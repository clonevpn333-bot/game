# Copy to .env.local for local work. Release builds (BINDERREADY_RELEASE=1) require every value.

# Canonical site origin, no trailing slash.
SITE_URL=https://binderready.example
SUPPORT_EMAIL=
COMPANY_LEGAL_NAME=
# US state whose law governs the Terms and EULA, e.g. Texas
COMPANY_GOVERNING_STATE=
COMPANY_ADDRESS=

# Lemon Squeezy: Store → Products → (product) → Share → copy the checkout link for each variant.
LEMON_SQUEEZY_SOLO_CHECKOUT_URL=
LEMON_SQUEEZY_FIRM_CHECKOUT_URL=

# Set to 1 to show the Founders banner. Create the code in Lemon Squeezy → Discounts (limit 100 redemptions).
FOUNDERS_ACTIVE=0
FOUNDERS_CODE=FOUNDERS

# GitHub repository (owner/name) whose published releases carry the installers. The
# download buttons point at its latest release (docs/release.md).
DOWNLOAD_REPO=
