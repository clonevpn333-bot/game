  <Item class="ServerScriptService" referent="66">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="67">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!nonstrict
-- Single server bootstrap. Services are plain modules with optional init(services) and start().
-- init runs for every service before any start, so services can grab each other in init.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local PhysicsService = game:GetService("PhysicsService")

local Net = require(ReplicatedStorage.Shared.Net)

Net.init()

-- Collision groups: riders (avatars on balls) never collide; client prop hitboxes only hit balls.
local function setupCollisionGroups()
	local groups = { "Balls", "Riders", "Props", "Loot" }
	for _, name in groups do
		if not PhysicsService:IsCollisionGroupRegistered(name) then
			PhysicsService:RegisterCollisionGroup(name)
		end
	end
	for _, other in { "Default", "Balls", "Riders", "Props", "Loot" } do
		PhysicsService:CollisionGroupSetCollidable("Riders", other, false)
	end
	PhysicsService:CollisionGroupSetCollidable("Props", "Default", false)
	PhysicsService:CollisionGroupSetCollidable("Props", "Props", false)
	PhysicsService:CollisionGroupSetCollidable("Props", "Balls", true)
	PhysicsService:CollisionGroupSetCollidable("Loot", "Balls", false)
	PhysicsService:CollisionGroupSetCollidable("Loot", "Props", false)
end
setupCollisionGroups()

local ServicesFolder = script.Services
local ORDER = {
	"LiveConfigService",
	"AnalyticsService",
	"PlayerDataService",
	"WorldService",
	"HubService",
	"BallService",
	"AbsorbService",
	"CritterService",
	"PvpService",
	"BotService",
	"MergeService",
	"EventService",
	"RolledexService",
	"RequestService",
	"ProgressionService",
	"GalaxyService",
	"ShopService",
	"MonetizationService",
	"SocialService",
	"RoundService",
	"DevService",
}

local services = {}
for _, name in ORDER do
	local module = ServicesFolder:FindFirstChild(name)
	if module then
		local ok, result = pcall(require, module)
		if ok then
			services[name] = result
		else
			warn("[Bootstrap] failed to load " .. name .. ": " .. tostring(result))
		end
	end
end

for _, name in ORDER do
	local service = services[name]
	if service and type(service.init) == "function" then
		local ok, err = pcall(service.init, service, services)
		if not ok then
			warn("[Bootstrap] init failed for " .. name .. ": " .. tostring(err))
		end
	end
end

for _, name in ORDER do
	local service = services[name]
	if service and type(service.start) == "function" then
		task.spawn(function()
			local ok, err = pcall(service.start, service)
			if not ok then
				warn("[Bootstrap] start failed for " .. name .. ": " .. tostring(err))
			end
		end)
	end
end
]]></string>
      </Properties>
      <Item class="Folder" referent="68">
        <Properties>
          <string name="Name">Lib</string>
        </Properties>
        <Item class="ModuleScript" referent="69">
          <Properties>
            <string name="Name">AvatarPool</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Real-looking avatars for bots. Bots should read as other kids playing, not as robots, so they
-- wear real Roblox avatars:
--   1. avatars of people who have played this game before (a rolling list saved in a DataStore,
--      never anyone in the current server), and
--   2. random Roblox accounts, keeping only ones that are actually dressed up (clothes or
--      accessories), so nobody shows up as a grey default.
-- Only the avatar's look is used; names are generated separately (BotNames), never the account's.
-- Descriptions are prefetched in the background so spawning a bot never waits on the web.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")

local AvatarPool = {}

local STORE_KEY = "recent"
local RECENT_CAP = 300
local CACHE_TARGET = 18
local MAX_RANDOM_ID = 4_000_000_000

local cache: { { desc: HumanoidDescription, userId: number } } = {}
local recent: { number } = {}
local recentDirty = false
local used: { [number]: boolean } = {}
local store = nil
local started = false
local lastFetched = 0

local function dressed(desc: HumanoidDescription): boolean
	local clothes = desc.Shirt ~= 0 or desc.Pants ~= 0 or desc.GraphicTShirt ~= 0
	local accessories = desc.HatAccessory ~= "" or desc.HairAccessory ~= "" or desc.FaceAccessory ~= ""
		or desc.BackAccessory ~= "" or desc.ShouldersAccessory ~= "" or desc.NeckAccessory ~= ""
	local layered = false
	local ok, list = pcall(function()
		return desc:GetAccessories(true)
	end)
	if ok and list and #list > 0 then
		layered = true
	end
	return (clothes and (accessories or layered)) or (layered and #list >= 2)
end

local function inServer(userId: number): boolean
	return Players:GetPlayerByUserId(userId) ~= nil
end

local function fetch(userId: number): HumanoidDescription?
	if used[userId] or inServer(userId) then
		return nil
	end
	local ok, desc = pcall(function()
		return Players:GetHumanoidDescriptionFromUserId(userId)
	end)
	if ok and desc and dressed(desc) then
		used[userId] = true
		lastFetched = userId
		return desc
	end
	return nil
end

local function openStore()
	local ok, s = pcall(function()
		return DataStoreService:GetDataStore("RTW_AvatarPool_v1")
	end)
	if not ok then
		return
	end
	local readOk, list = pcall(function()
		return s:GetAsync(STORE_KEY)
	end)
	if readOk then
		store = s
		if type(list) == "table" then
			for _, id in list do
				if type(id) == "number" then
					table.insert(recent, id)
				end
			end
		end
	end
end

local function remember(userId: number)
	if userId <= 0 or table.find(recent, userId) then
		return
	end
	table.insert(recent, userId)
	while #recent > RECENT_CAP do
		table.remove(recent, 1)
	end
	recentDirty = true
end

local function saveRecent()
	if not store or not recentDirty then
		return
	end
	recentDirty = false
	local mine = table.clone(recent)
	pcall(function()
		store:UpdateAsync(STORE_KEY, function(old)
			local merged = {}
			local seen = {}
			for _, list in { if type(old) == "table" then old else {}, mine } do
				for _, id in list do
					if type(id) == "number" and not seen[id] then
						seen[id] = true
						table.insert(merged, id)
					end
				end
			end
			while #merged > RECENT_CAP do
				table.remove(merged, 1)
			end
			return merged
		end)
	end)
end

local function refill()
	local attempts = 0
	while #cache < CACHE_TARGET and attempts < 40 do
		attempts += 1
		local desc = nil
		-- Prefer real players of this game; mix in random dressed accounts for variety.
		if #recent > 0 and math.random() < 0.7 then
			desc = fetch(recent[math.random(1, #recent)])
		else
			desc = fetch(math.random(1_000_000, MAX_RANDOM_ID))
		end
		if desc then
			table.insert(cache, { desc = desc, userId = lastFetched })
		end
		task.wait(if #cache < 6 then 0.15 else 0.5) -- quick at first, then gentle on the web endpoints
	end
end

function AvatarPool.start()
	if started then
		return
	end
	started = true
	task.spawn(function()
		openStore()
		for _, p in Players:GetPlayers() do
			remember(p.UserId)
		end
		while true do
			refill()
			saveRecent()
			task.wait(20)
		end
	end)
	Players.PlayerAdded:Connect(function(player)
		remember(player.UserId)
	end)
end

-- A ready description (and the account it came from, for headshot thumbnails), or nil if none
-- is cached yet (caller falls back).
function AvatarPool.take(): (HumanoidDescription?, number?)
	if #cache == 0 then
		return nil, nil
	end
	local entry = table.remove(cache, math.random(1, #cache))
	return entry.desc, entry.userId
end

function AvatarPool.size(): number
	return #cache
end

return AvatarPool
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="70">
          <Properties>
            <string name="Name">BotNames</string>
            <string name="Source"><![CDATA[--!strict
-- Usernames for bots that read like real Roblox kids' names (never a real account's name).

local BotNames = {}

local FIRST = {
	"Pixel", "Noodle", "Sky", "Turbo", "Lil", "Cosmic", "Sneaky", "Mega", "Shadow", "Bubble",
	"Frosty", "Lucky", "Ninja", "Cookie", "Blaze", "Mochi", "Sunny", "Zoom", "Taco", "Panda",
	"Rocket", "Waffle", "Storm", "Kitty", "Dino", "Jelly", "Neon", "Pickle", "Crystal", "Toast",
	"Captain", "Super", "Tiny", "Epic", "Happy", "Silly", "Golden", "Mystic", "Speedy", "Fluffy",
}
local SECOND = {
	"Roller", "Gamer", "King", "Queen", "Bean", "Fox", "Wolf", "Cat", "Pro", "Star", "Muffin",
	"Dragon", "Bunny", "Boi", "Girl", "Kid", "Master", "Nugget", "Ball", "Builder", "Hero",
	"Potato", "Shark", "Owl", "Ghost", "Pop", "Duck", "Tiger", "Wizard", "Blox", "Chef",
}
type Style = (string, string, string) -> string
local STYLES: { Style } = {
	function(a: string, b: string, n: string): string
		return a .. b .. n
	end,
	function(a: string, b: string, n: string): string
		return a .. "_" .. b .. n
	end,
	function(a: string, b: string, _: string): string
		return a .. b
	end,
	function(a: string, b: string, n: string): string
		return string.lower(a .. b) .. n
	end,
	function(a: string, b: string, _: string): string
		return "xX" .. a .. b .. "Xx"
	end,
	function(a: string, b: string, n: string): string
		return a .. b .. "_" .. n
	end,
	function(a: string, b: string, _: string): string
		return "its" .. a .. b
	end,
	function(a: string, b: string, n: string): string
		return "Itz" .. a .. n
	end,
}

function BotNames.generate(taken: { [string]: boolean }?): string
	for _ = 1, 20 do
		local a = FIRST[math.random(1, #FIRST)]
		local b = SECOND[math.random(1, #SECOND)]
		local roll = math.random()
		local n = if roll < 0.35 then tostring(math.random(1, 99)) elseif roll < 0.6 then tostring(math.random(2008, 2017)) else tostring(math.random(100, 9999))
		local name = STYLES[math.random(1, #STYLES)](a, b, n)
		if #name <= 20 and not (taken and taken[name]) then
			return name
		end
	end
	return "Roller" .. math.random(1000, 9999)
end

return BotNames
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="71">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="72">
          <Properties>
            <string name="Name">AbsorbService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Authoritative absorption. Clients send "I touched these props" claims for instant feel; the
-- server validates each claim against its own view of the ball (size, contact, latency reach) and
-- also sweeps every ball itself so nothing depends on a client claiming honestly.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Guard = require(Shared.Util.Guard)
local Signal = require(Shared.Util.Signal)
local Absorb = require(Shared.Logic.Absorb)
local Growth = require(Shared.Logic.Growth)
local PropLibrary = require(Shared.Logic.PropLibrary)
local Tuning = require(Shared.Config.Tuning)
local Cores = require(Shared.Data.Cores)
local Mutations = require(Shared.Data.Mutations)

local AbsorbService = {}
AbsorbService.Absorbed = Signal.new() -- (ballState, propState, info)
AbsorbService.Knocked = Signal.new() -- (ballState, count, reason)

local services
local pendingNotify: { [Player]: { any } } = {}
local scratch = {}

function AbsorbService:init(s)
	services = s
end

local function context()
	local round = services.RoundService
	local events = services.EventService
	return {
		ratioBonus = if events then events:absorbRatioBonus() else 0,
		finalRoll = if round then round:isFinalRoll() else false,
	}
end

local function canPlay(): boolean
	local round = services.RoundService
	return round == nil or round:isPlaying()
end

local function magnetReach(state): number
	local def = Cores.get(state.core)
	local extra = 0
	if def and def.magnetReach then
		extra += def.magnetReach(state.coreLevel)
	end
	if state.magnetUntil and os.clock() < state.magnetUntil then
		extra += Tuning.Absorb.MagnetReach
	end
	return extra
end

local function growthMultiplier(state, prop): number
	local mult = services.BallService:growthMultiplier(state)
	local round = services.RoundService
	if round and round:isFinalRoll() then
		mult *= Tuning.Growth.FinalRollMultiplier
	end
	local events = services.EventService
	if events then
		mult *= events:growthMultiplier(state)
	end
	if state.mergedWith then
		mult *= Tuning.Merge.GrowthPenalty
	end
	if prop.critter then
		mult *= Tuning.Growth.CritterBonus
	end
	return mult
end

-- Core absorb. `reach` is extra contact tolerance in studs. Returns true when absorbed.
function AbsorbService:tryAbsorb(state, prop, reach: number, ctx, segmentFrom: Vector3?): boolean
	if not prop or not state.alive then
		return false
	end
	if prop.loot and os.clock() < prop.activeAt then
		return false
	end
	local d = state.diameter
	if not Absorb.canAbsorbProp(d, prop.absorbSize, prop.landmark, ctx) then
		return false
	end
	local pos = state.part.Position
	local r = d / 2
	local threshold = Absorb.threshold(d, ctx)
	local limit = r + prop.radius * (1 - Tuning.Absorb.ContactSlack) + reach + Absorb.vacuumReach(d, prop.absorbSize, threshold)
	-- Magnet core: much smaller props are pulled in from further away still.
	if prop.absorbSize < threshold * 0.4 then
		limit += d * magnetReach(state)
	end
	local distSq
	if segmentFrom then
		distSq = Absorb.segmentDistanceSq(segmentFrom.X, segmentFrom.Y, segmentFrom.Z, pos.X, pos.Y, pos.Z, prop.x, prop.cy, prop.z)
	else
		local dx, dy, dz = prop.x - pos.X, prop.cy - pos.Y, prop.z - pos.Z
		distSq = dx * dx + dy * dy + dz * dz
	end
	if distSq > limit * limit then
		return false
	end
	self:commit(state, prop)
	return true
end

-- Apply an absorb that has already been validated.
function AbsorbService:commit(state, prop)
	local world = services.WorldService
	if not world:removeProp(prop.id, state.userId) then
		return
	end
	local oldD = state.diameter
	local newD = Growth.grow(oldD, prop.volume, { multiplier = growthMultiplier(state, prop) })
	services.BallService:setDiameter(state, newD, "absorb")

	local def = prop.def
	table.insert(state.history, {
		uid = prop.uid,
		mutation = prop.mutation,
		scale = prop.effScale,
		volume = prop.volume,
		color = def.metrics.mainColor,
		t = os.clock(),
	})
	if #state.history > Tuning.Absorb.RecentHistory * 4 then
		table.remove(state.history, 1)
	end
	state.stats.absorbed = (state.stats.absorbed or 0) + 1
	state.composition = state.composition or { tags = {}, colors = {}, total = 0 }
	local comp = state.composition
	comp.total += prop.volume
	for _, tag in def.tags do
		comp.tags[tag] = (comp.tags[tag] or 0) + prop.volume
	end
	comp.colors[def.metrics.mainColor] = (comp.colors[def.metrics.mainColor] or 0) + prop.volume
	if state.notable == nil or prop.absorbSize > (state.notable.size or 0) then
		state.notable = { uid = prop.uid, size = prop.absorbSize, mutation = prop.mutation }
	end

	local info = { isNew = false, isNewVariant = false }
	local rolledex = services.RolledexService
	if rolledex and Net.isPlayer(state.player) then
		info.isNew, info.isNewVariant = rolledex:discover(state.player, prop.uid, prop.mutation)
	end
	self.Absorbed:Fire(state, prop, info)
	if state.mergedWith then
		-- Merged partners share credit for everything the Mega Ball rolls up.
		local partnerState = { player = state.mergedWith, userId = state.mergedWith.UserId, diameter = newD }
		if rolledex then
			rolledex:discover(state.mergedWith, prop.uid, prop.mutation)
		end
		self.Absorbed:Fire(partnerState, prop, { isNew = false, isNewVariant = false, shared = true })
	end

	local list = pendingNotify[state.player]
	if not list then
		list = {}
		pendingNotify[state.player] = list
	end
	table.insert(list, {
		id = prop.id,
		uid = prop.uid,
		m = prop.mutation,
		s = prop.effScale,
		d = newD,
		g = newD - oldD,
		n = info.isNew,
		v = info.isNewVariant,
	})
	if state.mergedWith then
		local plist = pendingNotify[state.mergedWith] or {}
		pendingNotify[state.mergedWith] = plist
		table.insert(plist, { id = prop.id, uid = prop.uid, m = prop.mutation, s = prop.effScale, d = newD, g = newD - oldD })
	end
end

-- Knock the newest stuck props off a ball as grabbable loot. Returns the number knocked off.
function AbsorbService:knockLoose(state, count: number, awayFrom: Vector3?, reason: string): number
	if count <= 0 or not state.alive then
		return 0
	end
	local world = services.WorldService
	local pos = state.part.Position
	local entries = {}
	local lostVolume = 0
	for _ = 1, count do
		local item = table.remove(state.history)
		if not item then
			break
		end
		lostVolume += item.volume
		local dir
		if awayFrom then
			local flat = Vector3.new(pos.X - awayFrom.X, 0, pos.Z - awayFrom.Z)
			dir = if flat.Magnitude > 0.01 then flat.Unit else Vector3.new(1, 0, 0)
			local angle = (math.random() - 0.5) * 1.6
			dir = CFrame.Angles(0, angle, 0):VectorToWorldSpace(dir)
		else
			local a = math.random() * math.pi * 2
			dir = Vector3.new(math.cos(a), 0, math.sin(a))
		end
		local dist = state.diameter * (0.9 + math.random() * 1.4) + 6
		local land = pos + dir * dist
		local ground = world:groundAt(land.X, land.Z)
		local def = PropLibrary.get(item.uid)
		local mut = Mutations.get(item.mutation)
		local baseScale = item.scale / (if mut then mut.scale else 1)
		if def then
			table.insert(entries, {
				uid = item.uid,
				mutation = item.mutation,
				scale = baseScale,
				from = pos + Vector3.new(0, state.diameter * 0.3, 0),
				to = Vector3.new(land.X, ground, land.Z),
				settle = 0.8,
			})
		end
	end
	if #entries == 0 then
		return 0
	end
	world:spawnLoot(entries)
	-- Knocked props take their volume with them (minus the fill bonus they granted).
	local newD = Growth.shrink(state.diameter, lostVolume * Tuning.Growth.Gain * 0.5)
	services.BallService:setDiameter(state, newD, "knock")
	Net.fireAll("BallFx", "knock", { ball = state.userId, count = #entries })
	self.Knocked:Fire(state, #entries, reason)
	return #entries
end

local function onClaim(player: Player, ids: { number })
	if not canPlay() then
		return
	end
	local state = services.BallService:get(player)
	if not state or not state.alive then
		return
	end
	local world = services.WorldService
	local ctx = context()
	local speed = state.part.AssemblyLinearVelocity.Magnitude
	-- Claims arrive after the client saw contact, so allow generous (but bounded) latency reach.
	local reach = Absorb.latencyReach(speed) * 1.6 + 2 + state.diameter * 0.08
	for _, id in ids do
		local prop = world:get(id)
		if prop then
			AbsorbService:tryAbsorb(state, prop, reach, ctx, nil)
		end
	end
end

local function sweep()
	if not canPlay() then
		return
	end
	local world = services.WorldService
	local ctx = context()
	for _, state in services.BallService:all() do
		local part = state.part
		if part and part.Parent then
			local pos = part.Position
			local from = state.sweepFrom or pos
			local mid = (from + pos) / 2
			local span = (pos - from).Magnitude / 2
			local reachRadius = state.diameter / 2 + span + state.diameter * (magnetReach(state) + Tuning.Absorb.VacuumReach) + 4
			table.clear(scratch)
			world:queryNear(mid.X, mid.Z, reachRadius, scratch)
			local reach = Absorb.latencyReach(part.AssemblyLinearVelocity.Magnitude) * 0.5
			for _, id in scratch do
				local prop = world:get(id)
				if prop and not prop.critterHeld then
					AbsorbService:tryAbsorb(state, prop, reach, ctx, from)
				end
			end
			state.sweepFrom = pos
		end
	end
end

local function flushNotifications()
	for player, list in pendingNotify do
		if player.Parent then
			Net.fire("Absorbed", player, list)
		end
	end
	table.clear(pendingNotify)
end

-- Supply rain: any ball in a sparse area gets props sized for it dropped from the sky, so early
-- growth never stalls and the map never feels picked clean late in a round. Small balls get the
-- kit's crumb list; bigger balls get kit props between 25% and 55% of what they can absorb.
local function replenishCandidates(kit, threshold: number): { number }
	local out = {}
	for _, def in PropLibrary.ByKit[kit.id] do
		local s = def.metrics.absorbSize
		if not def.critter and not def.landmark and s >= threshold * 0.25 and s <= threshold * 0.55 then
			table.insert(out, def.uid)
		end
	end
	return out
end

local function replenish()
	if not canPlay() then
		return
	end
	local world = services.WorldService
	local kit = world.kit
	if not kit then
		return
	end
	local crumbs = {}
	for _, id in kit.replenish or {} do
		local def = PropLibrary.find(kit.id, id)
		if def then
			table.insert(crumbs, def.uid)
		end
	end
	local ctx = context()
	local w = Tuning.World
	for _, state in services.BallService:all() do
		if not state.part.Parent then
			continue
		end
		local d = state.diameter
		local pos = state.part.Position
		local radius = w.ReplenishRadius + d * 5
		local threshold = Absorb.threshold(d, ctx)
		local near = world:queryNear(pos.X, pos.Z, radius)
		local edible = 0
		for _, id in near do
			local p = world:get(id)
			if p and Absorb.canAbsorbProp(d, p.absorbSize, p.landmark, ctx) and p.absorbSize >= threshold * 0.08 then
				edible += 1
			end
		end
		local wanted = if d < 14 then 18 else 10
		if edible < wanted then
			local pool = if d < 14 then crumbs else replenishCandidates(kit, threshold)
			if #pool > 0 then
				local entries = {}
				local count = if d < 14 then w.ReplenishMaxPerTick else math.max(2, math.floor(w.ReplenishMaxPerTick / 2))
				for _ = 1, count do
					local a = math.random() * math.pi * 2
					local dist = d * 1.5 + 8 + math.random() * radius * 0.6
					local lx = math.clamp(pos.X + math.cos(a) * dist, -kit.arenaHalf + 30, kit.arenaHalf - 30)
					local lz = math.clamp(pos.Z + math.sin(a) * dist, -kit.arenaHalf + 30, kit.arenaHalf - 30)
					local ground = world:groundAt(lx, lz)
					table.insert(entries, {
						uid = pool[math.random(1, #pool)],
						mutation = 0,
						scale = 0.9 + math.random() * 0.25,
						from = Vector3.new(lx, ground + 60 + d * 2, lz),
						to = Vector3.new(lx, ground, lz),
						settle = 0.6 + math.min(d / 200, 0.6),
					})
				end
				world:spawnLoot(entries)
			end
		end
	end
end

function AbsorbService:start()
	Net.on("AbsorbClaim", onClaim, {
		rate = Tuning.Absorb.ClaimRatePerSecond / 4,
		burst = Tuning.Absorb.ClaimBurst / 4,
		guards = { Guard.arrayOf(Guard.integer(1, 65535), 48) },
	})
	services.BallService.ActionUsed:Connect(function(state, action, arg)
		if action == "bonk" and canPlay() then
			local speed = tonumber(arg) or 0
			if speed >= Growth.maxSpeed(state.diameter) * Tuning.Absorb.BonkMinSpeed then
				self:knockLoose(state, Tuning.Absorb.BonkKnockCount, nil, "bonk")
			end
		end
	end)
	local sweepAcc, notifyAcc = 0, 0
	RunService.Heartbeat:Connect(function(dt)
		sweepAcc += dt
		notifyAcc += dt
		if sweepAcc >= 1 / 15 then
			sweepAcc = 0
			sweep()
		end
		if notifyAcc >= 1 / 20 then
			notifyAcc = 0
			flushNotifications()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(Tuning.World.ReplenishInterval)
			local ok, err = pcall(replenish)
			if not ok then
				warn("[Absorb] replenish: " .. tostring(err))
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		pendingNotify[player] = nil
	end)
end

return AbsorbService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="73">
          <Properties>
            <string name="Name">BallService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Owns every player's ball: creation, authoritative size, network ownership, the Roller avatar
-- riding on top, and movement sanity checks (speed/teleport) against client-owned physics.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Guard = require(Shared.Util.Guard)
local Signal = require(Shared.Util.Signal)
local Growth = require(Shared.Logic.Growth)
local Tuning = require(Shared.Config.Tuning)
local Cores = require(Shared.Data.Cores)
local Titles = require(Shared.Data.Titles)

local BallService = {}

export type BallState = {
	player: Player,
	userId: number,
	part: Part,
	model: Model,
	diameter: number,
	core: string,
	coreLevel: number,
	shell: string,
	spawnedAt: number,
	shieldUntil: number,
	lastPos: Vector3,
	lastCheck: number,
	strikes: number,
	allowSpeedUntil: number,
	lastDash: number,
	lastHop: number,
	lastBonk: number,
	history: { any }, -- absorbed props, newest last: { uid, mutation, scale, volume, t }
	stats: { [string]: number },
	growthBoosts: { { mult: number, untilT: number, reason: string } },
	riderScale: number,
	mergedWith: Player?,
	isMergeHost: boolean,
	riders: { [Player]: boolean },
	alive: boolean,
	serverOwned: boolean, -- bots: the server simulates this ball's physics
	isBot: boolean,
	composition: any?,
	notable: any?,
	sweepFrom: Vector3?,
	magnetUntil: number?,
	launchFx: string?,
}

BallService.states = {} :: { [Player]: BallState }
BallService.folder = nil :: Folder?
BallService.DiameterChanged = Signal.new()
BallService.BallSpawned = Signal.new()
BallService.BallRemoved = Signal.new()
BallService.ActionUsed = Signal.new()
BallService.BurstRequested = Signal.new() -- (player) riders have no ball, so this skips the ball check

local services

function BallService:init(s)
	services = s
	local folder = Instance.new("Folder")
	folder.Name = "Balls"
	folder.Parent = Workspace
	self.folder = folder
end

local function setCharacterRiderMode(character: Model, riding: boolean)
	for _, d in character:GetDescendants() do
		if d:IsA("BasePart") then
			d.CollisionGroup = if riding then "Riders" else "Default"
			d.Massless = riding
		end
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.PlatformStand = riding
		humanoid.RequiresNeck = false
		humanoid.BreakJointsOnDeath = false
		humanoid.UseJumpPower = false
		humanoid.JumpHeight = if riding then 0 else 7.2
	end
end

function BallService:setRiderMode(player: Player, riding: boolean)
	local character = player.Character
	if character then
		setCharacterRiderMode(character, riding)
	end
end

local function scaleCharacter(state: BallState)
	local character = state.player.Character
	if not character then
		return
	end
	local target = Growth.riderScale(state.diameter)
	if math.abs(target - state.riderScale) / state.riderScale < Tuning.Ball.RiderScaleStep then
		return
	end
	state.riderScale = target
	local ok, err = pcall(function()
		character:ScaleTo(target)
	end)
	if not ok then
		warn("[Ball] ScaleTo failed: " .. tostring(err))
	end
end

function BallService:resetCharacterScale(player: Player)
	local character = player.Character
	if character and math.abs(character:GetScale() - 1) > 1e-3 then
		pcall(function()
			character:ScaleTo(1)
		end)
	end
end

local function physical(diameter: number, core: string)
	local b = Tuning.Ball
	local def = Cores.get(core)
	local density = b.Density * (def and def.densityMult or 1)
	local elasticity = b.Elasticity * (def and def.elasticityMult or 1)
	return PhysicalProperties.new(density, b.Friction, math.clamp(elasticity, 0, 1), 1, 1)
end

function BallService:get(player: Player): BallState?
	return self.states[player]
end

function BallService:getByUserId(userId: number): BallState?
	for _, state in self.states do
		if state.userId == userId then
			return state
		end
	end
	return nil
end

function BallService:all(): { BallState }
	local out = {}
	for _, state in self.states do
		if state.alive then
			table.insert(out, state)
		end
	end
	return out
end

function BallService:spawn(player: Player, position: Vector3, diameter: number, options: { [string]: any }?): BallState?
	local opts: { [string]: any } = options or {}
	self:remove(player, "respawn")
	local character = player.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") then
		return nil
	end
	local isBot = not Net.isPlayer(player)
	local data = if isBot then nil else (services.PlayerDataService and services.PlayerDataService:getLoaded(player))
	local core = opts.core or (data and data.cores.equipped) or "Classic"
	local coreLevel = (data and data.cores.owned[core]) or 1
	local shell = (data and data.cosmetics.equipped.shell) or (isBot and (player :: any).shell) or "Classic"

	local model = Instance.new("Model")
	model.Name = "Ball_" .. player.UserId
	model.ModelStreamingMode = Enum.ModelStreamingMode.Persistent

	local part = Instance.new("Part")
	part.Name = "Ball"
	part.Shape = Enum.PartType.Ball
	part.Size = Vector3.one * diameter
	part.CFrame = CFrame.new(position + Vector3.new(0, diameter / 2 + 0.5, 0))
	part.CustomPhysicalProperties = physical(diameter, core)
	part.Transparency = 1
	part.CastShadow = false
	part.CollisionGroup = "Balls"
	part.CanTouch = false
	part.CanQuery = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part:SetAttribute("OwnerId", player.UserId)
	part:SetAttribute("OwnerName", player.DisplayName)
	part:SetAttribute("Diameter", diameter)
	part:SetAttribute("Core", core)
	part:SetAttribute("Shell", shell)
	part:SetAttribute("Level", if isBot then (player :: any).level else (data and data.level or 1))
	local titleDef = Titles.get(if isBot then (player :: any).title else (data and data.title))
	if titleDef and titleDef.id ~= "Rookie" then
		part:SetAttribute("Title", titleDef.text)
		part:SetAttribute("TitleColor", titleDef.color)
	end
	part.Parent = model
	model.PrimaryPart = part
	model.Parent = self.folder

	local now = os.clock()
	local state: BallState = {
		player = player,
		userId = player.UserId,
		part = part,
		model = model,
		diameter = diameter,
		core = core,
		coreLevel = coreLevel,
		shell = shell,
		spawnedAt = now,
		shieldUntil = now + (opts.shield or Tuning.Pvp.SpawnShield),
		lastPos = part.Position,
		lastCheck = now,
		strikes = 0,
		allowSpeedUntil = now + 2,
		lastDash = -math.huge,
		lastHop = -math.huge,
		lastBonk = -math.huge,
		history = opts.history or {},
		stats = opts.stats or { absorbed = 0, playersRolled = 0, timesRolled = 0, discoveries = 0, peak = diameter, bumps = 0, bursts = 0, merges = 0 },
		growthBoosts = opts.growthBoosts or {},
		riderScale = math.max(character:GetScale(), 0.01),
		mergedWith = nil,
		isMergeHost = false,
		riders = {},
		alive = true,
		serverOwned = isBot,
		isBot = isBot,
	}
	part:SetAttribute("ShieldUntil", workspace:GetServerTimeNow() + (state.shieldUntil - now))
	self.states[player] = state

	if isBot then
		part:SetNetworkOwner(nil)
		part:SetAttribute("Bot", true)
	else
		part:SetNetworkOwner(player)
	end
	self:markRiding(player, true)
	local hrp = character.HumanoidRootPart :: BasePart
	hrp.CFrame = CFrame.new(part.Position + Vector3.new(0, diameter / 2 + 3, 0))
	hrp.AssemblyLinearVelocity = Vector3.zero
	scaleCharacter(state)

	self.BallSpawned:Fire(state)
	Net.fire("PlayerState", player, "Rolling", { ball = model, diameter = diameter, core = core, coreLevel = coreLevel })
	return state
end

function BallService:remove(player: Player, reason: string?)
	local state = self.states[player]
	if not state then
		return
	end
	state.alive = false
	self.states[player] = nil
	self.BallRemoved:Fire(state, reason)
	if state.model then
		state.model:Destroy()
	end
end

-- The only way a ball's size changes. Keeps the ball resting on the ground as it grows.
function BallService:setDiameter(state: BallState, diameter: number, reason: string?)
	local old = state.diameter
	diameter = math.clamp(diameter, Tuning.Ball.StartDiameter * 0.5, Tuning.Ball.MaxDiameter)
	if math.abs(diameter - old) < 1e-4 then
		return
	end
	state.diameter = diameter
	state.stats.peak = math.max(state.stats.peak or 0, diameter)
	local part = state.part
	if part and part.Parent then
		part:SetAttribute("Diameter", diameter)
		-- Client-owned balls are resized smoothly by their clients (the owner also lifts its ball
		-- as it grows). Writing Size/CFrame here would fight the owner's physics and hitch, so the
		-- server only resizes balls it simulates itself (bots, anchored launch balls).
		if state.serverOwned or part.Anchored then
			local lift = math.max(0, (diameter - old) / 2)
			part.Size = Vector3.one * diameter
			if lift > 0.05 and not part.Anchored then
				part.CFrame = part.CFrame + Vector3.new(0, lift, 0)
			end
		end
	end
	scaleCharacter(state)
	self.DiameterChanged:Fire(state, old, diameter, reason)
end

-- Product of all active growth multipliers for this ball (comeback, catch-up, events...).
function BallService:growthMultiplier(state: BallState): number
	local now = os.clock()
	local mult = 1
	for i = #state.growthBoosts, 1, -1 do
		local boost = state.growthBoosts[i]
		if now > boost.untilT then
			table.remove(state.growthBoosts, i)
		else
			mult *= boost.mult
		end
	end
	return mult
end

function BallService:addGrowthBoost(state: BallState, mult: number, duration: number, reason: string)
	table.insert(state.growthBoosts, { mult = mult, untilT = os.clock() + duration, reason = reason })
	Net.fire("Toast", state.player, "boost", { mult = mult, duration = duration, reason = reason })
end

function BallService:dashCooldown(state: BallState): number
	local def = Cores.get(state.core)
	local mult = def and def.dashCooldownMult and def.dashCooldownMult(state.coreLevel) or 1
	return Tuning.Ball.DashCooldown * mult
end

-- Server applies a velocity change on the owning client (server can't push client-owned physics).
function BallService:impulse(state: BallState, velocityChange: Vector3)
	state.allowSpeedUntil = os.clock() + 1.5
	if state.serverOwned then
		local part = state.part
		if part and part.Parent and not part.Anchored then
			part.AssemblyLinearVelocity += velocityChange
		end
	else
		Net.fire("Impulse", state.player, velocityChange)
	end
end

function BallService:teleport(state: BallState, position: Vector3)
	local part = state.part
	if not part or not part.Parent then
		return
	end
	state.allowSpeedUntil = os.clock() + 1
	part.AssemblyLinearVelocity = Vector3.zero
	part.AssemblyAngularVelocity = Vector3.zero
	part.CFrame = CFrame.new(position)
	state.lastPos = position
end

local function onAction(player: Player, action: string, arg: any)
	if action == "burst" then
		BallService.BurstRequested:Fire(player)
		return
	end
	local state = BallService.states[player]
	if not state then
		return
	end
	local now = os.clock()
	if action == "dash" then
		if now - state.lastDash >= BallService:dashCooldown(state) * 0.9 then
			state.lastDash = now
			state.allowSpeedUntil = now + Tuning.Ball.DashDuration + 1
			BallService.ActionUsed:Fire(state, "dash")
		end
	elseif action == "hop" then
		if now - state.lastHop >= Tuning.Ball.HopCooldown * 0.8 then
			state.lastHop = now
			BallService.ActionUsed:Fire(state, "hop")
		end
	elseif action == "bonk" then
		if type(arg) == "number" and now - state.lastBonk >= Tuning.Absorb.BonkCooldown then
			state.lastBonk = now
			BallService.ActionUsed:Fire(state, "bonk", arg)
		end
	end
end

-- Movement sanity: horizontal speed must stay within what the ball could plausibly reach.
local function validate(state: BallState, now: number)
	local part = state.part
	if not part or not part.Parent then
		return
	end
	local pos = part.Position
	if pos.Y < Tuning.Ball.VoidY then
		local spawns = services.WorldService:spawnPoints()
		local target = if #spawns > 0 then spawns[math.random(1, #spawns)] else Vector3.new(0, 60, 0)
		BallService:teleport(state, target + Vector3.new(0, state.diameter / 2 + 2, 0))
		return
	end
	local dt = now - state.lastCheck
	if dt < 0.2 then
		return
	end
	local delta = pos - state.lastPos
	local horizontal = Vector3.new(delta.X, 0, delta.Z).Magnitude / dt
	local limit = Growth.maxSpeed(state.diameter) * 1.6 + 30
	if now < state.allowSpeedUntil then
		limit = limit * 3 + Tuning.Pvp.BurstLaunchSpeed * 2
	end
	if state.mergedWith then
		limit *= 1.5
	end
	if horizontal > limit and not part.Anchored then
		state.strikes += 1
		if state.strikes >= 3 then
			warn(string.format("[Ball] %s moving too fast (%.0f > %.0f); correcting", state.player.Name, horizontal, limit))
			BallService:teleport(state, state.lastPos)
			state.strikes = 0
			if services.AnalyticsService then
				services.AnalyticsService:custom(state.player, "SpeedCorrection", horizontal)
			end
			return
		end
	else
		state.strikes = math.max(0, state.strikes - 0.25)
	end
	state.lastPos = pos
	state.lastCheck = now
end

function BallService:start()
	Net.on("Action", onAction, {
		rate = 20,
		burst = 40,
		guards = { Guard.string(24), Guard.optional(Guard.number(-1e6, 1e6)) },
	})
	RunService.Heartbeat:Connect(function()
		local now = os.clock()
		for _, state in self.states do
			if state.alive and not state.serverOwned then
				validate(state, now)
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		self:remove(player, "left")
	end)
	local function watchCharacter(character: Model)
		character.DescendantAdded:Connect(function(d)
			if d:IsA("BasePart") and character:GetAttribute("Riding") then
				d.CollisionGroup = "Riders"
				d.Massless = true
			end
		end)
	end
	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(watchCharacter)
		if player.Character then
			watchCharacter(player.Character)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
end

-- Exposed for other services so the Riding attribute stays in sync with rider mode.
function BallService:markRiding(player: Player, riding: boolean)
	local character = player.Character
	if character then
		character:SetAttribute("Riding", riding)
	end
	self:setRiderMode(player, riding)
end

return BallService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="74">
          <Properties>
            <string name="Name">BotService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Bots keep every server lively: they fill the round up to a target number of balls when few real
-- players are online and step out (smallest first) as players join. Each bot has a little
-- personality: how greedy, how brave, how bloodthirsty. They feed on props, chase balls they can
-- roll up, flee bigger ones, hop when stuck, and go for the landmark in the Final Roll.
-- Bots are server-simulated with the exact same movement model players use.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Absorb = require(Shared.Logic.Absorb)
local Growth = require(Shared.Logic.Growth)
local MovementModel = require(Shared.Logic.MovementModel)
local Tuning = require(Shared.Config.Tuning)
local Animations = require(Shared.Config.Animations)
local Cosmetics = require(Shared.Data.Cosmetics)
local AvatarPool = require(script.Parent.Parent.Lib.AvatarPool)
local BotNames = require(script.Parent.Parent.Lib.BotNames)

local BotService = {}
BotService.bots = {} :: { any } -- identity list

local services
local folder: Folder
local nextId = 1
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

-- Fallback look when no real avatar is cached yet (fresh server, or avatar web calls failing).
local SKIN = {
	Color3.fromRGB(255, 220, 177), Color3.fromRGB(234, 192, 134), Color3.fromRGB(198, 134, 66),
	Color3.fromRGB(141, 85, 36), Color3.fromRGB(255, 205, 148), Color3.fromRGB(110, 70, 45),
}
local CLOTHES = {
	Color3.fromRGB(39, 70, 144), Color3.fromRGB(27, 42, 53), Color3.fromRGB(196, 40, 28),
	Color3.fromRGB(91, 93, 105), Color3.fromRGB(242, 243, 243), Color3.fromRGB(75, 151, 75),
	Color3.fromRGB(218, 133, 65), Color3.fromRGB(107, 50, 124),
}
local SHELL_CHOICES = {}
for _, shell in Cosmetics.Shells do
	if shell.source == "Shop" then
		table.insert(SHELL_CHOICES, shell.id)
	end
end

-- What bots say (chat bubbles), by situation. Short and kid-like, like real players.
local LINES = {
	hello = { "hi", "yo", "lets goooo", "hii", "im gonna win this", "back again lol", "this map 😍", "ez" },
	rolledSomeone = { "gotcha 😂", "get rolled", "lol", "sorry not sorry", "nom", "yoink", "hehe", "ur mine now" },
	gotRolled = { "NOOO", "bruh", "hey!!", "😭", "not fair", "lol ok", "WAIT", "nooooo" },
	burst = { "freedom!!", "im free", "BYE", "ha!", "u cant hold me" },
	event = { "omg", "WHAT", "lets gooo", "yesss", "woah", "chaos 😂", "no way" },
	giant = { "RUN", "AHHH", "its huge 😱", "everyone run" },
	finalRoll = { "FINAL ROLL", "go go go", "landmark time", "im getting that" },
	gg = { "gg", "gg wp", "gg!!", "ggs", "that was fun", "one more", "close one", "ez gg" },
}

function BotService:init(s)
	services = s
	folder = Instance.new("Folder")
	folder.Name = "Bots"
	folder.Parent = Workspace
end

-- A bot "identity" duck-types the bits of Player the game uses (UserId, DisplayName, Character,
-- attributes). Net.fire ignores it, so no remote is ever sent to a bot.
local function newIdentity(name: string)
	local attrs = {}
	local id = nextId
	nextId += 1
	local identity = {
		IsBot = true,
		UserId = -id,
		Name = name,
		DisplayName = name,
		level = math.random(2, 46),
		title = ({ "Roller", "Sticky", "Hoover", "Winner", "Collector", nil, nil, nil })[math.random(1, 8)],
		shell = if math.random() < 0.45 and #SHELL_CHOICES > 0 then SHELL_CHOICES[math.random(1, #SHELL_CHOICES)] else "Classic",
		lastChat = 0,
		Character = nil,
		Parent = Workspace,
	}
	function identity.GetAttribute(_, key)
		return attrs[key]
	end
	function identity.SetAttribute(_, key, value)
		attrs[key] = value
	end
	return identity
end

local function fallbackDescription(): HumanoidDescription
	local desc = Instance.new("HumanoidDescription")
	local skin = SKIN[math.random(1, #SKIN)]
	desc.HeadColor = skin
	desc.LeftArmColor = skin
	desc.RightArmColor = skin
	desc.TorsoColor = CLOTHES[math.random(1, #CLOTHES)]
	local legs = CLOTHES[math.random(1, #CLOTHES)]
	desc.LeftLegColor = legs
	desc.RightLegColor = legs
	desc.HeightScale = 0.95 + math.random() * 0.1
	desc.WidthScale = 0.9 + math.random() * 0.15
	return desc
end

local function loadTrack(animator: Animator, id: string, priority: Enum.AnimationPriority, looped: boolean)
	local anim = Instance.new("Animation")
	anim.AnimationId = id
	local ok, track = pcall(function()
		return animator:LoadAnimation(anim)
	end)
	if ok and track then
		track.Looped = looped
		track.Priority = priority
		return track
	end
	return nil
end

-- Builds (or rebuilds) the bot's avatar from its saved description.
local function buildCharacter(identity)
	if identity.Character then
		identity.Character:Destroy()
		identity.Character = nil
	end
	if not identity.desc then
		local desc, avatarId = AvatarPool.take()
		identity.desc = desc or fallbackDescription()
		identity.avatarId = avatarId
	end
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(identity.desc, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		-- A real avatar can fail to load (deleted items); retry once with the fallback look.
		identity.desc = fallbackDescription()
		identity.avatarId = nil
		ok, model = pcall(function()
			return Players:CreateHumanoidModelFromDescription(identity.desc, Enum.HumanoidRigType.R15)
		end)
		if not ok or not model then
			warn("[Bots] could not build a bot avatar: " .. tostring(model))
			return nil
		end
	end
	model.Name = identity.Name
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		humanoid.PlatformStand = true
		humanoid.RequiresNeck = false
		humanoid.BreakJointsOnDeath = false
	end
	-- Riders never collide with anything (their own ball included).
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.CollisionGroup = "Riders"
			d.Massless = true
			d.CanQuery = false
			d.CanTouch = false
		end
	end
	model.Parent = folder
	local hrp = model:FindFirstChild("HumanoidRootPart")
	if hrp then
		pcall(function()
			hrp:SetNetworkOwner(nil)
		end)
	end
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	identity.tracks = {}
	if animator then
		identity.runTrack = loadTrack(animator, Animations.R15.Run, Enum.AnimationPriority.Action, true)
		for _, key in { "Cheer", "Laugh", "Wave", "Point", "Dance1" } do
			identity.tracks[key] = loadTrack(animator, Animations.R15[key], Enum.AnimationPriority.Action2, false)
		end
	end
	identity.Character = model
	return model
end

-- Chat bubble + optional emote, rate limited per bot so it feels human, not spammy.
function BotService:say(identity, kind: string, chance: number?, emote: string?)
	if not identity or not identity.IsBot or math.random() > (chance or 1) then
		return
	end
	local now = os.clock()
	if now - (identity.lastChat or 0) < 7 then
		return
	end
	identity.lastChat = now
	local lines = LINES[kind]
	if not lines then
		return
	end
	local text = lines[math.random(1, #lines)]
	task.delay(0.3 + math.random() * 1.2, function()
		if identity.Character and identity.Character.Parent then
			Net.fireAll("BotChat", identity.UserId, text)
			local track = emote and identity.tracks and identity.tracks[emote]
			if track then
				track:Play(0.15)
			end
		end
	end)
end

local function randomBot(filter: ((any) -> boolean)?)
	local pool = {}
	for _, b in BotService.bots do
		if b.Character and b.Character.Parent and (not filter or filter(b)) then
			table.insert(pool, b)
		end
	end
	return if #pool > 0 then pool[math.random(1, #pool)] else nil
end

local function brainFor()
	return {
		target = nil,
		mode = "feed",
		nextThink = 0,
		greed = 0.6 + math.random() * 0.4,
		aggression = 0.25 + math.random() * 0.6,
		bravery = math.random(),
		skill = 0.78 + math.random() * 0.14, -- fraction of player top speed: beatable but lively
		stuckSince = nil,
		lastDash = 0,
		lastHop = 0,
		wander = nil,
	}
end

function BotService:add()
	local taken = {}
	for _, b in self.bots do
		taken[b.Name] = true
	end
	for _, p in Players:GetPlayers() do
		taken[p.Name] = true
		taken[p.DisplayName] = true
	end
	local identity = newIdentity(BotNames.generate(taken))
	if not buildCharacter(identity) then
		return nil
	end
	identity.brain = brainFor()
	table.insert(self.bots, identity)
	self:spawnBall(identity)
	self:say(identity, "hello", 0.35, "Wave")
	return identity
end

function BotService:spawnBall(identity)
	local round = services.RoundService
	if not round or not round:isPlaying() then
		return
	end
	-- Fresh avatar model every round: no leftover scale, welds or ownership from the last map.
	if not identity.Character or identity.Character.Parent ~= folder then
		if not buildCharacter(identity) then
			return
		end
	end
	local catchUp = (Workspace:GetServerTimeNow() - round.startedAt) > 15
	round:spawnIntoRound(identity, { catchUp = catchUp })
	identity.brain = identity.brain or brainFor()
	if identity.runTrack then
		identity.runTrack:Play(0.2)
	end
end

function BotService:remove(identity, poof: boolean?)
	if services.PvpService then
		services.PvpService:release(identity, false, "botleft")
	end
	local state = services.BallService:get(identity)
	if state and poof then
		Net.fireAll("BallFx", "burst", { userId = identity.UserId, position = state.part.Position })
	end
	services.BallService:remove(identity, "bot")
	if identity.Character then
		identity.Character:Destroy()
		identity.Character = nil
	end
	for i, b in self.bots do
		if b == identity then
			table.remove(self.bots, i)
			break
		end
	end
end

function BotService:identities(): { any }
	return self.bots
end

function BotService:wanted(): number
	local b = Tuning.Bots
	local live = services.LiveConfigService
	local target = (live and live:get("botTargetBalls")) or b.TargetBalls
	local humans = #Players:GetPlayers()
	if humans == 0 then
		return 0
	end
	return math.clamp(target - humans, 0, b.MaxBots)
end

-- Brain ----------------------------------------------------------------------------------------

local function nearestBall(state, predicate)
	local best, bestDist = nil, math.huge
	local pos = state.part.Position
	for _, other in services.BallService:all() do
		if other ~= state and other.part.Parent and predicate(other) then
			local dist = (other.part.Position - pos).Magnitude
			if dist < bestDist then
				best, bestDist = other, dist
			end
		end
	end
	return best, bestDist
end

local function think(identity, state)
	local brain = identity.brain
	local d = state.diameter
	local pos = state.part.Position
	local world = services.WorldService
	local ctx = {
		ratioBonus = if services.EventService then services.EventService:absorbRatioBonus() else 0,
		finalRoll = services.RoundService:isFinalRoll(),
	}
	-- Danger first.
	local round = services.RoundService
	local threat, threatDist = nearestBall(state, function(o)
		return Absorb.canAbsorbBall(o.diameter, d) and not round:sameTeam(o.player, identity)
	end)
	if threat and threatDist < d * 5 + threat.diameter * 1.5 + 20 and brain.bravery < 0.85 then
		local away = pos - threat.part.Position
		away = Vector3.new(away.X, 0, away.Z)
		away = if away.Magnitude > 1e-3 then away.Unit else Vector3.new(1, 0, 0)
		local side = Vector3.new(-away.Z, 0, away.X) * (if math.random() < 0.5 then 0.4 else -0.4)
		brain.mode = "flee"
		brain.target = pos + (away + side).Unit * (d * 6 + 40)
		brain.dashWanted = threatDist < d * 2 + threat.diameter
		return
	end
	-- Hunt balls we can roll up.
	local prey, preyDist = nearestBall(state, function(o)
		return Absorb.canAbsorbBall(d, o.diameter) and os.clock() >= o.shieldUntil and not round:sameTeam(o.player, identity)
	end)
	local crownChase = round:mode().scoring == "crown"
	if prey and preyDist < d * (if crownChase then 10 else 7) + 50 and math.random() < brain.aggression + (if crownChase then 0.25 else 0) then
		brain.mode = "chase"
		local lead = prey.part.AssemblyLinearVelocity * 0.35
		brain.target = prey.part.Position + Vector3.new(lead.X, 0, lead.Z)
		brain.dashWanted = preyDist < d * 2.5 + prey.diameter
		return
	end
	-- Final Roll: the landmark.
	local landmark = world:get(world.landmarkId)
	if ctx.finalRoll and landmark and Absorb.canAbsorbProp(d, landmark.absorbSize, true, ctx) then
		brain.mode = "landmark"
		brain.target = Vector3.new(landmark.x, pos.Y, landmark.z)
		brain.dashWanted = true
		return
	end
	-- Feed: best absorbable prop nearby (bigger relative size is tastier).
	local threshold = Absorb.threshold(d, ctx)
	local best, bestScore = nil, 0
	local radius = d * 6 + 50
	for _, id in world:queryNear(pos.X, pos.Z, radius) do
		local p = world:get(id)
		if p and not p.landmark and p.absorbSize <= threshold and math.abs(p.cy - pos.Y) < d + 30 then
			local dist = math.sqrt((p.x - pos.X) ^ 2 + (p.z - pos.Z) ^ 2)
			local score = (p.absorbSize / threshold * brain.greed + 0.2) / (dist + 6)
			if p.mutation > 0 then
				score *= if round:mode().scoring == "gold" then 6 else 1.6 -- sparkly things are tempting
			end
			if score > bestScore then
				best, bestScore = p, score
			end
		end
	end
	brain.dashWanted = false
	if best then
		brain.mode = "feed"
		brain.target = Vector3.new(best.x, pos.Y, best.z)
		brain.wander = nil
		return
	end
	-- Nothing nearby: roam outward toward bigger stuff.
	if not brain.wander or (Vector3.new(brain.wander.X - pos.X, 0, brain.wander.Z - pos.Z)).Magnitude < d + 10 then
		local half = world.kit and world.kit.arenaHalf or 600
		local a = math.random() * math.pi * 2
		local r = math.clamp(d * 4 + half * 0.25, 60, half * 0.85)
		brain.wander = Vector3.new(math.clamp(pos.X + math.cos(a) * r, -half + 40, half - 40), pos.Y, math.clamp(pos.Z + math.sin(a) * r, -half + 40, half - 40))
	end
	brain.mode = "roam"
	brain.target = brain.wander
end

local function drive(identity, state, dt: number)
	local part = state.part
	if not part or not part.Parent or part.Anchored then
		return
	end
	local brain = identity.brain
	local d = state.diameter
	local pos = part.Position
	local now = os.clock()
	if pos.Y < Tuning.Ball.VoidY then
		local spawns = services.WorldService:spawnPoints()
		if #spawns > 0 then
			services.BallService:teleport(state, spawns[math.random(1, #spawns)] + Vector3.new(0, d, 0))
		end
		return
	end
	if now >= brain.nextThink then
		brain.nextThink = now + 0.2 + math.random() * 0.2
		think(identity, state)
	end
	local dirX, dirZ = 0, 0
	if brain.target then
		local to = Vector3.new(brain.target.X - pos.X, 0, brain.target.Z - pos.Z)
		if to.Magnitude > 0.5 then
			to = to.Unit
			dirX, dirZ = to.X, to.Z
		end
	end
	local result = Workspace:Raycast(pos, Vector3.new(0, -(d / 2 + math.max(0.6, d * 0.12)), 0), rayParams)
	local grounded = result ~= nil
	local dashing = now < (brain.dashUntil or 0)
	local v = part.AssemblyLinearVelocity
	local nvx, nvz = MovementModel.step(v.X, v.Z, d, {
		dirX = dirX,
		dirZ = dirZ,
		grounded = grounded,
		dashing = dashing,
		speedMult = brain.skill * (if services.EventService then services.EventService:speedMultiplier() else 1),
	}, dt)
	local vy = v.Y
	-- Dash: same cooldown as players.
	if brain.dashWanted and grounded and now - brain.lastDash > Tuning.Ball.DashCooldown * 1.3 and (dirX ~= 0 or dirZ ~= 0) then
		brain.lastDash = now
		brain.dashUntil = now + Tuning.Ball.DashDuration
		local boost = Growth.maxSpeed(d) * brain.skill * Tuning.Ball.DashBoost
		nvx += dirX * boost
		nvz += dirZ * boost
		vy = math.max(vy, 0) + 4
	end
	-- Stuck (pushing into a counter/obstacle): hop and pick somewhere else.
	local speed = math.sqrt(nvx * nvx + nvz * nvz)
	if brain.target and speed < Growth.maxSpeed(d) * 0.12 then
		brain.stuckSince = brain.stuckSince or now
		if now - brain.stuckSince > 0.9 and grounded and now - brain.lastHop > 1.2 then
			brain.lastHop = now
			vy = math.sqrt(2 * Workspace.Gravity * Growth.hopHeight(d) * (if services.EventService then services.EventService:hopMultiplier() else 1))
			brain.wander = nil
			brain.target = nil
			brain.nextThink = now + 0.4
		end
	else
		brain.stuckSince = nil
	end
	part.AssemblyLinearVelocity = Vector3.new(nvx, vy, nvz)
	if grounded then
		local spin = Vector3.yAxis:Cross(Vector3.new(nvx, 0, nvz)) / math.max(d / 2, 0.1)
		part.AssemblyAngularVelocity = part.AssemblyAngularVelocity:Lerp(spin, math.min(1, dt * 12))
	end
	-- Keep the bot's avatar balancing on top, facing travel.
	local character = identity.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if hrp and humanoid then
		local top = part.Position + Vector3.new(0, d / 2 + humanoid.HipHeight + hrp.Size.Y / 2, 0)
		local face = if speed > 1 then Vector3.new(nvx, 0, nvz).Unit else hrp.CFrame.LookVector * Vector3.new(1, 0, 1)
		if face.Magnitude < 1e-3 then
			face = Vector3.new(0, 0, -1)
		end
		hrp.CFrame = CFrame.lookAt(top, top + face)
		hrp.AssemblyLinearVelocity = part.AssemblyLinearVelocity
		if identity.runTrack then
			identity.runTrack:AdjustSpeed(math.clamp(0.6 + speed / math.max(Growth.maxSpeed(d), 1) * 1.6, 0.4, 2.4))
		end
	end
end

local function manage()
	local round = services.RoundService
	if not round or not round:isPlaying() then
		return
	end
	local want = BotService:wanted()
	local have = #BotService.bots
	if have < want then
		BotService:add()
		-- Early in a round, fill up quickly so the map is lively from the start.
		if want - have > 1 and round:timeLeft() > Tuning.Round.Length - 30 then
			task.delay(1.2, function()
				if #BotService.bots < BotService:wanted() and round:isPlaying() then
					BotService:add()
				end
			end)
		end
	elseif have > want then
		-- Leave gracefully: the smallest bot pops out.
		local smallest, smallestD = nil, math.huge
		for _, b in BotService.bots do
			local st = services.BallService:get(b)
			local dd = if st then st.diameter else 0
			if dd < smallestD then
				smallest, smallestD = b, dd
			end
		end
		if smallest then
			BotService:remove(smallest, true)
		end
	end
end

function BotService:start()
	local round = services.RoundService
	AvatarPool.start()
	round.RoundStarted:Connect(function()
		rayParams.FilterDescendantsInstances = { services.BallService.folder, folder }
		-- Bots who stayed from last round rejoin one by one, like players loading in.
		for i, b in table.clone(self.bots) do
			task.delay(0.3 + i * 0.35 + math.random() * 0.4, function()
				if table.find(self.bots, b) and round:isPlaying() and not services.BallService:get(b) then
					self:spawnBall(b)
					if i <= 2 then
						self:say(b, "hello", 0.5, "Wave")
					end
				end
			end)
		end
	end)
	round.RoundEnded:Connect(function()
		for _, b in table.clone(self.bots) do
			self:say(b, "gg", 0.55, "Cheer")
		end
		task.delay(2.5, function()
			for _, b in table.clone(self.bots) do
				-- Some bots "leave" between rounds and new ones join next round, like a real server.
				if math.random() < 0.35 then
					self:remove(b, false)
				else
					services.BallService:remove(b, "round_end")
					if b.runTrack then
						b.runTrack:Stop()
					end
					if b.Character then
						b.Character:Destroy()
						b.Character = nil
					end
				end
			end
		end)
	end)
	round.FinalRollStarted:Connect(function()
		self:say(randomBot(), "finalRoll", 0.8, "Point")
	end)
	if services.PvpService then
		services.PvpService.Rolled:Connect(function(host, victim)
			if host and host.player and host.player.IsBot then
				self:say(host.player, "rolledSomeone", 0.6, "Cheer")
			end
			if victim and victim.IsBot then
				self:say(victim, "gotRolled", 0.7, "Laugh")
			end
		end)
		services.PvpService.Burst:Connect(function(rider)
			if rider and rider.IsBot then
				self:say(rider, "burst", 0.6)
			end
		end)
	end
	if services.EventService then
		services.EventService.Started:Connect(function(def, info)
			local kind = if def.giant then "giant" else "event"
			self:say(randomBot(function(b)
				return info == nil or info.giantName ~= b.DisplayName
			end), kind, 0.85)
		end)
	end
	rayParams.FilterDescendantsInstances = { services.BallService.folder, folder }
	RunService.Heartbeat:Connect(function(dt)
		for _, identity in self.bots do
			local state = services.BallService:get(identity)
			if state and state.alive then
				local ok, err = pcall(drive, identity, state, dt)
				if not ok then
					warn("[Bots] drive: " .. tostring(err))
				end
			end
		end
	end)
	task.spawn(function()
		while true do
			task.wait(Tuning.Bots.ManageInterval)
			local ok, err = pcall(manage)
			if not ok then
				warn("[Bots] manage: " .. tostring(err))
			end
		end
	end)
end

return BotService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="75">
          <Properties>
            <string name="Name">CritterService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Simulates living props (ants, ducks, cats, rare roamers): wander, flee from balls that could roll
-- them up, and occasionally stampede. State is replicated compactly; clients animate.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local PropCodec = require(Shared.Util.PropCodec)
local Absorb = require(Shared.Logic.Absorb)
local Tuning = require(Shared.Config.Tuning)

local CritterService = {}

-- state byte sent to clients: 0 idle, 1 walk, 2 flee, 3 stampede
local IDLE, WALK, FLEE, STAMPEDE = 0, 1, 2, 3

local services
local critters: { [number]: any } = {}

function CritterService:init(s)
	services = s
end

local function register(prop)
	local def = prop.def
	local c = def.critter
	critters[prop.id] = {
		id = prop.id,
		speed = c.speed * prop.effScale ^ 0.5,
		fleeMult = c.flee or 1,
		style = c.style,
		homeY = prop.y,
		platform = services.WorldService:platformAt(prop.x, prop.z),
		yaw = prop.yaw,
		state = IDLE,
		target = nil,
		nextThink = 0,
		dirty = true,
		stampedeUntil = 0,
		stampedeDir = nil,
	}
end

local function rebuild()
	table.clear(critters)
	for _, prop in services.WorldService.props do
		if prop.critter then
			register(prop)
		end
	end
end

-- Spawn extra critters for the Stampede event: a herd that runs across the map.
function CritterService:stampede(uids: { number }, count: number)
	local world = services.WorldService
	local kit = world.kit
	if not kit or #uids == 0 then
		return
	end
	local H = kit.arenaHalf
	local side = math.random(0, 3)
	local dir = ({ Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0), Vector3.new(0, 0, 1), Vector3.new(0, 0, -1) })[side + 1]
	local entries = {}
	for _ = 1, count do
		local along = (math.random() - 0.5) * H * 1.4
		local start = -dir * (H - 60) + Vector3.new(dir.Z, 0, dir.X) * along
		local ground = world:groundAt(start.X, start.Z)
		table.insert(entries, {
			uid = uids[math.random(1, #uids)],
			mutation = 0,
			scale = 0.9 + math.random() * 0.3,
			from = Vector3.new(start.X, ground + 80, start.Z),
			to = Vector3.new(start.X, ground, start.Z),
			settle = 0.8,
		})
	end
	local ids = world:spawnLoot(entries)
	for _, id in ids do
		local prop = world:get(id)
		if prop and prop.def.critter then
			prop.expiresAt = os.clock() + 50
			register(prop)
			local c = critters[id]
			c.stampedeUntil = os.clock() + 40
			c.stampedeDir = dir
			c.state = STAMPEDE
		end
	end
end

-- One golden critter that runs from EVERY ball and must be chased down (Golden Runner event).
-- Returns the prop id.
function CritterService:spawnRunner(uid: number, mutation: number, position: Vector3, speed: number): number?
	local world = services.WorldService
	local ground = world:groundAt(position.X, position.Z)
	local ids = world:spawnLoot({
		{
			uid = uid,
			mutation = mutation,
			scale = 1,
			from = Vector3.new(position.X, ground + 120, position.Z),
			to = Vector3.new(position.X, ground, position.Z),
			settle = 1.2,
		},
	})
	local id = ids[1]
	local prop = id and world:get(id)
	if not prop or not prop.def.critter then
		return nil
	end
	prop.expiresAt = os.clock() + 60
	register(prop)
	local c = critters[id]
	c.runner = true
	c.runnerSince = os.clock()
	c.speed = speed
	c.platform = nil -- runs anywhere on the floor
	c.fleeMult = 1
	return id
end

local function insidePlatform(p, x: number, z: number, margin: number): boolean
	return math.abs(x - p.x) <= p.sx / 2 - margin and math.abs(z - p.z) <= p.sz / 2 - margin
end

-- Keep critters on the surface they started on: floor critters avoid platform blocks,
-- platform critters stay on top.
local function constrain(c, x: number, z: number): (number, number, boolean)
	local world = services.WorldService
	local H = world.kit.arenaHalf - 30
	local bumped = false
	if math.abs(x) > H or math.abs(z) > H then
		x, z = math.clamp(x, -H, H), math.clamp(z, -H, H)
		bumped = true
	end
	if c.platform then
		local p = c.platform
		if not insidePlatform(p, x, z, 3) then
			x = math.clamp(x, p.x - p.sx / 2 + 3, p.x + p.sx / 2 - 3)
			z = math.clamp(z, p.z - p.sz / 2 + 3, p.z + p.sz / 2 - 3)
			bumped = true
		end
	else
		for _, p in world.generation.platforms do
			if p.kind ~= "table" and insidePlatform(p, x, z, -4) then
				return nil :: any, nil :: any, true
			end
		end
	end
	return x, z, bumped
end

local function tick(dt: number)
	local world = services.WorldService
	if not world.kit then
		return
	end
	local balls = services.BallService:all()
	local nowT = os.clock()
	local ctx = { ratioBonus = if services.EventService then services.EventService:absorbRatioBonus() else 0 }
	for id, c in critters do
		local prop = world:get(id)
		if not prop then
			critters[id] = nil
			continue
		end
		local x, z = prop.x, prop.z
		-- Find the most threatening ball (one that can absorb us) within flee range.
		local threat, threatDist = nil, math.huge
		for _, ball in balls do
			if c.runner or Absorb.canAbsorbProp(ball.diameter, prop.absorbSize, false, ctx) then
				local pos = ball.part.Position
				local dx, dz = x - pos.X, z - pos.Z
				local dist = math.sqrt(dx * dx + dz * dz)
				local range = if c.runner then 90 + ball.diameter * 2 else ball.diameter * Tuning.World.CritterFleeRange * c.fleeMult + prop.radius * 4
				if dist < range and dist < threatDist then
					threat, threatDist = pos, dist
				end
			end
		end
		local moveDir: Vector3? = nil
		local speed = c.speed
		local newState = c.state
		if c.stampedeUntil > nowT and c.stampedeDir then
			moveDir = c.stampedeDir
			speed *= 2.2
			newState = STAMPEDE
		elseif threat ~= nil then
			local t: Vector3 = threat
			local away = Vector3.new(x - t.X, 0, z - t.Z)
			local fleeDir = if away.Magnitude > 0.01 then away.Unit else Vector3.new(1, 0, 0)
			-- A little zig-zag so fleeing reads as panicky-cute rather than robotic.
			local wobble = math.sin(nowT * 6 + id) * 0.5
			moveDir = CFrame.Angles(0, wobble, 0):VectorToWorldSpace(fleeDir)
			speed *= if c.runner then 1 else 1.6
			if c.runner then
				-- It tires out over time so persistent chasers win.
				speed *= math.clamp(1 - (nowT - (c.runnerSince or nowT)) / 50, 0.55, 1)
			end
			newState = FLEE
		else
			if nowT >= c.nextThink then
				c.nextThink = nowT + 1.5 + math.random() * 3.5
				if math.random() < 0.35 then
					c.target = nil
					newState = IDLE
				else
					local a = math.random() * math.pi * 2
					local r = 10 + math.random() * 40 * prop.effScale
					c.target = Vector3.new(x + math.cos(a) * r, 0, z + math.sin(a) * r)
					newState = WALK
				end
			end
			if c.target then
				local to = Vector3.new(c.target.X - x, 0, c.target.Z - z)
				if to.Magnitude < 1 then
					c.target = nil
					newState = IDLE
				else
					moveDir = to.Unit
				end
			end
		end
		if moveDir then
			local nx, nz = x + moveDir.X * speed * dt, z + moveDir.Z * speed * dt
			local cx, cz, bumped = constrain(c, nx, nz)
			if cx == nil then
				-- Blocked by a counter: turn around.
				c.target = nil
				if c.stampedeDir then
					c.stampedeDir = -c.stampedeDir
				end
			else
				if bumped and c.stampedeUntil > nowT then
					c.stampedeUntil = 0
				end
				local yaw = math.atan2(moveDir.X, moveDir.Z)
				world:moveProp(id, cx, prop.y, cz, yaw)
				c.yaw = yaw
				c.dirty = true
			end
		end
		if newState ~= c.state then
			c.state = newState
			c.dirty = true
		end
	end
end

local function broadcast()
	local records = {}
	for id, c in critters do
		if c.dirty then
			local prop = services.WorldService:get(id)
			if prop then
				table.insert(records, { id = id, x = prop.x, y = prop.y, z = prop.z, yaw = c.yaw, state = c.state })
			end
			c.dirty = false
		end
	end
	if #records > 0 then
		Net.fireAll("CritterState", PropCodec.encodeCritters(records))
	end
end

function CritterService:start()
	services.WorldService.WorldLoaded:Connect(rebuild)
	local rate = 1 / Tuning.World.CritterTickRate
	task.spawn(function()
		local last = os.clock()
		local sendAcc = 0
		while true do
			task.wait(rate)
			local t = os.clock()
			local dt = math.min(t - last, 0.3)
			last = t
			local playing = services.RoundService == nil or services.RoundService:isPlaying()
			if playing then
				local ok, err = pcall(tick, dt)
				if not ok then
					warn("[Critter] tick: " .. tostring(err))
				end
				sendAcc += dt
				if sendAcc >= 1 / 8 then
					sendAcc = 0
					broadcast()
				end
			end
		end
	end)
end

return CritterService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="76">
          <Properties>
            <string name="Name">DevService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Studio-only feel-tuning backend for the in-game Tuning Panel. Lets the developer change tuning
-- values live (applied on server AND the requesting client), resize their ball and restart the
-- round. Completely inert in live servers.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Guard = require(Shared.Util.Guard)
local Tuning = require(Shared.Config.Tuning)
local Events = require(Shared.Data.Events)

local DevService = {}

local services

-- Only these leaves are tunable from the panel.
DevService.Allowed = {
	["Ball.SpeedBase"] = true,
	["Ball.SpeedExponent"] = true,
	["Ball.AccelTimeSmall"] = true,
	["Ball.AccelTimeHuge"] = true,
	["Ball.TurnAssist"] = true,
	["Ball.BrakeTimeSmall"] = true,
	["Ball.BrakeTimeHuge"] = true,
	["Ball.AirControl"] = true,
	["Ball.HopPerDiameter"] = true,
	["Ball.DashBoost"] = true,
	["Ball.DashCooldown"] = true,
	["Absorb.Ratio"] = true,
	["Growth.Gain"] = true,
	["Growth.EarlyBoost"] = true,
	["Growth.EarlyScale"] = true,
	["Camera.BaseDistance"] = true,
	["Camera.DistancePerDiameter"] = true,
	["Camera.HeightPerDiameter"] = true,
	["Camera.FovSpeedBonus"] = true,
	["Camera.YawSharpness"] = true,
	["Round.Length"] = true,
}

function DevService.apply(path: string, value: number): boolean
	if not DevService.Allowed[path] then
		return false
	end
	local section, key = path:match("^(%w+)%.(%w+)$")
	local tbl = section and (Tuning :: any)[section]
	if not tbl or type(tbl[key]) ~= "number" then
		return false
	end
	tbl[key] = value
	return true
end

local function isDev(player: Player): boolean
	return RunService:IsStudio() and player.Parent ~= nil
end

function DevService:init(s)
	services = s
end

function DevService:start()
	if not RunService:IsStudio() then
		return
	end
	Net.action("DevTuning", Guard.shape({ path = Guard.string(48), value = Guard.number(-1e5, 1e5) }), function(player, payload)
		if not isDev(player) then
			return false
		end
		local ok = DevService.apply(payload.path, payload.value)
		if ok then
			print(string.format("[Tuning] %s = %s", payload.path, tostring(payload.value)))
		end
		return ok
	end, 20)
	Net.action("DevCommand", Guard.shape({ cmd = Guard.string(24), arg = Guard.optional(Guard.number(-1e5, 1e5)) }), function(player, payload)
		if not isDev(player) then
			return false
		end
		local ball = services.BallService:get(player)
		if payload.cmd == "scale" and ball then
			services.BallService:setDiameter(ball, ball.diameter * (payload.arg or 2), "dev")
			return true
		elseif payload.cmd == "reset" and ball then
			services.BallService:setDiameter(ball, Tuning.Ball.StartDiameter, "dev")
			return true
		elseif payload.cmd == "finalroll" and services.RoundService:isPlaying() then
			services.RoundService.endsAt = workspace:GetServerTimeNow() + Tuning.Round.FinalRoll
			return true
		elseif payload.cmd == "event" and services.EventService then
			local def = Events.List[math.floor(payload.arg or 1)]
			if def then
				services.EventService:stop()
				return services.EventService:trigger(def.id, player.DisplayName)
			end
			return false
		elseif payload.cmd == "endround" and services.RoundService:isPlaying() then
			services.RoundService.endsAt = workspace:GetServerTimeNow() + 1
			return true
		end
		return false
	end, 10)
end

return DevService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="77">
          <Properties>
            <string name="Name">EventService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- World events: the round's chaos layer. Two big events per round (Meteor Shower, Sticky Rain,
-- Golden Hour, Stampede, Low Gravity, Giant Moment) plus small surprises in between (Supply Drop,
-- Growth Frenzy, Shooting Stars) so no two rounds play the same. Purchases and dev commands can
-- start one too; if something is already running they queue.
--
-- Gameplay modifiers are applied here (absorb ratio, growth, Stardust, gravity, spawned props);
-- clients get the active event through the RoundState snapshot and a WorldEvent ping for banners,
-- weather and lighting.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)
local Absorb = require(Shared.Logic.Absorb)
local PropLibrary = require(Shared.Logic.PropLibrary)
local Growth = require(Shared.Logic.Growth)
local Events = require(Shared.Data.Events)
local Mutations = require(Shared.Data.Mutations)
local Mutators = require(Shared.Data.Mutators)

local EventService = {}
EventService.Started = Signal.new() -- (def, info)
EventService.Ended = Signal.new() -- (def)

local services
local active = nil -- { def, startedAt, endsAt, info, token }
local queue: { { id: string, by: string? } } = {}
local usedThisRound: { [string]: boolean } = {}
local nextMinorAt = math.huge
local baseGravity = Workspace.Gravity
local token = 0

local MINOR_GAP_MIN, MINOR_GAP_MAX = 38, 62
local mutator = nil -- this round's MutatorDef (or nil)

local function minorGap(): (number, number)
	local round = services and services.RoundService
	local gap = round and round:mode().minorGap
	if gap then
		return gap[1], gap[2]
	end
	return MINOR_GAP_MIN, MINOR_GAP_MAX
end

-- Gravity for "no event running": the round mutator may lower it.
local function restingGravity(): number
	return baseGravity * (if mutator and mutator.gravityMult then mutator.gravityMult else 1)
end
local GOLDEN = (Mutations.ById.Golden and Mutations.ById.Golden.index) or 1
local STARFALL = (Mutations.ById.Starfall and Mutations.ById.Starfall.index) or 5

local function now(): number
	return Workspace:GetServerTimeNow()
end

function EventService:init(s)
	services = s
end

-- MODIFIER QUERIES ------------------------------------------------------------------------

function EventService:absorbRatioBonus(): number
	local bonus = if active and active.def.ratioBonus then active.def.ratioBonus else 0
	if mutator and mutator.ratioBonus then
		bonus += mutator.ratioBonus
	end
	return bonus
end

function EventService:growthMultiplier(state): number
	local mult = 1
	if active then
		mult *= active.def.growthMult or 1
		if active.giantId and state and state.userId == active.giantId then
			mult *= 3
		end
	end
	if mutator and mutator.growthMult then
		mult *= mutator.growthMult
	end
	local round = services.RoundService
	if round then
		mult *= round:mode().growthMult or 1
	end
	return mult
end

function EventService:speedMultiplier(): number
	local mult = if active and active.def.speedMult then active.def.speedMult else 1
	if mutator and mutator.speedMult then
		mult *= mutator.speedMult
	end
	return mult
end

function EventService:hopMultiplier(): number
	local mult = if mutator and mutator.hopMult then mutator.hopMult else 1
	if active and active.def.gravityMult then
		mult *= 1.8
	end
	return mult
end

-- Everything the client needs to predict absorbs and movement, combined.
function EventService:mods()
	return {
		ratioBonus = self:absorbRatioBonus(),
		speedMult = self:speedMultiplier(),
		hopMult = self:hopMultiplier(),
	}
end

function EventService:mutatorId(): string?
	return mutator and mutator.id or nil
end

function EventService:chooseMutator(allowed: boolean)
	mutator = nil
	if allowed and math.random() < Mutators.Chance then
		local total = 0
		for _, m in Mutators.List do
			total += m.weight
		end
		local r = math.random() * total
		for _, m in Mutators.List do
			r -= m.weight
			if r <= 0 then
				mutator = m
				break
			end
		end
	end
	Workspace.Gravity = restingGravity()
end

-- Before the map is sent: Gold Rush gilds a share of props; mutators sprinkle mutations.
local NATURAL_MUTATIONS = {}
for _, m in Mutations.List do
	if m.weight > 0 and m.scale == 1 then
		table.insert(NATURAL_MUTATIONS, m.index)
	end
end

function EventService:prepareWorld(world, mode)
	local goldShare = mode and mode.goldenShare or 0
	local mutShare = mutator and mutator.mutationShare or 0
	if goldShare <= 0 and mutShare <= 0 then
		return
	end
	for id, p in world.props do
		if p.mutation == 0 and not p.landmark then
			local r = math.random()
			if r < goldShare then
				world:setMutation(id, GOLDEN)
			elseif r < goldShare + mutShare and #NATURAL_MUTATIONS > 0 then
				world:setMutation(id, NATURAL_MUTATIONS[math.random(1, #NATURAL_MUTATIONS)])
			end
		end
	end
end

function EventService:stardustMultiplier(): number
	return if active and active.def.stardustMult then active.def.stardustMult else 1
end

function EventService:isActive(id: string?): boolean
	if not active then
		return false
	end
	return id == nil or active.def.id == id
end

-- Compact description for the RoundState snapshot (nil when nothing is running).
function EventService:current()
	if not active then
		return nil
	end
	local def = active.def
	return {
		id = def.id,
		name = def.name,
		icon = def.icon,
		color = def.color,
		description = def.description,
		startedAt = active.startedAt,
		endsAt = active.endsAt,
		ratioBonus = def.ratioBonus,
		speedMult = def.speedMult,
		growthMult = def.growthMult,
		gravityMult = def.gravityMult,
		weather = def.weather,
		lighting = def.lighting,
		giantId = active.giantId,
		pos = active.info.pos,
		propId = active.info.propId,
	}
end

-- HELPERS ---------------------------------------------------------------------------------

local function playable(): boolean
	local round = services.RoundService
	return round ~= nil and round:isPlaying()
end

local function liveBalls()
	local out = {}
	for _, state in services.BallService:all() do
		if state.alive ~= false and state.part and state.part.Parent then
			table.insert(out, state)
		end
	end
	return out
end

-- Kit props sized for a ball of diameter d (a fraction band of its absorb threshold).
local function propsForSize(kit, d: number, lo: number, hi: number): { number }
	local threshold = Absorb.threshold(d, { ratioBonus = EventService:absorbRatioBonus() })
	local out = {}
	for _, def in (PropLibrary.ByKit[kit.id] or {}) :: { any } do
		local s = def.metrics.absorbSize
		if not def.critter and not def.landmark and s >= threshold * lo and s <= threshold * hi then
			table.insert(out, def.uid)
		end
	end
	if #out == 0 then
		-- Tiny balls: fall back to the smallest props in the kit.
		local smallest, best = nil, math.huge
		for _, def in (PropLibrary.ByKit[kit.id] or {}) :: { any } do
			if not def.critter and not def.landmark and def.metrics.absorbSize < best then
				smallest, best = def.uid, def.metrics.absorbSize
			end
		end
		if smallest then
			table.insert(out, smallest)
		end
	end
	return out
end

local function critterUids(kit): { number }
	local out = {}
	for _, def in (PropLibrary.ByKit[kit.id] or {}) :: { any } do
		if def.critter and not def.landmark then
			table.insert(out, def.uid)
		end
	end
	return out
end

local function clampToArena(kit, x: number, z: number): (number, number)
	local H = kit.arenaHalf - 30
	return math.clamp(x, -H, H), math.clamp(z, -H, H)
end

-- EFFECTS ---------------------------------------------------------------------------------

-- One meteor near a random ball, sized so that ball can grab it: everyone gets a share.
local function dropMeteor()
	local world = services.WorldService
	local kit = world.kit
	local balls = liveBalls()
	if not kit or #balls == 0 then
		return
	end
	local target = balls[math.random(1, #balls)]
	local d = target.diameter
	local pool = propsForSize(kit, d, 0.3, 0.85)
	if #pool == 0 then
		return
	end
	local pos = target.part.Position
	local v = target.part.AssemblyLinearVelocity
	-- Land ahead of where the ball is heading so chasing meteors feels natural.
	local a = math.random() * math.pi * 2
	local dist = d * 1.2 + 10 + math.random() * (30 + d * 3)
	local x, z = clampToArena(kit, pos.X + v.X * 1.2 + math.cos(a) * dist, pos.Z + v.Z * 1.2 + math.sin(a) * dist)
	local ground = world:groundAt(x, z)
	local fromDir = Vector3.new(math.cos(a + 2.4), 0, math.sin(a + 2.4))
	local height = 260 + d * 4
	world:spawnLoot({
		{
			uid = pool[math.random(1, #pool)],
			mutation = STARFALL,
			scale = 0.9 + math.random() * 0.3,
			from = Vector3.new(x, ground + height, z) + fromDir * height * 0.6,
			to = Vector3.new(x, ground, z),
			settle = 1.6,
		},
	})
end

-- Golden Hour: turn a share of the props near each ball golden, a few at a time.
local function goldenTick(share: number)
	local world = services.WorldService
	for _, state in liveBalls() do
		local pos = state.part.Position
		local d = state.diameter
		local threshold = Absorb.threshold(d, { ratioBonus = 0 })
		local near = world:queryNear(pos.X, pos.Z, 80 + d * 4)
		local turned = 0
		local budget = math.max(1, math.floor(#near * share * 0.25))
		for _, id in near do
			if turned >= budget then
				break
			end
			local p = world:get(id)
			if p and p.mutation == 0 and not p.landmark and not p.critter and p.absorbSize <= threshold * 1.4 and math.random() < share then
				world:setMutation(id, GOLDEN)
				turned += 1
			end
		end
	end
end

-- A pile of goodies for every size somewhere reachable, announced so everyone races for it.
local function supplyDrop(count: number): Vector3?
	local world = services.WorldService
	local kit = world.kit
	local balls = liveBalls()
	if not kit or #balls == 0 then
		return nil
	end
	-- Centre the drop between the balls (slightly randomised) so it's a race, not a gift.
	local cx, cz = 0, 0
	for _, s in balls do
		cx += s.part.Position.X
		cz += s.part.Position.Z
	end
	cx /= #balls
	cz /= #balls
	local a = math.random() * math.pi * 2
	local x, z = clampToArena(kit, cx + math.cos(a) * (60 + math.random() * 90), cz + math.sin(a) * (60 + math.random() * 90))
	local ground = world:groundAt(x, z)
	local entries = {}
	for i = 1, count do
		local sizer = balls[((i - 1) % #balls) + 1]
		local pool = propsForSize(kit, sizer.diameter, 0.25, 0.9)
		if #pool > 0 then
			local r = math.sqrt(math.random()) * (14 + sizer.diameter * 0.8)
			local t = math.random() * math.pi * 2
			local lx, lz = clampToArena(kit, x + math.cos(t) * r, z + math.sin(t) * r)
			table.insert(entries, {
				uid = pool[math.random(1, #pool)],
				mutation = if math.random() < 0.08 then GOLDEN else 0,
				scale = 0.9 + math.random() * 0.3,
				from = Vector3.new(x, ground + 220, z),
				to = Vector3.new(lx, world:groundAt(lx, lz), lz),
				settle = 1.3 + math.random() * 0.5,
			})
		end
	end
	world:spawnLoot(entries)
	return Vector3.new(x, ground, z)
end

-- Giant Moment: a ball outside the lead gets a burst of growth so the pecking order flips.
-- Golden Runner: a golden critter most balls can catch, fast enough to need a real chase.
local function spawnRunner(): number?
	local world = services.WorldService
	local kit = world.kit
	local balls = liveBalls()
	if not kit or #balls == 0 or not services.CritterService then
		return nil
	end
	local sizes = {}
	local cx, cz = 0, 0
	for _, b in balls do
		table.insert(sizes, b.diameter)
		cx += b.part.Position.X
		cz += b.part.Position.Z
	end
	table.sort(sizes)
	local median = sizes[math.ceil(#sizes / 2)]
	local threshold = Absorb.threshold(median, { ratioBonus = EventService:absorbRatioBonus() })
	local pick, pickSize, smallest, smallestSize = nil, -1, nil, math.huge
	for _, def in (PropLibrary.ByKit[kit.id] or {}) :: { any } do
		if def.critter and not def.landmark then
			local size = def.metrics.absorbSize
			if size <= threshold * 0.8 and size > pickSize then
				pick, pickSize = def, size
			end
			if size < smallestSize then
				smallest, smallestSize = def, size
			end
		end
	end
	pick = pick or smallest
	if not pick then
		return nil
	end
	-- Somewhere on open floor between the players.
	cx /= #balls
	cz /= #balls
	local spot = nil
	for _ = 1, 20 do
		local a = math.random() * math.pi * 2
		local r = 80 + math.random() * 120
		local x, z = clampToArena(kit, cx + math.cos(a) * r, cz + math.sin(a) * r)
		local p = world:platformAt(x, z)
		if not p or p.kind == "table" then
			spot = Vector3.new(x, 0, z)
			break
		end
	end
	if not spot then
		return nil
	end
	local speed = Growth.maxSpeed(median) * 0.8
	return services.CritterService:spawnRunner(pick.uid, GOLDEN, spot, speed)
end

local function pickGiant()
	local balls = liveBalls()
	if #balls == 0 then
		return nil
	end
	table.sort(balls, function(a, b)
		return a.diameter > b.diameter
	end)
	local from = if #balls >= 3 then 2 else 1
	local pick = balls[math.random(from, #balls)]
	return pick
end

-- LIFECYCLE -------------------------------------------------------------------------------

local function stop()
	if not active then
		return
	end
	local def = active.def
	active.token = -1
	active = nil
	if def.gravityMult then
		Workspace.Gravity = restingGravity()
	end
	Net.fireAll("WorldEvent", nil, { id = def.id, ended = true })
	EventService.Ended:Fire(def)
	if services.RoundService then
		services.RoundService:broadcast()
	end
end

local function run(def, by: string?): boolean
	if active then
		stop()
	end
	token += 1
	local myToken = token
	local startedAt = now()
	active = {
		def = def,
		startedAt = startedAt,
		endsAt = startedAt + def.duration,
		info = { by = by },
		token = myToken,
	}
	usedThisRound[def.id] = true
	local state = active

	if def.gravityMult then
		Workspace.Gravity = restingGravity() * def.gravityMult
	end
	if def.supplyDrop then
		state.info.pos = supplyDrop(def.supplyDrop)
	end
	if def.goldenRunner then
		state.info.propId = spawnRunner()
	end
	if def.stampede then
		local kit = services.WorldService.kit
		if kit and services.CritterService then
			local uids = critterUids(kit)
			if #uids > 0 then
				services.CritterService:stampede(uids, def.stampede)
			end
		end
	end
	if def.giant then
		local giant = pickGiant()
		if giant then
			state.giantId = giant.userId
			state.info.giantName = giant.player.DisplayName
			-- Instant pop so it's visible right away, then the 3x growth carries it.
			services.BallService:setDiameter(giant, giant.diameter * 1.45, "event")
			giant.part:SetAttribute("Giant", true)
		end
	end

	Net.fireAll("WorldEvent", def.id, {
		name = def.name,
		icon = def.icon,
		color = def.color,
		description = def.description,
		endsAt = state.endsAt,
		by = by,
		pos = state.info.pos,
		giantId = state.giantId,
		giantName = state.info.giantName,
		propId = state.info.propId,
		weather = def.weather,
		lighting = def.lighting,
	})
	EventService.Started:Fire(def, state.info)
	if services.RoundService then
		services.RoundService:broadcast()
	end
	if services.AnalyticsService and services.AnalyticsService.event then
		services.AnalyticsService:event("WorldEvent", def.id)
	end

	-- Ongoing effects run until the event ends or is replaced.
	task.spawn(function()
		local meteorAcc, goldenAcc = 0, 0
		local last = os.clock()
		while active == state and state.token == myToken and now() < state.endsAt and playable() do
			task.wait(0.1)
			local t = os.clock()
			local dt = t - last
			last = t
			if def.meteors then
				-- Scale with player count a little so busy servers get a proper shower.
				local rate = def.meteors * (1 + math.min(#liveBalls(), 10) * 0.12)
				meteorAcc += dt * rate
				while meteorAcc >= 1 do
					meteorAcc -= 1
					dropMeteor()
				end
			end
			if def.mutation == "Golden" then
				goldenAcc += dt
				if goldenAcc >= 2 then
					goldenAcc = 0
					goldenTick(def.mutationShare or 0.1)
				end
			end
		end
		if state.giantId then
			local giant = services.BallService:getByUserId(state.giantId)
			if giant and giant.part then
				giant.part:SetAttribute("Giant", nil)
			end
		end
		if active == state then
			stop()
		end
	end)
	return true
end

-- Weighted pick among events of one kind, avoiding repeats within a round when possible.
local function pick(major: boolean)
	local pool, total = {}, 0
	for _, def in Events.List do
		if def.major == major and not usedThisRound[def.id] then
			-- Giant Moment needs at least two balls to be meaningful.
			if not (def.giant and #liveBalls() < 2) then
				table.insert(pool, def)
				total += def.weight
			end
		end
	end
	if #pool == 0 then
		table.clear(usedThisRound)
		return pick(major)
	end
	local r = math.random() * total
	for _, def in pool do
		r -= def.weight
		if r <= 0 then
			return def
		end
	end
	return pool[#pool]
end

-- Called by RoundService at the scheduled times: the round's big moment.
function EventService:triggerRoundEvent()
	if not playable() then
		return
	end
	-- A purchased event waiting in line takes the slot.
	if #queue > 0 then
		local q = table.remove(queue, 1)
		local def = Events.get(q.id)
		if def then
			run(def, q.by)
			return
		end
	end
	run(pick(true), nil)
	nextMinorAt = math.max(nextMinorAt, active.endsAt + (minorGap()) * 0.6)
end

-- Purchases / dev commands. Returns true if started now, false if queued.
function EventService:trigger(id: string, by: string?): boolean
	local def = Events.get(id)
	if not def then
		return false
	end
	if active or not playable() then
		table.insert(queue, { id = id, by = by })
		return false
	end
	run(def, by)
	return true
end

function EventService:stop()
	stop()
end

function EventService:start()
	baseGravity = Workspace.Gravity
	services.AbsorbService.Absorbed:Connect(function(ballState, prop, info)
		if not active or not active.info.propId or prop.id ~= active.info.propId or (info and info.shared) then
			return
		end
		local player = ballState.player
		Net.fireAll("Announce", "runnerCaught", { userId = ballState.userId, name = player.DisplayName })
		if Net.isPlayer(player) and services.PlayerDataService then
			services.PlayerDataService:grantStardust(player, 250, "GoldenRunner")
			if services.ProgressionService then
				services.ProgressionService:addXp(player, 60)
			end
			Net.fire("Toast", player, "warning", { text = "🏃 You caught the Golden Runner! +250 ✨ +60 XP" })
		end
		if services.BotService and player.IsBot then
			services.BotService:say(player, "rolledSomeone", 1, "Cheer")
		end
		stop()
	end)
	local round = services.RoundService
	round.RoundStarted:Connect(function()
		table.clear(usedThisRound)
		nextMinorAt = now() + (minorGap()) * 0.9 + math.random() * 15
		-- Critter Party: a big herd joins right away.
		task.delay(4, function()
			if mutator and mutator.critterParty and services.CritterService then
				local kit = services.WorldService.kit
				local uids = kit and critterUids(kit) or {}
				if #uids > 0 then
					services.CritterService:stampede(uids, mutator.critterParty)
				end
			end
		end)
	end)
	round.RoundEnded:Connect(function()
		stop()
		nextMinorAt = math.huge
		-- The hub always has normal gravity; the mutator ends with the round.
		mutator = nil
		Workspace.Gravity = baseGravity
	end)
	-- Scheduler for small surprises and queued purchases.
	task.spawn(function()
		while true do
			task.wait(1)
			if not playable() or active then
				continue
			end
			local t = now()
			local timeLeft = round:timeLeft()
			if #queue > 0 and timeLeft > 20 then
				local q = table.remove(queue, 1)
				local def = Events.get(q.id)
				if def then
					run(def, q.by)
				end
				continue
			end
			-- Keep the scheduled major slots clear: don't start a minor right before one.
			local blocked = false
			for _, at in round:eventTimes() do
				local slot = round.startedAt + at
				if t < slot and slot - t < 18 then
					blocked = true
				end
			end
			if not blocked and t >= nextMinorAt and timeLeft > 12 then
				run(pick(false), nil)
				local lo, hi = minorGap()
				nextMinorAt = t + lo + math.random() * (hi - lo)
			end
		end
	end)
end

return EventService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="78">
          <Properties>
            <string name="Name">GalaxyService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Every launched ball becomes a planet in its owner's personal galaxy: its size, dominant colors,
-- the signature things it rolled up and a generated name. The galaxy keeps your best and most
-- recent planets (plus pinned ones); total galaxy mass only ever grows and unlocks later tiers.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextService = game:GetService("TextService")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Guard = require(Shared.Util.Guard)
local Rng = require(Shared.Util.Rng)
local Profile = require(Shared.Logic.Profile)
local Tuning = require(Shared.Config.Tuning)

local GalaxyService = {}

local services

-- Name parts: a word from the planet's dominant tag, then a cosmic suffix.
local TAG_WORDS = {
	food = { "Snack", "Munch", "Nibble" },
	candy = { "Sugar", "Gumdrop", "Lolly" },
	sweet = { "Honey", "Treacle", "Sprinkle" },
	fruit = { "Juicy", "Berry", "Citrus" },
	metal = { "Chrome", "Clank", "Steel" },
	kitchenware = { "Spoon", "Kettle", "Whisk" },
	critter = { "Critter", "Fuzzy", "Scamper" },
	animal = { "Wild", "Furry", "Paw" },
	toy = { "Toybox", "Blocky", "Squeaky" },
	garden = { "Leafy", "Mossy", "Bloom" },
	plant = { "Sprout", "Fern", "Petal" },
	bbq = { "Smoky", "Sizzle", "Ember" },
	breakfast = { "Pancake", "Toasty", "Sunny" },
	baked = { "Crusty", "Muffin", "Biscuit" },
	drink = { "Fizzy", "Bubbly", "Splash" },
	glass = { "Crystal", "Prism", "Glint" },
	shiny = { "Sparkle", "Glimmer", "Shimmer" },
	colorful = { "Rainbow", "Confetti", "Kaleido" },
	round = { "Roly", "Bouncy", "Orbit" },
	wood = { "Timber", "Oaky", "Knotty" },
	fluffy = { "Fluff", "Cloudy", "Puff" },
	electric = { "Zappy", "Volt", "Buzz" },
}
local GENERIC = { "Wobble", "Jumble", "Clutter", "Mishmash", "Pocket", "Rolly" }
local SUFFIX = { "Prime", "Major", "Minor", "World", "Orb", "-ia", "-tron", "Nova", "Sphere", "IX" }

function GalaxyService:init(s)
	services = s
end

local function topKeys(map: { [string]: number }?, n: number): { string }
	local list = {}
	for k, v in (map or {}) :: { [string]: number } do
		table.insert(list, { k, v })
	end
	table.sort(list, function(a, b)
		if a[2] == b[2] then
			return a[1] < b[1]
		end
		return a[2] > b[2]
	end)
	local out = {}
	for i = 1, math.min(n, #list) do
		out[i] = list[i][1]
	end
	return out
end

local function signatureProps(state, n: number): { number }
	-- Biggest distinct things rolled up (by volume), notable first.
	local best: { [number]: number } = {}
	for _, h in state.history or {} do
		best[h.uid] = math.max(best[h.uid] or 0, h.volume or 0)
	end
	local list = {}
	for uid, vol in best do
		table.insert(list, { uid, vol })
	end
	table.sort(list, function(a, b)
		return a[2] > b[2]
	end)
	local out = {}
	if state.notable then
		table.insert(out, state.notable.uid)
	end
	for _, e in list do
		if #out >= n then
			break
		end
		if not table.find(out, e[1]) then
			table.insert(out, e[1])
		end
	end
	return out
end

function GalaxyService.planetName(tag: string?, seed: number): string
	local rng = Rng.new(seed)
	local words = (tag and TAG_WORDS[tag]) or GENERIC
	local word = words[rng:int(1, #words)]
	local suffix = SUFFIX[rng:int(1, #SUFFIX)]
	if suffix:sub(1, 1) == "-" then
		return word .. suffix:sub(2)
	end
	return word .. " " .. suffix
end

-- Called by RoundService at launch for every ball.
function GalaxyService:createPlanet(state, kitId: string)
	local player = state.player
	if not Net.isPlayer(player) or not player.Parent then
		return nil
	end
	local pds = services.PlayerDataService
	local data = pds and pds:getLoaded(player)
	if not data or state.diameter <= 0 then
		return nil
	end
	-- Finishing place among everyone launching right now.
	local place = 1
	for _, other in services.BallService:all() do
		if other ~= state and other.diameter > state.diameter then
			place += 1
		end
	end
	local comp = state.composition or { tags = {}, colors = {} }
	local tags = topKeys(comp.tags, 6)
	local mainTag = nil
	for _, t in tags do
		if TAG_WORDS[t] then
			mainTag = t
			break
		end
	end
	local id = data.galaxy.nextId
	local planet = {
		id = id,
		t = os.time(),
		kit = kitId,
		tier = services.RoundService.tier.id,
		d = math.floor(state.diameter * 10 + 0.5) / 10,
		colors = topKeys(comp.colors, Tuning.Galaxy.PlanetColors),
		props = signatureProps(state, Tuning.Galaxy.SignatureProps),
		notable = state.notable and state.notable.uid or nil,
		name = GalaxyService.planetName(mainTag, player.UserId % 100000 * 131 + id),
		place = place,
	}
	pds:update(player, function(p)
		p.galaxy.nextId += 1
		p.galaxy.total += 1
		p.galaxy.mass += planet.d
		table.insert(p.galaxy.planets, planet)
		p.galaxy.planets = Profile.trimGalaxy(p.galaxy.planets)
	end)
	Net.fire("PlanetCreated", player, planet)
	return planet
end

local function findPlanet(data, id: number)
	for _, p in data.galaxy.planets do
		if p.id == id then
			return p
		end
	end
	return nil
end

function GalaxyService:start()
	local pds = services.PlayerDataService
	if not pds then
		return
	end
	Net.action("RenamePlanet", Guard.shape({ id = Guard.integer(1, 1e9), name = Guard.string(Tuning.Galaxy.NameMaxLength) }), function(player, payload)
		local data = pds:getLoaded(player)
		local planet = data and findPlanet(data, payload.id)
		if not planet then
			return false, "unknown"
		end
		local raw = payload.name:gsub("^%s+", ""):gsub("%s+$", "")
		if #raw < 2 then
			return false, "short"
		end
		local ok, filtered = pcall(function()
			local result = TextService:FilterStringAsync(raw, player.UserId, Enum.TextFilterContext.PublicChat)
			return result:GetNonChatStringForBroadcastAsync()
		end)
		if not ok then
			return false, "filter"
		end
		pds:update(player, function()
			planet.name = filtered
		end)
		return true, filtered
	end, 1)
	Net.action("PinPlanet", Guard.integer(1, 1e9), function(player, id)
		local data = pds:getLoaded(player)
		local planet = data and findPlanet(data, id)
		if not planet then
			return false, "unknown"
		end
		if not planet.pinned then
			local pinned = 0
			for _, p in data.galaxy.planets do
				if p.pinned then
					pinned += 1
				end
			end
			if pinned >= Tuning.Galaxy.MaxPinned then
				return false, "max_pinned"
			end
		end
		pds:update(player, function()
			planet.pinned = not planet.pinned or nil
		end)
		return true, planet.pinned == true
	end, 3)
end

return GalaxyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="79">
          <Properties>
            <string name="Name">HubService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Builds the hub: a floating island in space where players spend intermission, meet Nana Nova,
-- watch their galaxy, and open the shop / Rolledex / Cores / requests. Also hosts the podium.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared

local HubService = {}

HubService.ORIGIN = Vector3.new(0, 900, 6000)
-- Stations whose panels exist. Others (Roll Pass, tier portals) keep their prompts disabled so
-- nothing in the hub is a dead button.
HubService.LiveStations = { Shop = true, Rolledex = true, Cores = true, Galaxy = true, Requests = true }
HubService.StationsEnabled = false
HubService.model = nil :: Model?
HubService.spawns = {} :: { CFrame }
HubService.podium = {} :: { CFrame }

local services

local function part(parent: Instance, props: { [string]: any }): BasePart
	local className = props.ClassName or "Part"
	props.ClassName = nil
	local p = Instance.new(className)
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		(p :: any)[k] = v
	end
	p.Parent = parent
	return p :: BasePart
end

local function cylinderCF(pos: Vector3): CFrame
	return CFrame.new(pos) * CFrame.Angles(0, 0, math.pi / 2)
end

local function station(parent: Instance, origin: Vector3, name: string, label: string, color: Color3, icon: string, facing: Vector3)
	local model = Instance.new("Model")
	model.Name = name
	local look = CFrame.lookAt(origin, origin + facing)
	local base = part(model, {
		Name = "Base",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2, 22, 22),
		CFrame = cylinderCF(origin + Vector3.new(0, 1, 0)),
		Color = color,
		Material = Enum.Material.SmoothPlastic,
	})
	part(model, {
		Name = "Kiosk",
		Size = Vector3.new(14, 9, 6),
		CFrame = look * CFrame.new(0, 6.5, 2),
		Color = Color3.fromRGB(255, 250, 240),
		Material = Enum.Material.SmoothPlastic,
	})
	part(model, {
		Name = "Awning",
		ClassName = "WedgePart",
		Size = Vector3.new(16, 3, 7),
		CFrame = look * CFrame.new(0, 12.5, 1.5) * CFrame.Angles(0, math.pi, 0),
		Color = color,
		Material = Enum.Material.Fabric,
	})
	for i = -1, 1, 2 do
		part(model, {
			Name = "Post",
			Size = Vector3.new(1, 12, 1),
			CFrame = look * CFrame.new(i * 7.2, 7, -1.2),
			Color = Color3.fromRGB(255, 255, 255),
		})
	end
	local glow = part(model, {
		Name = "Glow",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(4, 4, 4),
		CFrame = look * CFrame.new(0, 17, 1),
		Color = color,
		Material = Enum.Material.Neon,
		CanCollide = false,
	})
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 22
	light.Brightness = 1.5
	light.Parent = glow
	local sign = Instance.new("BillboardGui")
	sign.Name = "Sign"
	sign.Size = UDim2.fromOffset(220, 90)
	sign.StudsOffsetWorldSpace = Vector3.new(0, 22, 0)
	sign.AlwaysOnTop = false
	sign.MaxDistance = 180
	sign.LightInfluence = 0
	sign.Adornee = base
	local text = Instance.new("TextLabel")
	text.BackgroundTransparency = 1
	text.Size = UDim2.fromScale(1, 1)
	text.FontFace = Font.new("rbxasset://fonts/families/LuckiestGuy.json")
	text.TextScaled = true
	text.Text = icon .. " " .. label
	text.TextColor3 = Color3.new(1, 1, 1)
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = Color3.fromRGB(38, 26, 74)
	stroke.Parent = text
	text.Parent = sign
	sign.Parent = base
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "Open"
	prompt.ActionText = "Open"
	prompt.ObjectText = label
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 16
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
	prompt.Enabled = HubService.StationsEnabled or HubService.LiveStations[name] == true
	prompt.Parent = base
	model:SetAttribute("Station", name)
	base:SetAttribute("Station", name)
	model.Parent = parent
	return model
end

local function buildIsland(hub: Model, o: Vector3)
	-- Layered floating island: grass top, cream cliff band, rocky underside tapering to a point.
	part(hub, {
		Name = "Top",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(6, 300, 300),
		CFrame = cylinderCF(o + Vector3.new(0, -3, 0)),
		Color = Color3.fromRGB(150, 226, 140),
		Material = Enum.Material.Grass,
	})
	local layers = {
		{ 290, 14, Color3.fromRGB(255, 226, 186), Enum.Material.Sandstone },
		{ 250, 20, Color3.fromRGB(196, 150, 120), Enum.Material.Rock },
		{ 190, 24, Color3.fromRGB(160, 120, 100), Enum.Material.Rock },
		{ 120, 26, Color3.fromRGB(130, 98, 90), Enum.Material.Rock },
		{ 56, 28, Color3.fromRGB(110, 84, 82), Enum.Material.Rock },
	}
	local y = -6
	for _, layer in layers do
		y -= layer[2] / 2
		part(hub, {
			Name = "Cliff",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(layer[2], layer[1], layer[1]),
			CFrame = cylinderCF(o + Vector3.new(0, y, 0)),
			Color = layer[3],
			Material = layer[4],
		})
		y -= layer[2] / 2
	end
	-- Pastel plaza and path ring.
	part(hub, {
		Name = "Plaza",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, 90, 90),
		CFrame = cylinderCF(o + Vector3.new(0, 0.3, 0)),
		Color = Color3.fromRGB(255, 244, 228),
		Material = Enum.Material.Pavement,
	})
	part(hub, {
		Name = "PlazaRing",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.5, 96, 96),
		CFrame = cylinderCF(o + Vector3.new(0, 0.2, 0)),
		Color = Color3.fromRGB(200, 182, 255),
		Material = Enum.Material.SmoothPlastic,
	})
	-- Floating mini rocks around the island.
	for i = 0, 11 do
		local a = i / 12 * math.pi * 2
		local r = 190 + (i % 3) * 22
		local size = 10 + (i % 4) * 6
		part(hub, {
			Name = "Islet",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(size * 0.5, size, size),
			CFrame = cylinderCF(o + Vector3.new(math.cos(a) * r, -20 - (i % 5) * 12, math.sin(a) * r)),
			Color = Color3.fromRGB(150, 226, 140),
			Material = Enum.Material.Grass,
			CanCollide = false,
		})
	end
	-- Cute trees.
	for i = 0, 9 do
		local a = i / 10 * math.pi * 2 + 0.3
		local r = 118 + (i % 2) * 14
		local base = o + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
		part(hub, {
			Name = "Trunk",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(14, 3, 3),
			CFrame = cylinderCF(base + Vector3.new(0, 7, 0)),
			Color = Color3.fromRGB(140, 90, 46),
			Material = Enum.Material.Wood,
		})
		local colors = { Color3.fromRGB(255, 175, 204), Color3.fromRGB(200, 182, 255), Color3.fromRGB(149, 213, 178) }
		part(hub, {
			Name = "Leaves",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(13, 13, 13),
			CFrame = CFrame.new(base + Vector3.new(0, 17, 0)),
			Color = colors[i % 3 + 1],
			Material = Enum.Material.SmoothPlastic,
		})
	end
	-- Invisible guard rail so nobody walks off into space.
	for i = 0, 35 do
		local a = i / 36 * math.pi * 2
		part(hub, {
			Name = "Rail",
			Size = Vector3.new(28, 40, 2),
			CFrame = CFrame.new(o + Vector3.new(math.cos(a) * 149, 20, math.sin(a) * 149)) * CFrame.Angles(0, -a + math.pi / 2, 0),
			Transparency = 1,
			CanQuery = false,
		})
	end
end

local function buildPodium(hub: Model, o: Vector3)
	local center = o + Vector3.new(0, 0, -95)
	local steps = {
		{ 0, 14, Color3.fromRGB(255, 209, 102), "1" },
		{ -16, 9, Color3.fromRGB(205, 214, 230), "2" },
		{ 16, 5, Color3.fromRGB(240, 160, 110), "3" },
	}
	HubService.podium = {}
	for i, s in steps do
		local block = part(hub, {
			Name = "Podium" .. s[4],
			Size = Vector3.new(14, s[2], 12),
			CFrame = CFrame.new(center + Vector3.new(s[1], s[2] / 2, 0)),
			Color = s[3],
			Material = Enum.Material.SmoothPlastic,
		})
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Back
		gui.LightInfluence = 0
		gui.PixelsPerStud = 20
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Size = UDim2.fromScale(1, 1)
		t.Text = s[4]
		t.TextScaled = true
		t.FontFace = Font.new("rbxasset://fonts/families/LuckiestGuy.json")
		t.TextColor3 = Color3.new(1, 1, 1)
		t.Parent = gui
		gui.Parent = block
		HubService.podium[i] = CFrame.new(center + Vector3.new(s[1], s[2] + 3, 0)) * CFrame.Angles(0, math.pi, 0)
	end
	-- Starry arch behind the podium.
	for i = 0, 12 do
		local a = i / 12 * math.pi
		part(hub, {
			Name = "Arch",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(5, 5, 5),
			CFrame = CFrame.new(center + Vector3.new(math.cos(a) * 30, math.sin(a) * 30, -10)),
			Color = if i % 2 == 0 then Color3.fromRGB(255, 209, 102) else Color3.fromRGB(200, 182, 255),
			Material = Enum.Material.Neon,
			CanCollide = false,
		})
	end
	local stage = part(hub, {
		Name = "Stage",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1, 70, 70),
		CFrame = cylinderCF(center + Vector3.new(0, 0.5, 0)),
		Color = Color3.fromRGB(123, 92, 214),
		Material = Enum.Material.SmoothPlastic,
	})
	stage:SetAttribute("PodiumStage", true)
end

-- Nana Nova and her chair are smooth meshes built on each client (editable meshes don't replicate),
-- so the server only places an anchor with her prompt; see client NanaController.
local function buildNana(hub: Model, o: Vector3)
	local spot = o + Vector3.new(0, 0, 30)
	local anchor = part(hub, {
		Name = "NanaAnchor",
		Size = Vector3.new(8, 12, 8),
		CFrame = CFrame.new(spot + Vector3.new(0, 6, 0)) * CFrame.Angles(0, math.pi, 0),
		Transparency = 1,
		CanCollide = true,
	})
	anchor:SetAttribute("NanaNova", true)
	anchor:SetAttribute("Station", "Requests")
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Requests"
	prompt.ObjectText = "Nana Nova"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 18
	prompt.RequiresLineOfSight = false
	prompt.Enabled = HubService.StationsEnabled or HubService.LiveStations.Requests == true
	prompt.Parent = anchor
end

local function buildPortals(hub: Model, o: Vector3)
	local Tiers = require(Shared.Config.Tiers)
	for i, tier in Tiers.List do
		local a = math.pi * 0.15 + (i - 1) / (#Tiers.List - 1) * math.pi * 0.7
		local pos = o + Vector3.new(math.cos(a) * 112, 0, math.sin(a) * 112)
		local look = CFrame.lookAt(pos, Vector3.new(o.X, pos.Y, o.Z))
		local ring = Instance.new("Model")
		ring.Name = "Portal" .. tier.key
		for k = 0, 15 do
			local ang = k / 16 * math.pi * 2
			part(ring, {
				Name = "Ring",
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(3, 3, 3),
				CFrame = look * CFrame.new(math.cos(ang) * 9, 10 + math.sin(ang) * 9, 0),
				Color = tier.color,
				Material = if tier.shipped then Enum.Material.Neon else Enum.Material.SmoothPlastic,
				CanCollide = false,
			})
		end
		local film = part(ring, {
			Name = "Film",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.4, 17, 17),
			CFrame = look * CFrame.new(0, 10, 0) * CFrame.Angles(0, math.pi / 2, 0),
			Color = tier.color,
			Material = Enum.Material.Glass,
			Transparency = 0.5,
			CanCollide = false,
		})
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = if tier.shipped then "Info" else "Locked"
		prompt.ObjectText = tier.icon .. " " .. tier.name
		prompt.HoldDuration = 0
		prompt.MaxActivationDistance = 16
		prompt.RequiresLineOfSight = false
		prompt.Enabled = HubService.StationsEnabled
		prompt.Parent = film
		film:SetAttribute("Station", "Tier")
		film:SetAttribute("TierId", tier.id)
		ring.Parent = hub
	end
end

function HubService:build()
	local o = self.ORIGIN
	local hub = Instance.new("Model")
	hub.Name = "Hub"
	hub.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	buildIsland(hub, o)
	buildPodium(hub, o)
	buildNana(hub, o)
	buildPortals(hub, o)
	station(hub, o + Vector3.new(-60, 0, 40), "Shop", "Shop", Color3.fromRGB(255, 122, 69), "🛍️", Vector3.new(1, 0, -0.4))
	station(hub, o + Vector3.new(60, 0, 40), "Rolledex", "Rolledex", Color3.fromRGB(77, 196, 255), "📖", Vector3.new(-1, 0, -0.4))
	station(hub, o + Vector3.new(-78, 0, -20), "Cores", "Cores", Color3.fromRGB(176, 108, 255), "⚙️", Vector3.new(1, 0, 0.3))
	station(hub, o + Vector3.new(78, 0, -20), "Galaxy", "My Galaxy", Color3.fromRGB(255, 214, 64), "🌌", Vector3.new(-1, 0, 0.3))
	station(hub, o + Vector3.new(0, 0, 80), "RollPass", "Roll Pass", Color3.fromRGB(88, 214, 116), "🎟️", Vector3.new(0, 0, -1))

	-- VIP lounge: a raised cloud deck. Non-VIP clients keep the gate solid locally.
	local lounge = part(hub, {
		Name = "VipLounge",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(3, 46, 46),
		CFrame = cylinderCF(o + Vector3.new(100, 1.5, -70)),
		Color = Color3.fromRGB(255, 214, 64),
		Material = Enum.Material.Foil,
	})
	lounge:SetAttribute("VipLounge", true)
	local gate = part(hub, {
		Name = "VipGate",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(40, 48, 48),
		CFrame = cylinderCF(o + Vector3.new(100, 22, -70)) * CFrame.Angles(0, 0, 0),
		Color = Color3.fromRGB(255, 214, 64),
		Material = Enum.Material.ForceField,
		Transparency = 0.6,
	})
	gate:SetAttribute("VipGate", true)

	-- Spawns around the plaza.
	self.spawns = {}
	for i = 0, 11 do
		local a = i / 12 * math.pi * 2
		local pos = o + Vector3.new(math.cos(a) * 34, 3, math.sin(a) * 34 + 10)
		local spawn = Instance.new("SpawnLocation")
		spawn.Name = "HubSpawn"
		spawn.Anchored = true
		spawn.Neutral = true
		spawn.Duration = 0
		spawn.Size = Vector3.new(6, 1, 6)
		spawn.CFrame = CFrame.new(pos - Vector3.new(0, 2.5, 0))
		spawn.Transparency = 1
		spawn.CanCollide = false
		spawn.CanQuery = false
		spawn.Parent = hub
		table.insert(self.spawns, CFrame.lookAt(pos, Vector3.new(o.X, pos.Y, o.Z)))
	end
	hub.Parent = Workspace
	self.model = hub
end

function HubService:init(s)
	services = s
	self:build()
end

function HubService:randomSpawn(): CFrame
	return self.spawns[math.random(1, #self.spawns)]
end

-- Put a player's avatar back in the hub at normal scale, walking normally.
function HubService:sendToHub(player: Player, at: CFrame?)
	local character = player.Character
	if not character then
		return
	end
	services.BallService:markRiding(player, false)
	services.BallService:resetCharacterScale(player)
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if hrp then
		for _, d in character:GetDescendants() do
			if d:IsA("Weld") and d.Name == "RiderWeld" then
				d:Destroy()
			end
		end
		hrp.Anchored = false
		hrp.AssemblyLinearVelocity = Vector3.zero
		character:PivotTo(at or self:randomSpawn())
		pcall(function()
			hrp:SetNetworkOwner(player)
		end)
	end
end

function HubService:start()
	Players.PlayerAdded:Connect(function(player)
		player:SetAttribute("InHub", true)
	end)
end

return HubService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="80">
          <Properties>
            <string name="Name">PlayerDataService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Player profiles with session locking. Every write goes through UpdateAsync:
--   * load claims a lock { job, t }; if another live server holds it (player just hopped), we
--     retry for a while, then take over a lock older than SessionLockTimeout;
--   * saves only write while we still own the lock, so a server that lost it can never clobber
--     newer data;
--   * leaving / shutdown saves and releases the lock; autosave runs every AutosaveInterval.
-- In Studio without API access (or if DataStores are down) profiles live in memory for the session
-- and the player is told progress won't be saved.

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Guard = require(Shared.Util.Guard)
local Signal = require(Shared.Util.Signal)
local Profile = require(Shared.Logic.Profile)
local Tuning = require(Shared.Config.Tuning)

local PlayerDataService = {}
PlayerDataService.Loaded = Signal.new() -- (player, data)
PlayerDataService.StardustChanged = Signal.new() -- (player, newTotal, delta, reason)

local STORE_NAME = "RTW_Profiles_v1"
local JOB_ID = if game.JobId ~= "" then game.JobId else ("studio-" .. HttpService:GenerateGUID(false))

local services
local store: GlobalDataStore? = nil
local memoryMode = false
local profiles: { [Player]: { data: { [string]: any }, dirty: boolean, joinedAt: number, saving: boolean } } = {}
local loading: { [Player]: boolean } = {}
local syncQueued: { [Player]: boolean } = {}
local closing = false

function PlayerDataService:init(s)
	services = s
end

local function keyFor(userId: number): string
	return "u_" .. tostring(userId)
end

local function openStore()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok and result then
		-- A cheap read proves API access (Studio without "Enable Studio Access to API Services" fails here).
		local probeOk = pcall(function()
			(result :: GlobalDataStore):GetAsync("__probe")
		end)
		if probeOk then
			store = result
			return
		end
	end
	memoryMode = true
	warn("[Data] DataStores unavailable; profiles are kept in memory for this session only.")
end

-- LOAD -------------------------------------------------------------------------------------------

local function claim(userId: number, steal: boolean): (boolean, any, string?)
	local key = keyFor(userId)
	local lockedBy = nil
	local claimed = nil
	local ok, err = pcall(function()
		(store :: GlobalDataStore):UpdateAsync(key, function(old)
			local record = if type(old) == "table" then old else {}
			local lock = record.lock
			local now = os.time()
			lockedBy, claimed = nil, nil
			if type(lock) == "table" and lock.job ~= JOB_ID and type(lock.t) == "number" then
				local fresh = now - lock.t < Tuning.Data.SessionLockTimeout
				if fresh and not steal then
					lockedBy = lock.job
					return nil -- abort; someone else is still using this profile
				end
			end
			record.lock = { job = JOB_ID, t = now }
			claimed = record -- the transform's input is the authoritative stored value
			return record
		end)
	end)
	if not ok then
		return false, nil, "error: " .. tostring(err)
	end
	if lockedBy then
		return false, nil, "locked"
	end
	return true, claimed, nil
end

local function loadProfile(player: Player)
	if loading[player] or profiles[player] then
		return
	end
	loading[player] = true
	local data
	if memoryMode then
		data = Profile.reconcile(nil)
	else
		local attempts = Tuning.Data.LoadRetries
		for attempt = 1, attempts do
			if not player.Parent then
				loading[player] = nil
				return
			end
			-- Last attempt takes over a lock the other server never released.
			local ok, record, reason = claim(player.UserId, attempt == attempts)
			if ok then
				data = Profile.reconcile(type(record) == "table" and record.data or nil)
				break
			end
			warn(string.format("[Data] load %s attempt %d/%d failed: %s", player.Name, attempt, attempts, tostring(reason)))
			task.wait(if reason == "locked" then 4 else math.min(2 ^ attempt, 10))
		end
	end
	loading[player] = nil
	if not player.Parent then
		return
	end
	if not data then
		-- DataStores are failing hard. Let them play on a temporary profile rather than kicking.
		data = Profile.reconcile(nil)
		data.temporary = true
		Net.fire("Toast", player, "warning", { text = "⚠️ Couldn't load your save. Progress this session won't be kept." })
	end
	local now = os.time()
	if data.firstJoin == 0 then
		data.firstJoin = now
	end
	data.lastJoin = now
	profiles[player] = { data = data, dirty = true, joinedAt = os.clock(), saving = false }
	if memoryMode then
		Net.fire("Toast", player, "warning", { text = "🧪 Studio test: progress isn't saved (enable API access to test saving)." })
	end
	PlayerDataService.Loaded:Fire(player, data)
	PlayerDataService:sync(player)
end

-- SAVE -------------------------------------------------------------------------------------------

local function save(player: Player, release: boolean): boolean
	local entry = profiles[player]
	if not entry or memoryMode or entry.data.temporary then
		return true
	end
	if entry.saving and not release then
		return false
	end
	entry.saving = true
	local data = entry.data
	data.stats.playSeconds = math.floor(data.stats.playSeconds + (os.clock() - entry.joinedAt))
	entry.joinedAt = os.clock()
	local lost = false
	local success = false
	for attempt = 1, Tuning.Data.SaveRetries do
		local ok, err = pcall(function()
			(store :: GlobalDataStore):UpdateAsync(keyFor(player.UserId), function(old)
				local record = if type(old) == "table" then old else {}
				local lock = record.lock
				if type(lock) == "table" and lock.job ~= JOB_ID then
					lost = true
					return nil -- another server owns this profile now; never overwrite it
				end
				record.data = data
				record.saved = os.time()
				record.lock = if release then nil else { job = JOB_ID, t = os.time() }
				return record
			end)
		end)
		if ok then
			success = not lost
			break
		end
		warn(string.format("[Data] save %s attempt %d failed: %s", player.Name, attempt, tostring(err)))
		task.wait(math.min(2 ^ attempt, 8))
	end
	if lost then
		warn("[Data] lost session lock for " .. player.Name .. "; not saving")
	end
	entry.saving = false
	if success then
		entry.dirty = false
	end
	return success
end

-- PUBLIC API -------------------------------------------------------------------------------------

function PlayerDataService:getLoaded(player: any): { [string]: any }?
	if not Net.isPlayer(player) then
		return nil
	end
	local entry = profiles[player]
	return entry and entry.data or nil
end

function PlayerDataService:waitLoaded(player: Player, timeout: number?): { [string]: any }?
	local deadline = os.clock() + (timeout or 30)
	while player.Parent and os.clock() < deadline do
		local data = self:getLoaded(player)
		if data then
			return data
		end
		task.wait(0.2)
	end
	return nil
end

function PlayerDataService:isMemoryMode(): boolean
	return memoryMode
end

-- Send the client a fresh view of its profile. Coalesced and capped at SYNC_INTERVAL per player
-- (a burst of discoveries or claims becomes one message).
local SYNC_INTERVAL = 0.5
local lastSync: { [Player]: number } = {}

function PlayerDataService:sync(player: Player)
	if syncQueued[player] then
		return
	end
	syncQueued[player] = true
	local delaySeconds = math.max(0, (lastSync[player] or 0) + SYNC_INTERVAL - os.clock())
	task.delay(delaySeconds, function()
		syncQueued[player] = nil
		local entry = profiles[player]
		if entry and player.Parent then
			lastSync[player] = os.clock()
			Net.fire("ProfileSync", player, Profile.clientView(entry.data))
		end
	end)
end

-- Mutate a profile safely. fn(data) may return false to signal "no change".
function PlayerDataService:update(player: Player, fn: (data: { [string]: any }) -> any): any
	local entry = profiles[player]
	if not entry then
		return nil
	end
	local result = fn(entry.data)
	if result ~= false then
		entry.dirty = true
		self:sync(player)
	end
	return result
end

-- For in-place edits made elsewhere that should be saved but not synced right away.
function PlayerDataService:markDirty(player: Player)
	local entry = profiles[player]
	if entry then
		entry.dirty = true
	end
end

function PlayerDataService:grantStardust(player: any, amount: number, reason: string): number?
	if not Net.isPlayer(player) then
		return nil
	end
	amount = math.floor(amount)
	if amount <= 0 then
		return nil
	end
	local total = self:update(player, function(data)
		data.stardust += amount
		data.totalStardust += amount
		return data.stardust
	end)
	if total then
		self.StardustChanged:Fire(player, total, amount, reason)
		if services.AnalyticsService and services.AnalyticsService.economy then
			services.AnalyticsService:economy(player, "Source", "Stardust", amount, total, reason)
		end
	end
	return total
end

-- Returns true and deducts if the player can afford it.
function PlayerDataService:spendStardust(player: Player, amount: number, reason: string): boolean
	local spent = self:update(player, function(data)
		if amount < 0 or data.stardust < amount then
			return false
		end
		data.stardust -= amount
		return true
	end)
	if spent then
		local data = self:getLoaded(player)
		self.StardustChanged:Fire(player, data.stardust, -amount, reason)
		if services.AnalyticsService and services.AnalyticsService.economy then
			services.AnalyticsService:economy(player, "Sink", "Stardust", amount, data.stardust, reason)
		end
	end
	return spent == true
end

function PlayerDataService:recordRound(player: Player, stats, awards: number)
	self:update(player, function(data)
		local s = data.stats
		s.rounds += 1
		s.absorbed += stats.absorbed or 0
		s.playersRolled += stats.playersRolled or 0
		s.timesRolled += stats.timesRolled or 0
		s.discoveries += stats.discoveries or 0
		s.biggest = math.max(s.biggest, stats.peakDiameter or stats.finalDiameter or 0)
		local place = stats.placement or 99
		if place == 1 then
			s.wins += 1
		end
		if place <= 3 then
			s.top3 += 1
		end
		s.awards = (s.awards or 0) + awards
	end)
end

function PlayerDataService:saveNow(player: Player): boolean
	return save(player, false)
end

-- LIFECYCLE --------------------------------------------------------------------------------------

local opt = Guard.optional
local SETTINGS_GUARD = Guard.shape({
	music = opt(Guard.number(0, 1)),
	sfx = opt(Guard.number(0, 1)),
	quality = opt(Guard.oneOf({ "Auto", "Low", "Medium", "High" })),
	cameraSensitivity = opt(Guard.number(0.2, 3)),
	reducedMotion = opt(Guard.boolean()),
	colorblind = opt(Guard.boolean()),
	autoSteer = opt(Guard.boolean()),
	shake = opt(Guard.number(0, 2)),
})

function PlayerDataService:start()
	openStore()
	Net.action("SaveSettings", SETTINGS_GUARD, function(player, payload)
		return self:update(player, function(data)
			for k, v in payload do
				data.settings[k] = v
			end
			return next(payload) ~= nil
		end) == true
	end, 6)
	Net.action("CompleteTutorial", Guard.optional(Guard.boolean()), function(player)
		return self:update(player, function(data)
			if data.tutorialDone then
				return false
			end
			data.tutorialDone = true
			return true
		end) == true
	end, 2)

	Players.PlayerAdded:Connect(function(player)
		task.spawn(loadProfile, player)
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(loadProfile, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		if closing then
			return -- BindToClose handles everyone
		end
		task.spawn(function()
			save(player, true)
			profiles[player] = nil
			syncQueued[player] = nil
			lastSync[player] = nil
		end)
	end)

	task.spawn(function()
		while true do
			task.wait(Tuning.Data.AutosaveInterval)
			for player, entry in profiles do
				if entry.dirty and player.Parent then
					task.spawn(save, player, false)
					task.wait(0.5) -- spread requests across the budget
				end
			end
		end
	end)

	game:BindToClose(function()
		closing = true
		if memoryMode then
			return
		end
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				save(player, true)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

return PlayerDataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="81">
          <Properties>
            <string name="Name">ProgressionService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Long-term goals that make every round count:
--   * XP after each round -> levels, each with a reward (Stardust; shells and titles at
--     milestones),
--   * personal records per map ("NEW RECORD!"),
--   * achievements (lifetime milestones with Stardust, titles and a shell),
--   * Rolledex sets (themed groups per map; completing one pays out, completing every set on a map
--     earns that map's Master title),
--   * titles you can wear under your name,
--   * global leaderboards (biggest ball ever, highest level) on boards in the hub.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Guard = require(Shared.Util.Guard)
local Format = require(Shared.Util.Format)
local Progression = require(Shared.Logic.Progression)
local Titles = require(Shared.Data.Titles)
local Cosmetics = require(Shared.Data.Cosmetics)

local ProgressionService = {}

local services
local boards: { [string]: any } = {} -- { biggest = { rows }, level = { rows } }
local nameCache: { [number]: string } = {}
local lastSubmit: { [Player]: number } = {}

function ProgressionService:init(s)
	services = s
end

local function pds()
	return services.PlayerDataService
end

local function grantShell(player: Player, id: string?): boolean
	if not id or not Cosmetics.ById[id] then
		return false
	end
	local granted = false
	pds():update(player, function(p)
		if p.cosmetics.shells[id] then
			return false
		end
		p.cosmetics.shells[id] = true
		granted = true
		return true
	end)
	return granted
end

local function grantTitle(player: Player, id: string?): boolean
	if not id or not Titles.ById[id] then
		return false
	end
	local granted = false
	pds():update(player, function(p)
		if p.titles[id] then
			return false
		end
		p.titles[id] = true
		granted = true
		return true
	end)
	return granted
end

-- XP + LEVELS -------------------------------------------------------------------------------------

function ProgressionService:addXp(player: Player, amount: number): { any }
	local data = pds():getLoaded(player)
	if not data or amount <= 0 then
		return {}
	end
	local oldLevel = data.level
	pds():update(player, function(p)
		p.xp += math.floor(amount)
		p.level = (Progression.levelFromXp(p.xp))
	end)
	local ups = {}
	for level = oldLevel + 1, data.level do
		local reward = Progression.levelReward(level)
		pds():grantStardust(player, reward.stardust, "LevelUp")
		local entry = { level = level, stardust = reward.stardust }
		if grantShell(player, reward.shell) then
			entry.shell = reward.shell
		end
		if grantTitle(player, reward.title) then
			entry.title = reward.title
		end
		table.insert(ups, entry)
	end
	if #ups > 0 then
		local ball = services.BallService:get(player)
		if ball and ball.part then
			ball.part:SetAttribute("Level", data.level)
		end
	end
	return ups
end

-- ACHIEVEMENTS ------------------------------------------------------------------------------------

function ProgressionService:checkAchievements(player: Player): { any }
	local data = pds():getLoaded(player)
	if not data then
		return {}
	end
	local got = {}
	for _, a in Progression.newAchievements(data) do
		pds():update(player, function(p)
			p.achievements[a.id] = true
		end)
		pds():grantStardust(player, a.stardust, "Achievement")
		local entry = { id = a.id, name = a.name, icon = a.icon, stardust = a.stardust }
		if grantTitle(player, a.title) then
			entry.title = a.title
		end
		if grantShell(player, a.shell) then
			entry.shell = a.shell
		end
		table.insert(got, entry)
		Net.fire("Toast", player, "achievement", entry)
	end
	return got
end

-- SETS --------------------------------------------------------------------------------------------

local function onDiscovered(player: Player, uid: number, _mutation: number, isNew: boolean)
	if not isNew then
		return
	end
	local rolledex = services.RolledexService
	local data = pds():getLoaded(player)
	if not rolledex or not data then
		return
	end
	local has = function(u: number)
		return rolledex:has(player, u)
	end
	for _, set in Progression.setsForUid(uid) do
		local have = Progression.setProgress(set, has)
		local total = #set.uids
		if have >= total and not data.setsClaimed[set.id] then
			pds():update(player, function(p)
				p.setsClaimed[set.id] = true
			end)
			pds():grantStardust(player, set.reward, "SetComplete")
			Net.fire("Toast", player, "setComplete", { name = set.name, icon = set.icon, stardust = set.reward })
			-- Every set on this map done -> the map's Master title.
			local allDone = true
			for _, other in Progression.sets() do
				if other.kitId == set.kitId and not data.setsClaimed[other.id] then
					allDone = false
					break
				end
			end
			local titleId = Titles.ForKit[set.kitId]
			if allDone and titleId and grantTitle(player, titleId) then
				Net.fire("Toast", player, "title", { id = titleId, text = Titles.ById[titleId].text })
			end
		elseif have < total then
			Net.fire("Toast", player, "setProgress", { name = set.name, icon = set.icon, have = have, total = total })
		end
	end
end

-- ROUND END ---------------------------------------------------------------------------------------

local function onRoundEnded(statsList)
	local round = services.RoundService
	local kitId = round.kitId
	local balls = #statsList
	for _, stats in statsList do
		local player = Players:GetPlayerByUserId(stats.userId)
		local data = player and pds():getLoaded(player)
		if not player or not data then
			continue
		end
		local xp, parts = Progression.roundXp({
			finalDiameter = stats.finalDiameter,
			placement = stats.placement or 99,
			players = balls,
			discoveries = stats.discoveries or 0,
			playersRolled = stats.playersRolled or 0,
			requestsDone = stats.requestsCompleted or 0,
		})
		local oldLevel, oldInto, oldNeed = Progression.levelFromXp(data.xp)
		local ups = ProgressionService:addXp(player, xp)
		-- Personal best on this map.
		local best = math.max(stats.peakDiameter or 0, stats.finalDiameter or 0)
		local oldRecord = data.records[kitId]
		local record = nil
		if kitId and best > 0 and (not oldRecord or best > oldRecord) then
			pds():update(player, function(p)
				p.records[kitId] = math.floor(best * 10 + 0.5) / 10
			end)
			if oldRecord then
				record = { old = oldRecord, new = best, kitId = kitId }
			end
		end
		local achievements = ProgressionService:checkAchievements(player)
		local newLevel, newInto, newNeed = Progression.levelFromXp(data.xp)
		Net.fire("Toast", player, "progress", {
			xp = xp,
			parts = parts,
			from = { level = oldLevel, into = oldInto, need = oldNeed },
			to = { level = newLevel, into = newInto, need = newNeed },
			levelUps = ups,
			record = record,
			achievements = #achievements,
		})
		ProgressionService:submitLeaderboards(player)
	end
end

-- LEADERBOARDS ------------------------------------------------------------------------------------

local stores = nil
local function leaderboardStores()
	if stores ~= nil then
		return stores or nil
	end
	if pds():isMemoryMode() then
		stores = false
		return nil
	end
	local ok, result = pcall(function()
		return {
			biggest = DataStoreService:GetOrderedDataStore("RTW_Biggest_v1"),
			level = DataStoreService:GetOrderedDataStore("RTW_XP_v1"),
		}
	end)
	stores = if ok then result else false
	return stores or nil
end

function ProgressionService:submitLeaderboards(player: Player)
	local s = leaderboardStores()
	local data = pds():getLoaded(player)
	if not s or not data then
		return
	end
	if os.clock() - (lastSubmit[player] or 0) < 60 then
		return
	end
	lastSubmit[player] = os.clock()
	task.spawn(function()
		pcall(function()
			s.biggest:SetAsync(tostring(player.UserId), math.floor((data.stats.biggest or 0) * 10))
		end)
		pcall(function()
			s.level:SetAsync(tostring(player.UserId), math.floor(data.xp))
		end)
	end)
end

local function nameFor(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local p = Players:GetPlayerByUserId(userId)
	if p then
		nameCache[userId] = p.DisplayName
		return p.DisplayName
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	nameCache[userId] = if ok and name then name else "Roller"
	return nameCache[userId]
end

local function buildBoard(hub: Instance, cf: CFrame, title: string, color: Color3)
	local board = Instance.new("Part")
	board.Name = "Leaderboard"
	board.Anchored = true
	board.Size = Vector3.new(22, 26, 1.2)
	board.CFrame = cf
	board.Color = Color3.fromRGB(38, 26, 74)
	board.Material = Enum.Material.SmoothPlastic
	board.Parent = hub
	local frame = Instance.new("Part")
	frame.Anchored = true
	frame.CanCollide = false
	frame.Size = Vector3.new(23.4, 27.4, 0.8)
	frame.CFrame = cf * CFrame.new(0, 0, 0.3)
	frame.Color = color
	frame.Material = Enum.Material.Neon
	frame.Parent = hub
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.LightInfluence = 0
	gui.PixelsPerStud = 24
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.Parent = board
	local header = Instance.new("TextLabel")
	header.BackgroundTransparency = 1
	header.Size = UDim2.new(1, 0, 0.12, 0)
	header.Text = title
	header.TextScaled = true
	header.FontFace = Font.new("rbxasset://fonts/families/LuckiestGuy.json")
	header.TextColor3 = color
	header.Parent = gui
	local rows = {}
	for i = 1, 10 do
		local row = Instance.new("TextLabel")
		row.BackgroundTransparency = if i % 2 == 0 then 1 else 0.85
		row.BackgroundColor3 = Color3.new(1, 1, 1)
		row.BorderSizePixel = 0
		row.Position = UDim2.new(0.04, 0, 0.13 + (i - 1) * 0.085, 0)
		row.Size = UDim2.new(0.92, 0, 0.08, 0)
		row.TextScaled = true
		row.FontFace = Font.new("rbxasset://fonts/families/FredokaOne.json")
		row.TextColor3 = Color3.new(1, 1, 1)
		row.TextXAlignment = Enum.TextXAlignment.Left
		row.Text = ""
		row.Parent = gui
		rows[i] = row
	end
	return rows
end

local function refreshBoards()
	local s = leaderboardStores()
	local cm = services.RoundService.tier.cmPerStud
	local function fill(rows, store, format)
		if not rows then
			return
		end
		if not store then
			-- Studio / no DataStores: show who's here so the board isn't empty.
			local list = {}
			for _, p in Players:GetPlayers() do
				local data = pds():getLoaded(p)
				if data then
					table.insert(list, { key = p.UserId, value = if format == "size" then (data.stats.biggest or 0) * 10 else data.xp })
				end
			end
			table.sort(list, function(a, b)
				return a.value > b.value
			end)
			for i, row in rows do
				local e = list[i]
				row.Text = if e then string.format("  %d. %s  —  %s", i, nameFor(e.key), if format == "size" then Format.size(e.value / 10, cm) else "Lv " .. (Progression.levelFromXp(e.value))) else ""
			end
			return
		end
		local ok, pages = pcall(function()
			return store:GetSortedAsync(false, 10)
		end)
		if not ok or not pages then
			return
		end
		local entries = pages:GetCurrentPage()
		for i, row in rows do
			local e = entries[i]
			if e then
				local userId = tonumber(e.key) or 0
				local value = e.value
				row.Text = string.format("  %d. %s  —  %s", i, nameFor(userId), if format == "size" then Format.size(value / 10, cm) else "Lv " .. (Progression.levelFromXp(value)))
			else
				row.Text = ""
			end
		end
	end
	fill(boards.biggest, s and s.biggest, "size")
	fill(boards.level, s and s.level, "level")
end

-- LIFECYCLE ---------------------------------------------------------------------------------------

function ProgressionService:start()
	if not services.PlayerDataService then
		return
	end
	Net.action("EquipTitle", Guard.string(32), function(player, id)
		local data = pds():getLoaded(player)
		if not data or not data.titles[id] then
			return false, "locked"
		end
		pds():update(player, function(p)
			p.title = id
		end)
		local ball = services.BallService:get(player)
		local def = Titles.ById[id]
		if ball and ball.part and def then
			ball.part:SetAttribute("Title", def.text)
			ball.part:SetAttribute("TitleColor", def.color)
		end
		return true
	end, 4)
	services.RoundService.RoundEnded:Connect(function(statsList)
		task.spawn(onRoundEnded, statsList)
	end)
	if services.RolledexService then
		services.RolledexService.Discovered:Connect(onDiscovered)
	end
	pds().Loaded:Connect(function(player, data)
		-- Level is derived from XP (repairs older saves) and catch-up achievements.
		local level = Progression.levelFromXp(data.xp)
		if level ~= data.level then
			pds():update(player, function(p)
				p.level = level
			end)
		end
		task.delay(5, function()
			if player.Parent then
				ProgressionService:checkAchievements(player)
			end
		end)
	end)
	-- Hub leaderboards.
	task.spawn(function()
		local hub = services.HubService and services.HubService.model
		local tries = 0
		while not hub and tries < 30 do
			task.wait(1)
			tries += 1
			hub = services.HubService and services.HubService.model
		end
		if hub then
			local o = services.HubService.ORIGIN
			boards.biggest = buildBoard(hub, CFrame.lookAt(o + Vector3.new(-44, 15, -100), o + Vector3.new(-44, 15, 0)), "🏆 BIGGEST BALLS EVER", Color3.fromRGB(255, 214, 64))
			boards.level = buildBoard(hub, CFrame.lookAt(o + Vector3.new(44, 15, -100), o + Vector3.new(44, 15, 0)), "⭐ TOP LEVELS", Color3.fromRGB(176, 108, 255))
		end
		while true do
			pcall(refreshBoards)
			task.wait(90)
		end
	end)
	-- Achievements that move outside rounds (streak, Nana, planets) are caught here.
	task.spawn(function()
		while true do
			task.wait(60)
			for _, player in Players:GetPlayers() do
				pcall(ProgressionService.checkAchievements, ProgressionService, player)
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		lastSubmit[player] = nil
	end)
end

return ProgressionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="82">
          <Properties>
            <string name="Name">PvpService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Player-vs-player (and bot) interactions:
--   * Rolling up: a ball sufficiently bigger than another absorbs it. The victim becomes a Rider,
--     stuck to the big ball, waving, until they Burst Off (after a short delay, or automatically).
--   * Burst Off: the rider launches away, knocks a chunk of the host's recent props loose as loot,
--     and comes back at a healthy fraction of their old size with a comeback growth boost.
--   * Bumps: similar-size balls colliding at speed scatter props off both, with a big CLANG.
-- Being rolled up is designed to be a funny setback and a story, never a reason to quit.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)
local Absorb = require(Shared.Logic.Absorb)
local Growth = require(Shared.Logic.Growth)
local Tuning = require(Shared.Config.Tuning)
local Cores = require(Shared.Data.Cores)
local MathUtil = require(Shared.Util.MathUtil)

local PvpService = {}
PvpService.riders = {} :: { [any]: any } -- rider identity -> { host = BallState, weld, since, burstAt, autoAt, oldDiameter }
PvpService.Rolled = Signal.new() -- (hostState, victimIdentity, victimDiameter)
PvpService.Burst = Signal.new() -- (riderIdentity, hostState)
PvpService.Bumped = Signal.new() -- (stateA, stateB, closingSpeed)

local services
local pairCooldown: { [string]: number } = {}

function PvpService:init(s)
	services = s
end

local function pairKey(a, b): string
	local x, y = a.userId, b.userId
	if x > y then
		x, y = y, x
	end
	return x .. ":" .. y
end

local function isShielded(state): boolean
	return os.clock() < state.shieldUntil
end

function PvpService:isRider(identity): boolean
	return self.riders[identity] ~= nil
end

-- Attach a rolled-up victim's avatar to the host ball at the contact point.
local function attachRider(host, victim, contactDir: Vector3)
	local character = victim.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not hrp or not host.part.Parent then
		return nil
	end
	services.BallService:markRiding(victim, true)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.PlatformStand = true
	end
	local localDir = host.part.CFrame:VectorToObjectSpace(contactDir)
	if localDir.Magnitude < 1e-3 then
		localDir = Vector3.yAxis
	end
	localDir = localDir.Unit
	local r = host.diameter / 2
	-- Stand the avatar on the surface, head pointing outward, a little embedded.
	local up = localDir
	local basis = CFrame.lookAt(Vector3.zero, up, if math.abs(up.Y) > 0.95 then Vector3.xAxis else Vector3.yAxis) * CFrame.Angles(-math.pi / 2, 0, 0)
	local offset = CFrame.new(up * (r + 1.5)) * basis
	local weld = Instance.new("Weld")
	weld.Name = "RiderWeld"
	weld.Part0 = host.part
	weld.Part1 = hrp
	weld.C0 = offset
	weld.Parent = hrp
	return weld
end

-- Ball A rolls up ball B (B's owner becomes a rider on A).
function PvpService:rollUp(host, victimState)
	local victim = victimState.player
	local victimD = victimState.diameter
	local contact = victimState.part.Position - host.part.Position
	local contactDir = if contact.Magnitude > 1e-3 then contact.Unit else Vector3.yAxis
	local oldHostD = host.diameter

	-- The host gets most of the victim's volume: the single biggest growth moment in the game.
	local mult = services.BallService:growthMultiplier(host)
	if services.EventService then
		mult *= services.EventService:growthMultiplier(host)
	end
	local newD = Growth.absorbBall(oldHostD, victimD, { multiplier = mult })
	services.BallService:remove(victim, "rolled")
	services.BallService:setDiameter(host, newD, "rolled")
	host.stats.playersRolled = (host.stats.playersRolled or 0) + 1

	local weld = attachRider(host, victim, contactDir)
	local now = os.clock()
	local isBotVictim = not Net.isPlayer(victim)
	self.riders[victim] = {
		host = host,
		weld = weld,
		since = now,
		burstAt = now + Tuning.Pvp.RiderBurstDelay,
		autoAt = now + (if isBotVictim then 3 + math.random() * 5 else Tuning.Pvp.RiderAutoBurst),
		oldDiameter = victimD,
	}
	host.riders[victim] = true
	if services.RoundService then
		services.RoundService:setPlayerState(victim, "Rider")
		local vs = services.RoundService:stats(victim)
		vs.timesRolled += 1
		local hs = services.RoundService:stats(host.player)
		hs.playersRolled += 1
		-- Rolling up a player is the best "Roll of the Round" highlight material.
		local score = victimD * 3
		if not hs.biggestAbsorb or score > hs.biggestAbsorb.score then
			hs.biggestAbsorb = {
				score = score,
				kind = "player",
				userId = host.userId,
				name = host.player.DisplayName,
				victimId = victimState.userId,
				victimName = victim.DisplayName,
				diameter = newD,
			}
		end
	end

	Net.fire("PlayerState", victim, "Rider", {
		hostId = host.userId,
		hostBall = host.model,
		burstAt = workspace:GetServerTimeNow() + Tuning.Pvp.RiderBurstDelay,
		autoAt = workspace:GetServerTimeNow() + (self.riders[victim].autoAt - now),
		by = host.player.DisplayName,
	})
	Net.fireAll("Announce", "rolled", {
		hostId = host.userId,
		hostName = host.player.DisplayName,
		victimId = victimState.userId,
		victimName = victim.DisplayName,
		position = victimState.part.Position,
		diameter = newD,
	})
	self.Rolled:Fire(host, victim, victimD)
	if services.AnalyticsService then
		services.AnalyticsService:custom(victim, "RolledUp", victimD)
	end
end

-- Detach a rider. respawn=true gives them a new ball (burst off); false just frees the avatar.
function PvpService:release(identity, respawn: boolean, reason: string)
	local info = self.riders[identity]
	if not info then
		return
	end
	self.riders[identity] = nil
	local host = info.host
	if host and host.riders then
		host.riders[identity] = nil
	end
	if info.weld then
		info.weld:Destroy()
	end
	local character = identity.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not respawn then
		return
	end
	local round = services.RoundService
	if not round or not round:isPlaying() or not hrp then
		return
	end
	local hostAlive = host and host.alive and host.part.Parent
	local origin = if hostAlive then host.part.Position else hrp.Position
	local away = hrp.Position - origin
	away = Vector3.new(away.X, 0, away.Z)
	away = if away.Magnitude > 1e-3 then away.Unit else Vector3.new(1, 0, 0)

	-- Burst knocks a chunk of the host's recent props loose for everyone to grab.
	if hostAlive and reason == "burst" then
		local count = math.min(Tuning.Pvp.BurstKnockMax, math.max(2, math.floor(#host.history * Tuning.Pvp.BurstKnockFraction)))
		services.AbsorbService:knockLoose(host, count, hrp.Position, "burst")
		local lost = MathUtil.sphereVolume(host.diameter) * Tuning.Pvp.BurstHostVolumeLoss
		services.BallService:setDiameter(host, Growth.shrink(host.diameter, lost), "burst")
		services.BallService:impulse(host, -away * 25)
	end

	local newD = math.max(Tuning.Ball.StartDiameter, info.oldDiameter * Tuning.Pvp.RiderRespawnFraction)
	local spawnPos = (if hostAlive then origin + away * (host.diameter / 2 + newD + 4) else hrp.Position)
	local ground = services.WorldService:groundAt(spawnPos.X, spawnPos.Z)
	spawnPos = Vector3.new(spawnPos.X, math.max(ground, spawnPos.Y - newD), spawnPos.Z)
	local state = round:spawnIntoRound(identity, {
		diameter = newD,
		position = spawnPos,
		afterRolled = true,
		shield = 3,
	})
	if state then
		services.BallService:addGrowthBoost(state, Tuning.Pvp.ComebackMultiplier, Tuning.Pvp.ComebackDuration, "comeback")
		services.BallService:impulse(state, away * Tuning.Pvp.BurstLaunchSpeed + Vector3.new(0, Tuning.Pvp.BurstLaunchSpeed * 0.6, 0))
		state.stats.bursts = (state.stats.bursts or 0) + 1
	end
	Net.fireAll("BallFx", "burst", { userId = identity.UserId, position = spawnPos })
	self.Burst:Fire(identity, host)
end

function PvpService:releaseAllRiders(reason: string)
	for identity in self.riders do
		self:release(identity, false, reason)
	end
end

local function bump(a, b, closing: number, normal: Vector3)
	local key = pairKey(a, b)
	local now = os.clock()
	if pairCooldown[key] and now < pairCooldown[key] then
		return
	end
	pairCooldown[key] = now + Tuning.Pvp.BumpPairCooldown
	local base = Absorb.bumpScatterCount(closing)
	local function scatterFor(victim, attacker)
		local resist = 0
		local vDef = Cores.get(victim.core)
		if vDef and vDef.bumpResist then
			resist = vDef.bumpResist(victim.coreLevel)
		end
		local power = 1
		local aDef = Cores.get(attacker.core)
		if aDef and aDef.bumpPower then
			power = aDef.bumpPower(attacker.coreLevel)
		end
		return math.max(0, math.floor(base * power * (1 - resist) + 0.5))
	end
	local contact = a.part.Position + normal * (a.diameter / 2)
	services.AbsorbService:knockLoose(a, scatterFor(a, b), contact, "bump")
	services.AbsorbService:knockLoose(b, scatterFor(b, a), contact, "bump")
	-- Push apart, heavier (bigger) balls move less.
	local va, vb = MathUtil.sphereVolume(a.diameter), MathUtil.sphereVolume(b.diameter)
	local total = va + vb
	local push = closing * Tuning.Pvp.BumpImpulse
	services.BallService:impulse(a, -normal * push * (vb / total) * 2 + Vector3.new(0, push * 0.2, 0))
	services.BallService:impulse(b, normal * push * (va / total) * 2 + Vector3.new(0, push * 0.2, 0))
	a.stats.bumps = (a.stats.bumps or 0) + 1
	b.stats.bumps = (b.stats.bumps or 0) + 1
	Net.fireAll("BallFx", "bump", {
		a = a.userId,
		b = b.userId,
		position = contact,
		power = math.clamp(closing / (Tuning.Pvp.BumpMinRelativeSpeed * 3), 0.2, 1),
		size = math.max(a.diameter, b.diameter),
	})
	PvpService.Bumped:Fire(a, b, closing)
end

local function tick()
	local round = services.RoundService
	if round and not round:isPlaying() then
		return
	end
	local balls = services.BallService:all()
	for i = 1, #balls do
		local a = balls[i]
		if not a.alive or not a.part.Parent then
			continue
		end
		for j = i + 1, #balls do
			local b = balls[j]
			if not b.alive or not b.part.Parent then
				continue
			end
			local pa, pb = a.part.Position, b.part.Position
			local delta = pb - pa
			local dist = delta.Magnitude
			local reach = (a.diameter + b.diameter) / 2
			local latency = Absorb.latencyReach(math.max(a.part.AssemblyLinearVelocity.Magnitude, b.part.AssemblyLinearVelocity.Magnitude)) * 0.5
			if dist <= reach * 1.04 + latency and services.RoundService:sameTeam(a.player, b.player) then
				continue -- teammates just roll past each other
			end
			if dist <= reach * 1.04 + latency then
				local big, small = a, b
				if b.diameter > a.diameter then
					big, small = b, a
				end
				if Absorb.canAbsorbBall(big.diameter, small.diameter) then
					if not isShielded(small) and not big.mergedWith and not small.mergedWith then
						PvpService:rollUp(big, small)
						return -- ball list changed; continue next tick
					end
				elseif Absorb.isBumpPair(a.diameter, b.diameter) and dist > 1e-3 then
					local normal = delta / dist
					local closing = (a.part.AssemblyLinearVelocity - b.part.AssemblyLinearVelocity):Dot(normal)
					if closing >= Tuning.Pvp.BumpMinRelativeSpeed then
						bump(a, b, closing, normal)
					end
				end
			end
		end
	end
end

local function riderTick()
	local now = os.clock()
	for identity, info in PvpService.riders do
		local host = info.host
		-- Host vanished (left, launched, rolled up itself): free the rider with a new ball.
		if not host or not host.alive or not host.part.Parent then
			PvpService:release(identity, true, "hostgone")
		elseif now >= info.autoAt then
			PvpService:release(identity, true, "burst")
		elseif info.weld and info.weld.Parent then
			-- Keep riders on the surface as the host grows.
			local c0 = info.weld.C0
			local dir = c0.Position.Unit
			info.weld.C0 = CFrame.new(dir * (host.diameter / 2 + 1.5)) * (c0 - c0.Position)
		end
	end
end

function PvpService:start()
	services.BallService.BurstRequested:Connect(function(player)
		local info = self.riders[player]
		if info and os.clock() >= info.burstAt then
			self:release(player, true, "burst")
		end
	end)
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc >= 1 / 20 then
			acc = 0
			local ok, err = pcall(tick)
			if not ok then
				warn("[Pvp] tick: " .. tostring(err))
			end
			pcall(riderTick)
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		self.riders[player] = nil
		for _, state in services.BallService:all() do
			if state.riders[player] then
				state.riders[player] = nil
			end
		end
	end)
end

return PvpService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="83">
          <Properties>
            <string name="Name">RequestService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Daily reasons to come back:
--   * Login streak, claimed once per UTC day (Daily.claimStreak) for Stardust and exclusive shells.
--   * Nana Nova's three daily requests, progressed by what you do in any round, claimed for
--     Stardust, plus a bonus for finishing all three (and Nana's Knit shell after five such days).
-- Progress is applied server-side from gameplay signals; the client only ever asks to claim/swap.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Guard = require(Shared.Util.Guard)
local Daily = require(Shared.Logic.Daily)
local Rarity = require(Shared.Config.Rarity)
local Cosmetics = require(Shared.Data.Cosmetics)

local RequestService = {}

local services
local dirtyAt: { [Player]: number } = {}

local SYNC_DELAY = 1.2 -- coalesce progress syncs (absorbs happen many times a second)

function RequestService:init(s)
	services = s
end

local function today(): number
	return Daily.dayIndex(os.time())
end

local function data(player: Player)
	return services.PlayerDataService:getLoaded(player)
end

-- Roll over to today's requests if the saved ones are from another day.
local function ensureToday(player: Player): boolean
	local d = data(player)
	if not d then
		return false
	end
	local day = today()
	if d.daily.day == day and #d.daily.requests == 3 then
		return false
	end
	services.PlayerDataService:update(player, function(p)
		p.daily = {
			day = day,
			requests = Daily.generate(player.UserId, day),
			bonusClaimed = false,
			swaps = 0,
		}
	end)
	return true
end

local function grantShell(player: Player, shellId: string): boolean
	local granted = false
	services.PlayerDataService:update(player, function(p)
		if p.cosmetics.shells[shellId] then
			return false
		end
		p.cosmetics.shells[shellId] = true
		granted = true
		return true
	end)
	return granted
end

-- Apply one gameplay event to a player's requests.
local function push(player: any, ev)
	if not Net.isPlayer(player) then
		return
	end
	local d = data(player)
	if not d then
		return
	end
	if d.daily.day ~= today() then
		ensureToday(player)
	end
	local anyChange = false
	for slot, req in d.daily.requests do
		local changed, completed = Daily.apply(req, ev)
		if changed then
			anyChange = true
		end
		if completed then
			if services.RoundService and services.RoundService:isPlaying() then
				local st = services.RoundService:stats(player)
				st.requestsCompleted += 1
			end
			Net.fire("Toast", player, "request", {
				slot = slot,
				text = Daily.describe(req),
				icon = Daily.icon(req),
				reward = req.reward,
			})
			if services.AnalyticsService and services.AnalyticsService.custom then
				services.AnalyticsService:custom(player, "RequestDone", req.tier)
			end
		end
	end
	if anyChange then
		-- Mark dirty without syncing every absorb; the flush loop syncs shortly after.
		services.PlayerDataService:markDirty(player)
		if not dirtyAt[player] then
			dirtyAt[player] = os.clock()
		end
	end
end

-- CLAIMS -----------------------------------------------------------------------------------------

local function claimStreak(player: Player)
	local d = data(player)
	if not d then
		return false, "loading"
	end
	local updated, reward = Daily.claimStreak(d.streak, today())
	if not updated or not reward then
		return false, "claimed"
	end
	local stardust = reward.stardust
	local shellGranted = nil
	services.PlayerDataService:update(player, function(p)
		p.streak = updated
	end)
	if reward.shell then
		if grantShell(player, reward.shell) then
			shellGranted = reward.shell
		else
			stardust += Daily.ShellDuplicateStardust
		end
	end
	services.PlayerDataService:grantStardust(player, stardust, "Streak")
	return true, { count = updated.count, stardust = stardust, shell = shellGranted }
end

local function claimRequest(player: Player, slot: number)
	local d = data(player)
	if not d then
		return false, "loading"
	end
	ensureToday(player)
	local req = d.daily.requests[slot]
	if not req or not req.done or req.claimed then
		return false, "not_ready"
	end
	services.PlayerDataService:update(player, function()
		req.claimed = true
	end)
	services.PlayerDataService:grantStardust(player, req.reward, "NanaRequest")
	local result = { stardust = req.reward, bonus = nil, shell = nil }
	local allClaimed = true
	for _, r in d.daily.requests do
		if not r.claimed then
			allClaimed = false
		end
	end
	if allClaimed and not d.daily.bonusClaimed then
		services.PlayerDataService:update(player, function(p)
			p.daily.bonusClaimed = true
			p.nanaDays += 1
		end)
		services.PlayerDataService:grantStardust(player, Daily.AllDoneBonus, "NanaBonus")
		result.bonus = Daily.AllDoneBonus
		if d.nanaDays >= Daily.KnitShellDays and Cosmetics.ById.Knitted and grantShell(player, "Knitted") then
			result.shell = "Knitted"
		end
	end
	return true, result
end

local function swapRequest(player: Player, slot: number)
	local d = data(player)
	if not d then
		return false, "loading"
	end
	ensureToday(player)
	if d.daily.swaps >= 1 then
		return false, "no_swaps"
	end
	local req = d.daily.requests[slot]
	if not req or req.done then
		return false, "not_swappable"
	end
	local replacement = Daily.reroll(d.daily.requests, slot, player.UserId, d.daily.day, d.daily.swaps)
	if not replacement then
		return false, "not_swappable"
	end
	services.PlayerDataService:update(player, function(p)
		p.daily.requests[slot] = replacement
		p.daily.swaps += 1
	end)
	return true, replacement
end

-- LIFECYCLE --------------------------------------------------------------------------------------

function RequestService:start()
	local pds = services.PlayerDataService
	if not pds then
		warn("[Requests] PlayerDataService missing; daily requests disabled")
		return
	end
	pds.Loaded:Connect(function(player)
		ensureToday(player)
		local d = data(player)
		local claimable, count = Daily.streakStatus(d.streak, today())
		Net.fire("Toast", player, "daily", {
			streakClaimable = claimable,
			streakNext = count,
			resetIn = Daily.secondsUntilReset(os.time()),
		})
	end)

	Net.action("ClaimStreak", Guard.optional(Guard.boolean()), function(player)
		return claimStreak(player)
	end, 2)
	Net.action("ClaimRequest", Guard.integer(1, 3), function(player, slot)
		return claimRequest(player, slot)
	end, 4)
	Net.action("SwapRequest", Guard.integer(1, 3), function(player, slot)
		return swapRequest(player, slot)
	end, 2)

	-- Gameplay -> request progress.
	services.AbsorbService.Absorbed:Connect(function(state, prop)
		local rarity = Rarity.get(prop.def.rarity)
		push(state.player, {
			kind = "absorb",
			tags = prop.def.tags,
			rarityOrder = rarity and rarity.order or 1,
			mutated = prop.mutation > 0,
			critter = prop.critter,
			landmark = prop.landmark,
		})
	end)
	services.BallService.DiameterChanged:Connect(function(state, old, new)
		-- Only whole-stud milestones matter for size requests.
		if math.floor(new) > math.floor(old) then
			push(state.player, { kind = "size", diameter = new })
		end
	end)
	if services.PvpService then
		services.PvpService.Rolled:Connect(function(host)
			push(host.player, { kind = "rolledPlayer" })
		end)
	end
	services.RoundService.RoundEnded:Connect(function(statsList)
		for _, stats in statsList do
			local player = Players:GetPlayerByUserId(stats.userId)
			if player then
				push(player, { kind = "roundEnd", placement = stats.placement })
			end
		end
	end)

	-- Flush coalesced syncs; roll everyone over at UTC midnight.
	task.spawn(function()
		local lastDay = today()
		while true do
			task.wait(0.5)
			local now = os.clock()
			for player, at in dirtyAt do
				if now - at >= SYNC_DELAY then
					dirtyAt[player] = nil
					if player.Parent then
						pds:sync(player)
					end
				end
			end
			local day = today()
			if day ~= lastDay then
				lastDay = day
				for _, player in Players:GetPlayers() do
					if ensureToday(player) then
						Net.fire("Toast", player, "daily", { newDay = true, streakClaimable = true, resetIn = Daily.secondsUntilReset(os.time()) })
					end
				end
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		dirtyAt[player] = nil
	end)
end

return RequestService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="84">
          <Properties>
            <string name="Name">RolledexService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- The Rolledex: every prop you have ever rolled up, and every mutation variant of it. Stored as a
-- bitset in the profile (bit uid * VariantsPerProp + 0 = "discovered", + mutationIndex = variant).
-- Decoded once per session and re-encoded only when something new is found.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Bitset = require(Shared.Util.Bitset)
local Signal = require(Shared.Util.Signal)
local Mutations = require(Shared.Data.Mutations)
local PropLibrary = require(Shared.Logic.PropLibrary)

local RolledexService = {}
RolledexService.Discovered = Signal.new() -- (player, uid, mutation, isNew, isNewVariant)

local services
local sets: { [Player]: any } = {}

local STRIDE = Mutations.VariantsPerProp

function RolledexService:init(s)
	services = s
end

local function setFor(player: Player)
	local set = sets[player]
	if set then
		return set
	end
	local data = services.PlayerDataService and services.PlayerDataService:getLoaded(player)
	if not data then
		return nil
	end
	set = Bitset.decode(data.rolledex)
	sets[player] = set
	return set
end

-- Returns isNew (first time this prop was ever rolled up), isNewVariant (first time this mutation).
function RolledexService:discover(player: Player, uid: number, mutation: number): (boolean, boolean)
	if not Net.isPlayer(player) or not PropLibrary.get(uid) then
		return false, false
	end
	local set = setFor(player)
	if not set then
		return false, false
	end
	local isNew = Bitset.set(set, uid * STRIDE)
	local isNewVariant = false
	if mutation and mutation > 0 and mutation < STRIDE then
		isNewVariant = Bitset.set(set, uid * STRIDE + mutation)
	end
	if isNew or isNewVariant then
		services.PlayerDataService:update(player, function(data)
			data.rolledex = Bitset.encode(set)
		end)
		self.Discovered:Fire(player, uid, mutation, isNew, isNewVariant)
	end
	return isNew, isNewVariant
end

function RolledexService:has(player: Player, uid: number, mutation: number?): boolean
	local set = setFor(player)
	return set ~= nil and Bitset.get(set, uid * STRIDE + (mutation or 0))
end

-- Discovered props per kit, for completion stats.
function RolledexService:progress(player: Player, kitId: string): (number, number)
	local set = setFor(player)
	local total, found = 0, 0
	for _, def in (PropLibrary.ByKit[kitId] or {}) :: { any } do
		total += 1
		if set and Bitset.get(set, def.uid * STRIDE) then
			found += 1
		end
	end
	return found, total
end

function RolledexService:start()
	Players.PlayerRemoving:Connect(function(player)
		sets[player] = nil
	end)
	if services.PlayerDataService then
		services.PlayerDataService.Loaded:Connect(function(player)
			sets[player] = nil
		end)
	end
end

return RolledexService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="85">
          <Properties>
            <string name="Name">RoundService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Continuous round loop: Playing (Scramble -> world event -> FINAL ROLL) -> Launch -> Results
-- (podium + awards) -> Intermission (hub) -> next map. Players can drop in at any moment.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)
local Guard = require(Shared.Util.Guard)
local Tuning = require(Shared.Config.Tuning)
local Tiers = require(Shared.Config.Tiers)
local Rarity = require(Shared.Config.Rarity)
local Kits = require(Shared.Data.Kits)
local Mutations = require(Shared.Data.Mutations)
local Awards = require(Shared.Logic.Awards)
local Rewards = require(Shared.Logic.Rewards)
local ModeScoring = require(Shared.Logic.ModeScoring)
local Modes = require(Shared.Data.Modes)

local RoundService = {}

RoundService.state = "Starting" -- Playing | Launch | Results | Intermission
RoundService.phase = "Scramble" -- Scramble | FinalRoll
RoundService.endsAt = 0 -- server time (workspace:GetServerTimeNow())
RoundService.startedAt = 0
RoundService.roundId = 0
RoundService.kitId = nil
RoundService.tier = Tiers.forPlace(game.PlaceId)
RoundService.roundStats = {} :: { [number]: any }
RoundService.playerState = {} :: { [Player]: string }
RoundService.ready = {} :: { [Player]: boolean }
RoundService.lastResults = nil
RoundService.modeId = "Classic"
RoundService.teams = {} :: { [number]: string } -- userId -> "Red" | "Blue" (team modes)
RoundService.crownId = nil :: number?
RoundService.vote = nil :: any -- { options, votes = { [userId] = index }, endsAt }
RoundService.nextChoice = nil :: any -- { kitId, modeId } decided by the vote

RoundService.RoundStarted = Signal.new()
RoundService.FinalRollStarted = Signal.new()
RoundService.RoundEnded = Signal.new() -- (statsList)
RoundService.PlayerStateChanged = Signal.new()

local services
local kitQueue = {}
local eventFired = {}

local function now(): number
	return Workspace:GetServerTimeNow()
end

local function roundLength(): number
	local live = services.LiveConfigService
	return (live and live:get("roundLength")) or Modes.get(RoundService.modeId).length or Tuning.Round.Length
end

function RoundService:mode()
	return Modes.get(self.modeId)
end

function RoundService:eventTimes(): { number }
	return self:mode().eventTimes or Tuning.Round.EventTimes
end

-- Team for a ball owner (assigned on first ask in team modes; nil otherwise).
function RoundService:teamOf(player: any): string?
	if not self:mode().teams then
		return nil
	end
	local team = self.teams[player.UserId]
	if not team then
		local counts = { Red = 0, Blue = 0 }
		for _, t in self.teams do
			counts[t] += 1
		end
		team = ModeScoring.pickTeam(counts)
		self.teams[player.UserId] = team
	end
	return team
end

function RoundService:sameTeam(a: any, b: any): boolean
	if not self:mode().teams or not a or not b then
		return false
	end
	local ta, tb = self:teamOf(a), self:teamOf(b)
	return ta ~= nil and ta == tb
end

function RoundService:init(s)
	services = s
end

function RoundService:isPlaying(): boolean
	return self.state == "Playing"
end

function RoundService:isFinalRoll(): boolean
	return self.state == "Playing" and self.phase == "FinalRoll"
end

function RoundService:timeLeft(): number
	return math.max(0, self.endsAt - now())
end

function RoundService:setPlayerState(player: Player, state: string)
	self.playerState[player] = state
	player:SetAttribute("RollState", state)
	self.PlayerStateChanged:Fire(player, state)
end

-- Per-player stats that survive ball respawns within a round.
function RoundService:stats(player: Player)
	local s = self.roundStats[player.UserId]
	if not s then
		s = {
			userId = player.UserId,
			name = player.DisplayName,
			finalDiameter = 0,
			peakDiameter = 0,
			discoveries = 0,
			newVariants = 0,
			playersRolled = 0,
			timesRolled = 0,
			respawnDiameter = 0,
			comebackRatio = 0,
			requestsCompleted = 0,
			rarestOrder = 0,
			rarestUid = 0,
			rarestMutation = 0,
			rarityPoints = 0,
			absorbed = 0,
			crownTime = 0,
			goldPoints = 0,
			team = nil,
			biggestAbsorb = nil,
			joinedAt = os.clock(),
		}
		self.roundStats[player.UserId] = s
	end
	return s
end

function RoundService:snapshot()
	local top = {}
	for _, state in services.BallService:all() do
		local st = self.roundStats[state.userId]
		local entry = {
			userId = state.userId,
			name = state.player.DisplayName,
			d = state.diameter,
			avatarId = (state.player :: any).avatarId,
			team = self.teams[state.userId],
		}
		entry.s = ModeScoring.score(self.modeId, { userId = state.userId, finalDiameter = state.diameter, crownTime = st and st.crownTime, goldPoints = st and st.goldPoints })
		table.insert(top, entry)
	end
	table.sort(top, function(a, b)
		if a.s == b.s then
			return a.d > b.d
		end
		return a.s > b.s
	end)
	for i = #top, 4, -1 do
		top[i] = nil
	end
	local event = services.EventService and services.EventService:current()
	return {
		state = self.state,
		phase = self.phase,
		endsAt = self.endsAt,
		roundId = self.roundId,
		kitId = self.kitId,
		tier = self.tier.id,
		cmPerStud = self.tier.cmPerStud,
		landmarkId = services.WorldService.landmarkId,
		top = top,
		event = event,
		players = #Players:GetPlayers(),
		mode = self.modeId,
		mutator = services.EventService and services.EventService:mutatorId() or nil,
		mods = services.EventService and services.EventService:mods() or nil,
		teamTotals = if self:mode().teams then self:teamTotals() else nil,
		crownId = self.crownId,
		vote = self:voteSnapshot(),
	}
end

function RoundService:broadcast()
	Net.fireAll("RoundState", self:snapshot())
end

-- Kit rotation: shuffled bag per tier; live config or a private-server host can force a kit.
local function nextKit(): string
	local live = services.LiveConfigService
	local forced = live and live:get("forceKit")
	local social = services.SocialService
	local hostKit = social and social:hostSetting("kit")
	if hostKit and Kits.get(hostKit) then
		return hostKit
	end
	if forced and Kits.get(forced) then
		return forced
	end
	if #kitQueue == 0 then
		for _, kit in Kits.forTier(RoundService.tier.id) do
			table.insert(kitQueue, kit.id)
		end
		if #kitQueue == 0 then
			table.insert(kitQueue, Kits.List[1].id)
		end
		for i = #kitQueue, 2, -1 do
			local j = math.random(1, i)
			kitQueue[i], kitQueue[j] = kitQueue[j], kitQueue[i]
		end
		-- Avoid repeating the previous kit back to back.
		if kitQueue[#kitQueue] == RoundService.kitId and #kitQueue > 1 then
			kitQueue[1], kitQueue[#kitQueue] = kitQueue[#kitQueue], kitQueue[1]
		end
	end
	return table.remove(kitQueue) :: string
end

local function medianDiameter(): number
	local list = {}
	for _, state in services.BallService:all() do
		table.insert(list, state.diameter)
	end
	if #list == 0 then
		return Tuning.Ball.StartDiameter
	end
	table.sort(list)
	return list[math.ceil(#list / 2)]
end

-- Spawn (or respawn) a player into the running round.
function RoundService:spawnIntoRound(player: Player, options: { [string]: any }?)
	local opts: { [string]: any } = options or {}
	if self.state ~= "Playing" then
		return
	end
	local character = player.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") then
		return
	end
	local diameter = opts.diameter or Tuning.Ball.StartDiameter
	local boosts = {}
	if opts.catchUp then
		local median = medianDiameter()
		diameter = math.max(Tuning.Ball.StartDiameter, median * Tuning.Pvp.CatchUpFraction)
		if median > Tuning.Ball.StartDiameter * 2 then
			table.insert(boosts, {
				mult = Tuning.Pvp.CatchUpBoostMultiplier,
				untilT = os.clock() + Tuning.Pvp.CatchUpBoostDuration,
				reason = "catchup",
			})
		end
	end
	local position = opts.position
	if not position then
		local spawns = services.WorldService:spawnPoints()
		position = if #spawns > 0 then spawns[math.random(1, #spawns)] else Vector3.new(0, 50, 0)
		-- Party members spawn next to each other.
		local social = services.SocialService
		local buddy = social and social:spawnBuddy(player)
		if buddy then
			local buddyBall = services.BallService:get(buddy)
			if buddyBall and buddyBall.part.Parent then
				position = buddyBall.part.Position + Vector3.new(math.random(-8, 8), buddyBall.diameter, math.random(-8, 8))
			end
		end
		-- Bigger drop-in balls start a little off the crowded spawn counter.
		if diameter > 20 then
			local a = math.random() * math.pi * 2
			local r = services.WorldService.kit.arenaHalf * 0.5
			local x, z = math.cos(a) * r, math.sin(a) * r
			position = Vector3.new(x, services.WorldService:groundAt(x, z) + 2, z)
		end
	end
	local state = services.BallService:spawn(player, position, diameter, { growthBoosts = boosts, shield = opts.shield })
	if state then
		local team = self:teamOf(player)
		if team then
			state.part:SetAttribute("Team", team)
			self:stats(player).team = team
		end
		self:setPlayerState(player, "Rolling")
		local stats = self:stats(player)
		stats.peakDiameter = math.max(stats.peakDiameter, diameter)
		if opts.afterRolled then
			stats.respawnDiameter = diameter
		end
	end
	return state
end

local function moveAllToHub()
	for _, player in Players:GetPlayers() do
		services.BallService:remove(player, "round_end")
		if services.HubService then
			services.HubService:sendToHub(player)
		end
		RoundService:setPlayerState(player, "Hub")
	end
end

function RoundService:startRound()
	self.roundId += 1
	local choice = self.nextChoice
	self.nextChoice = nil
	self.vote = nil
	self.kitId = if choice and Kits.get(choice.kitId) then choice.kitId else nextKit()
	-- The very first round of a server is always Classic so new players learn the basics.
	self.modeId = if choice then Modes.get(choice.modeId).id else (if self.roundId == 1 then "Classic" else self:randomMode())
	table.clear(self.teams)
	self.crownId = nil
	local seed = math.floor(os.time() % 1000000) * 7919 + self.roundId * 104729
	table.clear(self.roundStats)
	table.clear(eventFired)
	local events = services.EventService
	if events then
		events:chooseMutator(self.roundId > 1)
	end
	local mode = self:mode()
	services.WorldService:load(self.kitId, seed, function(world)
		if events then
			events:prepareWorld(world, mode)
		end
	end)
	self.state = "Playing"
	self.phase = "Scramble"
	self.startedAt = now()
	self.endsAt = self.startedAt + roundLength()
	for _, player in Players:GetPlayers() do
		if self.ready[player] then
			self:spawnIntoRound(player)
		end
	end
	self.RoundStarted:Fire(self.kitId, self.roundId)
	if services.AnalyticsService then
		services.AnalyticsService:serverEvent("RoundStart", { kit = self.kitId, players = #Players:GetPlayers() })
	end
	self:broadcast()
end

local function collectStats(): { any }
	local list = {}
	local everyone = table.clone(Players:GetPlayers()) :: { any }
	if services.BotService then
		for _, bot in services.BotService:identities() do
			table.insert(everyone, bot)
		end
	end
	for _, player in everyone do
		local stats = RoundService.roundStats[player.UserId]
		if stats then
			local ball = services.BallService:get(player)
			stats.finalDiameter = if ball then ball.diameter else stats.finalDiameter
			stats.name = player.DisplayName
			if stats.timesRolled > 0 and stats.respawnDiameter > 0 then
				stats.comebackRatio = stats.finalDiameter / stats.respawnDiameter
			end
			table.insert(list, stats)
		end
	end
	return list
end

function RoundService:launch()
	self.state = "Launch"
	self.phase = "Launch"
	self.endsAt = now() + Tuning.Round.Launch
	-- Riders and merged partners pop off first so every ball launches clean.
	if services.PvpService then
		services.PvpService:releaseAllRiders("launch")
	end
	if services.MergeService then
		services.MergeService:splitAll("launch")
	end
	local launchList = {}
	for _, state in services.BallService:all() do
		local part = state.part
		if part and part.Parent then
			part.Anchored = true
			state.alive = false -- freezes absorbing, validation and PvP
			table.insert(launchList, {
				userId = state.userId,
				ball = state.model,
				diameter = state.diameter,
				launchFx = state.launchFx,
			})
		end
	end
	local statsList = collectStats()
	-- Planets are born from the launched balls (GalaxyService stores them compactly).
	if services.GalaxyService then
		for _, state in services.BallService.states do
			local ok, err = pcall(services.GalaxyService.createPlanet, services.GalaxyService, state, self.kitId)
			if not ok then
				warn("[Round] planet creation failed: " .. tostring(err))
			end
		end
	end
	Net.fireAll("LaunchSequence", launchList, self.endsAt)
	self:broadcast()
	return statsList
end

function RoundService:results(statsList)
	self.state = "Results"
	self.phase = "Results"
	self.endsAt = now() + Tuning.Round.Results
	local mode = self:mode()
	local modeId = self.modeId
	local awards = Awards.select(statsList, {
		title = mode.winnerTitle,
		icon = mode.winnerIcon,
		score = function(p)
			return ModeScoring.score(modeId, p)
		end,
	})
	local standings = ModeScoring.standings(modeId, statsList)
	local winningTeam = ModeScoring.winningTeam(modeId, statsList)
	local awardCount = {}
	for _, award in awards do
		awardCount[award.userId] = (awardCount[award.userId] or 0) + 1
	end

	for place, stats in standings do
		stats.placement = place
	end

	-- Stardust for everyone who played.
	local payouts = {}
	for _, stats in statsList do
		local player = Players:GetPlayerByUserId(stats.userId)
		if player then
			local data = services.PlayerDataService
			local monet = services.MonetizationService
			local social = services.SocialService
			local events = services.EventService
			local breakdown = Rewards.round({
				finalDiameter = stats.finalDiameter,
				cmPerStud = self.tier.cmPerStud,
				discoveries = stats.discoveries,
				newVariants = stats.newVariants,
				playersRolled = stats.playersRolled,
				awards = awardCount[stats.userId] or 0,
				rarityPoints = stats.rarityPoints,
				friendsInServer = if social then social:friendCount(player) else 0,
				vip = if monet then monet:hasPass(player, "VIP") else false,
				doubleStardust = if monet then monet:hasPass(player, "DoubleStardust") else false,
				eventMultiplier = if events then events:stardustMultiplier() else 1,
			})
			payouts[stats.userId] = breakdown
			if data then
				data:grantStardust(player, breakdown.total, "Round")
				data:recordRound(player, stats, awardCount[stats.userId] or 0)
			end
		end
	end

	local podium = {}
	for i = 1, math.min(3, #standings) do
		podium[i] = { userId = standings[i].userId, name = standings[i].name, d = standings[i].finalDiameter, s = ModeScoring.score(modeId, standings[i]), team = standings[i].team }
	end
	-- Roll of the Round: the single biggest absorption (players rolled count extra).
	local highlight = nil
	for _, stats in statsList do
		local b = stats.biggestAbsorb
		if b and (highlight == nil or b.score > highlight.score) then
			highlight = b
		end
	end

	moveAllToHub()
	-- Winners stand on the podium.
	if services.HubService then
		for i, entry in podium do
			local player = Players:GetPlayerByUserId(entry.userId)
			if player and services.HubService.podium[i] then
				services.HubService:sendToHub(player, services.HubService.podium[i])
			end
		end
	end

	self.lastResults = {
		roundId = self.roundId,
		kitId = self.kitId,
		awards = awards,
		podium = podium,
		standings = standings,
		highlight = highlight,
		cmPerStud = self.tier.cmPerStud,
		mode = modeId,
		winningTeam = winningTeam,
		teamTotals = if mode.teams then ModeScoring.teamTotals(statsList) else nil,
	}
	for _, player in Players:GetPlayers() do
		local personal = table.clone(self.lastResults)
		personal.payout = payouts[player.UserId]
		personal.mine = self.roundStats[player.UserId]
		Net.fire("Results", player, personal)
	end
	self.RoundEnded:Fire(statsList, awards)
	self.crownId = nil
	self:openVote()
	self:broadcast()
end

function RoundService:intermission()
	self.state = "Intermission"
	self.phase = "Intermission"
	local social = services.SocialService
	local length = (social and social:hostSetting("intermission")) or Tuning.Round.Intermission
	self.endsAt = now() + length
	self:broadcast()
end

local function waitUntil(t: number)
	while now() < t do
		task.wait(0.25)
	end
end

-- Recording the round's notable moments for awards and the highlight.
local function hookStats()
	services.AbsorbService.Absorbed:Connect(function(state, prop, info)
		local player = state.player
		if not player or not player.Parent then
			return
		end
		local stats = RoundService:stats(player)
		stats.absorbed += 1
		local mutDef = Mutations.get(prop.mutation)
		if mutDef then
			stats.goldPoints += mutDef.stardust
		end
		if info.isNew then
			stats.discoveries += 1
		end
		if info.isNewVariant then
			stats.newVariants += 1
		end
		local rarity = Rarity.get(prop.def.rarity)
		local mut = Mutations.get(prop.mutation)
		local order = rarity.order + (if mut then mut.rarityBoost else 0)
		stats.rarityPoints += (Tuning.Rewards.RarityBonus[rarity.id] or 0) * (if mut then mut.stardust else 1)
		if order > stats.rarestOrder then
			stats.rarestOrder = order
			stats.rarestUid = prop.uid
			stats.rarestMutation = prop.mutation
		end
		local score = prop.absorbSize
		if not stats.biggestAbsorb or score > stats.biggestAbsorb.score then
			stats.biggestAbsorb = {
				score = score,
				kind = "prop",
				userId = player.UserId,
				name = player.DisplayName,
				uid = prop.uid,
				mutation = prop.mutation,
				diameter = state.diameter,
			}
		end
		-- Legendary first discoveries are announced to the whole server.
		if info.isNew and rarity.announce then
			Net.fireAll("Announce", "legendary", { name = player.DisplayName, uid = prop.uid, mutation = prop.mutation })
		end
	end)
	services.BallService.DiameterChanged:Connect(function(state, _, new)
		local stats = RoundService:stats(state.player)
		stats.peakDiameter = math.max(stats.peakDiameter, new)
		stats.finalDiameter = new
	end)
end

function RoundService:teamTotals(): { [string]: number }
	local totals = { Red = 0, Blue = 0 }
	for _, state in services.BallService:all() do
		local team = self.teams[state.userId]
		if team then
			totals[team] += state.diameter
		end
	end
	return totals
end

function RoundService:randomMode(): string
	local balls = #services.BallService:all() + #Players:GetPlayers()
	local pool, total = {}, 0
	for _, m in Modes.List do
		if (m.minBalls or 0) <= math.max(balls, Tuning.Bots.TargetBalls) then
			table.insert(pool, m)
			total += m.weight
		end
	end
	local r = math.random() * total
	for _, m in pool do
		r -= m.weight
		if r <= 0 then
			return m.id
		end
	end
	return "Classic"
end

-- Per-tick mode rules: the crown follows the biggest ball and banks crown time.
local lastCrownAnnounce = 0
function RoundService:tickMode(dt: number)
	if self:mode().scoring ~= "crown" or self.state ~= "Playing" then
		return
	end
	local best, bestD = nil, 0
	for _, state in services.BallService:all() do
		if state.alive and state.diameter > bestD then
			best, bestD = state, state.diameter
		end
	end
	local newId = best and best.userId or nil
	if newId ~= self.crownId then
		for _, state in services.BallService:all() do
			if state.part then
				state.part:SetAttribute("Crown", if state.userId == newId then true else nil)
			end
		end
		self.crownId = newId
		if best and now() - lastCrownAnnounce > 3 then
			lastCrownAnnounce = now()
			Net.fireAll("Announce", "crown", { userId = best.userId, name = best.player.DisplayName })
		end
	end
	if best then
		local st = self:stats(best.player)
		st.crownTime += dt
	end
end

-- VOTE ---------------------------------------------------------------------------------------

function RoundService:openVote()
	-- Three different map + mode combos; at least one is a new map.
	local kits = {}
	for _, kit in Kits.forTier(self.tier.id) do
		table.insert(kits, kit.id)
	end
	if #kits == 0 then
		table.insert(kits, Kits.List[1].id)
	end
	local options = {}
	local usedModes = {}
	for i = 1, 3 do
		local kitId = kits[((self.roundId + i) % #kits) + 1]
		if i == 1 and #kits > 1 and kitId == self.kitId then
			kitId = kits[((self.roundId + i + 1) % #kits) + 1]
		end
		local modeId = self:randomMode()
		for _ = 1, 6 do
			if not usedModes[modeId] then
				break
			end
			modeId = self:randomMode()
		end
		usedModes[modeId] = true
		table.insert(options, { kitId = kitId, modeId = modeId })
	end
	local social = services.SocialService
	local length = (social and social:hostSetting("intermission")) or Tuning.Round.Intermission
	self.vote = {
		options = options,
		votes = {},
		endsAt = now() + Tuning.Round.Results + length - 1,
	}
	-- Bots vote too, at human-ish moments.
	if services.BotService then
		for _, bot in services.BotService:identities() do
			task.delay(2 + math.random() * (Tuning.Round.Results + length - 6), function()
				if self.vote and self.vote.options == options then
					self.vote.votes[bot.UserId] = math.random(1, 3)
					self:broadcast()
				end
			end)
		end
	end
end

function RoundService:closeVote()
	local vote = self.vote
	if not vote then
		return
	end
	local pick = ModeScoring.resolveVote(#vote.options, vote.votes, math.random(1, 3))
	self.nextChoice = vote.options[pick]
	self.vote = nil
end

function RoundService:voteSnapshot()
	local vote = self.vote
	if not vote then
		return nil
	end
	local counts = table.create(#vote.options, 0)
	for _, idx in vote.votes do
		if counts[idx] then
			counts[idx] += 1
		end
	end
	return { options = vote.options, counts = counts, endsAt = vote.endsAt }
end

function RoundService:loop()
	-- First round starts immediately so nobody waits in a lobby.
	self:startRound()
	while true do
		local fireAt = {}
		for _, t in self:eventTimes() do
			table.insert(fireAt, self.startedAt + t)
		end
		local lastTick = now()
		while now() < self.endsAt do
			local tickNow = now()
			self:tickMode(tickNow - lastTick)
			lastTick = tickNow
			local left = self.endsAt - now()
			if self.phase == "Scramble" and left <= Tuning.Round.FinalRoll then
				self.phase = "FinalRoll"
				self.FinalRollStarted:Fire()
				Net.fireAll("Announce", "finalroll", { landmarkId = services.WorldService.landmarkId })
				self:broadcast()
			end
			for i, t in fireAt do
				if not eventFired[i] and now() >= t and services.EventService then
					eventFired[i] = true
					services.EventService:triggerRoundEvent()
				end
			end
			task.wait(0.25)
		end
		local statsList = self:launch()
		waitUntil(self.endsAt)
		self:results(statsList)
		waitUntil(self.endsAt)
		self:intermission()
		waitUntil(self.endsAt)
		self:closeVote()
		self:startRound()
	end
end

-- Drop a newly joined player into the running round (once their client has built the props
-- around spawn, or after a short fallback so nobody waits).
local function dropIn(player: Player)
	if RoundService.state ~= "Playing" or not RoundService.ready[player] then
		return
	end
	if services.BallService:get(player) or RoundService.playerState[player] == "Rolling" then
		return
	end
	local catchUp = (now() - RoundService.startedAt) > 20
	RoundService:spawnIntoRound(player, { catchUp = catchUp })
end

local function onReady(player: Player)
	if RoundService.ready[player] then
		return
	end
	RoundService.ready[player] = true
	services.WorldService:sendTo(player)
	Net.fire("RoundState", player, RoundService:snapshot())
	if RoundService.lastResults and RoundService.state ~= "Playing" then
		Net.fire("Results", player, RoundService.lastResults)
	end
	RoundService:setPlayerState(player, "Hub")
	if RoundService.state == "Playing" then
		task.delay(6, function()
			if player.Parent then
				dropIn(player)
			end
		end)
	end
end

function RoundService:start()
	hookStats()
	Net.action("Ready", Guard.optional(Guard.boolean()), function(player)
		task.spawn(onReady, player)
		return true
	end, 2)
	Net.action("Vote", Guard.integer(1, 3), function(player, index)
		if not self.vote then
			return false
		end
		self.vote.votes[player.UserId] = index
		self:broadcast()
		return true
	end, 4)
	Net.action("Spawn", Guard.optional(Guard.boolean()), function(player)
		task.spawn(dropIn, player)
		return true
	end, 1)
	Players.PlayerRemoving:Connect(function(player)
		self.ready[player] = nil
		self.playerState[player] = nil
	end)
	-- Respawned characters during a round go straight back into a ball.
	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function()
			task.wait(0.2)
			if self.ready[player] and self.state == "Playing" and self.playerState[player] == "Rolling" and not services.BallService:get(player) then
				self:spawnIntoRound(player, { catchUp = true })
			end
		end)
	end)
	-- Periodic HUD refresh (top 3, timer drift).
	task.spawn(function()
		while true do
			task.wait(1)
			if self.state == "Playing" then
				self:broadcast()
			end
		end
	end)
	task.spawn(function()
		-- If anything in the loop throws, log it, reset to a fresh round and keep the server alive.
		while true do
			local ok, err = xpcall(self.loop, debug.traceback, self)
			if not ok then
				warn("[Round] loop error, restarting round: " .. tostring(err))
				task.wait(2)
				pcall(moveAllToHub)
			end
		end
	end)
end

return RoundService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="86">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Stardust shop: unlock and level up Cores, buy and wear ball shells. All prices come from shared
-- data so the client shows exactly what the server charges. Equipping a shell re-skins a live ball
-- immediately; a new Core takes effect on your next roll (it changes ball physics).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Guard = require(Shared.Util.Guard)
local Cores = require(Shared.Data.Cores)
local Cosmetics = require(Shared.Data.Cosmetics)

local ShopService = {}

local services

function ShopService:init(s)
	services = s
end

local function pds()
	return services.PlayerDataService
end

local function buyCore(player: Player, id: string)
	local data = pds():getLoaded(player)
	local def = Cores.get(id)
	if not data or not def then
		return false, "unknown"
	end
	local level = data.cores.owned[id] or 0
	local cost = Cores.costFor(id, level)
	if not cost then
		return false, "max_level"
	end
	if not pds():spendStardust(player, cost, (if level == 0 then "CoreUnlock:" else "CoreUpgrade:") .. id) then
		return false, "afford"
	end
	pds():update(player, function(p)
		p.cores.owned[id] = level + 1
		if level == 0 then
			p.cores.equipped = id -- new toys get worn right away
		end
	end)
	-- Upgrades to the core you're rolling apply now (speed/dash/magnet read the level live).
	local ball = services.BallService:get(player)
	if ball and ball.core == id then
		ball.coreLevel = level + 1
	end
	return true, { level = level + 1 }
end

local function equipCore(player: Player, id: string)
	local data = pds():getLoaded(player)
	if not data or not data.cores.owned[id] then
		return false, "not_owned"
	end
	pds():update(player, function(p)
		p.cores.equipped = id
	end)
	return true, { nextRoll = true }
end

local function buyShell(player: Player, id: string)
	local data = pds():getLoaded(player)
	local def = Cosmetics.ById[id]
	if not data or not def then
		return false, "unknown"
	end
	if data.cosmetics.shells[id] then
		return false, "owned"
	end
	if def.source ~= "Shop" or not def.cost then
		return false, "not_for_sale"
	end
	if not pds():spendStardust(player, def.cost, "Shell:" .. id) then
		return false, "afford"
	end
	pds():update(player, function(p)
		p.cosmetics.shells[id] = true
		p.cosmetics.equipped.shell = id
	end)
	ShopService:applyShell(player, id)
	return true, { equipped = id }
end

local function equipShell(player: Player, id: string)
	local data = pds():getLoaded(player)
	if not data or not data.cosmetics.shells[id] then
		return false, "not_owned"
	end
	pds():update(player, function(p)
		p.cosmetics.equipped.shell = id
	end)
	ShopService:applyShell(player, id)
	return true, { equipped = id }
end

function ShopService:applyShell(player: Player, id: string)
	local ball = services.BallService:get(player)
	if ball then
		ball.shell = id
		if ball.part then
			ball.part:SetAttribute("Shell", id)
		end
	end
end

function ShopService:start()
	if not services.PlayerDataService then
		warn("[Shop] PlayerDataService missing; shop disabled")
		return
	end
	local id = Guard.string(32)
	Net.action("BuyCore", id, buyCore, 3)
	Net.action("EquipCore", id, equipCore, 4)
	Net.action("BuyShell", id, buyShell, 3)
	Net.action("EquipShell", id, equipShell, 4)
end

return ShopService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="87">
          <Properties>
            <string name="Name">WorldService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Owns the round's world: builds static geometry from WorldGen, holds the authoritative prop table
-- in a spatial hash, and replicates compact prop state (never prop instances) to clients.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)
local SpatialHash = require(Shared.Util.SpatialHash)
local PropCodec = require(Shared.Util.PropCodec)
local WorldGen = require(Shared.Logic.WorldGen)
local PropLibrary = require(Shared.Logic.PropLibrary)
local Kits = require(Shared.Data.Kits)
local Mutations = require(Shared.Data.Mutations)
local Tuning = require(Shared.Config.Tuning)

local WorldService = {}

export type PropState = {
	id: number,
	uid: number,
	def: any,
	x: number,
	y: number, -- ground level
	z: number,
	cy: number, -- world y of the contact sphere centre
	yaw: number,
	scale: number, -- placement scale (without mutation scale)
	effScale: number, -- placement scale * mutation scale
	mutation: number,
	absorbSize: number,
	radius: number,
	volume: number,
	landmark: boolean,
	critter: boolean,
	loot: boolean,
	activeAt: number, -- loot can't be grabbed until it lands
	expiresAt: number?,
}

WorldService.kit = nil
WorldService.seed = 0
WorldService.generation = nil
WorldService.props = {} :: { [number]: PropState }
WorldService.hash = SpatialHash.new(32)
WorldService.maxRadius = 0
WorldService.nextId = 1
WorldService.landmarkId = 0
WorldService.mapFolder = nil :: Model?
WorldService.roundId = 0

WorldService.PropRemoved = Signal.new()
WorldService.WorldLoaded = Signal.new()

local pendingRemovals = {}
local pendingMutations = {}
local pendingLoot = {}
local lootCount = 0

local function makeState(id: number, uid: number, x: number, y: number, z: number, yaw: number, scale: number, mutation: number, loot: boolean): PropState
	local def = PropLibrary.get(uid)
	local mut = Mutations.get(mutation)
	local eff = scale * (if mut then mut.scale else 1)
	local m = def.metrics
	return {
		id = id,
		uid = uid,
		def = def,
		x = x,
		y = y,
		z = z,
		cy = y + m.centerY * eff,
		yaw = yaw,
		scale = scale,
		effScale = eff,
		mutation = mutation,
		absorbSize = m.absorbSize * eff,
		radius = m.contactRadius * eff,
		volume = m.volume * eff * eff * eff,
		landmark = def.landmark,
		critter = def.critter ~= nil,
		loot = loot,
		activeAt = 0,
		expiresAt = nil,
	}
end

local function hexColor(hex: string): Color3
	return Color3.fromHex(hex)
end

local function buildGeometry(result, kit): Model
	local model = Instance.new("Model")
	model.Name = "Map"
	model.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	for i, g in result.geometry do
		local part
		if g.shape == "Wedge" then
			part = Instance.new("WedgePart")
		else
			part = Instance.new("Part")
			if g.shape == "Cylinder" then
				part.Shape = Enum.PartType.Cylinder
			elseif g.shape == "Ball" then
				-- Squashable sphere (leafy canopies, rim stones): a sphere mesh on a block part.
				local mesh = Instance.new("SpecialMesh")
				mesh.MeshType = Enum.MeshType.Sphere
				mesh.Parent = part
			end
		end
		part.Name = g.kind .. i
		part.Size = Vector3.new(g.size[1], g.size[2], g.size[3])
		part.CFrame = CFrame.new(g.pos[1], g.pos[2], g.pos[3]) * CFrame.Angles(0, math.rad(g.yaw), 0) * CFrame.Angles(0, 0, math.rad(g.roll or 0))
		part.Color = hexColor(g.color)
		local okMat, mat = pcall(function()
			return Enum.Material[g.material]
		end)
		part.Material = if okMat and mat then mat else Enum.Material.SmoothPlastic
		part.Anchored = true
		part.CanCollide = g.collide
		part.CanTouch = false
		part.CanQuery = g.collide
		part.Transparency = g.transparency or 0
		part.CastShadow = g.kind ~= "tile" and g.kind ~= "barrier" and g.kind ~= "window" and g.kind ~= "water" and g.kind ~= "path" and g.kind ~= "rug"
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		if g.kind == "ramp" or g.kind == "floor" or g.kind == "platform" then
			part:SetAttribute("Walkable", true)
		end
		part.Parent = model
	end
	model:SetAttribute("KitId", kit.id)
	return model
end

function WorldService:applyLighting(kit)
	local l = kit.lighting
	if not l then
		return
	end
	Lighting.ClockTime = l.ClockTime
	Lighting.Brightness = l.Brightness
	Lighting.Ambient = hexColor(l.Ambient)
	Lighting.OutdoorAmbient = hexColor(l.OutdoorAmbient)
	Lighting.ColorShift_Top = hexColor(l.ColorShift_Top)
	Lighting.FogColor = hexColor(l.FogColor)
	Lighting.FogEnd = l.FogEnd
	Lighting.ExposureCompensation = l.ExposureCompensation or 0
	local function ensure(className: string, name: string)
		local inst = Lighting:FindFirstChild(name)
		if not inst then
			inst = Instance.new(className)
			inst.Name = name
			inst.Parent = Lighting
		end
		return inst
	end
	if l.atmosphere then
		local a = ensure("Atmosphere", "KitAtmosphere")
		a.Density = l.atmosphere.Density
		a.Offset = l.atmosphere.Offset
		a.Color = hexColor(l.atmosphere.Color)
		a.Decay = hexColor(l.atmosphere.Decay)
		a.Glare = l.atmosphere.Glare
		a.Haze = l.atmosphere.Haze
	end
	if l.color then
		local c = ensure("ColorCorrectionEffect", "KitColor")
		c.Saturation = l.color.Saturation
		c.Contrast = l.color.Contrast
		c.Brightness = l.color.Brightness
		c.TintColor = hexColor(l.color.TintColor)
	end
	if l.bloom then
		local b = ensure("BloomEffect", "KitBloom")
		b.Intensity = l.bloom.Intensity
		b.Size = l.bloom.Size
		b.Threshold = l.bloom.Threshold
	end
	if l.sunRays then
		local s = ensure("SunRaysEffect", "KitSunRays")
		s.Intensity = l.sunRays.Intensity
		s.Spread = l.sunRays.Spread
	end
end

function WorldService:clear()
	if self.mapFolder then
		self.mapFolder:Destroy()
		self.mapFolder = nil
	end
	self.props = {}
	self.hash = SpatialHash.new(32)
	self.maxRadius = 0
	table.clear(pendingRemovals)
	table.clear(pendingMutations)
	table.clear(pendingLoot)
	lootCount = 0
end

-- `prepare(world)` may adjust props (e.g. mode/mutator mutations) before anyone is sent the map.
function WorldService:load(kitId: string, seed: number, prepare: ((any) -> ())?)
	local kit = Kits.get(kitId)
	assert(kit, "unknown kit " .. tostring(kitId))
	self:clear()
	local started = os.clock()
	local result = WorldGen.generate(kit, seed)
	self.kit = kit
	self.seed = seed
	self.generation = result
	self.roundId += 1
	self.landmarkId = result.landmarkId
	for _, p in result.props do
		-- Use the quantised scale so server contact maths matches what clients render.
		local scale = PropCodec.roundTripScale(p.scale)
		local state = makeState(p.id, p.uid, p.x, p.y, p.z, p.yaw, scale, p.mutation, false)
		self.props[p.id] = state
		self.hash:insert(p.id, p.x, p.z, state.radius)
		self.maxRadius = math.max(self.maxRadius, state.radius)
	end
	self.nextId = #result.props + 1
	if prepare then
		local ok, err = pcall(prepare, self)
		if not ok then
			warn("[World] prepare failed: " .. tostring(err))
		end
		table.clear(pendingMutations) -- already part of the snapshot below
	end
	self.mapFolder = buildGeometry(result, kit)
	self.mapFolder.Parent = Workspace
	self:applyLighting(kit)
	print(string.format("[World] %s seed %d: %d props, %d parts in %.0f ms", kit.id, seed, #result.props, #result.geometry, (os.clock() - started) * 1000))
	for _, player in Players:GetPlayers() do
		self:sendTo(player)
	end
	self.WorldLoaded:Fire(kit, seed)
end

-- Full world snapshot for one client (on load and for players joining mid-round).
function WorldService:sendTo(player: Player)
	if not self.kit then
		return
	end
	local records = {}
	for _, p in self.props do
		table.insert(records, {
			id = p.id,
			uid = p.uid,
			x = p.x,
			y = p.y,
			z = p.z,
			yaw = p.yaw,
			scale = p.scale,
			mutation = p.mutation,
		})
	end
	table.sort(records, function(a, b)
		return a.id < b.id
	end)
	Net.fire("WorldLoad", player, {
		kitId = self.kit.id,
		seed = self.seed,
		roundId = self.roundId,
		landmarkId = self.landmarkId,
		arenaHalf = self.kit.arenaHalf,
		spawnCenter = self.generation.spawnCenter,
	}, PropCodec.encode(records))
end

function WorldService:get(id: number): PropState?
	return self.props[id]
end

function WorldService:queryNear(x: number, z: number, radius: number, out: { number }?): { number }
	return self.hash:query(x, z, radius + self.maxRadius, out)
end

-- Remove a prop for everyone. absorberKey is the absorbing ball's id (0 = vanished).
function WorldService:removeProp(id: number, absorberKey: number)
	local p = self.props[id]
	if not p then
		return nil
	end
	self.props[id] = nil
	self.hash:remove(id)
	if p.loot then
		lootCount -= 1
	end
	table.insert(pendingRemovals, { id, absorberKey })
	self.PropRemoved:Fire(p, absorberKey)
	return p
end

function WorldService:moveProp(id: number, x: number, y: number, z: number, yaw: number?)
	local p = self.props[id]
	if not p then
		return
	end
	p.x, p.y, p.z = x, y, z
	p.cy = y + p.def.metrics.centerY * p.effScale
	if yaw then
		p.yaw = yaw
	end
	self.hash:move(id, x, z, p.radius)
end

function WorldService:setMutation(id: number, mutation: number)
	local p = self.props[id]
	if not p or p.landmark then
		return
	end
	local updated = makeState(p.id, p.uid, p.x, p.y, p.z, p.yaw, p.scale, mutation, p.loot)
	updated.activeAt = p.activeAt
	updated.expiresAt = p.expiresAt
	self.props[id] = updated
	self.hash:move(id, p.x, p.z, updated.radius)
	self.maxRadius = math.max(self.maxRadius, updated.radius)
	table.insert(pendingMutations, { id, mutation })
end

-- Spawns grabbable loot that arcs from `from` to its landing spot. Returns the new ids.
-- entries: { uid, mutation, scale, from: Vector3, to: Vector3 }
function WorldService:spawnLoot(entries: { any }): { number }
	local ids = {}
	local now = os.clock()
	local H = self.kit and self.kit.arenaHalf or 600
	for _, e in entries do
		if lootCount >= Tuning.World.MaxLoot then
			break
		end
		local to: Vector3 = e.to
		local x = math.clamp(to.X, -H + 20, H - 20)
		local z = math.clamp(to.Z, -H + 20, H - 20)
		local id = self.nextId
		self.nextId += 1
		local scale = PropCodec.roundTripScale(e.scale or 1)
		local state = makeState(id, e.uid, x, to.Y, z, math.random() * math.pi * 2, scale, e.mutation or 0, true)
		state.activeAt = now + (e.settle or Tuning.World.LootSettleTime)
		state.expiresAt = now + Tuning.World.LootLifetime
		self.props[id] = state
		self.hash:insert(id, x, z, state.radius)
		self.maxRadius = math.max(self.maxRadius, state.radius)
		lootCount += 1
		local from: Vector3 = e.from
		table.insert(pendingLoot, {
			record = { id = id, uid = e.uid, x = x, y = to.Y, z = z, yaw = state.yaw, scale = scale, mutation = state.mutation },
			from = from,
			settle = e.settle or Tuning.World.LootSettleTime,
		})
		table.insert(ids, id)
	end
	return ids
end

-- Ground height at (x, z) using the generated platform list (used for loot landing and critters).
function WorldService:groundAt(x: number, z: number): number
	local gen = self.generation
	if not gen then
		return 0
	end
	for _, p in gen.platforms do
		if math.abs(x - p.x) <= p.sx / 2 and math.abs(z - p.z) <= p.sz / 2 then
			return p.height
		end
	end
	return 0
end

function WorldService:platformAt(x: number, z: number)
	local gen = self.generation
	if not gen then
		return nil
	end
	for _, p in gen.platforms do
		if math.abs(x - p.x) <= p.sx / 2 and math.abs(z - p.z) <= p.sz / 2 then
			return p
		end
	end
	return nil
end

function WorldService:spawnPoints(): { Vector3 }
	local out = {}
	if self.generation then
		for _, s in self.generation.spawns do
			table.insert(out, Vector3.new(s[1], s[2], s[3]))
		end
	end
	return out
end

local function flush()
	if #pendingRemovals > 0 then
		Net.fireAll("PropsRemoved", pendingRemovals)
		pendingRemovals = {}
	end
	if #pendingMutations > 0 then
		Net.fireAll("PropsMutated", pendingMutations)
		pendingMutations = {}
	end
	if #pendingLoot > 0 then
		local records, origins, settles = {}, {}, {}
		for i, l in pendingLoot do
			records[i] = l.record
			origins[i] = l.from
			settles[i] = l.settle
		end
		Net.fireAll("LootSpawned", PropCodec.encode(records), origins, settles)
		pendingLoot = {}
	end
end

function WorldService:start()
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator >= 1 / 20 then
			accumulator = 0
			flush()
		end
	end)
	-- Expire old loot so the map doesn't fill with debris.
	task.spawn(function()
		while true do
			task.wait(5)
			local now = os.clock()
			for id, p in self.props do
				if p.loot and p.expiresAt and now > p.expiresAt then
					self:removeProp(id, 0)
				end
			end
		end
	end)
	Players.PlayerAdded:Connect(function(player)
		-- Clients request the snapshot once their controllers are ready (see Action "ready").
		player:SetAttribute("WorldRequested", false)
	end)
end

return WorldService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="88">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="89">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <bool name="AutoJumpEnabled">false</bool>
      <float name="CameraMaxZoomDistance">120</float>
      <float name="CameraMinZoomDistance">4</float>
      <float name="CharacterJumpHeight">7.2</float>
      <bool name="CharacterUseJumpPower">false</bool>
      <float name="CharacterWalkSpeed">20</float>
      <bool name="LoadCharacterAppearance">true</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="90">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="91">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Single client bootstrap. Controllers are modules with optional init(controllers) and start().

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")

local Net = require(ReplicatedStorage.Shared.Net)

Net.init()

-- Our own HUD replaces the default backpack/health bars; chat and the player list stay available.
pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
end)

local ORDER = {
	"ClientState",
	"SettingsController",
	"InputController",
	"AudioController",
	"VFXController",
	"WorldController",
	"BallVisualController",
	"MovementController",
	"CameraController",
	"HudController",
	"LaunchController",
	"EventController",
	"MenuController",
	"VoteController",
	"NanaController",
	"HubController",
	"TuningPanel",
}

local controllers = {}
local folder = script:WaitForChild("Controllers")
for _, name in ORDER do
	local module = folder:FindFirstChild(name)
	if module then
		local ok, result = pcall(require, module)
		if ok then
			controllers[name] = result
		else
			warn("[Client] failed to load " .. name .. ": " .. tostring(result))
		end
	end
end

for _, name in ORDER do
	local c = controllers[name]
	if c and type(c.init) == "function" then
		local ok, err = pcall(c.init, c, controllers)
		if not ok then
			warn("[Client] init failed for " .. name .. ": " .. tostring(err))
		end
	end
end

for _, name in ORDER do
	local c = controllers[name]
	if c and type(c.start) == "function" then
		task.spawn(function()
			local ok, err = pcall(c.start, c)
			if not ok then
				warn("[Client] start failed for " .. name .. ": " .. tostring(err))
			end
		end)
	end
end

-- Tell the server we're ready for the world snapshot and to be dropped into the round.
task.spawn(function()
	local player = Players.LocalPlayer
	if not player.Character then
		player.CharacterAdded:Wait()
	end
	task.wait(0.1)
	Net.request("Ready", true)
end)
]]></string>
        </Properties>
        <Item class="Folder" referent="92">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="93">
            <Properties>
              <string name="Name">AudioController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Sound design: pops pitched by prop size with a rising combo ladder on rapid pickups (the
-- "coin streak" feeling), a rolling loop and growth hum tied to speed/size, stingers for big
-- moments, and kit music with a Final Roll intensity layer. All ids live in Config/Sounds.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Sounds = require(Shared.Config.Sounds)
local Rarity = require(Shared.Config.Rarity)
local Growth = require(Shared.Logic.Growth)
local Absorb = require(Shared.Logic.Absorb)
local Kits = require(Shared.Data.Kits)
local PropLibrary = require(Shared.Logic.PropLibrary)

local AudioController = {}

local controllers
local state, settings
local group: SoundGroup
local musicGroup: SoundGroup
local pools: { [string]: { Sound } } = {}
local loops: { [string]: Sound } = {}
local music: { [string]: Sound } = {}
local currentMusic: string? = nil
local combo = 0
local lastPopAt = 0
local popsThisFrame = 0

function AudioController:init(c)
	controllers = c
end

local function makeSound(name: string, parent: Instance): Sound?
	local def = Sounds[name]
	if not def or def.id == "" then
		return nil
	end
	local s = Instance.new("Sound")
	s.Name = name
	s.SoundId = def.id
	s.Volume = def.volume
	s.Looped = def.looped == true
	s.PlaybackSpeed = def.pitch or 1
	s.SoundGroup = if name:sub(1, 5) == "Music" then musicGroup else group
	s.Parent = parent
	return s
end

-- One-shot. opts: pitch (multiplier), volume (multiplier).
function AudioController:play(name: string, opts: { [string]: number }?)
	local def = Sounds[name]
	if not def or def.id == "" then
		return
	end
	local pool = pools[name]
	if not pool then
		pool = {}
		pools[name] = pool
	end
	local sound
	for _, s in pool do
		if not s.IsPlaying then
			sound = s
			break
		end
	end
	if not sound then
		if #pool >= 6 then
			sound = pool[1]
			sound:Stop()
		else
			sound = makeSound(name, SoundService)
			if not sound then
				return
			end
			table.insert(pool, sound)
		end
	end
	local jitter = def.pitchJitter or 0
	local pitch = (def.pitch or 1) * ((opts and opts.pitch) or 1) * (1 + (math.random() * 2 - 1) * jitter)
	sound.PlaybackSpeed = math.clamp(pitch, 0.2, 4)
	sound.Volume = def.volume * ((opts and opts.volume) or 1)
	sound.TimePosition = 0
	sound:Play()
end

-- Absorb pop: small things squeak high, big things thunk low; quick streaks climb in pitch.
-- Absorb pop: soft and organic. Small things tick lightly, big things land with a thump. Streaks
-- get a gentle lift (a few percent, not a rising beep) and rapid pickups are thinned and ducked so
-- hoovering a crumb field sounds like a satisfying patter instead of a buzz.
local recentPops = 0

function AudioController:pop(relativeSize: number, isLocal: boolean, distance: number?)
	local now = os.clock()
	popsThisFrame += 1
	if popsThisFrame > 2 then
		return
	end
	if isLocal then
		if now - lastPopAt < 0.045 and relativeSize < 0.3 then
			return -- too close to the last one to hear as separate pops anyway
		end
		if now - lastPopAt < 0.55 then
			combo = math.min(combo + 1, 18)
		else
			combo = 0
		end
		lastPopAt = now
	end
	recentPops += 1
	task.delay(1, function()
		recentPops -= 1
	end)
	local size = math.clamp(relativeSize, 0, 1.2)
	local base = 1.18 - size * 0.4
	local ladder = if isLocal then 1 + math.min(combo, 10) * 0.008 else 1
	local duck = 1 / (1 + math.max(0, recentPops - 3) * 0.12)
	local volume = (if isLocal then 1 else math.clamp(1 - (distance or 0) / 300, 0.05, 0.4)) * duck
	local pitch = math.clamp(base * ladder, 0.7, 1.3)
	if relativeSize > 0.55 then
		self:play("PopBig", { volume = volume })
		self:play("PopBigLayer", { volume = volume })
	elseif relativeSize < 0.18 then
		self:play("PopSoft", { pitch = pitch, volume = volume })
	else
		self:play("Pop", { pitch = pitch, volume = volume })
	end
end

local function setMusic(name: string?)
	if currentMusic == name then
		return
	end
	if currentMusic and music[currentMusic] then
		local old = music[currentMusic]
		task.spawn(function()
			for i = 10, 0, -1 do
				old.Volume = (Sounds[currentMusic or ""] and Sounds[currentMusic].volume or 0.3) * i / 10
				task.wait(0.08)
			end
			old:Stop()
		end)
	end
	currentMusic = name
	if name then
		local s = music[name]
		if not s then
			s = makeSound(name, SoundService)
			if s then
				music[name] = s
			end
		end
		if s then
			s.Volume = Sounds[name].volume
			s:Play()
		end
	end
end

local function updateMusic()
	local round = state.round
	if round.state == "Playing" and state.playerState ~= "Hub" then
		if round.phase == "FinalRoll" and Sounds.MusicFinalRoll.id ~= "" then
			setMusic("MusicFinalRoll")
		else
			local kit = round.kitId and Kits.get(round.kitId)
			setMusic(if kit then kit.music else "MusicHub")
		end
	elseif round.state == "Results" then
		setMusic(if Sounds.MusicResults.id ~= "" then "MusicResults" else "MusicHub")
	else
		setMusic("MusicHub")
	end
end

local function updateLoops(dt: number)
	popsThisFrame = 0
	local roll = loops.RollLoop
	local hum = loops.GrowthHum
	local movement = controllers.MovementController
	if state:isRolling() and movement then
		local frac = math.clamp(movement.speed / math.max(Growth.maxSpeed(state.diameter), 1), 0, 1.5)
		local sizeAlpha = Growth.sizeAlpha(state.diameter)
		if roll then
			local target = if movement.grounded then 0.12 + frac * 0.45 else 0
			roll.Volume += (target - roll.Volume) * math.min(1, dt * 8)
			roll.PlaybackSpeed = (0.75 + frac * 0.6) * (1.3 - sizeAlpha * 0.6)
		end
		if hum then
			hum.Volume += ((0.04 + sizeAlpha * 0.12) * (0.3 + frac) - hum.Volume) * math.min(1, dt * 3)
			hum.PlaybackSpeed = 1.4 - sizeAlpha * 0.9
		end
	else
		if roll then
			roll.Volume *= 0.9
		end
		if hum then
			hum.Volume *= 0.9
		end
	end
end

function AudioController:start()
	state = controllers.ClientState
	settings = controllers.SettingsController
	group = Instance.new("SoundGroup")
	group.Name = "SFX"
	group.Volume = settings.values.sfx
	group.Parent = SoundService
	-- Warm the whole effects bus: take the harsh top off and add a touch of room.
	local eq = Instance.new("EqualizerSoundEffect")
	eq.HighGain = -9
	eq.MidGain = -1.5
	eq.LowGain = 2
	eq.Priority = 1
	eq.Parent = group
	local room = Instance.new("ReverbSoundEffect")
	room.DecayTime = 0.6
	room.Density = 0.6
	room.Diffusion = 0.8
	room.DryLevel = 0
	room.WetLevel = -18
	room.Priority = 0
	room.Parent = group
	musicGroup = Instance.new("SoundGroup")
	musicGroup.Name = "Music"
	musicGroup.Volume = settings.values.music
	musicGroup.Parent = SoundService
	settings.Changed:Connect(function(key, value)
		if key == "sfx" then
			group.Volume = value
		elseif key == "music" then
			musicGroup.Volume = value
		end
	end)
	for _, name in { "RollLoop", "GrowthHum" } do
		local s = makeSound(name, SoundService)
		if s then
			s.Volume = 0
			s:Play()
			loops[name] = s
		end
	end

	local world = controllers.WorldController
	world.PropAbsorbed:Connect(function(p, absorberKey, isPrediction)
		local isLocal = absorberKey == state.player.UserId
		if isLocal and not isPrediction then
			return -- already played at prediction time
		end
		local threshold = Absorb.threshold(state.diameter, state:absorbContext())
		local rel = p.absorbSize / math.max(threshold, 0.1)
		local dist = 0
		if not isLocal then
			dist = (Workspace.CurrentCamera.CFrame.Position - Vector3.new(p.x, p.cy, p.z)).Magnitude
			if dist > 300 then
				return
			end
			rel = 0.4
		end
		self:pop(rel, isLocal, dist)
		if isLocal and p.critter then
			self:play("PopSoft", { pitch = 1.55, volume = 0.45 }) -- the critter's little squeak
		end
	end)
	local lastChime = 0
	Net.connect("Absorbed", function(list)
		for _, a in list do
			-- New Rolledex entries chime softly, at most every couple of seconds (early game finds
			-- something new constantly; a chime per find would be a beep-fest).
			if a.n and os.clock() - lastChime > 2.5 then
				lastChime = os.clock()
				self:play("NewDiscovery")
			end
			local def = PropLibrary.get(a.uid)
			if def and Rarity.get(def.rarity).order >= 5 then
				self:play("Legendary")
			end
		end
	end)
	local movement = controllers.MovementController
	movement.Hopped:Connect(function()
		self:play("Hop", { pitch = 1.2 - Growth.sizeAlpha(state.diameter) * 0.5 })
	end)
	movement.Dashed:Connect(function()
		self:play("Dash", { pitch = 1.1 - Growth.sizeAlpha(state.diameter) * 0.4 })
	end)
	movement.Landed:Connect(function(impact)
		self:play("Land", { volume = math.clamp(impact / 80, 0.2, 1), pitch = 1.1 - Growth.sizeAlpha(state.diameter) * 0.5 })
	end)
	movement.Bonked:Connect(function(speed)
		local frac = math.clamp(speed / math.max(Growth.maxSpeed(state.diameter), 1), 0.3, 1.3)
		self:play("Bonk", { volume = frac, pitch = 1.25 - Growth.sizeAlpha(state.diameter) * 0.5 })
	end)
	state.RoundChanged:Connect(function(round, previous)
		if round.phase == "FinalRoll" and previous.phase ~= "FinalRoll" then
			self:play("FinalRoll")
		end
		updateMusic()
	end)
	state.PlayerStateChanged:Connect(updateMusic)
	Net.connect("Announce", function(kind, data)
		if kind == "legendary" then
			self:play("Legendary", { volume = 0.6 })
		elseif kind == "rolled" and type(data) == "table" then
			local me = state.player.UserId
			if data.victimId == me then
				self:play("GotRolled")
			elseif data.hostId == me then
				self:play("PlayerRolled")
			else
				self:play("PlayerRolled", { volume = 0.35 })
			end
		end
	end)
	Net.connect("BallFx", function(kind, data)
		if type(data) ~= "table" then
			return
		end
		if kind == "bump" then
			local alpha = Growth.sizeAlpha(data.size or 10)
			local me = state.player.UserId
			local involved = data.a == me or data.b == me
			self:play("Clang", { pitch = 1.3 - alpha * 0.6, volume = if involved then 1 else 0.4 })
		elseif kind == "burst" then
			self:play("BurstOff", { volume = if data.userId == state.player.UserId then 1 else 0.5 })
		end
	end)
	controllers.WorldController.GoalUnlocked:Connect(function()
		self:play("NewDiscovery", { pitch = 1.1 })
	end)
	RunService.RenderStepped:Connect(updateLoops)
	updateMusic()
end

return AudioController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="94">
            <Properties>
              <string name="Name">BallVisualController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Visuals for every ball: a squashy shell, a lumpy "packed with stuff" core that rolls with the
-- ball, and the props you've rolled up sticking out of it (newest/biggest/rarest kept visible,
-- older small ones folded into the core). All client-built from compact server state.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)
local Spring = require(Shared.Util.Spring)
local MathUtil = require(Shared.Util.MathUtil)
local PropBuilder = require(Shared.PropBuilder)
local Rarity = require(Shared.Config.Rarity)
local Tuning = require(Shared.Config.Tuning)
local Absorb = require(Shared.Logic.Absorb)
local Format = require(Shared.Util.Format)
local Cosmetics = require(Shared.Data.Cosmetics)

local BallVisualController = {}
BallVisualController.balls = {} :: { [number]: any }
BallVisualController.Stuck = Signal.new() -- (userId, prop) fired when a prop lands on a ball

local controllers
local state
local folder: Folder
local flights = {} -- props flying into balls
local myUserId = Players.LocalPlayer.UserId
local LUMPS = MathUtil.fibonacciSphere(34)

local PALETTE = {
	Color3.fromRGB(255, 122, 69),
	Color3.fromRGB(77, 196, 255),
	Color3.fromRGB(255, 120, 196),
	Color3.fromRGB(120, 214, 110),
	Color3.fromRGB(176, 108, 255),
	Color3.fromRGB(255, 196, 46),
	Color3.fromRGB(64, 214, 200),
	Color3.fromRGB(255, 92, 120),
}

function BallVisualController:init(c)
	controllers = c
end

local function visualPart(name: string, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Shape = Enum.PartType.Block
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

local function colorFor(userId: number): Color3
	return PALETTE[(userId % #PALETTE) + 1]
end

local function materialNamed(name: string?): Enum.Material
	local ok, m = pcall(function()
		return (Enum.Material :: any)[name or "SmoothPlastic"]
	end)
	return if ok and m then m else Enum.Material.SmoothPlastic
end

local function lumpShade(base: Color3, i: number): Color3
	local h, s, v = base:ToHSV()
	return Color3.fromHSV((h + (i % 5 - 2) * 0.015) % 1, math.clamp(s * (0.8 + (i % 3) * 0.12), 0, 1), math.clamp(v * (0.82 + (i % 4) * 0.06), 0, 1))
end

-- Dress a ball in its shell cosmetic (Shell attribute; "Classic" = the owner's personal color).
local function applyShell(entry)
	local def = Cosmetics.shell(entry.part:GetAttribute("Shell"))
	local base = if def.color then Color3.fromHex(def.color) else colorFor(entry.userId)
	local accent = if def.color2 then Color3.fromHex(def.color2) else nil
	local material = materialNamed(def.material)
	entry.color = base
	entry.rainbow = def.rainbow == true
	entry.shell.Color = base
	entry.shell.Material = material
	entry.shell.Reflectance = def.reflectance or 0.04
	for i, lump in entry.lumps do
		if accent and i % 3 == 0 then
			lump.Color = accent
			lump.Material = if def.neon then Enum.Material.Neon else material
		else
			lump.Color = lumpShade(base, i)
			lump.Material = material
		end
	end
end

local TEAM_COLORS = { Red = Color3.fromRGB(255, 84, 104), Blue = Color3.fromRGB(70, 160, 255) }

-- Team outline and the Crown Chase crown, driven by ball attributes.
local function updateBadges(entry)
	local part = entry.part
	local team = part:GetAttribute("Team")
	local crown = part:GetAttribute("Crown") == true
	entry.team = team
	if entry.badgeHighlight then
		entry.badgeHighlight:Destroy()
		entry.badgeHighlight = nil
	end
	if entry.crownGui then
		entry.crownGui:Destroy()
		entry.crownGui = nil
	end
	if team or crown then
		local hl = Instance.new("Highlight")
		hl.Adornee = entry.folder
		hl.FillTransparency = 1
		hl.OutlineTransparency = 0
		hl.OutlineColor = if crown then Color3.fromRGB(255, 214, 64) else TEAM_COLORS[team] or Color3.new(1, 1, 1)
		hl.DepthMode = if crown then Enum.HighlightDepthMode.AlwaysOnTop else Enum.HighlightDepthMode.Occluded
		hl.Parent = entry.folder
		entry.badgeHighlight = hl
	end
	if crown then
		local gui = Instance.new("BillboardGui")
		gui.Name = "Crown"
		gui.Size = UDim2.fromOffset(90, 90)
		gui.AlwaysOnTop = true
		gui.LightInfluence = 0
		gui.MaxDistance = 5000
		gui.Adornee = part
		local icon = Instance.new("TextLabel")
		icon.BackgroundTransparency = 1
		icon.Size = UDim2.fromScale(1, 1)
		icon.Text = "👑"
		icon.TextScaled = true
		icon.Parent = gui
		gui.Parent = entry.folder
		entry.crownGui = gui
	end
end

local function layoutLumps(entry)
	local d = entry.diameter
	local r = d / 2
	for i, lump in entry.lumps do
		local p = LUMPS[i]
		local dir = Vector3.new(p[1], p[2], p[3])
		local size = d * (0.2 + (i % 3) * 0.04)
		lump.Size = Vector3.new(size, size * 0.42, size)
		local cf = CFrame.lookAt(Vector3.zero, dir) * CFrame.Angles(-math.pi / 2, 0, 0)
		local weld = lump:FindFirstChild("W") :: Weld
		if weld then
			weld.C0 = CFrame.new(dir * (r - size * 0.12)) * (cf - cf.Position)
		end
	end
end

local function createEntry(model: Model)
	local part = model:WaitForChild("Ball", 10) :: BasePart?
	if not part then
		return
	end
	local userId = part:GetAttribute("OwnerId") or 0
	if BallVisualController.balls[userId] then
		BallVisualController.balls[userId].folder:Destroy()
	end
	local color = colorFor(userId)
	local vf = Instance.new("Model")
	vf.Name = "BallVisual_" .. userId
	vf.Parent = folder

	local shell = visualPart("Shell", color, Enum.Material.SmoothPlastic)
	shell.Anchored = true
	shell.Reflectance = 0.04
	shell.Parent = vf

	local lumps = {}
	for i = 1, #LUMPS do
		local lump = visualPart("Lump", lumpShade(color, i))
		lump.Anchored = false
		local weld = Instance.new("Weld")
		weld.Name = "W"
		weld.Part0 = part
		weld.Part1 = lump
		weld.Parent = lump
		lump.Parent = vf
		table.insert(lumps, lump)
	end

	local entry = {
		userId = userId,
		model = model,
		part = part,
		folder = vf,
		shell = shell,
		shellMesh = shell:FindFirstChildOfClass("SpecialMesh"),
		lumps = lumps,
		lumpCursor = 1,
		stuck = {},
		diameter = part:GetAttribute("Diameter") or part.Size.X,
		squash = Spring.new(0, 220, 11),
		color = color,
		isLocal = userId == myUserId,
		shield = nil,
		tag = nil,
	}
	layoutLumps(entry)
	BallVisualController.balls[userId] = entry

	-- Name + size tag for other players' balls (readable PvP at a glance).
	if not entry.isLocal then
		local player = Players:GetPlayerByUserId(userId)
		local gui = Instance.new("BillboardGui")
		gui.Name = "Tag"
		gui.Size = UDim2.fromOffset(170, 62)
		gui.AlwaysOnTop = true
		gui.MaxDistance = 600
		gui.LightInfluence = 0
		gui.Adornee = part
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 0.66)
		label.FontFace = Font.new("rbxasset://fonts/families/FredokaOne.json")
		label.TextScaled = true
		label.TextColor3 = Color3.new(1, 1, 1)
		label.Text = if player then player.DisplayName else (part:GetAttribute("OwnerName") or "?")
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 2
		stroke.Color = Color3.fromRGB(38, 26, 74)
		stroke.Parent = label
		label.Parent = gui
		gui.Parent = vf
		-- Title line (earned titles like "Ball Bully") under the name.
		local titleLabel = Instance.new("TextLabel")
		titleLabel.BackgroundTransparency = 1
		titleLabel.Position = UDim2.fromScale(0, 0.64)
		titleLabel.Size = UDim2.fromScale(1, 0.36)
		titleLabel.FontFace = Font.new("rbxasset://fonts/families/FredokaOne.json")
		titleLabel.TextScaled = true
		titleLabel.Text = ""
		local titleStroke = stroke:Clone()
		titleStroke.Thickness = 1.5
		titleStroke.Parent = titleLabel
		titleLabel.Parent = gui
		local baseName = label.Text
		local tag = { gui = gui, label = label, name = baseName, title = titleLabel }
		local function refreshTag()
			local level = part:GetAttribute("Level")
			tag.name = if type(level) == "number" and level > 0 then "Lv" .. level .. " " .. baseName else baseName
			local title = part:GetAttribute("Title")
			titleLabel.Text = if type(title) == "string" then "« " .. title .. " »" else ""
			local color = part:GetAttribute("TitleColor")
			titleLabel.TextColor3 = if type(color) == "string" then Color3.fromHex(color) else Color3.fromRGB(255, 230, 150)
		end
		refreshTag()
		part:GetAttributeChangedSignal("Level"):Connect(refreshTag)
		part:GetAttributeChangedSignal("Title"):Connect(refreshTag)
		entry.tag = tag
	end

	part:GetAttributeChangedSignal("Diameter"):Connect(function()
		BallVisualController:onDiameter(entry, part:GetAttribute("Diameter"))
	end)
	applyShell(entry)
	updateBadges(entry)
	part:GetAttributeChangedSignal("Team"):Connect(function()
		updateBadges(entry)
	end)
	part:GetAttributeChangedSignal("Crown"):Connect(function()
		updateBadges(entry)
	end)
	part:GetAttributeChangedSignal("Shell"):Connect(function()
		applyShell(entry)
		if controllers.VFXController then
			controllers.VFXController:sparkle(part.Position, entry.color, entry.diameter, 16)
		end
	end)
	return entry
end

local function removeEntry(userId: number)
	local entry = BallVisualController.balls[userId]
	if entry then
		entry.folder:Destroy()
		BallVisualController.balls[userId] = nil
	end
end

function BallVisualController:hasBall(userId: number): boolean
	local e = self.balls[userId]
	return e ~= nil and e.part.Parent ~= nil
end

-- Fold a stuck prop into the core: shrink it away and tint a lump with its color.
local function fold(entry, s)
	if s.folded then
		return
	end
	s.folded = true
	local lump = entry.lumps[entry.lumpCursor]
	entry.lumpCursor = entry.lumpCursor % #entry.lumps + 1
	if lump then
		lump.Color = s.color
	end
	if s.model then
		local model = s.model
		s.model = nil
		task.spawn(function()
			for _ = 1, 6 do
				if not model.Parent then
					return
				end
				pcall(function()
					model:ScaleTo(math.max(0.05, model:GetScale() * 0.7))
				end)
				task.wait(0.03)
			end
			model:Destroy()
		end)
	end
end

-- Keep visible stuck props under budget: fold smallest/oldest commons first.
local function enforceBudget(entry)
	local cap = if entry.isLocal then Tuning.Absorb.VisibleStuckLocal else Tuning.Absorb.VisibleStuckRemote
	local q = controllers.SettingsController and controllers.SettingsController:qualityFactor() or 1
	cap = math.floor(cap * math.clamp(q, 0.5, 1.1))
	local visible = {}
	for _, s in entry.stuck do
		if not s.folded and s.model then
			table.insert(visible, s)
		end
	end
	if #visible <= cap then
		return
	end
	table.sort(visible, function(a, b)
		return a.keep < b.keep
	end)
	for i = 1, #visible - cap do
		fold(entry, visible[i])
	end
end

function BallVisualController:onDiameter(entry, d: number)
	local old = entry.diameter
	entry.diameter = d
	layoutLumps(entry)
	local r = d / 2
	for i = #entry.stuck, 1, -1 do
		local s = entry.stuck[i]
		-- Buried by growth: fold into the core.
		if not s.folded and r > s.absorbR + s.size * 0.55 then
			fold(entry, s)
		end
		if s.folded then
			table.remove(entry.stuck, i)
		end
	end
	if d > old then
		entry.squash:impulse(math.clamp((d - old) / old * 6, 0.02, 0.6))
	end
end

local function stickPlacement(entry, s): CFrame
	-- Prop stands out of the surface along `dir`, base embedded ~35% of its height.
	local dir = s.dir
	local up = Vector3.yAxis
	local basis = CFrame.lookAt(Vector3.zero, dir, if math.abs(dir:Dot(up)) > 0.95 then Vector3.xAxis else up) * CFrame.Angles(-math.pi / 2, 0, 0)
	basis = basis * CFrame.Angles(0, s.spin, 0)
	local embed = s.height * 0.38
	return CFrame.new(dir * (s.absorbR - embed)) * basis
end

local function attach(entry, s)
	local model = s.model
	if not model or not model.Parent then
		return
	end
	PropBuilder.makeDynamic(model)
	local hitbox = model.PrimaryPart
	if not hitbox then
		return
	end
	local place = stickPlacement(entry, s)
	local weld = Instance.new("Weld")
	weld.Name = "Stick"
	weld.Part0 = entry.part
	weld.Part1 = hitbox
	weld.C0 = place * hitbox.PivotOffset:Inverse()
	weld.Parent = hitbox
	model.Parent = entry.folder
end

-- A prop starts flying into a ball (absorbed). Takes ownership of p.model.
function BallVisualController:absorbProp(userId: number, p)
	local entry = self.balls[userId]
	local model = p.model
	p.model = nil
	if model then
		-- Grabbed props must never collide again (a still-solid prop flying in shoves the ball).
		for _, d in model:GetDescendants() do
			if d:IsA("BasePart") then
				d.CanCollide = false
				d.CanQuery = false
				d.CanTouch = false
			end
		end
	end
	if not entry then
		if model then
			model:Destroy()
		end
		return
	end
	local ballCF = entry.part.CFrame
	local r = entry.diameter / 2
	local fromPos = if model then model:GetPivot().Position else Vector3.new(p.x, p.cy, p.z)
	local toward = Vector3.new(p.x, p.cy, p.z) - ballCF.Position
	local worldDir = if toward.Magnitude > 1e-3 then toward.Unit else Vector3.new(0, 1, 0)
	local rarity = Rarity.get(p.def.rarity)
	local s = {
		propId = p.id,
		uid = p.uid,
		mutation = p.mutation,
		model = model,
		dir = ballCF:VectorToObjectSpace(worldDir),
		spin = math.random() * math.pi * 2,
		absorbR = r,
		size = p.absorbSize,
		height = p.def.metrics.sy * p.eff,
		color = Color3.fromHex(p.def.metrics.mainColor),
		-- Higher keep score = stays visible longer (big and rare things poke out longest).
		keep = p.absorbSize / math.max(entry.diameter, 0.1) * 4 + rarity.order * 0.8 + (if p.mutation > 0 then 2 else 0) + os.clock() * 0.001,
		folded = false,
	}
	table.insert(entry.stuck, s)
	entry.squash:impulse(math.clamp(p.absorbSize / math.max(entry.diameter, 0.1) * 0.5, 0.03, 0.35))
	if model then
		-- Remote balls far from the camera skip the flight and fold straight in (cheap).
		local cam = Workspace.CurrentCamera
		if not entry.isLocal and (cam.CFrame.Position - ballCF.Position).Magnitude > 500 then
			fold(entry, s)
		else
			PropBuilder.makeStatic(model)
			-- Bigger props take a little longer and glide in (smooth), small ones snap in (punchy).
			local rel = p.absorbSize / math.max(entry.diameter, 1)
			table.insert(flights, {
				entry = entry,
				s = s,
				from = fromPos,
				fromCF = model:GetPivot(),
				t0 = os.clock(),
				dur = math.clamp(0.1 + rel * 0.45, 0.1, 0.36),
				smooth = rel > 0.3,
			})
		end
	else
		fold(entry, s)
	end
	enforceBudget(entry)
end

-- Move a predicted prop from one ball to another (another player beat us to it).
function BallVisualController:reassign(fromUserId: number, toUserId: number, p)
	local from = self.balls[fromUserId]
	if not from then
		return
	end
	for i, s in from.stuck do
		if s.propId == p.id then
			table.remove(from.stuck, i)
			if s.model then
				p.model = s.model
				local hb = s.model.PrimaryPart
				local weld = hb and hb:FindFirstChild("Stick")
				if weld then
					weld:Destroy()
				end
				PropBuilder.makeStatic(s.model)
				s.model.Parent = Workspace:FindFirstChild("ClientProps")
			end
			self:absorbProp(toUserId, p)
			return
		end
	end
end

-- Undo a local prediction (server never confirmed it).
function BallVisualController:release(userId: number, p)
	local entry = self.balls[userId]
	if not entry then
		return
	end
	for i, s in entry.stuck do
		if s.propId == p.id then
			table.remove(entry.stuck, i)
			if s.model then
				s.model:Destroy()
			end
			return
		end
	end
end

-- The nearest ball big enough to roll us up (camera leans toward it).
function BallVisualController:nearestThreat(): Vector3?
	local me = self.balls[myUserId]
	if not me or not me.part.Parent then
		return nil
	end
	local best, bestDist = nil, math.huge
	for userId, e in self.balls do
		if userId ~= myUserId and e.part.Parent and Absorb.canAbsorbBall(e.diameter, me.diameter) then
			local dist = (e.part.Position - me.part.Position).Magnitude
			if dist < me.diameter * 8 + e.diameter * 2 and dist < bestDist then
				best, bestDist = e.part.Position, dist
			end
		end
	end
	return best
end

local function onKnock(data)
	local entry = BallVisualController.balls[data.ball]
	if not entry then
		return
	end
	local removed = 0
	for i = #entry.stuck, 1, -1 do
		if removed >= data.count then
			break
		end
		local s = entry.stuck[i]
		if not s.folded then
			if s.model then
				if controllers.VFXController then
					controllers.VFXController:poof(s.model:GetPivot().Position, s.size)
				end
				s.model:Destroy()
				s.model = nil
			end
			table.remove(entry.stuck, i)
			removed += 1
		end
	end
	entry.squash:impulse(0.4)
end

local function updateFlights()
	local now = os.clock()
	for i = #flights, 1, -1 do
		local f = flights[i]
		local s = f.s
		local entry = f.entry
		if not s.model or not entry.part.Parent then
			table.remove(flights, i)
			continue
		end
		local t = math.clamp((now - f.t0) / f.dur, 0, 1)
		local target = entry.part.CFrame * stickPlacement(entry, s)
		if f.smooth then
			-- Ease-out cubic for position AND rotation: big things glide onto the ball.
			local e = 1 - (1 - t) ^ 3
			s.model:PivotTo(f.fromCF:Lerp(target, e))
		else
			local eased = MathUtil.easeOutBack(t)
			local pos = f.from:Lerp(target.Position, math.clamp(eased, 0, 1.08))
			s.model:PivotTo((target - target.Position) + pos)
		end
		if t >= 1 then
			table.remove(flights, i)
			attach(entry, s)
			BallVisualController.Stuck:Fire(entry.userId, s)
		end
	end
end

local function updateShells(dt: number)
	local parts, cfs = {}, {}
	local serverNow = Workspace:GetServerTimeNow()
	for userId, e in BallVisualController.balls do
		if not e.part.Parent then
			removeEntry(userId)
			continue
		end
		local sq = e.squash:step(dt)
		-- Smooth physical growth toward the server's diameter (no hitches on big absorbs).
		local target = e.diameter
		local current = e.part.Size.X
		if math.abs(current - target) > 1e-3 then
			local new = current + (target - current) * math.min(1, dt * 14)
			if math.abs(target - new) < 0.005 then
				new = target
			end
			e.part.Size = Vector3.one * new
			if e.isLocal and new > current and not e.part.Anchored then
				e.part.CFrame += Vector3.new(0, (new - current) / 2, 0)
			end
		end
		if e.rainbow then
			local hue = (os.clock() * 0.12 + (userId % 7) * 0.13) % 1
			e.color = Color3.fromHSV(hue, 0.62, 1)
			e.shell.Color = e.color
			e.rainbowTick = (e.rainbowTick or 0) + dt
			if e.rainbowTick > 0.1 then
				e.rainbowTick = 0
				for i, lump in e.lumps do
					lump.Color = lumpShade(Color3.fromHSV((hue + i * 0.03) % 1, 0.62, 1), i)
				end
			end
		end
		local d = e.part.Size.X
		local shellD = d * 0.97
		e.shell.Size = Vector3.one * shellD
		if e.shellMesh then
			e.shellMesh.Scale = Vector3.new(1 + sq * 0.5, 1 - sq, 1 + sq * 0.5)
		end
		table.insert(parts, e.shell)
		table.insert(cfs, CFrame.new(e.part.Position - Vector3.new(0, sq * d * 0.5, 0)))
		-- Spawn shield bubble.
		local shieldUntil = e.part:GetAttribute("ShieldUntil")
		local shielded = shieldUntil and serverNow < shieldUntil
		if shielded and not e.shield then
			local bubble = visualPart("Shield", Color3.fromRGB(150, 220, 255), Enum.Material.ForceField)
			bubble.Anchored = true
			bubble.Transparency = 0.2
			bubble.Parent = e.folder
			e.shield = bubble
		elseif not shielded and e.shield then
			e.shield:Destroy()
			e.shield = nil
		end
		if e.shield then
			e.shield.Size = Vector3.one * d * 1.35
			table.insert(parts, e.shield)
			table.insert(cfs, CFrame.new(e.part.Position))
		end
		if e.tag then
			e.tag.gui.StudsOffsetWorldSpace = Vector3.new(0, d * 0.7 + 3, 0)
			local teamIcon = if e.team == "Red" then "🔴 " elseif e.team == "Blue" then "🔵 " else ""
			e.tag.label.Text = teamIcon .. e.tag.name .. "  " .. Format.size(d, state.round.cmPerStud or 1)
			local me = BallVisualController.balls[myUserId]
			if me and e.team and e.team == me.team then
				e.tag.label.TextColor3 = TEAM_COLORS[e.team] -- teammate: can't roll each other up
			elseif me then
				-- Red tag = can roll you up; green = you can roll them up.
				local color = Color3.new(1, 1, 1)
				if Absorb.canAbsorbBall(d, me.diameter) then
					color = Color3.fromRGB(255, 120, 120)
				elseif Absorb.canAbsorbBall(me.diameter, d) then
					color = Color3.fromRGB(140, 255, 150)
				end
				e.tag.label.TextColor3 = color
			end
		end
	end
	for _, e in BallVisualController.balls do
		if e.crownGui then
			e.crownGui.StudsOffsetWorldSpace = Vector3.new(0, e.part.Size.X * 0.7 + 8, 0)
			e.crownGui.Size = UDim2.fromOffset(70 + math.min(e.part.Size.X, 60), 70 + math.min(e.part.Size.X, 60))
		end
	end
	if #parts > 0 then
		Workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

-- Speech bubble over a ball's rider (bots chatting like real players).
function BallVisualController:bubble(userId: number, text: string)
	local entry = self.balls[userId]
	if not entry or not entry.part.Parent then
		return
	end
	local ownerName = entry.part:GetAttribute("OwnerName")
	local bots = Workspace:FindFirstChild("Bots")
	local character = bots and ownerName and bots:FindFirstChild(ownerName)
	local head = character and character:FindFirstChild("Head")
	local adornee = head or entry.part
	if entry.bubbleGui then
		entry.bubbleGui:Destroy()
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "Bubble"
	gui.Size = UDim2.fromOffset(220, 56)
	gui.StudsOffsetWorldSpace = if head then Vector3.new(0, head.Size.Y * 1.6 + 1, 0) else Vector3.new(0, entry.diameter * 0.75 + 6, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 260
	gui.LightInfluence = 0
	gui.Adornee = adornee
	local frame = Instance.new("TextLabel")
	frame.AutomaticSize = Enum.AutomaticSize.X
	frame.AnchorPoint = Vector2.new(0.5, 1)
	frame.Position = UDim2.fromScale(0.5, 1)
	frame.Size = UDim2.fromOffset(40, 34)
	frame.BackgroundColor3 = Color3.new(1, 1, 1)
	frame.TextColor3 = Color3.fromRGB(38, 26, 74)
	frame.FontFace = Font.new("rbxasset://fonts/families/FredokaOne.json")
	frame.TextSize = 20
	frame.Text = text
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 14)
	corner.Parent = frame
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 10)
	pad.PaddingRight = UDim.new(0, 10)
	pad.Parent = frame
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = Color3.fromRGB(38, 26, 74)
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = frame
	frame.Parent = gui
	gui.Parent = folder
	entry.bubbleGui = gui
	task.delay(3.5, function()
		if gui.Parent then
			gui:Destroy()
		end
	end)
end

function BallVisualController:start()
	state = controllers.ClientState
	folder = Workspace:FindFirstChild("BallVisuals") or Instance.new("Folder")
	folder.Name = "BallVisuals"
	folder.Parent = Workspace
	local balls = Workspace:WaitForChild("Balls")
	local function onAdded(model)
		if model:IsA("Model") then
			task.spawn(createEntry, model)
		end
	end
	balls.ChildAdded:Connect(onAdded)
	for _, m in balls:GetChildren() do
		onAdded(m)
	end
	balls.ChildRemoved:Connect(function(model)
		for userId, e in self.balls do
			if e.model == model then
				removeEntry(userId)
			end
		end
	end)
	Net.connect("BotChat", function(userId, text)
		if type(userId) == "number" and type(text) == "string" then
			self:bubble(userId, text)
		end
	end)
	Net.connect("BallFx", function(kind, data)
		if kind == "knock" then
			onKnock(data)
		end
	end)
	RunService.RenderStepped:Connect(function(dt)
		updateFlights()
		updateShells(dt)
	end)
end

return BallVisualController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="95">
            <Properties>
              <string name="Name">CameraController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Chase camera that grows with the ball. Auto-follows the direction of travel (no right-click
-- needed), pulls back and rises smoothly as the ball grows, avoids clipping into geometry, leans
-- toward nearby threats, and adds trauma-based shake for big moments (respects reduced motion).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Tuning = require(Shared.Config.Tuning)
local Growth = require(Shared.Logic.Growth)
local Spring = require(Shared.Util.Spring)
local MathUtil = require(Shared.Util.MathUtil)

local CameraController = {}

CameraController.yaw = 0
CameraController.pitch = math.rad(-18)
CameraController.zoom = 1
CameraController.mode = "Default" -- Default | Chase | Launch | Podium | Scripted
CameraController.trauma = 0

local controllers
local state, input, movement, settings
local cam: Camera = Workspace.CurrentCamera
local focus = Vector3.zero
local distSpring = Spring.new(12, 60, 14)
local heightSpring = Spring.new(5, 60, 14)
local fovSpring = Spring.new(70, 120, 16)
local manualUntil = 0
local lastCamPos = nil
local scripted: ((dt: number) -> CFrame?)? = nil
local occlusionParams = RaycastParams.new()
occlusionParams.FilterType = Enum.RaycastFilterType.Exclude
local fovKick = 0
-- Spawn swoop: blend from a high establishing shot down into the chase camera.
local blendFrom: CFrame? = nil
local blendStart = 0
local BLEND_TIME = 1.25
local revealAngle = 0

function CameraController:init(c)
	controllers = c
end

-- Add screen shake (0..1). Reduced motion turns it way down.
function CameraController:shake(amount: number)
	local mult = if settings.values.reducedMotion then 0.15 else settings.values.shake
	self.trauma = math.min(1, self.trauma + amount * mult)
end

function CameraController:kickFov(amount: number)
	if not settings.values.reducedMotion then
		fovKick = math.max(fovKick, amount)
	end
end

-- Hand the camera to a scripted sequence (launch, podium). Return nil from fn to release.
function CameraController:playScripted(fn: (dt: number) -> CFrame?)
	scripted = fn
	self.mode = "Scripted"
end

local function refreshFilter()
	local list = {}
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(list, p.Character)
		end
	end
	local balls = Workspace:FindFirstChild("Balls")
	if balls then
		table.insert(list, balls)
	end
	local visuals = Workspace:FindFirstChild("BallVisuals")
	if visuals then
		table.insert(list, visuals)
	end
	local props = Workspace:FindFirstChild("ClientProps")
	if props then
		-- Props never block the view; walls and counters do.
		table.insert(list, props)
	end
	occlusionParams.FilterDescendantsInstances = list
end

local function desiredDistance(d: number): number
	local c = Tuning.Camera
	-- Slightly sub-linear so huge balls still fill a satisfying chunk of the screen.
	return (c.BaseDistance + d * c.DistancePerDiameter * (1 - 0.12 * Growth.sizeAlpha(d))) * CameraController.zoom
end

local function desiredHeight(d: number): number
	local c = Tuning.Camera
	return (c.BaseHeight + d * c.HeightPerDiameter) * CameraController.zoom
end

local function chase(self, dt: number)
	local ball = state:focusBall()
	if not ball then
		return
	end
	local riding = ball ~= state.ball
	local c = Tuning.Camera
	local d = if riding then (ball:GetAttribute("Diameter") or ball.Size.X) else state.diameter
	local now = os.clock()
	local sens = settings.values.cameraSensitivity
	-- Riders watch the host ball's motion; rollers use their own (smoothed) movement.
	local velocity = if riding then ball.AssemblyLinearVelocity else movement.velocity
	local flatVel = Vector3.new(velocity.X, 0, velocity.Z)
	local speed = if riding then flatVel.Magnitude else movement.speed
	local heading = if riding then (if flatVel.Magnitude > 1 then flatVel.Unit else Vector3.new(0, 0, -1)) else movement.heading

	-- Manual orbit input.
	local orbit = input:takeOrbit()
	if orbit.Magnitude > 0 then
		self.yaw -= orbit.X * c.DragSensitivity * sens
		self.pitch = math.clamp(self.pitch - orbit.Y * c.DragSensitivity * sens * 0.6, math.rad(-55), math.rad(-5))
		manualUntil = now + c.AutoRecenterDelay
	end
	if input.keyOrbit ~= 0 then
		self.yaw -= input.keyOrbit * c.KeyOrbitSpeed * sens * dt
		manualUntil = now + c.AutoRecenterDelay
	end
	if input.keyPitch ~= 0 then
		self.pitch = math.clamp(self.pitch + input.keyPitch * 1.4 * dt, math.rad(-55), math.rad(-5))
	end
	if input.orbitHeld then
		manualUntil = now + c.AutoRecenterDelay
	end

	-- Auto-follow: swing behind the direction of travel, faster the faster we go.
	local maxSpeed = Growth.maxSpeed(d)
	local speedFrac = math.clamp(speed / math.max(maxSpeed, 1), 0, 1.6)
	if now > manualUntil and speedFrac > 0.15 then
		local h = heading
		local targetYaw = math.atan2(-h.X, -h.Z)
		local delta = MathUtil.angleDelta(self.yaw, targetYaw)
		-- Don't whip around when reversing briefly: follow lazily for large angle changes.
		local sharp = c.YawSharpness * math.clamp(speedFrac, 0.3, 1.2) * (if math.abs(delta) > 2.4 then 0.35 else 1)
		self.yaw += delta * MathUtil.damp(sharp, dt)
		-- Ease pitch back to the default.
		self.pitch += (math.rad(-18) - self.pitch) * MathUtil.damp(0.8, dt)
	end

	distSpring.target = desiredDistance(d)
	heightSpring.target = desiredHeight(d)
	local dist = distSpring:step(dt)
	local height = heightSpring:step(dt)

	-- Smooth focus point slightly above the ball centre; lead a little in the direction of travel.
	local lead = flatVel * 0.08
	local target = ball.Position + Vector3.new(0, d * 0.32, 0) + lead
	focus = focus:Lerp(target, MathUtil.damp(c.FollowSharpness * 2.2, dt))
	if (focus - target).Magnitude > d * 6 + 60 then
		focus = target
	end

	local rot = CFrame.Angles(0, self.yaw, 0) * CFrame.Angles(self.pitch, 0, 0)
	local offset = rot:VectorToWorldSpace(Vector3.new(0, 0, dist)) + Vector3.new(0, height * 0.55, 0)
	local desiredPos = focus + offset

	-- Occlusion: pull the camera in front of walls/counters between it and the ball.
	local toCam = desiredPos - focus
	local hit = Workspace:Raycast(focus, toCam, occlusionParams)
	if hit then
		desiredPos = hit.Position - toCam.Unit * 1.5
	end
	-- Never dip below the floor.
	if desiredPos.Y < focus.Y - d * 0.2 then
		desiredPos = Vector3.new(desiredPos.X, focus.Y - d * 0.2, desiredPos.Z)
	end

	local camPos = desiredPos
	if lastCamPos and (lastCamPos - camPos).Magnitude < d * 10 + 80 then
		camPos = lastCamPos:Lerp(camPos, MathUtil.damp(18, dt))
	end
	lastCamPos = camPos

	-- Lean slightly toward the nearest threat (a ball big enough to roll us up).
	local lookAt = focus
	local threat = controllers.BallVisualController and controllers.BallVisualController:nearestThreat()
	if threat then
		lookAt = lookAt:Lerp(threat, 0.12)
	end

	local cf = CFrame.lookAt(camPos, lookAt)

	-- Shake.
	if self.trauma > 0 then
		local t = os.clock() * 28
		local s = self.trauma * self.trauma * c.ShakeMax
		local angle = CFrame.Angles(math.noise(t, 1) * s * 0.03, math.noise(t, 2) * s * 0.03, math.noise(t, 3) * s * 0.02)
		cf = cf * angle + Vector3.new(math.noise(t, 4), math.noise(t, 5), math.noise(t, 6)) * s * (0.4 + d * 0.01)
		self.trauma = math.max(0, self.trauma - dt * 1.6)
	end

	-- FOV opens up with speed; dashes kick it.
	fovSpring.target = c.FovBase + c.FovSpeedBonus * math.clamp(speedFrac, 0, 1.4) ^ 1.5 + fovKick
	fovKick = math.max(0, fovKick - dt * 30)
	cam.FieldOfView = fovSpring:step(dt)
	if blendFrom then
		local t = math.clamp((os.clock() - blendStart) / BLEND_TIME, 0, 1)
		-- Ease in-out cubic: hang on the skyline for a beat, then dive to the ball.
		local e = if t < 0.5 then 4 * t * t * t else 1 - (-2 * t + 2) ^ 3 / 2
		cf = blendFrom:Lerp(cf, e)
		if t >= 1 then
			blendFrom = nil
		end
	end
	cam.CFrame = cf
	cam.Focus = CFrame.new(focus)
end

-- A high shot that frames the ball against the map's giant stuff (landmark, furniture).
local function establishingShot(ballPos: Vector3): CFrame
	local world = controllers.WorldController
	local landmark = world and world.props[world.landmarkId]
	local target = if landmark then Vector3.new(landmark.x, landmark.cy, landmark.z) else ballPos + Vector3.new(0, 0, -200)
	local half = (world and world.arenaHalf) or 600
	local away = Vector3.new(ballPos.X - target.X, 0, ballPos.Z - target.Z)
	away = if away.Magnitude > 1 then away.Unit else Vector3.new(0, 0, 1)
	local pos = ballPos + away * half * 0.35 + Vector3.new(0, half * 0.38, 0)
	return CFrame.lookAt(pos, ballPos:Lerp(target, 0.45))
end

-- Slow cinematic orbit over the arena while the world around spawn finishes building.
local function reveal(dt: number)
	local world = controllers.WorldController
	local center = world and world.spawnCenter
	if not center then
		return
	end
	local half = world.arenaHalf or 600
	revealAngle += dt * 0.12
	local c = Vector3.new(center[1], center[2], center[3])
	local pos = c + Vector3.new(math.cos(revealAngle) * half * 0.75, half * 0.42, math.sin(revealAngle) * half * 0.75)
	cam.CameraType = Enum.CameraType.Scriptable
	cam.FieldOfView = 60
	cam.CFrame = CFrame.lookAt(pos, c)
end

function CameraController:setMode(mode: string)
	local previous = self.mode
	self.mode = mode
	if mode == "Chase" then
		cam.CameraType = Enum.CameraType.Scriptable
		lastCamPos = nil
		local ball = state:focusBall()
		if ball then
			focus = ball.Position
			local riding = ball ~= state.ball
			local d = if riding then (ball:GetAttribute("Diameter") or ball.Size.X) else state.diameter
			distSpring:snap(desiredDistance(d))
			heightSpring:snap(desiredHeight(d))
			if riding then
				-- Rolled up: a quick blend from where we were, no establishing swoop.
				blendFrom = cam.CFrame
			else
				-- Every spawn starts with the swoop (from the reveal orbit if we were showing it).
				blendFrom = if previous == "Reveal" then cam.CFrame else establishingShot(ball.Position)
			end
			blendStart = os.clock()
		end
		refreshFilter()
	elseif mode == "Default" then
		scripted = nil
		cam.CameraType = Enum.CameraType.Custom
		cam.FieldOfView = 70
		local character = Players.LocalPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			cam.CameraSubject = humanoid
		end
	end
end

function CameraController:start()
	state = controllers.ClientState
	input = controllers.InputController
	movement = controllers.MovementController
	settings = controllers.SettingsController
	input.ZoomChanged:Connect(function(delta)
		local c = Tuning.Camera
		self.zoom = math.clamp(self.zoom + delta * 0.08, c.ZoomMin, c.ZoomMax)
	end)
	controllers.WorldController.WorldLoaded:Connect(function()
		if not state:isRolling() and state.round.state == "Playing" then
			self.mode = "Reveal"
		end
	end)
	state.BallChanged:Connect(function(part)
		if part then
			-- Face the landmark (the big goal) so the first view is "everything I'll eat".
			local world = controllers.WorldController
			local landmark = world and world.props[world.landmarkId]
			if landmark then
				local to = Vector3.new(landmark.x - part.Position.X, 0, landmark.z - part.Position.Z)
				self.yaw = math.atan2(-to.X, -to.Z)
			else
				self.yaw = math.atan2(part.Position.X, part.Position.Z)
			end
			self:setMode("Chase")
		elseif self.mode == "Chase" and state.playerState ~= "Rider" then
			self:setMode("Default")
		end
	end)
	-- Rolled up: keep chasing, now following the ball we're stuck to.
	state.PlayerStateChanged:Connect(function(newState)
		if newState == "Rider" then
			self:shake(0.6)
			self:setMode("Chase")
		end
	end)
	state.DiameterChanged:Connect(function(new, old)
		-- Big jumps (rolling up a player) get a dramatic pull-back.
		if new > old * 1.15 then
			distSpring:impulse((new - old) * 4)
			self:shake(0.35)
		end
	end)
	movement.Dashed:Connect(function()
		self:kickFov(9)
		self:shake(0.12)
	end)
	movement.Bonked:Connect(function(speed)
		self:shake(math.clamp(speed / math.max(Growth.maxSpeed(state.diameter), 1) * 0.45, 0.1, 0.6))
	end)
	movement.Landed:Connect(function(impact)
		if impact > 40 then
			self:shake(math.clamp(impact / 200, 0.05, 0.3))
		end
	end)
	task.spawn(function()
		while true do
			task.wait(3)
			if self.mode == "Chase" then
				refreshFilter()
			end
		end
	end)
	RunService:BindToRenderStep("RTW_Camera", Enum.RenderPriority.Camera.Value + 1, function(dt)
		-- Waiting to drop into a running round: show the map. Otherwise hand back the default camera.
		local world = controllers.WorldController
		local waiting = not state:isRolling() and state.round.state == "Playing" and world and world.ready
		if waiting and self.mode == "Default" then
			self.mode = "Reveal"
		elseif not waiting and self.mode == "Reveal" then
			self:setMode("Default")
		end
		if self.mode == "Chase" then
			chase(self, dt)
		elseif self.mode == "Reveal" then
			reveal(dt)
		elseif self.mode == "Scripted" and scripted then
			local cf = scripted(dt)
			if cf then
				cam.CameraType = Enum.CameraType.Scriptable
				cam.CFrame = cf
			else
				scripted = nil
				self:setMode(if state:isRolling() then "Chase" else "Default")
			end
		end
	end)
end

return CameraController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="96">
            <Properties>
              <string name="Name">ClientState</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Client-side store: round snapshot, local player state, local ball, settings-independent facts.
-- Other controllers read from here and listen to its signals.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)
local Tiers = require(Shared.Config.Tiers)

local ClientState = {}

ClientState.player = Players.LocalPlayer
ClientState.round = ({
	state = "Starting",
	phase = "Scramble",
	endsAt = 0,
	kitId = nil,
	cmPerStud = Tiers.List[1].cmPerStud,
	top = {},
	event = nil,
	landmarkId = 0,
}) :: any
ClientState.playerState = "Loading" -- Loading | Hub | Rolling | Rider | Merged
ClientState.ball = nil :: BasePart? -- local player's physics ball
ClientState.ballModel = nil :: Model?
ClientState.diameter = 3
ClientState.core = "Classic"
ClientState.coreLevel = 1
ClientState.profile = nil
ClientState.lastResults = nil
ClientState.rider = nil -- { hostId, hostBall: Model, burstAt, autoAt, by } while rolled up

ClientState.RoundChanged = Signal.new() -- (round, previous)
ClientState.PlayerStateChanged = Signal.new() -- (state, data)
ClientState.DiameterChanged = Signal.new() -- (new, old)
ClientState.BallChanged = Signal.new() -- (ballPart?)
ClientState.ResultsReceived = Signal.new()
ClientState.ProfileChanged = Signal.new()

function ClientState:serverTime(): number
	return Workspace:GetServerTimeNow()
end

function ClientState:timeLeft(): number
	return math.max(0, self.round.endsAt - self:serverTime())
end

function ClientState:isFinalRoll(): boolean
	return self.round.state == "Playing" and self.round.phase == "FinalRoll"
end

-- The ball the camera should follow: ours, or the one we're stuck to as a rider.
function ClientState:focusBall(): BasePart?
	if self.ball and self.ball.Parent then
		return self.ball
	end
	local host = self.rider and self.rider.hostBall
	local part = host and host:FindFirstChild("Ball")
	if part and part.Parent then
		return part :: BasePart
	end
	return nil
end

function ClientState:isRolling(): boolean
	return self.playerState == "Rolling" and self.ball ~= nil and self.ball.Parent ~= nil
end

-- Combined round modifiers from the server (event + mutator): ratioBonus, speedMult, hopMult.
function ClientState:mods()
	local mods = self.round and self.round.mods
	if mods then
		return mods
	end
	local event = self.round and self.round.event
	return { ratioBonus = event and event.ratioBonus or 0, speedMult = event and event.speedMult or 1, hopMult = 1 }
end

function ClientState:absorbContext()
	return {
		ratioBonus = self:mods().ratioBonus or 0,
		finalRoll = self:isFinalRoll(),
	}
end

local diameterConn

local function bindBall(model: Model?)
	if diameterConn then
		diameterConn:Disconnect()
		diameterConn = nil
	end
	local part = model and (model.PrimaryPart or model:WaitForChild("Ball", 5))
	ClientState.ballModel = model
	ClientState.ball = part
	if part then
		local function update()
			local d = part:GetAttribute("Diameter") or part.Size.X
			local old = ClientState.diameter
			if math.abs(d - old) > 1e-4 then
				ClientState.diameter = d
				ClientState.DiameterChanged:Fire(d, old)
			end
		end
		diameterConn = part:GetAttributeChangedSignal("Diameter"):Connect(update)
		update()
	end
	ClientState.BallChanged:Fire(part)
end

function ClientState:start()
	Net.connect("RoundState", function(snapshot)
		local previous = self.round
		self.round = snapshot
		self.RoundChanged:Fire(snapshot, previous)
	end)
	Net.connect("PlayerState", function(state, data)
		self.playerState = state
		if state == "Rolling" and data then
			self.core = data.core or "Classic"
			self.coreLevel = data.coreLevel or 1
			local model = data.ball
			if not model then
				-- The event can outrun replication of the ball itself; wait for it by name.
				local balls = Workspace:WaitForChild("Balls", 10)
				model = balls and balls:WaitForChild("Ball_" .. self.player.UserId, 10)
			end
			self.rider = nil
			bindBall(model)
		elseif state == "Rider" then
			self.rider = data
			bindBall(nil)
		elseif state ~= "Rolling" then
			self.rider = nil
			bindBall(nil)
		end
		self.PlayerStateChanged:Fire(state, data)
	end)
	self.player:GetAttributeChangedSignal("RollState"):Connect(function()
		local state = self.player:GetAttribute("RollState")
		if state and state ~= self.playerState and state ~= "Rolling" then
			self.playerState = state
			bindBall(nil)
			self.PlayerStateChanged:Fire(state, nil)
		end
	end)
	Net.connect("Results", function(results)
		self.lastResults = results
		self.ResultsReceived:Fire(results)
	end)
	Net.connect("ProfileSync", function(profile)
		self.profile = profile
		self.ProfileChanged:Fire(profile)
	end)
end

return ClientState
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="97">
            <Properties>
              <string name="Name">EventController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- World event presentation: a big slam-in banner with the event's icon and one-line hook, a live
-- countdown chip under it, weather that follows the camera (rain, glitter, dust, floaty bubbles,
-- sparks, shooting stars), a lighting mood shift that eases in and back out, a sky beam over
-- Supply Drops and a pulsing aura on the Giant. Gameplay effects are server-side; this is the show.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Theme = require(Shared.Config.Theme)
local Signal = require(Shared.Util.Signal)
local Ui = require(script.Parent.Parent.UI.Ui)
local Modes = require(Shared.Data.Modes)
local Mutators = require(Shared.Data.Mutators)
local Kits = require(Shared.Data.Kits)

local EventController = {}
EventController.Changed = Signal.new() -- (eventInfo?)

local controllers
local state, settings
local gui: ScreenGui
local card: Frame
local cardIcon: TextLabel
local cardTitle: TextLabel
local cardSub: TextLabel
local chip: Frame
local chipLabel: TextLabel
local chipFill: Frame
local currentId: string? = nil
local current = nil
local weatherPart: Part? = nil
local weatherEmitters: { ParticleEmitter } = {}
local weatherName: string? = nil
local lightingSaved = nil
local lightingTweens: { Tween } = {}
local colorFx: ColorCorrectionEffect? = nil
local beam: Model? = nil
local giantFx: { Instance } = {}
local giantBall: BasePart? = nil
local lastRoundId = nil
local beamPropId: number? = nil
local nightFx: ColorCorrectionEffect? = nil
local nightSaved = nil

local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local FIRE = "rbxasset://textures/particles/fire_main.dds"
local RAIN = "rbxasset://textures/particles/forcefield_glow_main.dds"

function EventController:init(c)
	controllers = c
end

local function hex(h: string?): Color3?
	if type(h) ~= "string" then
		return nil
	end
	local ok, c = pcall(Color3.fromHex, h)
	return if ok then c else nil
end

local function quality(): number
	return if settings then settings:qualityFactor() else 1
end

-- UI ----------------------------------------------------------------------------------------------

local function buildUi()
	gui = Ui.new("ScreenGui", {
		Name = "EventHud",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 5,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	Ui.autoScale(gui)
	card = Ui.new("Frame", {
		Name = "EventCard",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.24),
		Size = UDim2.fromOffset(560, 128),
		BackgroundColor3 = Theme.Color.Panel,
		Visible = false,
		Parent = gui,
	}, {
		Ui.corner(Theme.Radius.Large),
		Ui.stroke(4, Theme.Color.Ink),
		Ui.new("UIScale", { Scale = 1 }),
	})
	cardIcon = Ui.new("TextLabel", {
		Text = "☄️",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 14, 0.5, 0),
		Size = UDim2.fromOffset(100, 100),
		TextScaled = true,
		Parent = card,
	})
	cardTitle = Ui.new("TextLabel", {
		Text = "METEOR SHOWER",
		Position = UDim2.fromOffset(124, 12),
		Size = UDim2.new(1, -138, 0, 62),
		TextScaled = true,
		FontFace = Theme.Font.Display,
		TextColor3 = Theme.Color.White,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = card,
	}, { Ui.stroke(3, Theme.Color.Ink) })
	cardSub = Ui.new("TextLabel", {
		Text = "",
		Position = UDim2.fromOffset(124, 76),
		Size = UDim2.new(1, -138, 0, 38),
		TextScaled = true,
		FontFace = Theme.Font.Bold,
		TextColor3 = Theme.Color.Ink,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = card,
	})
	-- Countdown chip beside the round timer pill (top left) while an event runs.
	chip = Ui.new("Frame", {
		Name = "EventChip",
		Position = UDim2.fromOffset(184, 56),
		Size = UDim2.fromOffset(250, 40),
		BackgroundColor3 = Theme.Color.Panel,
		Visible = false,
		Parent = gui,
	}, { Ui.corner(Theme.Radius.Pill), Ui.stroke(3, Theme.Color.Ink) })
	chipFill = Ui.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Color.Magic,
		BackgroundTransparency = 0.25,
		Parent = chip,
	}, { Ui.corner(Theme.Radius.Pill) })
	chipLabel = Ui.new("TextLabel", {
		Text = "",
		Position = UDim2.fromOffset(10, 4),
		Size = UDim2.new(1, -20, 1, -8),
		TextScaled = true,
		FontFace = Theme.Font.Bold,
		TextColor3 = Theme.Color.White,
		ZIndex = 2,
		Parent = chip,
	}, { Ui.stroke(2, Theme.Color.Ink) })
end

local function slamCard(icon: string, title: string, sub: string, color: Color3)
	cardIcon.Text = icon
	cardTitle.Text = string.upper(title)
	cardTitle.TextColor3 = color
	cardSub.Text = sub
	card.Visible = true
	card.BackgroundTransparency = 0
	local scale = card:FindFirstChildOfClass("UIScale")
	scale.Scale = 0.2
	card.Rotation = -6
	Ui.tween(scale, Theme.Tween.Bounce, { Scale = 1 })
	Ui.tween(card, Theme.Tween.Pop, { Rotation = 0 })
	-- The icon wobbles for attention.
	task.spawn(function()
		for i = 1, 6 do
			if not card.Visible then
				break
			end
			Ui.tween(cardIcon, TweenInfo.new(0.12), { Rotation = if i % 2 == 0 then 12 else -12 })
			task.wait(0.12)
		end
		cardIcon.Rotation = 0
	end)
	local shown = title
	task.delay(3.4, function()
		if cardTitle.Text == string.upper(shown) then
			Ui.tween(scale, Theme.Tween.Smooth, { Scale = 0 })
			task.wait(0.3)
			if cardTitle.Text == string.upper(shown) then
				card.Visible = false
			end
		end
	end)
end

-- WEATHER -----------------------------------------------------------------------------------------

local function emitter(props): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	for k, v in props do
		e[k] = v
	end
	e.Parent = weatherPart
	table.insert(weatherEmitters, e)
	return e
end

local function clearWeather()
	for _, e in weatherEmitters do
		e.Enabled = false
		task.delay(3, function()
			e:Destroy()
		end)
	end
	table.clear(weatherEmitters)
	weatherName = nil
end

local function setWeather(name: string?, color: Color3)
	if name == weatherName then
		return
	end
	clearWeather()
	weatherName = name
	if not name or not weatherPart then
		return
	end
	local q = quality()
	if name == "Rain" then
		emitter({
			Texture = RAIN,
			Color = ColorSequence.new(Color3.fromRGB(210, 235, 255)),
			LightEmission = 0.3,
			Transparency = NumberSequence.new(0.35),
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.15), NumberSequenceKeypoint.new(1, 0.15) }),
			Squash = NumberSequence.new(-6),
			Lifetime = NumberRange.new(0.9, 1.2),
			Rate = 500 * q,
			Speed = NumberRange.new(110, 140),
			EmissionDirection = Enum.NormalId.Bottom,
			Orientation = Enum.ParticleOrientation.FacingCameraWorldUp,
			SpreadAngle = Vector2.new(6, 6),
		})
		emitter({
			Texture = SMOKE,
			Color = ColorSequence.new(Color3.fromRGB(200, 220, 240)),
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.85), NumberSequenceKeypoint.new(1, 1) }),
			Size = NumberSequence.new(40),
			Lifetime = NumberRange.new(4, 6),
			Rate = 6 * q,
			Speed = NumberRange.new(4, 10),
			EmissionDirection = Enum.NormalId.Bottom,
		})
	elseif name == "Glitter" then
		emitter({
			Texture = SPARKLE,
			Color = ColorSequence.new(Color3.fromRGB(255, 230, 140), Color3.fromRGB(255, 190, 80)),
			LightEmission = 1,
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.2, 0), NumberSequenceKeypoint.new(1, 1) }),
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0.1) }),
			Lifetime = NumberRange.new(3, 5),
			Rate = 80 * q,
			Speed = NumberRange.new(3, 8),
			EmissionDirection = Enum.NormalId.Bottom,
			RotSpeed = NumberRange.new(-120, 120),
			SpreadAngle = Vector2.new(40, 40),
		})
	elseif name == "Meteors" then
		-- Distant shooting stars in the sky (the real meteors are props with their own trails).
		emitter({
			Texture = FIRE,
			Color = ColorSequence.new(Color3.fromRGB(255, 230, 200), Color3.fromRGB(170, 130, 255)),
			LightEmission = 1,
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) }),
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 3), NumberSequenceKeypoint.new(1, 0) }),
			Squash = NumberSequence.new(-4),
			Lifetime = NumberRange.new(1, 1.6),
			Rate = 6 * q + 2,
			Speed = NumberRange.new(140, 220),
			Acceleration = Vector3.new(0, -40, 0),
			EmissionDirection = Enum.NormalId.Front,
			Orientation = Enum.ParticleOrientation.VelocityParallel,
			SpreadAngle = Vector2.new(50, 20),
		})
	elseif name == "Dust" then
		emitter({
			Texture = SMOKE,
			Color = ColorSequence.new(Color3.fromRGB(240, 210, 160)),
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.4, 0.75), NumberSequenceKeypoint.new(1, 1) }),
			Size = NumberSequence.new(24),
			Lifetime = NumberRange.new(3, 5),
			Rate = 10 * q,
			Speed = NumberRange.new(10, 20),
			EmissionDirection = Enum.NormalId.Right,
			SpreadAngle = Vector2.new(30, 10),
		})
	elseif name == "Floaty" then
		emitter({
			Texture = SPARKLE,
			Color = ColorSequence.new(Color3.fromRGB(220, 200, 255), Color3.fromRGB(160, 220, 255)),
			LightEmission = 0.7,
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 0.2), NumberSequenceKeypoint.new(1, 1) }),
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1.4) }),
			Lifetime = NumberRange.new(4, 7),
			Rate = 40 * q,
			Speed = NumberRange.new(2, 5),
			EmissionDirection = Enum.NormalId.Top,
			SpreadAngle = Vector2.new(70, 70),
		})
	elseif name == "Sparks" then
		emitter({
			Texture = SPARKLE,
			Color = ColorSequence.new(color, Color3.fromRGB(255, 255, 255)),
			LightEmission = 1,
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }),
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 0) }),
			Lifetime = NumberRange.new(0.6, 1.2),
			Rate = 60 * q,
			Speed = NumberRange.new(10, 30),
			EmissionDirection = Enum.NormalId.Bottom,
			SpreadAngle = Vector2.new(80, 80),
		})
	end
end

local function updateWeatherPart()
	local cam = Workspace.CurrentCamera
	if not cam or not weatherPart then
		return
	end
	local focus = cam.Focus.Position
	local look = cam.CFrame.LookVector
	-- A wide sheet of emitters above and slightly ahead of what the camera is looking at.
	local ahead = Vector3.new(look.X, 0, look.Z)
	if ahead.Magnitude > 0.01 then
		ahead = ahead.Unit
	end
	local size = math.clamp((cam.CFrame.Position - focus).Magnitude * 2.2, 120, 600)
	weatherPart.Size = Vector3.new(size, 1, size)
	if weatherName == "Meteors" then
		-- Shooting stars start high and off to one side, streaking across the sky.
		weatherPart.CFrame = CFrame.lookAt(focus + Vector3.new(0, 260, 0) - ahead * 200, focus + ahead * 300 + Vector3.new(0, 150, 0))
	elseif weatherName == "Floaty" then
		weatherPart.CFrame = CFrame.new(focus + ahead * size * 0.2 - Vector3.new(0, 10, 0))
	elseif weatherName == "Dust" then
		weatherPart.CFrame = CFrame.new(focus + Vector3.new(0, 12, 0) + ahead * size * 0.2)
	else
		weatherPart.CFrame = CFrame.new(focus + Vector3.new(0, 70, 0) + ahead * size * 0.25)
	end
end

-- LIGHTING ----------------------------------------------------------------------------------------

local function stopLightingTweens()
	for _, t in lightingTweens do
		t:Cancel()
	end
	table.clear(lightingTweens)
end

local function applyLighting(spec)
	stopLightingTweens()
	if not colorFx then
		local fx = Instance.new("ColorCorrectionEffect")
		fx.Name = "EventColor"
		fx.Parent = Lighting
		colorFx = fx
	end
	local info = TweenInfo.new(2.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	if spec then
		if not lightingSaved then
			lightingSaved = { clock = Lighting.ClockTime, fog = Lighting.FogColor }
		end
		table.insert(lightingTweens, TweenService:Create(colorFx, info, {
			TintColor = hex(spec.tint) or Color3.new(1, 1, 1),
			Brightness = spec.brightness or 0,
			Saturation = spec.saturation or 0,
		}))
		local props = {}
		if spec.clock then
			props.ClockTime = spec.clock
		end
		if spec.fog then
			props.FogColor = hex(spec.fog)
		end
		if next(props) then
			table.insert(lightingTweens, TweenService:Create(Lighting, info, props))
		end
	else
		table.insert(lightingTweens, TweenService:Create(colorFx, info, { TintColor = Color3.new(1, 1, 1), Brightness = 0, Saturation = 0 }))
		if lightingSaved then
			table.insert(lightingTweens, TweenService:Create(Lighting, info, { ClockTime = lightingSaved.clock, FogColor = lightingSaved.fog }))
			lightingSaved = nil
		end
	end
	for _, t in lightingTweens do
		t:Play()
	end
end

-- SUPPLY DROP BEAM / GIANT AURA -------------------------------------------------------------------

local function clearBeam()
	if beam then
		beam:Destroy()
		beam = nil
	end
end

local function makeBeam(pos: Vector3, color: Color3)
	clearBeam()
	local model = Instance.new("Model")
	model.Name = "SupplyBeam"
	local pillar = Instance.new("Part")
	pillar.Anchored = true
	pillar.CanCollide = false
	pillar.CanQuery = false
	pillar.CanTouch = false
	pillar.CastShadow = false
	pillar.Material = Enum.Material.Neon
	pillar.Color = color
	pillar.Transparency = 0.55
	pillar.Shape = Enum.PartType.Cylinder
	pillar.Size = Vector3.new(400, 6, 6)
	pillar.CFrame = CFrame.new(pos + Vector3.new(0, 200, 0)) * CFrame.Angles(0, 0, math.pi / 2)
	pillar.Parent = model
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(120, 120)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.StudsOffsetWorldSpace = Vector3.new(0, 40, 0)
	bb.Adornee = pillar
	bb.MaxDistance = 3000
	bb.Parent = pillar
	local icon = Instance.new("TextLabel")
	icon.BackgroundTransparency = 1
	icon.Size = UDim2.fromScale(1, 0.7)
	icon.Text = "📦"
	icon.TextScaled = true
	icon.Parent = bb
	local dist = Instance.new("TextLabel")
	dist.Name = "Distance"
	dist.BackgroundTransparency = 1
	dist.Position = UDim2.fromScale(0, 0.7)
	dist.Size = UDim2.fromScale(1, 0.3)
	dist.TextScaled = true
	dist.FontFace = Theme.Font.Display
	dist.TextColor3 = Theme.Color.White
	dist.Text = ""
	dist.Parent = bb
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = Theme.Color.Ink
	stroke.Parent = dist
	model.Parent = Workspace
	beam = model
	-- Pulse.
	TweenService:Create(pillar, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
		Transparency = 0.8,
		Size = Vector3.new(400, 9, 9),
	}):Play()
end

local function clearGiant()
	for _, inst in giantFx do
		inst:Destroy()
	end
	table.clear(giantFx)
	giantBall = nil
end

local function markGiant(ball: BasePart)
	if giantBall == ball then
		return
	end
	clearGiant()
	giantBall = ball
	local hl = Instance.new("Highlight")
	hl.FillColor = Color3.fromRGB(255, 70, 110)
	hl.FillTransparency = 0.75
	hl.OutlineColor = Color3.fromRGB(255, 220, 120)
	hl.OutlineTransparency = 0
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Adornee = ball
	hl.Parent = ball
	table.insert(giantFx, hl)
	TweenService:Create(hl, TweenInfo.new(0.45, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { FillTransparency = 0.35 }):Play()
	local a = Instance.new("Attachment")
	a.Parent = ball
	table.insert(giantFx, a)
	local aura = Instance.new("ParticleEmitter")
	aura.Texture = FIRE
	aura.LightEmission = 1
	aura.Color = ColorSequence.new(Color3.fromRGB(255, 120, 150), Color3.fromRGB(255, 200, 90))
	aura.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) })
	aura.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, ball.Size.X * 0.4), NumberSequenceKeypoint.new(1, 0) })
	aura.Lifetime = NumberRange.new(0.5, 0.9)
	aura.Rate = 30
	aura.Speed = NumberRange.new(ball.Size.X * 0.3, ball.Size.X * 0.6)
	aura.SpreadAngle = Vector2.new(180, 180)
	aura.Parent = a
	table.insert(giantFx, aura)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(220, 60)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.StudsOffsetWorldSpace = Vector3.new(0, ball.Size.Y * 0.75 + 4, 0)
	bb.MaxDistance = 2500
	bb.Adornee = ball
	bb.Parent = ball
	table.insert(giantFx, bb)
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Text = "🦖 GIANT!"
	label.TextScaled = true
	label.FontFace = Theme.Font.Display
	label.TextColor3 = Color3.fromRGB(255, 110, 140)
	label.Parent = bb
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = Theme.Color.Ink
	stroke.Parent = label
end

local function findBallByUserId(userId: number): BasePart?
	local balls = Workspace:FindFirstChild("Balls")
	if not balls then
		return nil
	end
	for _, ball in balls:GetChildren() do
		if ball:IsA("BasePart") and ball:GetAttribute("OwnerId") == userId then
			return ball
		end
	end
	return nil
end

-- FLOW --------------------------------------------------------------------------------------------

local function applyEvent(ev, fresh: boolean)
	local id = ev and ev.id or nil
	if id == currentId and not fresh then
		current = ev or current
		return
	end
	currentId = id
	current = ev
	EventController.Changed:Fire(ev)
	if not ev then
		setWeather(nil, Color3.new(1, 1, 1))
		applyLighting(nil)
		clearBeam()
		clearGiant()
		chip.Visible = false
		return
	end
	local color = hex(ev.color) or Theme.Color.Magic
	setWeather(ev.weather, color)
	applyLighting(ev.lighting)
	chip.Visible = true
	chipFill.BackgroundColor3 = color
	beamPropId = nil
	if ev.pos and typeof(ev.pos) == "Vector3" then
		makeBeam(ev.pos, color)
	elseif type(ev.propId) == "number" then
		-- Golden Runner: the beam follows the critter around.
		beamPropId = ev.propId
		makeBeam(Vector3.new(0, -5000, 0), color)
	else
		clearBeam()
	end
	clearGiant()
end

local function onWorldEvent(id: string?, info)
	if not id then
		applyEvent(nil, false)
		return
	end
	info = info or {}
	local ev = {
		id = id,
		name = info.name,
		icon = info.icon,
		color = info.color,
		description = info.description,
		endsAt = info.endsAt,
		startedAt = state:serverTime(),
		pos = info.pos,
		propId = info.propId,
		giantId = info.giantId,
		weather = info.weather,
		lighting = info.lighting,
	}
	-- Merge with the snapshot copy when it arrives (it carries weather/lighting).
	local snap = state.round and state.round.event
	if snap and snap.id == id then
		for k, v in snap do
			if ev[k] == nil then
				ev[k] = v
			end
		end
	end
	applyEvent(ev, true)
	local color = hex(info.color) or Theme.Color.Magic
	local sub = info.description or ""
	local me = Players.LocalPlayer
	if info.giantId and info.giantId == me.UserId then
		sub = "That's YOU! Roll everyone up!"
	elseif info.giantName then
		sub = info.giantName .. " is the GIANT! Run!"
	end
	if info.by then
		sub = sub .. "  (thanks " .. tostring(info.by) .. "!)"
	end
	slamCard(info.icon or "✨", info.name or id, sub, color)
	if controllers.AudioController then
		controllers.AudioController:play("EventStart")
	end
	if controllers.CameraController then
		controllers.CameraController:kickFov(6)
	end
	if controllers.HudController and controllers.HudController.feed then
		controllers.HudController:feed((info.icon or "✨") .. " " .. (info.name or id) .. "!", color)
	end
end

local function update()
	if weatherPart then
		updateWeatherPart()
	end
	if not current then
		return
	end
	local left = math.max(0, (current.endsAt or 0) - state:serverTime())
	local total = math.max(1, (current.endsAt or 0) - (current.startedAt or (current.endsAt or 0) - 30))
	chipLabel.Text = string.format("%s %s  %ds", current.icon or "✨", current.name or "", math.ceil(left))
	chipFill.Size = UDim2.fromScale(math.clamp(left / total, 0, 1), 1)
	if beam and beamPropId then
		local world = controllers.WorldController
		local p = world and world.props[beamPropId]
		local pillar = beam:FindFirstChildWhichIsA("BasePart")
		if not p then
			clearBeam()
			beamPropId = nil
		elseif pillar and p.model then
			local at = p.model:GetPivot().Position
			pillar.CFrame = CFrame.new(at + Vector3.new(0, 200, 0)) * CFrame.Angles(0, 0, math.pi / 2)
		end
	end
	if beam then
		local pillar = beam:FindFirstChildWhichIsA("BasePart")
		local ball = state:focusBall()
		if pillar and ball then
			local bb = pillar:FindFirstChildOfClass("BillboardGui")
			local label = bb and bb:FindFirstChild("Distance")
			if label then
				local d = (Vector3.new(pillar.Position.X, 0, pillar.Position.Z) - Vector3.new(ball.Position.X, 0, ball.Position.Z)).Magnitude
				label.Text = string.format("%dm", math.floor(d * ((state.round and state.round.cmPerStud) or 100) / 100))
			end
		end
	end
	if current.giantId and not giantBall then
		local ball = findBallByUserId(current.giantId)
		if ball then
			markGiant(ball)
		end
	elseif giantBall and not giantBall.Parent then
		clearGiant()
	end
end

function EventController:showCard(icon: string, title: string, sub: string, color: Color3)
	slamCard(icon, title, sub, color)
end

-- Night Roll mutator: moonlit lighting for the round, restored afterwards.
local function setNight(on: boolean)
	if on and not nightSaved then
		nightSaved = { clock = Lighting.ClockTime, brightness = Lighting.Brightness, ambient = Lighting.OutdoorAmbient }
		local fx = Instance.new("ColorCorrectionEffect")
		fx.Name = "NightRoll"
		fx.Parent = Lighting
		nightFx = fx
		local info = TweenInfo.new(3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
		TweenService:Create(Lighting, info, { ClockTime = 23.2, Brightness = 1.4, OutdoorAmbient = Color3.fromRGB(90, 96, 150) }):Play()
		TweenService:Create(fx, info, { TintColor = Color3.fromRGB(200, 210, 255), Saturation = -0.05, Contrast = 0.1 }):Play()
	elseif not on and nightSaved then
		local saved = nightSaved
		nightSaved = nil
		local info = TweenInfo.new(2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
		TweenService:Create(Lighting, info, { ClockTime = saved.clock, Brightness = saved.brightness, OutdoorAmbient = saved.ambient }):Play()
		local fx = nightFx
		nightFx = nil
		if fx then
			TweenService:Create(fx, info, { TintColor = Color3.new(1, 1, 1), Saturation = 0, Contrast = 0 }):Play()
			task.delay(2.2, function()
				fx:Destroy()
			end)
		end
	end
end

-- New round: announce the map + mode, then the mutator.
local function onRoundStart(round)
	local mode = Modes.get(round.mode)
	local kit = round.kitId and Kits.get(round.kitId)
	local mutator = Mutators.get(round.mutator)
	setNight(mutator ~= nil and mutator.night == true)
	task.delay(1.5, function()
		slamCard(mode.icon, mode.name, (if kit then kit.name .. ": " else "") .. mode.goal, hex(mode.color) or Theme.Color.Primary)
		if controllers.AudioController then
			controllers.AudioController:play("EventStart")
		end
	end)
	if mutator then
		task.delay(5.6, function()
			slamCard(mutator.icon, mutator.name, mutator.description, hex(mutator.color) or Theme.Color.Magic)
		end)
	end
end

function EventController:current()
	return current
end

function EventController:start()
	state = controllers.ClientState
	settings = controllers.SettingsController
	buildUi()
	local part = Instance.new("Part")
	part.Name = "EventWeather"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Transparency = 1
	part.Size = Vector3.new(200, 1, 200)
	part.Parent = Workspace.CurrentCamera or Workspace
	weatherPart = part
	Net.connect("WorldEvent", onWorldEvent)
	-- Late joiners and missed pings: the round snapshot is the source of truth.
	state.RoundChanged:Connect(function(round)
		if round and round.state == "Playing" and round.roundId ~= lastRoundId then
			lastRoundId = round.roundId
			onRoundStart(round)
		elseif round and round.state ~= "Playing" and round.state ~= "Launch" and nightSaved then
			setNight(false)
		end
		local ev = round and round.event
		if ev then
			if ev.id ~= currentId then
				applyEvent(ev, false)
			else
				-- Keep weather/lighting fields from the snapshot.
				for k, v in ev do
					current[k] = v
				end
				if ev.lighting and not lightingSaved then
					applyLighting(ev.lighting)
				end
				if ev.weather and weatherName ~= ev.weather then
					setWeather(ev.weather, hex(ev.color) or Theme.Color.Magic)
				end
			end
		elseif currentId then
			applyEvent(nil, false)
		end
	end)
	RunService.RenderStepped:Connect(update)
end

return EventController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="98">
            <Properties>
              <string name="Name">HubController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Hub-side client behaviour: restores normal walking controls/camera in the hub, keeps the VIP
-- lounge gate solid for non-VIPs (character physics is client-owned, so this is enforced locally),
-- and adds a soft ambient particle drift so the floating island feels alive.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local HubController = {}

local controllers

function HubController:init(c)
	controllers = c
end

local function setVipGate(hub: Instance)
	local gate = hub:FindFirstChild("VipGate", true)
	if gate and gate:IsA("BasePart") then
		local isVip = Players.LocalPlayer:GetAttribute("VIP") == true
		gate.CanCollide = not isVip
		gate.Transparency = if isVip then 0.85 else 0.6
	end
end

local function ambience(hub: Instance)
	local top = hub:FindFirstChild("Top")
	if not top or not top:IsA("BasePart") then
		return
	end
	-- Emitting straight from the island part spreads motes over its whole volume.
	local motes = Instance.new("ParticleEmitter")
	motes.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	motes.Color = ColorSequence.new(Color3.fromRGB(255, 236, 170), Color3.fromRGB(200, 182, 255))
	motes.LightEmission = 1
	motes.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 0.6), NumberSequenceKeypoint.new(1, 0) })
	motes.Lifetime = NumberRange.new(4, 7)
	motes.Rate = 14
	motes.Speed = NumberRange.new(0.5, 1.5)
	motes.SpreadAngle = Vector2.new(180, 180)
	motes.Acceleration = Vector3.new(0, 0.6, 0)
	motes.Shape = Enum.ParticleEmitterShape.Box
	motes.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	motes.Parent = top
end

function HubController:start()
	task.spawn(function()
		local hub = Workspace:WaitForChild("Hub", 60)
		if hub then
			setVipGate(hub)
			ambience(hub)
			Players.LocalPlayer:GetAttributeChangedSignal("VIP"):Connect(function()
				setVipGate(hub)
			end)
		end
	end)
	local state = controllers.ClientState
	state.PlayerStateChanged:Connect(function(newState)
		if newState == "Hub" and controllers.CameraController then
			controllers.CameraController:setMode("Default")
		end
	end)
end

return HubController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="99">
            <Properties>
              <string name="Name">HudController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- The gameplay HUD. Minimal and loud: a huge animated size counter (the headline number), the next
-- thing you'll be able to roll up, round timer, top-3, floaters, NEW! toasts, goal-unlocked
-- moments, Final Roll banner, touch Dash/Hop buttons, landmark marker, and the results screen.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Theme = require(Shared.Config.Theme)
local Rarity = require(Shared.Config.Rarity)
local Tuning = require(Shared.Config.Tuning)
local Format = require(Shared.Util.Format)
local Spring = require(Shared.Util.Spring)
local PropLibrary = require(Shared.Logic.PropLibrary)
local Growth = require(Shared.Logic.Growth)
local Mutations = require(Shared.Data.Mutations)
local Kits = require(Shared.Data.Kits)
local Modes = require(Shared.Data.Modes)
local PropBuilder = require(Shared.PropBuilder)
local Ui = require(script.Parent.Parent.UI.Ui)

local HudController = {}

local controllers
local state, settings, input
local gui: ScreenGui
local root: Frame
local sizeValue: TextLabel
local sizeUnit: TextLabel
local sizeScale: UIScale
local sizeSpring = Spring.new(3, 120, 15)
local bumpSpring = Spring.new(1, 260, 12)
local goalCard: Frame
local goalIcon: ViewportFrame
local goalText: TextLabel
local goalBar: Frame
local goalUid: number? = nil
local timerLabel: TextLabel
local timerPill: Frame
local topList: Frame
local floaters: Frame
local toasts: Frame
local banner: TextLabel
local touchButtons: Frame
local dashFill: Frame
local loadingChip: TextLabel
local resultsPanel: Frame? = nil
local pendingGain = 0
local pendingAt = 0
local lastUnit = "cm"
local thumbnails = {}
local comboLabel: TextLabel
local comboScale: UIScale
local combo = 0
local lastComboAt = 0
local speedLines: Frame
local countdownLabel: TextLabel
local riderPanel: Frame
local riderTitle: TextLabel
local riderSub: TextLabel

local burstHolder: Frame
local feed: Frame
local modeChip: Frame
local modeChipLabel: TextLabel
local teamBar: Frame
local teamRedFill: Frame
local teamLabel: TextLabel
local lastCountdown = -1
local lines = {}
local COMBO_COLORS = {
	{ 0, Color3.fromRGB(255, 255, 255) },
	{ 5, Color3.fromRGB(255, 236, 120) },
	{ 12, Color3.fromRGB(255, 170, 70) },
	{ 25, Color3.fromRGB(255, 110, 170) },
	{ 50, Color3.fromRGB(176, 140, 255) },
}

function HudController:init(c)
	controllers = c
end

local function cmPerStud(): number
	return state.round.cmPerStud or 1
end

local function rarityColor(id: string): Color3
	return Rarity.color(id, settings.values.colorblind)
end

-- Builders --------------------------------------------------------------------------------------

local function buildSizeCounter()
	local holder = Ui.new("Frame", {
		Name = "Size",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 10),
		Size = UDim2.fromOffset(420, 120),
		BackgroundTransparency = 1,
		Parent = root,
	})
	sizeScale = Ui.new("UIScale", { Parent = holder })
	sizeValue = Ui.display("3.0", {
		Name = "Value",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(0.68, 0, 0, 0),
		Size = UDim2.new(0.68, 0, 0, 92),
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = holder,
	})
	Ui.gradient(Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 226, 150)).Parent = sizeValue
	sizeUnit = Ui.display("cm", {
		Name = "Unit",
		Position = UDim2.new(0.7, 0, 0, 32),
		Size = UDim2.new(0.3, 0, 0, 56),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Theme.Color.Accent,
		Parent = holder,
	})
end

local function buildGoalCard()
	goalCard = Ui.new("Frame", {
		Name = "Goal",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 118),
		Size = UDim2.fromOffset(300, 54),
		BackgroundColor3 = Theme.Color.Ink,
		BackgroundTransparency = 0.25,
		Visible = false,
		Parent = root,
	}, { Ui.corner(Theme.Radius.Pill), Ui.stroke(2, Color3.fromRGB(255, 255, 255)) })
	local iconHolder = Ui.new("Frame", {
		Size = UDim2.fromOffset(62, 62),
		Position = UDim2.fromOffset(-8, -6),
		BackgroundColor3 = Theme.Color.PanelAlt,
		Parent = goalCard,
	}, { Ui.corner(Theme.Radius.Pill), Ui.stroke(3, Theme.Color.Ink) })
	goalIcon = Ui.viewport(nil, { Size = UDim2.fromScale(1, 1), Parent = iconHolder })
	Ui.new("TextLabel", {
		Text = "🔒",
		Size = UDim2.fromOffset(22, 22),
		Position = UDim2.new(1, -18, 1, -20),
		TextScaled = true,
		Parent = iconHolder,
	})
	goalText = Ui.new("TextLabel", {
		Position = UDim2.fromOffset(62, 4),
		Size = UDim2.new(1, -74, 0, 26),
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "",
		Parent = goalCard,
	}, { Ui.stroke(2, Theme.Color.Ink) })
	local barBg = Ui.new("Frame", {
		Position = UDim2.fromOffset(62, 34),
		Size = UDim2.new(1, -78, 0, 12),
		BackgroundColor3 = Color3.fromRGB(70, 56, 120),
		Parent = goalCard,
	}, { Ui.corner(Theme.Radius.Pill) })
	goalBar = Ui.new("Frame", {
		Size = UDim2.fromScale(0.3, 1),
		BackgroundColor3 = Theme.Color.Accent,
		Parent = barBg,
	}, { Ui.corner(Theme.Radius.Pill), Ui.gradient(Color3.fromRGB(255, 236, 140), Color3.fromRGB(255, 160, 60), 0) })
end

local function buildTimer()
	timerPill = Ui.new("Frame", {
		Name = "Timer",
		Position = UDim2.fromOffset(16, 14),
		Size = UDim2.fromOffset(150, 52),
		BackgroundColor3 = Theme.Color.Panel,
		Parent = root,
	}, { Ui.corner(Theme.Radius.Pill), Ui.stroke(3, Theme.Color.Ink) })
	Ui.new("TextLabel", {
		Text = "⏱️",
		Size = UDim2.fromOffset(40, 40),
		Position = UDim2.fromOffset(8, 6),
		TextScaled = true,
		Parent = timerPill,
	})
	timerLabel = Ui.new("TextLabel", {
		Text = "7:30",
		Position = UDim2.fromOffset(50, 4),
		Size = UDim2.new(1, -60, 1, -8),
		TextScaled = true,
		FontFace = Theme.Font.Display,
		TextColor3 = Theme.Color.Ink,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = timerPill,
	})
end

local function buildTopList()
	topList = Ui.new("Frame", {
		Name = "Top",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 14),
		Size = UDim2.fromOffset(230, 150),
		BackgroundTransparency = 1,
		Parent = root,
	}, {
		Ui.new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	for i = 1, 3 do
		local row = Ui.new("Frame", {
			Name = "Row" .. i,
			LayoutOrder = i,
			Size = UDim2.new(1, 0, 0, 40),
			BackgroundColor3 = Theme.Color.Ink,
			BackgroundTransparency = 0.3,
			Visible = false,
			Parent = topList,
		}, { Ui.corner(Theme.Radius.Pill) })
		Ui.new("TextLabel", {
			Name = "Rank",
			Text = ({ "🥇", "🥈", "🥉" })[i],
			Size = UDim2.fromOffset(34, 34),
			Position = UDim2.fromOffset(4, 3),
			TextScaled = true,
			Parent = row,
		})
		Ui.new("ImageLabel", {
			Name = "Avatar",
			Size = UDim2.fromOffset(32, 32),
			Position = UDim2.fromOffset(40, 4),
			BackgroundColor3 = Theme.Color.PanelAlt,
			Parent = row,
		}, { Ui.corner(Theme.Radius.Pill) })
		Ui.new("TextLabel", {
			Name = "Name",
			Position = UDim2.fromOffset(78, 2),
			Size = UDim2.new(1, -160, 1, -4),
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = row,
		}, { Ui.stroke(1.5, Theme.Color.Ink) })
		Ui.new("TextLabel", {
			Name = "Size",
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -10, 0, 4),
			Size = UDim2.fromOffset(78, 32),
			TextScaled = true,
			FontFace = Theme.Font.Display,
			TextColor3 = Theme.Color.Accent,
			TextXAlignment = Enum.TextXAlignment.Right,
			Parent = row,
		}, { Ui.stroke(2, Theme.Color.Ink) })
	end
end

-- Under the top list: what this round is about (mode, your score) and, in Team Roll, the score bar.
local function buildModeHud()
	modeChip = Ui.new("Frame", {
		Name = "ModeChip",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 156),
		Size = UDim2.fromOffset(230, 34),
		BackgroundColor3 = Theme.Color.Panel,
		BackgroundTransparency = 0.1,
		Visible = false,
		Parent = root,
	}, { Ui.corner(Theme.Radius.Pill), Ui.stroke(2.5, Theme.Color.Ink) })
	modeChipLabel = Ui.new("TextLabel", {
		Position = UDim2.fromOffset(10, 4),
		Size = UDim2.new(1, -20, 1, -8),
		TextScaled = true,
		TextColor3 = Theme.Color.Ink,
		Parent = modeChip,
	})
	teamBar = Ui.new("Frame", {
		Name = "TeamBar",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 196),
		Size = UDim2.fromOffset(230, 30),
		BackgroundColor3 = Color3.fromRGB(70, 160, 255),
		Visible = false,
		Parent = root,
	}, { Ui.corner(Theme.Radius.Pill), Ui.stroke(2.5, Theme.Color.Ink) })
	teamRedFill = Ui.new("Frame", {
		Size = UDim2.fromScale(0.5, 1),
		BackgroundColor3 = Color3.fromRGB(255, 84, 104),
		Parent = teamBar,
	}, { Ui.corner(Theme.Radius.Pill) })
	teamLabel = Ui.new("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		TextScaled = true,
		ZIndex = 3,
		Parent = teamBar,
	}, { Ui.stroke(2, Theme.Color.Ink), Ui.padding(3) })
end

local function updateModeHud()
	local round = state.round
	local playing = round.state == "Playing"
	local mode = Modes.get(round.mode)
	modeChip.Visible = playing
	teamBar.Visible = playing and round.teamTotals ~= nil
	if not playing then
		return
	end
	local me = nil
	for _, e in round.top or {} do
		if e.userId == state.player.UserId then
			me = e
		end
	end
	local text = mode.icon .. " " .. mode.name
	if mode.scoring == "crown" then
		local holder = "nobody"
		for _, e in round.top or {} do
			if e.userId == round.crownId then
				holder = if e.userId == state.player.UserId then "YOU!" else e.name
			end
		end
		text = "👑 " .. holder
	elseif mode.scoring == "gold" and me then
		text = "💰 Your gold: " .. math.floor(me.s or 0)
	end
	modeChipLabel.Text = text
	local totals = round.teamTotals
	if totals then
		local total = math.max(totals.Red + totals.Blue, 1e-3)
		Ui.tween(teamRedFill, Theme.Tween.Smooth, { Size = UDim2.fromScale(math.clamp(totals.Red / total, 0.04, 0.96), 1) })
		local myTeam = me and me.team
		teamLabel.Text = string.format("🔴 %s  vs  %s 🔵", Format.size(totals.Red, cmPerStud()), Format.size(totals.Blue, cmPerStud()))
		local stroke = teamBar:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Color = if myTeam == "Red" then Color3.fromRGB(255, 84, 104) elseif myTeam == "Blue" then Color3.fromRGB(70, 160, 255) else Theme.Color.Ink
		end
	end
end

