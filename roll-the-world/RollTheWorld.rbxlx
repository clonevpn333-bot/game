          <Item class="ModuleScript" referent="26">
            <Properties>
              <string name="Name">Shapes</string>
              <string name="Source"><![CDATA[--!strict
-- Recipe helpers for building props out of primitives. A recipe is pure data (no Instances, no
-- Color3) so it can be validated in tests and built identically on any client.
--
-- Conventions: units are studs at the prop's nominal scale, origin is the centre of the prop's
-- footprint at ground level (y = 0 is the floor), +Z is the prop's "front".
-- Colors are hex strings. Rotations are degrees, applied Y then X then Z (CFrame.fromEulerAnglesYXZ).

export type Shape = "Block" | "Ball" | "Cylinder" | "Wedge" | "CornerWedge" | "Mesh"

export type PartSpec = {
	shape: Shape,
	size: { number }, -- x, y, z (for Cylinder: length along its axis, then diameter, diameter)
	pos: { number },
	rot: { number }?,
	upright: boolean?, -- Cylinder axis points up (+Y) instead of +X
	color: string,
	material: string?,
	transparency: number?,
	reflectance: number?,
	neon: boolean?,
	tag: string?, -- "eye", "leg", "wing", "tail", "head", "body", "accent" (used by critter animation)
	mesh: { [string]: any }?, -- MeshKit descriptor when shape == "Mesh"
	meshCenter: { number }?, -- bbox centre of the generated mesh in its own space
	sharp: boolean?, -- opt out of automatic bevelling for blocks/cylinders
}

export type Opts = {
	rot: { number }?,
	mat: string?,
	t: number?,
	refl: number?,
	tag: string?,
	neon: boolean?,
	sharp: boolean?,
}

local MeshKit = require(script.Parent.Parent.Parent.Logic.MeshKit)

local Shapes = {}

local function finish(spec: PartSpec, opts: Opts?): PartSpec
	if opts then
		spec.rot = opts.rot
		spec.material = opts.mat
		spec.transparency = opts.t
		spec.reflectance = opts.refl
		spec.tag = opts.tag
		spec.sharp = opts.sharp
		if opts.neon then
			spec.neon = true
			spec.material = "Neon"
		end
	end
	return spec
end

-- Axis-aligned box centred at (x, y, z).
function Shapes.box(sx: number, sy: number, sz: number, x: number, y: number, z: number, color: string, opts: Opts?): PartSpec
	return finish({ shape = "Block", size = { sx, sy, sz }, pos = { x, y, z }, color = color }, opts)
end

-- Sphere of diameter d centred at (x, y, z).
function Shapes.ball(d: number, x: number, y: number, z: number, color: string, opts: Opts?): PartSpec
	return finish({ shape = "Ball", size = { d, d, d }, pos = { x, y, z }, color = color }, opts)
end

-- Upright cylinder (axis +Y) of diameter d and height h centred at (x, y, z).
function Shapes.cyl(d: number, h: number, x: number, y: number, z: number, color: string, opts: Opts?): PartSpec
	return finish({ shape = "Cylinder", size = { h, d, d }, pos = { x, y, z }, upright = true, color = color }, opts)
end

-- Cylinder lying along X (wheels, rolling pins, logs). Use opts.rot to point it elsewhere.
function Shapes.cylX(d: number, len: number, x: number, y: number, z: number, color: string, opts: Opts?): PartSpec
	return finish({ shape = "Cylinder", size = { len, d, d }, pos = { x, y, z }, color = color }, opts)
end

function Shapes.wedge(sx: number, sy: number, sz: number, x: number, y: number, z: number, color: string, opts: Opts?): PartSpec
	return finish({ shape = "Wedge", size = { sx, sy, sz }, pos = { x, y, z }, color = color }, opts)
end

function Shapes.corner(sx: number, sy: number, sz: number, x: number, y: number, z: number, color: string, opts: Opts?): PartSpec
	return finish({ shape = "CornerWedge", size = { sx, sy, sz }, pos = { x, y, z }, color = color }, opts)
end

-- Ellipsoid approximation: a ball part stretched via the builder's SpecialMesh scale.
-- Kept as a Ball shape with non-uniform size; PropBuilder renders it with a sphere mesh.
function Shapes.blob(sx: number, sy: number, sz: number, x: number, y: number, z: number, color: string, opts: Opts?): PartSpec
	return finish({ shape = "Ball", size = { sx, sy, sz }, pos = { x, y, z }, color = color }, opts)
end

-- Smooth meshes ---------------------------------------------------------------------------------
-- These generate real triangle meshes (see Logic/MeshKit). x, y, z place the mesh's own origin.

local function meshSpec(desc: { [string]: any }, x: number, y: number, z: number, color: string, opts: Opts?): PartSpec
	local mesh = MeshKit.generate(desc)
	local size = { mesh.max[1] - mesh.min[1], mesh.max[2] - mesh.min[2], mesh.max[3] - mesh.min[3] }
	local center = { (mesh.max[1] + mesh.min[1]) / 2, (mesh.max[2] + mesh.min[2]) / 2, (mesh.max[3] + mesh.min[3]) / 2 }
	return finish({ shape = "Mesh", mesh = desc, meshCenter = center, size = size, pos = { x, y, z }, color = color }, opts)
end

-- Revolve a profile { {radius, y}, ... } (bottom to top) around the vertical axis.
-- extra: { seg, smooth, lobes, lobeDepth, twist, squash = {sx, sz} }
function Shapes.lathe(profile: { { number } }, x: number, y: number, z: number, color: string, opts: Opts?, extra: { [string]: any }?): PartSpec
	local desc: { [string]: any } = { kind = "lathe", profile = profile, seg = 24, smooth = 3 }
	if extra then
		for k, v in extra do
			desc[k] = v
		end
	end
	return meshSpec(desc, x, y, z, color, opts)
end

-- Rounded box with real bevels; radius defaults to 18% of the smallest side.
function Shapes.rbox(sx: number, sy: number, sz: number, x: number, y: number, z: number, color: string, opts: Opts?, radius: number?): PartSpec
	local r = radius or math.min(sx, sy, sz) * 0.18
	return meshSpec({ kind = "rbox", size = { sx, sy, sz }, radius = r, seg = 3 }, x, y, z, color, opts)
end

-- Tube swept along a path of points (smoothed), radius scalar or per point.
function Shapes.tube(path: { { number } }, radius: number | { number }, color: string, opts: Opts?, extra: { [string]: any }?): PartSpec
	local desc: { [string]: any } = { kind = "tube", path = path, radius = radius, sides = 12, smooth = 4, caps = "round" }
	if extra then
		for k, v in extra do
			desc[k] = v
		end
	end
	return meshSpec(desc, 0, 0, 0, color, opts)
end

function Shapes.torus(major: number, minor: number, x: number, y: number, z: number, color: string, opts: Opts?, extra: { [string]: any }?): PartSpec
	local desc: { [string]: any } = { kind = "torus", major = major, minor = minor, segU = 28, segV = 14 }
	if extra then
		for k, v in extra do
			desc[k] = v
		end
	end
	return meshSpec(desc, x, y, z, color, opts)
end

-- Smooth ellipsoid; lump > 0 gives organic cloud/foliage silhouettes.
function Shapes.ell(sx: number, sy: number, sz: number, x: number, y: number, z: number, color: string, opts: Opts?, extra: { [string]: any }?): PartSpec
	local desc: { [string]: any } = { kind = "ellipsoid", size = { sx, sy, sz }, segU = 24, segV = 16 }
	if extra then
		for k, v in extra do
			desc[k] = v
		end
	end
	return meshSpec(desc, x, y, z, color, opts)
end

-- Extrude a 2D outline {{x, z}, ...} upward by height with a soft bevel.
function Shapes.extrude(outline: { { number } }, height: number, x: number, y: number, z: number, color: string, opts: Opts?, extra: { [string]: any }?): PartSpec
	local desc: { [string]: any } = { kind = "extrude", outline = outline, height = height }
	if extra then
		for k, v in extra do
			desc[k] = v
		end
	end
	return meshSpec(desc, x, y, z, color, opts)
end

-- Regular star / flower outline helper for extrude.
function Shapes.starOutline(points: number, outer: number, inner: number): { { number } }
	local out = {}
	for i = 0, points * 2 - 1 do
		local a = i / (points * 2) * math.pi * 2 + math.pi / 2
		local r = if i % 2 == 0 then outer else inner
		table.insert(out, { math.cos(a) * r, math.sin(a) * r })
	end
	return out
end

-- Two cartoon eyes (white + pupil + highlight) placed symmetrically at +/- x on the +Z face.
function Shapes.eyes(spacing: number, d: number, y: number, z: number, out: { PartSpec }, pupilColor: string?)
	for _, side in { -1, 1 } do
		local x = side * spacing / 2
		table.insert(out, Shapes.ball(d, x, y, z, "#ffffff", { tag = "eye", mat = "SmoothPlastic" }))
		table.insert(out, Shapes.ball(d * 0.55, x, y, z + d * 0.3, pupilColor or "#1c1430", { tag = "eye" }))
		table.insert(out, Shapes.ball(d * 0.2, x + d * 0.12, y + d * 0.14, z + d * 0.48, "#ffffff", { tag = "eye", neon = true }))
	end
end

-- Concatenate part lists.
function Shapes.join(...: { PartSpec }): { PartSpec }
	local out = {}
	for i = 1, select("#", ...) do
		for _, p in (select(i, ...)) do
			table.insert(out, p)
		end
	end
	return out
end

-- Copy a list of parts offset/scaled (for reusing sub-assemblies like wheels or legs).
function Shapes.transform(parts: { PartSpec }, scale: number, dx: number, dy: number, dz: number): { PartSpec }
	local out = {}
	for _, p in parts do
		local copy = table.clone(p)
		copy.size = { p.size[1] * scale, p.size[2] * scale, p.size[3] * scale }
		copy.pos = { p.pos[1] * scale + dx, p.pos[2] * scale + dy, p.pos[3] * scale + dz }
		table.insert(out, copy)
	end
	return out
end

-- Lighten (+) or darken (-) a hex color by amount in [-1, 1]. Pure, so recipes can derive shades.
function Shapes.shade(hex: string, amount: number): string
	local h = hex:gsub("#", "")
	local r = tonumber(h:sub(1, 2), 16) or 0
	local g = tonumber(h:sub(3, 4), 16) or 0
	local b = tonumber(h:sub(5, 6), 16) or 0
	local function adjust(c: number): number
		if amount >= 0 then
			return math.floor(c + (255 - c) * amount + 0.5)
		end
		return math.floor(c * (1 + amount) + 0.5)
	end
	return string.format("#%02x%02x%02x", adjust(r), adjust(g), adjust(b))
end

return Shapes
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
      <Item class="Folder" referent="27">
        <Properties>
          <string name="Name">Logic</string>
        </Properties>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">Absorb</string>
            <string name="Source"><![CDATA[--!strict
-- Absorption rules: what can stick to a ball, contact tests, and player-vs-player size checks.
-- Pure functions over numbers so the server, the predicting client and tests agree exactly.

local Tuning = require(script.Parent.Parent.Config.Tuning)

local Absorb = {}

export type Context = {
	ratioBonus: number?, -- added to the absorb ratio (Sticky Rain etc.)
	finalRoll: boolean?,
}

function Absorb.ratio(ctx: Context?): number
	return Tuning.Absorb.Ratio + ((ctx and ctx.ratioBonus) or 0)
end

-- Largest absorbSize a ball of this diameter can pick up.
function Absorb.threshold(diameter: number, ctx: Context?): number
	return diameter * Absorb.ratio(ctx)
end

function Absorb.canAbsorbProp(diameter: number, absorbSize: number, isLandmark: boolean, ctx: Context?): boolean
	if isLandmark then
		if not (ctx and ctx.finalRoll) then
			return false
		end
		return absorbSize <= diameter * Tuning.Absorb.LandmarkReach
	end
	return absorbSize <= Absorb.threshold(diameter, ctx)
end

-- Sphere-vs-fuzzy-sphere contact. `reach` is extra tolerance (latency compensation).
function Absorb.inContact(
	bx: number,
	by: number,
	bz: number,
	ballRadius: number,
	px: number,
	py: number,
	pz: number,
	propRadius: number,
	reach: number
): boolean
	local dx, dy, dz = px - bx, py - by, pz - bz
	local limit = ballRadius + propRadius * (1 - Tuning.Absorb.ContactSlack) + reach
	return dx * dx + dy * dy + dz * dz <= limit * limit
end

-- Distance from point P to segment AB (used to sweep fast balls between server ticks).
function Absorb.segmentDistanceSq(
	ax: number,
	ay: number,
	az: number,
	bx: number,
	by: number,
	bz: number,
	px: number,
	py: number,
	pz: number
): number
	local abx, aby, abz = bx - ax, by - ay, bz - az
	local apx, apy, apz = px - ax, py - ay, pz - az
	local lenSq = abx * abx + aby * aby + abz * abz
	local t = 0
	if lenSq > 1e-9 then
		t = math.clamp((apx * abx + apy * aby + apz * abz) / lenSq, 0, 1)
	end
	local cx, cy, cz = ax + abx * t - px, ay + aby * t - py, az + abz * t - pz
	return cx * cx + cy * cy + cz * cz
end

-- Server-side latency allowance for a ball moving at `speed`.
function Absorb.latencyReach(speed: number): number
	local a = Tuning.Absorb
	return math.min(speed * a.LatencyReachPerSpeed, a.LatencyReachMax)
end

-- Can ball A (diameter da) roll up ball B (diameter db)?
function Absorb.canAbsorbBall(da: number, db: number): boolean
	return da >= db * Tuning.Pvp.AbsorbRatio
end

-- Two balls are "similar size" (eligible to bump rather than absorb).
function Absorb.isBumpPair(da: number, db: number): boolean
	local big, small = math.max(da, db), math.min(da, db)
	return big < small * Tuning.Pvp.AbsorbRatio
end

-- Number of props knocked loose by a bump at the given closing speed.
function Absorb.bumpScatterCount(closingSpeed: number): number
	local p = Tuning.Pvp
	if closingSpeed < p.BumpMinRelativeSpeed then
		return 0
	end
	return math.clamp(math.floor((closingSpeed - p.BumpMinRelativeSpeed) * p.BumpScatterPerSpeed) + 1, 1, p.BumpScatterMax)
end

return Absorb
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">Awards</string>
            <string name="Source"><![CDATA[--!strict
-- End-of-round award selection. Several categories so more than one player feels like a winner:
-- each category prefers a player who hasn't already won something, when one qualifies.

export type PlayerRound = {
	userId: number,
	name: string,
	finalDiameter: number,
	peakDiameter: number,
	discoveries: number,
	playersRolled: number,
	timesRolled: number,
	comebackRatio: number, -- final size / size right after last respawn (0 if never rolled)
	requestsCompleted: number,
	rarestOrder: number, -- rarity order of rarest find, + mutation bonus (0 = none)
	rarestUid: number,
	rarestMutation: number,
}

export type Award = {
	id: string,
	title: string,
	icon: string,
	userId: number,
	name: string,
	value: number,
}

local Awards = {}

Awards.Categories = {
	{
		id = "Biggest",
		title = "Biggest Ball",
		icon = "🏆",
		score = function(p: PlayerRound): number
			return p.finalDiameter
		end,
		minimum = 0,
		exclusive = false, -- the top prize always goes to the true winner
	},
	{
		id = "RarestFind",
		title = "Rarest Find",
		icon = "💎",
		score = function(p: PlayerRound): number
			return p.rarestOrder
		end,
		minimum = 3, -- Rare or better
		exclusive = true,
	},
	{
		id = "MostPlayersRolled",
		title = "Player Roller",
		icon = "🌀",
		score = function(p: PlayerRound): number
			return p.playersRolled
		end,
		minimum = 1,
		exclusive = true,
	},
	{
		id = "BestComeback",
		title = "Best Comeback",
		icon = "🔥",
		score = function(p: PlayerRound): number
			return if p.timesRolled > 0 then p.comebackRatio else 0
		end,
		minimum = 1.5,
		exclusive = true,
	},
	{
		id = "MostDiscoveries",
		title = "Top Explorer",
		icon = "🔍",
		score = function(p: PlayerRound): number
			return p.discoveries
		end,
		minimum = 1,
		exclusive = true,
	},
	{
		id = "RequestCompleted",
		title = "Nana's Helper",
		icon = "🧶",
		score = function(p: PlayerRound): number
			return p.requestsCompleted
		end,
		minimum = 1,
		exclusive = true,
	},
}

function Awards.select(players: { PlayerRound }): { Award }
	local awards: { Award } = {}
	local winners: { [number]: boolean } = {}
	for _, cat in Awards.Categories do
		local ranked = {}
		for _, p in players do
			local s = cat.score(p)
			if s >= cat.minimum and s > 0 then
				table.insert(ranked, { p = p, s = s })
			end
		end
		table.sort(ranked, function(a, b)
			if a.s == b.s then
				return a.p.userId < b.p.userId
			end
			return a.s > b.s
		end)
		local pick = ranked[1]
		if pick and cat.exclusive then
			-- Prefer someone who hasn't won yet, as long as they're within 75% of the best score.
			for _, entry in ranked do
				if not winners[entry.p.userId] and entry.s >= ranked[1].s * 0.75 then
					pick = entry
					break
				end
			end
		end
		if pick then
			winners[pick.p.userId] = true
			table.insert(awards, {
				id = cat.id,
				title = cat.title,
				icon = cat.icon,
				userId = pick.p.userId,
				name = pick.p.name,
				value = pick.s,
			})
		end
	end
	return awards
end

-- Final standings by size (for the podium).
function Awards.standings(players: { PlayerRound }): { PlayerRound }
	local sorted = table.clone(players)
	table.sort(sorted, function(a, b)
		if a.finalDiameter == b.finalDiameter then
			return a.userId < b.userId
		end
		return a.finalDiameter > b.finalDiameter
	end)
	return sorted
end

return Awards
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">Growth</string>
            <string name="Source"><![CDATA[--!strict
-- The growth curve. The ball's size is its volume; absorbing adds volume, diameter follows.
-- Early growth is boosted so a brand-new ball visibly swells within seconds, and the boost fades
-- smoothly so late growth stays steady rather than exploding.

local Tuning = require(script.Parent.Parent.Config.Tuning)
local MathUtil = require(script.Parent.Parent.Util.MathUtil)

local Growth = {}

export type Modifiers = {
	multiplier: number?, -- product of event/final roll/comeback/merge multipliers
}

function Growth.earlyBoost(diameter: number): number
	local g = Tuning.Growth
	return 1 + g.EarlyBoost * math.exp(-diameter / g.EarlyScale)
end

-- Volume (cubic studs) a prop contributes when absorbed, before ball-side multipliers.
function Growth.propVolume(baseVolume: number, scale: number): number
	return baseVolume * scale * scale * scale
end

-- Returns the ball's new diameter after absorbing `volume` of stuff.
function Growth.grow(diameter: number, volume: number, mods: Modifiers?): number
	local g = Tuning.Growth
	local mult = (mods and mods.multiplier) or 1
	local gained = volume * g.Gain * Growth.earlyBoost(diameter) * mult
	local newVolume = MathUtil.sphereVolume(diameter) + gained
	return math.min(MathUtil.diameterFromVolume(newVolume), Tuning.Ball.MaxDiameter)
end

-- Removes volume (knocked-off props, burst riders) without going below the start size.
function Growth.shrink(diameter: number, volume: number): number
	local newVolume = math.max(MathUtil.sphereVolume(diameter) - volume, MathUtil.sphereVolume(Tuning.Ball.StartDiameter))
	return MathUtil.diameterFromVolume(newVolume)
end

-- Diameter after absorbing another player's ball of diameter `otherDiameter`.
function Growth.absorbBall(diameter: number, otherDiameter: number, mods: Modifiers?): number
	local share = Tuning.Growth.PlayerVolumeShare
	local mult = (mods and mods.multiplier) or 1
	-- Player volume is not affected by the early boost; it is already a big, earned chunk.
	local newVolume = MathUtil.sphereVolume(diameter) + MathUtil.sphereVolume(otherDiameter) * share * mult
	return math.min(MathUtil.diameterFromVolume(newVolume), Tuning.Ball.MaxDiameter)
end

-- Combined diameter of two merged balls.
function Growth.merge(a: number, b: number): number
	return MathUtil.diameterFromVolume(MathUtil.sphereVolume(a) + MathUtil.sphereVolume(b))
end

-- Split a merged ball back into two by volume share (0..1 for the first ball).
function Growth.split(diameter: number, shareA: number): (number, number)
	local v = MathUtil.sphereVolume(diameter)
	local minV = MathUtil.sphereVolume(Tuning.Ball.StartDiameter)
	local va = math.max(v * shareA, minV)
	local vb = math.max(v * (1 - shareA), minV)
	return MathUtil.diameterFromVolume(va), MathUtil.diameterFromVolume(vb)
end

-- Max ground speed for a ball of diameter D.
function Growth.maxSpeed(diameter: number): number
	local b = Tuning.Ball
	return b.SpeedBase * (math.max(diameter, b.StartDiameter) / b.StartDiameter) ^ b.SpeedExponent
end

-- 0 at start size, 1 at HugeDiameter (log-scaled), used to interpolate "feel" parameters.
function Growth.sizeAlpha(diameter: number): number
	local b = Tuning.Ball
	return MathUtil.clamp01(math.log(math.max(diameter, b.StartDiameter) / b.StartDiameter) / math.log(b.HugeDiameter / b.StartDiameter))
end

function Growth.accelTime(diameter: number): number
	local b = Tuning.Ball
	return MathUtil.lerp(b.AccelTimeSmall, b.AccelTimeHuge, Growth.sizeAlpha(diameter))
end

function Growth.brakeTime(diameter: number): number
	local b = Tuning.Ball
	return MathUtil.lerp(b.BrakeTimeSmall, b.BrakeTimeHuge, Growth.sizeAlpha(diameter))
end

function Growth.hopHeight(diameter: number): number
	local b = Tuning.Ball
	return math.max(b.HopMin, diameter * b.HopPerDiameter)
end

-- Avatar scale so the Roller stays proportional to the ball.
function Growth.riderScale(diameter: number): number
	local b = Tuning.Ball
	-- A default avatar is ~5 studs tall at scale 1.
	return math.clamp(diameter * b.RiderHeightFraction / 5, b.RiderScaleMin, b.RiderScaleMax)
end

return Growth
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">MeshAssembly</string>
            <string name="Source"><![CDATA[--!strict
-- Turns a prop recipe into a handful of merged, smooth meshes (one per color/material group),
-- with automatic bevels on blocks and cylinders and baked "toy" shading (soft contact shadow at
-- the base, gentle sky light from above). Pure Luau: the client feeds the result into
-- EditableMesh, and the preview renderer draws exactly the same triangles.

local MeshKit = require(script.Parent.MeshKit)
local PropMetrics = require(script.Parent.PropMetrics)

export type Group = {
	key: string,
	color: string,
	material: string,
	transparency: number,
	reflectance: number,
	neon: boolean,
	tag: string?,
	pivot: { number }?, -- for animated groups: the source part's position (rotation pivot)
	verts: { number },
	norms: { number },
	uvs: { number },
	shade: { number }, -- per-vertex brightness multiplier (0..1)
	tris: { number },
}

local MeshAssembly = {}

-- Tags whose parts stay separate so critters / Nana can animate them.
local ANIMATED = { leg = true, wing = true, tail = true, head = true, arm = true, needle = true, yarn = true }

MeshAssembly.BevelFraction = 0.2
MeshAssembly.AoBase = 0.6

local function scaledCylinder(length: number, diameter: number, sharp: boolean, detail: number): any
	local r = diameter / 2
	local h = length / 2
	local seg = math.clamp(math.floor(diameter * 6 * detail), 8, 32)
	if sharp then
		return MeshKit.generate({ kind = "lathe", profile = { { 0, -h }, { r, -h }, { r, h }, { 0, h } }, seg = seg, smooth = 1 })
	end
	local b = math.min(r, h) * MeshAssembly.BevelFraction * 1.4
	return MeshKit.generate({
		kind = "lathe",
		profile = { { 0, -h }, { r - b, -h }, { r - b * 0.3, -h + b * 0.3 }, { r, -h + b }, { r, h - b }, { r - b * 0.3, h - b * 0.3 }, { r - b, h }, { 0, h } },
		seg = seg,
		smooth = 1,
	})
end

-- Flat-shaded prism matching Roblox's WedgePart (full height at +Z, slope facing -Z/+Y).
local function wedgeMesh(sx: number, sy: number, sz: number): any
	local x, y, z = sx / 2, sy / 2, sz / 2
	local faces = {
		{ { -x, -y, -z }, { x, -y, -z }, { x, -y, z }, { -x, -y, z } }, -- bottom
		{ { -x, -y, z }, { x, -y, z }, { x, y, z }, { -x, y, z } }, -- back
		{ { -x, -y, -z }, { -x, y, z }, { x, y, z }, { x, -y, -z } }, -- slope
	}
	local tri = {
		{ { -x, -y, -z }, { -x, -y, z }, { -x, y, z } }, -- left
		{ { x, -y, -z }, { x, y, z }, { x, -y, z } }, -- right
	}
	local m = { verts = {}, norms = {}, uvs = {}, tris = {} }
	local function addFace(points: { { number } })
		local a, b, c = points[1], points[2], points[3]
		local ux, uy, uz = b[1] - a[1], b[2] - a[2], b[3] - a[3]
		local wx, wy, wz = c[1] - a[1], c[2] - a[2], c[3] - a[3]
		local nx, ny, nz = uy * wz - uz * wy, uz * wx - ux * wz, ux * wy - uy * wx
		local len = math.sqrt(nx * nx + ny * ny + nz * nz)
		nx, ny, nz = nx / len, ny / len, nz / len
		-- Ensure outward normal (away from the prism centroid).
		local cx, cy, cz = 0, 0, 0
		for _, p in points do
			cx += p[1]
			cy += p[2]
			cz += p[3]
		end
		cx, cy, cz = cx / #points, cy / #points, cz / #points
		local flip = (nx * cx + ny * (cy + y / 3) + nz * (cz - z / 3)) < 0
		local base = #m.verts // 3
		for _, p in points do
			table.insert(m.verts, p[1])
			table.insert(m.verts, p[2])
			table.insert(m.verts, p[3])
			table.insert(m.norms, if flip then -nx else nx)
			table.insert(m.norms, if flip then -ny else ny)
			table.insert(m.norms, if flip then -nz else nz)
			table.insert(m.uvs, (p[1] + p[3]) / 4)
			table.insert(m.uvs, (p[2] + p[3]) / 4)
		end
		for k = 2, #points - 1 do
			if flip then
				table.insert(m.tris, base + 1)
				table.insert(m.tris, base + k + 1)
				table.insert(m.tris, base + k)
			else
				table.insert(m.tris, base + 1)
				table.insert(m.tris, base + k)
				table.insert(m.tris, base + k + 1)
			end
		end
	end
	for _, f in faces do
		addFace(f)
	end
	for _, f in tri do
		addFace(f)
	end
	return m
end

-- Detail level (0.3..1) from a prop's absorb size: crumbs get light meshes, landmarks get full detail.
function MeshAssembly.detailFor(absorbSize: number): number
	if absorbSize <= 1.5 then
		return 0.34
	elseif absorbSize <= 5 then
		return 0.5
	elseif absorbSize <= 15 then
		return 0.72
	elseif absorbSize <= 40 then
		return 0.88
	end
	return 1
end

local SEG_KEYS: { [string]: number } = { seg = 8, segU = 8, segV = 6, sides = 6 }

local function scaled(desc: any, detail: number): any
	if detail >= 0.999 then
		return desc
	end
	local copy: { [string]: any } = table.clone(desc)
	for key, minimum in SEG_KEYS do
		if copy[key] then
			copy[key] = math.max(minimum, math.floor(copy[key] * detail + 0.5))
		end
	end
	if copy.smooth and copy.smooth > 1 then
		copy.smooth = math.max(1, math.floor(copy.smooth * detail + 0.5))
	end
	return copy
end

-- Local-space mesh for one part spec (before the part's rotation/position are applied).
function MeshAssembly.localMesh(spec: any, detail: number?): (any, boolean)
	local size = spec.size
	local d = detail or 1
	if spec.shape == "Mesh" then
		return MeshKit.generate(scaled(spec.mesh, d)), false
	elseif spec.shape == "Ball" then
		local seg = math.clamp(math.floor(math.max(size[1], size[2], size[3]) * 5 * d), 8, 28)
		return MeshKit.generate({ kind = "ellipsoid", size = { size[1], size[2], size[3] }, segU = seg, segV = math.max(6, math.floor(seg * 0.66)) }), false
	elseif spec.shape == "Cylinder" then
		-- Roblox cylinders lie along X; the lathe is built along Y, so rotate Y -> X.
		return scaledCylinder(size[1], math.min(size[2], size[3]), spec.sharp or spec.neon, d), true
	elseif spec.shape == "Wedge" or spec.shape == "CornerWedge" then
		return wedgeMesh(size[1], size[2], size[3]), false
	end
	local minSide = math.min(size[1], size[2], size[3])
	local radius = if spec.sharp or minSide < 0.12 then minSide * 0.02 else math.clamp(minSide * MeshAssembly.BevelFraction, 0.02, 4)
	local arcSeg = if d < 0.45 then 1 elseif radius > 0.6 then 4 else if d < 0.8 then 2 else 3
	return MeshKit.generate({ kind = "rbox", size = { size[1], size[2], size[3] }, radius = radius, seg = arcSeg }), false
end

local function groupKey(spec: any, index: number): (string, string?)
	local tag = spec.tag
	local animated = tag and ANIMATED[tag]
	local key = table.concat({
		spec.color,
		spec.material or "SmoothPlastic",
		tostring(spec.transparency or 0),
		tostring(spec.reflectance or 0),
		if spec.neon then "N" else "",
		if animated then tag .. index else "",
	}, "|")
	return key, if animated then tag else nil
end

function MeshAssembly.assemble(parts: { any }, shade: boolean?, detail: number?): { Group }
	local groups: { [string]: Group } = {}
	local order: { string } = {}
	for index, spec in parts do
		if (spec.transparency or 0) >= 0.99 then
			continue
		end
		local mesh, yToX = MeshAssembly.localMesh(spec, detail)
		local key, tag = groupKey(spec, index)
		local g = groups[key]
		if not g then
			g = {
				key = key,
				color = spec.color,
				material = if spec.neon then "Neon" else (spec.material or "SmoothPlastic"),
				transparency = spec.transparency or 0,
				reflectance = spec.reflectance or 0,
				neon = spec.neon == true,
				tag = tag,
				pivot = if tag then { spec.pos[1], spec.pos[2], spec.pos[3] } else nil,
				verts = {},
				norms = {},
				uvs = {},
				shade = {},
				tris = {},
			}
			groups[key] = g
			table.insert(order, key)
		end
		local r = PropMetrics.partRotation(spec)
		local px, py, pz = spec.pos[1], spec.pos[2], spec.pos[3]
		local base = #g.verts // 3
		local v, n, uv = mesh.verts, mesh.norms, mesh.uvs
		for i = 1, #v, 3 do
			local x, y, z = v[i], v[i + 1], v[i + 2]
			local nx, ny, nz = n[i], n[i + 1], n[i + 2]
			if yToX then
				-- Rotate -90 degrees about Z: (x, y) -> (y, -x)
				x, y = y, -x
				nx, ny = ny, -nx
			end
			table.insert(g.verts, r[1] * x + r[2] * y + r[3] * z + px)
			table.insert(g.verts, r[4] * x + r[5] * y + r[6] * z + py)
			table.insert(g.verts, r[7] * x + r[8] * y + r[9] * z + pz)
			table.insert(g.norms, r[1] * nx + r[2] * ny + r[3] * nz)
			table.insert(g.norms, r[4] * nx + r[5] * ny + r[6] * nz)
			table.insert(g.norms, r[7] * nx + r[8] * ny + r[9] * nz)
		end
		for i = 1, #uv do
			table.insert(g.uvs, uv[i])
		end
		for _, t in mesh.tris do
			table.insert(g.tris, t + base)
		end
	end

	local list: { Group } = {}
	for _, key in order do
		table.insert(list, groups[key])
	end

	-- Baked shading: soft contact darkening near the ground + slightly darker downward faces.
	local minY, maxY = math.huge, -math.huge
	for _, g in list do
		for i = 2, #g.verts, 3 do
			minY = math.min(minY, g.verts[i])
			maxY = math.max(maxY, g.verts[i])
		end
	end
	local height = math.max(maxY - minY, 0.1)
	local band = math.max(height * 0.35, 0.4)
	for _, g in list do
		for i = 1, #g.verts, 3 do
			local s = 1
			if shade ~= false and not g.neon then
				local t = math.clamp((g.verts[i + 1] - minY) / band, 0, 1)
				t = t * t * (3 - 2 * t)
				local ao = MeshAssembly.AoBase + (1 - MeshAssembly.AoBase) * t
				local sky = 0.86 + 0.14 * math.clamp(g.norms[i + 1] * 0.5 + 0.5, 0, 1)
				s = ao * sky
			end
			table.insert(g.shade, s)
		end
	end
	return list
end

function MeshAssembly.triangleCount(groups: { Group }): number
	local n = 0
	for _, g in groups do
		n += #g.tris // 3
	end
	return n
end

return MeshAssembly
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">MeshKit</string>
            <string name="Source"><![CDATA[--!strict
-- Procedural mesh generation (pure Luau). Produces smooth triangle meshes from compact descriptors:
--   lathe    - a profile curve revolved around Y (mugs, fruit, bottles, pots, trunks, bodies)
--   rbox     - rounded box with real bevelled edges (appliances, furniture, blocks, books)
--   tube     - a radius-varying tube swept along a smoothed path (handles, tails, branches, bananas)
--   torus    - ring (donuts, rims, lifebuoys)
--   ellipsoid- smooth ellipsoid with optional lumpiness (foliage clumps, heads, bodies)
--   extrude  - a 2D outline extruded with a soft bevel (leaves, stars, cookies, signs)
-- The client turns results into EditableMesh-backed MeshParts; the preview renderer draws the
-- same triangles, so previews show exactly what the game builds.

export type Mesh = {
	verts: { number }, -- flat x,y,z
	norms: { number }, -- flat x,y,z (unit)
	uvs: { number }, -- flat u,v in "texture tiles" (1 unit = Tile studs) so Roblox materials map cleanly
	tris: { number }, -- flat 1-based vertex indices
	min: { number },
	max: { number },
}

-- Studs per texture tile for generated UVs.
local TILE = 4

export type Descriptor = { [string]: any }

local MeshKit = {}

local cache: { [string]: Mesh } = {}

-- Builder helpers -------------------------------------------------------------------------------

local function newMesh(): Mesh
	return { verts = {}, norms = {}, uvs = {}, tris = {}, min = { math.huge, math.huge, math.huge }, max = { -math.huge, -math.huge, -math.huge } }
end

local function addVert(m: Mesh, x: number, y: number, z: number, u: number?, v: number?): number
	local verts = m.verts
	verts[#verts + 1] = x
	verts[#verts + 1] = y
	verts[#verts + 1] = z
	local uv = m.uvs
	uv[#uv + 1] = (u or 0) / TILE
	uv[#uv + 1] = (v or 0) / TILE
	return #verts // 3
end

local function addTri(m: Mesh, a: number, b: number, c: number)
	if a == b or b == c or a == c then
		return
	end
	local t = m.tris
	t[#t + 1] = a
	t[#t + 1] = b
	t[#t + 1] = c
end

-- Smooth per-vertex normals from area-weighted face normals; also computes bounds.
local function finish(m: Mesh): Mesh
	local v, t = m.verts, m.tris
	local n = table.create(#v, 0)
	for i = 1, #t, 3 do
		local a, b, c = (t[i] - 1) * 3, (t[i + 1] - 1) * 3, (t[i + 2] - 1) * 3
		local ux, uy, uz = v[b + 1] - v[a + 1], v[b + 2] - v[a + 2], v[b + 3] - v[a + 3]
		local wx, wy, wz = v[c + 1] - v[a + 1], v[c + 2] - v[a + 2], v[c + 3] - v[a + 3]
		local nx, ny, nz = uy * wz - uz * wy, uz * wx - ux * wz, ux * wy - uy * wx
		for _, o in { a, b, c } do
			n[o + 1] += nx
			n[o + 2] += ny
			n[o + 3] += nz
		end
	end
	-- Weld normals of coincident vertices (UV seams, rounded-box face borders) so shading is
	-- seamless while UVs stay continuous.
	local groups: { [string]: { number } } = {}
	for i = 1, #v, 3 do
		local key = string.format("%.3f,%.3f,%.3f", v[i], v[i + 1], v[i + 2])
		local g = groups[key]
		if g then
			table.insert(g, i)
		else
			groups[key] = { i }
		end
	end
	for _, g in groups do
		if #g > 1 then
			local sx, sy, sz = 0, 0, 0
			for _, i in g do
				sx += n[i]
				sy += n[i + 1]
				sz += n[i + 2]
			end
			for _, i in g do
				n[i], n[i + 1], n[i + 2] = sx, sy, sz
			end
		end
	end
	for i = 1, #n, 3 do
		local len = math.sqrt(n[i] * n[i] + n[i + 1] * n[i + 1] + n[i + 2] * n[i + 2])
		if len > 1e-9 then
			n[i], n[i + 1], n[i + 2] = n[i] / len, n[i + 1] / len, n[i + 2] / len
		else
			n[i], n[i + 1], n[i + 2] = 0, 1, 0
		end
		m.min[1] = math.min(m.min[1], v[i])
		m.min[2] = math.min(m.min[2], v[i + 1])
		m.min[3] = math.min(m.min[3], v[i + 2])
		m.max[1] = math.max(m.max[1], v[i])
		m.max[2] = math.max(m.max[2], v[i + 1])
		m.max[3] = math.max(m.max[3], v[i + 2])
	end
	m.norms = n
	return m
end

-- Catmull-Rom subdivision of a polyline of tuples (any dimension) for smooth organic curves.
local function smoothCurve(points: { { number } }, steps: number): { { number } }
	if steps <= 1 or #points < 3 then
		return points
	end
	local out = {}
	local count = #points
	local dims = #points[1]
	for i = 1, count - 1 do
		local p0 = points[math.max(i - 1, 1)]
		local p1 = points[i]
		local p2 = points[i + 1]
		local p3 = points[math.min(i + 2, count)]
		for s = 0, steps - 1 do
			local t = s / steps
			local t2, t3 = t * t, t * t * t
			local q = table.create(dims)
			for d = 1, dims do
				q[d] = 0.5 * ((2 * p1[d]) + (-p0[d] + p2[d]) * t + (2 * p0[d] - 5 * p1[d] + 4 * p2[d] - p3[d]) * t2 + (-p0[d] + 3 * p1[d] - 3 * p2[d] + p3[d]) * t3)
			end
			table.insert(out, q)
		end
	end
	table.insert(out, points[count])
	return out
end

MeshKit.smoothCurve = smoothCurve

-- Generators ------------------------------------------------------------------------------------

-- profile: { {radius, y}, ... } from bottom to top. Endpoints with radius 0 close the shape.
-- Options: seg (radial segments), smooth (curve subdivision), lobes/lobeDepth (radial ridges),
-- twist (radians over height), squash {x, z} (oval cross-section).
local function lathe(d: Descriptor): Mesh
	local m = newMesh()
	local seg = d.seg or 24
	local profile = smoothCurve(d.profile, d.smooth or 1)
	local lobes, lobeDepth = d.lobes or 0, d.lobeDepth or 0
	local twist = d.twist or 0
	local sx, sz = 1, 1
	if d.squash then
		sx, sz = d.squash[1], d.squash[2]
	end
	local minY, maxY = math.huge, -math.huge
	for _, p in profile do
		minY = math.min(minY, p[2])
		maxY = math.max(maxY, p[2])
	end
	local rings = {}
	local arc = 0
	local maxR = 0
	for _, p in profile do
		maxR = math.max(maxR, p[1])
	end
	for i, p in profile do
		local r, y = math.max(p[1], 0), p[2]
		if i > 1 then
			local q = profile[i - 1]
			arc += math.sqrt((p[1] - q[1]) ^ 2 + (p[2] - q[2]) ^ 2)
		end
		local ring = {}
		local tNorm = if maxY > minY then (y - minY) / (maxY - minY) else 0
		for j = 0, seg do
			local a = j / seg * math.pi * 2 + twist * tNorm
			local rr = r
			if lobes > 0 and r > 1e-6 then
				rr = r * (1 - lobeDepth * (0.5 - 0.5 * math.cos(a * lobes)))
			end
			ring[j] = addVert(m, math.cos(a) * rr * sx, y, math.sin(a) * rr * sz, j / seg * math.pi * 2 * maxR, arc)
		end
		rings[i] = ring
	end
	for i = 1, #rings - 1 do
		local r0, r1 = rings[i], rings[i + 1]
		for j = 0, seg - 1 do
			-- Counter-clockwise when viewed from outside (normals point outward).
			addTri(m, r0[j], r1[j], r1[j + 1])
			addTri(m, r0[j], r1[j + 1], r0[j + 1])
		end
	end
	return finish(m)
end

-- Rounded box: size {x,y,z}, radius r, seg = arc segments per rounded edge.
local function rbox(d: Descriptor): Mesh
	local m = newMesh()
	local hx, hy, hz = d.size[1] / 2, d.size[2] / 2, d.size[3] / 2
	local r = math.min(d.radius or 0.2, hx, hy, hz)
	local seg = d.seg or 4
	local function coords(h: number): { number }
		local list = {}
		local inner = h - r
		for k = 0, seg do
			local a = (1 - k / seg) * math.pi / 2
			table.insert(list, -inner - math.sin(a) * r)
		end
		if inner > 1e-4 then
			for k = 0, seg do
				local a = k / seg * math.pi / 2
				table.insert(list, inner + math.sin(a) * r)
			end
		else
			for k = 1, seg do
				local a = k / seg * math.pi / 2
				table.insert(list, inner + math.sin(a) * r)
			end
		end
		return list
	end
	local cx, cy, cz = coords(hx), coords(hy), coords(hz)
	local ix, iy, iz = hx - r, hy - r, hz - r
	local function project(x: number, y: number, z: number): (number, number, number)
		local qx = math.clamp(x, -ix, ix)
		local qy = math.clamp(y, -iy, iy)
		local qz = math.clamp(z, -iz, iz)
		local dx, dy, dz = x - qx, y - qy, z - qz
		local len = math.sqrt(dx * dx + dy * dy + dz * dz)
		if len < 1e-6 then
			return x, y, z
		end
		return qx + dx / len * r, qy + dy / len * r, qz + dz / len * r
	end
	-- Each face: grid over two axes at fixed third coordinate.
	local function face(us: { number }, vs: { number }, map: (number, number) -> (number, number, number), flip: boolean)
		local idx = {}
		for i, u in us do
			idx[i] = {}
			for j, v in vs do
				local x, y, z = map(u, v)
				x, y, z = project(x, y, z)
				idx[i][j] = addVert(m, x, y, z, u, v)
			end
		end
		for i = 1, #us - 1 do
			for j = 1, #vs - 1 do
				local a, b, c, e = idx[i][j], idx[i + 1][j], idx[i + 1][j + 1], idx[i][j + 1]
				if flip then
					addTri(m, a, c, b)
					addTri(m, a, e, c)
				else
					addTri(m, a, b, c)
					addTri(m, a, c, e)
				end
			end
		end
	end
	face(cy, cz, function(u, v) return hx, u, v end, false)
	face(cy, cz, function(u, v) return -hx, u, v end, true)
	face(cz, cx, function(u, v) return v, hy, u end, false)
	face(cz, cx, function(u, v) return v, -hy, u end, true)
	face(cx, cy, function(u, v) return u, v, hz end, false)
	face(cx, cy, function(u, v) return u, v, -hz end, true)
	return finish(m)
end

-- Parallel-transport frame sweep of a circle along a smoothed path.
-- path: { {x,y,z}, ... }; radius: number or per-point list; sides; caps = "round" | "flat" | nil.
local function tube(d: Descriptor): Mesh
	local m = newMesh()
	local raw = {}
	for i, p in d.path do
		local r = if type(d.radius) == "table" then d.radius[i] else d.radius
		raw[i] = { p[1], p[2], p[3], r }
	end
	local pts = smoothCurve(raw, d.smooth or 4)
	local sides = d.sides or 12
	local n = #pts
	-- Tangents.
	local tangents = {}
	for i = 1, n do
		local a = pts[math.max(i - 1, 1)]
		local b = pts[math.min(i + 1, n)]
		local tx, ty, tz = b[1] - a[1], b[2] - a[2], b[3] - a[3]
		local len = math.sqrt(tx * tx + ty * ty + tz * tz)
		if len < 1e-9 then
			tangents[i] = { 0, 1, 0 }
		else
			tangents[i] = { tx / len, ty / len, tz / len }
		end
	end
	-- Initial normal perpendicular to the first tangent.
	local t0 = tangents[1]
	local ref = if math.abs(t0[2]) < 0.9 then { 0, 1, 0 } else { 1, 0, 0 }
	local function cross(a: { number }, b: { number }): { number }
		return { a[2] * b[3] - a[3] * b[2], a[3] * b[1] - a[1] * b[3], a[1] * b[2] - a[2] * b[1] }
	end
	local function norm(a: { number }): { number }
		local l = math.sqrt(a[1] * a[1] + a[2] * a[2] + a[3] * a[3])
		if l < 1e-9 then
			return { 1, 0, 0 }
		end
		return { a[1] / l, a[2] / l, a[3] / l }
	end
	local normal = norm(cross(t0, ref))
	local rings = {}
	local along = 0
	for i = 1, n do
		local t = tangents[i]
		-- Re-orthogonalise the carried normal against the new tangent (parallel transport).
		local dot = normal[1] * t[1] + normal[2] * t[2] + normal[3] * t[3]
		normal = norm({ normal[1] - t[1] * dot, normal[2] - t[2] * dot, normal[3] - t[3] * dot })
		local binormal = cross(t, normal)
		local p = pts[i]
		if i > 1 then
			local q = pts[i - 1]
			along += math.sqrt((p[1] - q[1]) ^ 2 + (p[2] - q[2]) ^ 2 + (p[3] - q[3]) ^ 2)
		end
		local r = math.max(p[4], 0.001)
		local ring = {}
		for j = 0, sides do
			local a = j / sides * math.pi * 2
			local c, s = math.cos(a), math.sin(a)
			ring[j] = addVert(
				m,
				p[1] + (normal[1] * c + binormal[1] * s) * r,
				p[2] + (normal[2] * c + binormal[2] * s) * r,
				p[3] + (normal[3] * c + binormal[3] * s) * r,
				j / sides * math.pi * 2 * r,
				along
			)
		end
		rings[i] = ring
	end
	for i = 1, n - 1 do
		local r0, r1 = rings[i], rings[i + 1]
		for j = 0, sides - 1 do
			addTri(m, r0[j], r0[j + 1], r1[j + 1])
			addTri(m, r0[j], r1[j + 1], r1[j])
		end
	end
	local caps = d.caps or "round"
	local function cap(i: number, dir: number)
		local p = pts[i]
		local t = tangents[i]
		local depth = if caps == "round" then p[4] * 0.9 else 0
		local tip = addVert(m, p[1] + t[1] * depth * dir, p[2] + t[2] * depth * dir, p[3] + t[3] * depth * dir)
		local ring = rings[i]
		for j = 0, sides - 1 do
			local j1 = j + 1
			if dir > 0 then
				addTri(m, ring[j], ring[j1], tip)
			else
				addTri(m, ring[j1], ring[j], tip)
			end
		end
	end
	if caps ~= "none" then
		cap(1, -1)
		cap(n, 1)
	end
	return finish(m)
end

local function torus(d: Descriptor): Mesh
	local m = newMesh()
	local R, r = d.major, d.minor
	local su, sv = d.segU or 28, d.segV or 14
	local arc = d.arc or math.pi * 2
	local closed = arc >= math.pi * 2 - 1e-6
	local idx = {}
	for i = 0, su do
		local u = i / su * arc
		idx[i] = {}
		for j = 0, sv do
			local v = j / sv * math.pi * 2
			local rr = R + r * math.cos(v)
			-- Optional flattening (squash) for frosting-like shapes.
			local y = r * math.sin(v) * (d.flatten or 1)
			idx[i][j] = addVert(m, math.cos(u) * rr, y, math.sin(u) * rr, u * R, v * r)
		end
	end
	for i = 0, su - 1 do
		for j = 0, sv - 1 do
			addTri(m, idx[i][j], idx[i][j + 1], idx[i + 1][j + 1])
			addTri(m, idx[i][j], idx[i + 1][j + 1], idx[i + 1][j])
		end
	end
	local _ = closed
	return finish(m)
end

-- Deterministic value noise on the sphere for organic lumps (foliage, rocks, bread).
local function hashNoise(x: number, y: number, z: number, seed: number): number
	local s = math.sin(x * 12.9898 + y * 78.233 + z * 37.719 + seed * 4.1414) * 43758.5453
	return s - math.floor(s)
end

local function ellipsoid(d: Descriptor): Mesh
	local m = newMesh()
	local sx, sy, sz = d.size[1] / 2, d.size[2] / 2, d.size[3] / 2
	local segU, segV = d.segU or 24, d.segV or 16
	local lump, seed = d.lump or 0, d.seed or 1
	local flatBottom = d.flatBottom
	local circumference = math.pi * (sx + sz)
	local rows = {}
	for i = 0, segV do
		local v = i / segV * math.pi
		local row = {}
		for j = 0, segU do
			local u = j / segU * math.pi * 2
			local nx, ny, nz = math.sin(v) * math.cos(u), math.cos(v), math.sin(v) * math.sin(u)
			local k = 1
			if lump > 0 and i > 0 and i < segV then
				-- Low-frequency lumps: blend a few hashed bumps for a cloud/foliage silhouette.
				local f = 0
				for o = 1, 3 do
					local scale = o * 1.7
					f += (hashNoise(math.floor(nx * scale * 2), math.floor(ny * scale * 2), math.floor(nz * scale * 2), seed + o) - 0.5) / o
				end
				k = 1 + lump * f + lump * 0.25 * math.sin(u * 5 + seed) * math.sin(v * 4)
			end
			local y = ny * sy * k
			if flatBottom and y < -sy * flatBottom then
				y = -sy * flatBottom
			end
			row[j] = addVert(m, nx * sx * k, y, nz * sz * k, j / segU * circumference, i / segV * math.pi * sy)
		end
		rows[i] = row
	end
	for i = 0, segV - 1 do
		for j = 0, segU - 1 do
			addTri(m, rows[i][j], rows[i][j + 1], rows[i + 1][j + 1])
			addTri(m, rows[i][j], rows[i + 1][j + 1], rows[i + 1][j])
		end
	end
	return finish(m)
end

-- Ear-clipping triangulation for a simple polygon given as {{x, z}, ...} (CCW or CW).
local function triangulate(poly: { { number } }): { { number } }
	local n = #poly
	local idx = {}
	local area = 0
	for i = 1, n do
		local a, b = poly[i], poly[i % n + 1]
		area += a[1] * b[2] - b[1] * a[2]
		idx[i] = i
	end
	local ccw = area > 0
	local function isEar(i0: number, i1: number, i2: number, list: { number }): boolean
		local a, b, c = poly[i0], poly[i1], poly[i2]
		local cr = (b[1] - a[1]) * (c[2] - a[2]) - (b[2] - a[2]) * (c[1] - a[1])
		if (cr > 0) ~= ccw or math.abs(cr) < 1e-12 then
			return false
		end
		for _, k in list do
			if k ~= i0 and k ~= i1 and k ~= i2 then
				local p = poly[k]
				local d1 = (b[1] - a[1]) * (p[2] - a[2]) - (b[2] - a[2]) * (p[1] - a[1])
				local d2 = (c[1] - b[1]) * (p[2] - b[2]) - (c[2] - b[2]) * (p[1] - b[1])
				local d3 = (a[1] - c[1]) * (p[2] - c[2]) - (a[2] - c[2]) * (p[1] - c[1])
				if ccw then
					if d1 >= 0 and d2 >= 0 and d3 >= 0 then
						return false
					end
				elseif d1 <= 0 and d2 <= 0 and d3 <= 0 then
					return false
				end
			end
		end
		return true
	end
	local out = {}
	local guard = 0
	while #idx > 3 and guard < 10000 do
		guard += 1
		local clipped = false
		for i = 1, #idx do
			local i0, i1, i2 = idx[(i - 2) % #idx + 1], idx[i], idx[i % #idx + 1]
			if isEar(i0, i1, i2, idx) then
				table.insert(out, if ccw then { i0, i1, i2 } else { i0, i2, i1 })
				table.remove(idx, i)
				clipped = true
				break
			end
		end
		if not clipped then
			break
		end
	end
	if #idx == 3 then
		table.insert(out, if ccw then { idx[1], idx[2], idx[3] } else { idx[1], idx[3], idx[2] })
	end
	return out
end

-- Extrude a 2D outline (in XZ) upward by `height`, with a soft inset bevel on top and bottom.
local function extrude(d: Descriptor): Mesh
	local m = newMesh()
	local outline = d.outline
	if d.smooth and d.smooth > 1 then
		local closed = table.clone(outline)
		table.insert(closed, outline[1])
		table.insert(closed, outline[2])
		local sm = smoothCurve(closed, d.smooth)
		outline = {}
		for i = 1, #sm - d.smooth - 1 do
			table.insert(outline, sm[i])
		end
	end
	local h = d.height
	local bevel = math.min(d.bevel or h * 0.3, h * 0.45)
	local inset = d.inset or bevel
	local n = #outline
	-- Centroid for inset direction.
	local cx, cz = 0, 0
	for _, p in outline do
		cx += p[1]
		cz += p[2]
	end
	cx, cz = cx / n, cz / n
	local function ringAt(y: number, shrink: number): { number }
		local ring = {}
		for i, p in outline do
			local dx, dz = p[1] - cx, p[2] - cz
			local len = math.sqrt(dx * dx + dz * dz)
			local k = if len > 1e-6 then math.max(len - shrink, len * 0.2) / len else 1
			local x, z = cx + dx * k, cz + dz * k
			ring[i] = addVert(m, x, y, z, x + y * 0.5, z)
		end
		return ring
	end
	local levels = {
		ringAt(0, inset),
		ringAt(bevel, 0),
		ringAt(h - bevel, 0),
		ringAt(h, inset),
	}
	for l = 1, #levels - 1 do
		local r0, r1 = levels[l], levels[l + 1]
		for i = 1, n do
			local i1 = i % n + 1
			addTri(m, r0[i], r0[i1], r1[i1])
			addTri(m, r0[i], r1[i1], r1[i])
		end
	end
	local tris = triangulate(outline)
	for _, t in tris do
		addTri(m, levels[4][t[1]], levels[4][t[3]], levels[4][t[2]])
		addTri(m, levels[1][t[1]], levels[1][t[2]], levels[1][t[3]])
	end
	local mesh = finish(m)
	-- Orientation of the outline decides winding; ensure normals face out by checking the top.
	return mesh
end

local generators: { [string]: (Descriptor) -> Mesh } = {
	lathe = lathe,
	rbox = rbox,
	tube = tube,
	torus = torus,
	ellipsoid = ellipsoid,
	extrude = extrude,
}

-- Stable cache key from a descriptor (descriptors are plain data).
local function keyOf(value: any): string
	local t = type(value)
	if t == "table" then
		local keys = {}
		for k in value do
			table.insert(keys, k)
		end
		table.sort(keys, function(a, b)
			return tostring(a) < tostring(b)
		end)
		local parts = {}
		for _, k in keys do
			table.insert(parts, tostring(k) .. "=" .. keyOf(value[k]))
		end
		return "{" .. table.concat(parts, ",") .. "}"
	elseif t == "number" then
		return string.format("%.4g", value)
	end
	return tostring(value)
end

MeshKit.keyOf = keyOf

function MeshKit.generate(d: Descriptor): Mesh
	local key = keyOf(d)
	local existing = cache[key]
	if existing then
		return existing
	end
	local gen = generators[d.kind]
	assert(gen, "unknown mesh kind " .. tostring(d.kind))
	local mesh = gen(d)
	cache[key] = mesh
	return mesh
end

function MeshKit.triangleCount(m: Mesh): number
	return #m.tris // 3
end

return MeshKit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">PropLibrary</string>
            <string name="Source"><![CDATA[--!strict
-- Global registry of every prop across every World Kit, keyed by permanent uid and by "kit:id".
-- Computes metrics once at load and normalises recipes so every prop's lowest point sits at y = 0.

local Kits = require(script.Parent.Parent.Data.Kits)
local PropMetrics = require(script.Parent.PropMetrics)
local Rarity = require(script.Parent.Parent.Config.Rarity)

export type PropDef = {
	uid: number,
	id: string,
	kitId: string,
	name: string,
	rarity: string,
	tags: { string },
	tagSet: { [string]: boolean },
	hint: string,
	parts: { any },
	variants: { string }?,
	weight: number,
	critter: any?,
	landmark: boolean,
	fill: number,
	metrics: PropMetrics.Metrics,
}

local PropLibrary = {}

PropLibrary.ByUid = {} :: { [number]: PropDef }
PropLibrary.ByKey = {} :: { [string]: PropDef }
PropLibrary.ByKit = {} :: { [string]: { PropDef } }
PropLibrary.All = {} :: { PropDef }
PropLibrary.MaxUid = 0

local function register(kit: any, raw: any)
	assert(type(raw.uid) == "number" and raw.uid > 0 and raw.uid < 4096, "bad uid on " .. tostring(raw.id))
	assert(PropLibrary.ByUid[raw.uid] == nil, "duplicate prop uid " .. raw.uid)
	for i, part in raw.parts do
		assert(type(part.color) == "string" and part.color:match("^#%x%x%x%x%x%x$"), string.format("prop %s part %d has an invalid color", tostring(raw.id), i))
	end
	local metrics = PropMetrics.compute(raw.parts, raw.fill)
	local parts = raw.parts
	if math.abs(metrics.minY) > 1e-3 then
		-- Shift recipe so the prop rests on the ground.
		local shift = -metrics.minY
		local shifted = table.create(#parts)
		for i, p in parts do
			local copy = table.clone(p)
			copy.pos = { p.pos[1], p.pos[2] + shift, p.pos[3] }
			shifted[i] = copy
		end
		parts = shifted
		metrics.centerY += shift
		metrics.minY = 0
	end
	local tagSet = {}
	for _, tag in raw.tags do
		tagSet[tag] = true
	end
	if raw.critter then
		tagSet.critter = true
	end
	local def: PropDef = {
		uid = raw.uid,
		id = raw.id,
		kitId = kit.id,
		name = raw.name,
		rarity = raw.rarity,
		tags = raw.tags,
		tagSet = tagSet,
		hint = raw.hint or "",
		parts = parts,
		variants = raw.variants,
		weight = raw.weight or 1,
		critter = raw.critter,
		landmark = raw.landmark == true,
		fill = raw.fill or 1,
		metrics = metrics,
	}
	assert(Rarity.Defs[def.rarity :: any], "bad rarity on " .. def.id)
	PropLibrary.ByUid[def.uid] = def
	PropLibrary.ByKey[kit.id .. ":" .. def.id] = def
	table.insert(PropLibrary.ByKit[kit.id], def)
	table.insert(PropLibrary.All, def)
	PropLibrary.MaxUid = math.max(PropLibrary.MaxUid, def.uid)
end

for _, kit in Kits.List do
	PropLibrary.ByKit[kit.id] = {}
	for _, raw in kit.props do
		register(kit, raw)
	end
end

table.sort(PropLibrary.All, function(a, b)
	return a.uid < b.uid
end)

function PropLibrary.get(uid: number): PropDef?
	return PropLibrary.ByUid[uid]
end

function PropLibrary.find(kitId: string, id: string): PropDef?
	return PropLibrary.ByKey[kitId .. ":" .. id]
end

-- Variant color for a placed prop instance (deterministic from its instance id).
function PropLibrary.variantColor(def: PropDef, instanceId: number): string?
	local variants = def.variants
	if not variants or #variants == 0 then
		return nil
	end
	return variants[(instanceId % #variants) + 1]
end

return PropLibrary
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">PropMetrics</string>
            <string name="Source"><![CDATA[--!strict
-- Derives gameplay metrics (bounding box, absorb size, volume, contact radius) from a prop recipe.
-- Pure math so it runs in tests and identically on server and client.

local PropMetrics = {}

export type Metrics = {
	sx: number,
	sy: number,
	sz: number,
	minY: number,
	centerY: number,
	absorbSize: number,
	volume: number,
	contactRadius: number,
	footprint: number, -- radius of the prop's XZ footprint (for placement spacing)
	mainColor: string,
}

-- 3x3 rotation matrix for CFrame.fromEulerAnglesYXZ(rx, ry, rz) = Ry * Rx * Rz (radians).
local function rotationYXZ(rx: number, ry: number, rz: number): { number }
	local cx, sx = math.cos(rx), math.sin(rx)
	local cy, sy = math.cos(ry), math.sin(ry)
	local cz, sz = math.cos(rz), math.sin(rz)
	-- Ry
	local ry11, ry13, ry31, ry33 = cy, sy, -sy, cy
	-- Rx * Rz
	local a11, a12, a13 = cz, -sz, 0
	local a21, a22, a23 = cx * sz, cx * cz, -sx
	local a31, a32, a33 = sx * sz, sx * cz, cx
	-- Ry * (Rx * Rz)
	return {
		ry11 * a11 + ry13 * a31, ry11 * a12 + ry13 * a32, ry11 * a13 + ry13 * a33,
		a21, a22, a23,
		ry31 * a11 + ry33 * a31, ry31 * a12 + ry33 * a32, ry31 * a13 + ry33 * a33,
	}
end

local function mul(a: { number }, b: { number }): { number }
	local out = table.create(9, 0)
	for r = 0, 2 do
		for c = 0, 2 do
			local s = 0
			for k = 0, 2 do
				s += a[r * 3 + k + 1] * b[k * 3 + c + 1]
			end
			out[r * 3 + c + 1] = s
		end
	end
	return out
end

-- Rotation that maps a cylinder's native X axis onto +Y (roll 90 degrees about Z).
local UPRIGHT = rotationYXZ(0, 0, math.pi / 2)

function PropMetrics.partRotation(part: any): { number }
	local rot = part.rot
	local m = if rot then rotationYXZ(math.rad(rot[1]), math.rad(rot[2]), math.rad(rot[3])) else rotationYXZ(0, 0, 0)
	if part.upright then
		m = mul(m, UPRIGHT)
	end
	return m
end

-- Half extents of the axis-aligned bounds of a rotated box.
local function rotatedHalfExtents(m: { number }, hx: number, hy: number, hz: number): (number, number, number)
	return math.abs(m[1]) * hx + math.abs(m[2]) * hy + math.abs(m[3]) * hz,
		math.abs(m[4]) * hx + math.abs(m[5]) * hy + math.abs(m[6]) * hz,
		math.abs(m[7]) * hx + math.abs(m[8]) * hy + math.abs(m[9]) * hz
end

function PropMetrics.compute(parts: { any }, fill: number?): Metrics
	assert(#parts > 0, "prop recipe has no parts")
	local minX, minY, minZ = math.huge, math.huge, math.huge
	local maxX, maxY, maxZ = -math.huge, -math.huge, -math.huge
	local bestVolume, mainColor = -1, "#ffffff"
	local solid = 0
	for _, part in parts do
		local m = PropMetrics.partRotation(part)
		local hx, hy, hz = part.size[1] / 2, part.size[2] / 2, part.size[3] / 2
		if part.shape == "Ball" and part.size[1] == part.size[2] and part.size[2] == part.size[3] then
			-- Spheres are rotation invariant.
			hx, hy, hz = hx, hx, hx
		end
		local ex, ey, ez = rotatedHalfExtents(m, hx, hy, hz)
		local px, py, pz = part.pos[1], part.pos[2], part.pos[3]
		if part.meshCenter then
			-- Mesh parts are placed by their own origin; their bounds are offset from it.
			local c = part.meshCenter
			px += m[1] * c[1] + m[2] * c[2] + m[3] * c[3]
			py += m[4] * c[1] + m[5] * c[2] + m[6] * c[3]
			pz += m[7] * c[1] + m[8] * c[2] + m[9] * c[3]
		end
		minX, maxX = math.min(minX, px - ex), math.max(maxX, px + ex)
		minY, maxY = math.min(minY, py - ey), math.max(maxY, py + ey)
		minZ, maxZ = math.min(minZ, pz - ez), math.max(maxZ, pz + ez)
		local v = part.size[1] * part.size[2] * part.size[3]
		-- Real (approximate) solid volume of the shape, not its bounding box.
		local factor = 1
		if part.shape == "Ball" then
			factor = math.pi / 6
		elseif part.shape == "Cylinder" then
			factor = math.pi / 4
		elseif part.shape == "Wedge" or part.shape == "CornerWedge" then
			factor = 0.5
		elseif part.shape == "Mesh" then
			factor = 0.55
		end
		if (part.transparency or 0) < 0.9 then
			solid += v * factor
		end
		if v > bestVolume and not part.neon and part.tag ~= "eye" then
			bestVolume = v
			mainColor = part.color
		end
	end
	local sx, sy, sz = maxX - minX, maxY - minY, maxZ - minZ
	local dims = { sx, sy, sz }
	table.sort(dims, function(a, b)
		return a > b
	end)
	local absorbSize = dims[1] * 0.6 + dims[2] * 0.4
	local f = fill or 1
	local halfDiag = 0.5 * math.sqrt(sx * sx + sy * sy + sz * sz)
	return {
		sx = sx,
		sy = sy,
		sz = sz,
		minY = minY,
		centerY = (minY + maxY) / 2,
		absorbSize = absorbSize,
		-- Overlapping parts double count, so never exceed 70% of the bounding box.
		volume = math.min(solid, sx * sy * sz * 0.7) * f,
		-- Fuzzy contact sphere: between the inscribed and circumscribed radius.
		contactRadius = (halfDiag + dims[2] / 2) / 2,
		footprint = 0.5 * math.sqrt(sx * sx + sz * sz),
		mainColor = mainColor,
	}
end

return PropMetrics
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">Rewards</string>
            <string name="Source"><![CDATA[--!strict
-- Stardust reward math for one player's round. Pure so the economy can be unit tested and tuned.

local Tuning = require(script.Parent.Parent.Config.Tuning)

export type RoundInput = {
	finalDiameter: number,
	cmPerStud: number,
	discoveries: number, -- brand-new Rolledex entries this round
	newVariants: number, -- new mutation variants this round
	playersRolled: number,
	awards: number,
	rarityPoints: number, -- sum of RarityBonus over everything absorbed
	friendsInServer: number,
	vip: boolean,
	doubleStardust: boolean,
	eventMultiplier: number?,
}

export type Breakdown = {
	size: number,
	discoveries: number,
	players: number,
	awards: number,
	rarity: number,
	participation: number,
	base: number,
	multiplier: number,
	total: number,
}

local Rewards = {}

function Rewards.round(input: RoundInput): Breakdown
	local r = Tuning.Rewards
	local meters = input.finalDiameter * input.cmPerStud / 100
	local size = math.floor(meters * r.StardustPerMeterGrown + 0.5)
	local discoveries = input.discoveries * r.StardustPerDiscovery + input.newVariants * r.StardustPerNewVariant
	local players = input.playersRolled * r.StardustPerPlayerRolled
	local awards = input.awards * r.StardustPerAward
	local rarity = math.floor(input.rarityPoints)
	local participation = r.StardustParticipation
	local base = size + discoveries + players + awards + rarity + participation

	local multiplier = 1
	multiplier += math.min(input.friendsInServer * r.FriendBonusPerFriend, r.FriendBonusMax)
	if input.vip then
		multiplier += r.VipBonus
	end
	multiplier *= input.eventMultiplier or 1
	if input.doubleStardust then
		multiplier *= r.DoubleStardustPassMultiplier
	end
	local total = math.min(math.floor(base * multiplier + 0.5), r.RoundStardustCap)
	return {
		size = size,
		discoveries = discoveries,
		players = players,
		awards = awards,
		rarity = rarity,
		participation = participation,
		base = base,
		multiplier = multiplier,
		total = total,
	}
end

return Rewards
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">WorldGen</string>
            <string name="Source"><![CDATA[--!strict
-- Seeded world generation from a World Kit. Pure Luau (no Roblox types) so the same seed always
-- produces the same map and it can be tested headless.
--
-- Output: static geometry (floor, walls, platforms, ramps) the server builds as anchored parts,
-- plus a compact prop list the server sends to clients (clients build the visuals).

local Rng = require(script.Parent.Parent.Util.Rng)
local SpatialHash = require(script.Parent.Parent.Util.SpatialHash)
local PropLibrary = require(script.Parent.PropLibrary)
local Rarity = require(script.Parent.Parent.Config.Rarity)
local Mutations = require(script.Parent.Parent.Data.Mutations)

export type Geometry = {
	shape: string, -- "Block" | "Wedge" | "Cylinder"
	size: { number },
	pos: { number },
	yaw: number, -- degrees
	color: string,
	material: string,
	collide: boolean,
	transparency: number?,
	kind: string,
}

export type Placed = {
	id: number,
	uid: number,
	x: number,
	y: number,
	z: number,
	yaw: number, -- radians
	scale: number,
	mutation: number,
}

export type Platform = {
	id: string,
	kind: string,
	x: number,
	z: number,
	sx: number,
	sz: number,
	height: number,
	spawn: boolean,
}

export type Result = {
	kitId: string,
	seed: number,
	arenaHalf: number,
	geometry: { Geometry },
	props: { Placed },
	platforms: { Platform },
	spawns: { { number } },
	spawnCenter: { number },
	landmarkId: number,
	stats: { [string]: number },
}

local WorldGen = {}

local WALL_THICK = 40
local EDGE_MARGIN = 50

local function geo(out: { Geometry }, kind: string, shape: string, sx: number, sy: number, sz: number, x: number, y: number, z: number, yaw: number, color: string, material: string, collide: boolean, transparency: number?)
	table.insert(out, {
		shape = shape,
		size = { sx, sy, sz },
		pos = { x, y, z },
		yaw = yaw,
		color = color,
		material = material,
		collide = collide,
		transparency = transparency,
		kind = kind,
	})
end

local function insideRect(p: Platform, x: number, z: number, margin: number): boolean
	return math.abs(x - p.x) <= p.sx / 2 - margin and math.abs(z - p.z) <= p.sz / 2 - margin
end

local function rectsOverlap(a: Platform, x: number, z: number, sx: number, sz: number, margin: number): boolean
	return math.abs(a.x - x) < (a.sx + sx) / 2 + margin and math.abs(a.z - z) < (a.sz + sz) / 2 + margin
end

-- Floor + walls --------------------------------------------------------------------------------

local function buildArena(kit: any, out: { Geometry })
	local H = kit.arenaHalf
	local floor = kit.floor
	local full = H * 2 + WALL_THICK * 2
	geo(out, "floor", "Block", full, 20, full, 0, -10, 0, 0, floor.color, floor.material, true)
	-- Decorative checker tiles laid just above the slab (non-colliding, no seams for the ball).
	local tile = floor.tile
	if tile then
		local n = math.ceil(H * 2 / tile.size)
		local start = -n * tile.size / 2 + tile.size / 2
		for ix = 0, n - 1 do
			for iz = 0, n - 1 do
				if (ix + iz) % 2 == 1 then
					local x = start + ix * tile.size
					local z = start + iz * tile.size
					if math.abs(x) < H and math.abs(z) < H then
						geo(out, "tile", "Block", tile.size, 0.06, tile.size, x, 0.03, z, 0, tile.colors[2], tile.material, false)
					end
				end
			end
		end
	end

	local walls = kit.walls
	local h = walls.height
	for side = 0, 3 do
		local yaw = side * 90
		local nx, nz = 0, 0
		if side == 0 then
			nz = 1
		elseif side == 1 then
			nx = 1
		elseif side == 2 then
			nz = -1
		else
			nx = -1
		end
		local cx, cz = nx * (H + WALL_THICK / 2), nz * (H + WALL_THICK / 2)
		local length = full
		local sx, sz = if nx == 0 then length else WALL_THICK, if nx == 0 then WALL_THICK else length
		geo(out, "wall", "Block", sx, h, sz, cx, h / 2, cz, 0, walls.color, walls.material, true)
		-- Invisible barrier so huge hopping balls can never leave the arena.
		geo(out, "barrier", "Block", sx, 1600, sz, cx, h + 800, cz, 0, "#ffffff", "SmoothPlastic", true, 1)
		-- Baseboard + top trim.
		local bx, bz = nx * (H - 2), nz * (H - 2)
		local tsx, tsz = if nx == 0 then H * 2 else 4, if nx == 0 then 4 else H * 2
		geo(out, "decor", "Block", tsx, 14, tsz, bx, 7, bz, 0, walls.baseboard, "SmoothPlastic", true)
		geo(out, "decor", "Block", tsx, 10, tsz, bx, h - 5, bz, 0, walls.trim, "SmoothPlastic", false)

		if walls.stripes then
			local count = math.floor(H * 2 / walls.stripes.width)
			for i = 0, count - 1, 2 do
				local offset = -H + walls.stripes.width * (i + 0.5)
				local px = if nx == 0 then offset else nx * (H - 0.6)
				local pz = if nx == 0 then nz * (H - 0.6) else offset
				local ssx = if nx == 0 then walls.stripes.width else 1
				local ssz = if nx == 0 then 1 else walls.stripes.width
				geo(out, "decor", "Block", ssx, h - 30, ssz, px, (h - 30) / 2 + 14, pz, 0, walls.stripes.colors[2], "SmoothPlastic", false)
			end
		end
		if walls.windows and (side == 0 or side == 1) then
			local win = walls.windows
			for i = 1, win.count do
				local offset = -H + (H * 2) * i / (win.count + 1)
				local px = if nx == 0 then offset else nx * (H - 1)
				local pz = if nx == 0 then nz * (H - 1) else offset
				local wsx = if nx == 0 then 150 else 2
				local wsz = if nx == 0 then 2 else 150
				geo(out, "decor", "Block", wsx + (if nx == 0 then 16 else 0), 196, wsz + (if nx == 0 then 0 else 16), px, h * 0.62, pz, 0, "#ffffff", "SmoothPlastic", false)
				geo(out, "window", "Block", wsx, 180, wsz, px - nx * 0.6, h * 0.62, pz - nz * 0.6, 0, win.glow, "Neon", false)
				geo(out, "decor", "Block", if nx == 0 then 8 else 3, 180, if nx == 0 then 3 else 8, px - nx * 1.2, h * 0.62, pz - nz * 1.2, 0, "#ffffff", "SmoothPlastic", false)
			end
		end
		if walls.cabinets and side == 2 then
			-- A row of low cabinets along the back wall: big early obstacles that later get dwarfed.
			local cab = walls.cabinets
			local count = 6
			for i = 0, count - 1 do
				local w = (H * 2 - 40) / count
				local x = -H + 20 + w * (i + 0.5)
				local z = nz * (H - cab.depth / 2 - 2)
				geo(out, "cabinet", "Block", w - 6, cab.height, cab.depth, x, cab.height / 2, z, 0, cab.color, "SmoothPlastic", true)
				geo(out, "decor", "Block", w - 2, 6, cab.depth + 4, x, cab.height + 3, z, 0, "#f4f1ec", "Marble", true)
				geo(out, "decor", "Block", w * 0.4, 3, 2, x, cab.height * 0.75, z - nz * (cab.depth / 2 + 1), 0, cab.handle, "Metal", false)
			end
		end
		if walls.fence then
			local f = walls.fence
			local count = math.floor(H * 2 / f.postSpacing)
			for i = 0, count do
				local offset = -H + i * (H * 2 / count)
				local px = if nx == 0 then offset else nx * (H - 4)
				local pz = if nx == 0 then nz * (H - 4) else offset
				geo(out, "decor", "Block", 10, h + 20, 10, px, (h + 20) / 2, pz, 0, f.color, "WoodPlanks", true)
				geo(out, "decor", "Wedge", 10, 8, 10, px, h + 24, pz, yaw, f.color, "WoodPlanks", false)
			end
		end
	end
end

-- Platforms + ramps ----------------------------------------------------------------------------

local function buildPlatformGeometry(spec: any, p: Platform, out: { Geometry }, rng: Rng.Rng, blocked: { Platform })
	local h = p.height
	if spec.kind == "table" then
		local topT = 6
		geo(out, "platform", "Block", p.sx, topT, p.sz, p.x, h - topT / 2, p.z, 0, spec.top.color, spec.top.material, true)
		if spec.cloth then
			geo(out, "decor", "Block", p.sx * 0.7, 0.4, p.sz + 4, p.x, h + 0.2, p.z, 0, spec.cloth, "Fabric", false)
			geo(out, "decor", "Block", p.sx * 0.7, h * 0.35, 0.6, p.x, h - h * 0.175, p.z + p.sz / 2 + 2, 0, spec.cloth, "Fabric", false)
			geo(out, "decor", "Block", p.sx * 0.7, h * 0.35, 0.6, p.x, h - h * 0.175, p.z - p.sz / 2 - 2, 0, spec.cloth, "Fabric", false)
		end
		local legW = math.max(8, p.sx * 0.05)
		for _, sx in { -1, 1 } do
			for _, sz in { -1, 1 } do
				geo(out, "platform", "Block", legW, h - topT, legW, p.x + sx * (p.sx / 2 - legW), (h - topT) / 2, p.z + sz * (p.sz / 2 - legW), 0, spec.side.color, spec.side.material, true)
			end
		end
		return
	end

	-- Solid block platform with a top slab and trim lip.
	geo(out, "platform", "Block", p.sx, h - 1, p.sz, p.x, (h - 1) / 2, p.z, 0, spec.side.color, spec.side.material, true)
	geo(out, "platform", "Block", p.sx, 1, p.sz, p.x, h - 0.5, p.z, 0, spec.top.color, spec.top.material, true)
	if spec.trim then
		geo(out, "decor", "Block", p.sx + 2, spec.trim.height, p.sz + 2, p.x, h - 1 - spec.trim.height / 2, p.z, 0, spec.trim.color, "SmoothPlastic", false)
	end

	local ramps = spec.ramps
	if not ramps then
		return
	end
	-- Candidate edges: +X, -X, +Z, -Z. Long edges are preferred.
	local edges = {
		{ 1, 0, p.sz },
		{ -1, 0, p.sz },
		{ 0, 1, p.sx },
		{ 0, -1, p.sx },
	}
	rng:shuffle(edges)
	table.sort(edges, function(a, b)
		return a[3] > b[3]
	end)
	local len = math.max(h * 3, 40)
	local placed = 0
	for _, edge in edges do
		if placed >= ramps.count then
			break
		end
		local ox, oz, edgeLen = edge[1], edge[2], edge[3]
		local along = rng:range(-edgeLen * 0.3, edgeLen * 0.3)
		local cx = p.x + ox * (p.sx / 2 + len / 2) + (if ox == 0 then along else 0)
		local cz = p.z + oz * (p.sz / 2 + len / 2) + (if oz == 0 then along else 0)
		local sx = if ox == 0 then ramps.width else len
		local sz = if ox == 0 then len else ramps.width
		local fits = math.abs(cx) + sx / 2 < p.sx + 9999 -- always true; kept for clarity
		local clear = true
		for _, other in blocked do
			if other ~= p and rectsOverlap(other, cx, cz, sx, sz, 4) then
				clear = false
				break
			end
		end
		if fits and clear then
			-- Wedge high end (+Z local) faces the platform.
			local yaw = math.deg(math.atan2(-ox, -oz))
			geo(out, "ramp", "Wedge", ramps.width, h, len, cx, h / 2, cz, yaw, ramps.color, ramps.material, true)
			table.insert(blocked, { id = "ramp", kind = "ramp", x = cx, z = cz, sx = sx, sz = sz, height = 0, spawn = false })
			placed += 1
		end
	end
end

local function placePlatforms(kit: any, rng: Rng.Rng, out: { Geometry }): ({ Platform }, { Platform })
	local H = kit.arenaHalf
	local platforms: { Platform } = {}
	local blocked: { Platform } = {}
	local specsFor: { [Platform]: any } = {}
	for _, spec in kit.platforms do
		local count = if spec.count then rng:int(spec.count[1], spec.count[2]) else 1
		for _ = 1, count do
			for _attempt = 1, 40 do
				local sx = spec.size[1] + rng:range(-spec.jitter, spec.jitter)
				local sz = spec.size[2] + rng:range(-spec.jitter, spec.jitter)
				if rng:chance(0.5) and spec.placement ~= "center" then
					sx, sz = sz, sx
				end
				local x, z
				if spec.placement == "center" then
					x, z = rng:range(-30, 30), rng:range(-30, 30)
				else
					local a = rng:range(0, math.pi * 2)
					local r = rng:range(spec.ring[1], spec.ring[2]) * H
					x, z = math.cos(a) * r, math.sin(a) * r
				end
				local limit = H - EDGE_MARGIN - 130
				if math.abs(x) + sx / 2 < limit and math.abs(z) + sz / 2 < limit then
					local ok = true
					for _, other in blocked do
						if rectsOverlap(other, x, z, sx, sz, 150) then
							ok = false
							break
						end
					end
					if ok then
						local p: Platform = {
							id = spec.id,
							kind = spec.kind,
							x = x,
							z = z,
							sx = sx,
							sz = sz,
							height = spec.height,
							spawn = spec.spawn == true,
						}
						table.insert(platforms, p)
						table.insert(blocked, p)
						specsFor[p] = spec
						break
					end
				end
			end
		end
	end
	for _, p in platforms do
		buildPlatformGeometry(specsFor[p], p, out, rng, blocked)
	end
	return platforms, blocked
end

-- Props ----------------------------------------------------------------------------------------

type PlaceCtx = {
	rng: Rng.Rng,
	kit: any,
	H: number,
	platforms: { Platform },
	blocked: { Platform },
	hash: SpatialHash.SpatialHash,
	props: { Placed },
	spawnCenter: { number },
	nextId: number,
}

-- Returns surface height at (x, z) for a prop with this footprint/height, or nil if not allowed.
local function surfaceAt(ctx: PlaceCtx, x: number, z: number, footprint: number, height: number): number?
	if math.abs(x) > ctx.H - EDGE_MARGIN - footprint or math.abs(z) > ctx.H - EDGE_MARGIN - footprint then
		return nil
	end
	for _, b in ctx.blocked do
		if b.kind == "ramp" then
			if math.abs(x - b.x) < b.sx / 2 + footprint and math.abs(z - b.z) < b.sz / 2 + footprint then
				return nil
			end
		end
	end
	for _, p in ctx.platforms do
		local inside = math.abs(x - p.x) < p.sx / 2 + footprint and math.abs(z - p.z) < p.sz / 2 + footprint
		if inside then
			if insideRect(p, x, z, footprint) then
				if p.kind == "table" and height < p.height - 10 then
					return 0 -- tucked under the table
				end
				return p.height
			end
			return nil -- straddling an edge
		end
	end
	return 0
end

local function tryPlace(ctx: PlaceCtx, def: PropLibrary.PropDef, x: number, z: number, scale: number, mutation: number, spacing: number): Placed?
	local m = def.metrics
	local fp = m.footprint * scale
	local y = surfaceAt(ctx, x, z, fp, m.sy * scale)
	if not y then
		return nil
	end
	local near = ctx.hash:query(x, z, fp * spacing + 1)
	for _, otherId in near do
		local other = ctx.props[otherId]
		local ofp = PropLibrary.ByUid[other.uid].metrics.footprint * other.scale
		local dx, dz = other.x - x, other.z - z
		local minDist = (fp + ofp) * spacing
		if dx * dx + dz * dz < minDist * minDist and math.abs(other.y - y) < 5 then
			return nil
		end
	end
	local id = ctx.nextId
	ctx.nextId += 1
	local placed: Placed = {
		id = id,
		uid = def.uid,
		x = x,
		y = y,
		z = z,
		yaw = ctx.rng:range(0, math.pi * 2),
		scale = scale,
		mutation = mutation,
	}
	ctx.props[id] = placed
	ctx.hash:insert(id, x, z, fp)
	return placed
end

local function rollMutation(rng: Rng.Rng, def: PropLibrary.PropDef): number
	if def.landmark then
		return 0
	end
	for _, mut in Mutations.List do
		if mut.weight > 0 and rng:chance(mut.weight) then
			return mut.index
		end
	end
	return 0
end

local function sampleInRing(ctx: PlaceCtx, ring: { number }): (number, number)
	local rng = ctx.rng
	local H = ctx.H
	local cx, cz = ctx.spawnCenter[1], ctx.spawnCenter[3]
	for _ = 1, 24 do
		local x, z = rng:range(-H, H), rng:range(-H, H)
		local d = math.sqrt((x - cx) ^ 2 + (z - cz) ^ 2) / H
		if d >= ring[1] and d <= ring[2] then
			return x, z
		end
	end
	-- Fall back to polar sampling inside the ring.
	local a = rng:range(0, math.pi * 2)
	local r = rng:range(ring[1], ring[2]) * H
	return cx + math.cos(a) * r, cz + math.sin(a) * r
end

-- Pick a point on top of a random platform (area weighted) that lies within the ring.
local function samplePlatformTop(ctx: PlaceCtx, ring: { number }): (number?, number?)
	local rng = ctx.rng
	local H = ctx.H
	local cx, cz = ctx.spawnCenter[1], ctx.spawnCenter[3]
	local candidates = {}
	for _, p in ctx.platforms do
		table.insert(candidates, p)
	end
	if #candidates == 0 then
		return nil, nil
	end
	for _ = 1, 12 do
		local p = rng:weighted(candidates, function(c)
			return c.sx * c.sz
		end) :: Platform
		local x = p.x + rng:range(-p.sx / 2, p.sx / 2)
		local z = p.z + rng:range(-p.sz / 2, p.sz / 2)
		local d = math.sqrt((x - cx) ^ 2 + (z - cz) ^ 2) / H
		if d >= ring[1] - 0.05 and d <= ring[2] + 0.05 then
			return x, z
		end
	end
	return nil, nil
end

local function bandCandidates(kitId: string, lo: number, hi: number): { PropLibrary.PropDef }
	local out = {}
	for _, def in PropLibrary.ByKit[kitId] do
		local s = def.metrics.absorbSize
		if not def.critter and not def.landmark and s > lo and s <= hi then
			table.insert(out, def)
		end
	end
	return out
end

local function defWeight(def: PropLibrary.PropDef): number
	return Rarity.get(def.rarity).weight * def.weight
end

local function placeClusters(ctx: PlaceCtx, stats: { [string]: number })
	local rng = ctx.rng
	for _, cluster in ctx.kit.clusters do
		local count = rng:int(cluster.count[1], cluster.count[2])
		for _ = 1, count do
			local cx, cz = sampleInRing(ctx, cluster.ring)
			local placedAny = 0
			for _, item in cluster.items do
				local def = PropLibrary.find(ctx.kit.id, item[1])
				if def then
					for _ = 1, item[2] do
						for _attempt = 1, 6 do
							local a = rng:range(0, math.pi * 2)
							local r = cluster.radius * math.sqrt(rng:float())
							local scale = math.clamp(1 + rng:gauss() * 0.08, 0.85, 1.18)
							if tryPlace(ctx, def, cx + math.cos(a) * r, cz + math.sin(a) * r, scale, rollMutation(rng, def), 0.7) then
								placedAny += 1
								break
							end
						end
					end
				else
					warn("[WorldGen] cluster " .. cluster.id .. " references unknown prop " .. tostring(item[1]))
				end
			end
			stats.clusterProps = (stats.clusterProps or 0) + placedAny
		end
	end
end

local function placeBands(ctx: PlaceCtx, stats: { [string]: number })
	local rng = ctx.rng
	local lo = 0
	for bandIndex, band in ctx.kit.bands do
		local candidates = bandCandidates(ctx.kit.id, lo, band.max)
		local placed = 0
		if #candidates > 0 then
			for _ = 1, band.count do
				local def = rng:weighted(candidates, defWeight) :: PropLibrary.PropDef
				local scale = math.clamp(1 + rng:gauss() * 0.1, 0.82, 1.2)
				for _attempt = 1, 8 do
					local x, z
					if rng:chance(band.topBias) then
						x, z = samplePlatformTop(ctx, band.ring)
					end
					if not x then
						x, z = sampleInRing(ctx, band.ring)
					end
					if tryPlace(ctx, def, x :: number, z :: number, scale, rollMutation(rng, def), 0.9) then
						placed += 1
						break
					end
				end
			end
		end
		stats["band" .. bandIndex] = placed
		lo = band.max
	end
end

local function placeCritters(ctx: PlaceCtx, stats: { [string]: number })
	local rng = ctx.rng
	local n = 0
	for _, entry in ctx.kit.critters do
		local def = PropLibrary.find(ctx.kit.id, entry.id)
		if def and (entry.chance == nil or rng:chance(entry.chance)) then
			local count = rng:int(entry.count[1], entry.count[2])
			for _ = 1, count do
				for _attempt = 1, 10 do
					local x, z = sampleInRing(ctx, { 0.05, 1.2 })
					if tryPlace(ctx, def, x, z, math.clamp(1 + rng:gauss() * 0.06, 0.9, 1.12), rollMutation(rng, def), 1.2) then
						n += 1
						break
					end
				end
			end
		end
	end
	stats.critters = n
end

local function placeLandmark(ctx: PlaceCtx): number
	local def = PropLibrary.find(ctx.kit.id, ctx.kit.landmark.id)
	assert(def, "kit " .. ctx.kit.id .. " has no landmark prop")
	local rng = ctx.rng
	local H = ctx.H
	local fp = def.metrics.footprint
	local inset = H - fp - EDGE_MARGIN - 90
	for _attempt = 1, 30 do
		local x, z
		if ctx.kit.landmark.placement == "corner" then
			x = (if rng:chance(0.5) then 1 else -1) * inset * 0.92
			z = (if rng:chance(0.5) then 1 else -1) * inset * 0.92
		else
			local side = rng:int(0, 3)
			local along = rng:range(-inset * 0.6, inset * 0.6)
			if side == 0 then
				x, z = along, inset
			elseif side == 1 then
				x, z = inset, along
			elseif side == 2 then
				x, z = along, -inset * 0.75 -- back wall has cabinets
			else
				x, z = -inset, along
			end
		end
		local placed = tryPlace(ctx, def, x, z, 1, 0, 0.6)
		if placed then
			-- Face the arena centre.
			placed.yaw = math.atan2(-x, -z)
			return placed.id
		end
	end
	-- Guaranteed fallback: force it in on the floor near an edge.
	local id = ctx.nextId
	ctx.nextId += 1
	ctx.props[id] = { id = id, uid = def.uid, x = 0, y = 0, z = inset, yaw = math.pi, scale = 1, mutation = 0 }
	ctx.hash:insert(id, 0, inset, fp)
	return id
end

local function makeSpawns(spawnPlatform: Platform?, count: number, rng: Rng.Rng): { { number } }
	local spawns = {}
	if not spawnPlatform then
		for i = 1, count do
			local a = i / count * math.pi * 2
			table.insert(spawns, { math.cos(a) * 40, 4, math.sin(a) * 40 })
		end
		return spawns
	end
	local p = spawnPlatform
	local cols = 6
	local rows = math.ceil(count / cols)
	for i = 0, count - 1 do
		local c, r = i % cols, i // cols
		local x = p.x - p.sx * 0.38 + (c + 0.5) / cols * p.sx * 0.76 + rng:range(-6, 6)
		local z = p.z - p.sz * 0.3 + (r + 0.5) / rows * p.sz * 0.6 + rng:range(-6, 6)
		table.insert(spawns, { x, p.height + 3, z })
	end
	return spawns
end

function WorldGen.generate(kit: any, seed: number): Result
	local rng = Rng.new(seed)
	local geometry: { Geometry } = {}
	buildArena(kit, geometry)
	local platforms, blocked = placePlatforms(kit, rng:fork(1), geometry)

	local spawnPlatform: Platform? = nil
	for _, p in platforms do
		if p.spawn then
			spawnPlatform = p
			break
		end
	end
	local spawnCenter = if spawnPlatform then { spawnPlatform.x, spawnPlatform.height, spawnPlatform.z } else { 0, 0, 0 }

	local ctx: PlaceCtx = {
		rng = rng:fork(2),
		kit = kit,
		H = kit.arenaHalf,
		platforms = platforms,
		blocked = blocked,
		hash = SpatialHash.new(32),
		props = {},
		spawnCenter = spawnCenter,
		nextId = 1,
	}
	local stats: { [string]: number } = {}
	local landmarkId = placeLandmark(ctx)
	placeClusters(ctx, stats)
	placeBands(ctx, stats)
	placeCritters(ctx, stats)

	local props: { Placed } = {}
	for i = 1, ctx.nextId - 1 do
		local p = ctx.props[i]
		if p then
			table.insert(props, p)
		end
	end
	stats.total = #props

	return {
		kitId = kit.id,
		seed = seed,
		arenaHalf = kit.arenaHalf,
		geometry = geometry,
		props = props,
		platforms = platforms,
		spawns = makeSpawns(spawnPlatform, 24, rng:fork(3)),
		spawnCenter = spawnCenter,
		landmarkId = landmarkId,
		stats = stats,
	}
end

return WorldGen
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Thin networking wrapper. The server creates remotes; clients wait for them.
-- Every client->server entry point goes through `on`/`action`, which enforce argument guards and
-- per-player token-bucket rate limits so handlers only ever see well-formed, throttled input.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Definitions = require(script.Definitions)
local RateLimiter = require(script.Parent.Util.RateLimiter)

local Net = {}

local FOLDER_NAME = "Remotes"
local remotes: { [string]: Instance } = {}
local actionHandlers: { [string]: { guard: (any) -> boolean, fn: (Player, any) -> any, limiter: any } } = {}
local violationCounts: { [Player]: number } = {}

local IS_SERVER = RunService:IsServer()

local function classFor(kind: string): string
	if kind == "Unreliable" then
		return "UnreliableRemoteEvent"
	elseif kind == "Function" then
		return "RemoteFunction"
	end
	return "RemoteEvent"
end

local function getRemote(name: string): any
	local remote = remotes[name]
	if remote then
		return remote
	end
	assert(Definitions[name], "Unknown remote: " .. name)
	if IS_SERVER then
		error("Net.init() must run before using remote " .. name)
	end
	local folder = ReplicatedStorage:WaitForChild(FOLDER_NAME)
	remote = folder:WaitForChild(name)
	remotes[name] = remote
	return remote
end

-- Logs repeated malformed/over-limit traffic once per burst so exploit attempts are visible.
local function flag(player: Player, reason: string)
	local count = (violationCounts[player] or 0) + 1
	violationCounts[player] = count
	if count == 1 or count % 50 == 0 then
		warn(string.format("[Net] %s (%d) rejected: %s (x%d)", player.Name, player.UserId, reason, count))
	end
end

function Net.init()
	if IS_SERVER then
		local folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = FOLDER_NAME
			folder.Parent = ReplicatedStorage
		end
		for name, kind in Definitions do
			local remote = folder:FindFirstChild(name)
			if not remote then
				remote = Instance.new(classFor(kind))
				remote.Name = name
				remote.Parent = folder
			end
			remotes[name] = remote
		end
		local requestRemote = remotes.Request :: RemoteFunction
		requestRemote.OnServerInvoke = function(player: Player, action: any, payload: any)
			if type(action) ~= "string" then
				flag(player, "request action type")
				return false, "bad_request"
			end
			local handler = actionHandlers[action]
			if not handler then
				flag(player, "unknown action " .. action:sub(1, 32))
				return false, "unknown_action"
			end
			if not handler.limiter:allow(player) then
				flag(player, "rate " .. action)
				return false, "slow_down"
			end
			if not handler.guard(payload) then
				flag(player, "payload " .. action)
				return false, "bad_payload"
			end
			local ok, result, extra = pcall(handler.fn, player, payload)
			if not ok then
				warn("[Net] action " .. action .. " errored: " .. tostring(result))
				return false, "server_error"
			end
			return result, extra
		end
		Players.PlayerRemoving:Connect(function(player)
			violationCounts[player] = nil
		end)
	end
end

-- SERVER API -------------------------------------------------------------------------------

function Net.fire(name: string, player: Player, ...)
	getRemote(name):FireClient(player, ...)
end

function Net.fireAll(name: string, ...)
	getRemote(name):FireAllClients(...)
end

function Net.fireList(name: string, players: { Player }, ...)
	local remote = getRemote(name)
	for _, player in players do
		if player.Parent then
			remote:FireClient(player, ...)
		end
	end
end

function Net.fireExcept(name: string, except: Player, ...)
	local remote = getRemote(name)
	for _, player in Players:GetPlayers() do
		if player ~= except then
			remote:FireClient(player, ...)
		end
	end
end

export type OnOptions = {
	rate: number?, -- calls per second sustained
	burst: number?,
	guards: { (any) -> boolean }?, -- one guard per positional argument
}

function Net.on(name: string, handler: (Player, ...any) -> (), options: OnOptions?)
	local opts = options or {}
	local limiter = RateLimiter.new(opts.rate or 10, opts.burst or (opts.rate or 10) * 2)
	local guards = opts.guards or {}
	local remote = getRemote(name)
	remote.OnServerEvent:Connect(function(player: Player, ...)
		if not limiter:allow(player) then
			flag(player, "rate " .. name)
			return
		end
		local argCount = select("#", ...)
		if argCount > math.max(#guards, 0) then
			flag(player, "arg count " .. name)
			return
		end
		for i, guard in guards do
			if not guard((select(i, ...))) then
				flag(player, "guard " .. name .. "#" .. i)
				return
			end
		end
		handler(player, ...)
	end)
end

-- Register a menu action reachable through the Request RemoteFunction.
function Net.action(name: string, guard: (any) -> boolean, fn: (Player, any) -> any, rate: number?)
	assert(actionHandlers[name] == nil, "Duplicate action " .. name)
	actionHandlers[name] = {
		guard = guard,
		fn = fn,
		limiter = RateLimiter.new(rate or 4, (rate or 4) * 2),
	}
end

-- CLIENT API -------------------------------------------------------------------------------

function Net.connect(name: string, fn: (...any) -> ()): RBXScriptConnection
	local remote = getRemote(name)
	return remote.OnClientEvent:Connect(fn)
end

function Net.send(name: string, ...)
	getRemote(name):FireServer(...)
end

-- Returns (ok/result, extra). Never throws; network errors come back as (false, "network").
function Net.request(action: string, payload: any?): (any, any)
	local remote = getRemote("Request")
	local ok, result, extra = pcall(function()
		return remote:InvokeServer(action, payload)
	end)
	if not ok then
		return false, "network"
	end
	return result, extra
end

return Net
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Definitions</string>
            <string name="Source"><![CDATA[--!strict
-- Every remote in the game. Server -> client unless marked C2S. Unreliable remotes carry
-- high-frequency, loss-tolerant state (critter positions, merge input).

export type RemoteKind = "Event" | "Unreliable" | "Function"

local Definitions: { [string]: RemoteKind } = {
	-- Round + world
	RoundState = "Event", -- (snapshot)
	WorldLoad = "Event", -- (kitId, seed, propBuffer, landmarkId)
	PropsRemoved = "Event", -- ({ {propId, absorberBallId} })
	LootSpawned = "Event", -- (buffer)
	PropsMutated = "Event", -- ({ {propId, mutationIndex} })
	CritterState = "Unreliable", -- (buffer)
	WorldEvent = "Event", -- (eventId | nil, info)
	Announce = "Event", -- (kind, data)

	-- Ball + absorption
	Absorbed = "Event", -- (list of absorb results for the local player)
	BallFx = "Event", -- (kind, data) bonks, bumps, squash for everyone nearby
	Impulse = "Event", -- (velocityChange: Vector3) applied by the owning client
	PlayerState = "Event", -- (state, data) Rolling / Rider / Merged / Hub
	LaunchSequence = "Event",
	Results = "Event",
	PlanetCreated = "Event",

	-- Data sync
	ProfileSync = "Event", -- (clientProfile)
	Toast = "Event", -- (kind, data)

	-- C2S
	AbsorbClaim = "Event", -- ({ propIds })
	Action = "Event", -- (actionName, arg?)
	MergeInput = "Unreliable", -- (moveX, moveZ)
	Social = "Event", -- (kind, arg)

	-- C2S request/response for menus
	Request = "Function", -- (action, payload) -> (ok, result)
}

return Definitions
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="39">
        <Properties>
          <string name="Name">PropBuilder</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Turns prop recipes into Roblox Models (client side).
--
-- Preferred path: MeshAssembly merges each recipe into a few smooth meshes (bevelled edges, real
-- curves, baked contact shading, UVs for material textures) and we upload them to EditableMesh
-- -> MeshPart. One template per prop type is built once per session and cloned per instance.
-- Fallback path: if EditableMesh is unavailable (device budget, experience setting), the same
-- recipe is built from primitive parts so the game always works.
--
-- Every model has an invisible "Hitbox" PrimaryPart sized to the prop's bounds whose pivot sits at
-- ground level, so PivotTo(CFrame.new(x, groundY, z)) places a prop correctly.

local AssetService = game:GetService("AssetService")
local CollectionService = game:GetService("CollectionService")

local PropLibrary = require(script.Parent.Logic.PropLibrary)
local PropMetrics = require(script.Parent.Logic.PropMetrics)
local MeshAssembly = require(script.Parent.Logic.MeshAssembly)
local MeshKit = require(script.Parent.Logic.MeshKit)
local Mutations = require(script.Parent.Data.Mutations)
local Tuning = require(script.Parent.Config.Tuning)

local PropBuilder = {}

local templates: { [number]: Model } = {}
local building: { [number]: boolean } = {}
local editableAvailable = Tuning.Graphics.UseEditableMesh
PropBuilder.stats = { meshTemplates = 0, fallbackTemplates = 0, meshFailures = 0 }

local function material(name: string?): Enum.Material
	if not name then
		return Enum.Material.SmoothPlastic
	end
	local ok, value = pcall(function()
		return (Enum.Material :: any)[name]
	end)
	return if ok and value then value else Enum.Material.SmoothPlastic
end
PropBuilder.material = material

local function toCFrame(spec: any): CFrame
	local m = PropMetrics.partRotation(spec)
	return CFrame.new(spec.pos[1], spec.pos[2], spec.pos[3], m[1], m[2], m[3], m[4], m[5], m[6], m[7], m[8], m[9])
end

local function styleVisual(part: BasePart, castShadow: boolean)
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.CastShadow = castShadow
	if part:IsA("Part") then
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
	end
end

-- FALLBACK: primitive parts ----------------------------------------------------------------------

local function primitive(spec: any): BasePart
	local part: BasePart
	if spec.shape == "Wedge" then
		part = Instance.new("WedgePart")
	elseif spec.shape == "CornerWedge" then
		part = Instance.new("CornerWedgePart")
	elseif spec.shape == "Ball" and not (spec.size[1] == spec.size[2] and spec.size[2] == spec.size[3]) then
		local p = Instance.new("Part")
		p.Shape = Enum.PartType.Block
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
		part = p
	else
		local p = Instance.new("Part")
		p.Shape = if spec.shape == "Ball" then Enum.PartType.Ball elseif spec.shape == "Cylinder" then Enum.PartType.Cylinder else Enum.PartType.Block
		part = p
	end
	part.Size = Vector3.new(math.max(spec.size[1], 0.05), math.max(spec.size[2], 0.05), math.max(spec.size[3], 0.05))
	part.CFrame = toCFrame(spec)
	part.Color = Color3.fromHex(spec.color)
	part.Material = if spec.neon then Enum.Material.Neon else material(spec.material)
	part.Transparency = spec.transparency or 0
	part.Reflectance = spec.reflectance or 0
	styleVisual(part, math.max(spec.size[1], spec.size[2], spec.size[3]) > 2.5 and not spec.neon)
	if spec.tag then
		part:SetAttribute("Tag", spec.tag)
		part:SetAttribute("Pivot", Vector3.new(spec.pos[1], spec.pos[2], spec.pos[3]))
	end
	part:SetAttribute("BaseColor", spec.color)
	return part
end

-- Approximate a smooth-mesh spec with primitives (fallback only).
local function fallbackSpecs(spec: any): { any }
	if spec.shape ~= "Mesh" then
		return { spec }
	end
	local d = spec.mesh
	local out = {}
	local function sub(shape: string, size: { number }, lx: number, ly: number, lz: number, extraRot: { number }?)
		-- Local offset rotated by the spec rotation.
		local m = PropMetrics.partRotation(spec)
		local wx = spec.pos[1] + m[1] * lx + m[2] * ly + m[3] * lz
		local wy = spec.pos[2] + m[4] * lx + m[5] * ly + m[6] * lz
		local wz = spec.pos[3] + m[7] * lx + m[8] * ly + m[9] * lz
		table.insert(out, {
			shape = shape,
			size = size,
			pos = { wx, wy, wz },
			rot = extraRot or spec.rot,
			upright = shape == "Cylinder" and extraRot == nil,
			color = spec.color,
			material = spec.material,
			transparency = spec.transparency,
			neon = spec.neon,
			tag = spec.tag,
		})
	end
	if d.kind == "lathe" then
		local prof = d.profile
		for i = 1, #prof - 1 do
			local a, b = prof[i], prof[i + 1]
			local h = math.abs(b[2] - a[2])
			local r = (a[1] + b[1]) / 2
			if h > 0.05 and r > 0.05 then
				sub("Cylinder", { h, r * 2, r * 2 }, 0, (a[2] + b[2]) / 2, 0)
			end
		end
	elseif d.kind == "ellipsoid" then
		sub("Ball", { d.size[1], d.size[2], d.size[3] }, 0, 0, 0)
	elseif d.kind == "rbox" then
		sub("Block", { d.size[1], d.size[2], d.size[3] }, 0, 0, 0)
	elseif d.kind == "torus" then
		for i = 0, 9 do
			local a = i / 10 * math.pi * 2
			sub("Ball", { d.minor * 2.2, d.minor * 2.2, d.minor * 2.2 }, math.cos(a) * d.major, 0, math.sin(a) * d.major)
		end
	elseif d.kind == "tube" then
		local pts = MeshKit.smoothCurve(d.path, 2)
		for i = 1, #pts do
			local p = pts[i]
			local r = if type(d.radius) == "table" then d.radius[math.clamp(math.floor((i - 1) / 2) + 1, 1, #d.radius)] else d.radius
			sub("Ball", { r * 2, r * 2, r * 2 }, p[1], p[2], p[3])
		end
	else
		local s = spec.size
		local c = spec.meshCenter or { 0, 0, 0 }
		sub("Block", { s[1], s[2], s[3] }, c[1], c[2], c[3])
	end
	return out
end

-- MESH PATH: EditableMesh -> MeshPart ------------------------------------------------------------

local function groupBounds(g): (Vector3, Vector3)
	local v = g.verts
	local minX, minY, minZ = math.huge, math.huge, math.huge
	local maxX, maxY, maxZ = -math.huge, -math.huge, -math.huge
	for i = 1, #v, 3 do
		minX, maxX = math.min(minX, v[i]), math.max(maxX, v[i])
		minY, maxY = math.min(minY, v[i + 1]), math.max(maxY, v[i + 1])
		minZ, maxZ = math.min(minZ, v[i + 2]), math.max(maxZ, v[i + 2])
	end
	return Vector3.new((minX + maxX) / 2, (minY + maxY) / 2, (minZ + maxZ) / 2), Vector3.new(maxX - minX, maxY - minY, maxZ - minZ)
end

-- Uploads one merged group. Yields (CreateMeshPartAsync). Returns nil on any failure.
local function meshPartFromGroup(g): MeshPart?
	local center, size = groupBounds(g)
	local ok, result = pcall(function()
		local em = AssetService:CreateEditableMesh()
		local v, n, uv, shade, tris = g.verts, g.norms, g.uvs, g.shade, g.tris
		local count = #v // 3
		local vids = table.create(count)
		local nids = table.create(count)
		local uvids = table.create(count)
		local cids = if Tuning.Graphics.VertexShading then table.create(count) else nil
		for i = 1, count do
			local o = (i - 1) * 3
			vids[i] = em:AddVertex(Vector3.new(v[o + 1] - center.X, v[o + 2] - center.Y, v[o + 3] - center.Z))
			nids[i] = em:AddNormal(Vector3.new(n[o + 1], n[o + 2], n[o + 3]))
			uvids[i] = em:AddUV(Vector2.new(uv[(i - 1) * 2 + 1], 1 - uv[(i - 1) * 2 + 2]))
			if cids then
				local s = shade[i]
				cids[i] = em:AddColor(Color3.new(s, s, s), 1)
			end
		end
		local flip = Tuning.Graphics.FlipWinding
		for t = 1, #tris, 3 do
			local a, b, c = tris[t], tris[t + 1], tris[t + 2]
			if flip then
				b, c = c, b
			end
			local face = em:AddTriangle(vids[a], vids[b], vids[c])
			em:SetFaceNormals(face, { nids[a], nids[b], nids[c] })
			em:SetFaceUVs(face, { uvids[a], uvids[b], uvids[c] })
			if cids then
				em:SetFaceColors(face, { cids[a], cids[b], cids[c] })
			end
		end
		local mp = AssetService:CreateMeshPartAsync(Content.fromObject(em), {
			CollisionFidelity = Enum.CollisionFidelity.Box,
		})
		return mp
	end)
	if not ok or not result then
		PropBuilder.stats.meshFailures += 1
		if PropBuilder.stats.meshFailures == 1 then
			warn("[PropBuilder] EditableMesh unavailable, using primitive fallback: " .. tostring(result))
		end
		if PropBuilder.stats.meshFailures >= 3 then
			editableAvailable = false
		end
		return nil
	end
	local mp = result :: MeshPart
	mp.Size = Vector3.new(math.max(size.X, 0.05), math.max(size.Y, 0.05), math.max(size.Z, 0.05))
	mp.CFrame = CFrame.new(center)
	mp.Color = Color3.fromHex(g.color)
	mp.Material = material(g.material)
	mp.Transparency = g.transparency
	mp.Reflectance = g.reflectance
	styleVisual(mp, not g.neon and g.transparency < 0.5 and math.max(size.X, size.Y, size.Z) > 2)
	mp:SetAttribute("BaseColor", g.color)
	if g.tag then
		mp:SetAttribute("Tag", g.tag)
		local p = g.pivot
		mp:SetAttribute("Pivot", Vector3.new(p[1], p[2], p[3]))
	end
	return mp
end

local function newModel(name: string, metrics: any): (Model, Part)
	local model = Instance.new("Model")
	model.Name = name
	local hitbox = Instance.new("Part")
	hitbox.Name = "Hitbox"
	hitbox.Size = Vector3.new(math.max(metrics.sx, 0.2), math.max(metrics.sy, 0.2), math.max(metrics.sz, 0.2))
	hitbox.CFrame = CFrame.new(0, metrics.centerY, 0)
	hitbox.PivotOffset = CFrame.new(0, -metrics.centerY, 0)
	hitbox.Transparency = 1
	hitbox.Anchored = true
	hitbox.CanCollide = false
	hitbox.CanQuery = false
	hitbox.CanTouch = false
	hitbox.CastShadow = false
	hitbox.Parent = model
	model.PrimaryPart = hitbox
	return model, hitbox
end

local function weld(hitbox: BasePart, part: BasePart)
	local w = Instance.new("WeldConstraint")
	w.Part0 = hitbox
	w.Part1 = part
	w.Parent = part
end

local function buildFallback(parts: { any }, model: Model, hitbox: BasePart)
	local i = 0
	for _, spec in parts do
		for _, sub in fallbackSpecs(spec) do
			i += 1
			local part = primitive(sub)
			part.Name = "P" .. i
			part.Parent = model
			weld(hitbox, part)
		end
	end
end

-- Build a model from a recipe. Yields when using the mesh path.
local function buildRecipe(name: string, parts: { any }, metrics: any, detail: number): (Model, boolean)
	local model, hitbox = newModel(name, metrics)
	if editableAvailable then
		local groups = MeshAssembly.assemble(parts, Tuning.Graphics.VertexShading, detail)
		local built = {}
		local failed = false
		for gi, g in groups do
			local mp = meshPartFromGroup(g)
			if not mp then
				failed = true
				break
			end
			mp.Name = "M" .. gi
			table.insert(built, mp)
		end
		if not failed then
			for _, mp in built do
				mp.Parent = model
				weld(hitbox, mp)
			end
			return model, true
		end
		for _, mp in built do
			mp:Destroy()
		end
	end
	buildFallback(parts, model, hitbox)
	return model, false
end

local function templateFor(def): Model
	local model, isMesh = buildRecipe(def.id, def.parts, def.metrics, MeshAssembly.detailFor(def.metrics.absorbSize))
	model:SetAttribute("Uid", def.uid)
	if isMesh then
		PropBuilder.stats.meshTemplates += 1
	else
		PropBuilder.stats.fallbackTemplates += 1
	end
	return model
end

-- Ensure a template exists. Yields while building; concurrent callers wait for the same build.
function PropBuilder.template(uid: number): Model?
	local existing = templates[uid]
	if existing then
		return existing
	end
	local def = PropLibrary.get(uid)
	if not def then
		return nil
	end
	if building[uid] then
		while building[uid] do
			task.wait()
		end
		return templates[uid]
	end
	building[uid] = true
	local ok, model = pcall(templateFor, def)
	if not ok then
		warn("[PropBuilder] template " .. def.id .. " failed: " .. tostring(model))
		local fallback, hitbox = newModel(def.id, def.metrics)
		buildFallback(def.parts, fallback, hitbox)
		model = fallback
	end
	templates[uid] = model
	building[uid] = nil
	return model
end

function PropBuilder.hasTemplate(uid: number): boolean
	return templates[uid] ~= nil
end

-- Build templates for many props in the background (current kit first). onProgress(done, total).
function PropBuilder.prepareAsync(uids: { number }, onProgress: ((number, number) -> ())?)
	local total = #uids
	local done = 0
	local perFrame = Tuning.Graphics.TemplatesPerFrame
	for i, uid in uids do
		PropBuilder.template(uid)
		done += 1
		if onProgress then
			onProgress(done, total)
		end
		if i % perFrame == 0 then
			task.wait()
		end
	end
end

-- Build an arbitrary recipe (Nana Nova, hub decor, shop previews). Yields.
function PropBuilder.buildParts(parts: { any }, name: string, detail: number?): Model
	local metrics = PropMetrics.compute(parts, 1)
	local model = buildRecipe(name, parts, metrics, detail or 1)
	-- Pivot at the recipe origin rather than the ground-centred hitbox convention.
	model.PrimaryPart.PivotOffset = CFrame.new(0, -metrics.centerY, 0)
	return model
end

local function lerpColor(a: Color3, b: Color3, t: number): Color3
	return a:Lerp(b, t)
end

local function visualParts(model: Model): { BasePart }
	local out = {}
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d.Name ~= "Hitbox" then
			table.insert(out, d)
		end
	end
	return out
end

-- Apply a mutation layer (color tint, material, light, rainbow tag) to a built model.
function PropBuilder.applyMutation(model: Model, mutationIndex: number)
	model:SetAttribute("Mutation", mutationIndex)
	local mut = Mutations.get(mutationIndex)
	if not mut then
		return
	end
	local tint = if mut.color then Color3.fromHex(mut.color) else nil
	for _, d in visualParts(model) do
		if d:GetAttribute("Tag") ~= "eye" then
			if tint and mut.tintStrength > 0 then
				d.Color = lerpColor(d.Color, tint, mut.tintStrength)
			end
			if mut.material and d.Material ~= Enum.Material.Neon then
				d.Material = material(mut.material)
			end
			if mut.reflectance then
				d.Reflectance = mut.reflectance
			end
		end
	end
	if mut.rainbow then
		CollectionService:AddTag(model, "RainbowProp")
	end
	local hitbox = model.PrimaryPart
	if hitbox and mut.light then
		local light = Instance.new("PointLight")
		light.Color = Color3.fromHex(mut.light)
		light.Range = math.clamp(hitbox.Size.Magnitude * 1.2, 4, 40)
		light.Brightness = 1.2
		light.Shadows = false
		light.Parent = hitbox
	end
end

-- Recolor parts that share the recipe's primary color with the variant color.
function PropBuilder.applyVariant(model: Model, def, instanceId: number)
	local variant = PropLibrary.variantColor(def, instanceId)
	if not variant then
		return
	end
	local primary = def.parts[1].color
	local color = Color3.fromHex(variant)
	for _, d in visualParts(model) do
		if d:GetAttribute("BaseColor") == primary then
			d.Color = color
		end
	end
end

-- Build a ready-to-place clone. Yields only if the template isn't prepared yet.
function PropBuilder.create(uid: number, instanceId: number, scale: number, mutationIndex: number): Model?
	local template = PropBuilder.template(uid)
	local def = PropLibrary.get(uid)
	if not template or not def then
		return nil
	end
	local model = template:Clone()
	PropBuilder.applyVariant(model, def, instanceId)
	local mut = Mutations.get(mutationIndex)
	local finalScale = scale * (if mut then mut.scale else 1)
	if math.abs(finalScale - 1) > 1e-3 then
		model:ScaleTo(finalScale)
	end
	if mutationIndex > 0 then
		PropBuilder.applyMutation(model, mutationIndex)
	end
	model:SetAttribute("PropId", instanceId)
	return model
end

-- Unanchor a model so it can be welded to a moving ball. Parts keep their internal welds.
function PropBuilder.makeDynamic(model: Model)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = false
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.Massless = true
		end
	end
end

function PropBuilder.makeStatic(model: Model)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
		end
	end
end

return PropBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="40">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">Base64</string>
            <string name="Source"><![CDATA[--!strict
-- Base64 for byte strings, so compact binary blobs (bitsets) can live safely in DataStore JSON.

local Base64 = {}

local ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local encodeMap: { [number]: string } = {}
local decodeMap: { [number]: number } = {}
for i = 1, #ALPHABET do
	local ch = ALPHABET:sub(i, i)
	encodeMap[i - 1] = ch
	decodeMap[string.byte(ch)] = i - 1
end

function Base64.encode(bytes: string): string
	local out = table.create(math.ceil(#bytes / 3) * 4)
	for i = 1, #bytes, 3 do
		local a, b, c = string.byte(bytes, i, i + 2)
		local n = bit32.lshift(a, 16) + bit32.lshift(b or 0, 8) + (c or 0)
		table.insert(out, encodeMap[bit32.extract(n, 18, 6)])
		table.insert(out, encodeMap[bit32.extract(n, 12, 6)])
		table.insert(out, if b then encodeMap[bit32.extract(n, 6, 6)] else "=")
		table.insert(out, if c then encodeMap[bit32.extract(n, 0, 6)] else "=")
	end
	return table.concat(out)
end

function Base64.decode(text: string): string
	local out = {}
	local clean = text:gsub("[^%w%+/=]", "")
	for i = 1, #clean, 4 do
		local c1, c2, c3, c4 = string.byte(clean, i, i + 3)
		if not c1 or not c2 then
			break
		end
		local v1, v2 = decodeMap[c1] or 0, decodeMap[c2] or 0
		local pad3 = c3 == nil or c3 == 61
		local pad4 = c4 == nil or c4 == 61
		local v3 = if pad3 then 0 else (decodeMap[c3 :: number] or 0)
		local v4 = if pad4 then 0 else (decodeMap[c4 :: number] or 0)
		local n = bit32.lshift(v1, 18) + bit32.lshift(v2, 12) + bit32.lshift(v3, 6) + v4
		table.insert(out, string.char(bit32.extract(n, 16, 8)))
		if not pad3 then
			table.insert(out, string.char(bit32.extract(n, 8, 8)))
		end
		if not pad4 then
			table.insert(out, string.char(bit32.extract(n, 0, 8)))
		end
	end
	return table.concat(out)
end

return Base64
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">Bitset</string>
            <string name="Source"><![CDATA[--!strict
-- Growable bitset stored as a byte array, serialised to base64 for saving.
-- Used for the Rolledex (prop uid x mutation variant) and Roll Pass claims.

local Base64 = require(script.Parent.Base64)

export type Bitset = {
	bytes: { number },
}

local Bitset = {}

function Bitset.new(): Bitset
	return { bytes = {} }
end

function Bitset.get(set: Bitset, index: number): boolean
	local byteIndex = index // 8 + 1
	local byte = set.bytes[byteIndex]
	if not byte then
		return false
	end
	return bit32.btest(byte, bit32.lshift(1, index % 8))
end

-- Returns true when the bit was newly set.
function Bitset.set(set: Bitset, index: number): boolean
	assert(index >= 0 and index == math.floor(index), "Bitset index must be a non-negative integer")
	local byteIndex = index // 8 + 1
	local bytes = set.bytes
	for i = #bytes + 1, byteIndex do
		bytes[i] = 0
	end
	local mask = bit32.lshift(1, index % 8)
	local before = bytes[byteIndex]
	if bit32.btest(before, mask) then
		return false
	end
	bytes[byteIndex] = bit32.bor(before, mask)
	return true
end

function Bitset.clear(set: Bitset, index: number)
	local byteIndex = index // 8 + 1
	local byte = set.bytes[byteIndex]
	if byte then
		set.bytes[byteIndex] = bit32.band(byte, bit32.bnot(bit32.lshift(1, index % 8)))
	end
end

function Bitset.count(set: Bitset): number
	local total = 0
	for _, byte in set.bytes do
		local b = byte
		while b ~= 0 do
			b = bit32.band(b, b - 1)
			total += 1
		end
	end
	return total
end

function Bitset.encode(set: Bitset): string
	local chars = table.create(#set.bytes)
	for i, byte in set.bytes do
		chars[i] = string.char(byte)
	end
	-- Trim trailing zero bytes to keep saves small.
	local n = #chars
	while n > 0 and set.bytes[n] == 0 do
		chars[n] = nil
		n -= 1
	end
	return Base64.encode(table.concat(chars))
end

function Bitset.decode(text: string?): Bitset
	local set = Bitset.new()
	if not text or text == "" then
		return set
	end
	local raw = Base64.decode(text)
	for i = 1, #raw do
		set.bytes[i] = string.byte(raw, i)
	end
	return set
end

return Bitset
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">Format</string>
            <string name="Source"><![CDATA[--!strict
-- Human-readable formatting: sizes in real-world units, big numbers, timers.

local Format = {}

-- Converts a diameter in studs to a display string given the tier's centimetres-per-stud scale.
-- Returns value string and unit separately so the HUD can animate the number and style the unit.
function Format.sizeParts(diameterStuds: number, cmPerStud: number): (string, string)
	local cm = diameterStuds * cmPerStud
	if cm < 1 then
		return string.format("%.1f", cm * 10), "mm"
	elseif cm < 100 then
		if cm < 10 then
			return string.format("%.1f", cm), "cm"
		end
		return string.format("%d", math.floor(cm + 0.5)), "cm"
	elseif cm < 100000 then
		local m = cm / 100
		if m < 10 then
			return string.format("%.2f", m), "m"
		elseif m < 100 then
			return string.format("%.1f", m), "m"
		end
		return string.format("%d", math.floor(m + 0.5)), "m"
	else
		local km = cm / 100000
		if km < 10 then
			return string.format("%.2f", km), "km"
		elseif km < 100 then
			return string.format("%.1f", km), "km"
		end
		return Format.compact(km), "km"
	end
end

function Format.size(diameterStuds: number, cmPerStud: number): string
	local v, u = Format.sizeParts(diameterStuds, cmPerStud)
	return v .. " " .. u
end

-- 1234 -> "1,234"
function Format.commas(n: number): string
	local negative = n < 0
	local s = tostring(math.floor(math.abs(n)))
	local reversed = s:reverse():gsub("(%d%d%d)", "%1,")
	local out = reversed:reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return (negative and "-" or "") .. out
end

-- 15300 -> "15.3K"
function Format.compact(n: number): string
	local abs = math.abs(n)
	local limits = { 1e12, 1e9, 1e6, 1e3 }
	local suffixes = { "T", "B", "M", "K" }
	for i, limit in limits do
		if abs >= limit then
			local v = n / limit
			if math.abs(v) >= 100 then
				return string.format("%d%s", math.floor(v), suffixes[i])
			end
			local text = string.format("%.1f", v):gsub("%.0$", "")
			return text .. suffixes[i]
		end
	end
	return tostring(math.floor(n))
end

-- 125 -> "2:05"
function Format.clock(seconds: number): string
	seconds = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

-- 90061 -> "1d 1h"
function Format.duration(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local d = seconds // 86400
	local h = (seconds % 86400) // 3600
	local m = (seconds % 3600) // 60
	if d > 0 then
		return string.format("%dd %dh", d, h)
	elseif h > 0 then
		return string.format("%dh %dm", h, m)
	end
	return string.format("%dm", math.max(1, m))
end

function Format.percent(fraction: number): string
	return string.format("%d%%", math.floor(fraction * 100 + 0.5))
end

function Format.ordinal(n: number): string
	local suffix = "th"
	local lastTwo = n % 100
	if lastTwo < 11 or lastTwo > 13 then
		local last = n % 10
		if last == 1 then
			suffix = "st"
		elseif last == 2 then
			suffix = "nd"
		elseif last == 3 then
			suffix = "rd"
		end
	end
	return tostring(n) .. suffix
end

return Format
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">Guard</string>
            <string name="Source"><![CDATA[--!strict
-- Runtime type guards for validating remote payloads from untrusted clients.
-- Every guard returns true only for well-formed, finite, bounded values.

local Guard = {}

export type Check = (value: any) -> boolean

local function isFinite(n: number): boolean
	return n == n and n ~= math.huge and n ~= -math.huge
end

function Guard.number(min: number?, max: number?): Check
	return function(v)
		if type(v) ~= "number" or not isFinite(v) then
			return false
		end
		if min and v < min then
			return false
		end
		if max and v > max then
			return false
		end
		return true
	end
end

function Guard.integer(min: number?, max: number?): Check
	local base = Guard.number(min, max)
	return function(v)
		return base(v) and v == math.floor(v)
	end
end

function Guard.string(maxLen: number): Check
	return function(v)
		return type(v) == "string" and #v <= maxLen and utf8.len(v) ~= nil
	end
end

function Guard.boolean(): Check
	return function(v)
		return type(v) == "boolean"
	end
end

function Guard.oneOf(options: { any }): Check
	local set = {}
	for _, o in options do
		set[o] = true
	end
	return function(v)
		return set[v] == true
	end
end

function Guard.optional(check: Check): Check
	return function(v)
		return v == nil or check(v)
	end
end

function Guard.vector3(maxMagnitude: number?): Check
	return function(v)
		if typeof(v) ~= "Vector3" then
			return false
		end
		if not (isFinite(v.X) and isFinite(v.Y) and isFinite(v.Z)) then
			return false
		end
		if maxMagnitude and v.Magnitude > maxMagnitude then
			return false
		end
		return true
	end
end

function Guard.arrayOf(check: Check, maxLen: number): Check
	return function(v)
		if type(v) ~= "table" then
			return false
		end
		local n = 0
		for k, item in v do
			n += 1
			if type(k) ~= "number" or k ~= math.floor(k) or k < 1 or n > maxLen then
				return false
			end
			if not check(item) then
				return false
			end
		end
		return n == #v
	end
end

-- Validates a flat table shape: { field = check }. Unknown keys are rejected.
function Guard.shape(fields: { [string]: Check }): Check
	return function(v)
		if type(v) ~= "table" then
			return false
		end
		for k in v do
			if type(k) ~= "string" or fields[k] == nil then
				return false
			end
		end
		for key, check in fields do
			if not check(v[key]) then
				return false
			end
		end
		return true
	end
end

function Guard.instanceOf(className: string): Check
	return function(v)
		return typeof(v) == "Instance" and v:IsA(className)
	end
end

return Guard
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">MathUtil</string>
            <string name="Source"><![CDATA[--!strict
-- Small numeric helpers shared by client and server.

local MathUtil = {}

function MathUtil.clamp01(x: number): number
	return if x < 0 then 0 elseif x > 1 then 1 else x
end

function MathUtil.lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

function MathUtil.inverseLerp(a: number, b: number, v: number): number
	if a == b then
		return 0
	end
	return (v - a) / (b - a)
end

function MathUtil.remap(v: number, a0: number, a1: number, b0: number, b1: number, clamp: boolean?): number
	local t = MathUtil.inverseLerp(a0, a1, v)
	if clamp then
		t = MathUtil.clamp01(t)
	end
	return b0 + (b1 - b0) * t
end

-- Frame-rate independent exponential smoothing factor.
function MathUtil.damp(speed: number, dt: number): number
	return 1 - math.exp(-speed * dt)
end

function MathUtil.smoothstep(t: number): number
	t = MathUtil.clamp01(t)
	return t * t * (3 - 2 * t)
end

function MathUtil.easeOutBack(t: number): number
	local c1 = 1.70158
	local c3 = c1 + 1
	return 1 + c3 * (t - 1) ^ 3 + c1 * (t - 1) ^ 2
end

function MathUtil.easeOutElastic(t: number): number
	if t <= 0 then
		return 0
	elseif t >= 1 then
		return 1
	end
	local c4 = (2 * math.pi) / 3
	return 2 ^ (-10 * t) * math.sin((t * 10 - 0.75) * c4) + 1
end

function MathUtil.sphereVolume(diameter: number): number
	return math.pi / 6 * diameter * diameter * diameter
end

function MathUtil.diameterFromVolume(volume: number): number
	return (6 * math.max(volume, 0) / math.pi) ^ (1 / 3)
end

function MathUtil.round(x: number, step: number?): number
	local s = step or 1
	return math.floor(x / s + 0.5) * s
end

-- Shortest signed angle difference in radians.
function MathUtil.angleDelta(a: number, b: number): number
	local d = (b - a) % (2 * math.pi)
	if d > math.pi then
		d -= 2 * math.pi
	end
	return d
end

-- Evenly distributed unit vectors on a sphere (returned as x, y, z triples).
function MathUtil.fibonacciSphere(count: number): { { number } }
	local points = table.create(count)
	local golden = math.pi * (3 - math.sqrt(5))
	for i = 0, count - 1 do
		local y = 1 - (i / math.max(count - 1, 1)) * 2
		local radius = math.sqrt(math.max(0, 1 - y * y))
		local theta = golden * i
		table.insert(points, { math.cos(theta) * radius, y, math.sin(theta) * radius })
	end
	return points
end

return MathUtil
]]></string>
          </Properties>
