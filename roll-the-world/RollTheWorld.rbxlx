			cyl(6.4, 0.5, 0, 3.6, 0, "#e63946"),
			blob(7.4, 3.6, 7.4, 0, 4.9, 0, "#e09f3e"),
		}
		for i = 0, 6 do
			local a = i * 0.9
			table.insert(out, blob(0.3, 0.15, 0.6, math.cos(a) * 2, 6.6, math.sin(a) * 2, "#fff8e1", { rot = { 0, i * 40, 0 } }))
		end
		return out
	end)(),
})

