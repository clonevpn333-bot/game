			ramps = { count = 3, width = 46, color = "#deb887", material = "Wood" },
		},
		{
			id = "Island",
			kind = "block",
			placement = "ring",
			ring = { 0.42, 0.62 },
			count = { 1, 2 },
			size = { 200, 110 },
			jitter = 30,
			height = 40,
			top = { color = "#3d405b", material = "Granite" },
			side = { color = "#f2cc8f", material = "Wood" },
			trim = { color = "#d9dee6", height = 3 },
			ramps = { count = 2, width = 40, color = "#deb887", material = "Wood" },
		},
		{
			id = "Table",
			kind = "table",
			placement = "ring",
			ring = { 0.55, 0.8 },
			count = { 1, 1 },
			size = { 230, 150 },
