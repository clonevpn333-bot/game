  <Item class="ServerScriptService" referent="54">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="55">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!nonstrict
-- Single server bootstrap. Services are plain modules with optional init(services) and start().
-- init runs for every service before any start, so services can grab each other in init.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local PhysicsService = game:GetService("PhysicsService")

local Net = require(ReplicatedStorage.Shared.Net)

Net.init()

-- Collision groups: riders (avatars on balls) never collide; client prop hitboxes only hit balls.
local function setupCollisionGroups()
	local groups = { "Balls", "Riders", "Props", "Loot" }
	for _, name in groups do
		if not PhysicsService:IsCollisionGroupRegistered(name) then
			PhysicsService:RegisterCollisionGroup(name)
		end
	end
	for _, other in { "Default", "Balls", "Riders", "Props", "Loot" } do
		PhysicsService:CollisionGroupSetCollidable("Riders", other, false)
	end
	PhysicsService:CollisionGroupSetCollidable("Props", "Default", false)
	PhysicsService:CollisionGroupSetCollidable("Props", "Props", false)
	PhysicsService:CollisionGroupSetCollidable("Props", "Balls", true)
	PhysicsService:CollisionGroupSetCollidable("Loot", "Balls", false)
	PhysicsService:CollisionGroupSetCollidable("Loot", "Props", false)
end
setupCollisionGroups()

local ServicesFolder = script.Services
local ORDER = {
	"LiveConfigService",
	"AnalyticsService",
	"PlayerDataService",
	"WorldService",
	"HubService",
	"BallService",
	"AbsorbService",
	"CritterService",
	"PvpService",
	"MergeService",
	"EventService",
	"RolledexService",
	"RequestService",
	"GalaxyService",
	"ShopService",
	"MonetizationService",
	"SocialService",
	"RoundService",
	"DevService",
}

local services = {}
for _, name in ORDER do
	local module = ServicesFolder:FindFirstChild(name)
	if module then
		local ok, result = pcall(require, module)
		if ok then
			services[name] = result
		else
			warn("[Bootstrap] failed to load " .. name .. ": " .. tostring(result))
		end
	end
end

for _, name in ORDER do
	local service = services[name]
	if service and type(service.init) == "function" then
		local ok, err = pcall(service.init, service, services)
		if not ok then
			warn("[Bootstrap] init failed for " .. name .. ": " .. tostring(err))
		end
	end
end

for _, name in ORDER do
	local service = services[name]
	if service and type(service.start) == "function" then
		task.spawn(function()
			local ok, err = pcall(service.start, service)
			if not ok then
				warn("[Bootstrap] start failed for " .. name .. ": " .. tostring(err))
			end
		end)
	end
end
]]></string>
      </Properties>
      <Item class="Folder" referent="56">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">AbsorbService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Authoritative absorption. Clients send "I touched these props" claims for instant feel; the
-- server validates each claim against its own view of the ball (size, contact, latency reach) and
-- also sweeps every ball itself so nothing depends on a client claiming honestly.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Guard = require(Shared.Util.Guard)
local Signal = require(Shared.Util.Signal)
local Absorb = require(Shared.Logic.Absorb)
local Growth = require(Shared.Logic.Growth)
local PropLibrary = require(Shared.Logic.PropLibrary)
local Tuning = require(Shared.Config.Tuning)
local Cores = require(Shared.Data.Cores)
local Mutations = require(Shared.Data.Mutations)

local AbsorbService = {}
AbsorbService.Absorbed = Signal.new() -- (ballState, propState, info)
AbsorbService.Knocked = Signal.new() -- (ballState, count, reason)

local services
local pendingNotify: { [Player]: { any } } = {}
local scratch = {}

function AbsorbService:init(s)
	services = s
end

local function context()
	local round = services.RoundService
	local events = services.EventService
	return {
		ratioBonus = if events then events:absorbRatioBonus() else 0,
		finalRoll = if round then round:isFinalRoll() else false,
	}
end

local function canPlay(): boolean
	local round = services.RoundService
	return round == nil or round:isPlaying()
end

local function magnetReach(state): number
	local def = Cores.get(state.core)
	local extra = 0
	if def and def.magnetReach then
		extra += def.magnetReach(state.coreLevel)
	end
	if state.magnetUntil and os.clock() < state.magnetUntil then
		extra += Tuning.Absorb.MagnetReach
	end
	return extra
end

local function growthMultiplier(state, prop): number
	local mult = services.BallService:growthMultiplier(state)
	local round = services.RoundService
	if round and round:isFinalRoll() then
		mult *= Tuning.Growth.FinalRollMultiplier
	end
	local events = services.EventService
	if events then
		mult *= events:growthMultiplier(state)
	end
	if state.mergedWith then
		mult *= Tuning.Merge.GrowthPenalty
	end
	if prop.critter then
		mult *= Tuning.Growth.CritterBonus
	end
	return mult
end

-- Core absorb. `reach` is extra contact tolerance in studs. Returns true when absorbed.
function AbsorbService:tryAbsorb(state, prop, reach: number, ctx, segmentFrom: Vector3?): boolean
	if not prop or not state.alive then
		return false
	end
	if prop.loot and os.clock() < prop.activeAt then
		return false
	end
	local d = state.diameter
	if not Absorb.canAbsorbProp(d, prop.absorbSize, prop.landmark, ctx) then
		return false
	end
	local pos = state.part.Position
	local r = d / 2
	local limit = r + prop.radius * (1 - Tuning.Absorb.ContactSlack) + reach
	-- Magnet: much smaller props are pulled in from further away.
	if prop.absorbSize < Absorb.threshold(d, ctx) * 0.4 then
		limit += d * magnetReach(state)
	end
	local distSq
	if segmentFrom then
		distSq = Absorb.segmentDistanceSq(segmentFrom.X, segmentFrom.Y, segmentFrom.Z, pos.X, pos.Y, pos.Z, prop.x, prop.cy, prop.z)
	else
		local dx, dy, dz = prop.x - pos.X, prop.cy - pos.Y, prop.z - pos.Z
		distSq = dx * dx + dy * dy + dz * dz
	end
	if distSq > limit * limit then
		return false
	end
	self:commit(state, prop)
	return true
end

-- Apply an absorb that has already been validated.
function AbsorbService:commit(state, prop)
	local world = services.WorldService
	if not world:removeProp(prop.id, state.userId) then
		return
	end
	local oldD = state.diameter
	local newD = Growth.grow(oldD, prop.volume, { multiplier = growthMultiplier(state, prop) })
	services.BallService:setDiameter(state, newD, "absorb")

	local def = prop.def
	table.insert(state.history, {
		uid = prop.uid,
		mutation = prop.mutation,
		scale = prop.effScale,
		volume = prop.volume,
		color = def.metrics.mainColor,
		t = os.clock(),
	})
	if #state.history > Tuning.Absorb.RecentHistory * 4 then
		table.remove(state.history, 1)
	end
	state.stats.absorbed = (state.stats.absorbed or 0) + 1
	state.composition = state.composition or { tags = {}, colors = {}, total = 0 }
	local comp = state.composition
	comp.total += prop.volume
	for _, tag in def.tags do
		comp.tags[tag] = (comp.tags[tag] or 0) + prop.volume
	end
	comp.colors[def.metrics.mainColor] = (comp.colors[def.metrics.mainColor] or 0) + prop.volume
	if state.notable == nil or prop.absorbSize > (state.notable.size or 0) then
		state.notable = { uid = prop.uid, size = prop.absorbSize, mutation = prop.mutation }
	end

	local info = { isNew = false, isNewVariant = false }
	local rolledex = services.RolledexService
	if rolledex then
		info.isNew, info.isNewVariant = rolledex:discover(state.player, prop.uid, prop.mutation)
	end
	self.Absorbed:Fire(state, prop, info)
	if state.mergedWith then
		-- Merged partners share credit for everything the Mega Ball rolls up.
		local partnerState = { player = state.mergedWith, userId = state.mergedWith.UserId, diameter = newD }
		if rolledex then
			rolledex:discover(state.mergedWith, prop.uid, prop.mutation)
		end
		self.Absorbed:Fire(partnerState, prop, { isNew = false, isNewVariant = false, shared = true })
	end

	local list = pendingNotify[state.player]
	if not list then
		list = {}
		pendingNotify[state.player] = list
	end
	table.insert(list, {
		id = prop.id,
		uid = prop.uid,
		m = prop.mutation,
		s = prop.effScale,
		d = newD,
		g = newD - oldD,
		n = info.isNew,
		v = info.isNewVariant,
	})
	if state.mergedWith then
		local plist = pendingNotify[state.mergedWith] or {}
		pendingNotify[state.mergedWith] = plist
		table.insert(plist, { id = prop.id, uid = prop.uid, m = prop.mutation, s = prop.effScale, d = newD, g = newD - oldD })
	end
end

-- Knock the newest stuck props off a ball as grabbable loot. Returns the number knocked off.
function AbsorbService:knockLoose(state, count: number, awayFrom: Vector3?, reason: string): number
	if count <= 0 or not state.alive then
		return 0
	end
	local world = services.WorldService
	local pos = state.part.Position
	local entries = {}
	local lostVolume = 0
	for _ = 1, count do
		local item = table.remove(state.history)
		if not item then
			break
		end
		lostVolume += item.volume
		local dir
		if awayFrom then
			local flat = Vector3.new(pos.X - awayFrom.X, 0, pos.Z - awayFrom.Z)
			dir = if flat.Magnitude > 0.01 then flat.Unit else Vector3.new(1, 0, 0)
			local angle = (math.random() - 0.5) * 1.6
			dir = CFrame.Angles(0, angle, 0):VectorToWorldSpace(dir)
		else
			local a = math.random() * math.pi * 2
			dir = Vector3.new(math.cos(a), 0, math.sin(a))
		end
		local dist = state.diameter * (0.9 + math.random() * 1.4) + 6
		local land = pos + dir * dist
		local ground = world:groundAt(land.X, land.Z)
		local def = PropLibrary.get(item.uid)
		local mut = Mutations.get(item.mutation)
		local baseScale = item.scale / (if mut then mut.scale else 1)
		if def then
			table.insert(entries, {
				uid = item.uid,
				mutation = item.mutation,
				scale = baseScale,
				from = pos + Vector3.new(0, state.diameter * 0.3, 0),
				to = Vector3.new(land.X, ground, land.Z),
				settle = 0.8,
			})
		end
	end
	if #entries == 0 then
		return 0
	end
	world:spawnLoot(entries)
	-- Knocked props take their volume with them (minus the fill bonus they granted).
	local newD = Growth.shrink(state.diameter, lostVolume * Tuning.Growth.Gain * 0.5)
	services.BallService:setDiameter(state, newD, "knock")
	Net.fireAll("BallFx", "knock", { ball = state.userId, count = #entries })
	self.Knocked:Fire(state, #entries, reason)
	return #entries
end

local function onClaim(player: Player, ids: { number })
	if not canPlay() then
		return
	end
	local state = services.BallService:get(player)
	if not state or not state.alive then
		return
	end
	local world = services.WorldService
	local ctx = context()
	local speed = state.part.AssemblyLinearVelocity.Magnitude
	-- Claims arrive after the client saw contact, so allow generous (but bounded) latency reach.
	local reach = Absorb.latencyReach(speed) * 1.6 + 2 + state.diameter * 0.08
	for _, id in ids do
		local prop = world:get(id)
		if prop then
			AbsorbService:tryAbsorb(state, prop, reach, ctx, nil)
		end
	end
end

local function sweep()
	if not canPlay() then
		return
	end
	local world = services.WorldService
	local ctx = context()
	for _, state in services.BallService:all() do
		local part = state.part
		if part and part.Parent then
			local pos = part.Position
			local from = state.sweepFrom or pos
			local mid = (from + pos) / 2
			local span = (pos - from).Magnitude / 2
			local reachRadius = state.diameter / 2 + span + state.diameter * magnetReach(state) + 4
			table.clear(scratch)
			world:queryNear(mid.X, mid.Z, reachRadius, scratch)
			local reach = Absorb.latencyReach(part.AssemblyLinearVelocity.Magnitude) * 0.5
			for _, id in scratch do
				local prop = world:get(id)
				if prop and not prop.critterHeld then
					AbsorbService:tryAbsorb(state, prop, reach, ctx, from)
				end
			end
			state.sweepFrom = pos
		end
	end
end

local function flushNotifications()
	for player, list in pendingNotify do
		if player.Parent then
			Net.fire("Absorbed", player, list)
		end
	end
	table.clear(pendingNotify)
end

-- Small balls in sparse areas get a gentle rain of tiny props so early growth never stalls.
local function replenish()
	if not canPlay() then
		return
	end
	local world = services.WorldService
	local kit = world.kit
	if not kit or not kit.replenish then
		return
	end
	local uids = {}
	for _, id in kit.replenish do
		local def = PropLibrary.find(kit.id, id)
		if def then
			table.insert(uids, def.uid)
		end
	end
	if #uids == 0 then
		return
	end
	local ctx = context()
	for _, state in services.BallService:all() do
		if state.diameter < 14 and state.part.Parent then
			local pos = state.part.Position
			local near = world:queryNear(pos.X, pos.Z, Tuning.World.ReplenishRadius)
			local edible = 0
			for _, id in near do
				local p = world:get(id)
				if p and Absorb.canAbsorbProp(state.diameter, p.absorbSize, p.landmark, ctx) then
					edible += 1
				end
			end
			if edible < 18 then
				local entries = {}
				for _ = 1, Tuning.World.ReplenishMaxPerTick do
					local a = math.random() * math.pi * 2
					local dist = 8 + math.random() * Tuning.World.ReplenishRadius * 0.7
					local land = Vector3.new(pos.X + math.cos(a) * dist, 0, pos.Z + math.sin(a) * dist)
					local ground = world:groundAt(land.X, land.Z)
					table.insert(entries, {
						uid = uids[math.random(1, #uids)],
						mutation = 0,
						scale = 0.9 + math.random() * 0.25,
						from = Vector3.new(land.X, ground + 60, land.Z),
						to = Vector3.new(land.X, ground, land.Z),
						settle = 0.6,
					})
				end
				world:spawnLoot(entries)
			end
		end
	end
end

function AbsorbService:start()
	Net.on("AbsorbClaim", onClaim, {
		rate = Tuning.Absorb.ClaimRatePerSecond / 4,
		burst = Tuning.Absorb.ClaimBurst / 4,
		guards = { Guard.arrayOf(Guard.integer(1, 65535), 48) },
	})
	services.BallService.ActionUsed:Connect(function(state, action, arg)
		if action == "bonk" and canPlay() then
			local speed = tonumber(arg) or 0
			if speed >= Growth.maxSpeed(state.diameter) * Tuning.Absorb.BonkMinSpeed then
				self:knockLoose(state, Tuning.Absorb.BonkKnockCount, nil, "bonk")
			end
		end
	end)
	local sweepAcc, notifyAcc = 0, 0
	RunService.Heartbeat:Connect(function(dt)
		sweepAcc += dt
		notifyAcc += dt
		if sweepAcc >= 1 / 15 then
			sweepAcc = 0
			sweep()
		end
		if notifyAcc >= 1 / 20 then
			notifyAcc = 0
			flushNotifications()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(Tuning.World.ReplenishInterval)
			local ok, err = pcall(replenish)
			if not ok then
				warn("[Absorb] replenish: " .. tostring(err))
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		pendingNotify[player] = nil
	end)
end

return AbsorbService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">BallService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Owns every player's ball: creation, authoritative size, network ownership, the Roller avatar
-- riding on top, and movement sanity checks (speed/teleport) against client-owned physics.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Guard = require(Shared.Util.Guard)
local Signal = require(Shared.Util.Signal)
local Growth = require(Shared.Logic.Growth)
local Tuning = require(Shared.Config.Tuning)
local Cores = require(Shared.Data.Cores)

local BallService = {}

export type BallState = {
	player: Player,
	userId: number,
	part: Part,
	model: Model,
	diameter: number,
	core: string,
	coreLevel: number,
	shell: string,
	spawnedAt: number,
	shieldUntil: number,
	lastPos: Vector3,
	lastCheck: number,
	strikes: number,
	allowSpeedUntil: number,
	lastDash: number,
	lastHop: number,
	lastBonk: number,
	history: { any }, -- absorbed props, newest last: { uid, mutation, scale, volume, t }
	stats: { [string]: number },
	growthBoosts: { { mult: number, untilT: number, reason: string } },
	riderScale: number,
	mergedWith: Player?,
	isMergeHost: boolean,
	riders: { [Player]: boolean },
	alive: boolean,
}

BallService.states = {} :: { [Player]: BallState }
BallService.folder = nil :: Folder?
BallService.DiameterChanged = Signal.new()
BallService.BallSpawned = Signal.new()
BallService.BallRemoved = Signal.new()
BallService.ActionUsed = Signal.new()

local services

function BallService:init(s)
	services = s
	local folder = Instance.new("Folder")
	folder.Name = "Balls"
	folder.Parent = Workspace
	self.folder = folder
end

local function setCharacterRiderMode(character: Model, riding: boolean)
	for _, d in character:GetDescendants() do
		if d:IsA("BasePart") then
			d.CollisionGroup = if riding then "Riders" else "Default"
			d.Massless = riding
		end
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.PlatformStand = riding
		humanoid.RequiresNeck = false
		humanoid.BreakJointsOnDeath = false
		humanoid.UseJumpPower = false
		humanoid.JumpHeight = if riding then 0 else 7.2
	end
end

function BallService:setRiderMode(player: Player, riding: boolean)
	local character = player.Character
	if character then
		setCharacterRiderMode(character, riding)
	end
end

local function scaleCharacter(state: BallState)
	local character = state.player.Character
	if not character then
		return
	end
	local target = Growth.riderScale(state.diameter)
	if math.abs(target - state.riderScale) / state.riderScale < Tuning.Ball.RiderScaleStep then
		return
	end
	state.riderScale = target
	local ok, err = pcall(function()
		character:ScaleTo(target)
	end)
	if not ok then
		warn("[Ball] ScaleTo failed: " .. tostring(err))
	end
end

function BallService:resetCharacterScale(player: Player)
	local character = player.Character
	if character and math.abs(character:GetScale() - 1) > 1e-3 then
		pcall(function()
			character:ScaleTo(1)
		end)
	end
end

local function physical(diameter: number, core: string)
	local b = Tuning.Ball
	local def = Cores.get(core)
	local density = b.Density * (def and def.densityMult or 1)
	local elasticity = b.Elasticity * (def and def.elasticityMult or 1)
	return PhysicalProperties.new(density, b.Friction, math.clamp(elasticity, 0, 1), 1, 1)
end

function BallService:get(player: Player): BallState?
	return self.states[player]
end

function BallService:getByUserId(userId: number): BallState?
	for _, state in self.states do
		if state.userId == userId then
			return state
		end
	end
	return nil
end

function BallService:all(): { BallState }
	local out = {}
	for _, state in self.states do
		if state.alive then
			table.insert(out, state)
		end
	end
	return out
end

function BallService:spawn(player: Player, position: Vector3, diameter: number, options: { [string]: any }?): BallState?
	local opts: { [string]: any } = options or {}
	self:remove(player, "respawn")
	local character = player.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") then
		return nil
	end
	local data = services.PlayerDataService and services.PlayerDataService:getLoaded(player)
	local core = opts.core or (data and data.cores.equipped) or "Classic"
	local coreLevel = (data and data.cores.owned[core]) or 1
	local shell = (data and data.cosmetics.equipped.shell) or "Classic"

	local model = Instance.new("Model")
	model.Name = "Ball_" .. player.UserId
	model.ModelStreamingMode = Enum.ModelStreamingMode.Persistent

	local part = Instance.new("Part")
	part.Name = "Ball"
	part.Shape = Enum.PartType.Ball
	part.Size = Vector3.one * diameter
	part.CFrame = CFrame.new(position + Vector3.new(0, diameter / 2 + 0.5, 0))
	part.CustomPhysicalProperties = physical(diameter, core)
	part.Transparency = 1
	part.CastShadow = false
	part.CollisionGroup = "Balls"
	part.CanTouch = false
	part.CanQuery = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part:SetAttribute("OwnerId", player.UserId)
	part:SetAttribute("Diameter", diameter)
	part:SetAttribute("Core", core)
	part:SetAttribute("Shell", shell)
	part.Parent = model
	model.PrimaryPart = part
	model.Parent = self.folder

	local now = os.clock()
	local state: BallState = {
		player = player,
		userId = player.UserId,
		part = part,
		model = model,
		diameter = diameter,
		core = core,
		coreLevel = coreLevel,
		shell = shell,
		spawnedAt = now,
		shieldUntil = now + (opts.shield or Tuning.Pvp.SpawnShield),
		lastPos = part.Position,
		lastCheck = now,
		strikes = 0,
		allowSpeedUntil = now + 2,
		lastDash = -math.huge,
		lastHop = -math.huge,
		lastBonk = -math.huge,
		history = opts.history or {},
		stats = opts.stats or { absorbed = 0, playersRolled = 0, timesRolled = 0, discoveries = 0, peak = diameter, bumps = 0, bursts = 0, merges = 0 },
		growthBoosts = opts.growthBoosts or {},
		riderScale = 1,
		mergedWith = nil,
		isMergeHost = false,
		riders = {},
		alive = true,
	}
	part:SetAttribute("ShieldUntil", workspace:GetServerTimeNow() + (state.shieldUntil - now))
	self.states[player] = state

	part:SetNetworkOwner(player)
	self:markRiding(player, true)
	local hrp = character.HumanoidRootPart :: BasePart
	hrp.CFrame = CFrame.new(part.Position + Vector3.new(0, diameter / 2 + 3, 0))
	hrp.AssemblyLinearVelocity = Vector3.zero
	scaleCharacter(state)

	self.BallSpawned:Fire(state)
	Net.fire("PlayerState", player, "Rolling", { ball = model, diameter = diameter, core = core, coreLevel = coreLevel })
	return state
end

function BallService:remove(player: Player, reason: string?)
	local state = self.states[player]
	if not state then
		return
	end
	state.alive = false
	self.states[player] = nil
	self.BallRemoved:Fire(state, reason)
	if state.model then
		state.model:Destroy()
	end
end

-- The only way a ball's size changes. Keeps the ball resting on the ground as it grows.
function BallService:setDiameter(state: BallState, diameter: number, reason: string?)
	local old = state.diameter
	diameter = math.clamp(diameter, Tuning.Ball.StartDiameter * 0.5, Tuning.Ball.MaxDiameter)
	if math.abs(diameter - old) < 1e-4 then
		return
	end
	state.diameter = diameter
	state.stats.peak = math.max(state.stats.peak or 0, diameter)
	local part = state.part
	if part and part.Parent then
		local lift = math.max(0, (diameter - old) / 2)
		part.Size = Vector3.one * diameter
		if lift > 0.05 then
			part.CFrame = part.CFrame + Vector3.new(0, lift, 0)
		end
		part:SetAttribute("Diameter", diameter)
	end
	scaleCharacter(state)
	self.DiameterChanged:Fire(state, old, diameter, reason)
end

-- Product of all active growth multipliers for this ball (comeback, catch-up, events...).
function BallService:growthMultiplier(state: BallState): number
	local now = os.clock()
	local mult = 1
	for i = #state.growthBoosts, 1, -1 do
		local boost = state.growthBoosts[i]
		if now > boost.untilT then
			table.remove(state.growthBoosts, i)
		else
			mult *= boost.mult
		end
	end
	return mult
end

function BallService:addGrowthBoost(state: BallState, mult: number, duration: number, reason: string)
	table.insert(state.growthBoosts, { mult = mult, untilT = os.clock() + duration, reason = reason })
	Net.fire("Toast", state.player, "boost", { mult = mult, duration = duration, reason = reason })
end

function BallService:dashCooldown(state: BallState): number
	local def = Cores.get(state.core)
	local mult = def and def.dashCooldownMult and def.dashCooldownMult(state.coreLevel) or 1
	return Tuning.Ball.DashCooldown * mult
end

-- Server applies a velocity change on the owning client (server can't push client-owned physics).
function BallService:impulse(state: BallState, velocityChange: Vector3)
	state.allowSpeedUntil = os.clock() + 1.5
	Net.fire("Impulse", state.player, velocityChange)
end

function BallService:teleport(state: BallState, position: Vector3)
	local part = state.part
	if not part or not part.Parent then
		return
	end
	state.allowSpeedUntil = os.clock() + 1
	part.AssemblyLinearVelocity = Vector3.zero
	part.AssemblyAngularVelocity = Vector3.zero
	part.CFrame = CFrame.new(position)
	state.lastPos = position
end

local function onAction(player: Player, action: string, arg: any)
	local state = BallService.states[player]
	if not state then
		return
	end
	local now = os.clock()
	if action == "dash" then
		if now - state.lastDash >= BallService:dashCooldown(state) * 0.9 then
			state.lastDash = now
			state.allowSpeedUntil = now + Tuning.Ball.DashDuration + 1
			BallService.ActionUsed:Fire(state, "dash")
		end
	elseif action == "hop" then
		if now - state.lastHop >= Tuning.Ball.HopCooldown * 0.8 then
			state.lastHop = now
			BallService.ActionUsed:Fire(state, "hop")
		end
	elseif action == "bonk" then
		if type(arg) == "number" and now - state.lastBonk >= Tuning.Absorb.BonkCooldown then
			state.lastBonk = now
			BallService.ActionUsed:Fire(state, "bonk", arg)
		end
	end
end

-- Movement sanity: horizontal speed must stay within what the ball could plausibly reach.
local function validate(state: BallState, now: number)
	local part = state.part
	if not part or not part.Parent then
		return
	end
	local pos = part.Position
	if pos.Y < Tuning.Ball.VoidY then
		local spawns = services.WorldService:spawnPoints()
		local target = if #spawns > 0 then spawns[math.random(1, #spawns)] else Vector3.new(0, 60, 0)
		BallService:teleport(state, target + Vector3.new(0, state.diameter / 2 + 2, 0))
		return
	end
	local dt = now - state.lastCheck
	if dt < 0.2 then
		return
	end
	local delta = pos - state.lastPos
	local horizontal = Vector3.new(delta.X, 0, delta.Z).Magnitude / dt
	local limit = Growth.maxSpeed(state.diameter) * 1.6 + 30
	if now < state.allowSpeedUntil then
		limit = limit * 3 + Tuning.Pvp.BurstLaunchSpeed * 2
	end
	if state.mergedWith then
		limit *= 1.5
	end
	if horizontal > limit and not part.Anchored then
		state.strikes += 1
		if state.strikes >= 3 then
			warn(string.format("[Ball] %s moving too fast (%.0f > %.0f); correcting", state.player.Name, horizontal, limit))
			BallService:teleport(state, state.lastPos)
			state.strikes = 0
			if services.AnalyticsService then
				services.AnalyticsService:custom(state.player, "SpeedCorrection", horizontal)
			end
			return
		end
	else
		state.strikes = math.max(0, state.strikes - 0.25)
	end
	state.lastPos = pos
	state.lastCheck = now
end

function BallService:start()
	Net.on("Action", onAction, {
		rate = 20,
		burst = 40,
		guards = { Guard.string(24), Guard.optional(Guard.number(-1e6, 1e6)) },
	})
	RunService.Heartbeat:Connect(function()
		local now = os.clock()
		for _, state in self.states do
			if state.alive then
				validate(state, now)
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		self:remove(player, "left")
	end)
	local function watchCharacter(character: Model)
		character.DescendantAdded:Connect(function(d)
			if d:IsA("BasePart") and character:GetAttribute("Riding") then
				d.CollisionGroup = "Riders"
				d.Massless = true
			end
		end)
	end
	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(watchCharacter)
		if player.Character then
			watchCharacter(player.Character)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
end

-- Exposed for other services so the Riding attribute stays in sync with rider mode.
function BallService:markRiding(player: Player, riding: boolean)
	local character = player.Character
	if character then
		character:SetAttribute("Riding", riding)
	end
	self:setRiderMode(player, riding)
end

return BallService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">CritterService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Simulates living props (ants, ducks, cats, rare roamers): wander, flee from balls that could roll
-- them up, and occasionally stampede. State is replicated compactly; clients animate.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local PropCodec = require(Shared.Util.PropCodec)
local Absorb = require(Shared.Logic.Absorb)
local Tuning = require(Shared.Config.Tuning)

local CritterService = {}

-- state byte sent to clients: 0 idle, 1 walk, 2 flee, 3 stampede
local IDLE, WALK, FLEE, STAMPEDE = 0, 1, 2, 3

local services
local critters: { [number]: any } = {}

function CritterService:init(s)
	services = s
end

local function register(prop)
	local def = prop.def
	local c = def.critter
	critters[prop.id] = {
		id = prop.id,
		speed = c.speed * prop.effScale ^ 0.5,
		fleeMult = c.flee or 1,
		style = c.style,
		homeY = prop.y,
		platform = services.WorldService:platformAt(prop.x, prop.z),
		yaw = prop.yaw,
		state = IDLE,
		target = nil,
		nextThink = 0,
		dirty = true,
		stampedeUntil = 0,
		stampedeDir = nil,
	}
end

local function rebuild()
	table.clear(critters)
	for _, prop in services.WorldService.props do
		if prop.critter then
			register(prop)
		end
	end
end

-- Spawn extra critters for the Stampede event: a herd that runs across the map.
function CritterService:stampede(uids: { number }, count: number)
	local world = services.WorldService
	local kit = world.kit
	if not kit or #uids == 0 then
		return
	end
	local H = kit.arenaHalf
	local side = math.random(0, 3)
	local dir = ({ Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0), Vector3.new(0, 0, 1), Vector3.new(0, 0, -1) })[side + 1]
	local entries = {}
	for _ = 1, count do
		local along = (math.random() - 0.5) * H * 1.4
		local start = -dir * (H - 60) + Vector3.new(dir.Z, 0, dir.X) * along
		local ground = world:groundAt(start.X, start.Z)
		table.insert(entries, {
			uid = uids[math.random(1, #uids)],
			mutation = 0,
			scale = 0.9 + math.random() * 0.3,
			from = Vector3.new(start.X, ground + 80, start.Z),
			to = Vector3.new(start.X, ground, start.Z),
			settle = 0.8,
		})
	end
	local ids = world:spawnLoot(entries)
	for _, id in ids do
		local prop = world:get(id)
		if prop and prop.def.critter then
			prop.expiresAt = os.clock() + 50
			register(prop)
			local c = critters[id]
			c.stampedeUntil = os.clock() + 40
			c.stampedeDir = dir
			c.state = STAMPEDE
		end
	end
end

local function insidePlatform(p, x: number, z: number, margin: number): boolean
	return math.abs(x - p.x) <= p.sx / 2 - margin and math.abs(z - p.z) <= p.sz / 2 - margin
end

-- Keep critters on the surface they started on: floor critters avoid platform blocks,
-- platform critters stay on top.
local function constrain(c, x: number, z: number): (number, number, boolean)
	local world = services.WorldService
	local H = world.kit.arenaHalf - 30
	local bumped = false
	if math.abs(x) > H or math.abs(z) > H then
		x, z = math.clamp(x, -H, H), math.clamp(z, -H, H)
		bumped = true
	end
	if c.platform then
		local p = c.platform
		if not insidePlatform(p, x, z, 3) then
			x = math.clamp(x, p.x - p.sx / 2 + 3, p.x + p.sx / 2 - 3)
			z = math.clamp(z, p.z - p.sz / 2 + 3, p.z + p.sz / 2 - 3)
			bumped = true
		end
	else
		for _, p in world.generation.platforms do
			if p.kind ~= "table" and insidePlatform(p, x, z, -4) then
				return nil :: any, nil :: any, true
			end
		end
	end
	return x, z, bumped
end

local function tick(dt: number)
	local world = services.WorldService
	if not world.kit then
		return
	end
	local balls = services.BallService:all()
	local nowT = os.clock()
	local ctx = { ratioBonus = if services.EventService then services.EventService:absorbRatioBonus() else 0 }
	for id, c in critters do
		local prop = world:get(id)
		if not prop then
			critters[id] = nil
			continue
		end
		local x, z = prop.x, prop.z
		-- Find the most threatening ball (one that can absorb us) within flee range.
		local threat, threatDist = nil, math.huge
		for _, ball in balls do
			if Absorb.canAbsorbProp(ball.diameter, prop.absorbSize, false, ctx) then
				local pos = ball.part.Position
				local dx, dz = x - pos.X, z - pos.Z
				local dist = math.sqrt(dx * dx + dz * dz)
				local range = ball.diameter * Tuning.World.CritterFleeRange * c.fleeMult + prop.radius * 4
				if dist < range and dist < threatDist then
					threat, threatDist = pos, dist
				end
			end
		end
		local moveDir: Vector3? = nil
		local speed = c.speed
		local newState = c.state
		if c.stampedeUntil > nowT and c.stampedeDir then
			moveDir = c.stampedeDir
			speed *= 2.2
			newState = STAMPEDE
		elseif threat ~= nil then
			local t: Vector3 = threat
			local away = Vector3.new(x - t.X, 0, z - t.Z)
			local fleeDir = if away.Magnitude > 0.01 then away.Unit else Vector3.new(1, 0, 0)
			-- A little zig-zag so fleeing reads as panicky-cute rather than robotic.
			local wobble = math.sin(nowT * 6 + id) * 0.5
			moveDir = CFrame.Angles(0, wobble, 0):VectorToWorldSpace(fleeDir)
			speed *= 1.6
			newState = FLEE
		else
			if nowT >= c.nextThink then
				c.nextThink = nowT + 1.5 + math.random() * 3.5
				if math.random() < 0.35 then
					c.target = nil
					newState = IDLE
				else
					local a = math.random() * math.pi * 2
					local r = 10 + math.random() * 40 * prop.effScale
					c.target = Vector3.new(x + math.cos(a) * r, 0, z + math.sin(a) * r)
					newState = WALK
				end
			end
			if c.target then
				local to = Vector3.new(c.target.X - x, 0, c.target.Z - z)
				if to.Magnitude < 1 then
					c.target = nil
					newState = IDLE
				else
					moveDir = to.Unit
				end
			end
		end
		if moveDir then
			local nx, nz = x + moveDir.X * speed * dt, z + moveDir.Z * speed * dt
			local cx, cz, bumped = constrain(c, nx, nz)
			if cx == nil then
				-- Blocked by a counter: turn around.
				c.target = nil
				if c.stampedeDir then
					c.stampedeDir = -c.stampedeDir
				end
			else
				if bumped and c.stampedeUntil > nowT then
					c.stampedeUntil = 0
				end
				local yaw = math.atan2(moveDir.X, moveDir.Z)
				world:moveProp(id, cx, prop.y, cz, yaw)
				c.yaw = yaw
				c.dirty = true
			end
		end
		if newState ~= c.state then
			c.state = newState
			c.dirty = true
		end
	end
end

local function broadcast()
	local records = {}
	for id, c in critters do
		if c.dirty then
			local prop = services.WorldService:get(id)
			if prop then
				table.insert(records, { id = id, x = prop.x, y = prop.y, z = prop.z, yaw = c.yaw, state = c.state })
			end
			c.dirty = false
		end
	end
	if #records > 0 then
		Net.fireAll("CritterState", PropCodec.encodeCritters(records))
	end
end

function CritterService:start()
	services.WorldService.WorldLoaded:Connect(rebuild)
	local rate = 1 / Tuning.World.CritterTickRate
	task.spawn(function()
		local last = os.clock()
		local sendAcc = 0
		while true do
			task.wait(rate)
			local t = os.clock()
			local dt = math.min(t - last, 0.3)
			last = t
			local playing = services.RoundService == nil or services.RoundService:isPlaying()
			if playing then
				local ok, err = pcall(tick, dt)
				if not ok then
					warn("[Critter] tick: " .. tostring(err))
				end
				sendAcc += dt
				if sendAcc >= 1 / 8 then
					sendAcc = 0
					broadcast()
				end
			end
		end
	end)
end

return CritterService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">DevService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Studio-only feel-tuning backend for the in-game Tuning Panel. Lets the developer change tuning
-- values live (applied on server AND the requesting client), resize their ball and restart the
-- round. Completely inert in live servers.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Guard = require(Shared.Util.Guard)
local Tuning = require(Shared.Config.Tuning)

local DevService = {}

local services

-- Only these leaves are tunable from the panel.
DevService.Allowed = {
	["Ball.SpeedBase"] = true,
	["Ball.SpeedExponent"] = true,
	["Ball.AccelTimeSmall"] = true,
	["Ball.AccelTimeHuge"] = true,
	["Ball.TurnAssist"] = true,
	["Ball.BrakeTimeSmall"] = true,
	["Ball.BrakeTimeHuge"] = true,
	["Ball.AirControl"] = true,
	["Ball.HopPerDiameter"] = true,
	["Ball.DashBoost"] = true,
	["Ball.DashCooldown"] = true,
	["Absorb.Ratio"] = true,
	["Growth.Gain"] = true,
	["Growth.EarlyBoost"] = true,
	["Growth.EarlyScale"] = true,
	["Camera.BaseDistance"] = true,
	["Camera.DistancePerDiameter"] = true,
	["Camera.HeightPerDiameter"] = true,
	["Camera.FovSpeedBonus"] = true,
	["Camera.YawSharpness"] = true,
	["Round.Length"] = true,
}

function DevService.apply(path: string, value: number): boolean
	if not DevService.Allowed[path] then
		return false
	end
	local section, key = path:match("^(%w+)%.(%w+)$")
	local tbl = section and (Tuning :: any)[section]
	if not tbl or type(tbl[key]) ~= "number" then
		return false
	end
	tbl[key] = value
	return true
end

local function isDev(player: Player): boolean
	return RunService:IsStudio() and player.Parent ~= nil
end

function DevService:init(s)
	services = s
end

function DevService:start()
	if not RunService:IsStudio() then
		return
	end
	Net.action("DevTuning", Guard.shape({ path = Guard.string(48), value = Guard.number(-1e5, 1e5) }), function(player, payload)
		if not isDev(player) then
			return false
		end
		local ok = DevService.apply(payload.path, payload.value)
		if ok then
			print(string.format("[Tuning] %s = %s", payload.path, tostring(payload.value)))
		end
		return ok
	end, 20)
	Net.action("DevCommand", Guard.shape({ cmd = Guard.string(24), arg = Guard.optional(Guard.number(-1e5, 1e5)) }), function(player, payload)
		if not isDev(player) then
			return false
		end
		local ball = services.BallService:get(player)
		if payload.cmd == "scale" and ball then
			services.BallService:setDiameter(ball, ball.diameter * (payload.arg or 2), "dev")
			return true
		elseif payload.cmd == "reset" and ball then
			services.BallService:setDiameter(ball, Tuning.Ball.StartDiameter, "dev")
			return true
		elseif payload.cmd == "finalroll" and services.RoundService:isPlaying() then
			services.RoundService.endsAt = workspace:GetServerTimeNow() + Tuning.Round.FinalRoll
			return true
		elseif payload.cmd == "endround" and services.RoundService:isPlaying() then
			services.RoundService.endsAt = workspace:GetServerTimeNow() + 1
			return true
		end
		return false
	end, 10)
end

return DevService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">HubService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Builds the hub: a floating island in space where players spend intermission, meet Nana Nova,
-- watch their galaxy, and open the shop / Rolledex / Cores / requests. Also hosts the podium.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared

local HubService = {}

HubService.ORIGIN = Vector3.new(0, 900, 6000)
-- Station panels (shop, Rolledex, cores, galaxy, pass, requests) arrive with the progression
-- milestone; until then their prompts are disabled so nothing in the hub is a dead button.
HubService.StationsEnabled = false
HubService.model = nil :: Model?
HubService.spawns = {} :: { CFrame }
HubService.podium = {} :: { CFrame }

local services

local function part(parent: Instance, props: { [string]: any }): BasePart
	local className = props.ClassName or "Part"
	props.ClassName = nil
	local p = Instance.new(className)
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		(p :: any)[k] = v
	end
	p.Parent = parent
	return p :: BasePart
end

local function cylinderCF(pos: Vector3): CFrame
	return CFrame.new(pos) * CFrame.Angles(0, 0, math.pi / 2)
end

local function station(parent: Instance, origin: Vector3, name: string, label: string, color: Color3, icon: string, facing: Vector3)
	local model = Instance.new("Model")
	model.Name = name
	local look = CFrame.lookAt(origin, origin + facing)
	local base = part(model, {
		Name = "Base",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2, 22, 22),
		CFrame = cylinderCF(origin + Vector3.new(0, 1, 0)),
		Color = color,
		Material = Enum.Material.SmoothPlastic,
	})
	part(model, {
		Name = "Kiosk",
		Size = Vector3.new(14, 9, 6),
		CFrame = look * CFrame.new(0, 6.5, 2),
		Color = Color3.fromRGB(255, 250, 240),
		Material = Enum.Material.SmoothPlastic,
	})
	part(model, {
		Name = "Awning",
		ClassName = "WedgePart",
		Size = Vector3.new(16, 3, 7),
		CFrame = look * CFrame.new(0, 12.5, 1.5) * CFrame.Angles(0, math.pi, 0),
		Color = color,
		Material = Enum.Material.Fabric,
	})
	for i = -1, 1, 2 do
		part(model, {
			Name = "Post",
			Size = Vector3.new(1, 12, 1),
			CFrame = look * CFrame.new(i * 7.2, 7, -1.2),
			Color = Color3.fromRGB(255, 255, 255),
		})
	end
	local glow = part(model, {
		Name = "Glow",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(4, 4, 4),
		CFrame = look * CFrame.new(0, 17, 1),
		Color = color,
		Material = Enum.Material.Neon,
		CanCollide = false,
	})
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 22
	light.Brightness = 1.5
	light.Parent = glow
	local sign = Instance.new("BillboardGui")
	sign.Name = "Sign"
	sign.Size = UDim2.fromOffset(220, 90)
	sign.StudsOffsetWorldSpace = Vector3.new(0, 22, 0)
	sign.AlwaysOnTop = false
	sign.MaxDistance = 180
	sign.LightInfluence = 0
	sign.Adornee = base
	local text = Instance.new("TextLabel")
	text.BackgroundTransparency = 1
	text.Size = UDim2.fromScale(1, 1)
	text.FontFace = Font.new("rbxasset://fonts/families/LuckiestGuy.json")
	text.TextScaled = true
	text.Text = icon .. " " .. label
	text.TextColor3 = Color3.new(1, 1, 1)
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = Color3.fromRGB(38, 26, 74)
	stroke.Parent = text
	text.Parent = sign
	sign.Parent = base
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "Open"
	prompt.ActionText = "Open"
	prompt.ObjectText = label
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 16
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
	prompt.Enabled = HubService.StationsEnabled
	prompt.Parent = base
	model:SetAttribute("Station", name)
	base:SetAttribute("Station", name)
	model.Parent = parent
	return model
end

local function buildIsland(hub: Model, o: Vector3)
	-- Layered floating island: grass top, cream cliff band, rocky underside tapering to a point.
	part(hub, {
		Name = "Top",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(6, 300, 300),
		CFrame = cylinderCF(o + Vector3.new(0, -3, 0)),
		Color = Color3.fromRGB(150, 226, 140),
		Material = Enum.Material.Grass,
	})
	local layers = {
		{ 290, 14, Color3.fromRGB(255, 226, 186), Enum.Material.Sandstone },
		{ 250, 20, Color3.fromRGB(196, 150, 120), Enum.Material.Rock },
		{ 190, 24, Color3.fromRGB(160, 120, 100), Enum.Material.Rock },
		{ 120, 26, Color3.fromRGB(130, 98, 90), Enum.Material.Rock },
		{ 56, 28, Color3.fromRGB(110, 84, 82), Enum.Material.Rock },
	}
	local y = -6
	for _, layer in layers do
		y -= layer[2] / 2
		part(hub, {
			Name = "Cliff",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(layer[2], layer[1], layer[1]),
			CFrame = cylinderCF(o + Vector3.new(0, y, 0)),
			Color = layer[3],
			Material = layer[4],
		})
		y -= layer[2] / 2
	end
	-- Pastel plaza and path ring.
	part(hub, {
		Name = "Plaza",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, 90, 90),
		CFrame = cylinderCF(o + Vector3.new(0, 0.3, 0)),
		Color = Color3.fromRGB(255, 244, 228),
		Material = Enum.Material.Pavement,
	})
	part(hub, {
		Name = "PlazaRing",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.5, 96, 96),
		CFrame = cylinderCF(o + Vector3.new(0, 0.2, 0)),
		Color = Color3.fromRGB(200, 182, 255),
		Material = Enum.Material.SmoothPlastic,
	})
	-- Floating mini rocks around the island.
	for i = 0, 11 do
		local a = i / 12 * math.pi * 2
		local r = 190 + (i % 3) * 22
		local size = 10 + (i % 4) * 6
		part(hub, {
			Name = "Islet",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(size * 0.5, size, size),
			CFrame = cylinderCF(o + Vector3.new(math.cos(a) * r, -20 - (i % 5) * 12, math.sin(a) * r)),
			Color = Color3.fromRGB(150, 226, 140),
			Material = Enum.Material.Grass,
			CanCollide = false,
		})
	end
	-- Cute trees.
	for i = 0, 9 do
		local a = i / 10 * math.pi * 2 + 0.3
		local r = 118 + (i % 2) * 14
		local base = o + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
		part(hub, {
			Name = "Trunk",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(14, 3, 3),
			CFrame = cylinderCF(base + Vector3.new(0, 7, 0)),
			Color = Color3.fromRGB(140, 90, 46),
			Material = Enum.Material.Wood,
		})
		local colors = { Color3.fromRGB(255, 175, 204), Color3.fromRGB(200, 182, 255), Color3.fromRGB(149, 213, 178) }
		part(hub, {
			Name = "Leaves",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(13, 13, 13),
			CFrame = CFrame.new(base + Vector3.new(0, 17, 0)),
			Color = colors[i % 3 + 1],
			Material = Enum.Material.SmoothPlastic,
		})
	end
	-- Invisible guard rail so nobody walks off into space.
	for i = 0, 35 do
		local a = i / 36 * math.pi * 2
		part(hub, {
			Name = "Rail",
			Size = Vector3.new(28, 40, 2),
			CFrame = CFrame.new(o + Vector3.new(math.cos(a) * 149, 20, math.sin(a) * 149)) * CFrame.Angles(0, -a + math.pi / 2, 0),
			Transparency = 1,
			CanQuery = false,
		})
	end
end

local function buildPodium(hub: Model, o: Vector3)
	local center = o + Vector3.new(0, 0, -95)
	local steps = {
		{ 0, 14, Color3.fromRGB(255, 209, 102), "1" },
		{ -16, 9, Color3.fromRGB(205, 214, 230), "2" },
		{ 16, 5, Color3.fromRGB(240, 160, 110), "3" },
	}
	HubService.podium = {}
	for i, s in steps do
		local block = part(hub, {
			Name = "Podium" .. s[4],
			Size = Vector3.new(14, s[2], 12),
			CFrame = CFrame.new(center + Vector3.new(s[1], s[2] / 2, 0)),
			Color = s[3],
			Material = Enum.Material.SmoothPlastic,
		})
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Back
		gui.LightInfluence = 0
		gui.PixelsPerStud = 20
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Size = UDim2.fromScale(1, 1)
		t.Text = s[4]
		t.TextScaled = true
		t.FontFace = Font.new("rbxasset://fonts/families/LuckiestGuy.json")
		t.TextColor3 = Color3.new(1, 1, 1)
		t.Parent = gui
		gui.Parent = block
		HubService.podium[i] = CFrame.new(center + Vector3.new(s[1], s[2] + 3, 0)) * CFrame.Angles(0, math.pi, 0)
	end
	-- Starry arch behind the podium.
	for i = 0, 12 do
		local a = i / 12 * math.pi
		part(hub, {
			Name = "Arch",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(5, 5, 5),
			CFrame = CFrame.new(center + Vector3.new(math.cos(a) * 30, math.sin(a) * 30, -10)),
			Color = if i % 2 == 0 then Color3.fromRGB(255, 209, 102) else Color3.fromRGB(200, 182, 255),
			Material = Enum.Material.Neon,
			CanCollide = false,
		})
	end
	local stage = part(hub, {
		Name = "Stage",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1, 70, 70),
		CFrame = cylinderCF(center + Vector3.new(0, 0.5, 0)),
		Color = Color3.fromRGB(123, 92, 214),
		Material = Enum.Material.SmoothPlastic,
	})
	stage:SetAttribute("PodiumStage", true)
end

-- Nana Nova and her chair are smooth meshes built on each client (editable meshes don't replicate),
-- so the server only places an anchor with her prompt; see client NanaController.
local function buildNana(hub: Model, o: Vector3)
	local spot = o + Vector3.new(0, 0, 30)
	local anchor = part(hub, {
		Name = "NanaAnchor",
		Size = Vector3.new(8, 12, 8),
		CFrame = CFrame.new(spot + Vector3.new(0, 6, 0)) * CFrame.Angles(0, math.pi, 0),
		Transparency = 1,
		CanCollide = true,
	})
	anchor:SetAttribute("NanaNova", true)
	anchor:SetAttribute("Station", "Requests")
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Requests"
	prompt.ObjectText = "Nana Nova"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 18
	prompt.RequiresLineOfSight = false
	prompt.Enabled = HubService.StationsEnabled
	prompt.Parent = anchor
end

local function buildPortals(hub: Model, o: Vector3)
	local Tiers = require(Shared.Config.Tiers)
	for i, tier in Tiers.List do
		local a = math.pi * 0.15 + (i - 1) / (#Tiers.List - 1) * math.pi * 0.7
		local pos = o + Vector3.new(math.cos(a) * 112, 0, math.sin(a) * 112)
		local look = CFrame.lookAt(pos, Vector3.new(o.X, pos.Y, o.Z))
		local ring = Instance.new("Model")
		ring.Name = "Portal" .. tier.key
		for k = 0, 15 do
			local ang = k / 16 * math.pi * 2
			part(ring, {
				Name = "Ring",
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(3, 3, 3),
				CFrame = look * CFrame.new(math.cos(ang) * 9, 10 + math.sin(ang) * 9, 0),
				Color = tier.color,
				Material = if tier.shipped then Enum.Material.Neon else Enum.Material.SmoothPlastic,
				CanCollide = false,
			})
		end
		local film = part(ring, {
			Name = "Film",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.4, 17, 17),
			CFrame = look * CFrame.new(0, 10, 0) * CFrame.Angles(0, math.pi / 2, 0),
			Color = tier.color,
			Material = Enum.Material.Glass,
			Transparency = 0.5,
			CanCollide = false,
		})
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = if tier.shipped then "Info" else "Locked"
		prompt.ObjectText = tier.icon .. " " .. tier.name
		prompt.HoldDuration = 0
		prompt.MaxActivationDistance = 16
		prompt.RequiresLineOfSight = false
		prompt.Enabled = HubService.StationsEnabled
		prompt.Parent = film
		film:SetAttribute("Station", "Tier")
		film:SetAttribute("TierId", tier.id)
		ring.Parent = hub
	end
end

function HubService:build()
	local o = self.ORIGIN
	local hub = Instance.new("Model")
	hub.Name = "Hub"
	hub.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	buildIsland(hub, o)
	buildPodium(hub, o)
	buildNana(hub, o)
	buildPortals(hub, o)
	station(hub, o + Vector3.new(-60, 0, 40), "Shop", "Shop", Color3.fromRGB(255, 122, 69), "🛍️", Vector3.new(1, 0, -0.4))
	station(hub, o + Vector3.new(60, 0, 40), "Rolledex", "Rolledex", Color3.fromRGB(77, 196, 255), "📖", Vector3.new(-1, 0, -0.4))
	station(hub, o + Vector3.new(-78, 0, -20), "Cores", "Cores", Color3.fromRGB(176, 108, 255), "⚙️", Vector3.new(1, 0, 0.3))
	station(hub, o + Vector3.new(78, 0, -20), "Galaxy", "My Galaxy", Color3.fromRGB(255, 214, 64), "🌌", Vector3.new(-1, 0, 0.3))
	station(hub, o + Vector3.new(0, 0, 80), "RollPass", "Roll Pass", Color3.fromRGB(88, 214, 116), "🎟️", Vector3.new(0, 0, -1))

	-- VIP lounge: a raised cloud deck. Non-VIP clients keep the gate solid locally.
	local lounge = part(hub, {
		Name = "VipLounge",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(3, 46, 46),
		CFrame = cylinderCF(o + Vector3.new(100, 1.5, -70)),
		Color = Color3.fromRGB(255, 214, 64),
		Material = Enum.Material.Foil,
	})
	lounge:SetAttribute("VipLounge", true)
	local gate = part(hub, {
		Name = "VipGate",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(40, 48, 48),
		CFrame = cylinderCF(o + Vector3.new(100, 22, -70)) * CFrame.Angles(0, 0, 0),
		Color = Color3.fromRGB(255, 214, 64),
		Material = Enum.Material.ForceField,
		Transparency = 0.6,
	})
	gate:SetAttribute("VipGate", true)

	-- Spawns around the plaza.
	self.spawns = {}
	for i = 0, 11 do
		local a = i / 12 * math.pi * 2
		local pos = o + Vector3.new(math.cos(a) * 34, 3, math.sin(a) * 34 + 10)
		local spawn = Instance.new("SpawnLocation")
		spawn.Name = "HubSpawn"
		spawn.Anchored = true
		spawn.Neutral = true
		spawn.Duration = 0
		spawn.Size = Vector3.new(6, 1, 6)
		spawn.CFrame = CFrame.new(pos - Vector3.new(0, 2.5, 0))
		spawn.Transparency = 1
		spawn.CanCollide = false
		spawn.CanQuery = false
		spawn.Parent = hub
		table.insert(self.spawns, CFrame.lookAt(pos, Vector3.new(o.X, pos.Y, o.Z)))
	end
	hub.Parent = Workspace
	self.model = hub
end

function HubService:init(s)
	services = s
	self:build()
end

function HubService:randomSpawn(): CFrame
	return self.spawns[math.random(1, #self.spawns)]
end

-- Put a player's avatar back in the hub at normal scale, walking normally.
function HubService:sendToHub(player: Player, at: CFrame?)
	local character = player.Character
	if not character then
		return
	end
	services.BallService:markRiding(player, false)
	services.BallService:resetCharacterScale(player)
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if hrp then
		for _, d in character:GetDescendants() do
			if d:IsA("Weld") and d.Name == "RiderWeld" then
				d:Destroy()
			end
		end
		hrp.Anchored = false
		hrp.AssemblyLinearVelocity = Vector3.zero
		character:PivotTo(at or self:randomSpawn())
		pcall(function()
			hrp:SetNetworkOwner(player)
		end)
	end
end

function HubService:start()
	Players.PlayerAdded:Connect(function(player)
		player:SetAttribute("InHub", true)
	end)
end

return HubService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">RoundService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Continuous round loop: Playing (Scramble -> world event -> FINAL ROLL) -> Launch -> Results
-- (podium + awards) -> Intermission (hub) -> next map. Players can drop in at any moment.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)
local Guard = require(Shared.Util.Guard)
local Tuning = require(Shared.Config.Tuning)
local Tiers = require(Shared.Config.Tiers)
local Rarity = require(Shared.Config.Rarity)
local Kits = require(Shared.Data.Kits)
local Mutations = require(Shared.Data.Mutations)
local Awards = require(Shared.Logic.Awards)
local Rewards = require(Shared.Logic.Rewards)

local RoundService = {}

RoundService.state = "Starting" -- Playing | Launch | Results | Intermission
RoundService.phase = "Scramble" -- Scramble | FinalRoll
RoundService.endsAt = 0 -- server time (workspace:GetServerTimeNow())
RoundService.startedAt = 0
RoundService.roundId = 0
RoundService.kitId = nil
RoundService.tier = Tiers.forPlace(game.PlaceId)
RoundService.roundStats = {} :: { [number]: any }
RoundService.playerState = {} :: { [Player]: string }
RoundService.ready = {} :: { [Player]: boolean }
RoundService.lastResults = nil

RoundService.RoundStarted = Signal.new()
RoundService.FinalRollStarted = Signal.new()
RoundService.RoundEnded = Signal.new() -- (statsList)
RoundService.PlayerStateChanged = Signal.new()

local services
local kitQueue = {}
local eventFired = {}

local function now(): number
	return Workspace:GetServerTimeNow()
end

local function roundLength(): number
	local live = services.LiveConfigService
	return (live and live:get("roundLength")) or Tuning.Round.Length
end

function RoundService:init(s)
	services = s
end

function RoundService:isPlaying(): boolean
	return self.state == "Playing"
end

function RoundService:isFinalRoll(): boolean
	return self.state == "Playing" and self.phase == "FinalRoll"
end

function RoundService:timeLeft(): number
	return math.max(0, self.endsAt - now())
end

function RoundService:setPlayerState(player: Player, state: string)
	self.playerState[player] = state
	player:SetAttribute("RollState", state)
	self.PlayerStateChanged:Fire(player, state)
end

-- Per-player stats that survive ball respawns within a round.
function RoundService:stats(player: Player)
	local s = self.roundStats[player.UserId]
	if not s then
		s = {
			userId = player.UserId,
			name = player.DisplayName,
			finalDiameter = 0,
			peakDiameter = 0,
			discoveries = 0,
			newVariants = 0,
			playersRolled = 0,
			timesRolled = 0,
			respawnDiameter = 0,
			comebackRatio = 0,
			requestsCompleted = 0,
			rarestOrder = 0,
			rarestUid = 0,
			rarestMutation = 0,
			rarityPoints = 0,
			absorbed = 0,
			biggestAbsorb = nil,
			joinedAt = os.clock(),
		}
		self.roundStats[player.UserId] = s
	end
	return s
end

function RoundService:snapshot()
	local top = {}
	for _, state in services.BallService:all() do
		table.insert(top, { userId = state.userId, name = state.player.DisplayName, d = state.diameter })
	end
	table.sort(top, function(a, b)
		return a.d > b.d
	end)
	for i = #top, 4, -1 do
		top[i] = nil
	end
	local event = services.EventService and services.EventService:current()
	return {
		state = self.state,
		phase = self.phase,
		endsAt = self.endsAt,
		roundId = self.roundId,
		kitId = self.kitId,
		tier = self.tier.id,
		cmPerStud = self.tier.cmPerStud,
		landmarkId = services.WorldService.landmarkId,
		top = top,
		event = event,
		players = #Players:GetPlayers(),
	}
end

function RoundService:broadcast()
	Net.fireAll("RoundState", self:snapshot())
end

-- Kit rotation: shuffled bag per tier; live config or a private-server host can force a kit.
local function nextKit(): string
	local live = services.LiveConfigService
	local forced = live and live:get("forceKit")
	local social = services.SocialService
	local hostKit = social and social:hostSetting("kit")
	if hostKit and Kits.get(hostKit) then
		return hostKit
	end
	if forced and Kits.get(forced) then
		return forced
	end
	if #kitQueue == 0 then
		for _, kit in Kits.forTier(RoundService.tier.id) do
			table.insert(kitQueue, kit.id)
		end
		if #kitQueue == 0 then
			table.insert(kitQueue, Kits.List[1].id)
		end
		for i = #kitQueue, 2, -1 do
			local j = math.random(1, i)
			kitQueue[i], kitQueue[j] = kitQueue[j], kitQueue[i]
		end
		-- Avoid repeating the previous kit back to back.
		if kitQueue[#kitQueue] == RoundService.kitId and #kitQueue > 1 then
			kitQueue[1], kitQueue[#kitQueue] = kitQueue[#kitQueue], kitQueue[1]
		end
	end
	return table.remove(kitQueue) :: string
end

local function medianDiameter(): number
	local list = {}
	for _, state in services.BallService:all() do
		table.insert(list, state.diameter)
	end
	if #list == 0 then
		return Tuning.Ball.StartDiameter
	end
	table.sort(list)
	return list[math.ceil(#list / 2)]
end

-- Spawn (or respawn) a player into the running round.
function RoundService:spawnIntoRound(player: Player, options: { [string]: any }?)
	local opts: { [string]: any } = options or {}
	if self.state ~= "Playing" then
		return
	end
	local character = player.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") then
		return
	end
	local diameter = opts.diameter or Tuning.Ball.StartDiameter
	local boosts = {}
	if opts.catchUp then
		local median = medianDiameter()
		diameter = math.max(Tuning.Ball.StartDiameter, median * Tuning.Pvp.CatchUpFraction)
		if median > Tuning.Ball.StartDiameter * 2 then
			table.insert(boosts, {
				mult = Tuning.Pvp.CatchUpBoostMultiplier,
				untilT = os.clock() + Tuning.Pvp.CatchUpBoostDuration,
				reason = "catchup",
			})
		end
	end
	local position = opts.position
	if not position then
		local spawns = services.WorldService:spawnPoints()
		position = if #spawns > 0 then spawns[math.random(1, #spawns)] else Vector3.new(0, 50, 0)
		-- Party members spawn next to each other.
		local social = services.SocialService
		local buddy = social and social:spawnBuddy(player)
		if buddy then
			local buddyBall = services.BallService:get(buddy)
			if buddyBall and buddyBall.part.Parent then
				position = buddyBall.part.Position + Vector3.new(math.random(-8, 8), buddyBall.diameter, math.random(-8, 8))
			end
		end
		-- Bigger drop-in balls start a little off the crowded spawn counter.
		if diameter > 20 then
			local a = math.random() * math.pi * 2
			local r = services.WorldService.kit.arenaHalf * 0.5
			local x, z = math.cos(a) * r, math.sin(a) * r
			position = Vector3.new(x, services.WorldService:groundAt(x, z) + 2, z)
		end
	end
	local state = services.BallService:spawn(player, position, diameter, { growthBoosts = boosts, shield = opts.shield })
	if state then
		self:setPlayerState(player, "Rolling")
		local stats = self:stats(player)
		stats.peakDiameter = math.max(stats.peakDiameter, diameter)
		if opts.afterRolled then
			stats.respawnDiameter = diameter
		end
	end
	return state
end

local function moveAllToHub()
	for _, player in Players:GetPlayers() do
		services.BallService:remove(player, "round_end")
		if services.HubService then
			services.HubService:sendToHub(player)
		end
		RoundService:setPlayerState(player, "Hub")
	end
end

function RoundService:startRound()
	self.roundId += 1
	self.kitId = nextKit()
	local seed = math.floor(os.time() % 1000000) * 7919 + self.roundId * 104729
	table.clear(self.roundStats)
	table.clear(eventFired)
	services.WorldService:load(self.kitId, seed)
	self.state = "Playing"
	self.phase = "Scramble"
	self.startedAt = now()
	self.endsAt = self.startedAt + roundLength()
	for _, player in Players:GetPlayers() do
		if self.ready[player] then
			self:spawnIntoRound(player)
		end
	end
	self.RoundStarted:Fire(self.kitId, self.roundId)
	if services.AnalyticsService then
		services.AnalyticsService:serverEvent("RoundStart", { kit = self.kitId, players = #Players:GetPlayers() })
	end
	self:broadcast()
end

local function collectStats(): { any }
	local list = {}
	for _, player in Players:GetPlayers() do
		local stats = RoundService.roundStats[player.UserId]
		if stats then
			local ball = services.BallService:get(player)
			stats.finalDiameter = if ball then ball.diameter else stats.finalDiameter
			stats.name = player.DisplayName
			if stats.timesRolled > 0 and stats.respawnDiameter > 0 then
				stats.comebackRatio = stats.finalDiameter / stats.respawnDiameter
			end
			table.insert(list, stats)
		end
	end
	return list
end

function RoundService:launch()
	self.state = "Launch"
	self.phase = "Launch"
	self.endsAt = now() + Tuning.Round.Launch
	-- Riders and merged partners pop off first so every ball launches clean.
	if services.PvpService then
		services.PvpService:releaseAllRiders("launch")
	end
	if services.MergeService then
		services.MergeService:splitAll("launch")
	end
	local launchList = {}
	for _, state in services.BallService:all() do
		local part = state.part
		if part and part.Parent then
			part.Anchored = true
			state.alive = false -- freezes absorbing, validation and PvP
			table.insert(launchList, {
				userId = state.userId,
				ball = state.model,
				diameter = state.diameter,
				launchFx = state.launchFx,
			})
		end
	end
	local statsList = collectStats()
	-- Planets are born from the launched balls (GalaxyService stores them compactly).
	if services.GalaxyService then
		for _, state in services.BallService.states do
			local ok, err = pcall(services.GalaxyService.createPlanet, services.GalaxyService, state, self.kitId)
			if not ok then
				warn("[Round] planet creation failed: " .. tostring(err))
			end
		end
	end
	Net.fireAll("LaunchSequence", launchList, self.endsAt)
	self:broadcast()
	return statsList
end

function RoundService:results(statsList)
	self.state = "Results"
	self.phase = "Results"
	self.endsAt = now() + Tuning.Round.Results
	local awards = Awards.select(statsList)
	local standings = Awards.standings(statsList)
	local awardCount = {}
	for _, award in awards do
		awardCount[award.userId] = (awardCount[award.userId] or 0) + 1
	end

	-- Stardust for everyone who played.
	local payouts = {}
	for _, stats in statsList do
		local player = Players:GetPlayerByUserId(stats.userId)
		if player then
			local data = services.PlayerDataService
			local monet = services.MonetizationService
			local social = services.SocialService
			local events = services.EventService
			local breakdown = Rewards.round({
				finalDiameter = stats.finalDiameter,
				cmPerStud = self.tier.cmPerStud,
				discoveries = stats.discoveries,
				newVariants = stats.newVariants,
				playersRolled = stats.playersRolled,
				awards = awardCount[stats.userId] or 0,
				rarityPoints = stats.rarityPoints,
				friendsInServer = if social then social:friendCount(player) else 0,
				vip = if monet then monet:hasPass(player, "VIP") else false,
				doubleStardust = if monet then monet:hasPass(player, "DoubleStardust") else false,
				eventMultiplier = if events then events:stardustMultiplier() else 1,
			})
			payouts[stats.userId] = breakdown
			if data then
				data:grantStardust(player, breakdown.total, "Round")
				data:recordRound(player, stats, awardCount[stats.userId] or 0)
			end
		end
	end

	local podium = {}
	for i = 1, math.min(3, #standings) do
		podium[i] = { userId = standings[i].userId, name = standings[i].name, d = standings[i].finalDiameter }
	end
	-- Roll of the Round: the single biggest absorption (players rolled count extra).
	local highlight = nil
	for _, stats in statsList do
		local b = stats.biggestAbsorb
		if b and (highlight == nil or b.score > highlight.score) then
			highlight = b
		end
	end

	moveAllToHub()
	-- Winners stand on the podium.
	if services.HubService then
		for i, entry in podium do
			local player = Players:GetPlayerByUserId(entry.userId)
			if player and services.HubService.podium[i] then
				services.HubService:sendToHub(player, services.HubService.podium[i])
			end
		end
	end

	self.lastResults = {
		roundId = self.roundId,
		kitId = self.kitId,
		awards = awards,
		podium = podium,
		standings = standings,
		highlight = highlight,
		cmPerStud = self.tier.cmPerStud,
	}
	for _, player in Players:GetPlayers() do
		local personal = table.clone(self.lastResults)
		personal.payout = payouts[player.UserId]
		personal.mine = self.roundStats[player.UserId]
		Net.fire("Results", player, personal)
	end
	self.RoundEnded:Fire(statsList, awards)
	self:broadcast()
end

function RoundService:intermission()
	self.state = "Intermission"
	self.phase = "Intermission"
	local social = services.SocialService
	local length = (social and social:hostSetting("intermission")) or Tuning.Round.Intermission
	self.endsAt = now() + length
	self:broadcast()
end

local function waitUntil(t: number)
	while now() < t do
		task.wait(0.25)
	end
end

-- Recording the round's notable moments for awards and the highlight.
local function hookStats()
	services.AbsorbService.Absorbed:Connect(function(state, prop, info)
		local player = state.player
		if not player or not player.Parent then
			return
		end
		local stats = RoundService:stats(player)
		stats.absorbed += 1
		if info.isNew then
			stats.discoveries += 1
		end
		if info.isNewVariant then
			stats.newVariants += 1
		end
		local rarity = Rarity.get(prop.def.rarity)
		local mut = Mutations.get(prop.mutation)
		local order = rarity.order + (if mut then mut.rarityBoost else 0)
		stats.rarityPoints += (Tuning.Rewards.RarityBonus[rarity.id] or 0) * (if mut then mut.stardust else 1)
		if order > stats.rarestOrder then
			stats.rarestOrder = order
			stats.rarestUid = prop.uid
			stats.rarestMutation = prop.mutation
		end
		local score = prop.absorbSize
		if not stats.biggestAbsorb or score > stats.biggestAbsorb.score then
			stats.biggestAbsorb = {
				score = score,
				kind = "prop",
				userId = player.UserId,
				name = player.DisplayName,
				uid = prop.uid,
				mutation = prop.mutation,
				diameter = state.diameter,
			}
		end
		-- Legendary first discoveries are announced to the whole server.
		if info.isNew and rarity.announce then
			Net.fireAll("Announce", "legendary", { name = player.DisplayName, uid = prop.uid, mutation = prop.mutation })
		end
	end)
	services.BallService.DiameterChanged:Connect(function(state, _, new)
		local stats = RoundService:stats(state.player)
		stats.peakDiameter = math.max(stats.peakDiameter, new)
		stats.finalDiameter = new
	end)
end

function RoundService:loop()
	-- First round starts immediately so nobody waits in a lobby.
	self:startRound()
	while true do
		local fireAt = {}
		for _, t in Tuning.Round.EventTimes do
			table.insert(fireAt, self.startedAt + t)
		end
		while now() < self.endsAt do
			local left = self.endsAt - now()
			if self.phase == "Scramble" and left <= Tuning.Round.FinalRoll then
				self.phase = "FinalRoll"
				self.FinalRollStarted:Fire()
				Net.fireAll("Announce", "finalroll", { landmarkId = services.WorldService.landmarkId })
				self:broadcast()
			end
			for i, t in fireAt do
				if not eventFired[i] and now() >= t and services.EventService then
					eventFired[i] = true
					services.EventService:triggerRoundEvent()
				end
			end
			task.wait(0.25)
		end
		local statsList = self:launch()
		waitUntil(self.endsAt)
		self:results(statsList)
		waitUntil(self.endsAt)
		self:intermission()
		waitUntil(self.endsAt)
		self:startRound()
	end
end

local function onReady(player: Player)
	if RoundService.ready[player] then
		return
	end
	RoundService.ready[player] = true
	services.WorldService:sendTo(player)
	Net.fire("RoundState", player, RoundService:snapshot())
	if RoundService.lastResults and RoundService.state ~= "Playing" then
		Net.fire("Results", player, RoundService.lastResults)
	end
	if RoundService.state == "Playing" then
		-- Drop straight in: rolling within seconds of loading.
		local catchUp = (now() - RoundService.startedAt) > 20
		RoundService:spawnIntoRound(player, { catchUp = catchUp })
	else
		RoundService:setPlayerState(player, "Hub")
	end
end

function RoundService:start()
	hookStats()
	Net.action("Ready", Guard.optional(Guard.boolean()), function(player)
		task.spawn(onReady, player)
		return true
	end, 2)
	Players.PlayerRemoving:Connect(function(player)
		self.ready[player] = nil
		self.playerState[player] = nil
	end)
	-- Respawned characters during a round go straight back into a ball.
	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function()
			task.wait(0.2)
			if self.ready[player] and self.state == "Playing" and self.playerState[player] == "Rolling" and not services.BallService:get(player) then
				self:spawnIntoRound(player, { catchUp = true })
			end
		end)
	end)
	-- Periodic HUD refresh (top 3, timer drift).
	task.spawn(function()
		while true do
			task.wait(1)
			if self.state == "Playing" then
				self:broadcast()
			end
		end
	end)
	task.spawn(function()
		-- If anything in the loop throws, log it, reset to a fresh round and keep the server alive.
		while true do
			local ok, err = xpcall(self.loop, debug.traceback, self)
			if not ok then
				warn("[Round] loop error, restarting round: " .. tostring(err))
				task.wait(2)
				pcall(moveAllToHub)
			end
		end
	end)
end

return RoundService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">WorldService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Owns the round's world: builds static geometry from WorldGen, holds the authoritative prop table
-- in a spatial hash, and replicates compact prop state (never prop instances) to clients.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)
local SpatialHash = require(Shared.Util.SpatialHash)
local PropCodec = require(Shared.Util.PropCodec)
local WorldGen = require(Shared.Logic.WorldGen)
local PropLibrary = require(Shared.Logic.PropLibrary)
local Kits = require(Shared.Data.Kits)
local Mutations = require(Shared.Data.Mutations)
local Tuning = require(Shared.Config.Tuning)

local WorldService = {}

export type PropState = {
	id: number,
	uid: number,
	def: any,
	x: number,
	y: number, -- ground level
	z: number,
	cy: number, -- world y of the contact sphere centre
	yaw: number,
	scale: number, -- placement scale (without mutation scale)
	effScale: number, -- placement scale * mutation scale
	mutation: number,
	absorbSize: number,
	radius: number,
	volume: number,
	landmark: boolean,
	critter: boolean,
	loot: boolean,
	activeAt: number, -- loot can't be grabbed until it lands
	expiresAt: number?,
}

WorldService.kit = nil
WorldService.seed = 0
WorldService.generation = nil
WorldService.props = {} :: { [number]: PropState }
WorldService.hash = SpatialHash.new(32)
WorldService.maxRadius = 0
WorldService.nextId = 1
WorldService.landmarkId = 0
WorldService.mapFolder = nil :: Model?
WorldService.roundId = 0

WorldService.PropRemoved = Signal.new()
WorldService.WorldLoaded = Signal.new()

local pendingRemovals = {}
local pendingMutations = {}
local pendingLoot = {}
local lootCount = 0

local function makeState(id: number, uid: number, x: number, y: number, z: number, yaw: number, scale: number, mutation: number, loot: boolean): PropState
	local def = PropLibrary.get(uid)
	local mut = Mutations.get(mutation)
	local eff = scale * (if mut then mut.scale else 1)
	local m = def.metrics
	return {
		id = id,
		uid = uid,
		def = def,
		x = x,
		y = y,
		z = z,
		cy = y + m.centerY * eff,
		yaw = yaw,
		scale = scale,
		effScale = eff,
		mutation = mutation,
		absorbSize = m.absorbSize * eff,
		radius = m.contactRadius * eff,
		volume = m.volume * eff * eff * eff,
		landmark = def.landmark,
		critter = def.critter ~= nil,
		loot = loot,
		activeAt = 0,
		expiresAt = nil,
	}
end

local function hexColor(hex: string): Color3
	return Color3.fromHex(hex)
end

local function buildGeometry(result, kit): Model
	local model = Instance.new("Model")
	model.Name = "Map"
	model.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	for i, g in result.geometry do
		local part
		if g.shape == "Wedge" then
			part = Instance.new("WedgePart")
		else
			part = Instance.new("Part")
			if g.shape == "Cylinder" then
				part.Shape = Enum.PartType.Cylinder
			end
		end
		part.Name = g.kind .. i
		part.Size = Vector3.new(g.size[1], g.size[2], g.size[3])
		part.CFrame = CFrame.new(g.pos[1], g.pos[2], g.pos[3]) * CFrame.Angles(0, math.rad(g.yaw), 0)
		part.Color = hexColor(g.color)
		local okMat, mat = pcall(function()
			return Enum.Material[g.material]
		end)
		part.Material = if okMat and mat then mat else Enum.Material.SmoothPlastic
		part.Anchored = true
		part.CanCollide = g.collide
		part.CanTouch = false
		part.CanQuery = g.collide
		part.Transparency = g.transparency or 0
		part.CastShadow = g.kind ~= "tile" and g.kind ~= "barrier" and g.kind ~= "window"
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		if g.kind == "ramp" or g.kind == "floor" or g.kind == "platform" then
			part:SetAttribute("Walkable", true)
		end
		part.Parent = model
	end
	model:SetAttribute("KitId", kit.id)
	return model
end

function WorldService:applyLighting(kit)
	local l = kit.lighting
	if not l then
		return
	end
	Lighting.ClockTime = l.ClockTime
	Lighting.Brightness = l.Brightness
	Lighting.Ambient = hexColor(l.Ambient)
	Lighting.OutdoorAmbient = hexColor(l.OutdoorAmbient)
	Lighting.ColorShift_Top = hexColor(l.ColorShift_Top)
	Lighting.FogColor = hexColor(l.FogColor)
	Lighting.FogEnd = l.FogEnd
	Lighting.ExposureCompensation = l.ExposureCompensation or 0
	local function ensure(className: string, name: string)
		local inst = Lighting:FindFirstChild(name)
		if not inst then
			inst = Instance.new(className)
			inst.Name = name
			inst.Parent = Lighting
		end
		return inst
	end
	if l.atmosphere then
		local a = ensure("Atmosphere", "KitAtmosphere")
		a.Density = l.atmosphere.Density
		a.Offset = l.atmosphere.Offset
		a.Color = hexColor(l.atmosphere.Color)
		a.Decay = hexColor(l.atmosphere.Decay)
		a.Glare = l.atmosphere.Glare
		a.Haze = l.atmosphere.Haze
	end
	if l.color then
		local c = ensure("ColorCorrectionEffect", "KitColor")
		c.Saturation = l.color.Saturation
		c.Contrast = l.color.Contrast
		c.Brightness = l.color.Brightness
		c.TintColor = hexColor(l.color.TintColor)
	end
	if l.bloom then
		local b = ensure("BloomEffect", "KitBloom")
		b.Intensity = l.bloom.Intensity
		b.Size = l.bloom.Size
		b.Threshold = l.bloom.Threshold
	end
	if l.sunRays then
		local s = ensure("SunRaysEffect", "KitSunRays")
		s.Intensity = l.sunRays.Intensity
		s.Spread = l.sunRays.Spread
	end
end

function WorldService:clear()
	if self.mapFolder then
		self.mapFolder:Destroy()
		self.mapFolder = nil
	end
	self.props = {}
	self.hash = SpatialHash.new(32)
	self.maxRadius = 0
	table.clear(pendingRemovals)
	table.clear(pendingMutations)
	table.clear(pendingLoot)
	lootCount = 0
end

function WorldService:load(kitId: string, seed: number)
	local kit = Kits.get(kitId)
	assert(kit, "unknown kit " .. tostring(kitId))
	self:clear()
	local started = os.clock()
	local result = WorldGen.generate(kit, seed)
	self.kit = kit
	self.seed = seed
	self.generation = result
	self.roundId += 1
	self.landmarkId = result.landmarkId
	for _, p in result.props do
		-- Use the quantised scale so server contact maths matches what clients render.
		local scale = PropCodec.roundTripScale(p.scale)
		local state = makeState(p.id, p.uid, p.x, p.y, p.z, p.yaw, scale, p.mutation, false)
		self.props[p.id] = state
		self.hash:insert(p.id, p.x, p.z, state.radius)
		self.maxRadius = math.max(self.maxRadius, state.radius)
	end
	self.nextId = #result.props + 1
	self.mapFolder = buildGeometry(result, kit)
	self.mapFolder.Parent = Workspace
	self:applyLighting(kit)
	print(string.format("[World] %s seed %d: %d props, %d parts in %.0f ms", kit.id, seed, #result.props, #result.geometry, (os.clock() - started) * 1000))
	for _, player in Players:GetPlayers() do
		self:sendTo(player)
	end
	self.WorldLoaded:Fire(kit, seed)
end

-- Full world snapshot for one client (on load and for players joining mid-round).
function WorldService:sendTo(player: Player)
	if not self.kit then
		return
	end
	local records = {}
	for _, p in self.props do
		table.insert(records, {
			id = p.id,
			uid = p.uid,
			x = p.x,
			y = p.y,
			z = p.z,
			yaw = p.yaw,
			scale = p.scale,
			mutation = p.mutation,
		})
	end
	table.sort(records, function(a, b)
		return a.id < b.id
	end)
	Net.fire("WorldLoad", player, {
		kitId = self.kit.id,
		seed = self.seed,
		roundId = self.roundId,
		landmarkId = self.landmarkId,
		arenaHalf = self.kit.arenaHalf,
		spawnCenter = self.generation.spawnCenter,
	}, PropCodec.encode(records))
end

function WorldService:get(id: number): PropState?
	return self.props[id]
end

function WorldService:queryNear(x: number, z: number, radius: number, out: { number }?): { number }
	return self.hash:query(x, z, radius + self.maxRadius, out)
end

-- Remove a prop for everyone. absorberKey is the absorbing ball's id (0 = vanished).
function WorldService:removeProp(id: number, absorberKey: number)
	local p = self.props[id]
	if not p then
		return nil
	end
	self.props[id] = nil
	self.hash:remove(id)
	if p.loot then
		lootCount -= 1
	end
	table.insert(pendingRemovals, { id, absorberKey })
	self.PropRemoved:Fire(p, absorberKey)
	return p
end

function WorldService:moveProp(id: number, x: number, y: number, z: number, yaw: number?)
	local p = self.props[id]
	if not p then
		return
	end
	p.x, p.y, p.z = x, y, z
	p.cy = y + p.def.metrics.centerY * p.effScale
	if yaw then
		p.yaw = yaw
	end
	self.hash:move(id, x, z, p.radius)
end

function WorldService:setMutation(id: number, mutation: number)
	local p = self.props[id]
	if not p or p.landmark then
		return
	end
	local updated = makeState(p.id, p.uid, p.x, p.y, p.z, p.yaw, p.scale, mutation, p.loot)
	updated.activeAt = p.activeAt
	updated.expiresAt = p.expiresAt
	self.props[id] = updated
	self.hash:move(id, p.x, p.z, updated.radius)
	self.maxRadius = math.max(self.maxRadius, updated.radius)
	table.insert(pendingMutations, { id, mutation })
end

-- Spawns grabbable loot that arcs from `from` to its landing spot. Returns the new ids.
-- entries: { uid, mutation, scale, from: Vector3, to: Vector3 }
function WorldService:spawnLoot(entries: { any }): { number }
	local ids = {}
	local now = os.clock()
	local H = self.kit and self.kit.arenaHalf or 600
	for _, e in entries do
		if lootCount >= Tuning.World.MaxLoot then
			break
		end
		local to: Vector3 = e.to
		local x = math.clamp(to.X, -H + 20, H - 20)
		local z = math.clamp(to.Z, -H + 20, H - 20)
		local id = self.nextId
		self.nextId += 1
		local scale = PropCodec.roundTripScale(e.scale or 1)
		local state = makeState(id, e.uid, x, to.Y, z, math.random() * math.pi * 2, scale, e.mutation or 0, true)
		state.activeAt = now + (e.settle or Tuning.World.LootSettleTime)
		state.expiresAt = now + Tuning.World.LootLifetime
		self.props[id] = state
		self.hash:insert(id, x, z, state.radius)
		self.maxRadius = math.max(self.maxRadius, state.radius)
		lootCount += 1
		local from: Vector3 = e.from
		table.insert(pendingLoot, {
			record = { id = id, uid = e.uid, x = x, y = to.Y, z = z, yaw = state.yaw, scale = scale, mutation = state.mutation },
			from = from,
			settle = e.settle or Tuning.World.LootSettleTime,
		})
		table.insert(ids, id)
	end
	return ids
end

-- Ground height at (x, z) using the generated platform list (used for loot landing and critters).
function WorldService:groundAt(x: number, z: number): number
	local gen = self.generation
	if not gen then
		return 0
	end
	for _, p in gen.platforms do
		if math.abs(x - p.x) <= p.sx / 2 and math.abs(z - p.z) <= p.sz / 2 then
			return p.height
		end
	end
	return 0
end

function WorldService:platformAt(x: number, z: number)
	local gen = self.generation
	if not gen then
		return nil
	end
	for _, p in gen.platforms do
		if math.abs(x - p.x) <= p.sx / 2 and math.abs(z - p.z) <= p.sz / 2 then
			return p
		end
	end
	return nil
end

function WorldService:spawnPoints(): { Vector3 }
	local out = {}
	if self.generation then
		for _, s in self.generation.spawns do
			table.insert(out, Vector3.new(s[1], s[2], s[3]))
		end
	end
	return out
end

local function flush()
	if #pendingRemovals > 0 then
		Net.fireAll("PropsRemoved", pendingRemovals)
		pendingRemovals = {}
	end
	if #pendingMutations > 0 then
		Net.fireAll("PropsMutated", pendingMutations)
		pendingMutations = {}
	end
	if #pendingLoot > 0 then
		local records, origins, settles = {}, {}, {}
		for i, l in pendingLoot do
			records[i] = l.record
			origins[i] = l.from
			settles[i] = l.settle
		end
		Net.fireAll("LootSpawned", PropCodec.encode(records), origins, settles)
		pendingLoot = {}
	end
end

function WorldService:start()
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator >= 1 / 20 then
			accumulator = 0
			flush()
		end
	end)
	-- Expire old loot so the map doesn't fill with debris.
	task.spawn(function()
		while true do
			task.wait(5)
			local now = os.clock()
			for id, p in self.props do
				if p.loot and p.expiresAt and now > p.expiresAt then
					self:removeProp(id, 0)
				end
			end
		end
	end)
	Players.PlayerAdded:Connect(function(player)
		-- Clients request the snapshot once their controllers are ready (see Action "ready").
		player:SetAttribute("WorldRequested", false)
	end)
end

return WorldService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="64">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="65">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <bool name="AutoJumpEnabled">false</bool>
      <float name="CameraMaxZoomDistance">120</float>
      <float name="CameraMinZoomDistance">4</float>
      <float name="CharacterJumpHeight">7.2</float>
      <bool name="CharacterUseJumpPower">false</bool>
      <float name="CharacterWalkSpeed">20</float>
      <bool name="LoadCharacterAppearance">true</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="66">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="67">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Single client bootstrap. Controllers are modules with optional init(controllers) and start().

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")

local Net = require(ReplicatedStorage.Shared.Net)

Net.init()

-- Our own HUD replaces the default backpack/health bars; chat and the player list stay available.
pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
end)

local ORDER = {
	"ClientState",
	"SettingsController",
	"InputController",
	"AudioController",
	"VFXController",
	"WorldController",
	"BallVisualController",
	"MovementController",
	"CameraController",
	"HudController",
	"NanaController",
	"HubController",
	"TuningPanel",
}

local controllers = {}
local folder = script:WaitForChild("Controllers")
for _, name in ORDER do
	local module = folder:FindFirstChild(name)
	if module then
		local ok, result = pcall(require, module)
		if ok then
			controllers[name] = result
		else
			warn("[Client] failed to load " .. name .. ": " .. tostring(result))
		end
	end
end

for _, name in ORDER do
	local c = controllers[name]
	if c and type(c.init) == "function" then
		local ok, err = pcall(c.init, c, controllers)
		if not ok then
			warn("[Client] init failed for " .. name .. ": " .. tostring(err))
		end
	end
end

for _, name in ORDER do
	local c = controllers[name]
	if c and type(c.start) == "function" then
		task.spawn(function()
			local ok, err = pcall(c.start, c)
			if not ok then
				warn("[Client] start failed for " .. name .. ": " .. tostring(err))
			end
		end)
	end
end

-- Tell the server we're ready for the world snapshot and to be dropped into the round.
task.spawn(function()
	local player = Players.LocalPlayer
	if not player.Character then
		player.CharacterAdded:Wait()
	end
	task.wait(0.1)
	Net.request("Ready", true)
end)
]]></string>
        </Properties>
        <Item class="Folder" referent="68">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="69">
            <Properties>
              <string name="Name">AudioController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Sound design: pops pitched by prop size with a rising combo ladder on rapid pickups (the
-- "coin streak" feeling), a rolling loop and growth hum tied to speed/size, stingers for big
-- moments, and kit music with a Final Roll intensity layer. All ids live in Config/Sounds.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Sounds = require(Shared.Config.Sounds)
local Rarity = require(Shared.Config.Rarity)
local Growth = require(Shared.Logic.Growth)
local Absorb = require(Shared.Logic.Absorb)
local Kits = require(Shared.Data.Kits)
local PropLibrary = require(Shared.Logic.PropLibrary)

local AudioController = {}

local controllers
local state, settings
local group: SoundGroup
local musicGroup: SoundGroup
local pools: { [string]: { Sound } } = {}
local loops: { [string]: Sound } = {}
local music: { [string]: Sound } = {}
local currentMusic: string? = nil
local combo = 0
local lastPopAt = 0
local popsThisFrame = 0

function AudioController:init(c)
	controllers = c
end

local function makeSound(name: string, parent: Instance): Sound?
	local def = Sounds[name]
	if not def or def.id == "" then
		return nil
	end
	local s = Instance.new("Sound")
	s.Name = name
	s.SoundId = def.id
	s.Volume = def.volume
	s.Looped = def.looped == true
	s.PlaybackSpeed = def.pitch or 1
	s.SoundGroup = if name:sub(1, 5) == "Music" then musicGroup else group
	s.Parent = parent
	return s
end

-- One-shot. opts: pitch (multiplier), volume (multiplier).
function AudioController:play(name: string, opts: { [string]: number }?)
	local def = Sounds[name]
	if not def or def.id == "" then
		return
	end
	local pool = pools[name]
	if not pool then
		pool = {}
		pools[name] = pool
	end
	local sound
	for _, s in pool do
		if not s.IsPlaying then
			sound = s
			break
		end
	end
	if not sound then
		if #pool >= 6 then
			sound = pool[1]
			sound:Stop()
		else
			sound = makeSound(name, SoundService)
			if not sound then
				return
			end
			table.insert(pool, sound)
		end
	end
	local jitter = def.pitchJitter or 0
	local pitch = (def.pitch or 1) * ((opts and opts.pitch) or 1) * (1 + (math.random() * 2 - 1) * jitter)
	sound.PlaybackSpeed = math.clamp(pitch, 0.2, 4)
	sound.Volume = def.volume * ((opts and opts.volume) or 1)
	sound.TimePosition = 0
	sound:Play()
end

-- Absorb pop: small things squeak high, big things thunk low; quick streaks climb in pitch.
function AudioController:pop(relativeSize: number, isLocal: boolean, distance: number?)
	local now = os.clock()
	popsThisFrame += 1
	if popsThisFrame > 4 then
		return -- a vacuum-cleaner moment would just be noise
	end
	if isLocal then
		if now - lastPopAt < 0.55 then
			combo = math.min(combo + 1, 18)
		else
			combo = 0
		end
		lastPopAt = now
	end
	local base = 1.75 - math.clamp(relativeSize, 0, 1.2) * 0.9
	local ladder = if isLocal then 1 + combo * 0.028 else 1
	local volume = if isLocal then 1 else math.clamp(1 - (distance or 0) / 300, 0.05, 0.5)
	local name = if relativeSize > 0.55 then "PopBig" elseif relativeSize < 0.18 then "PopSoft" else "Pop"
	self:play(name, { pitch = base * ladder, volume = volume })
end

local function setMusic(name: string?)
	if currentMusic == name then
		return
	end
	if currentMusic and music[currentMusic] then
		local old = music[currentMusic]
		task.spawn(function()
			for i = 10, 0, -1 do
				old.Volume = (Sounds[currentMusic or ""] and Sounds[currentMusic].volume or 0.3) * i / 10
				task.wait(0.08)
			end
			old:Stop()
		end)
	end
	currentMusic = name
	if name then
		local s = music[name]
		if not s then
			s = makeSound(name, SoundService)
			if s then
				music[name] = s
			end
		end
		if s then
			s.Volume = Sounds[name].volume
			s:Play()
		end
	end
end

local function updateMusic()
	local round = state.round
	if round.state == "Playing" and state.playerState ~= "Hub" then
		if round.phase == "FinalRoll" and Sounds.MusicFinalRoll.id ~= "" then
			setMusic("MusicFinalRoll")
		else
			local kit = round.kitId and Kits.get(round.kitId)
			setMusic(if kit then kit.music else "MusicHub")
		end
	elseif round.state == "Results" then
		setMusic(if Sounds.MusicResults.id ~= "" then "MusicResults" else "MusicHub")
	else
		setMusic("MusicHub")
	end
end

local function updateLoops(dt: number)
	popsThisFrame = 0
	local roll = loops.RollLoop
	local hum = loops.GrowthHum
	local movement = controllers.MovementController
	if state:isRolling() and movement then
		local frac = math.clamp(movement.speed / math.max(Growth.maxSpeed(state.diameter), 1), 0, 1.5)
		local sizeAlpha = Growth.sizeAlpha(state.diameter)
		if roll then
			local target = if movement.grounded then 0.12 + frac * 0.45 else 0
			roll.Volume += (target - roll.Volume) * math.min(1, dt * 8)
			roll.PlaybackSpeed = (0.75 + frac * 0.6) * (1.3 - sizeAlpha * 0.6)
		end
		if hum then
			hum.Volume += ((0.04 + sizeAlpha * 0.12) * (0.3 + frac) - hum.Volume) * math.min(1, dt * 3)
			hum.PlaybackSpeed = 1.4 - sizeAlpha * 0.9
		end
	else
		if roll then
			roll.Volume *= 0.9
		end
		if hum then
			hum.Volume *= 0.9
		end
	end
end

function AudioController:start()
	state = controllers.ClientState
	settings = controllers.SettingsController
	group = Instance.new("SoundGroup")
	group.Name = "SFX"
	group.Volume = settings.values.sfx
	group.Parent = SoundService
	musicGroup = Instance.new("SoundGroup")
	musicGroup.Name = "Music"
	musicGroup.Volume = settings.values.music
	musicGroup.Parent = SoundService
	settings.Changed:Connect(function(key, value)
		if key == "sfx" then
			group.Volume = value
		elseif key == "music" then
			musicGroup.Volume = value
		end
	end)
	for _, name in { "RollLoop", "GrowthHum" } do
		local s = makeSound(name, SoundService)
		if s then
			s.Volume = 0
			s:Play()
			loops[name] = s
		end
	end

	local world = controllers.WorldController
	world.PropAbsorbed:Connect(function(p, absorberKey, isPrediction)
		local isLocal = absorberKey == state.player.UserId
		if isLocal and not isPrediction then
			return -- already played at prediction time
		end
		local threshold = Absorb.threshold(state.diameter, state:absorbContext())
		local rel = p.absorbSize / math.max(threshold, 0.1)
		local dist = 0
		if not isLocal then
			dist = (Workspace.CurrentCamera.CFrame.Position - Vector3.new(p.x, p.cy, p.z)).Magnitude
			if dist > 300 then
				return
			end
			rel = 0.4
		end
		self:pop(rel, isLocal, dist)
		if isLocal and p.critter then
			self:play("PopSoft", { pitch = 2.2, volume = 0.8 }) -- the critter's happy giggle
		end
	end)
	Net.connect("Absorbed", function(list)
		for _, a in list do
			if a.n then
				self:play("NewDiscovery")
			end
			local def = PropLibrary.get(a.uid)
			if def and Rarity.get(def.rarity).order >= 5 then
				self:play("Legendary")
			end
		end
	end)
	local movement = controllers.MovementController
	movement.Hopped:Connect(function()
		self:play("Hop", { pitch = 1.2 - Growth.sizeAlpha(state.diameter) * 0.5 })
	end)
	movement.Dashed:Connect(function()
		self:play("Dash", { pitch = 1.1 - Growth.sizeAlpha(state.diameter) * 0.4 })
	end)
	movement.Landed:Connect(function(impact)
		self:play("Land", { volume = math.clamp(impact / 80, 0.2, 1), pitch = 1.1 - Growth.sizeAlpha(state.diameter) * 0.5 })
	end)
	movement.Bonked:Connect(function(speed)
		local frac = math.clamp(speed / math.max(Growth.maxSpeed(state.diameter), 1), 0.3, 1.3)
		self:play("Bonk", { volume = frac, pitch = 1.25 - Growth.sizeAlpha(state.diameter) * 0.5 })
	end)
	state.RoundChanged:Connect(function(round, previous)
		if round.phase == "FinalRoll" and previous.phase ~= "FinalRoll" then
			self:play("FinalRoll")
		end
		updateMusic()
	end)
	state.PlayerStateChanged:Connect(updateMusic)
	Net.connect("Announce", function(kind)
		if kind == "legendary" then
			self:play("Legendary", { volume = 0.6 })
		end
	end)
	controllers.WorldController.GoalUnlocked:Connect(function()
		self:play("NewDiscovery", { pitch = 1.1 })
	end)
	RunService.RenderStepped:Connect(updateLoops)
	updateMusic()
end

return AudioController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="70">
            <Properties>
              <string name="Name">BallVisualController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Visuals for every ball: a squashy shell, a lumpy "packed with stuff" core that rolls with the
-- ball, and the props you've rolled up sticking out of it (newest/biggest/rarest kept visible,
-- older small ones folded into the core). All client-built from compact server state.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)
local Spring = require(Shared.Util.Spring)
local MathUtil = require(Shared.Util.MathUtil)
local PropBuilder = require(Shared.PropBuilder)
local Rarity = require(Shared.Config.Rarity)
local Tuning = require(Shared.Config.Tuning)
local Absorb = require(Shared.Logic.Absorb)
local Format = require(Shared.Util.Format)

local BallVisualController = {}
BallVisualController.balls = {} :: { [number]: any }
BallVisualController.Stuck = Signal.new() -- (userId, prop) fired when a prop lands on a ball

local controllers
local state
local folder: Folder
local flights = {} -- props flying into balls
local myUserId = Players.LocalPlayer.UserId
local LUMPS = MathUtil.fibonacciSphere(34)

local PALETTE = {
	Color3.fromRGB(255, 122, 69),
	Color3.fromRGB(77, 196, 255),
	Color3.fromRGB(255, 120, 196),
	Color3.fromRGB(120, 214, 110),
	Color3.fromRGB(176, 108, 255),
	Color3.fromRGB(255, 196, 46),
	Color3.fromRGB(64, 214, 200),
	Color3.fromRGB(255, 92, 120),
}

function BallVisualController:init(c)
	controllers = c
end

local function visualPart(name: string, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Shape = Enum.PartType.Block
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

local function colorFor(userId: number): Color3
	return PALETTE[(userId % #PALETTE) + 1]
end

local function layoutLumps(entry)
	local d = entry.diameter
	local r = d / 2
	for i, lump in entry.lumps do
		local p = LUMPS[i]
		local dir = Vector3.new(p[1], p[2], p[3])
		local size = d * (0.2 + (i % 3) * 0.04)
		lump.Size = Vector3.new(size, size * 0.42, size)
		local cf = CFrame.lookAt(Vector3.zero, dir) * CFrame.Angles(-math.pi / 2, 0, 0)
		local weld = lump:FindFirstChild("W") :: Weld
		if weld then
			weld.C0 = CFrame.new(dir * (r - size * 0.12)) * (cf - cf.Position)
		end
	end
end

local function createEntry(model: Model)
	local part = model:WaitForChild("Ball", 10) :: BasePart?
	if not part then
		return
	end
	local userId = part:GetAttribute("OwnerId") or 0
	if BallVisualController.balls[userId] then
		BallVisualController.balls[userId].folder:Destroy()
	end
	local color = colorFor(userId)
	local vf = Instance.new("Model")
	vf.Name = "BallVisual_" .. userId
	vf.Parent = folder

	local shell = visualPart("Shell", color, Enum.Material.SmoothPlastic)
	shell.Anchored = true
	shell.Reflectance = 0.04
	shell.Parent = vf

	local lumps = {}
	for i = 1, #LUMPS do
		local h, s, v = color:ToHSV()
		local shade = Color3.fromHSV((h + (i % 5 - 2) * 0.015) % 1, math.clamp(s * (0.8 + (i % 3) * 0.12), 0, 1), math.clamp(v * (0.82 + (i % 4) * 0.06), 0, 1))
		local lump = visualPart("Lump", shade)
		lump.Anchored = false
		local weld = Instance.new("Weld")
		weld.Name = "W"
		weld.Part0 = part
		weld.Part1 = lump
		weld.Parent = lump
		lump.Parent = vf
		table.insert(lumps, lump)
	end

	local entry = {
		userId = userId,
		model = model,
		part = part,
		folder = vf,
		shell = shell,
		shellMesh = shell:FindFirstChildOfClass("SpecialMesh"),
		lumps = lumps,
		lumpCursor = 1,
		stuck = {},
		diameter = part:GetAttribute("Diameter") or part.Size.X,
		squash = Spring.new(0, 220, 11),
		color = color,
		isLocal = userId == myUserId,
		shield = nil,
		tag = nil,
	}
	layoutLumps(entry)
	BallVisualController.balls[userId] = entry

	-- Name + size tag for other players' balls (readable PvP at a glance).
	if not entry.isLocal then
		local player = Players:GetPlayerByUserId(userId)
		local gui = Instance.new("BillboardGui")
		gui.Name = "Tag"
		gui.Size = UDim2.fromOffset(160, 44)
		gui.AlwaysOnTop = true
		gui.MaxDistance = 600
		gui.LightInfluence = 0
		gui.Adornee = part
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 1)
		label.FontFace = Font.new("rbxasset://fonts/families/FredokaOne.json")
		label.TextScaled = true
		label.TextColor3 = Color3.new(1, 1, 1)
		label.Text = if player then player.DisplayName else "?"
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 2
		stroke.Color = Color3.fromRGB(38, 26, 74)
		stroke.Parent = label
		label.Parent = gui
		gui.Parent = vf
		entry.tag = { gui = gui, label = label, name = label.Text }
	end

	part:GetAttributeChangedSignal("Diameter"):Connect(function()
		BallVisualController:onDiameter(entry, part:GetAttribute("Diameter"))
	end)
	return entry
end

local function removeEntry(userId: number)
	local entry = BallVisualController.balls[userId]
	if entry then
		entry.folder:Destroy()
		BallVisualController.balls[userId] = nil
	end
end

function BallVisualController:hasBall(userId: number): boolean
	local e = self.balls[userId]
	return e ~= nil and e.part.Parent ~= nil
end

-- Fold a stuck prop into the core: shrink it away and tint a lump with its color.
local function fold(entry, s)
	if s.folded then
		return
	end
	s.folded = true
	local lump = entry.lumps[entry.lumpCursor]
	entry.lumpCursor = entry.lumpCursor % #entry.lumps + 1
	if lump then
		lump.Color = s.color
	end
	if s.model then
		local model = s.model
		s.model = nil
		task.spawn(function()
			for _ = 1, 6 do
				if not model.Parent then
					return
				end
				pcall(function()
					model:ScaleTo(math.max(0.05, model:GetScale() * 0.7))
				end)
				task.wait(0.03)
			end
			model:Destroy()
		end)
	end
end

-- Keep visible stuck props under budget: fold smallest/oldest commons first.
local function enforceBudget(entry)
	local cap = if entry.isLocal then Tuning.Absorb.VisibleStuckLocal else Tuning.Absorb.VisibleStuckRemote
	local q = controllers.SettingsController and controllers.SettingsController:qualityFactor() or 1
	cap = math.floor(cap * math.clamp(q, 0.5, 1.1))
	local visible = {}
	for _, s in entry.stuck do
		if not s.folded and s.model then
			table.insert(visible, s)
		end
	end
	if #visible <= cap then
		return
	end
	table.sort(visible, function(a, b)
		return a.keep < b.keep
	end)
	for i = 1, #visible - cap do
		fold(entry, visible[i])
	end
end

function BallVisualController:onDiameter(entry, d: number)
	local old = entry.diameter
	entry.diameter = d
	layoutLumps(entry)
	local r = d / 2
	for i = #entry.stuck, 1, -1 do
		local s = entry.stuck[i]
		-- Buried by growth: fold into the core.
		if not s.folded and r > s.absorbR + s.size * 0.55 then
			fold(entry, s)
		end
		if s.folded then
			table.remove(entry.stuck, i)
		end
	end
	if d > old then
		entry.squash:impulse(math.clamp((d - old) / old * 6, 0.02, 0.6))
	end
end

local function stickPlacement(entry, s): CFrame
	-- Prop stands out of the surface along `dir`, base embedded ~35% of its height.
	local dir = s.dir
	local up = Vector3.yAxis
	local basis = CFrame.lookAt(Vector3.zero, dir, if math.abs(dir:Dot(up)) > 0.95 then Vector3.xAxis else up) * CFrame.Angles(-math.pi / 2, 0, 0)
	basis = basis * CFrame.Angles(0, s.spin, 0)
	local embed = s.height * 0.38
	return CFrame.new(dir * (s.absorbR - embed)) * basis
end

local function attach(entry, s)
	local model = s.model
	if not model or not model.Parent then
		return
	end
	PropBuilder.makeDynamic(model)
	local hitbox = model.PrimaryPart
	if not hitbox then
		return
	end
	local place = stickPlacement(entry, s)
	local weld = Instance.new("Weld")
	weld.Name = "Stick"
	weld.Part0 = entry.part
	weld.Part1 = hitbox
	weld.C0 = place * hitbox.PivotOffset:Inverse()
	weld.Parent = hitbox
	model.Parent = entry.folder
end

-- A prop starts flying into a ball (absorbed). Takes ownership of p.model.
function BallVisualController:absorbProp(userId: number, p)
	local entry = self.balls[userId]
	local model = p.model
	p.model = nil
	if not entry then
		if model then
			model:Destroy()
		end
		return
	end
	local ballCF = entry.part.CFrame
	local r = entry.diameter / 2
	local fromPos = if model then model:GetPivot().Position else Vector3.new(p.x, p.cy, p.z)
	local toward = Vector3.new(p.x, p.cy, p.z) - ballCF.Position
	local worldDir = if toward.Magnitude > 1e-3 then toward.Unit else Vector3.new(0, 1, 0)
	local rarity = Rarity.get(p.def.rarity)
	local s = {
		propId = p.id,
		uid = p.uid,
		mutation = p.mutation,
		model = model,
		dir = ballCF:VectorToObjectSpace(worldDir),
		spin = math.random() * math.pi * 2,
		absorbR = r,
		size = p.absorbSize,
		height = p.def.metrics.sy * p.eff,
		color = Color3.fromHex(p.def.metrics.mainColor),
		-- Higher keep score = stays visible longer (big and rare things poke out longest).
		keep = p.absorbSize / math.max(entry.diameter, 0.1) * 4 + rarity.order * 0.8 + (if p.mutation > 0 then 2 else 0) + os.clock() * 0.001,
		folded = false,
	}
	table.insert(entry.stuck, s)
	entry.squash:impulse(math.clamp(p.absorbSize / math.max(entry.diameter, 0.1) * 0.5, 0.03, 0.35))
	if model then
		-- Remote balls far from the camera skip the flight and fold straight in (cheap).
		local cam = Workspace.CurrentCamera
		if not entry.isLocal and (cam.CFrame.Position - ballCF.Position).Magnitude > 500 then
			fold(entry, s)
		else
			PropBuilder.makeStatic(model)
			table.insert(flights, { entry = entry, s = s, from = fromPos, t0 = os.clock(), dur = math.clamp(0.1 + p.absorbSize / math.max(entry.diameter, 1) * 0.15, 0.1, 0.22) })
		end
	else
		fold(entry, s)
	end
	enforceBudget(entry)
end

-- Move a predicted prop from one ball to another (another player beat us to it).
function BallVisualController:reassign(fromUserId: number, toUserId: number, p)
	local from = self.balls[fromUserId]
	if not from then
		return
	end
	for i, s in from.stuck do
		if s.propId == p.id then
			table.remove(from.stuck, i)
			if s.model then
				p.model = s.model
				local hb = s.model.PrimaryPart
				local weld = hb and hb:FindFirstChild("Stick")
				if weld then
					weld:Destroy()
				end
				PropBuilder.makeStatic(s.model)
				s.model.Parent = Workspace:FindFirstChild("ClientProps")
			end
			self:absorbProp(toUserId, p)
			return
		end
	end
end

-- Undo a local prediction (server never confirmed it).
function BallVisualController:release(userId: number, p)
	local entry = self.balls[userId]
	if not entry then
		return
	end
	for i, s in entry.stuck do
		if s.propId == p.id then
			table.remove(entry.stuck, i)
			if s.model then
				s.model:Destroy()
			end
			return
		end
	end
end

-- The nearest ball big enough to roll us up (camera leans toward it).
function BallVisualController:nearestThreat(): Vector3?
	local me = self.balls[myUserId]
	if not me or not me.part.Parent then
		return nil
	end
	local best, bestDist = nil, math.huge
	for userId, e in self.balls do
		if userId ~= myUserId and e.part.Parent and Absorb.canAbsorbBall(e.diameter, me.diameter) then
			local dist = (e.part.Position - me.part.Position).Magnitude
			if dist < me.diameter * 8 + e.diameter * 2 and dist < bestDist then
				best, bestDist = e.part.Position, dist
			end
		end
	end
	return best
end

local function onKnock(data)
	local entry = BallVisualController.balls[data.ball]
	if not entry then
		return
	end
	local removed = 0
	for i = #entry.stuck, 1, -1 do
		if removed >= data.count then
			break
		end
		local s = entry.stuck[i]
		if not s.folded then
			if s.model then
				if controllers.VFXController then
					controllers.VFXController:poof(s.model:GetPivot().Position, s.size)
				end
				s.model:Destroy()
				s.model = nil
			end
			table.remove(entry.stuck, i)
			removed += 1
		end
	end
	entry.squash:impulse(0.4)
end

local function updateFlights()
	local now = os.clock()
	for i = #flights, 1, -1 do
		local f = flights[i]
		local s = f.s
		local entry = f.entry
		if not s.model or not entry.part.Parent then
			table.remove(flights, i)
			continue
		end
		local t = math.clamp((now - f.t0) / f.dur, 0, 1)
		local eased = MathUtil.easeOutBack(t)
		local target = entry.part.CFrame * stickPlacement(entry, s)
		local pos = f.from:Lerp(target.Position, math.clamp(eased, 0, 1.08))
		s.model:PivotTo((target - target.Position) + pos)
		if t >= 1 then
			table.remove(flights, i)
			attach(entry, s)
			BallVisualController.Stuck:Fire(entry.userId, s)
		end
	end
end

local function updateShells(dt: number)
	local parts, cfs = {}, {}
	local serverNow = Workspace:GetServerTimeNow()
	for userId, e in BallVisualController.balls do
		if not e.part.Parent then
			removeEntry(userId)
			continue
		end
		local sq = e.squash:step(dt)
		local d = e.diameter
		local shellD = d * 0.97
		e.shell.Size = Vector3.one * shellD
		if e.shellMesh then
			e.shellMesh.Scale = Vector3.new(1 + sq * 0.5, 1 - sq, 1 + sq * 0.5)
		end
		table.insert(parts, e.shell)
		table.insert(cfs, CFrame.new(e.part.Position - Vector3.new(0, sq * d * 0.5, 0)))
		-- Spawn shield bubble.
		local shieldUntil = e.part:GetAttribute("ShieldUntil")
		local shielded = shieldUntil and serverNow < shieldUntil
		if shielded and not e.shield then
			local bubble = visualPart("Shield", Color3.fromRGB(150, 220, 255), Enum.Material.ForceField)
			bubble.Anchored = true
			bubble.Transparency = 0.2
			bubble.Parent = e.folder
			e.shield = bubble
		elseif not shielded and e.shield then
			e.shield:Destroy()
			e.shield = nil
		end
		if e.shield then
			e.shield.Size = Vector3.one * d * 1.35
			table.insert(parts, e.shield)
			table.insert(cfs, CFrame.new(e.part.Position))
		end
		if e.tag then
			e.tag.gui.StudsOffsetWorldSpace = Vector3.new(0, d * 0.7 + 3, 0)
			e.tag.label.Text = e.tag.name .. "  " .. Format.size(d, state.round.cmPerStud or 1)
			local me = BallVisualController.balls[myUserId]
			if me then
				-- Red tag = can roll you up; green = you can roll them up.
				local color = Color3.new(1, 1, 1)
				if Absorb.canAbsorbBall(d, me.diameter) then
					color = Color3.fromRGB(255, 120, 120)
				elseif Absorb.canAbsorbBall(me.diameter, d) then
					color = Color3.fromRGB(140, 255, 150)
				end
				e.tag.label.TextColor3 = color
			end
		end
	end
	if #parts > 0 then
		Workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

function BallVisualController:start()
	state = controllers.ClientState
	folder = Workspace:FindFirstChild("BallVisuals") or Instance.new("Folder")
	folder.Name = "BallVisuals"
	folder.Parent = Workspace
	local balls = Workspace:WaitForChild("Balls")
	local function onAdded(model)
		if model:IsA("Model") then
			task.spawn(createEntry, model)
		end
	end
	balls.ChildAdded:Connect(onAdded)
	for _, m in balls:GetChildren() do
		onAdded(m)
	end
	balls.ChildRemoved:Connect(function(model)
		for userId, e in self.balls do
			if e.model == model then
				removeEntry(userId)
			end
		end
	end)
	Net.connect("BallFx", function(kind, data)
		if kind == "knock" then
			onKnock(data)
		end
	end)
	RunService.RenderStepped:Connect(function(dt)
		updateFlights()
		updateShells(dt)
	end)
end

return BallVisualController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="71">
            <Properties>
              <string name="Name">CameraController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Chase camera that grows with the ball. Auto-follows the direction of travel (no right-click
-- needed), pulls back and rises smoothly as the ball grows, avoids clipping into geometry, leans
-- toward nearby threats, and adds trauma-based shake for big moments (respects reduced motion).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Tuning = require(Shared.Config.Tuning)
local Growth = require(Shared.Logic.Growth)
local Spring = require(Shared.Util.Spring)
local MathUtil = require(Shared.Util.MathUtil)

local CameraController = {}

CameraController.yaw = 0
CameraController.pitch = math.rad(-18)
CameraController.zoom = 1
CameraController.mode = "Default" -- Default | Chase | Launch | Podium | Scripted
CameraController.trauma = 0

local controllers
local state, input, movement, settings
local cam: Camera = Workspace.CurrentCamera
local focus = Vector3.zero
local distSpring = Spring.new(12, 60, 14)
local heightSpring = Spring.new(5, 60, 14)
local fovSpring = Spring.new(70, 120, 16)
local manualUntil = 0
local lastCamPos = nil
local scripted: ((dt: number) -> CFrame?)? = nil
local occlusionParams = RaycastParams.new()
occlusionParams.FilterType = Enum.RaycastFilterType.Exclude
local fovKick = 0

function CameraController:init(c)
	controllers = c
end

-- Add screen shake (0..1). Reduced motion turns it way down.
function CameraController:shake(amount: number)
	local mult = if settings.values.reducedMotion then 0.15 else settings.values.shake
	self.trauma = math.min(1, self.trauma + amount * mult)
end

function CameraController:kickFov(amount: number)
	if not settings.values.reducedMotion then
		fovKick = math.max(fovKick, amount)
	end
end

-- Hand the camera to a scripted sequence (launch, podium). Return nil from fn to release.
function CameraController:playScripted(fn: (dt: number) -> CFrame?)
	scripted = fn
	self.mode = "Scripted"
end

local function refreshFilter()
	local list = {}
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(list, p.Character)
		end
	end
	local balls = Workspace:FindFirstChild("Balls")
	if balls then
		table.insert(list, balls)
	end
	local visuals = Workspace:FindFirstChild("BallVisuals")
	if visuals then
		table.insert(list, visuals)
	end
	local props = Workspace:FindFirstChild("ClientProps")
	if props then
		-- Props never block the view; walls and counters do.
		table.insert(list, props)
	end
	occlusionParams.FilterDescendantsInstances = list
end

local function desiredDistance(d: number): number
	local c = Tuning.Camera
	-- Slightly sub-linear so huge balls still fill a satisfying chunk of the screen.
	return (c.BaseDistance + d * c.DistancePerDiameter * (1 - 0.12 * Growth.sizeAlpha(d))) * CameraController.zoom
end

local function desiredHeight(d: number): number
	local c = Tuning.Camera
	return (c.BaseHeight + d * c.HeightPerDiameter) * CameraController.zoom
end

local function chase(self, dt: number)
	local ball = state.ball
	if not ball or not ball.Parent then
		return
	end
	local c = Tuning.Camera
	local d = state.diameter
	local now = os.clock()
	local sens = settings.values.cameraSensitivity

	-- Manual orbit input.
	local orbit = input:takeOrbit()
	if orbit.Magnitude > 0 then
		self.yaw -= orbit.X * c.DragSensitivity * sens
		self.pitch = math.clamp(self.pitch - orbit.Y * c.DragSensitivity * sens * 0.6, math.rad(-55), math.rad(-5))
		manualUntil = now + c.AutoRecenterDelay
	end
	if input.keyOrbit ~= 0 then
		self.yaw -= input.keyOrbit * c.KeyOrbitSpeed * sens * dt
		manualUntil = now + c.AutoRecenterDelay
	end
	if input.keyPitch ~= 0 then
		self.pitch = math.clamp(self.pitch + input.keyPitch * 1.4 * dt, math.rad(-55), math.rad(-5))
	end
	if input.orbitHeld then
		manualUntil = now + c.AutoRecenterDelay
	end

	-- Auto-follow: swing behind the direction of travel, faster the faster we go.
	local maxSpeed = Growth.maxSpeed(d)
	local speedFrac = math.clamp(movement.speed / math.max(maxSpeed, 1), 0, 1.6)
	if now > manualUntil and speedFrac > 0.15 then
		local h = movement.heading
		local targetYaw = math.atan2(-h.X, -h.Z)
		local delta = MathUtil.angleDelta(self.yaw, targetYaw)
		-- Don't whip around when reversing briefly: follow lazily for large angle changes.
		local sharp = c.YawSharpness * math.clamp(speedFrac, 0.3, 1.2) * (if math.abs(delta) > 2.4 then 0.35 else 1)
		self.yaw += delta * MathUtil.damp(sharp, dt)
		-- Ease pitch back to the default.
		self.pitch += (math.rad(-18) - self.pitch) * MathUtil.damp(0.8, dt)
	end

	distSpring.target = desiredDistance(d)
	heightSpring.target = desiredHeight(d)
	local dist = distSpring:step(dt)
	local height = heightSpring:step(dt)

	-- Smooth focus point slightly above the ball centre; lead a little in the direction of travel.
	local lead = movement.velocity * Vector3.new(1, 0, 1) * 0.08
	local target = ball.Position + Vector3.new(0, d * 0.32, 0) + lead
	focus = focus:Lerp(target, MathUtil.damp(c.FollowSharpness * 2.2, dt))
	if (focus - target).Magnitude > d * 6 + 60 then
		focus = target
	end

	local rot = CFrame.Angles(0, self.yaw, 0) * CFrame.Angles(self.pitch, 0, 0)
	local offset = rot:VectorToWorldSpace(Vector3.new(0, 0, dist)) + Vector3.new(0, height * 0.55, 0)
	local desiredPos = focus + offset

	-- Occlusion: pull the camera in front of walls/counters between it and the ball.
	local toCam = desiredPos - focus
	local hit = Workspace:Raycast(focus, toCam, occlusionParams)
	if hit then
		desiredPos = hit.Position - toCam.Unit * 1.5
	end
	-- Never dip below the floor.
	if desiredPos.Y < focus.Y - d * 0.2 then
		desiredPos = Vector3.new(desiredPos.X, focus.Y - d * 0.2, desiredPos.Z)
	end

	local camPos = desiredPos
	if lastCamPos and (lastCamPos - camPos).Magnitude < d * 10 + 80 then
		camPos = lastCamPos:Lerp(camPos, MathUtil.damp(18, dt))
	end
	lastCamPos = camPos

	-- Lean slightly toward the nearest threat (a ball big enough to roll us up).
	local lookAt = focus
	local threat = controllers.BallVisualController and controllers.BallVisualController:nearestThreat()
	if threat then
		lookAt = lookAt:Lerp(threat, 0.12)
	end

	local cf = CFrame.lookAt(camPos, lookAt)

	-- Shake.
	if self.trauma > 0 then
		local t = os.clock() * 28
		local s = self.trauma * self.trauma * c.ShakeMax
		local angle = CFrame.Angles(math.noise(t, 1) * s * 0.03, math.noise(t, 2) * s * 0.03, math.noise(t, 3) * s * 0.02)
		cf = cf * angle + Vector3.new(math.noise(t, 4), math.noise(t, 5), math.noise(t, 6)) * s * (0.4 + d * 0.01)
		self.trauma = math.max(0, self.trauma - dt * 1.6)
	end

	-- FOV opens up with speed; dashes kick it.
	fovSpring.target = c.FovBase + c.FovSpeedBonus * math.clamp(speedFrac, 0, 1.4) ^ 1.5 + fovKick
	fovKick = math.max(0, fovKick - dt * 30)
	cam.FieldOfView = fovSpring:step(dt)
	cam.CFrame = cf
	cam.Focus = CFrame.new(focus)
end

function CameraController:setMode(mode: string)
	self.mode = mode
	if mode == "Chase" then
		cam.CameraType = Enum.CameraType.Scriptable
		lastCamPos = nil
		local ball = state.ball
		if ball then
			focus = ball.Position
			local d = state.diameter
			distSpring:snap(desiredDistance(d))
			heightSpring:snap(desiredHeight(d))
		end
		refreshFilter()
	elseif mode == "Default" then
		scripted = nil
		cam.CameraType = Enum.CameraType.Custom
		cam.FieldOfView = 70
		local character = Players.LocalPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			cam.CameraSubject = humanoid
		end
	end
end

function CameraController:start()
	state = controllers.ClientState
	input = controllers.InputController
	movement = controllers.MovementController
	settings = controllers.SettingsController
	input.ZoomChanged:Connect(function(delta)
		local c = Tuning.Camera
		self.zoom = math.clamp(self.zoom + delta * 0.08, c.ZoomMin, c.ZoomMax)
	end)
	state.BallChanged:Connect(function(part)
		if part then
			-- Face the way the ball can go: start looking across the counter, not into a wall.
			self.yaw = math.atan2(part.Position.X, part.Position.Z)
			self:setMode("Chase")
		elseif self.mode == "Chase" then
			self:setMode("Default")
		end
	end)
	state.DiameterChanged:Connect(function(new, old)
		-- Big jumps (rolling up a player) get a dramatic pull-back.
		if new > old * 1.15 then
			distSpring:impulse((new - old) * 4)
			self:shake(0.35)
		end
	end)
	movement.Dashed:Connect(function()
		self:kickFov(9)
		self:shake(0.12)
	end)
	movement.Bonked:Connect(function(speed)
		self:shake(math.clamp(speed / math.max(Growth.maxSpeed(state.diameter), 1) * 0.45, 0.1, 0.6))
	end)
	movement.Landed:Connect(function(impact)
		if impact > 40 then
			self:shake(math.clamp(impact / 200, 0.05, 0.3))
		end
	end)
	task.spawn(function()
		while true do
			task.wait(3)
			if self.mode == "Chase" then
				refreshFilter()
			end
		end
	end)
	RunService:BindToRenderStep("RTW_Camera", Enum.RenderPriority.Camera.Value + 1, function(dt)
		if self.mode == "Chase" then
			chase(self, dt)
		elseif self.mode == "Scripted" and scripted then
			local cf = scripted(dt)
			if cf then
				cam.CameraType = Enum.CameraType.Scriptable
				cam.CFrame = cf
			else
				scripted = nil
				self:setMode(if state:isRolling() then "Chase" else "Default")
			end
		end
	end)
end

return CameraController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="72">
            <Properties>
              <string name="Name">ClientState</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Client-side store: round snapshot, local player state, local ball, settings-independent facts.
-- Other controllers read from here and listen to its signals.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)
local Tiers = require(Shared.Config.Tiers)

local ClientState = {}

ClientState.player = Players.LocalPlayer
ClientState.round = ({
	state = "Starting",
	phase = "Scramble",
	endsAt = 0,
	kitId = nil,
	cmPerStud = Tiers.List[1].cmPerStud,
	top = {},
	event = nil,
	landmarkId = 0,
}) :: any
ClientState.playerState = "Loading" -- Loading | Hub | Rolling | Rider | Merged
ClientState.ball = nil :: BasePart? -- local player's physics ball
ClientState.ballModel = nil :: Model?
ClientState.diameter = 3
ClientState.core = "Classic"
ClientState.coreLevel = 1
ClientState.profile = nil
ClientState.lastResults = nil

ClientState.RoundChanged = Signal.new() -- (round, previous)
ClientState.PlayerStateChanged = Signal.new() -- (state, data)
ClientState.DiameterChanged = Signal.new() -- (new, old)
ClientState.BallChanged = Signal.new() -- (ballPart?)
ClientState.ResultsReceived = Signal.new()
ClientState.ProfileChanged = Signal.new()

function ClientState:serverTime(): number
	return Workspace:GetServerTimeNow()
end

function ClientState:timeLeft(): number
	return math.max(0, self.round.endsAt - self:serverTime())
end

function ClientState:isFinalRoll(): boolean
	return self.round.state == "Playing" and self.round.phase == "FinalRoll"
end

function ClientState:isRolling(): boolean
	return self.playerState == "Rolling" and self.ball ~= nil and self.ball.Parent ~= nil
end

function ClientState:absorbContext()
	local event = self.round.event
	return {
		ratioBonus = if event and event.ratioBonus then event.ratioBonus else 0,
		finalRoll = self:isFinalRoll(),
	}
end

local diameterConn

local function bindBall(model: Model?)
	if diameterConn then
		diameterConn:Disconnect()
		diameterConn = nil
	end
	local part = model and (model.PrimaryPart or model:WaitForChild("Ball", 5))
	ClientState.ballModel = model
	ClientState.ball = part
	if part then
		local function update()
			local d = part:GetAttribute("Diameter") or part.Size.X
			local old = ClientState.diameter
			if math.abs(d - old) > 1e-4 then
				ClientState.diameter = d
				ClientState.DiameterChanged:Fire(d, old)
			end
		end
		diameterConn = part:GetAttributeChangedSignal("Diameter"):Connect(update)
		update()
	end
	ClientState.BallChanged:Fire(part)
end

function ClientState:start()
	Net.connect("RoundState", function(snapshot)
		local previous = self.round
		self.round = snapshot
		self.RoundChanged:Fire(snapshot, previous)
	end)
	Net.connect("PlayerState", function(state, data)
		self.playerState = state
		if state == "Rolling" and data then
			self.core = data.core or "Classic"
			self.coreLevel = data.coreLevel or 1
			local model = data.ball
			if not model then
				-- The event can outrun replication of the ball itself; wait for it by name.
				local balls = Workspace:WaitForChild("Balls", 10)
				model = balls and balls:WaitForChild("Ball_" .. self.player.UserId, 10)
			end
			bindBall(model)
		elseif state ~= "Rolling" then
			bindBall(nil)
		end
		self.PlayerStateChanged:Fire(state, data)
	end)
	self.player:GetAttributeChangedSignal("RollState"):Connect(function()
		local state = self.player:GetAttribute("RollState")
		if state and state ~= self.playerState and state ~= "Rolling" then
			self.playerState = state
			bindBall(nil)
			self.PlayerStateChanged:Fire(state, nil)
		end
	end)
	Net.connect("Results", function(results)
		self.lastResults = results
		self.ResultsReceived:Fire(results)
	end)
	Net.connect("ProfileSync", function(profile)
		self.profile = profile
		self.ProfileChanged:Fire(profile)
	end)
end

return ClientState
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="73">
            <Properties>
              <string name="Name">HubController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Hub-side client behaviour: restores normal walking controls/camera in the hub, keeps the VIP
-- lounge gate solid for non-VIPs (character physics is client-owned, so this is enforced locally),
-- and adds a soft ambient particle drift so the floating island feels alive.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local HubController = {}

local controllers

function HubController:init(c)
	controllers = c
end

local function setVipGate(hub: Instance)
	local gate = hub:FindFirstChild("VipGate", true)
	if gate and gate:IsA("BasePart") then
		local isVip = Players.LocalPlayer:GetAttribute("VIP") == true
		gate.CanCollide = not isVip
		gate.Transparency = if isVip then 0.85 else 0.6
	end
end

local function ambience(hub: Instance)
	local top = hub:FindFirstChild("Top")
	if not top or not top:IsA("BasePart") then
		return
	end
	-- Emitting straight from the island part spreads motes over its whole volume.
	local motes = Instance.new("ParticleEmitter")
	motes.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	motes.Color = ColorSequence.new(Color3.fromRGB(255, 236, 170), Color3.fromRGB(200, 182, 255))
	motes.LightEmission = 1
	motes.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 0.6), NumberSequenceKeypoint.new(1, 0) })
	motes.Lifetime = NumberRange.new(4, 7)
	motes.Rate = 14
	motes.Speed = NumberRange.new(0.5, 1.5)
	motes.SpreadAngle = Vector2.new(180, 180)
	motes.Acceleration = Vector3.new(0, 0.6, 0)
	motes.Shape = Enum.ParticleEmitterShape.Box
	motes.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	motes.Parent = top
end

function HubController:start()
	task.spawn(function()
		local hub = Workspace:WaitForChild("Hub", 60)
		if hub then
			setVipGate(hub)
			ambience(hub)
			Players.LocalPlayer:GetAttributeChangedSignal("VIP"):Connect(function()
				setVipGate(hub)
			end)
		end
	end)
	local state = controllers.ClientState
	state.PlayerStateChanged:Connect(function(newState)
		if newState == "Hub" and controllers.CameraController then
			controllers.CameraController:setMode("Default")
		end
	end)
end

return HubController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="74">
            <Properties>
              <string name="Name">HudController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- The gameplay HUD. Minimal and loud: a huge animated size counter (the headline number), the next
-- thing you'll be able to roll up, round timer, top-3, floaters, NEW! toasts, goal-unlocked
-- moments, Final Roll banner, touch Dash/Hop buttons, landmark marker, and the results screen.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Theme = require(Shared.Config.Theme)
local Rarity = require(Shared.Config.Rarity)
local Tuning = require(Shared.Config.Tuning)
local Format = require(Shared.Util.Format)
local Spring = require(Shared.Util.Spring)
local PropLibrary = require(Shared.Logic.PropLibrary)
local Mutations = require(Shared.Data.Mutations)
local Kits = require(Shared.Data.Kits)
local PropBuilder = require(Shared.PropBuilder)
local Ui = require(script.Parent.Parent.UI.Ui)

local HudController = {}

local controllers
local state, settings, input
local gui: ScreenGui
local root: Frame
local sizeValue: TextLabel
local sizeUnit: TextLabel
local sizeScale: UIScale
local sizeSpring = Spring.new(3, 120, 15)
local bumpSpring = Spring.new(1, 260, 12)
local goalCard: Frame
local goalIcon: ViewportFrame
local goalText: TextLabel
local goalBar: Frame
local goalUid: number? = nil
local timerLabel: TextLabel
local timerPill: Frame
local topList: Frame
local floaters: Frame
local toasts: Frame
local banner: TextLabel
local touchButtons: Frame
local dashFill: Frame
local loadingChip: TextLabel
local resultsPanel: Frame? = nil
local pendingGain = 0
local pendingAt = 0
local lastUnit = "cm"
local thumbnails = {}

function HudController:init(c)
	controllers = c
end

local function cmPerStud(): number
	return state.round.cmPerStud or 1
end

local function rarityColor(id: string): Color3
	return Rarity.color(id, settings.values.colorblind)
end

-- Builders --------------------------------------------------------------------------------------

local function buildSizeCounter()
	local holder = Ui.new("Frame", {
		Name = "Size",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 10),
		Size = UDim2.fromOffset(420, 120),
		BackgroundTransparency = 1,
		Parent = root,
	})
	sizeScale = Ui.new("UIScale", { Parent = holder })
	sizeValue = Ui.display("3.0", {
		Name = "Value",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(0.68, 0, 0, 0),
		Size = UDim2.new(0.68, 0, 0, 92),
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = holder,
	})
	Ui.gradient(Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 226, 150)).Parent = sizeValue
	sizeUnit = Ui.display("cm", {
		Name = "Unit",
		Position = UDim2.new(0.7, 0, 0, 32),
		Size = UDim2.new(0.3, 0, 0, 56),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Theme.Color.Accent,
		Parent = holder,
	})
end

local function buildGoalCard()
	goalCard = Ui.new("Frame", {
		Name = "Goal",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 118),
		Size = UDim2.fromOffset(300, 54),
		BackgroundColor3 = Theme.Color.Ink,
		BackgroundTransparency = 0.25,
		Visible = false,
		Parent = root,
	}, { Ui.corner(Theme.Radius.Pill), Ui.stroke(2, Color3.fromRGB(255, 255, 255)) })
	local iconHolder = Ui.new("Frame", {
		Size = UDim2.fromOffset(62, 62),
		Position = UDim2.fromOffset(-8, -6),
		BackgroundColor3 = Theme.Color.PanelAlt,
		Parent = goalCard,
	}, { Ui.corner(Theme.Radius.Pill), Ui.stroke(3, Theme.Color.Ink) })
	goalIcon = Ui.viewport(nil, { Size = UDim2.fromScale(1, 1), Parent = iconHolder })
	Ui.new("TextLabel", {
		Text = "🔒",
		Size = UDim2.fromOffset(22, 22),
		Position = UDim2.new(1, -18, 1, -20),
		TextScaled = true,
		Parent = iconHolder,
	})
	goalText = Ui.new("TextLabel", {
		Position = UDim2.fromOffset(62, 4),
		Size = UDim2.new(1, -74, 0, 26),
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "",
		Parent = goalCard,
	}, { Ui.stroke(2, Theme.Color.Ink) })
	local barBg = Ui.new("Frame", {
		Position = UDim2.fromOffset(62, 34),
		Size = UDim2.new(1, -78, 0, 12),
		BackgroundColor3 = Color3.fromRGB(70, 56, 120),
		Parent = goalCard,
	}, { Ui.corner(Theme.Radius.Pill) })
	goalBar = Ui.new("Frame", {
		Size = UDim2.fromScale(0.3, 1),
		BackgroundColor3 = Theme.Color.Accent,
		Parent = barBg,
	}, { Ui.corner(Theme.Radius.Pill), Ui.gradient(Color3.fromRGB(255, 236, 140), Color3.fromRGB(255, 160, 60), 0) })
end

local function buildTimer()
	timerPill = Ui.new("Frame", {
		Name = "Timer",
		Position = UDim2.fromOffset(16, 14),
		Size = UDim2.fromOffset(150, 52),
		BackgroundColor3 = Theme.Color.Panel,
		Parent = root,
	}, { Ui.corner(Theme.Radius.Pill), Ui.stroke(3, Theme.Color.Ink) })
	Ui.new("TextLabel", {
		Text = "⏱️",
		Size = UDim2.fromOffset(40, 40),
		Position = UDim2.fromOffset(8, 6),
		TextScaled = true,
		Parent = timerPill,
	})
	timerLabel = Ui.new("TextLabel", {
		Text = "7:30",
		Position = UDim2.fromOffset(50, 4),
		Size = UDim2.new(1, -60, 1, -8),
		TextScaled = true,
		FontFace = Theme.Font.Display,
		TextColor3 = Theme.Color.Ink,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = timerPill,
	})
end

local function buildTopList()
	topList = Ui.new("Frame", {
		Name = "Top",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 14),
		Size = UDim2.fromOffset(230, 150),
		BackgroundTransparency = 1,
		Parent = root,
	}, {
		Ui.new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	for i = 1, 3 do
		local row = Ui.new("Frame", {
			Name = "Row" .. i,
			LayoutOrder = i,
			Size = UDim2.new(1, 0, 0, 40),
			BackgroundColor3 = Theme.Color.Ink,
			BackgroundTransparency = 0.3,
			Visible = false,
			Parent = topList,
		}, { Ui.corner(Theme.Radius.Pill) })
		Ui.new("TextLabel", {
			Name = "Rank",
			Text = ({ "🥇", "🥈", "🥉" })[i],
			Size = UDim2.fromOffset(34, 34),
			Position = UDim2.fromOffset(4, 3),
			TextScaled = true,
			Parent = row,
		})
		Ui.new("ImageLabel", {
			Name = "Avatar",
			Size = UDim2.fromOffset(32, 32),
			Position = UDim2.fromOffset(40, 4),
			BackgroundColor3 = Theme.Color.PanelAlt,
			Parent = row,
		}, { Ui.corner(Theme.Radius.Pill) })
		Ui.new("TextLabel", {
			Name = "Name",
			Position = UDim2.fromOffset(78, 2),
			Size = UDim2.new(1, -160, 1, -4),
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = row,
		}, { Ui.stroke(1.5, Theme.Color.Ink) })
		Ui.new("TextLabel", {
			Name = "Size",
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -10, 0, 4),
			Size = UDim2.fromOffset(78, 32),
			TextScaled = true,
			FontFace = Theme.Font.Display,
			TextColor3 = Theme.Color.Accent,
			TextXAlignment = Enum.TextXAlignment.Right,
			Parent = row,
		}, { Ui.stroke(2, Theme.Color.Ink) })
	end
end

local function buildTouchButtons()
	touchButtons = Ui.new("Frame", {
		Name = "Touch",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -24, 1, -28),
		Size = UDim2.fromOffset(250, 220),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = root,
	})
	local dash = Ui.button({
		name = "Dash",
		text = "💨",
		color = Theme.Color.Secondary,
		size = UDim2.fromOffset(122, 122),
		position = UDim2.new(1, 0, 1, 0),
		anchor = Vector2.new(1, 1),
		radius = Theme.Radius.Pill,
		parent = touchButtons,
		onClick = function()
			input:press("Dash")
		end,
	})
	dashFill = Ui.new("Frame", {
		Name = "Cooldown",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromScale(1, 0),
		BackgroundColor3 = Theme.Color.Ink,
		BackgroundTransparency = 0.45,
		ZIndex = 3,
		Parent = dash,
	}, { Ui.corner(Theme.Radius.Pill) })
	Ui.button({
		name = "Hop",
		text = "⬆️",
		color = Theme.Color.Good,
		size = UDim2.fromOffset(96, 96),
		position = UDim2.new(1, -140, 1, -10),
		anchor = Vector2.new(1, 1),
		radius = Theme.Radius.Pill,
		parent = touchButtons,
		onClick = function()
			input:press("Hop")
		end,
	})
end

local function buildContainers()
	floaters = Ui.new("Frame", {
		Name = "Floaters",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.62),
		Size = UDim2.fromOffset(300, 200),
		BackgroundTransparency = 1,
		Parent = root,
	})
	toasts = Ui.new("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -16, 0.5, 0),
		Size = UDim2.fromOffset(280, 360),
		BackgroundTransparency = 1,
		Parent = root,
	}, {
		Ui.new("UIListLayout", {
			Padding = UDim.new(0, 8),
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	banner = Ui.display("", {
		Name = "Banner",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.34),
		Size = UDim2.fromOffset(760, 110),
		TextTransparency = 1,
		Parent = root,
	})
	loadingChip = Ui.new("TextLabel", {
		Name = "Loading",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -16),
		Size = UDim2.fromOffset(300, 30),
		TextScaled = true,
		Text = "",
		Visible = false,
		Parent = root,
	}, { Ui.stroke(2, Theme.Color.Ink) })
end

-- Behaviours ------------------------------------------------------------------------------------

function HudController:showBanner(text: string, color: Color3?, duration: number?)
	banner.Text = text
	banner.TextColor3 = color or Theme.Color.White
	banner.TextTransparency = 0
	local stroke = banner:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Transparency = 0
	end
	local s = banner:FindFirstChildOfClass("UIScale") or Ui.new("UIScale", { Parent = banner })
	s.Scale = 0.4
	Ui.tween(s, Theme.Tween.Bounce, { Scale = 1 })
	task.delay(duration or 2.2, function()
		if banner.Text == text then
			Ui.tween(banner, Theme.Tween.Smooth, { TextTransparency = 1 })
			if stroke then
				Ui.tween(stroke, Theme.Tween.Smooth, { Transparency = 1 })
			end
		end
	end)
end

local function floater(text: string, color: Color3, big: boolean?)
	local label = Ui.display(text, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5 + (math.random() - 0.5) * 0.4, 0, 0.8, 0),
		Size = UDim2.fromOffset(if big then 260 else 160, if big then 54 else 34),
		TextColor3 = color,
		Parent = floaters,
	})
	local s = Ui.new("UIScale", { Scale = 0.5, Parent = label })
	Ui.tween(s, Theme.Tween.Pop, { Scale = 1 })
	Ui.tween(label, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Position = label.Position - UDim2.fromScale(0, 0.55),
	})
	task.delay(0.5, function()
		Ui.tween(label, Theme.Tween.Smooth, { TextTransparency = 1 })
		local stroke = label:FindFirstChildOfClass("UIStroke")
		if stroke then
			Ui.tween(stroke, Theme.Tween.Smooth, { Transparency = 1 })
		end
	end)
	task.delay(1, function()
		label:Destroy()
	end)
end

local function propModel(uid: number): Model?
	if PropBuilder.hasTemplate(uid) then
		return PropBuilder.template(uid)
	end
	return nil
end

function HudController:toast(uid: number, mutation: number, headline: string)
	local def = PropLibrary.get(uid)
	if not def then
		return
	end
	local mut = Mutations.get(mutation)
	local color = rarityColor(def.rarity)
	local card = Ui.new("Frame", {
		Size = UDim2.fromOffset(270, 76),
		BackgroundColor3 = Theme.Color.Panel,
		LayoutOrder = math.floor(os.clock() * 100),
		Parent = toasts,
	}, { Ui.corner(Theme.Radius.Medium), Ui.stroke(3, Theme.Color.Ink) })
	Ui.new("Frame", {
		Size = UDim2.new(0, 10, 1, 0),
		BackgroundColor3 = color,
		Parent = card,
	}, { Ui.corner(Theme.Radius.Medium) })
	Ui.viewport(propModel(uid), { Size = UDim2.fromOffset(64, 64), Position = UDim2.fromOffset(14, 6), Parent = card })
	Ui.new("TextLabel", {
		Text = headline,
		Position = UDim2.fromOffset(84, 6),
		Size = UDim2.new(1, -92, 0, 26),
		TextScaled = true,
		FontFace = Theme.Font.Display,
		TextColor3 = color,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = card,
	}, { Ui.stroke(2, Theme.Color.Ink) })
	Ui.new("TextLabel", {
		Text = (if mut then mut.name .. " " else "") .. def.name,
		Position = UDim2.fromOffset(84, 34),
		Size = UDim2.new(1, -92, 0, 22),
		TextScaled = true,
		TextColor3 = Theme.Color.Ink,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = card,
	})
	Ui.new("TextLabel", {
		Text = Rarity.get(def.rarity).glyph .. " " .. def.rarity,
		Position = UDim2.fromOffset(84, 56),
		Size = UDim2.new(1, -92, 0, 16),
		TextScaled = true,
		TextColor3 = color,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = card,
	}, { Ui.stroke(1, Theme.Color.Ink) })
	local s = Ui.new("UIScale", { Scale = 0.3, Parent = card })
	Ui.tween(s, Theme.Tween.Bounce, { Scale = 1 })
	task.delay(3, function()
		Ui.tween(s, Theme.Tween.Smooth, { Scale = 0 })
		task.wait(0.3)
		card:Destroy()
	end)
	-- Keep the stack short.
	local cards = {}
	for _, c in toasts:GetChildren() do
		if c:IsA("Frame") then
			table.insert(cards, c)
		end
	end
	if #cards > 4 then
		table.sort(cards, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		cards[1]:Destroy()
	end
end

-- "You can roll up TOASTERS now!" — the core growth reward, wordless-friendly (icon + check).
function HudController:goalUnlocked(uid: number)
	local def = PropLibrary.get(uid)
	if not def then
		return
	end
	local card = Ui.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromOffset(340, 120),
		BackgroundColor3 = Theme.Color.Accent,
		Parent = root,
	}, { Ui.corner(Theme.Radius.Large), Ui.stroke(4, Theme.Color.Ink) })
	Ui.viewport(propModel(uid), { Size = UDim2.fromOffset(110, 110), Position = UDim2.fromOffset(6, 5), Parent = card })
	Ui.display("✓ " .. def.name, {
		Position = UDim2.fromOffset(118, 16),
		Size = UDim2.new(1, -128, 0, 50),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = card,
	})
	Ui.new("TextLabel", {
		Text = "can be rolled up now! 🟢",
		Position = UDim2.fromOffset(118, 68),
		Size = UDim2.new(1, -128, 0, 30),
		TextScaled = true,
		TextColor3 = Theme.Color.Ink,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = card,
	})
	local s = Ui.new("UIScale", { Scale = 0.2, Parent = card })
	Ui.tween(s, Theme.Tween.Bounce, { Scale = 1 })
	task.delay(1.6, function()
		Ui.tween(s, Theme.Tween.Smooth, { Scale = 0 })
		Ui.tween(card, Theme.Tween.Smooth, { Position = UDim2.fromScale(0.5, 0.2) })
		task.wait(0.3)
		card:Destroy()
	end)
	bumpSpring:impulse(6)
end

local function setTopRow(i: number, entry)
	local row = topList:FindFirstChild("Row" .. i)
	if not row then
		return
	end
	if not entry then
		row.Visible = false
		return
	end
	row.Visible = true
	row.BackgroundColor3 = if entry.userId == state.player.UserId then Theme.Color.MagicDark else Theme.Color.Ink
	local nameLabel = row:FindFirstChild("Name") :: TextLabel
	nameLabel.Text = entry.name
	local sizeLabel = row:FindFirstChild("Size") :: TextLabel
	sizeLabel.Text = Format.size(entry.d, cmPerStud())
	local avatar = row:FindFirstChild("Avatar") :: ImageLabel
	local thumb = thumbnails[entry.userId]
	if thumb then
		avatar.Image = thumb
	elseif thumb == nil then
		thumbnails[entry.userId] = false
		task.spawn(function()
			local ok, img = pcall(function()
				return Players:GetUserThumbnailAsync(entry.userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
			end)
			if ok then
				thumbnails[entry.userId] = img
			end
		end)
	end
end

local function updateGoal()
	local world = controllers.WorldController
	local goal = world and world.nextGoal
	if not state:isRolling() or not goal then
		goalCard.Visible = false
		return
	end
	goalCard.Visible = true
	if goalUid ~= goal.uid then
		local model = propModel(goal.uid)
		if model then
			goalUid = goal.uid
			Ui.setViewportModel(goalIcon, model)
			local s = goalCard:FindFirstChildOfClass("UIScale") or Ui.new("UIScale", { Parent = goalCard })
			s.Scale = 0.6
			Ui.tween(s, Theme.Tween.Bounce, { Scale = 1 })
		end
	end
	local def = PropLibrary.get(goal.uid)
	goalText.Text = (if def then def.name else "?") .. " @ " .. Format.size(goal.needDiameter, cmPerStud())
	local frac = math.clamp(state.diameter / goal.needDiameter, 0, 1)
	goalBar.Size = UDim2.fromScale(math.max(0.04, frac), 1)
end

function HudController:attachLandmarkMarker(p)
	if not p.model or not p.model.PrimaryPart then
		return
	end
	local hb = p.model.PrimaryPart
	local gui = Ui.new("BillboardGui", {
		Name = "LandmarkMarker",
		Size = UDim2.fromOffset(150, 70),
		StudsOffsetWorldSpace = Vector3.new(0, hb.Size.Y * 0.6 + 10, 0),
		AlwaysOnTop = true,
		LightInfluence = 0,
		MaxDistance = 5000,
		Adornee = hb,
		Parent = hb,
	})
	local label = Ui.display("🔒", { Size = UDim2.fromScale(1, 1), Parent = gui })
	local need = p.absorbSize / Tuning.Absorb.LandmarkReach
	task.spawn(function()
		while gui.Parent do
			if state:isFinalRoll() then
				local canNow = state.diameter >= need
				label.Text = if canNow then "⭐ ROLL IT UP! ⭐" else "⭐ " .. Format.size(need, cmPerStud())
				label.TextColor3 = if canNow then Theme.Color.Accent else Theme.Color.White
				label.Rotation = math.sin(os.clock() * 6) * 4
			else
				label.Text = "🔒 Final Roll"
				label.TextColor3 = Theme.Color.White
				label.Rotation = 0
			end
			task.wait(0.15)
		end
	end)
end

-- Results ---------------------------------------------------------------------------------------

local function closeResults()
	if resultsPanel then
		resultsPanel:Destroy()
		resultsPanel = nil
	end
end

local function showResults(results)
	closeResults()
	local panel = Ui.new("Frame", {
		Name = "Results",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.55),
		Size = UDim2.fromOffset(640, 420),
		BackgroundColor3 = Theme.Color.Panel,
		Parent = root,
	}, { Ui.corner(Theme.Radius.Large), Ui.stroke(4, Theme.Color.Ink), Ui.padding(18) })
	resultsPanel = panel
	local kit = Kits.get(results.kitId or "")
	Ui.display((if kit then kit.icon .. " " .. kit.name else "Round") .. " — Results", {
		Size = UDim2.new(1, 0, 0, 46),
		TextColor3 = Theme.Color.Primary,
		Parent = panel,
	})
	local awards = Ui.new("Frame", {
		Position = UDim2.fromOffset(0, 56),
		Size = UDim2.new(1, 0, 0, 230),
		BackgroundTransparency = 1,
		Parent = panel,
	}, {
		Ui.new("UIGridLayout", { CellSize = UDim2.fromOffset(190, 108), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	for i, award in results.awards or {} do
		local cardColor = if award.userId == state.player.UserId then Theme.Color.Accent else Theme.Color.PanelAlt
		local card = Ui.new("Frame", { LayoutOrder = i, BackgroundColor3 = cardColor, Parent = awards }, { Ui.corner(Theme.Radius.Medium), Ui.stroke(3, Theme.Color.Ink) })
		Ui.new("TextLabel", { Text = award.icon, Size = UDim2.fromOffset(44, 44), Position = UDim2.fromOffset(8, 8), TextScaled = true, Parent = card })
		Ui.new("TextLabel", { Text = award.title, Position = UDim2.fromOffset(56, 10), Size = UDim2.new(1, -62, 0, 26), TextScaled = true, TextColor3 = Theme.Color.Ink, TextXAlignment = Enum.TextXAlignment.Left, Parent = card })
		Ui.new("TextLabel", { Text = award.name, Position = UDim2.fromOffset(10, 58), Size = UDim2.new(1, -20, 0, 32), TextScaled = true, FontFace = Theme.Font.Display, TextColor3 = Theme.Color.MagicDark, Parent = card })
	end
	local mine = results.mine
	local payout = results.payout
	local summary = "Your ball: " .. Format.size(mine and mine.finalDiameter or 0, results.cmPerStud or 1)
	if payout then
		summary ..= "    ✨ +" .. Format.commas(payout.total) .. " Stardust"
	end
	Ui.display(summary, {
		Position = UDim2.new(0, 0, 1, -100),
		Size = UDim2.new(1, 0, 0, 40),
		TextColor3 = Theme.Color.Ink,
		Parent = panel,
	}).TextStrokeTransparency = 1
	local countdown = Ui.new("TextLabel", {
		Position = UDim2.new(0, 0, 1, -48),
		Size = UDim2.new(1, 0, 0, 32),
		TextScaled = true,
		TextColor3 = Theme.Color.InkSoft,
		Parent = panel,
	})
	task.spawn(function()
		while resultsPanel == panel do
			local left = state:timeLeft()
			if state.round.state == "Results" then
				countdown.Text = "Hub in " .. math.ceil(left)
			elseif state.round.state == "Intermission" then
				countdown.Text = "Next round in " .. math.ceil(left)
			else
				break
			end
			task.wait(0.2)
		end
		closeResults()
	end)
	local s = Ui.new("UIScale", { Scale = 0.3, Parent = panel })
	Ui.tween(s, Theme.Tween.Pop, { Scale = 1 })
end

-- Loop ------------------------------------------------------------------------------------------

local function update(dt: number)
	-- Size counter: springy count-up and bump.
	sizeSpring.target = state.diameter
	local d = sizeSpring:step(dt)
	local value, unit = Format.sizeParts(math.max(d, 0.1), cmPerStud())
	sizeValue.Text = value
	sizeUnit.Text = unit
	if unit ~= lastUnit then
		lastUnit = unit
		HudController:showBanner("📏 " .. string.upper(unit) .. "!", Theme.Color.Accent, 1.6)
		bumpSpring:impulse(10)
	end
	sizeScale.Scale = bumpSpring:step(dt)
	local rolling = state:isRolling() or state.playerState == "Rider"
	local sizeHolder = sizeValue.Parent :: Frame
	sizeHolder.Visible = rolling

	-- Aggregate tiny gains into readable floaters.
	if pendingGain > 0 and os.clock() - pendingAt > 0.18 then
		local v, u = Format.sizeParts(pendingGain, cmPerStud())
		floater("+" .. v .. " " .. u, Theme.Color.Good)
		pendingGain = 0
	end

	-- Timer.
	local round = state.round
	local left = state:timeLeft()
	timerLabel.Text = Format.clock(left)
	local final = state:isFinalRoll()
	timerPill.BackgroundColor3 = if final then Theme.Color.Bad else Theme.Color.Panel
	timerLabel.TextColor3 = if final then Theme.Color.White else Theme.Color.Ink
	timerPill.Visible = round.state == "Playing"
	topList.Visible = round.state == "Playing"

	-- Touch buttons + dash cooldown.
	touchButtons.Visible = input.inputType == "Touch" and state:isRolling()
	if dashFill then
		local p = controllers.MovementController:dashProgress()
		dashFill.Size = UDim2.fromScale(1, 1 - p)
	end
end

function HudController:start()
	state = controllers.ClientState
	settings = controllers.SettingsController
	input = controllers.InputController
	Ui.onClickSound = function()
		if controllers.AudioController then
			controllers.AudioController:play("Click")
		end
	end
	gui = Ui.new("ScreenGui", {
		Name = "RollHud",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	Ui.autoScale(gui)
	root = Ui.new("Frame", {
		Name = "Root",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		Ui.new("UIPadding", { PaddingTop = UDim.new(0, 36), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8) }),
	})
	buildSizeCounter()
	buildGoalCard()
	buildTimer()
	buildTopList()
	buildTouchButtons()
	buildContainers()

	sizeSpring:snap(state.diameter)
	state.DiameterChanged:Connect(function(new, old)
		if new > old then
			pendingGain += new - old
			pendingAt = os.clock()
			bumpSpring:impulse(math.clamp((new - old) / old * 8, 0.3, 4))
		end
	end)
	state.BallChanged:Connect(function(part)
		if part then
			sizeSpring:snap(state.diameter)
		end
	end)
	Net.connect("Absorbed", function(list)
		for _, a in list do
			local def = PropLibrary.get(a.uid)
			if def then
				if a.n then
					self:toast(a.uid, a.m, "✨ NEW!")
				elseif a.v then
					self:toast(a.uid, a.m, "✨ NEW VARIANT!")
				elseif Rarity.get(def.rarity).toast or a.m > 0 then
					self:toast(a.uid, a.m, Rarity.get(def.rarity).glyph .. " " .. def.rarity .. "!")
				end
			end
		end
	end)
	controllers.WorldController.GoalUnlocked:Connect(function(uid)
		self:goalUnlocked(uid)
	end)
	controllers.WorldController.TemplateProgress:Connect(function(done, total)
		loadingChip.Visible = done < total
		loadingChip.Text = string.format("✨ Building the world… %d%%", math.floor(done / total * 100))
	end)
	state.RoundChanged:Connect(function(round: any, previous: any)
		for i = 1, 3 do
			setTopRow(i, round.top and round.top[i])
		end
		local enteredFinal = round.phase == "FinalRoll" and previous.phase ~= "FinalRoll"
		local enteredPlaying = round.state == "Playing" and previous.state ~= "Playing"
		local enteredLaunch = round.state == "Launch" and previous.state ~= "Launch"
		if enteredFinal then
			self:showBanner("⭐ FINAL ROLL! ⭐", Theme.Color.Accent, 2.8)
		elseif enteredPlaying then
			local kit = Kits.get(round.kitId or "")
			self:showBanner(if kit then kit.icon .. " " .. kit.name else "ROLL!", Theme.Color.White, 2.2)
		elseif enteredLaunch then
			self:showBanner("🚀 LAUNCH! 🚀", Theme.Color.Accent, 2.5)
		end
	end)
	state.ResultsReceived:Connect(showResults)
	Net.connect("Announce", function(kind, data)
		if kind == "legendary" and data then
			local def = PropLibrary.get(data.uid)
			self:showBanner("🌟 " .. tostring(data.name) .. " found " .. (if def then def.name else "a Legendary") .. "!", rarityColor("Legendary"), 3)
		end
	end)
	RunService.RenderStepped:Connect(update)
	task.spawn(function()
		while true do
			task.wait(0.25)
			pcall(updateGoal)
		end
	end)
end

return HudController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="75">
            <Properties>
              <string name="Name">InputController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- All player input in one place. Movement comes from Roblox's own control module (dynamic thumbstick,
-- WASD/arrows, left stick) so it feels native everywhere; actions are bound with ContextActionService.
-- Camera orbit never needs right-click: Q/E, left-drag, one-finger drag (touch), right stick.

local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Signal = require(ReplicatedStorage.Shared.Util.Signal)

local InputController = {}

InputController.ActionPressed = Signal.new() -- (actionName)
InputController.ZoomChanged = Signal.new() -- (delta)
InputController.InputTypeChanged = Signal.new() -- ("Touch" | "Gamepad" | "Keyboard")
InputController.inputType = "Keyboard"
InputController.orbit = Vector2.zero -- accumulated orbit delta this frame (radians-ish), consumed by camera
InputController.orbitHeld = false
InputController.keyOrbit = 0 -- -1..1 from Q/E or right stick X
InputController.keyPitch = 0
InputController.lastMove = Vector3.zero

local controls = nil
local dragging = false
local dragInput: InputObject? = nil
local lastDragPos: Vector2? = nil

local function detectInputType(input: InputObject)
	local t = input.UserInputType
	local kind
	if t == Enum.UserInputType.Touch then
		kind = "Touch"
	elseif t.Name:find("Gamepad") then
		kind = "Gamepad"
	elseif t == Enum.UserInputType.Keyboard or t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.MouseMovement then
		kind = "Keyboard"
	end
	if kind and kind ~= InputController.inputType then
		InputController.inputType = kind
		InputController.InputTypeChanged:Fire(kind)
	end
end

-- Raw move input in camera space: X = right, Z = back (forward is -Z), magnitude 0..1.
function InputController:getMoveVector(): Vector3
	local v = Vector3.zero
	if controls then
		local ok, result = pcall(function()
			return controls:GetMoveVector()
		end)
		if ok and result then
			v = result
		end
	end
	if v.Magnitude > 1 then
		v = v.Unit
	end
	self.lastMove = v
	return v
end

-- Called by HUD touch buttons as well as keybinds.
function InputController:press(action: string)
	self.ActionPressed:Fire(action)
end

-- Consume the orbit delta accumulated since the last call.
function InputController:takeOrbit(): Vector2
	local o = self.orbit
	self.orbit = Vector2.zero
	return o
end

local function bindActions()
	ContextActionService:BindActionAtPriority("RTW_Hop", function(_, state)
		if state == Enum.UserInputState.Begin then
			InputController:press("Hop")
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.Space, Enum.KeyCode.ButtonA)
	ContextActionService:BindActionAtPriority("RTW_Dash", function(_, state)
		if state == Enum.UserInputState.Begin then
			InputController:press("Dash")
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift, Enum.KeyCode.ButtonX, Enum.KeyCode.ButtonR2)
	ContextActionService:BindActionAtPriority("RTW_Emote", function(_, state)
		if state == Enum.UserInputState.Begin then
			InputController:press("EmoteWheel")
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.ContextActionPriority.Medium.Value, Enum.KeyCode.G, Enum.KeyCode.ButtonY)
	ContextActionService:BindActionAtPriority("RTW_Burst", function(_, state)
		if state == Enum.UserInputState.Begin then
			InputController:press("Burst")
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.ContextActionPriority.Medium.Value, Enum.KeyCode.F, Enum.KeyCode.ButtonB)
end

-- While rolling, Space and Shift belong to us; in the hub they go back to the normal character.
function InputController:setRollingBindings(rolling: boolean)
	if rolling then
		bindActions()
	else
		ContextActionService:UnbindAction("RTW_Hop")
		ContextActionService:UnbindAction("RTW_Dash")
	end
end

function InputController:start()
	local player = Players.LocalPlayer
	task.spawn(function()
		local ok, module = pcall(function()
			local moduleScript: any = player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule")
			return (require :: any)(moduleScript)
		end)
		if ok and module then
			controls = module:GetControls()
		else
			warn("[Input] PlayerModule unavailable; movement input disabled")
		end
	end)

	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		self.inputType = "Touch"
	elseif UserInputService.GamepadEnabled and GuiService:IsTenFootInterface() then
		self.inputType = "Gamepad"
	end

	UserInputService.InputBegan:Connect(function(input, processed)
		detectInputType(input)
		if processed then
			return
		end
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.MouseButton2 then
			dragging = true
			lastDragPos = Vector2.new(input.Position.X, input.Position.Y)
		elseif t == Enum.UserInputType.Touch then
			-- Touches on the right 60% of the screen orbit the camera (left side is the thumbstick).
			local viewport = workspace.CurrentCamera.ViewportSize
			if input.Position.X > viewport.X * 0.4 and not dragInput then
				dragInput = input
				lastDragPos = Vector2.new(input.Position.X, input.Position.Y)
			end
		elseif input.KeyCode == Enum.KeyCode.Q then
			self.keyOrbit = -1
		elseif input.KeyCode == Enum.KeyCode.E then
			self.keyOrbit = 1
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.MouseButton2 then
			dragging = false
			self.orbitHeld = false
		elseif input == dragInput then
			dragInput = nil
			self.orbitHeld = false
		elseif input.KeyCode == Enum.KeyCode.Q and self.keyOrbit < 0 then
			self.keyOrbit = 0
		elseif input.KeyCode == Enum.KeyCode.E and self.keyOrbit > 0 then
			self.keyOrbit = 0
		end
	end)
	UserInputService.InputChanged:Connect(function(input, processed)
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseMovement and dragging and lastDragPos then
			local pos = Vector2.new(input.Position.X, input.Position.Y)
			local delta = pos - lastDragPos
			lastDragPos = pos
			if delta.Magnitude > 0.5 then
				self.orbit += delta
				self.orbitHeld = true
			end
		elseif input == dragInput and lastDragPos then
			local pos = Vector2.new(input.Position.X, input.Position.Y)
			self.orbit += (pos - lastDragPos)
			lastDragPos = pos
			self.orbitHeld = true
		elseif t == Enum.UserInputType.MouseWheel and not processed then
			-- Two-finger scroll on a MacBook trackpad arrives as MouseWheel.
			self.ZoomChanged:Fire(-input.Position.Z)
		elseif input.KeyCode == Enum.KeyCode.Thumbstick2 then
			local x, y = input.Position.X, input.Position.Y
			self.keyOrbit = if math.abs(x) > 0.2 then x else 0
			self.keyPitch = if math.abs(y) > 0.2 then y else 0
		end
	end)
	UserInputService.TouchPinch:Connect(function(_, scale, _, state)
		if state == Enum.UserInputState.Change then
			self.ZoomChanged:Fire((1 - scale) * 4)
		end
	end)
	bindActions()
end

return InputController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="76">
            <Properties>
              <string name="Name">MovementController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Local ball physics: momentum-based rolling with snappy acceleration, strong turn-in, a coasting
-- brake, hop and dash. The client owns its ball, so input feels instant; the server validates.
--
-- We steer by setting the ball's horizontal velocity toward a force-limited target every physics
-- step and drive its spin to match true rolling, so stuck props visibly roll with the ball while
-- the motion stays tight and predictable at every size.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)
local Growth = require(Shared.Logic.Growth)
local Tuning = require(Shared.Config.Tuning)
local Cores = require(Shared.Data.Cores)
local Animations = require(Shared.Config.Animations)

local MovementController = {}

MovementController.Hopped = Signal.new()
MovementController.Dashed = Signal.new()
MovementController.Landed = Signal.new() -- (impactSpeed)
MovementController.Bonked = Signal.new() -- (speed, hitPart, hitPosition, normal)
MovementController.grounded = false
MovementController.speed = 0
MovementController.velocity = Vector3.zero
MovementController.heading = Vector3.new(0, 0, -1)
MovementController.dashReadyAt = 0
MovementController.dashUntil = 0
MovementController.lastDash = -math.huge
MovementController.moveInput = Vector3.zero -- world-space desired direction (0..1)
MovementController.enabled = false

local controllers
local state, input, camera
local ball: BasePart? = nil
local riderAttachment: Attachment? = nil
local alignPos: AlignPosition? = nil
local alignOri: AlignOrientation? = nil
local animTracks = {}
local lastHop = -math.huge
local lastGroundedAt = 0
local airborneSince = 0
local wasGrounded = true
local prevHorizontal = Vector3.zero
local lastBonk = 0
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

function MovementController:init(c)
	controllers = c
end

local function speedMultiplier(): number
	local mult = 1
	local def = Cores.get(state.core)
	if def and def.speedMult then
		mult *= def.speedMult(state.coreLevel)
	end
	local event = state.round.event
	if event and event.speedMult then
		mult *= event.speedMult
	end
	if state.playerState == "Merged" then
		mult *= Tuning.Merge.SpeedPenalty
	end
	return mult
end

local function hopHeight(d: number): number
	local h = Growth.hopHeight(d)
	local def = Cores.get(state.core)
	if def and def.hopMult then
		h *= def.hopMult(state.coreLevel)
	end
	return h
end

function MovementController:dashCooldown(): number
	local def = Cores.get(state.core)
	local mult = if def and def.dashCooldownMult then def.dashCooldownMult(state.coreLevel) else 1
	return Tuning.Ball.DashCooldown * mult
end

function MovementController:dashProgress(): number
	local cd = self:dashCooldown()
	return math.clamp((os.clock() - self.lastDash) / cd, 0, 1)
end

local function refreshFilter()
	local list = {}
	local character = Players.LocalPlayer.Character
	if character then
		table.insert(list, character)
	end
	if state.ballModel then
		table.insert(list, state.ballModel)
	end
	local visuals = Workspace:FindFirstChild("BallVisuals")
	if visuals then
		table.insert(list, visuals)
	end
	rayParams.FilterDescendantsInstances = list
end

local function loadAnimations(character: Model)
	table.clear(animTracks)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		return
	end
	local rig = if humanoid.RigType == Enum.HumanoidRigType.R6 then "R6" else "R15"
	local ids = Animations[rig]
	for _, name in { "Run", "Idle", "Fall", "Cheer" } do
		local anim = Instance.new("Animation")
		anim.AnimationId = ids[name]
		local ok, track = pcall(function()
			return animator:LoadAnimation(anim)
		end)
		if ok and track then
			track.Priority = if name == "Cheer" then Enum.AnimationPriority.Action2 else Enum.AnimationPriority.Action
			track.Looped = name ~= "Cheer"
			animTracks[name] = track
		end
	end
end

-- The Roller: the avatar balances on top of the ball, running on it like a circus performer.
local function attachRider()
	local character = Players.LocalPlayer.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return
	end
	if alignPos then
		alignPos:Destroy()
	end
	if alignOri then
		alignOri:Destroy()
	end
	if riderAttachment then
		riderAttachment:Destroy()
	end
	local att = Instance.new("Attachment")
	att.Name = "RollerAttachment"
	att.Parent = hrp
	local ap = Instance.new("AlignPosition")
	ap.Mode = Enum.PositionAlignmentMode.OneAttachment
	ap.Attachment0 = att
	ap.RigidityEnabled = true
	ap.Parent = hrp
	local ao = Instance.new("AlignOrientation")
	ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
	ao.Attachment0 = att
	ao.RigidityEnabled = false
	ao.Responsiveness = 30
	ao.MaxTorque = math.huge
	ao.Parent = hrp
	riderAttachment, alignPos, alignOri = att, ap, ao
	loadAnimations(character)
end

local function detachRider()
	if alignPos then
		alignPos:Destroy()
		alignPos = nil
	end
	if alignOri then
		alignOri:Destroy()
		alignOri = nil
	end
	if riderAttachment then
		riderAttachment:Destroy()
		riderAttachment = nil
	end
	for _, track in animTracks do
		pcall(function()
			track:Stop(0.2)
		end)
	end
end

function MovementController:bind(part: BasePart?)
	ball = part
	self.enabled = part ~= nil
	if part then
		refreshFilter()
		attachRider()
		self.lastDash = -math.huge
		input:setRollingBindings(true)
	else
		detachRider()
		input:setRollingBindings(false)
	end
end

local function groundCheck(pos: Vector3, radius: number): (boolean, Vector3?)
	local result = Workspace:Raycast(pos, Vector3.new(0, -(radius + math.max(0.6, radius * 0.12)), 0), rayParams)
	if result then
		return true, result.Normal
	end
	return false, nil
end

-- Mobile auto-steer: bend the input a little toward absorbable stuff ahead.
local function autoSteer(dir: Vector3, d: number): Vector3
	if input.inputType ~= "Touch" or not controllers.SettingsController.values.autoSteer then
		return dir
	end
	local world = controllers.WorldController
	if not world or not ball then
		return dir
	end
	local target = world:steerTarget(ball.Position, dir, d)
	if not target then
		return dir
	end
	local to = Vector3.new(target.X - ball.Position.X, 0, target.Z - ball.Position.Z)
	if to.Magnitude < 0.1 then
		return dir
	end
	to = to.Unit
	local maxAngle = math.rad(Tuning.Ball.AutoSteerMaxAngle)
	local angle = math.acos(math.clamp(dir:Dot(to), -1, 1))
	if angle < 1e-3 then
		return dir
	end
	local t = math.min(1, maxAngle / angle) * 0.6
	local blended = dir:Lerp(to, t)
	return if blended.Magnitude > 1e-3 then blended.Unit * dir.Magnitude else dir
end

function MovementController:hop()
	if not ball or not self.enabled then
		return
	end
	local now = os.clock()
	if now - lastHop < Tuning.Ball.HopCooldown then
		return
	end
	-- Coyote time: allow hopping just after rolling off an edge.
	if not self.grounded and now - lastGroundedAt > 0.15 then
		return
	end
	lastHop = now
	local h = hopHeight(state.diameter)
	local vy = math.sqrt(2 * Workspace.Gravity * h)
	local v = ball.AssemblyLinearVelocity
	ball.AssemblyLinearVelocity = Vector3.new(v.X, math.max(v.Y, 0) + vy, v.Z)
	self.Hopped:Fire(h)
	Net.send("Action", "hop")
end

function MovementController:dash()
	if not ball or not self.enabled then
		return
	end
	local now = os.clock()
	if now - self.lastDash < self:dashCooldown() then
		return
	end
	self.lastDash = now
	self.dashUntil = now + Tuning.Ball.DashDuration
	local dir = if self.moveInput.Magnitude > 0.1 then self.moveInput.Unit else self.heading
	local maxSpeed = Growth.maxSpeed(state.diameter) * speedMultiplier()
	local v = ball.AssemblyLinearVelocity
	local horizontal = Vector3.new(v.X, 0, v.Z)
	-- Redirect momentum into the dash direction, then add the boost: dashes always go where you aim.
	local boosted = dir * math.max(horizontal.Magnitude, maxSpeed * 0.6) + dir * maxSpeed * Tuning.Ball.DashBoost
	ball.AssemblyLinearVelocity = Vector3.new(boosted.X, math.max(v.Y, 0) + 4, boosted.Z)
	self.Dashed:Fire(dir)
	Net.send("Action", "dash")
end

function MovementController:applyImpulse(dv: Vector3)
	if ball and ball.Parent then
		ball.AssemblyLinearVelocity += dv
	end
end

local function updateRider()
	if not ball or not alignPos or not alignOri then
		return
	end
	local character = Players.LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local scale = if character then character:GetScale() else 1
	local hip = (if humanoid then humanoid.HipHeight else 2) + 1
	local r = ball.Size.X / 2
	alignPos.Position = ball.Position + Vector3.new(0, r + hip * 0.92, 0)
	local h = MovementController.heading
	alignOri.CFrame = CFrame.lookAt(Vector3.zero, Vector3.new(h.X, 0, h.Z))
	-- Animation: run on the ball proportionally to speed; idle balance when still; flail in the air.
	local run, idle, fall = animTracks.Run, animTracks.Idle, animTracks.Fall
	local speedFrac = MovementController.speed / math.max(Growth.maxSpeed(state.diameter), 1)
	if not MovementController.grounded and fall then
		if not fall.IsPlaying then
			fall:Play(0.15)
		end
		if run and run.IsPlaying then
			run:Stop(0.15)
		end
	elseif speedFrac > 0.08 and run then
		if fall and fall.IsPlaying then
			fall:Stop(0.15)
		end
		if not run.IsPlaying then
			run:Play(0.2)
		end
		if idle and idle.IsPlaying then
			idle:Stop(0.2)
		end
		run:AdjustSpeed(math.clamp(0.6 + speedFrac * 1.6, 0.6, 2.4) / math.sqrt(math.max(scale, 0.3)))
	elseif idle then
		if fall and fall.IsPlaying then
			fall:Stop(0.15)
		end
		if run and run.IsPlaying then
			run:Stop(0.25)
		end
		if not idle.IsPlaying then
			idle:Play(0.25)
		end
	end
end

local function step(dt: number)
	if not ball or not ball.Parent or not MovementController.enabled then
		return
	end
	if ball.Anchored then
		return
	end
	local self = MovementController
	local d = state.diameter
	local r = ball.Size.X / 2
	local pos = ball.Position
	local now = os.clock()

	-- Input -> world direction using the camera's yaw (camera-relative controls).
	local raw = input:getMoveVector()
	local yaw = camera and camera.yaw or 0
	local forward = Vector3.new(-math.sin(yaw), 0, -math.cos(yaw))
	local right = Vector3.new(math.cos(yaw), 0, -math.sin(yaw))
	local desired = right * raw.X - forward * raw.Z
	if desired.Magnitude > 1 then
		desired = desired.Unit
	end
	if desired.Magnitude > 0.05 then
		desired = autoSteer(desired, d)
	end
	self.moveInput = desired

	local grounded = groundCheck(pos, r)
	if grounded then
		lastGroundedAt = now
	end
	if grounded and not wasGrounded and now - airborneSince > 0.15 then
		self.Landed:Fire(math.abs(prevHorizontal.Y))
	end
	if not grounded and wasGrounded then
		airborneSince = now
	end
	wasGrounded = grounded
	self.grounded = grounded

	local maxSpeed = Growth.maxSpeed(d) * speedMultiplier()
	local v = ball.AssemblyLinearVelocity
	local horizontal = Vector3.new(v.X, 0, v.Z)
	local dashing = now < self.dashUntil
	local cap = if dashing then maxSpeed * (1 + Tuning.Ball.DashBoost) else maxSpeed

	local accel = maxSpeed / Growth.accelTime(d)
	if not grounded then
		accel *= Tuning.Ball.AirControl
	end

	local newHorizontal
	if desired.Magnitude > 0.05 then
		local target = desired * cap * math.clamp(desired.Magnitude, 0, 1)
		local diff = target - horizontal
		local rate = accel
		-- Turn-in: steering against current motion gets extra grip so turns feel crisp, not floaty.
		if horizontal.Magnitude > 1 and horizontal.Unit:Dot(desired.Unit) < 0.6 then
			rate *= Tuning.Ball.TurnAssist
		end
		if dashing and horizontal.Magnitude > target.Magnitude then
			-- Don't eat dash momentum; let it bleed off naturally.
			diff = desired.Unit * math.max(0, target.Magnitude - horizontal:Dot(desired.Unit)) + (horizontal - desired.Unit * horizontal:Dot(desired.Unit)) * -0.5
		end
		local maxStep = rate * dt
		if diff.Magnitude > maxStep then
			diff = diff.Unit * maxStep
		end
		newHorizontal = horizontal + diff
	else
		-- Coast: exponential brake (a heavy ball rolls a little longer than a pea).
		local brake = if grounded then dt / Growth.brakeTime(d) else dt * 0.2
		newHorizontal = horizontal * math.max(0, 1 - brake * 2.2)
	end
	-- Speed cap with a soft ceiling (momentum from slopes/bumps decays instead of snapping).
	local mag = newHorizontal.Magnitude
	if mag > cap then
		newHorizontal = newHorizontal.Unit * math.max(cap, mag - accel * 1.5 * dt)
	end

	-- Bonk detection: a sudden loss of speed while pushing into something.
	local prevSpeed = prevHorizontal.Magnitude
	if prevSpeed > maxSpeed * 0.35 and horizontal.Magnitude < prevSpeed * 0.45 and now - lastBonk > 0.35 then
		local dir = Vector3.new(prevHorizontal.X, 0, prevHorizontal.Z).Unit
		local hit = Workspace:Raycast(pos, dir * (r + math.max(2, r * 0.6)), rayParams)
		if hit then
			lastBonk = now
			-- Bounce back a little: it teaches "too big!" without words.
			local bounce = -dir * prevSpeed * 0.35
			newHorizontal = newHorizontal + bounce
			self.Bonked:Fire(prevSpeed, hit.Instance, hit.Position, hit.Normal)
			if prevSpeed >= maxSpeed * Tuning.Absorb.BonkMinSpeed then
				Net.send("Action", "bonk", prevSpeed)
			end
		end
	end

	local vy = v.Y
	ball.AssemblyLinearVelocity = Vector3.new(newHorizontal.X, vy, newHorizontal.Z)
	-- Spin to match rolling without slipping (visual + keeps stuck props rolling believably).
	if grounded then
		local spin = Vector3.yAxis:Cross(newHorizontal) / math.max(r, 0.1)
		ball.AssemblyAngularVelocity = ball.AssemblyAngularVelocity:Lerp(spin, math.min(1, dt * 12))
	end

	prevHorizontal = Vector3.new(newHorizontal.X, vy, newHorizontal.Z)
	self.velocity = ball.AssemblyLinearVelocity
	self.speed = newHorizontal.Magnitude
	if self.speed > maxSpeed * 0.12 then
		self.heading = self.heading:Lerp(newHorizontal.Unit, math.min(1, dt * 10))
		if self.heading.Magnitude > 1e-3 then
			self.heading = self.heading.Unit
		end
	elseif desired.Magnitude > 0.2 then
		self.heading = self.heading:Lerp(desired.Unit, math.min(1, dt * 6)).Unit
	end
end

function MovementController:start()
	state = controllers.ClientState
	input = controllers.InputController
	camera = controllers.CameraController
	state.BallChanged:Connect(function(part)
		self:bind(part)
	end)
	if state.ball then
		self:bind(state.ball)
	end
	input.ActionPressed:Connect(function(action)
		if action == "Hop" then
			self:hop()
		elseif action == "Dash" then
			self:dash()
		end
	end)
	Net.connect("Impulse", function(dv: Vector3)
		if typeof(dv) == "Vector3" then
			self:applyImpulse(dv)
		end
	end)
	Players.LocalPlayer.CharacterAdded:Connect(function()
		task.wait(0.2)
		if ball then
			refreshFilter()
			attachRider()
		end
	end)
	RunService.PreSimulation:Connect(step)
	RunService.RenderStepped:Connect(updateRider)
	state.DiameterChanged:Connect(function()
		refreshFilter()
	end)
end

return MovementController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="77">
            <Properties>
              <string name="Name">NanaController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Builds Nana Nova (smooth meshes) at her hub anchor and gives her a cosy idle: gentle rocking,
-- head tilts, knitting needles clicking, the galaxy yarn ball slowly turning.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local NanaNova = require(Shared.Data.NanaNova)
local PropBuilder = require(Shared.PropBuilder)

local NanaController = {}

local nana: Model? = nil
local chair: Model? = nil
local base: CFrame = CFrame.new()
local parts, offsets, tags = {}, {}, {}

local function build(anchor: BasePart)
	local ground = anchor.CFrame * CFrame.new(0, -anchor.Size.Y / 2, 0)
	local chairModel = PropBuilder.buildParts(NanaNova.Chair, "NanaChair")
	chairModel:PivotTo(ground)
	chairModel.Parent = Workspace
	local nanaModel = PropBuilder.buildParts(NanaNova.Parts, "NanaNova")
	base = ground * CFrame.new(0, 4.6, -0.3)
	nanaModel:PivotTo(base)
	nanaModel.Parent = Workspace
	chair, nana = chairModel, nanaModel
	local pivot = nanaModel:GetPivot()
	for _, d in nanaModel:GetDescendants() do
		if d:IsA("BasePart") then
			table.insert(parts, d)
			table.insert(offsets, pivot:ToObjectSpace(d.CFrame))
			table.insert(tags, d:GetAttribute("Tag"))
		end
	end
end

local function animate()
	if not nana or not nana.Parent then
		return
	end
	local t = os.clock()
	local rock = math.sin(t * 1.4) * 0.05
	local root = base * CFrame.Angles(rock, 0, 0)
	local cfs = {}
	for i, part in parts do
		local offset = offsets[i]
		local tag = tags[i]
		if tag == "head" then
			offset = CFrame.new(0, 6.5, 0) * CFrame.Angles(math.sin(t * 0.7) * 0.05, math.sin(t * 0.45) * 0.12, math.sin(t * 0.9) * 0.06) * CFrame.new(0, -6.5, 0) * offset
		elseif tag == "needle" then
			offset = offset * CFrame.Angles(0, 0, math.sin(t * 7) * 0.12)
		elseif tag == "arm" then
			offset = CFrame.new(0, 0, math.sin(t * 7) * 0.06) * offset
		elseif tag == "yarn" then
			local center = CFrame.new(0, 3.6, 2.4)
			offset = center * CFrame.Angles(0, t * 0.6, 0) * center:Inverse() * offset
		end
		cfs[i] = root * offset
	end
	Workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
	if chair then
		chair:PivotTo(base * CFrame.new(0, -4.6, 0.3) * CFrame.Angles(rock, 0, 0))
	end
end

function NanaController:start()
	task.spawn(function()
		local hub = Workspace:WaitForChild("Hub", 60)
		local anchor = hub and hub:WaitForChild("NanaAnchor", 30)
		if anchor then
			build(anchor)
		end
	end)
	RunService.RenderStepped:Connect(animate)
end

return NanaController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="78">
            <Properties>
              <string name="Name">SettingsController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Player settings (audio, graphics quality, camera sensitivity, reduced motion, colorblind rarity
-- colors, mobile auto-steer). Saved to the profile when PlayerDataService is present; otherwise kept
-- for the session. Other controllers read Settings.values and listen to Changed.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)

local SettingsController = {}

SettingsController.values = {
	music = 0.6,
	sfx = 0.9,
	quality = "Auto", -- Auto | Low | Medium | High
	cameraSensitivity = 1,
	reducedMotion = false,
	colorblind = false,
	autoSteer = true,
	shake = 1,
}
SettingsController.Changed = Signal.new() -- (key, value)

local controllers

function SettingsController:init(c)
	controllers = c
end

-- 0.5 (low) .. 1.2 (high): scales render distances, particle counts and effects.
function SettingsController:qualityFactor(): number
	local q = self.values.quality
	if q == "Low" then
		return 0.55
	elseif q == "Medium" then
		return 0.8
	elseif q == "High" then
		return 1.15
	end
	-- Auto: read the engine's current graphics level (1-10) when available.
	local ok, level = pcall(function()
		return UserSettings().GameSettings.SavedQualityLevel.Value
	end)
	if ok and level and level > 0 then
		return math.clamp(0.45 + level * 0.07, 0.5, 1.15)
	end
	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		return 0.7
	end
	return 1
end

function SettingsController:set(key: string, value: any)
	if self.values[key] == value then
		return
	end
	self.values[key] = value
	self.Changed:Fire(key, value)
	Net.request("SaveSettings", { [key] = value })
end

function SettingsController:start()
	local state = controllers.ClientState
	state.ProfileChanged:Connect(function(profile)
		if profile and profile.settings then
			for k, v in profile.settings do
				if self.values[k] ~= nil and self.values[k] ~= v then
					self.values[k] = v
					self.Changed:Fire(k, v)
				end
			end
		end
	end)
end

return SettingsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="79">
            <Properties>
              <string name="Name">TuningPanel</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Studio-only live tuning panel (toggle with F2 or the 🔧 button). Change feel numbers while
-- rolling; values apply instantly on client and server. "Print" dumps the current values so they
-- can be pasted into Config/Tuning.luau. Not created in live servers.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Theme = require(Shared.Config.Theme)
local Tuning = require(Shared.Config.Tuning)
local Ui = require(script.Parent.Parent.UI.Ui)

local TuningPanel = {}

local PARAMS = {
	{ "Ball.SpeedBase", 1 },
	{ "Ball.SpeedExponent", 0.02 },
	{ "Ball.AccelTimeSmall", 0.02 },
	{ "Ball.AccelTimeHuge", 0.05 },
	{ "Ball.TurnAssist", 0.1 },
	{ "Ball.BrakeTimeSmall", 0.1 },
	{ "Ball.BrakeTimeHuge", 0.1 },
	{ "Ball.AirControl", 0.05 },
	{ "Ball.HopPerDiameter", 0.05 },
	{ "Ball.DashBoost", 0.05 },
	{ "Ball.DashCooldown", 0.1 },
	{ "Absorb.Ratio", 0.02 },
	{ "Growth.Gain", 0.05 },
	{ "Growth.EarlyBoost", 0.1 },
	{ "Growth.EarlyScale", 1 },
	{ "Camera.BaseDistance", 0.5 },
	{ "Camera.DistancePerDiameter", 0.1 },
	{ "Camera.HeightPerDiameter", 0.05 },
	{ "Camera.FovSpeedBonus", 1 },
	{ "Camera.YawSharpness", 0.2 },
}

local function read(path: string): number
	local section, key = path:match("^(%w+)%.(%w+)$")
	return (Tuning :: any)[section][key]
end

local function write(path: string, value: number)
	local section, key = path:match("^(%w+)%.(%w+)$")
	;(Tuning :: any)[section][key] = value
end

function TuningPanel:start()
	if not RunService:IsStudio() then
		return
	end
	local gui = Ui.new("ScreenGui", {
		Name = "TuningPanel",
		ResetOnSpawn = false,
		DisplayOrder = 50,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	local panel = Ui.new("Frame", {
		Position = UDim2.new(0, 12, 0.5, -280),
		Size = UDim2.fromOffset(330, 560),
		BackgroundColor3 = Theme.Color.Panel,
		Visible = false,
		Parent = gui,
	}, { Ui.corner(Theme.Radius.Medium), Ui.stroke(3, Theme.Color.Ink), Ui.padding(10) })
	Ui.new("TextLabel", {
		Text = "🔧 Feel Tuning (Studio)",
		Size = UDim2.new(1, 0, 0, 26),
		TextScaled = true,
		TextColor3 = Theme.Color.Ink,
		Parent = panel,
	})
	local list = Ui.new("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 30),
		Size = UDim2.new(1, 0, 1, -120),
		BackgroundTransparency = 1,
		CanvasSize = UDim2.fromOffset(0, #PARAMS * 30),
		ScrollBarThickness = 6,
		Parent = panel,
	}, { Ui.new("UIListLayout", { Padding = UDim.new(0, 4) }) })
	for _, param in PARAMS do
		local path, step = param[1], param[2]
		local row = Ui.new("Frame", { Size = UDim2.new(1, -8, 0, 26), BackgroundTransparency = 1, Parent = list })
		Ui.new("TextLabel", {
			Text = path,
			Size = UDim2.new(0.55, 0, 1, 0),
			TextScaled = true,
			TextColor3 = Theme.Color.Ink,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = row,
		})
		local box = Ui.new("TextBox", {
			Text = tostring(read(path)),
			Position = UDim2.new(0.55, 26, 0, 0),
			Size = UDim2.new(0.45, -52, 1, 0),
			TextScaled = true,
			TextColor3 = Theme.Color.Ink,
			BackgroundTransparency = 0,
			BackgroundColor3 = Theme.Color.PanelAlt,
			ClearTextOnFocus = false,
			Parent = row,
		}, { Ui.corner(Theme.Radius.Small) })
		local function set(v: number)
			v = math.floor(v * 1000 + 0.5) / 1000
			write(path, v)
			box.Text = tostring(v)
			Net.request("DevTuning", { path = path, value = v })
		end
		box.FocusLost:Connect(function()
			local v = tonumber(box.Text)
			if v then
				set(v)
			else
				box.Text = tostring(read(path))
			end
		end)
		Ui.button({ text = "-", size = UDim2.fromOffset(24, 26), position = UDim2.new(0.55, 0, 0, 0), color = Theme.Color.Bad, radius = Theme.Radius.Small, parent = row, onClick = function()
			set(read(path) - step)
		end })
		Ui.button({ text = "+", size = UDim2.fromOffset(24, 26), position = UDim2.new(1, -24, 0, 0), color = Theme.Color.Good, radius = Theme.Radius.Small, parent = row, onClick = function()
			set(read(path) + step)
		end })
	end
	local actions = Ui.new("Frame", {
		Position = UDim2.new(0, 0, 1, -84),
		Size = UDim2.new(1, 0, 0, 84),
		BackgroundTransparency = 1,
		Parent = panel,
	}, { Ui.new("UIGridLayout", { CellSize = UDim2.fromOffset(100, 36), CellPadding = UDim2.fromOffset(6, 6) }) })
	local function cmd(text: string, name: string, arg: number?)
		Ui.button({ text = text, size = UDim2.fromOffset(100, 36), color = Theme.Color.Secondary, radius = Theme.Radius.Small, parent = actions, onClick = function()
			Net.request("DevCommand", { cmd = name, arg = arg })
		end })
	end
	cmd("Size ×2", "scale", 2)
	cmd("Size ×0.5", "scale", 0.5)
	cmd("Reset size", "reset")
	cmd("Final Roll", "finalroll")
	cmd("End round", "endround")
	Ui.button({ text = "Print", size = UDim2.fromOffset(100, 36), color = Theme.Color.Accent, radius = Theme.Radius.Small, parent = actions, onClick = function()
		local lines = {}
		for _, param in PARAMS do
			table.insert(lines, string.format("%s = %s", param[1], tostring(read(param[1]))))
		end
		print("[Tuning]\n" .. table.concat(lines, "\n"))
	end })
	Ui.button({
		text = "🔧",
		size = UDim2.fromOffset(44, 44),
		position = UDim2.new(0, 12, 1, -60),
		color = Theme.Color.Magic,
		radius = Theme.Radius.Pill,
		parent = gui,
		onClick = function()
			panel.Visible = not panel.Visible
		end,
	})
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.F2 then
			panel.Visible = not panel.Visible
		end
	end)
end

return TuningPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="80">
            <Properties>
              <string name="Name">VFXController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Visual effects with pooled emitters (mobile friendly): absorb pops colored like the prop,
-- rarity sparkles, bonk stars + shockwave rings, landing dust, dash trails, glints on rare props,
-- wordless emoji reactions. Counts scale with the graphics quality setting.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Growth = require(Shared.Logic.Growth)
local PropLibrary = require(Shared.Logic.PropLibrary)
local Rarity = require(Shared.Config.Rarity)
local Mutations = require(Shared.Data.Mutations)

local VFXController = {}

local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"

local controllers
local state, settings
local folder: Folder
local emitterPool = {}
local trail: Trail? = nil
local trailAttachments = {}

function VFXController:init(c)
	controllers = c
end

local function quality(): number
	return if settings then settings:qualityFactor() else 1
end

local function getEmitter(): (Part, ParticleEmitter)
	for _, e in emitterPool do
		if not e.busy then
			e.busy = true
			task.delay(2.5, function()
				e.busy = false
			end)
			return e.part, e.emitter
		end
	end
	local part = Instance.new("Part")
	part.Name = "Emitter"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Transparency = 1
	part.Size = Vector3.one * 0.2
	part.Parent = folder
	local emitter = Instance.new("ParticleEmitter")
	emitter.Enabled = false
	emitter.Parent = part
	local e = { part = part, emitter = emitter, busy = true }
	table.insert(emitterPool, e)
	task.delay(2.5, function()
		e.busy = false
	end)
	return part, emitter
end

local function burst(pos: Vector3, opts)
	local part, emitter = getEmitter()
	part.CFrame = CFrame.new(pos)
	emitter.Texture = opts.texture or SPARKLE
	emitter.Color = ColorSequence.new(opts.color or Color3.new(1, 1, 1), opts.color2 or opts.color or Color3.new(1, 1, 1))
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, opts.size or 1), NumberSequenceKeypoint.new(1, 0) })
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, opts.alpha or 0), NumberSequenceKeypoint.new(1, 1) })
	emitter.Lifetime = NumberRange.new(opts.life or 0.35, (opts.life or 0.35) * 1.6)
	emitter.Speed = NumberRange.new((opts.speed or 10) * 0.5, opts.speed or 10)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Drag = opts.drag or 4
	emitter.Acceleration = opts.accel or Vector3.zero
	emitter.LightEmission = opts.light or 0.6
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-180, 180)
	emitter:Emit(math.max(1, math.floor((opts.count or 8) * quality())))
end

-- Absorb pop at a contact point, tinted with the prop's main color.
function VFXController:pop(pos: Vector3, color: Color3, size: number, rarityOrder: number?)
	burst(pos, { color = color, color2 = Color3.new(1, 1, 1), size = math.clamp(size * 0.35, 0.3, 14), speed = math.clamp(size * 2.5, 6, 120), count = 7, life = 0.3 })
	if rarityOrder and rarityOrder >= 3 then
		burst(pos, { color = color, color2 = Color3.fromRGB(255, 255, 255), size = math.clamp(size * 0.5, 0.6, 18), speed = math.clamp(size * 4, 10, 160), count = 10 + rarityOrder * 3, life = 0.6, light = 1 })
	end
end

function VFXController:sparkle(pos: Vector3, color: Color3, size: number, count: number?)
	burst(pos, { color = color, color2 = Color3.new(1, 1, 1), size = size, speed = size * 6, count = count or 18, life = 0.8, light = 1, drag = 3 })
end

function VFXController:poof(pos: Vector3, size: number, color: Color3?)
	burst(pos, { texture = SMOKE, color = color or Color3.fromRGB(255, 250, 240), size = math.clamp(size * 0.8, 0.6, 40), speed = math.clamp(size * 1.5, 3, 60), count = 6, life = 0.5, light = 0.2, alpha = 0.3 })
end

function VFXController:dust(pos: Vector3, size: number)
	burst(pos, { texture = SMOKE, color = Color3.fromRGB(255, 244, 228), size = math.clamp(size * 0.6, 0.4, 50), speed = math.clamp(size * 1.2, 2, 80), count = 5, life = 0.6, light = 0.1, alpha = 0.45, accel = Vector3.new(0, size * 0.5, 0) })
end

-- Expanding neon ring on the ground (bonks, bumps, landings of big balls).
function VFXController:shockwave(pos: Vector3, radius: number, color: Color3?)
	if quality() < 0.6 and radius < 8 then
		return
	end
	local ring = Instance.new("Part")
	ring.Shape = Enum.PartType.Cylinder
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.Material = Enum.Material.Neon
	ring.Color = color or Color3.fromRGB(255, 240, 200)
	ring.Transparency = 0.2
	ring.Size = Vector3.new(0.2, radius * 0.3, radius * 0.3)
	ring.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.pi / 2)
	ring.Parent = folder
	local tween = TweenService:Create(ring, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.1, radius * 2, radius * 2),
		Transparency = 1,
	})
	tween:Play()
	tween.Completed:Once(function()
		ring:Destroy()
	end)
end

-- Little floating emoji reaction (critters fleeing, giggling when rolled up, stickers).
function VFXController:emoji(pos: Vector3, text: string, duration: number?)
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.one * 0.2
	anchor.CFrame = CFrame.new(pos)
	anchor.Parent = folder
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(48, 48)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.MaxDistance = 250
	gui.Adornee = anchor
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Text = text
	label.TextScaled = true
	label.Parent = gui
	gui.Parent = anchor
	local d = duration or 1
	TweenService:Create(gui, TweenInfo.new(d, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { StudsOffsetWorldSpace = Vector3.new(0, 4, 0) }):Play()
	TweenService:Create(label, TweenInfo.new(d * 0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, d * 0.6), { TextTransparency = 1 }):Play()
	task.delay(d + 0.1, function()
		anchor:Destroy()
	end)
end

-- Persistent soft glint on rare / mutated props so they read as treasure from a distance.
function VFXController:attachGlint(part: BasePart, color: Color3, strong: boolean)
	if quality() < 0.55 and not strong then
		return
	end
	local att = Instance.new("Attachment")
	att.Parent = part
	local e = Instance.new("ParticleEmitter")
	e.Texture = SPARKLE
	e.Color = ColorSequence.new(color, Color3.new(1, 1, 1))
	e.LightEmission = 1
	local s = math.clamp(part.Size.Magnitude * 0.25, 0.4, 8)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.4, s), NumberSequenceKeypoint.new(1, 0) })
	e.Lifetime = NumberRange.new(0.6, 1.1)
	e.Rate = if strong then 6 else 2.5
	e.Speed = NumberRange.new(0.2, 1)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-90, 90)
	e.Parent = att
	e:Emit(1)
end

local function setupTrail()
	if trail then
		trail:Destroy()
		trail = nil
	end
	for _, a in trailAttachments do
		a:Destroy()
	end
	table.clear(trailAttachments)
	local balls = controllers.BallVisualController
	local me = balls and balls.balls[Players.LocalPlayer.UserId]
	if not me then
		return
	end
	local a0 = Instance.new("Attachment")
	a0.Parent = me.shell
	local a1 = Instance.new("Attachment")
	a1.Parent = me.shell
	trailAttachments = { a0, a1 }
	local t = Instance.new("Trail")
	t.Attachment0 = a0
	t.Attachment1 = a1
	t.Lifetime = 0.35
	t.LightEmission = 0.6
	t.FaceCamera = true
	t.Color = ColorSequence.new(Color3.new(1, 1, 1), me.color)
	t.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) })
	t.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) })
	t.Enabled = false
	t.Parent = me.shell
	trail = t
end

local function updateTrail()
	if not trail or not trail.Parent then
		return
	end
	local movement = controllers.MovementController
	local d = state.diameter
	local frac = movement.speed / math.max(Growth.maxSpeed(d), 1)
	local dashing = os.clock() < movement.dashUntil + 0.2
	trail.Enabled = dashing or frac > 1.05
	-- Attachments sit on the ball's sides, perpendicular to the heading.
	local h = movement.heading
	local side = Vector3.new(-h.Z, 0, h.X) * d * 0.42
	if #trailAttachments == 2 then
		trailAttachments[1].Position = side - Vector3.new(0, d * 0.2, 0)
		trailAttachments[2].Position = -side - Vector3.new(0, d * 0.2, 0)
	end
end

function VFXController:start()
	state = controllers.ClientState
	settings = controllers.SettingsController
	folder = Workspace:FindFirstChild("VFX") or Instance.new("Folder")
	folder.Name = "VFX"
	folder.Parent = Workspace

	local world = controllers.WorldController
	world.PropAbsorbed:Connect(function(p, absorberKey, isPrediction)
		local isLocal = absorberKey == state.player.UserId
		if isLocal and not isPrediction then
			return
		end
		local pos = Vector3.new(p.x, p.cy, p.z)
		local color = Color3.fromHex(p.def.metrics.mainColor)
		local rarity = Rarity.get(p.def.rarity)
		local mut = Mutations.get(p.mutation)
		self:pop(pos, color, p.absorbSize, rarity.order + (if mut then mut.rarityBoost else 0))
		if isLocal and p.critter then
			self:emoji(pos + Vector3.new(0, p.def.metrics.sy * p.eff, 0), if math.random() < 0.5 then "😆" else "🎉", 1.1)
		end
	end)
	local movement = controllers.MovementController
	movement.Bonked:Connect(function(speed, _, hitPos)
		local d = state.diameter
		local frac = math.clamp(speed / math.max(Growth.maxSpeed(d), 1), 0.3, 1.4)
		burst(hitPos, { color = Color3.fromRGB(255, 236, 140), size = math.clamp(d * 0.25, 0.5, 30), speed = d * 3 * frac, count = 9, life = 0.45, light = 1 })
		self:shockwave(hitPos, d * 0.9 * frac, Color3.fromRGB(255, 240, 200))
		self:emoji(hitPos + Vector3.new(0, d * 0.5, 0), "💫", 0.7)
	end)
	movement.Landed:Connect(function(impact)
		local ball = state.ball
		if ball and impact > 25 then
			local d = state.diameter
			self:dust(ball.Position - Vector3.new(0, d / 2, 0), d)
			if impact > 60 then
				self:shockwave(ball.Position - Vector3.new(0, d / 2 - 0.2, 0), d * 1.2)
			end
		end
	end)
	movement.Dashed:Connect(function()
		local ball = state.ball
		if ball then
			self:dust(ball.Position - Vector3.new(0, state.diameter / 2, 0), state.diameter * 0.8)
		end
	end)
	world.GoalUnlocked:Connect(function()
		local ball = state.ball
		if ball then
			self:sparkle(ball.Position, Color3.fromRGB(255, 214, 64), math.clamp(state.diameter * 0.3, 0.6, 30), 30)
			self:shockwave(ball.Position - Vector3.new(0, state.diameter / 2 - 0.2, 0), state.diameter * 2, Color3.fromRGB(255, 214, 64))
		end
	end)
	Net.connect("Absorbed", function(list)
		local ball = state.ball
		if not ball then
			return
		end
		for _, a in list do
			if a.n or a.v then
				local def = PropLibrary.get(a.uid)
				if def then
					self:sparkle(ball.Position + Vector3.new(0, state.diameter * 0.6, 0), Rarity.color(def.rarity, settings.values.colorblind), math.clamp(state.diameter * 0.2, 0.5, 20), 16)
				end
			end
		end
	end)
	state.BallChanged:Connect(function(part)
		if part then
			task.delay(0.5, setupTrail)
		end
	end)
	RunService.RenderStepped:Connect(updateTrail)
end

return VFXController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="81">
            <Properties>
              <string name="Name">WorldController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Client side of the world: builds prop visuals from the compact server snapshot (only near the
-- camera, distance-scaled per prop), predicts absorbs for instant feel and sends claims, animates
-- removals/loot/critters, toggles collision on props that are too big (bonk!), highlights
-- "almost" targets, and tracks the next size goal for the HUD.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)
local SpatialHash = require(Shared.Util.SpatialHash)
local PropCodec = require(Shared.Util.PropCodec)
local MathUtil = require(Shared.Util.MathUtil)
local PropLibrary = require(Shared.Logic.PropLibrary)
local Absorb = require(Shared.Logic.Absorb)
local Mutations = require(Shared.Data.Mutations)
local Rarity = require(Shared.Config.Rarity)
local Tuning = require(Shared.Config.Tuning)
local Kits = require(Shared.Data.Kits)
local PropBuilder = require(Shared.PropBuilder)

local WorldController = {}

WorldController.props = {} :: { [number]: any }
WorldController.hash = SpatialHash.new(32)
WorldController.maxRadius = 1
WorldController.kitId = nil
WorldController.roundId = 0
WorldController.landmarkId = 0
WorldController.ready = false
WorldController.templateProgress = 0
WorldController.nextGoal = nil -- { uid, needDiameter }
WorldController.bigGoal = nil

WorldController.WorldLoaded = Signal.new()
WorldController.PropAbsorbed = Signal.new() -- (prop, absorberKey, isLocalPrediction)
WorldController.GoalUnlocked = Signal.new() -- (uid)
WorldController.TemplateProgress = Signal.new() -- (done, total)

local controllers
local state, settings
local folder: Folder
local myUserId = Players.LocalPlayer.UserId
local claims = {}
local arcs = {} -- loot / knock-off flight animations
local critterVisuals = {} -- id -> { model, parts, offsets, display = CFrame, target }
local highlightPool = {}
local unlockedUids = {}
local queryScratch = {}

function WorldController:init(c)
	controllers = c
end

local function propRenderDistance(p): number
	if p.landmark then
		return math.huge
	end
	local g = Tuning.Graphics
	local q = if settings then settings:qualityFactor() else 1
	return math.clamp(p.absorbSize * g.PropRenderScale, g.PropRenderMin, g.PropRenderMax) * q
end

local function makeEntry(r, loot: boolean)
	local def = PropLibrary.get(r.uid)
	if not def then
		return nil
	end
	local mut = Mutations.get(r.mutation)
	local eff = r.scale * (if mut then mut.scale else 1)
	local m = def.metrics
	local p = {
		id = r.id,
		uid = r.uid,
		def = def,
		x = r.x,
		y = r.y,
		z = r.z,
		yaw = r.yaw,
		scale = r.scale,
		eff = eff,
		mutation = r.mutation,
		absorbSize = m.absorbSize * eff,
		radius = m.contactRadius * eff,
		cy = r.y + m.centerY * eff,
		landmark = def.landmark,
		critter = def.critter ~= nil,
		loot = loot,
		activeAt = 0,
		state = "world",
		model = nil,
		collides = false,
	}
	p.renderDist = propRenderDistance(p)
	return p
end

local function placeModel(p)
	local model = p.model
	if not model then
		return
	end
	model:PivotTo(CFrame.new(p.x, p.y, p.z) * CFrame.Angles(0, p.yaw, 0))
end

local function addSparkle(p)
	local rarity = Rarity.get(p.def.rarity)
	local mut = Mutations.get(p.mutation)
	if not (rarity.sparkle or mut) or not p.model or not p.model.PrimaryPart then
		return
	end
	local vfx = controllers.VFXController
	if vfx then
		vfx:attachGlint(p.model.PrimaryPart, if mut and mut.color then Color3.fromHex(mut.color) else rarity.color, mut ~= nil)
	end
end

local function spawnVisual(p, force: boolean?): boolean
	if p.model then
		return true
	end
	if p.state ~= "world" and not force then
		return true
	end
	if not PropBuilder.hasTemplate(p.uid) then
		return false
	end
	local model = PropBuilder.create(p.uid, p.id, p.scale, p.mutation)
	if not model then
		return false
	end
	p.model = model
	local hitbox = model.PrimaryPart
	if hitbox then
		hitbox.CollisionGroup = "Props"
		hitbox.CanCollide = p.collides
		hitbox.CanQuery = p.collides
		hitbox:SetAttribute("PropId", p.id)
	end
	placeModel(p)
	model.Parent = folder
	addSparkle(p)
	if p.critter then
		WorldController:registerCritterVisual(p)
	end
	if p.landmark and controllers.HudController then
		controllers.HudController:attachLandmarkMarker(p)
	end
	return true
end

local function despawnVisual(p)
	if p.model then
		critterVisuals[p.id] = nil
		p.model:Destroy()
		p.model = nil
	end
end

function WorldController:clear()
	for _, p in self.props do
		if p.model then
			p.model:Destroy()
		end
	end
	table.clear(self.props)
	table.clear(critterVisuals)
	table.clear(arcs)
	table.clear(claims)
	table.clear(unlockedUids)
	self.hash = SpatialHash.new(32)
	self.maxRadius = 1
	self.nextGoal = nil
	self.bigGoal = nil
end

function WorldController:get(id: number)
	return self.props[id]
end

-- Prioritised background template building: what's near spawn first, then by frequency.
local function prepareTemplates(kitId: string, spawnCenter)
	local counts = {}
	local nearScore = {}
	for _, p in WorldController.props do
		counts[p.uid] = (counts[p.uid] or 0) + 1
		local dx, dz = p.x - spawnCenter[1], p.z - spawnCenter[3]
		if dx * dx + dz * dz < 220 * 220 then
			nearScore[p.uid] = (nearScore[p.uid] or 0) + 1
		end
	end
	local uids = {}
	local defs: { any } = PropLibrary.ByKit[kitId] or {}
	for _, def in defs do
		table.insert(uids, def.uid)
	end
	table.sort(uids, function(a, b)
		local na, nb = nearScore[a] or 0, nearScore[b] or 0
		if na ~= nb then
			return na > nb
		end
		return (counts[a] or 0) > (counts[b] or 0)
	end)
	local roundId = WorldController.roundId
	PropBuilder.prepareAsync(uids, function(done, total)
		if WorldController.roundId ~= roundId then
			return
		end
		WorldController.templateProgress = done / total
		WorldController.TemplateProgress:Fire(done, total)
	end)
end

local function onWorldLoad(info, buf)
	local self = WorldController
	self:clear()
	self.kitId = info.kitId
	self.roundId = info.roundId
	self.landmarkId = info.landmarkId
	self.ready = false
	local folderName = "ClientProps"
	folder = Workspace:FindFirstChild(folderName) or Instance.new("Folder")
	folder.Name = folderName
	folder.Parent = Workspace
	for _, r in PropCodec.decode(buf) do
		local p = makeEntry(r, false)
		if p then
			self.props[p.id] = p
			self.hash:insert(p.id, p.x, p.z, p.radius)
			self.maxRadius = math.max(self.maxRadius, p.radius)
		end
	end
	self.ready = true
	self.WorldLoaded:Fire(info)
	task.spawn(prepareTemplates, info.kitId, info.spawnCenter or { 0, 0, 0 })
	-- Warm the other kits of this tier in the background so the next round loads instantly.
	task.delay(20, function()
		for _, kit in Kits.forTier(Kits.get(info.kitId).tier) do
			if kit.id ~= info.kitId then
				local uids = {}
				for _, def in PropLibrary.ByKit[kit.id] do
					table.insert(uids, def.uid)
				end
				PropBuilder.prepareAsync(uids)
			end
		end
	end)
end

-- Fly-in or poof for a removed prop. absorberKey = ball owner's userId (0 = vanished).
local function handleRemoval(p, absorberKey: number)
	local balls = controllers.BallVisualController
	WorldController.hash:remove(p.id)
	WorldController.props[p.id] = nil
	if p.state == "predicted" then
		if absorberKey == myUserId then
			p.state = "gone"
			return
		end
		-- Someone else got it first: reassign the visual to their ball.
		if balls then
			balls:reassign(myUserId, absorberKey, p)
		end
		p.state = "gone"
		return
	end
	p.state = "gone"
	if absorberKey ~= 0 and balls and balls:hasBall(absorberKey) then
		if not p.model then
			spawnVisual(p, true)
		end
		balls:absorbProp(absorberKey, p)
		WorldController.PropAbsorbed:Fire(p, absorberKey, false)
	else
		if p.model and controllers.VFXController then
			controllers.VFXController:poof(p.model:GetPivot().Position, p.absorbSize)
		end
		despawnVisual(p)
	end
end

local function onPropsRemoved(list)
	for _, entry in list do
		local id, absorberKey = entry[1], entry[2]
		local p = WorldController.props[id]
		if p then
			handleRemoval(p, absorberKey)
		end
	end
end

local function onLoot(buf, origins, settles)
	local self = WorldController
	local now = os.clock()
	for i, r in PropCodec.decode(buf) do
		local p = makeEntry(r, true)
		if p then
			local settle = settles[i] or Tuning.World.LootSettleTime
			p.activeAt = now + settle
			self.props[p.id] = p
			self.hash:insert(p.id, p.x, p.z, p.radius)
			self.maxRadius = math.max(self.maxRadius, p.radius)
			local from = origins[i]
			if typeof(from) == "Vector3" and spawnVisual(p) and p.model then
				table.insert(arcs, {
					prop = p,
					from = from,
					to = Vector3.new(p.x, p.y, p.z),
					t0 = now,
					dur = settle,
					spin = (math.random() - 0.5) * 12,
					height = math.max(6, (from - Vector3.new(p.x, p.y, p.z)).Magnitude * 0.35),
				})
			end
		end
	end
end

local function onMutated(list)
	for _, entry in list do
		local p = WorldController.props[entry[1]]
		if p then
			local r = { id = p.id, uid = p.uid, x = p.x, y = p.y, z = p.z, yaw = p.yaw, scale = p.scale, mutation = entry[2] }
			local updated = makeEntry(r, p.loot)
			updated.state = p.state
			despawnVisual(p)
			WorldController.props[p.id] = updated
			WorldController.hash:move(p.id, p.x, p.z, updated.radius)
			if controllers.VFXController then
				controllers.VFXController:poof(Vector3.new(p.x, p.cy, p.z), p.absorbSize, Color3.fromRGB(255, 220, 110))
			end
		end
	end
end

-- Critters ------------------------------------------------------------------------------------

function WorldController:registerCritterVisual(p)
	local model = p.model
	if not model or not model.PrimaryPart then
		return
	end
	local pivot = model:GetPivot()
	local parts, offsets, tags, pivots = {}, {}, {}, {}
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			table.insert(parts, d)
			table.insert(offsets, pivot:ToObjectSpace(d.CFrame))
			table.insert(tags, d:GetAttribute("Tag"))
			local pv = d:GetAttribute("Pivot")
			table.insert(pivots, if typeof(pv) == "Vector3" then pv * p.eff else nil)
		end
	end
	critterVisuals[p.id] = {
		prop = p,
		parts = parts,
		offsets = offsets,
		tags = tags,
		pivots = pivots,
		display = pivot,
		phase = math.random() * 10,
		state = 0,
		reactUntil = 0,
	}
end

local function onCritterState(buf)
	local now = os.clock()
	for _, r in PropCodec.decodeCritters(buf) do
		local p = WorldController.props[r.id]
		if p and p.state == "world" then
			p.x, p.y, p.z, p.yaw = r.x, r.y, r.z, r.yaw
			p.cy = r.y + p.def.metrics.centerY * p.eff
			WorldController.hash:move(p.id, p.x, p.z, p.radius)
			local vis = critterVisuals[p.id]
			if vis then
				if r.state == 2 and vis.state ~= 2 and controllers.VFXController then
					controllers.VFXController:emoji(Vector3.new(p.x, p.cy + p.def.metrics.sy * p.eff * 0.7, p.z), "❗", 0.8)
				end
				vis.state = r.state
				vis.lastUpdate = now
			end
		end
	end
end

local function animateCritters(dt: number)
	local cframes, partsList = {}, {}
	for id, vis in critterVisuals do
		local p = vis.prop
		if not p.model or p.state ~= "world" then
			critterVisuals[id] = nil
			continue
		end
		local target = CFrame.new(p.x, p.y, p.z) * CFrame.Angles(0, p.yaw, 0)
		vis.display = vis.display:Lerp(target, MathUtil.damp(10, dt))
		local moving = vis.state ~= 0
		local style = p.def.critter.style
		local speedMul = if vis.state == 2 or vis.state == 3 then 2.2 else 1
		vis.phase += dt * (if moving then 9 * speedMul else 2)
		local ph = vis.phase
		local h = p.def.metrics.sy * p.eff
		local bob, tilt, roll = 0, 0, 0
		if style == "hop" then
			bob = if moving then math.abs(math.sin(ph * 0.6)) * h * 0.5 else math.abs(math.sin(ph)) * h * 0.03
		elseif style == "waddle" then
			roll = math.sin(ph) * (if moving then 0.18 else 0.04)
			bob = math.abs(math.sin(ph)) * h * 0.06
		elseif style == "fly" then
			bob = (p.def.critter.hover or 3) * p.eff + math.sin(ph * 0.5) * h * 0.4
			roll = math.sin(ph * 0.3) * 0.1
		elseif style == "glide" then
			bob = 0
			tilt = math.sin(ph * 0.4) * 0.03
		elseif style == "wiggle" then
			roll = math.sin(ph * 1.3) * 0.12
		else -- scurry / trot / run
			bob = if moving then math.abs(math.sin(ph)) * h * 0.08 else 0
			tilt = if moving then -0.08 * speedMul else 0
		end
		local base = vis.display * CFrame.new(0, bob, 0) * CFrame.Angles(tilt, 0, roll)
		for i, part in vis.parts do
			local offset = vis.offsets[i]
			local tag = vis.tags[i]
			local pivot = vis.pivots[i]
			if pivot and (tag == "leg" or tag == "wing" or tag == "tail" or tag == "head") then
				-- Rotate about the part's own pivot point (top of a leg, root of a wing...).
				local angle = 0
				local axis = "X"
				if tag == "leg" then
					local side = if pivot.X >= 0 then 1 else -1
					local front = if pivot.Z >= 0 then 1 else -1
					angle = if moving then math.sin(ph + (side * front > 0 and 0 or math.pi)) * 0.7 else 0
				elseif tag == "wing" then
					axis = "Z"
					local side = if pivot.X >= 0 then 1 else -1
					angle = side * (if style == "fly" then math.sin(ph * 3.2) * 0.9 else (if moving then math.sin(ph * 1.5) * 0.35 else 0))
				elseif tag == "tail" then
					axis = "Y"
					angle = math.sin(ph * 0.8) * 0.35
				elseif tag == "head" then
					angle = math.sin(ph * 0.5) * 0.08
				end
				local rot = if axis == "X" then CFrame.Angles(angle, 0, 0) elseif axis == "Y" then CFrame.Angles(0, angle, 0) else CFrame.Angles(0, 0, angle)
				local pivotCF = CFrame.new(pivot)
				offset = pivotCF * rot * pivotCF:Inverse() * offset
			end
			table.insert(partsList, part)
			table.insert(cframes, base * offset)
		end
	end
	if #partsList > 0 then
		Workspace:BulkMoveTo(partsList, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

-- Arcs (loot, knocked props) -------------------------------------------------------------------

local function animateArcs()
	local now = os.clock()
	for i = #arcs, 1, -1 do
		local a = arcs[i]
		local p = a.prop
		if not p.model or p.state ~= "world" then
			table.remove(arcs, i)
			continue
		end
		local t = math.clamp((now - a.t0) / a.dur, 0, 1)
		local pos = a.from:Lerp(a.to, t) + Vector3.new(0, math.sin(t * math.pi) * a.height, 0)
		local spin = CFrame.Angles(a.spin * (1 - t) * t, p.yaw + a.spin * t, 0)
		p.model:PivotTo(CFrame.new(pos) * spin)
		if t >= 1 then
			placeModel(p)
			if controllers.VFXController then
				controllers.VFXController:dust(a.to, math.max(1, p.absorbSize * 0.6))
			end
			table.remove(arcs, i)
		end
	end
end

-- Prediction + claims -------------------------------------------------------------------------

local function predict()
	if not state:isRolling() or state.round.state ~= "Playing" then
		return
	end
	local ball = state.ball
	local d = state.diameter
	local r = d / 2
	local pos = ball.Position
	local ctx = state:absorbContext()
	local now = os.clock()
	table.clear(queryScratch)
	WorldController.hash:query(pos.X, pos.Z, r + WorldController.maxRadius + 2, queryScratch)
	for _, id in queryScratch do
		local p = WorldController.props[id]
		if p and p.state == "world" and (not p.loot or now >= p.activeAt) then
			if Absorb.canAbsorbProp(d, p.absorbSize, p.landmark, ctx) and Absorb.inContact(pos.X, pos.Y, pos.Z, r, p.x, p.cy, p.z, p.radius, 0.4) then
				if not p.model then
					spawnVisual(p, true)
				end
				p.state = "predicted"
				p.predictedAt = now
				table.insert(claims, p.id)
				local balls = controllers.BallVisualController
				if balls then
					balls:absorbProp(myUserId, p)
				end
				WorldController.PropAbsorbed:Fire(p, myUserId, true)
			end
		end
	end
	if #claims > 0 then
		local batch = {}
		for i = 1, math.min(#claims, 48) do
			batch[i] = claims[i]
		end
		for _ = 1, #batch do
			table.remove(claims, 1)
		end
		Net.send("AbsorbClaim", batch)
	end
end

-- Predictions the server never confirmed are restored (rare: e.g. another player got there first
-- and the removal is still in flight, or a claim was rejected).
local function reconcile()
	local now = os.clock()
	for _, p in WorldController.props do
		if p.state == "predicted" and now - (p.predictedAt or now) > 1.6 then
			p.state = "world"
			local balls = controllers.BallVisualController
			if balls then
				balls:release(myUserId, p)
			end
			if p.model then
				p.model:Destroy()
				p.model = nil
			end
		end
	end
end

-- Rendering, collision, highlights, goals ------------------------------------------------------

local function renderPass()
	if not WorldController.ready then
		return
	end
	local cam = Workspace.CurrentCamera
	local focus = if state.ball and state.ball.Parent then state.ball.Position else cam.CFrame.Position
	local d = state.diameter
	local threshold = Absorb.threshold(d, state:absorbContext())
	local toSpawn = {}
	for _, p in WorldController.props do
		if p.state ~= "world" then
			continue
		end
		local dx, dz = p.x - focus.X, p.z - focus.Z
		local distSq = dx * dx + dz * dz
		-- Render distance grows with the ball a little so big rollers see the next feeding grounds.
		local rd = p.renderDist * (1 + math.min(d / 120, 1.5))
		if p.model then
			if distSq > (rd * 1.15) ^ 2 then
				despawnVisual(p)
			end
		elseif distSq < rd * rd then
			table.insert(toSpawn, { p = p, d = distSq })
		end
		-- Collision only on props too big to absorb (they bonk); everything smaller rolls in.
		if p.model and distSq < (d * 3 + 40) ^ 2 then
			local collide = p.absorbSize > threshold or (p.landmark and not state:isFinalRoll())
			if collide ~= p.collides then
				p.collides = collide
				local hb = p.model.PrimaryPart
				if hb then
					hb.CanCollide = collide
					hb.CanQuery = collide
				end
			end
		end
	end
	table.sort(toSpawn, function(a, b)
		return a.d < b.d
	end)
	local budget = 40
	for _, entry in toSpawn do
		if budget <= 0 then
			break
		end
		if spawnVisual(entry.p) then
			budget -= 1
		end
	end
end

local function updateHighlights()
	if not state:isRolling() then
		for _, h in highlightPool do
			h.Adornee = nil
		end
		return
	end
	local pos = state.ball.Position
	local d = state.diameter
	local threshold = Absorb.threshold(d, state:absorbContext())
	local candidates = {}
	table.clear(queryScratch)
	WorldController.hash:query(pos.X, pos.Z, d * 6 + 40, queryScratch)
	for _, id in queryScratch do
		local p = WorldController.props[id]
		if p and p.model and p.state == "world" and not p.landmark and p.absorbSize > threshold and p.absorbSize <= threshold * 1.3 then
			local dx, dz = p.x - pos.X, p.z - pos.Z
			table.insert(candidates, { p = p, d = dx * dx + dz * dz })
		end
	end
	table.sort(candidates, function(a, b)
		return a.d < b.d
	end)
	for i = 1, 5 do
		local h = highlightPool[i]
		if not h then
			h = Instance.new("Highlight")
			h.FillColor = Color3.fromRGB(255, 214, 64)
			h.OutlineColor = Color3.fromRGB(255, 236, 160)
			h.FillTransparency = 0.88
			h.OutlineTransparency = 0.25
			h.DepthMode = Enum.HighlightDepthMode.Occluded
			h.Parent = folder
			highlightPool[i] = h
		end
		local c = candidates[i]
		h.Adornee = if c then c.p.model else nil
		if c then
			-- Brighter the closer we are to being able to roll it up.
			local closeness = 1 - math.clamp((c.p.absorbSize - threshold) / (threshold * 0.3), 0, 1)
			h.OutlineTransparency = 0.6 - closeness * 0.45
		end
	end
end

-- Next goal = the smallest kind of thing on the map we can't roll up yet; big goal = the landmark.
local function updateGoals()
	local d = state.diameter
	local ctx = state:absorbContext()
	local threshold = Absorb.threshold(d, ctx)
	local best, bestSize = nil, math.huge
	local present = {}
	for _, p in WorldController.props do
		if p.state == "world" and not p.landmark then
			present[p.uid] = true
			if p.absorbSize > threshold and p.def.metrics.absorbSize < bestSize then
				best, bestSize = p.uid, p.def.metrics.absorbSize
			end
		end
	end
	local prev = WorldController.nextGoal
	WorldController.nextGoal = if best then { uid = best, needDiameter = bestSize / Absorb.ratio(ctx) } else nil
	if prev and (not WorldController.nextGoal or WorldController.nextGoal.uid ~= prev.uid) and not unlockedUids[prev.uid] and d >= prev.needDiameter * 0.98 then
		unlockedUids[prev.uid] = true
		WorldController.GoalUnlocked:Fire(prev.uid)
	end
	local landmark = WorldController.props[WorldController.landmarkId]
	if landmark then
		WorldController.bigGoal = { uid = landmark.uid, needDiameter = landmark.absorbSize / Tuning.Absorb.LandmarkReach, prop = landmark }
	else
		WorldController.bigGoal = nil
	end
end

-- Weighted centre of absorbable props ahead (mobile auto-steer assist).
function WorldController:steerTarget(pos: Vector3, dir: Vector3, d: number): Vector3?
	local range = d * Tuning.Ball.AutoSteerRange + 10
	local threshold = Absorb.threshold(d, state:absorbContext())
	local sum, weight = Vector3.zero, 0
	table.clear(queryScratch)
	self.hash:query(pos.X, pos.Z, range, queryScratch)
	local flatDir = Vector3.new(dir.X, 0, dir.Z)
	if flatDir.Magnitude < 1e-3 then
		return nil
	end
	flatDir = flatDir.Unit
	for _, id in queryScratch do
		local p = self.props[id]
		if p and p.state == "world" and p.absorbSize <= threshold then
			local to = Vector3.new(p.x - pos.X, 0, p.z - pos.Z)
			local dist = to.Magnitude
			if dist > 0.5 and dist < range and to.Unit:Dot(flatDir) > 0.75 then
				local w = (p.absorbSize / threshold + 0.3) / (dist + 2)
				sum += Vector3.new(p.x, 0, p.z) * w
				weight += w
			end
		end
	end
	if weight <= 0 then
		return nil
	end
	return sum / weight
end

function WorldController:start()
	state = controllers.ClientState
	settings = controllers.SettingsController
	folder = Workspace:FindFirstChild("ClientProps") or Instance.new("Folder")
	folder.Name = "ClientProps"
	folder.Parent = Workspace
	Net.connect("WorldLoad", onWorldLoad)
	Net.connect("PropsRemoved", onPropsRemoved)
	Net.connect("LootSpawned", onLoot)
	Net.connect("PropsMutated", onMutated)
	Net.connect("CritterState", onCritterState)
	RunService.Heartbeat:Connect(predict)
	RunService.RenderStepped:Connect(function(dt)
		animateArcs()
		animateCritters(dt)
	end)
	task.spawn(function()
		while true do
			task.wait(0.2)
			local ok, err = pcall(renderPass)
			if not ok then
				warn("[World] render pass: " .. tostring(err))
			end
			reconcile()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(0.3)
			pcall(updateHighlights)
			pcall(updateGoals)
		end
	end)
	settings.Changed:Connect(function(key)
		if key == "quality" then
			for _, p in self.props do
				p.renderDist = propRenderDistance(p)
			end
		end
	end)
end

return WorldController
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="82">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="83">
            <Properties>
              <string name="Name">Ui</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Tiny declarative UI helpers for a cohesive, chunky, bouncy look (no default Roblox styling).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Theme = require(ReplicatedStorage.Shared.Config.Theme)

local Ui: any = {}

-- Ui.new("Frame", { Size = ..., [Ui.Children] = {...} })
function Ui.new(className: string, props: { [any]: any }?, children: { Instance }?): any
	local inst: any = Instance.new(className)
	if inst:IsA("GuiObject") then
		(inst :: any).BorderSizePixel = 0
	end
	if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
		(inst :: any).FontFace = Theme.Font.Bold;
		(inst :: any).TextColor3 = Theme.Color.White;
		(inst :: any).BackgroundTransparency = 1
	end
	local parent = nil
	local propList: { [any]: any } = props or {}
	for k, v in propList do
		if k == "Parent" then
			parent = v
		else
			(inst :: any)[k] = v
		end
	end
	local childList: { Instance } = children or {}
	for _, child in childList do
		child.Parent = inst
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function Ui.corner(radius: UDim?): UICorner
	return Ui.new("UICorner", { CornerRadius = radius or Theme.Radius.Medium }) :: UICorner
end

function Ui.stroke(thickness: number?, color: Color3?, mode: Enum.ApplyStrokeMode?): UIStroke
	return Ui.new("UIStroke", {
		Thickness = thickness or Theme.Stroke.Medium,
		Color = color or Theme.Color.Ink,
		ApplyStrokeMode = mode or Enum.ApplyStrokeMode.Contextual,
		LineJoinMode = Enum.LineJoinMode.Round,
	}) :: UIStroke
end

function Ui.padding(px: number): UIPadding
	local u = UDim.new(0, px)
	return Ui.new("UIPadding", { PaddingTop = u, PaddingBottom = u, PaddingLeft = u, PaddingRight = u }) :: UIPadding
end

function Ui.gradient(top: Color3, bottom: Color3, rotation: number?): UIGradient
	return Ui.new("UIGradient", { Color = ColorSequence.new(top, bottom), Rotation = rotation or 90 }) :: UIGradient
end

function Ui.tween(inst: Instance, info: TweenInfo, goals: { [string]: any }): Tween
	local t = TweenService:Create(inst, info, goals)
	t:Play()
	return t
end

-- Big outlined display text (size counter, banners).
function Ui.display(text: string, props: { [any]: any }?): TextLabel
	local label = Ui.new("TextLabel", {
		Text = text,
		FontFace = Theme.Font.Display,
		TextScaled = true,
		TextColor3 = Theme.Color.White,
	}, { Ui.stroke(4, Theme.Color.Ink) })
	local propList: { [any]: any } = props or {}
	for k, v in propList do
		label[k] = v
	end
	return label
end

-- Chunky button with a drop "lip", hover/press bounce and click sound.
function Ui.button(props: { [string]: any }): (TextButton, Frame)
	local color = props.color or Theme.Color.Primary
	local h, s, v = color:ToHSV()
	local dark = Color3.fromHSV(h, math.min(1, s * 1.1), v * 0.72)
	local holder = Ui.new("Frame", {
		Name = props.name or "Button",
		Size = props.size or UDim2.fromOffset(160, 64),
		Position = props.position or UDim2.new(),
		AnchorPoint = props.anchor or Vector2.zero,
		BackgroundColor3 = dark,
		LayoutOrder = props.order or 0,
		Parent = props.parent,
	}, {
		Ui.corner(props.radius or Theme.Radius.Medium),
	}) :: Frame
	local scale = Ui.new("UIScale", { Parent = holder }) :: UIScale
	local button = Ui.new("TextButton", {
		Name = "Face",
		Size = UDim2.new(1, 0, 1, -6),
		BackgroundColor3 = color,
		BackgroundTransparency = 0,
		AutoButtonColor = false,
		Text = props.text or "",
		TextScaled = true,
		FontFace = props.font or Theme.Font.Bold,
		Parent = holder,
	}, {
		Ui.corner(props.radius or Theme.Radius.Medium),
		Ui.stroke(3, Theme.Color.Ink, Enum.ApplyStrokeMode.Border),
		Ui.new("UIGradient", {
			Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(225, 225, 225)),
			Rotation = 90,
		}),
		Ui.new("UIPadding", { PaddingTop = UDim.new(0.14, 0), PaddingBottom = UDim.new(0.14, 0), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }),
	}) :: TextButton
	local textStroke = Ui.stroke(2.5, Theme.Color.Ink, Enum.ApplyStrokeMode.Contextual)
	textStroke.Parent = button
	button.MouseEnter:Connect(function()
		Ui.tween(scale, Theme.Tween.Quick, { Scale = 1.05 })
	end)
	button.MouseLeave:Connect(function()
		Ui.tween(scale, Theme.Tween.Quick, { Scale = 1 })
		Ui.tween(button, Theme.Tween.Quick, { Position = UDim2.new() })
	end)
	button.MouseButton1Down:Connect(function()
		Ui.tween(scale, Theme.Tween.Quick, { Scale = 0.94 })
		Ui.tween(button, Theme.Tween.Quick, { Position = UDim2.fromOffset(0, 4) })
	end)
	button.MouseButton1Up:Connect(function()
		Ui.tween(scale, Theme.Tween.Pop, { Scale = 1 })
		Ui.tween(button, Theme.Tween.Quick, { Position = UDim2.new() })
	end)
	if props.onClick then
		button.Activated:Connect(function()
			if Ui.onClickSound then
				Ui.onClickSound()
			end
			props.onClick()
		end)
	end
	return button, holder
end

-- A ViewportFrame showing a model, auto-framed. `model` is cloned.
function Ui.viewport(model: Model?, props: { [any]: any }?): ViewportFrame
	local vp = Ui.new("ViewportFrame", {
		BackgroundTransparency = 1,
		Ambient = Color3.fromRGB(200, 190, 220),
		LightColor = Color3.fromRGB(255, 248, 235),
		LightDirection = Vector3.new(-0.6, -1, -0.5),
	})
	local propList: { [any]: any } = props or {}
	for k, v in propList do
		vp[k] = v
	end
	if model then
		Ui.setViewportModel(vp, model)
	end
	return vp
end

function Ui.setViewportModel(vp: ViewportFrame, model: Model, silhouette: boolean?)
	for _, c in vp:GetChildren() do
		if c:IsA("Model") or c:IsA("Camera") or c:IsA("WorldModel") then
			c:Destroy()
		end
	end
	local clone = model:Clone()
	for _, d in clone:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
			if silhouette then
				d.Color = Color3.fromRGB(40, 28, 80)
				d.Material = Enum.Material.SmoothPlastic
			end
		elseif d:IsA("ParticleEmitter") or d:IsA("PointLight") then
			d:Destroy()
		end
	end
	clone:PivotTo(CFrame.new())
	clone.Parent = vp
	local cf, size = clone:GetBoundingBox()
	local radius = math.max(size.Magnitude / 2, 0.2)
	local cam = Instance.new("Camera")
	cam.FieldOfView = 30
	local dir = Vector3.new(0.7, 0.5, 1).Unit
	cam.CFrame = CFrame.lookAt(cf.Position + dir * radius / math.sin(math.rad(15)) * 1.05, cf.Position)
	cam.Parent = vp
	vp.CurrentCamera = cam
end

-- Uniform UI scale so layouts read the same on phones, tablets, PCs and TVs.
function Ui.autoScale(gui: ScreenGui): UIScale
	local scale = Ui.new("UIScale", { Parent = gui }) :: UIScale
	local function update()
		local cam = Workspace.CurrentCamera
		local vs = cam.ViewportSize
		local s = math.clamp(math.min(vs.X / 1280, vs.Y / 760), 0.6, 1.4)
		if game:GetService("GuiService"):IsTenFootInterface() then
			s *= 1.25
		end
		scale.Scale = s
	end
	update()
	Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(update)
	return scale
end

return Ui
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
