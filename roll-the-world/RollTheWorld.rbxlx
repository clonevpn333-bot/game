		pip(0.5, 2.0, 0.5)
		pip(-0.5, 2.0, 0.5)
		pip(0.5, 2.0, -0.5)
		pip(-0.45, 1.45, 1.0)
		pip(0.45, 0.55, 1.0)
		pip(1.0, 1.5, -0.5)
