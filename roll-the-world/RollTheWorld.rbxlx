			items = {
				{ "frying_pan", 1 },
				{ "stock_pot", 1 },
				{ "pancake_stack", 2 },
				{ "spatula", 2 },
				{ "oven_mitt", 1 },
				{ "kettle", 1 },
			},
		},
	},

	critters = {
		{ id = "ant", count = { 10, 16 } },
		{ id = "ladybug", count = { 4, 6 } },
		{ id = "hamster", count = { 1, 2 } },
		{ id = "tabby_cat", count = { 1, 2 } },
		{ id = "robot_vacuum", count = { 1, 1 }, chance = 0.8 },
		{ id = "golden_retriever", count = { 1, 1 }, chance = 0.75 },
		{ id = "moon_mouse", count = { 1, 1 }, chance = 0.25 },
	},
	stampede = { "hamster", "hamster", "ladybug", "tabby_cat", "moon_mouse" },
	replenish = { "crumb", "sesame", "pea", "rice", "cereal_ring", "sugar_cube", "coffee_bean" },

	landmark = { id = "fridge", placement = "edge" },

	lighting = {
		ClockTime = 9.3,
		Brightness = 2.7,
		Ambient = "#8c7f73",
		OutdoorAmbient = "#c9b8a6",
		ColorShift_Top = "#ffe4c4",
		FogColor = "#ffe9d0",
		FogEnd = 4000,
		ExposureCompensation = 0.1,
		atmosphere = { Density = 0.22, Offset = 0.1, Color = "#fff1dc", Decay = "#d9a37a", Glare = 0.3, Haze = 1.2 },
		color = { Saturation = 0.12, Contrast = 0.08, Brightness = 0.02, TintColor = "#fff8f0" },
		bloom = { Intensity = 0.55, Size = 26, Threshold = 1.5 },
		sunRays = { Intensity = 0.06, Spread = 0.6 },
	},
}
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">Modes</string>
            <string name="Source"><![CDATA[--!strict
-- Game modes. Every round is one map + one mode, picked by a vote between rounds, so two rounds
-- in a row rarely play the same. A mode changes how you win (scoring), and can change round
-- length, event pacing, growth and the rules of rolling each other up (teams).

export type Scoring = "size" | "crown" | "gold" | "team"

export type ModeDef = {
	id: string,
	name: string,
	icon: string,
	color: string,
	description: string, -- one line on the vote card
	goal: string, -- the round-start banner subtitle
	scoring: Scoring,
	scoreLabel: string, -- what the top list shows
	weight: number,
	length: number?, -- round seconds (default Tuning.Round.Length)
	eventTimes: { number }?, -- big events (seconds after start); default Tuning.Round.EventTimes
	minorGap: { number }?, -- { min, max } seconds between surprises
	growthMult: number?,
	goldenShare: number?, -- share of map props that start Golden
	teams: boolean?,
	minBalls: number?, -- needs at least this many balls (players + bots)
	winnerTitle: string, -- the top award's title
	winnerIcon: string,
}

local Modes = {}

Modes.List = {
	{
		id = "Classic",
		name = "Classic Roll",
		icon = "🌍",
		color = "#ff7a45",
		description = "Roll up everything. Biggest ball wins.",
		goal = "Get as BIG as you can!",
		scoring = "size",
		scoreLabel = "size",
		weight = 3,
		winnerTitle = "Biggest Ball",
		winnerIcon = "🏆",
	},
	{
		id = "TeamRoll",
		name = "Team Roll",
		icon = "🔴🔵",
		color = "#4dc4ff",
		description = "Red vs Blue! Your team's sizes add up. Roll up the other team.",
		goal = "Grow your team, roll up the other team!",
		scoring = "team",
		scoreLabel = "size",
		weight = 2,
		teams = true,
		minBalls = 4,
		winnerTitle = "Team MVP",
		winnerIcon = "🏅",
	},
	{
		id = "CrownChase",
		name = "Crown Chase",
		icon = "👑",
		color = "#ffd640",
		description = "The biggest ball wears the crown. Hold it the longest to win!",
		goal = "Become the biggest and KEEP the crown!",
		scoring = "crown",
		scoreLabel = "crown time",
		weight = 2,
		minBalls = 3,
		winnerTitle = "Crown Keeper",
		winnerIcon = "👑",
	},
	{
		id = "GoldRush",
		name = "Gold Rush",
		icon = "💰",
		color = "#ffc83a",
		description = "The map is full of Golden things. Most gold wins!",
		goal = "Grab everything that sparkles!",
		scoring = "gold",
		scoreLabel = "gold",
		weight = 2,
		length = 330,
		eventTimes = { 100, 220 },
		minorGap = { 30, 45 },
		goldenShare = 0.07,
		winnerTitle = "Gold Rusher",
		winnerIcon = "💰",
	},
	{
		id = "Mayhem",
		name = "Mayhem",
		icon = "🌪️",
		color = "#b06cff",
		description = "Events NON-STOP and everyone grows faster. Pure chaos.",
		goal = "Survive the chaos. Biggest ball wins!",
		scoring = "size",
		scoreLabel = "size",
		weight = 2,
		length = 390,
		eventTimes = { 50, 130, 210, 290 },
		minorGap = { 22, 34 },
		growthMult = 1.25,
		winnerTitle = "Chaos Champion",
		winnerIcon = "🌪️",
	},
} :: { ModeDef }

Modes.ById = {} :: { [string]: ModeDef }
for _, m in Modes.List do
	Modes.ById[m.id] = m
end

function Modes.get(id: string?): ModeDef
	return (id and Modes.ById[id]) or Modes.ById.Classic
end

return Modes
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Mutations</string>
            <string name="Source"><![CDATA[--!strict
-- Mutations are visual/audio layers on top of any prop model. Each counts as its own Rolledex
-- variant. `index` is permanent (it is part of the saved Rolledex bit index) — never reuse one.

export type MutationDef = {
	index: number, -- 1..15 (0 = no mutation)
	id: string,
	name: string,
	color: string?, -- tint applied over every part (nil keeps original colors)
	tintStrength: number, -- 0..1 blend toward `color`
	material: string?,
	reflectance: number?,
	rainbow: boolean?, -- client cycles hue over time
	particle: string?, -- VFX preset name
	light: string?, -- PointLight color
	scale: number, -- size multiplier (Giant/Tiny)
	stardust: number, -- reward multiplier when absorbed
	rarityBoost: number, -- shifts displayed rarity tier up by this many steps
	sound: string?,
	weight: number, -- base natural spawn weight (events multiply these)
}

local Mutations = {}

Mutations.List = {
	{
		index = 1,
		id = "Golden",
		name = "Golden",
		color = "#ffc83a",
		tintStrength = 0.85,
		material = "Foil",
		reflectance = 0.25,
		particle = "Sparkle",
		light = "#ffd76a",
		scale = 1,
		stardust = 3,
		rarityBoost = 1,
		sound = "Coin",
		weight = 0.012,
	},
	{
		index = 2,
		id = "Rainbow",
		name = "Rainbow",
		tintStrength = 0.7,
		rainbow = true,
		material = "SmoothPlastic",
		particle = "Rainbow",
		scale = 1,
		stardust = 4,
		rarityBoost = 2,
		weight = 0.003,
	},
	{
		index = 3,
		id = "Frozen",
		name = "Frozen",
		color = "#bfeaff",
		tintStrength = 0.6,
		material = "Ice",
		reflectance = 0.1,
		particle = "Snow",
		scale = 1,
		stardust = 2,
		rarityBoost = 1,
		weight = 0.006,
	},
	{
		index = 4,
		id = "Electric",
		name = "Electric",
		color = "#7af7ff",
		tintStrength = 0.35,
		material = "Neon",
		particle = "Zap",
		light = "#7af7ff",
		scale = 1,
		stardust = 2.5,
		rarityBoost = 1,
		weight = 0.005,
	},
	{
		index = 5,
		id = "Starfall",
		name = "Starfall",
		color = "#9c7bff",
		tintStrength = 0.55,
		material = "Glass",
		particle = "Stars",
		light = "#b49cff",
		scale = 1,
		stardust = 5,
		rarityBoost = 2,
		weight = 0, -- only from Meteor Shower
	},
	{
		index = 6,
		id = "Giant",
		name = "Giant",
		tintStrength = 0,
		particle = nil,
		scale = 1.7,
		stardust = 2,
		rarityBoost = 1,
		weight = 0.006,
	},
	{
		index = 7,
		id = "Tiny",
		name = "Tiny",
		tintStrength = 0,
		scale = 0.55,
		stardust = 2,
		rarityBoost = 1,
		weight = 0.006,
	},
	{
		index = 8,
		id = "Glitter",
		name = "Glitter",
		color = "#ff8ad8",
		tintStrength = 0.45,
		material = "Glass",
		reflectance = 0.2,
		particle = "Glitter",
		scale = 1,
		stardust = 2.5,
		rarityBoost = 1,
		weight = 0.004,
	},
	{
		index = 9,
		id = "Midnight",
		name = "Midnight",
		color = "#2b2160",
		tintStrength = 0.75,
		material = "Glass",
		particle = "Stars",
		light = "#6b5bff",
		scale = 1,
		stardust = 3,
		rarityBoost = 1,
		weight = 0.002,
	},
} :: { MutationDef }

Mutations.ById = {} :: { [string]: MutationDef }
Mutations.ByIndex = {} :: { [number]: MutationDef }
for _, m in Mutations.List do
	assert(m.index >= 1 and m.index <= 15, "mutation index out of range")
	assert(Mutations.ByIndex[m.index] == nil, "duplicate mutation index")
	Mutations.ById[m.id] = m
	Mutations.ByIndex[m.index] = m
end

Mutations.VariantsPerProp = 16 -- Rolledex bit index = uid * 16 + mutationIndex

function Mutations.get(index: number): MutationDef?
	return Mutations.ByIndex[index]
end

return Mutations
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Mutators</string>
            <string name="Source"><![CDATA[--!strict
-- Round mutators: a twist that lasts the whole round (shown at round start). Most rounds get one,
-- so even the same map + mode feels different. They stack with world events.

export type MutatorDef = {
	id: string,
	name: string,
	icon: string,
	color: string,
	description: string,
	weight: number,
	speedMult: number?,
	hopMult: number?,
	ratioBonus: number?,
	growthMult: number?,
	gravityMult: number?,
	mutationShare: number?, -- share of props that start with a random natural mutation
	critterParty: number?, -- extra critters released at round start
	night: boolean?, -- client: moonlit lighting, props glow softly
}

local Mutators = {}

Mutators.List = {
	{ id = "BouncyDay", name = "Bouncy Day", icon = "🏀", color = "#ff9f1c", description = "Super high hops all round!", weight = 3, hopMult = 1.7 },
	{ id = "SpeedRush", name = "Speed Rush", icon = "💨", color = "#4cc9f0", description = "Everyone rolls 20% faster.", weight = 3, speedMult = 1.2 },
	{ id = "StickyDay", name = "Extra Sticky", icon = "🍯", color = "#ffb703", description = "You can roll up slightly bigger things.", weight = 2, ratioBonus = 0.06 },
	{ id = "Floaty", name = "Floaty", icon = "🎈", color = "#c8b6ff", description = "Low gravity the whole round.", weight = 2, gravityMult = 0.6, hopMult = 1.15 },
	{ id = "RainbowDay", name = "Rainbow Day", icon = "🌈", color = "#ff5c8a", description = "Mutated props everywhere. Rolledex hunters, go!", weight = 2, mutationShare = 0.05 },
	{ id = "CritterParty", name = "Critter Party", icon = "🐾", color = "#7bd88f", description = "Twice the critters running around.", weight = 2, critterParty = 22 },
	{ id = "GrowthSpurt", name = "Growth Spurt", icon = "🌱", color = "#58d674", description = "Everything grows you 20% more.", weight = 2, growthMult = 1.2 },
	{ id = "NightRoll", name = "Night Roll", icon = "🌙", color = "#6c63ff", description = "A moonlit round. Mutated props glow in the dark.", weight = 2, night = true, mutationShare = 0.02 },
} :: { MutatorDef }

Mutators.ById = {} :: { [string]: MutatorDef }
for _, m in Mutators.List do
	Mutators.ById[m.id] = m
end

-- Chance a round gets a mutator at all (first round of a server never does).
Mutators.Chance = 0.7

function Mutators.get(id: string?): MutatorDef?
	return if id then Mutators.ById[id] else nil
end

return Mutators
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">NanaNova</string>
            <string name="Source"><![CDATA[--!strict
-- Nana Nova: the tiny, cheerful cosmic grandma who knits galaxies. Built from parts (recipe data)
-- so she renders anywhere: hub, launch screen viewport, request board. Origin = feet centre.

local S = require(script.Parent.Props.Shapes)
local box, ball, blob, cyl, wedge = S.box, S.ball, S.blob, S.cyl, S.wedge

local SKIN = "#f6d5c1"
local DRESS = "#7b5cd6"
local SHAWL = "#c8b6ff"
local HAIR = "#f1f1f6"
local GOLD = "#ffd166"
local INK = "#2a1f3d"

local NanaNova = {}

NanaNova.Parts = (function()
	local p = {
		-- slippers
		blob(1.4, 0.7, 2.0, -0.7, 0.35, 0.2, "#ff8fab"),
		blob(1.4, 0.7, 2.0, 0.7, 0.35, 0.2, "#ff8fab"),
		ball(0.5, -0.7, 0.75, 1.0, "#ffffff"),
		ball(0.5, 0.7, 0.75, 1.0, "#ffffff"),
		-- dress (a soft bell)
		cyl(4.6, 1.2, 0, 1.2, 0, DRESS, { tag = "body" }),
		blob(4.4, 4.2, 4.0, 0, 3.2, 0, DRESS, { tag = "body" }),
		blob(3.6, 2.0, 3.2, 0, 5.0, 0, DRESS, { tag = "body" }),
		-- star-speckled shawl
		blob(4.6, 1.8, 3.8, 0, 5.4, 0, SHAWL, { tag = "body", mat = "Fabric" }),
		wedge(3.2, 1.8, 1.0, 0, 4.2, 1.6, SHAWL, { tag = "body", mat = "Fabric", rot = { 0, 180, 0 } }),
		ball(0.3, -1.2, 5.6, 1.6, GOLD, { neon = true, tag = "body" }),
		ball(0.25, 1.0, 5.2, 1.7, GOLD, { neon = true, tag = "body" }),
		ball(0.3, 0.2, 4.4, 1.9, GOLD, { neon = true, tag = "body" }),
		ball(0.22, 1.8, 5.8, 0.4, GOLD, { neon = true, tag = "body" }),
		-- head
		ball(3.2, 0, 7.6, 0.1, SKIN, { tag = "head" }),
		ball(0.7, 0, 7.4, 1.65, "#f2b8a2", { tag = "head" }),
		ball(0.7, -1.0, 7.0, 1.3, "#ffb3c1", { tag = "head", t = 0.2 }),
		ball(0.7, 1.0, 7.0, 1.3, "#ffb3c1", { tag = "head", t = 0.2 }),
		blob(0.9, 0.25, 0.3, 0, 6.6, 1.55, "#c0566b", { tag = "head" }),
		-- glasses
		cyl(0.95, 0.12, -0.6, 7.9, 1.55, GOLD, { rot = { 90, 0, 0 }, tag = "head", mat = "Foil" }),
		cyl(0.95, 0.12, 0.6, 7.9, 1.55, GOLD, { rot = { 90, 0, 0 }, tag = "head", mat = "Foil" }),
		cyl(0.75, 0.13, -0.6, 7.9, 1.57, "#e8f6ff", { rot = { 90, 0, 0 }, tag = "head", mat = "Glass", t = 0.3 }),
		cyl(0.75, 0.13, 0.6, 7.9, 1.57, "#e8f6ff", { rot = { 90, 0, 0 }, tag = "head", mat = "Glass", t = 0.3 }),
		ball(0.3, -0.6, 7.95, 1.62, INK, { tag = "head" }),
		ball(0.3, 0.6, 7.95, 1.62, INK, { tag = "head" }),
		box(0.3, 0.08, 0.1, 0, 7.95, 1.6, GOLD, { tag = "head" }),
		-- hair + bun + star pin
		blob(3.5, 2.0, 3.4, 0, 8.6, -0.1, HAIR, { tag = "head", mat = "Fabric" }),
		ball(1.8, 0, 9.9, -0.5, HAIR, { tag = "head", mat = "Fabric" }),
		ball(0.7, 0.9, 10.3, -0.3, GOLD, { neon = true, tag = "head" }),
		-- arms
		blob(1.0, 2.6, 1.0, -2.1, 4.8, 0.6, SHAWL, { rot = { -40, 0, 20 }, tag = "arm" }),
		blob(1.0, 2.6, 1.0, 2.1, 4.8, 0.6, SHAWL, { rot = { -40, 0, -20 }, tag = "arm" }),
		ball(0.8, -1.4, 4.0, 1.8, SKIN, { tag = "arm" }),
		ball(0.8, 1.4, 4.0, 1.8, SKIN, { tag = "arm" }),
		-- knitting needles + the galaxy she's knitting
		cyl(0.16, 3.6, -0.7, 4.6, 2.2, GOLD, { rot = { 0, 0, -50 }, tag = "needle", mat = "Foil" }),
		cyl(0.16, 3.6, 0.7, 4.6, 2.2, GOLD, { rot = { 0, 0, 50 }, tag = "needle", mat = "Foil" }),
		ball(2.0, 0, 3.6, 2.4, "#2b2160", { mat = "Glass", tag = "yarn" }),
		ball(0.35, 0.4, 3.9, 3.3, "#fff3b0", { neon = true, tag = "yarn" }),
		ball(0.25, -0.5, 3.4, 3.3, "#c8b6ff", { neon = true, tag = "yarn" }),
		blob(3.0, 0.15, 3.0, 0, 3.6, 2.4, "#ffafcc", { rot = { 20, 0, 15 }, tag = "yarn", neon = true }),
		-- trailing yarn thread
		box(0.12, 0.12, 2.2, 0.6, 2.6, 3.2, "#ffafcc", { rot = { 30, 20, 0 }, neon = true }),
	}
	return p
end)()

-- Her rocking chair (hub decor).
NanaNova.Chair = {
	box(7, 0.8, 6, 0, 4.2, 0, "#8c5a2e", { mat = "Wood" }),
	box(7, 8, 0.8, 0, 8.6, -2.8, "#8c5a2e", { mat = "Wood" }),
	box(6.4, 1.2, 5.2, 0, 5.0, 0.2, "#c8b6ff", { mat = "Fabric" }),
	box(0.8, 4, 0.8, -3, 2.2, 2.4, "#6f4518", { mat = "Wood" }),
	box(0.8, 4, 0.8, 3, 2.2, 2.4, "#6f4518", { mat = "Wood" }),
	box(0.8, 4, 0.8, -3, 2.2, -2.4, "#6f4518", { mat = "Wood" }),
	box(0.8, 4, 0.8, 3, 2.2, -2.4, "#6f4518", { mat = "Wood" }),
	blob(1, 1, 10, -3, 0.4, 0, "#6f4518", { mat = "Wood" }),
	blob(1, 1, 10, 3, 0.4, 0, "#6f4518", { mat = "Wood" }),
	ball(1.6, 0, 13, -2.8, "#ffd166", { neon = true }),
}

-- Short, wordless-friendly reactions. Icons carry the meaning; text is a bonus.
NanaNova.Lines = {
	greet = { "✨ Hello, dearie! ✨", "🧶 Ready to roll?", "🌟 My sky needs filling!" },
	request = { "🧶 Could you fetch me…", "✨ Oh! I'd love some…", "🌙 Bring Nana…" },
	complete = { "🥰 Wonderful!", "🌟 Just what I needed!", "🧶 You're a star!" },
	launch = { "🚀 Up it goes!", "🌌 Into the sky!", "✨ A brand new planet!" },
	rolled = { "😆 Whoopsie!", "🌀 Round and round!", "💫 Up you get!" },
	legendary = { "😲 My stars!", "🌟 Ooooh, sparkly!", "💖 Treasure!" },
}

return NanaNova
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="27">
          <Properties>
            <string name="Name">Props</string>
          </Properties>
          <Item class="ModuleScript" referent="28">
            <Properties>
              <string name="Name">Backyard</string>
              <string name="Source"><![CDATA[--!strict
-- Backyard BBQ prop library. UIDs 200-299 are reserved for this kit and are permanent.

local S = require(script.Parent.Shapes)
local box, ball, blob, cyl, cylX, wedge, eyes = S.box, S.ball, S.blob, S.cyl, S.cylX, S.wedge, S.eyes
local lathe, rbox, tube, torus, ell, extrude = S.lathe, S.rbox, S.tube, S.torus, S.ell, S.extrude
local shade = S.shade

local P = {}
local function add(def: any)
	table.insert(P, def)
end

local GRASS = "#6cc04a"
local GRASS_DARK = "#4a9a32"
local WOOD = "#b5835a"
local WOOD_DARK = "#7f5539"
local CHROME = "#d9dee6"
local INK = "#2a1f3d"

local function leaf(x: number, y: number, z: number, len: number, yaw: number, color: string?, pitch: number?)
	return blob(len * 0.5, len * 0.12, len, x, y, z, color or GRASS, { rot = { pitch or 20, yaw, 0 } })
end

local function legs4(out: { any }, w: number, l: number, h: number, d: number, color: string)
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			table.insert(out, cyl(d, h, sx * w / 2, h / 2, sz * l / 2, color, { tag = "leg" }))
		end
	end
end

-- Extrude outlines must wind clockwise in (x, z) for outward-facing walls; this fixes either winding.
local function cwPoly(points: { { number } }): { { number } }
	local area = 0
	for i, p in points do
		local q = points[i % #points + 1]
		area += p[1] * q[2] - q[1] * p[2]
	end
	if area <= 0 then
		return points
	end
	local out = {}
	for i = #points, 1, -1 do
		table.insert(out, points[i])
	end
	return out
end

-- Rotate a 2D outline by deg degrees (to spin extruded shapes in their own plane).
local function spinPoly(points: { { number } }, deg: number): { { number } }
	local a = math.rad(deg)
	local c, s = math.cos(a), math.sin(a)
	local out = {}
	for _, p in points do
		table.insert(out, { p[1] * c - p[2] * s, p[1] * s + p[2] * c })
	end
	return out
end

local function star(points: number, outer: number, inner: number): { { number } }
	return cwPoly(S.starOutline(points, outer, inner))
end

local function legs2(out: { any }, w: number, h: number, d: number, color: string, z: number?)
	for _, sx in { -1, 1 } do
		table.insert(out, cyl(d, h, sx * w / 2, h / 2, z or 0, color, { tag = "leg" }))
		table.insert(out, blob(d * 2.2, d * 0.6, d * 2.6, sx * w / 2, d * 0.3, (z or 0) + d * 0.6, color, { tag = "leg" }))
	end
end

