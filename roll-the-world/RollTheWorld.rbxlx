		{ type = "pillars", ring = { 0.5, 0.97 }, count = { 4, 6 }, radius = 12, height = 110, color = "#7f5539", material = "Wood", canopy = { size = 120, solidFoot = 30, color = "#52b788", colors = { "#40916c", "#52b788", "#74c69d", "#2d6a4f" }, material = "Grass" } },
