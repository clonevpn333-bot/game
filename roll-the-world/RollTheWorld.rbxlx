        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">Monetization</string>
            <string name="Source"><![CDATA[--!strict
-- Game pass + developer product ids and display prices.
-- Create each pass/product on the Creator Dashboard and paste its id here. An id of 0 means
-- "not configured": in Studio the purchase is simulated (so the full flow can be tested),
-- in live servers the item is shown as unavailable instead of failing.
-- Display prices are fallbacks; MonetizationService reads live prices via GetProductInfo.

export type PassDef = {
	key: string,
	id: number,
	name: string,
	description: string,
	price: number,
	icon: string,
}

export type ProductDef = {
	key: string,
	id: number,
	name: string,
	description: string,
	price: number,
	icon: string,
	kind: "ServerEvent" | "RollPass" | "Cosmetic" | "AdReward" | "Gift",
	eventId: string?,
}

local Monetization = {}

Monetization.SimulateInStudio = true

Monetization.Passes = {
	VIP = {
		key = "VIP",
		id = 0,
		name = "VIP",
		description = "Golden name tag, VIP lounge in the hub, +10% Stardust.",
		price = 249,
		icon = "👑",
	},
	DoubleStardust = {
		key = "DoubleStardust",
		id = 0,
		name = "2x Stardust",
		description = "Earn double Stardust from every round, forever.",
		price = 399,
		icon = "✨",
	},
	Radar = {
		key = "Radar",
		id = 0,
		name = "Rolledex Radar",
		description = "Undiscovered props nearby glow with a little ping.",
		price = 199,
		icon = "📡",
	},
	PlanetStudio = {
		key = "PlanetStudio",
		id = 0,
		name = "Planet Studio",
		description = "Custom planet colors, extra rings and orbit styles for your galaxy.",
		price = 149,
		icon = "🪐",
	},
	ExtraLoadout = {
		key = "ExtraLoadout",
		id = 0,
		name = "Extra Loadout",
		description = "Save a second Core + cosmetics loadout and swap instantly in the hub.",
		price = 99,
		icon = "🎒",
	},
} :: { [string]: PassDef }

Monetization.Products = {
	EventGoldenHour = {
		key = "EventGoldenHour",
		id = 0,
		name = "Golden Hour",
		description = "Start Golden Hour for the whole server! Everyone finds Golden props.",
		price = 99,
		icon = "🌅",
		kind = "ServerEvent",
		eventId = "GoldenHour",
	},
	EventMeteorShower = {
		key = "EventMeteorShower",
		id = 0,
		name = "Meteor Shower",
		description = "Rain Starfall meteors on the whole server!",
		price = 99,
		icon = "☄️",
		kind = "ServerEvent",
		eventId = "MeteorShower",
	},
	EventStampede = {
		key = "EventStampede",
		id = 0,
		name = "Stampede",
		description = "Send a herd of rare critters across the map for everyone.",
		price = 79,
		icon = "🦆",
		kind = "ServerEvent",
		eventId = "Stampede",
	},
	EventLowGravity = {
		key = "EventLowGravity",
		id = 0,
		name = "Low Gravity",
		description = "Floaty bouncy chaos for the whole server.",
		price = 49,
		icon = "🌙",
		kind = "ServerEvent",
		eventId = "LowGravity",
	},
	RollPassPremium = {
		key = "RollPassPremium",
		id = 0,
		name = "Roll Pass Premium",
		description = "Unlock the premium cosmetic track for this season.",
		price = 449,
		icon = "🎟️",
		kind = "RollPass",
	},
	AdDoubleStardust = {
		key = "AdDoubleStardust",
		id = 0,
		name = "Double Round Stardust",
		description = "Watch a short video to double this round's Stardust.",
		price = 0,
		icon = "📺",
		kind = "AdReward",
	},
} :: { [string]: ProductDef }

-- Server events cannot be bought more often than this, server-wide (seconds), and never during
-- Launch/Results so they always have a round to land in.
Monetization.ServerEventCooldown = 90

function Monetization.passById(id: number): PassDef?
	if id == 0 then
		return nil
	end
	for _, pass in Monetization.Passes do
		if pass.id == id then
			return pass
		end
	end
	return nil
end

function Monetization.productById(id: number): ProductDef?
	if id == 0 then
		return nil
	end
	for _, product in Monetization.Products do
		if product.id == id then
			return product
		end
	end
	return nil
end

return Monetization
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">Rarity</string>
            <string name="Source"><![CDATA[--!strict
-- Rarity tiers. Colorblind palette pairs every rarity with a distinct glyph so color is never the only cue.

export type RarityId = "Common" | "Uncommon" | "Rare" | "Epic" | "Legendary"

export type RarityDef = {
	id: RarityId,
	order: number,
	name: string,
	color: Color3,
	colorblind: Color3,
	glyph: string,
	weight: number, -- relative spawn weight inside a size band
	toast: boolean, -- show a toast when absorbed
	announce: boolean, -- announce first discovery to the whole server
	sparkle: boolean,
}

local Rarity = {}

Rarity.Order = { "Common", "Uncommon", "Rare", "Epic", "Legendary" } :: { RarityId }

Rarity.Defs = {
	Common = {
		id = "Common",
		order = 1,
		name = "Common",
		color = Color3.fromRGB(176, 190, 204),
		colorblind = Color3.fromRGB(200, 200, 200),
		glyph = "●",
		weight = 100,
		toast = false,
		announce = false,
		sparkle = false,
	},
	Uncommon = {
		id = "Uncommon",
		order = 2,
		name = "Uncommon",
		color = Color3.fromRGB(96, 214, 120),
		colorblind = Color3.fromRGB(86, 180, 233),
		glyph = "▲",
		weight = 34,
		toast = false,
		announce = false,
		sparkle = false,
	},
	Rare = {
		id = "Rare",
		order = 3,
		name = "Rare",
		color = Color3.fromRGB(72, 160, 255),
		colorblind = Color3.fromRGB(0, 114, 178),
		glyph = "◆",
		weight = 9,
		toast = true,
		announce = false,
		sparkle = true,
	},
	Epic = {
		id = "Epic",
		order = 4,
		name = "Epic",
		color = Color3.fromRGB(190, 104, 255),
		colorblind = Color3.fromRGB(204, 121, 167),
		glyph = "★",
		weight = 2.2,
		toast = true,
		announce = false,
		sparkle = true,
	},
	Legendary = {
		id = "Legendary",
		order = 5,
		name = "Legendary",
		color = Color3.fromRGB(255, 196, 46),
		colorblind = Color3.fromRGB(240, 228, 66),
		glyph = "✦",
		weight = 0.45,
		toast = true,
		announce = true,
		sparkle = true,
	},
} :: { [RarityId]: RarityDef }

function Rarity.get(id: string): RarityDef
	local defs: { [string]: RarityDef } = Rarity.Defs :: any
	return defs[id] or defs.Common
end

function Rarity.color(id: string, colorblind: boolean?): Color3
	local def = Rarity.get(id)
	return if colorblind then def.colorblind else def.color
end

return Rarity
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">Sounds</string>
            <string name="Source"><![CDATA[--!strict
-- Every sound id in the game. Defaults point at sounds that ship inside the Roblox client
-- (rbxasset://), which every experience may use. Replace `id` with licensed Creator Store
-- audio (rbxassetid://...) to upgrade; an empty id is skipped silently so music slots are optional.

export type SoundDef = {
	id: string,
	volume: number,
	pitch: number?,
	pitchJitter: number?,
	looped: boolean?,
}

local Sounds: { [string]: SoundDef } = {
	-- Absorb pops: pitch is driven by prop size relative to the ball (small = high).
	-- Soft, organic pops (no electronic beeps). Swap for Creator Store "pop"/"plop" SFX ids to upgrade.
	Pop = { id = "rbxasset://sounds/snap.mp3", volume = 0.3, pitch = 0.95, pitchJitter = 0.07 },
	PopSoft = { id = "rbxasset://sounds/snap.mp3", volume = 0.2, pitch = 1.15, pitchJitter = 0.08 },
	PopBig = { id = "rbxasset://sounds/action_jump_land.mp3", volume = 0.65, pitch = 0.75, pitchJitter = 0.05 },
	PopBigLayer = { id = "rbxasset://sounds/snap.mp3", volume = 0.35, pitch = 0.6, pitchJitter = 0.04 },
	Bonk = { id = "rbxasset://sounds/action_jump_land.mp3", volume = 0.8, pitchJitter = 0.08 },
	Clang = { id = "rbxasset://sounds/impact_water.mp3", volume = 0.9, pitch = 0.6, pitchJitter = 0.05 },
	Hop = { id = "rbxasset://sounds/action_jump.mp3", volume = 0.6, pitchJitter = 0.05 },
	Land = { id = "rbxasset://sounds/action_jump_land.mp3", volume = 0.4, pitchJitter = 0.1 },
	Dash = { id = "rbxasset://sounds/swoosh.wav", volume = 0.7, pitchJitter = 0.05 },
	GrowthHum = { id = "rbxasset://sounds/action_falling.mp3", volume = 0.0, looped = true },
	RollLoop = { id = "rbxasset://sounds/action_footsteps_plastic.mp3", volume = 0.0, looped = true },

	-- Stingers
	NewDiscovery = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.3, pitch = 0.9 },
	Legendary = { id = "rbxasset://sounds/victory.wav", volume = 0.8 },
	PlayerRolled = { id = "rbxasset://sounds/snap.mp3", volume = 1, pitch = 0.7 },
	GotRolled = { id = "rbxasset://sounds/swoosh.wav", volume = 0.9, pitch = 0.6 },
	BurstOff = { id = "rbxasset://sounds/Rocket shot.wav", volume = 0.8 },
	EventStart = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.45, pitch = 0.55 },
	FinalRoll = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.5, pitch = 0.45 },
	Launch = { id = "rbxasset://sounds/Rocket whoosh 01.wav", volume = 1 },
	Podium = { id = "rbxasset://sounds/victory.wav", volume = 0.8 },
	Merge = { id = "rbxasset://sounds/snap.mp3", volume = 0.8, pitch = 1.3 },
	Split = { id = "rbxasset://sounds/swoosh.wav", volume = 0.7, pitch = 1.3 },
	Coin = { id = "rbxasset://sounds/snap.mp3", volume = 0.4, pitch = 1.45, pitchJitter = 0.05 },
	Meteor = { id = "rbxasset://sounds/Rocket whoosh 01.wav", volume = 0.5, pitch = 0.7, pitchJitter = 0.1 },

	-- UI
	Click = { id = "rbxasset://sounds/button.wav", volume = 0.5 },
	Hover = { id = "rbxasset://sounds/clickfast.wav", volume = 0.2, pitch = 1.4 },
	Open = { id = "rbxasset://sounds/swoosh.wav", volume = 0.35, pitch = 1.5 },
	Close = { id = "rbxasset://sounds/swoosh.wav", volume = 0.3, pitch = 1.2 },
	Purchase = { id = "rbxasset://sounds/victory.wav", volume = 0.6 },
	Error = { id = "rbxasset://sounds/clickfast.wav", volume = 0.5, pitch = 0.5 },
	Toast = { id = "rbxasset://sounds/clickfast.wav", volume = 0.25, pitch = 0.8 },
	Tick = { id = "rbxasset://sounds/clickfast.wav", volume = 0.4, pitch = 0.9 },

	-- Music slots: fill with licensed tracks from the Creator Store (Roblox-owned music is free to use).
	MusicHub = { id = "", volume = 0.35, looped = true },
	MusicKitchen = { id = "", volume = 0.35, looped = true },
	MusicBackyard = { id = "", volume = 0.35, looped = true },
	MusicCandy = { id = "", volume = 0.35, looped = true },
	MusicToyRoom = { id = "", volume = 0.35, looped = true },
	MusicBeach = { id = "", volume = 0.35, looped = true },
	MusicFinalRoll = { id = "", volume = 0.45, looped = true },
	MusicEventLayer = { id = "", volume = 0.3, looped = true },
	MusicResults = { id = "", volume = 0.4, looped = true },
}

return Sounds
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Theme</string>
            <string name="Source"><![CDATA[--!strict
-- UI design language: chunky rounded shapes, bold display font, bright high-contrast palette.

local Theme = {}

Theme.Font = {
	Display = Font.new("rbxasset://fonts/families/LuckiestGuy.json", Enum.FontWeight.Regular),
	Bold = Font.new("rbxasset://fonts/families/FredokaOne.json", Enum.FontWeight.Regular),
	Body = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold),
}

Theme.Color = {
	Ink = Color3.fromRGB(38, 26, 74), -- deep violet used for outlines and text strokes
	InkSoft = Color3.fromRGB(70, 56, 120),
	Paper = Color3.fromRGB(255, 250, 240),
	PaperDim = Color3.fromRGB(238, 230, 255),
	Panel = Color3.fromRGB(255, 255, 255),
	PanelAlt = Color3.fromRGB(245, 239, 255),
	Shadow = Color3.fromRGB(24, 14, 52),
	Primary = Color3.fromRGB(255, 122, 69), -- tangerine
	PrimaryDark = Color3.fromRGB(214, 78, 40),
	Secondary = Color3.fromRGB(77, 196, 255), -- sky
	SecondaryDark = Color3.fromRGB(32, 140, 214),
	Accent = Color3.fromRGB(255, 214, 64), -- sunshine
	AccentDark = Color3.fromRGB(222, 166, 22),
	Good = Color3.fromRGB(88, 214, 116),
	GoodDark = Color3.fromRGB(46, 160, 78),
	Bad = Color3.fromRGB(255, 92, 120),
	BadDark = Color3.fromRGB(204, 48, 84),
	Magic = Color3.fromRGB(176, 108, 255),
	MagicDark = Color3.fromRGB(120, 60, 210),
	Stardust = Color3.fromRGB(255, 220, 110),
	White = Color3.new(1, 1, 1),
	Black = Color3.new(0, 0, 0),
	Overlay = Color3.fromRGB(20, 10, 44),
	Space = Color3.fromRGB(26, 18, 64),
}

Theme.Radius = {
	Small = UDim.new(0, 10),
	Medium = UDim.new(0, 18),
	Large = UDim.new(0, 28),
	Pill = UDim.new(1, 0),
}

Theme.Stroke = {
	Thin = 2,
	Medium = 3,
	Thick = 4,
}

Theme.Tween = {
	Pop = TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
	Quick = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
	Smooth = TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
	Slow = TweenInfo.new(0.6, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
	Bounce = TweenInfo.new(0.5, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out),
}

-- Kit accent colors for portals, banners and the results screen.
Theme.KitColors = {
	KitchenCounter = Color3.fromRGB(255, 176, 92),
	BackyardBBQ = Color3.fromRGB(120, 206, 96),
	CandyShop = Color3.fromRGB(255, 120, 196),
}

return Theme
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">Tiers</string>
            <string name="Source"><![CDATA[--!strict
-- Scale tiers. Each tier is its own server pool (its own place in the universe).
-- Adding a tier = add an entry, publish a place with the tier's PlaceId, add kits with that tier.

export type TierDef = {
	id: number,
	key: string,
	name: string,
	cmPerStud: number, -- display scale: how many real centimetres one stud represents
	galaxyMassRequired: number,
	placeId: number, -- 0 = this place / not yet published
	color: Color3,
	icon: string,
	shipped: boolean,
}

local Tiers = {}

Tiers.List = {
	{
		id = 1,
		key = "Crumb",
		name = "Crumb",
		cmPerStud = 1,
		galaxyMassRequired = 0,
		placeId = 0,
		color = Color3.fromRGB(255, 186, 92),
		icon = "🍪",
		shipped = true,
	},
	{
		id = 2,
		key = "Backyard",
		name = "Backyard",
		cmPerStud = 6,
		galaxyMassRequired = 2500,
		placeId = 0,
		color = Color3.fromRGB(120, 210, 110),
		icon = "🌻",
		shipped = false,
	},
	{
		id = 3,
		key = "Block",
		name = "Block",
		cmPerStud = 40,
		galaxyMassRequired = 12000,
		placeId = 0,
		color = Color3.fromRGB(110, 170, 255),
		icon = "🏘️",
		shipped = false,
	},
	{
		id = 4,
		key = "City",
		name = "City",
		cmPerStud = 250,
		galaxyMassRequired = 50000,
		placeId = 0,
		color = Color3.fromRGB(180, 130, 255),
		icon = "🏙️",
		shipped = false,
	},
	{
		id = 5,
		key = "Island",
		name = "Island",
		cmPerStud = 1500,
		galaxyMassRequired = 200000,
		placeId = 0,
		color = Color3.fromRGB(70, 210, 210),
		icon = "🏝️",
		shipped = false,
	},
	{
		id = 6,
		key = "Cosmos",
		name = "Cosmos",
		cmPerStud = 50000,
		galaxyMassRequired = 1000000,
		placeId = 0,
		color = Color3.fromRGB(255, 110, 180),
		icon = "🌌",
		shipped = false,
	},
} :: { TierDef }

function Tiers.get(id: number): TierDef
	return Tiers.List[id] or Tiers.List[1]
end

-- Which tier does this place serve? Tier places are mapped by PlaceId; anything else is tier 1.
function Tiers.forPlace(placeId: number): TierDef
	for _, tier in Tiers.List do
		if tier.placeId ~= 0 and tier.placeId == placeId then
			return tier
		end
	end
	return Tiers.List[1]
end

function Tiers.highestUnlocked(galaxyMass: number): number
	local best = 1
	for _, tier in Tiers.List do
		if galaxyMass >= tier.galaxyMassRequired then
			best = math.max(best, tier.id)
		end
	end
	return best
end

return Tiers
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Tuning</string>
            <string name="Source"><![CDATA[--!strict
-- Every gameplay tuning number lives here. Live config may override any leaf via LiveConfig.tuning.
-- Units: studs, seconds, studs/second. "D" = ball diameter in studs.

local Tuning = {
	Ball = {
		StartDiameter = 3,
		MaxDiameter = 1600,
		-- Max ground speed = SpeedBase * (D / StartDiameter) ^ SpeedExponent
		SpeedBase = 23,
		SpeedExponent = 0.45,
		-- Seconds to reach top speed from rest; interpolated on log(D) between small and huge.
		AccelTimeSmall = 0.32,
		AccelTimeHuge = 0.72,
		HugeDiameter = 250,
		-- Extra force multiplier when steering against current velocity (snappy turn-in).
		TurnAssist = 2.3,
		-- Seconds to coast to a stop with no input.
		BrakeTimeSmall = 1.1,
		BrakeTimeHuge = 2.4,
		BrakeStrength = 2.2, -- multiplier on the coasting brake (higher = stops sooner)
		AirControl = 0.35,
		Density = 0.7,
		Friction = 0.9,
		Elasticity = 0.15,
		-- Hop height in studs = max(HopMin, D * HopPerDiameter)
		HopMin = 5,
		HopPerDiameter = 0.55,
		HopCooldown = 0.35,
		-- Dash adds DashBoost * maxSpeed instantly and lifts the speed cap for DashDuration.
		DashBoost = 0.85,
		DashDuration = 0.5,
		DashCooldown = 2.6,
		-- Mobile auto-steer assist: max bend (degrees) toward absorbable clusters ahead.
		AutoSteerMaxAngle = 22,
		AutoSteerRange = 6, -- multiples of D
		-- Rider avatar height as a fraction of ball diameter, clamped.
		RiderHeightFraction = 0.55,
		RiderScaleMin = 0.35,
		RiderScaleMax = 40,
		RiderScaleStep = 0.08, -- only rescale the avatar when it changes by this fraction
		VoidY = -400,
	},

	Absorb = {
		-- A prop sticks when its absorbSize <= Ratio * D.
		Ratio = 0.62,
		-- Contact tolerance as a fraction of prop radius (props are fuzzy spheres for contact).
		ContactSlack = 0.25,
		-- Extra server-side reach (studs) per stud/sec of ball speed to absorb latency.
		LatencyReachPerSpeed = 0.12,
		LatencyReachMax = 18,
		ClaimRatePerSecond = 45,
		ClaimBurst = 90,
		-- Final Roll: the landmark becomes absorbable once absorbSize <= LandmarkReach * D
		-- (deliberately bigger than the ball, so the round's best roller gets the big moment).
		LandmarkReach = 1.6,
		-- Bonks: props up to BonkKnockRatio * D (too big to absorb) can knock items loose at speed.
		BonkMinSpeed = 0.75, -- fraction of max speed
		BonkKnockCount = 2,
		BonkCooldown = 0.8,
		-- Magnet core / merge magnet reach in multiples of D.
		MagnetReach = 1.1,
		-- Vacuum: props much smaller than you are grabbed from a little further away so rolling
		-- through crumbs feels like hoovering. Extra reach = D * VacuumReach * (1 - size/(threshold*VacuumBelow)).
		VacuumReach = 0.22,
		VacuumBelow = 0.5,
		-- Max visible stuck-prop instances per ball (client LOD may lower further).
		VisibleStuckLocal = 44,
		VisibleStuckRemote = 22,
		-- Volume history kept per ball for loot knock-off and planet composition.
		RecentHistory = 60,
	},

	Growth = {
		-- volumeGained = propSolidVolume * Gain * earlyBoost(D) * modifiers
		-- Tuned with tools/sim/growth.spec.luau (see docs/TUNING.md): a solo greedy roller grabs ~5
		-- things/second in the first minute and grows 3 -> ~15 (1 min) -> ~65 (4 min) -> ~150 (end).
		Gain = 0.7,
		EarlyBoost = 2.8,
		EarlyScale = 10, -- D at which early boost has decayed to ~37%
		FinalRollMultiplier = 1.5,
		-- Absorbing another player adds this share of their ball volume.
		PlayerVolumeShare = 0.8,
		-- Absorbing a critter adds this bonus on top of its prop volume.
		CritterBonus = 1.5,
	},

	Pvp = {
		-- A ball absorbs another ball when D_big >= AbsorbRatio * D_small.
		AbsorbRatio = 1.32,
		-- Bumps happen between balls closer in size than AbsorbRatio, approaching faster than this.
		BumpMinRelativeSpeed = 28,
		BumpScatterPerSpeed = 0.04, -- props knocked loose per stud/sec of closing speed
		BumpScatterMax = 8,
		BumpPairCooldown = 1.2,
		BumpImpulse = 0.9, -- multiples of closing speed, applied as a velocity change
		SpawnShield = 6,
		RiderBurstDelay = 3.5,
		RiderAutoBurst = 18, -- riders are auto-burst after this long so nobody is stuck forever
		RiderRespawnFraction = 0.7,
		BurstLaunchSpeed = 90,
		BurstKnockFraction = 0.25, -- fraction of the host ball's recent props knocked loose
		BurstKnockMax = 14,
		BurstHostVolumeLoss = 0.1, -- host loses this fraction of volume (the knocked props)
		ComebackMultiplier = 1.6,
		ComebackDuration = 25,
		-- Drop-in catch-up: start at this fraction of the median ball diameter (never below start).
		CatchUpFraction = 0.45,
		CatchUpBoostDuration = 30,
		CatchUpBoostMultiplier = 1.35,
	},

	Merge = {
		RequestTimeout = 12,
		TouchRange = 1.4, -- multiples of combined radii for the "both pressing Merge while touching" path
		InputBlend = 0.5, -- host weight; partner gets 1 - InputBlend
		MagnetCooldown = 6,
		MagnetDuration = 2.5,
		SpeedPenalty = 0.88, -- merged balls are a little slower so merging isn't dominant
		GrowthPenalty = 0.9,
		MinMergedTime = 3,
		SplitLaunchSpeed = 60,
	},

	Round = {
		Length = 450,
		EventTimes = { 120, 270 }, -- seconds after round start when the round's big world events fire
		FinalRoll = 60,
		Launch = 15, -- rocket ride to your galaxy + a few seconds to admire your new planet
		Results = 12,
		Intermission = 15,
		MinPlayersForPvpAwards = 2,
	},

	Bots = {
		-- Bots fill each round up to this many balls total; one leaves for every player who joins.
		TargetBalls = 8,
		MaxBots = 7,
		ManageInterval = 3,
	},

	World = {
		CritterTickRate = 10,
		CritterFleeRange = 4, -- multiples of ball D
		ReplenishInterval = 3,
		ReplenishMaxPerTick = 6,
		ReplenishRadius = 60,
		LootSettleTime = 0.7,
		LootLifetime = 120,
		MaxLoot = 220,
	},

	Rewards = {
		StardustPerMeterGrown = 60, -- per display metre of final diameter (tier-scaled)
		StardustPerDiscovery = 15,
		StardustPerNewVariant = 30,
		StardustPerPlayerRolled = 20,
		StardustPerAward = 40,
		StardustParticipation = 25,
		RarityBonus = { Common = 0, Uncommon = 1, Rare = 3, Epic = 8, Legendary = 25 },
		FriendBonusPerFriend = 0.1,
		FriendBonusMax = 0.3,
		VipBonus = 0.1,
		DoubleStardustPassMultiplier = 2,
		AdRoundMultiplier = 2,
		AdCooldownRounds = 3,
		RoundStardustCap = 6000,
	},

	Galaxy = {
		KeepBest = 12,
		KeepRecent = 8,
		MaxPinned = 4,
		SignatureProps = 6,
		PlanetColors = 5,
		NameMaxLength = 24,
		LikeCooldownHours = 20,
	},

	Data = {
		AutosaveInterval = 120,
		SessionLockTimeout = 1800, -- seconds before a stale session lock may be stolen
		LoadRetries = 6,
		SaveRetries = 5,
		ReceiptHistory = 60,
	},

	Graphics = {
		-- Build props as smooth EditableMesh meshes (falls back to primitive parts automatically
		-- if the device/experience can't create editable meshes).
		UseEditableMesh = true,
		-- Baked contact shadows / sky light as vertex colors on generated meshes.
		VertexShading = true,
		-- Safety valve: flip triangle winding if generated meshes render inside-out on a platform.
		FlipWinding = false,
		-- Max templates built per frame while preparing a kit in the background.
		TemplatesPerFrame = 2,
		-- Render distance (studs) = clamp(absorbSize * PropRenderScale, Min, Max) per prop,
		-- multiplied by the device quality factor; huge props and landmarks always render.
		PropRenderScale = 70,
		PropRenderMin = 90,
		PropRenderMax = 1600,
	},

	Camera = {
		BaseDistance = 9,
		DistancePerDiameter = 2.6,
		BaseHeight = 4,
		HeightPerDiameter = 1.1,
		FovBase = 70,
		FovSpeedBonus = 12,
		FollowSharpness = 7,
		YawSharpness = 3.2,
		AutoRecenterDelay = 1.6,
		KeyOrbitSpeed = 2.4, -- radians/second
		DragSensitivity = 0.006,
		ShakeMax = 1.2,
		ZoomMin = 0.6,
		ZoomMax = 1.8,
	},
}

return Tuning
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="14">
        <Properties>
          <string name="Name">Data</string>
        </Properties>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">Achievements</string>
            <string name="Source"><![CDATA[--!strict
-- Long-term milestones. Each is a profile stat crossing a threshold; rewards are granted once.
-- `stat` reads from profile.stats unless it names one of the special keys handled in
-- Progression.statValue (nanaDays, streakBest, planets, level).

export type AchievementDef = {
	id: string,
	name: string,
	icon: string,
	description: string,
	stat: string,
	goal: number,
	stardust: number,
	title: string?,
	shell: string?,
}

local Achievements = {}

Achievements.List = {
	{ id = "FirstRound", name = "First Roll", icon = "🎉", description = "Finish your first round", stat = "rounds", goal = 1, stardust = 100 },
	{ id = "Rounds25", name = "Regular", icon = "🔁", description = "Play 25 rounds", stat = "rounds", goal = 25, stardust = 400 },
	{ id = "Rounds100", name = "Roll Addict", icon = "♾️", description = "Play 100 rounds", stat = "rounds", goal = 100, stardust = 1500 },
	{ id = "FirstWin", name = "Winner!", icon = "🥇", description = "Win a round", stat = "wins", goal = 1, stardust = 300, title = "Winner" },
	{ id = "Wins25", name = "Champion", icon = "🏆", description = "Win 25 rounds", stat = "wins", goal = 25, stardust = 2500, title = "Champ", shell = "Champion" },
	{ id = "Podium10", name = "Podium Regular", icon = "🏅", description = "Finish top 3 ten times", stat = "top3", goal = 10, stardust = 600 },
	{ id = "Absorb1k", name = "Hungry", icon = "🧺", description = "Roll up 1,000 things", stat = "absorbed", goal = 1000, stardust = 300 },
	{ id = "Absorb10k", name = "Bottomless", icon = "🕳️", description = "Roll up 10,000 things", stat = "absorbed", goal = 10000, stardust = 1500 },
	{ id = "Absorb50k", name = "World Eater", icon = "🌍", description = "Roll up 50,000 things", stat = "absorbed", goal = 50000, stardust = 5000 },
	{ id = "Rolled10", name = "Bowling Ball", icon = "🎳", description = "Roll up 10 other balls", stat = "playersRolled", goal = 10, stardust = 400 },
	{ id = "Rolled50", name = "Ball Bully", icon = "😈", description = "Roll up 50 other balls", stat = "playersRolled", goal = 50, stardust = 1500, title = "Bully" },
	{ id = "GotRolled25", name = "Comeback Kid", icon = "🔥", description = "Get rolled up 25 times (and keep going!)", stat = "timesRolled", goal = 25, stardust = 500, title = "Comeback" },
	{ id = "Size1m", name = "Meter Club", icon = "📏", description = "Grow to 1 m", stat = "biggest", goal = 100, stardust = 300 },
	{ id = "Size2m", name = "Gentle Giant", icon = "🦕", description = "Grow to 2 m", stat = "biggest", goal = 200, stardust = 1200, title = "Giant" },
	{ id = "Discover50", name = "Explorer", icon = "🔍", description = "Discover 50 props", stat = "discoveries", goal = 50, stardust = 400 },
	{ id = "Discover100", name = "Collector", icon = "📖", description = "Discover 100 props", stat = "discoveries", goal = 100, stardust = 1000, title = "Collector" },
	{ id = "Discover250", name = "Completionist", icon = "🗂️", description = "Discover 250 props", stat = "discoveries", goal = 250, stardust = 3000, title = "Completionist" },
	{ id = "Nana10", name = "Nana's Favorite", icon = "🧶", description = "Finish all of Nana's requests on 10 days", stat = "nanaDays", goal = 10, stardust = 1500, title = "NanasFave" },
	{ id = "Streak14", name = "Loyal Roller", icon = "📅", description = "Reach a 14-day login streak", stat = "streakBest", goal = 14, stardust = 1500, title = "Loyal" },
	{ id = "Planets50", name = "Astronomer", icon = "🔭", description = "Make 50 planets", stat = "planets", goal = 50, stardust = 1500, title = "Astronomer" },
} :: { AchievementDef }

Achievements.ById = {} :: { [string]: AchievementDef }
for _, a in Achievements.List do
	Achievements.ById[a.id] = a
end

return Achievements
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">Cores</string>
            <string name="Source"><![CDATA[--!strict
-- Cores: ball types with sidegrade perks. All gameplay Cores are unlockable with Stardust.
-- cost[1] unlocks the Core (level 1); cost[n] upgrades from level n-1 to n.

export type CoreDef = {
	id: string,
	name: string,
	icon: string,
	color: string,
	description: string,
	perk: (level: number) -> string,
	cost: { number },
	maxLevel: number,
	densityMult: number?,
	elasticityMult: number?,
	speedMult: ((level: number) -> number)?,
	hopMult: ((level: number) -> number)?,
	dashCooldownMult: ((level: number) -> number)?,
	magnetReach: ((level: number) -> number)?, -- extra reach in multiples of D for tiny props
	bumpResist: ((level: number) -> number)?, -- fraction of knocked props kept
	bumpPower: ((level: number) -> number)?, -- scatter multiplier dealt to others
}

local Cores = {}

Cores.List = {
	{
		id = "Classic",
		name = "Classic",
		icon = "⚪",
		color = "#f4f1ec",
		description = "Nana's trusty first ball. A little quicker on its feet.",
		perk = function(level)
			return string.format("+%d%% top speed", 2 + level)
		end,
		cost = { 0, 300, 700, 1400, 2600 },
		maxLevel = 5,
		speedMult = function(level)
			return 1.02 + level * 0.01
		end,
	},
	{
		id = "Magnet",
		name = "Magnet",
		icon = "🧲",
		color = "#e63946",
		description = "Tiny things leap onto you from a little further away.",
		perk = function(level)
			return string.format("Grabs crumbs from %d%% further", 6 + level * 4)
		end,
		cost = { 600, 500, 900, 1600, 3000 },
		maxLevel = 5,
		magnetReach = function(level)
			return 0.06 + level * 0.04
		end,
	},
	{
		id = "Bouncy",
		name = "Bouncy",
		icon = "🏀",
		color = "#ff9f1c",
		description = "Springier hops: reach counters and shelves sooner.",
		perk = function(level)
			return string.format("+%d%% hop height", 20 + level * 8)
		end,
		cost = { 600, 500, 900, 1600, 3000 },
		maxLevel = 5,
		elasticityMult = 2.2,
		hopMult = function(level)
			return 1.2 + level * 0.08
		end,
	},
	{
		id = "Heavy",
		name = "Heavy",
		icon = "🪨",
		color = "#6c757d",
		description = "Shrugs off bumps and knocks more loot off others.",
		perk = function(level)
			return string.format("Keeps %d%% more in bumps, hits %d%% harder", 20 + level * 6, 10 + level * 6)
		end,
		cost = { 800, 600, 1000, 1800, 3200 },
		maxLevel = 5,
		densityMult = 1.7,
		bumpResist = function(level)
			return 0.2 + level * 0.06
		end,
		bumpPower = function(level)
			return 1.1 + level * 0.06
		end,
	},
	{
		id = "Swift",
		name = "Swift",
		icon = "⚡",
		color = "#4cc9f0",
		description = "Dash recharges faster. Zip zip zip.",
		perk = function(level)
			return string.format("Dash recharges %d%% faster", 15 + level * 6)
		end,
		cost = { 800, 600, 1000, 1800, 3200 },
		maxLevel = 5,
		dashCooldownMult = function(level)
			return 0.85 - level * 0.06
		end,
	},
} :: { CoreDef }

Cores.ById = {} :: { [string]: CoreDef }
for _, def in Cores.List do
	Cores.ById[def.id] = def
end

function Cores.get(id: string?): CoreDef?
	if not id then
		return nil
	end
	return Cores.ById[id]
end

-- Stardust cost to go from `level` to `level + 1` (level 0 = locked).
function Cores.costFor(id: string, level: number): number?
	local def = Cores.ById[id]
	if not def or level >= def.maxLevel then
		return nil
	end
	return def.cost[level + 1]
end

return Cores
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">Cosmetics</string>
            <string name="Source"><![CDATA[--!strict
-- Ball shells: the look of your ball. Bought with Stardust in the shop, or earned (login streak,
-- Nana's requests). "Classic" uses the player's personal color. `source` says how it is unlocked.

export type ShellDef = {
	id: string,
	name: string,
	icon: string,
	color: string?, -- nil = the player's personal color
	color2: string?, -- lump accent
	material: string, -- Enum.Material name
	reflectance: number?,
	neon: boolean?, -- glowing flecks on the lumps
	rainbow: boolean?, -- hue cycles over time
	cost: number?, -- Stardust price when sold in the shop
	source: "Default" | "Shop" | "Streak" | "Nana" | "Level" | "Achievement",
	order: number,
	description: string,
}

local Cosmetics = {}

Cosmetics.Shells = {
	{ id = "Classic", name = "Classic", icon = "⚪", material = "SmoothPlastic", source = "Default", order = 1, description = "Your very own color." },
	{ id = "Bubblegum", name = "Bubblegum", icon = "🍬", color = "#ff8fc7", color2 = "#ffd1e8", material = "SmoothPlastic", cost = 400, source = "Shop", order = 2, description = "Sweet and squishy." },
	{ id = "Mint", name = "Mint Chip", icon = "🍃", color = "#8ff0c4", color2 = "#4a3b2a", material = "SmoothPlastic", cost = 400, source = "Shop", order = 3, description = "Cool, fresh, a little crunchy." },
	{ id = "Sunset", name = "Sunset", icon = "🌅", color = "#ff9a52", color2 = "#ff5c8a", material = "SmoothPlastic", cost = 900, source = "Shop", order = 4, description = "Warm golden-hour glow." },
	{ id = "Ocean", name = "Ocean Glass", icon = "🌊", color = "#3fb6e8", color2 = "#bff1ff", material = "Glass", reflectance = 0.15, cost = 1500, source = "Shop", order = 5, description = "Clear blue sea glass." },
	{ id = "Frosty", name = "Frosty", icon = "❄️", color = "#d6f3ff", color2 = "#9fd8ff", material = "Ice", cost = 2200, source = "Shop", order = 6, description = "Snowball, but cuter." },
	{ id = "Lava", name = "Lava", icon = "🌋", color = "#3a1f1f", color2 = "#ff6a2a", material = "Basalt", neon = true, cost = 3500, source = "Shop", order = 7, description = "Hot hot hot." },
	{ id = "Disco", name = "Disco", icon = "🪩", color = "#cfd4e0", color2 = "#ffffff", material = "Foil", reflectance = 0.45, cost = 5000, source = "Shop", order = 8, description = "Party ball. Literally." },
	{ id = "Starlight", name = "Starlight", icon = "✨", color = "#2b2160", color2 = "#fff3b0", material = "SmoothPlastic", neon = true, source = "Streak", order = 9, description = "Login streak reward: day 7." },
	{ id = "Golden", name = "Golden", icon = "🏆", color = "#ffc83a", color2 = "#fff1b0", material = "Foil", reflectance = 0.3, source = "Streak", order = 10, description = "Login streak reward: day 14." },
	{ id = "Rainbow", name = "Rainbow", icon = "🌈", color = "#ff5c8a", material = "SmoothPlastic", rainbow = true, source = "Streak", order = 11, description = "Login streak reward: day 30." },
	{ id = "Knitted", name = "Nana's Knit", icon = "🧶", color = "#c8b6ff", color2 = "#ffafcc", material = "Fabric", source = "Nana", order = 12, description = "Finish all three of Nana's requests on 5 days." },
	{ id = "Cookie", name = "Cookie Dough", icon = "🍪", color = "#d9a066", color2 = "#5b3a1e", material = "Sand", source = "Level", order = 13, description = "Reach level 5." },
	{ id = "Comet", name = "Comet", icon = "☄️", color = "#1d1b3a", color2 = "#7ee8ff", material = "SmoothPlastic", neon = true, source = "Level", order = 14, description = "Reach level 10." },
	{ id = "Jelly", name = "Jelly", icon = "🍮", color = "#ff6fb5", color2 = "#ffd1ea", material = "Glass", reflectance = 0.1, source = "Level", order = 15, description = "Reach level 15." },
	{ id = "Aurora", name = "Aurora", icon = "🌌", color = "#3bd6c6", color2 = "#b06cff", material = "SmoothPlastic", neon = true, source = "Level", order = 16, description = "Reach level 20." },
	{ id = "Diamond", name = "Diamond", icon = "💎", color = "#cfefff", color2 = "#ffffff", material = "Glass", reflectance = 0.35, source = "Level", order = 17, description = "Reach level 30." },
	{ id = "Nebula", name = "Nebula", icon = "🪐", color = "#3a1d6e", color2 = "#ff8fc7", material = "SmoothPlastic", neon = true, source = "Level", order = 18, description = "Reach level 40." },
	{ id = "Sun", name = "Little Sun", icon = "☀️", color = "#ffb21e", color2 = "#fff3b0", material = "Neon", source = "Level", order = 19, description = "Reach level 50." },
	{ id = "Champion", name = "Champion", icon = "🏆", color = "#ffd640", color2 = "#ff7a45", material = "Foil", reflectance = 0.2, source = "Achievement", order = 20, description = "Win 25 rounds." },
} :: { ShellDef }

Cosmetics.ById = {} :: { [string]: ShellDef }
for _, s in Cosmetics.Shells do
	assert(Cosmetics.ById[s.id] == nil, "duplicate shell " .. s.id)
	Cosmetics.ById[s.id] = s
end

function Cosmetics.shell(id: string?): ShellDef
	return (id and Cosmetics.ById[id]) or Cosmetics.ById.Classic
end

return Cosmetics
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Events</string>
            <string name="Source"><![CDATA[--!strict
-- World events are recipes of modifiers. EventService applies them server-side (gameplay +
-- lighting); EventController on clients adds weather, banners and music layers.
-- Adding an event = add an entry here (and, for a brand-new modifier type, a few lines of code).

export type EventDef = {
	id: string,
	name: string,
	icon: string,
	color: string, -- banner / tint color
	description: string, -- one short line under the banner
	duration: number,
	weight: number, -- chance weight when picked at random
	major: boolean, -- major events take the round's mid-round slot; minor ones sprinkle chaos
	purchasable: boolean,
	ratioBonus: number?, -- added to the absorb ratio (bigger things stick)
	growthMult: number?,
	speedMult: number?,
	gravityMult: number?,
	stardustMult: number?,
	mutation: string?, -- turns nearby props into this mutation over time
	mutationShare: number?,
	meteors: number?, -- meteors per second (Starfall props falling from the sky)
	stampede: number?, -- critters in the herd
	giant: boolean?, -- one random ball gets a huge growth boost
	supplyDrop: number?, -- props dropped in one big pile somewhere on the map
	frenzy: boolean?,
	goldenRunner: boolean?, -- a golden critter bolts around; catch it for a big reward
	weather: string?, -- client weather preset
	lighting: { [string]: any }?,
}

local Events = {}

Events.List = {
	{
		id = "MeteorShower",
		name = "Meteor Shower",
		icon = "☄️",
		color = "#9c7bff",
		description = "Starfall meteors are raining down! Grab them!",
		duration = 40,
		weight = 3,
		major = true,
		purchasable = true,
		meteors = 1.6,
		weather = "Meteors",
		lighting = { tint = "#d9ccff", brightness = -0.15, saturation = 0.25, clock = 18.6 },
	},
	{
		id = "StickyRain",
		name = "Sticky Rain",
		icon = "🌧️",
		color = "#4cc9f0",
		description = "Everything is sticky! Bigger things roll up!",
		duration = 35,
		weight = 3,
		major = true,
		purchasable = false,
		ratioBonus = 0.14,
		growthMult = 1.1,
		weather = "Rain",
		lighting = { tint = "#cfe8ff", brightness = -0.1, saturation = -0.15, fog = "#b8cde0" },
	},
	{
		id = "GoldenHour",
		name = "Golden Hour",
		icon = "🌅",
		color = "#ffc83a",
		description = "Props are turning GOLDEN! Extra Stardust!",
		duration = 40,
		weight = 3,
		major = true,
		purchasable = true,
		mutation = "Golden",
		mutationShare = 0.1,
		stardustMult = 1.5,
		weather = "Glitter",
		lighting = { tint = "#ffd59a", brightness = 0.05, saturation = 0.3, clock = 17.4 },
	},
	{
		id = "Stampede",
		name = "Stampede",
		icon = "🦆",
		color = "#ff9f1c",
		description = "A herd of rare critters is running across the map!",
		duration = 30,
		weight = 2,
		major = true,
		purchasable = true,
		stampede = 16,
		weather = "Dust",
	},
	{
		id = "LowGravity",
		name = "Low Gravity",
		icon = "🌙",
		color = "#b388ff",
		description = "Floaty bouncy chaos! Hop everywhere!",
		duration = 30,
		weight = 2,
		major = true,
		purchasable = true,
		gravityMult = 0.35,
		weather = "Floaty",
		lighting = { tint = "#e6dcff", saturation = 0.15, clock = 21 },
	},
	{
		id = "GiantMoment",
		name = "Giant Moment",
		icon = "🦖",
		color = "#ff5c8a",
		description = "Someone is growing SUPER fast. RUN!",
		duration = 18,
		weight = 2,
		major = true,
		purchasable = false,
		giant = true,
	},
	{
		id = "SupplyDrop",
		name = "Supply Drop",
		icon = "📦",
		color = "#7bd88f",
		description = "A pile of goodies just landed! Race for it!",
		duration = 20,
		weight = 4,
		major = false,
		purchasable = false,
		supplyDrop = 26,
	},
	{
		id = "Frenzy",
		name = "Growth Frenzy",
		icon = "⚡",
		color = "#ffd23f",
		description = "Everyone grows 50% faster!",
		duration = 15,
		weight = 3,
		major = false,
		purchasable = false,
		growthMult = 1.5,
		speedMult = 1.1,
		frenzy = true,
		weather = "Sparks",
	},
	{
		id = "MiniMeteors",
		name = "Shooting Stars",
		icon = "🌠",
		color = "#c8b6ff",
		description = "A few shooting stars are falling!",
		duration = 12,
		weight = 3,
		major = false,
		purchasable = false,
		meteors = 0.8,
		weather = "Meteors",
	},
	{
		id = "GoldenRunner",
		name = "Golden Runner",
		icon = "🏃",
		color = "#ffd23f",
		description = "A GOLDEN critter is on the loose! Catch it!",
		duration = 35,
		weight = 3,
		major = false,
		purchasable = false,
		goldenRunner = true,
		weather = "Glitter",
	},
} :: { EventDef }

Events.ById = {} :: { [string]: EventDef }
for _, e in Events.List do
	Events.ById[e.id] = e
end

function Events.get(id: string): EventDef?
	return Events.ById[id]
end

return Events
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">Kits</string>
            <string name="Source"><![CDATA[--!strict
-- World Kit registry. Adding a kit = add a data module here + a prop library. No code changes.

local Kits = {}

Kits.List = {
	require(script.KitchenCounter),
	require(script.BackyardBBQ),
	require(script.CandyShop),
} :: { any }

Kits.ById = {} :: { [string]: any }
for _, kit in Kits.List do
	assert(Kits.ById[kit.id] == nil, "duplicate kit id " .. kit.id)
	Kits.ById[kit.id] = kit
end

function Kits.get(id: string): any
	return Kits.ById[id]
end

function Kits.forTier(tier: number): { any }
	local out = {}
	for _, kit in Kits.List do
		if kit.tier == tier then
			table.insert(out, kit)
		end
	end
	return out
end

return Kits
]]></string>
          </Properties>
          <Item class="ModuleScript" referent="20">
            <Properties>
              <string name="Name">BackyardBBQ</string>
              <string name="Source"><![CDATA[--!nonstrict
