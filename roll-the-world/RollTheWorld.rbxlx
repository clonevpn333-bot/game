          <Item class="ModuleScript" referent="21">
            <Properties>
              <string name="Name">CandyShop</string>
              <string name="Source"><![CDATA[--!nonstrict
-- World Kit: Candy Shop. Candy-pink light, checkerboard floor, counters and soda fountain.
-- Themed corners: pick-and-mix and sweetheart spills by the till, a gummy pile, a chocolate counter,
-- a bakery corner, the soda & ice cream parlour, a popcorn stand, a toy corner, the shop front and
-- a lollipop garden out by the walls.

