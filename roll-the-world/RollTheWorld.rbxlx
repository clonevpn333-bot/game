-- Behaviours ------------------------------------------------------------------------------------

function HudController:showBanner(text: string, color: Color3?, duration: number?)
	banner.Text = text
	banner.TextColor3 = color or Theme.Color.White
	banner.TextTransparency = 0
	local stroke = banner:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Transparency = 0
	end
	local s = banner:FindFirstChildOfClass("UIScale") or Ui.new("UIScale", { Parent = banner })
	s.Scale = 0.4
	Ui.tween(s, Theme.Tween.Bounce, { Scale = 1 })
	task.delay(duration or 2.2, function()
		if banner.Text == text then
			Ui.tween(banner, Theme.Tween.Smooth, { TextTransparency = 1 })
			if stroke then
				Ui.tween(stroke, Theme.Tween.Smooth, { Transparency = 1 })
			end
		end
	end)
end

local function floater(text: string, color: Color3, big: boolean?)
	local label = Ui.display(text, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5 + (math.random() - 0.5) * 0.4, 0, 0.8, 0),
		Size = UDim2.fromOffset(if big then 260 else 160, if big then 54 else 34),
		TextColor3 = color,
		Parent = floaters,
	})
	local s = Ui.new("UIScale", { Scale = 0.5, Parent = label })
	Ui.tween(s, Theme.Tween.Pop, { Scale = 1 })
	Ui.tween(label, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Position = label.Position - UDim2.fromScale(0, 0.55),
	})
	task.delay(0.5, function()
		Ui.tween(label, Theme.Tween.Smooth, { TextTransparency = 1 })
		local stroke = label:FindFirstChildOfClass("UIStroke")
		if stroke then
			Ui.tween(stroke, Theme.Tween.Smooth, { Transparency = 1 })
		end
	end)
	task.delay(1, function()
		label:Destroy()
	end)
end

local function propModel(uid: number): Model?
	if PropBuilder.hasTemplate(uid) then
		return PropBuilder.template(uid)
	end
	return nil
end

function HudController:toast(uid: number, mutation: number, headline: string)
	local def = PropLibrary.get(uid)
	if not def then
		return
	end
	local mut = Mutations.get(mutation)
	local color = rarityColor(def.rarity)
	local card = Ui.new("Frame", {
		Size = UDim2.fromOffset(270, 76),
		BackgroundColor3 = Theme.Color.Panel,
		LayoutOrder = math.floor(os.clock() * 100),
		Parent = toasts,
	}, { Ui.corner(Theme.Radius.Medium), Ui.stroke(3, Theme.Color.Ink) })
	Ui.new("Frame", {
		Size = UDim2.new(0, 10, 1, 0),
		BackgroundColor3 = color,
		Parent = card,
	}, { Ui.corner(Theme.Radius.Medium) })
	Ui.viewport(propModel(uid), { Size = UDim2.fromOffset(64, 64), Position = UDim2.fromOffset(14, 6), Parent = card })
	Ui.new("TextLabel", {
		Text = headline,
		Position = UDim2.fromOffset(84, 6),
		Size = UDim2.new(1, -92, 0, 26),
		TextScaled = true,
		FontFace = Theme.Font.Display,
		TextColor3 = color,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = card,
	}, { Ui.stroke(2, Theme.Color.Ink) })
	Ui.new("TextLabel", {
		Text = (if mut then mut.name .. " " else "") .. def.name,
		Position = UDim2.fromOffset(84, 34),
		Size = UDim2.new(1, -92, 0, 22),
		TextScaled = true,
		TextColor3 = Theme.Color.Ink,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = card,
	})
	Ui.new("TextLabel", {
		Text = Rarity.get(def.rarity).glyph .. " " .. def.rarity,
		Position = UDim2.fromOffset(84, 56),
		Size = UDim2.new(1, -92, 0, 16),
		TextScaled = true,
		TextColor3 = color,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = card,
	}, { Ui.stroke(1, Theme.Color.Ink) })
	local s = Ui.new("UIScale", { Scale = 0.3, Parent = card })
	Ui.tween(s, Theme.Tween.Bounce, { Scale = 1 })
	task.delay(3, function()
		Ui.tween(s, Theme.Tween.Smooth, { Scale = 0 })
		task.wait(0.3)
		card:Destroy()
	end)
	-- Keep the stack short.
	local cards = {}
	for _, c in toasts:GetChildren() do
		if c:IsA("Frame") then
			table.insert(cards, c)
		end
	end
	if #cards > 4 then
		table.sort(cards, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		cards[1]:Destroy()
	end
end

-- "You can roll up TOASTERS now!" — the core growth reward, wordless-friendly (icon + check).
function HudController:goalUnlocked(uid: number)
	local def = PropLibrary.get(uid)
	if not def then
		return
	end
	local card = Ui.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromOffset(340, 120),
		BackgroundColor3 = Theme.Color.Accent,
		Parent = root,
	}, { Ui.corner(Theme.Radius.Large), Ui.stroke(4, Theme.Color.Ink) })
	Ui.viewport(propModel(uid), { Size = UDim2.fromOffset(110, 110), Position = UDim2.fromOffset(6, 5), Parent = card })
	Ui.display("✓ " .. def.name, {
		Position = UDim2.fromOffset(118, 16),
		Size = UDim2.new(1, -128, 0, 50),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = card,
	})
	Ui.new("TextLabel", {
		Text = "can be rolled up now! 🟢",
		Position = UDim2.fromOffset(118, 68),
		Size = UDim2.new(1, -128, 0, 30),
		TextScaled = true,
		TextColor3 = Theme.Color.Ink,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = card,
	})
	local s = Ui.new("UIScale", { Scale = 0.2, Parent = card })
	Ui.tween(s, Theme.Tween.Bounce, { Scale = 1 })
	task.delay(1.6, function()
		Ui.tween(s, Theme.Tween.Smooth, { Scale = 0 })
		Ui.tween(card, Theme.Tween.Smooth, { Position = UDim2.fromScale(0.5, 0.2) })
		task.wait(0.3)
		card:Destroy()
	end)
	bumpSpring:impulse(6)
end

local function setTopRow(i: number, entry)
	local row = topList:FindFirstChild("Row" .. i)
	if not row then
		return
	end
	if not entry then
		row.Visible = false
		return
	end
	row.Visible = true
	row.BackgroundColor3 = if entry.userId == state.player.UserId then Theme.Color.MagicDark else Theme.Color.Ink
	local nameLabel = row:FindFirstChild("Name") :: TextLabel
	nameLabel.Text = entry.name
	local sizeLabel = row:FindFirstChild("Size") :: TextLabel
	local mode = Modes.get(state.round.mode)
	if mode.scoring == "crown" then
		sizeLabel.Text = "👑" .. Format.clock(entry.s or 0)
	elseif mode.scoring == "gold" then
		sizeLabel.Text = "💰" .. math.floor(entry.s or 0)
	else
		sizeLabel.Text = Format.size(entry.d, cmPerStud())
	end
	if entry.team then
		row.BackgroundColor3 = if entry.team == "Red" then Color3.fromRGB(170, 40, 70) else Color3.fromRGB(30, 90, 190)
	end
	local avatar = row:FindFirstChild("Avatar") :: ImageLabel
	-- Bots wear real avatars; show the headshot of the look they're wearing.
	local thumbId = if entry.userId < 0 then entry.avatarId else entry.userId
	if not thumbId then
		avatar.Image = ""
		return
	end
	local thumb = thumbnails[thumbId]
	if thumb then
		avatar.Image = thumb
	elseif thumb == nil then
		thumbnails[thumbId] = false
		task.spawn(function()
			local ok, img = pcall(function()
				return Players:GetUserThumbnailAsync(thumbId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
			end)
			if ok then
				thumbnails[thumbId] = img
			end
		end)
	end
end

local function updateGoal()
	local world = controllers.WorldController
	local goal = world and world.nextGoal
	if not state:isRolling() or not goal then
		goalCard.Visible = false
		return
	end
	goalCard.Visible = true
	if goalUid ~= goal.uid then
		local model = propModel(goal.uid)
		if model then
			goalUid = goal.uid
			Ui.setViewportModel(goalIcon, model)
			local s = goalCard:FindFirstChildOfClass("UIScale") or Ui.new("UIScale", { Parent = goalCard })
			s.Scale = 0.6
			Ui.tween(s, Theme.Tween.Bounce, { Scale = 1 })
		end
	end
	local def = PropLibrary.get(goal.uid)
	goalText.Text = (if def then def.name else "?") .. " @ " .. Format.size(goal.needDiameter, cmPerStud())
	local frac = math.clamp(state.diameter / goal.needDiameter, 0, 1)
	goalBar.Size = UDim2.fromScale(math.max(0.04, frac), 1)
end

function HudController:attachLandmarkMarker(p)
	if not p.model or not p.model.PrimaryPart then
		return
	end
	local hb = p.model.PrimaryPart
	local gui = Ui.new("BillboardGui", {
		Name = "LandmarkMarker",
		Size = UDim2.fromOffset(150, 70),
		StudsOffsetWorldSpace = Vector3.new(0, hb.Size.Y * 0.6 + 10, 0),
		AlwaysOnTop = true,
		LightInfluence = 0,
		MaxDistance = 5000,
		Adornee = hb,
		Parent = hb,
	})
	local label = Ui.display("🔒", { Size = UDim2.fromScale(1, 1), Parent = gui })
	local need = p.absorbSize / Tuning.Absorb.LandmarkReach
	task.spawn(function()
		while gui.Parent do
			if state:isFinalRoll() then
				local canNow = state.diameter >= need
				label.Text = if canNow then "⭐ ROLL IT UP! ⭐" else "⭐ " .. Format.size(need, cmPerStud())
				label.TextColor3 = if canNow then Theme.Color.Accent else Theme.Color.White
				label.Rotation = math.sin(os.clock() * 6) * 4
			else
				label.Text = "🔒 Final Roll"
				label.TextColor3 = Theme.Color.White
				label.Rotation = 0
			end
			task.wait(0.15)
		end
	end)
end

-- Results ---------------------------------------------------------------------------------------

local pendingProgress = nil
local recordShownRound = nil

-- XP bar on the results card: fills from the old XP to the new, flashing LEVEL UP on the way.
function HudController:showProgress(data)
	local panel = resultsPanel
	if not panel then
		pendingProgress = data
		return
	end
	pendingProgress = nil
	local box = Ui.new("Frame", {
		Name = "Progress",
		Position = UDim2.new(0, 0, 1, -150),
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundTransparency = 1,
		Parent = panel,
	})
	local levelLabel = Ui.display("⭐ Lv " .. data.from.level, {
		Size = UDim2.fromOffset(120, 40),
		TextColor3 = Theme.Color.Magic,
		Parent = box,
	})
	local bar = Ui.new("Frame", {
		Position = UDim2.fromOffset(130, 8),
		Size = UDim2.new(1, -260, 0, 28),
		BackgroundColor3 = Theme.Color.PaperDim,
		Parent = box,
	}, { Ui.corner(Theme.Radius.Pill), Ui.stroke(2.5, Theme.Color.Ink) })
	local fill = Ui.new("Frame", {
		Size = UDim2.fromScale(math.clamp(data.from.into / math.max(data.from.need, 1), 0, 1), 1),
		BackgroundColor3 = Theme.Color.Magic,
		Parent = bar,
	}, { Ui.corner(Theme.Radius.Pill), Ui.gradient(Color3.new(1, 1, 1), Color3.fromRGB(205, 205, 205)) })
	Ui.display("+" .. data.xp .. " XP", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(120, 40),
		TextColor3 = Theme.Color.Good,
		Parent = box,
	})
	task.spawn(function()
		task.wait(0.6)
		local level = data.from.level
		while level < data.to.level and box.Parent do
			Ui.tween(fill, TweenInfo.new(0.5, Enum.EasingStyle.Quad), { Size = UDim2.fromScale(1, 1) })
			task.wait(0.55)
			level += 1
			levelLabel.Text = "⭐ Lv " .. level
			self:showBanner("⭐ LEVEL " .. level .. "! ⭐", Theme.Color.Magic, 2)
			if controllers.AudioController then
				controllers.AudioController:play("Legendary", { volume = 0.6 })
			end
			if controllers.VFXController and state.ball then
				controllers.VFXController:sparkle(state.ball.Position, Theme.Color.Magic, 6, 30)
			end
			fill.Size = UDim2.fromScale(0, 1)
			task.wait(0.4)
		end
		if box.Parent then
			Ui.tween(fill, TweenInfo.new(0.6, Enum.EasingStyle.Quad), { Size = UDim2.fromScale(math.clamp(data.to.into / math.max(data.to.need, 1), 0, 1), 1) })
		end
	end)
	if data.record then
		self:feed("🏆 New personal best: " .. Format.size(data.record.new, cmPerStud()) .. "!", Theme.Color.Accent)
	end
end

local function closeResults()
	if resultsPanel then
		resultsPanel:Destroy()
		resultsPanel = nil
	end
end

local function showResults(results)
	closeResults()
	local panel = Ui.new("Frame", {
		Name = "Results",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.385),
		Size = UDim2.fromOffset(640, 470),
		BackgroundColor3 = Theme.Color.Panel,
		Parent = root,
	}, { Ui.corner(Theme.Radius.Large), Ui.stroke(4, Theme.Color.Ink), Ui.padding(18) })
	resultsPanel = panel
	local kit = Kits.get(results.kitId or "")
	local mode = Modes.get(results.mode)
	local headline = (if kit then kit.icon .. " " .. kit.name else "Round") .. " — " .. mode.name
	if results.winningTeam then
		headline = (if results.winningTeam == "Red" then "🔴 RED" else "🔵 BLUE") .. " TEAM WINS!"
		local myTeam = results.mine and results.mine.team
		if myTeam == results.winningTeam then
			headline ..= " 🎉"
		end
	end
	Ui.display(headline, {
		Size = UDim2.new(1, 0, 0, 46),
		TextColor3 = Theme.Color.Primary,
		Parent = panel,
	})
	local awards = Ui.new("Frame", {
		Position = UDim2.fromOffset(0, 56),
		Size = UDim2.new(1, 0, 0, 230),
		BackgroundTransparency = 1,
		Parent = panel,
	}, {
		Ui.new("UIGridLayout", { CellSize = UDim2.fromOffset(190, 108), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	for i, award in results.awards or {} do
		local cardColor = if award.userId == state.player.UserId then Theme.Color.Accent else Theme.Color.PanelAlt
		local card = Ui.new("Frame", { LayoutOrder = i, BackgroundColor3 = cardColor, Parent = awards }, { Ui.corner(Theme.Radius.Medium), Ui.stroke(3, Theme.Color.Ink) })
		Ui.new("TextLabel", { Text = award.icon, Size = UDim2.fromOffset(44, 44), Position = UDim2.fromOffset(8, 8), TextScaled = true, Parent = card })
		Ui.new("TextLabel", { Text = award.title, Position = UDim2.fromOffset(56, 10), Size = UDim2.new(1, -62, 0, 26), TextScaled = true, TextColor3 = Theme.Color.Ink, TextXAlignment = Enum.TextXAlignment.Left, Parent = card })
		Ui.new("TextLabel", { Text = award.name, Position = UDim2.fromOffset(10, 58), Size = UDim2.new(1, -20, 0, 32), TextScaled = true, FontFace = Theme.Font.Display, TextColor3 = Theme.Color.MagicDark, Parent = card })
	end
	local mine = results.mine
	local payout = results.payout
	local summary = "Your ball: " .. Format.size(mine and mine.finalDiameter or 0, results.cmPerStud or 1)
	if mode.scoring == "crown" then
		summary = "👑 Crown time: " .. Format.clock(mine and mine.crownTime or 0)
	elseif mode.scoring == "gold" then
		summary = "💰 Gold: " .. math.floor(mine and mine.goldPoints or 0)
	end
	if mine and mine.placement then
		summary = Format.ordinal(mine.placement) .. " place  •  " .. summary
	end
	if payout then
		summary ..= "    ✨ +" .. Format.commas(payout.total) .. " Stardust"
	end
	Ui.display(summary, {
		Position = UDim2.new(0, 0, 1, -100),
		Size = UDim2.new(1, 0, 0, 40),
		TextColor3 = Theme.Color.Ink,
		Parent = panel,
	}).TextStrokeTransparency = 1
	local countdown = Ui.new("TextLabel", {
		Position = UDim2.new(0, 0, 1, -48),
		Size = UDim2.new(1, 0, 0, 32),
		TextScaled = true,
		TextColor3 = Theme.Color.InkSoft,
		Parent = panel,
	})
	task.spawn(function()
		while resultsPanel == panel do
			local left = state:timeLeft()
			if state.round.state == "Results" then
				countdown.Text = "Hub in " .. math.ceil(left)
			elseif state.round.state == "Intermission" then
				countdown.Text = "Next round in " .. math.ceil(left)
			else
				break
			end
			task.wait(0.2)
		end
		closeResults()
	end)
	local s = Ui.new("UIScale", { Scale = 0.3, Parent = panel })
	Ui.tween(s, Theme.Tween.Pop, { Scale = 1 })
	if pendingProgress then
		HudController:showProgress(pendingProgress)
	end
end

-- Loop ------------------------------------------------------------------------------------------

local function update(dt: number)
	-- Size counter: springy count-up and bump.
	sizeSpring.target = state.diameter
	local d = sizeSpring:step(dt)
	local value, unit = Format.sizeParts(math.max(d, 0.1), cmPerStud())
	sizeValue.Text = value
	sizeUnit.Text = unit
	if unit ~= lastUnit then
		lastUnit = unit
		HudController:showBanner("📏 " .. string.upper(unit) .. "!", Theme.Color.Accent, 1.6)
		bumpSpring:impulse(10)
	end
	sizeScale.Scale = bumpSpring:step(dt)
	local rolling = state:isRolling() or state.playerState == "Rider"
	local sizeHolder = sizeValue.Parent :: Frame
	sizeHolder.Visible = rolling

	-- Beat your best on this map mid-round: celebrate once.
	local profile = state.profile
	local roundNow = state.round
	if rolling and profile and profile.records and roundNow.kitId and recordShownRound ~= roundNow.roundId then
		local best = profile.records[roundNow.kitId]
		if best and best > 5 and state.diameter > best then
			recordShownRound = roundNow.roundId
			HudController:showBanner("🏆 NEW PERSONAL RECORD!", Theme.Color.Accent, 2.4)
			bumpSpring:impulse(14)
			if controllers.AudioController then
				controllers.AudioController:play("Legendary", { volume = 0.5 })
			end
		end
	end

	-- Aggregate tiny gains into readable floaters.
	if pendingGain > 0 and os.clock() - pendingAt > 0.18 then
		local v, u = Format.sizeParts(pendingGain, cmPerStud())
		floater("+" .. v .. " " .. u, Theme.Color.Good)
		pendingGain = 0
	end

	-- Timer.
	local round = state.round
	local left = state:timeLeft()
	timerLabel.Text = Format.clock(left)
	local final = state:isFinalRoll()
	timerPill.BackgroundColor3 = if final then Theme.Color.Bad else Theme.Color.Panel
	timerLabel.TextColor3 = if final then Theme.Color.White else Theme.Color.Ink
	timerPill.Visible = round.state == "Playing"

	-- The last 10 seconds count down big so the launch is never a surprise.
	if round.state == "Playing" and left <= 10.5 and left > 0 then
		local n = math.ceil(left - 0.5)
		if n ~= lastCountdown and n >= 1 and n <= 10 then
			lastCountdown = n
			countdownLabel.Text = tostring(n)
			countdownLabel.TextTransparency = 0
			local stroke = countdownLabel:FindFirstChildOfClass("UIStroke")
			if stroke then
				stroke.Transparency = 0
			end
			local s = countdownLabel:FindFirstChildOfClass("UIScale") or Ui.new("UIScale", { Parent = countdownLabel })
			s.Scale = 1.6
			Ui.tween(s, Theme.Tween.Pop, { Scale = 1 })
			Ui.tween(countdownLabel, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 0.6 })
			if controllers.AudioController then
				controllers.AudioController:play("Tick", { pitch = 1 + (10 - n) * 0.06 })
			end
			if n == 10 then
				HudController:showBanner("🚀 Launch in 10! Get BIG!", Theme.Color.Accent, 1.8)
			end
		end
	elseif lastCountdown ~= -1 then
		lastCountdown = -1
		countdownLabel.TextTransparency = 1
		local stroke = countdownLabel:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Transparency = 1
		end
	end
	topList.Visible = round.state == "Playing"
	updateModeHud()

	-- Touch buttons + dash cooldown.
	touchButtons.Visible = input.inputType == "Touch" and state:isRolling()
	if dashFill then
		local p = controllers.MovementController:dashProgress()
		dashFill.Size = UDim2.fromScale(1, 1 - p)
	end
end

function HudController:start()
	state = controllers.ClientState
	settings = controllers.SettingsController
	input = controllers.InputController
	Ui.onClickSound = function()
		if controllers.AudioController then
			controllers.AudioController:play("Click")
		end
	end
	gui = Ui.new("ScreenGui", {
		Name = "RollHud",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	Ui.autoScale(gui)
	root = Ui.new("Frame", {
		Name = "Root",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		Ui.new("UIPadding", { PaddingTop = UDim.new(0, 36), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8) }),
	})
	buildSizeCounter()
	buildGoalCard()
	buildTimer()
	buildTopList()
	buildModeHud()
	buildTouchButtons()
	buildContainers()
	buildCombo()
	buildSpeedLines()
	buildRiderPanel()
	controllers.WorldController.PropAbsorbed:Connect(function(_, absorberKey, isPrediction)
		if isPrediction and absorberKey == state.player.UserId then
			onLocalAbsorb()
		end
	end)
	controllers.MovementController.Bonked:Connect(function(_, hitPart)
		self:bonkGauge(hitPart)
	end)

	sizeSpring:snap(state.diameter)
	state.DiameterChanged:Connect(function(new, old)
		if new > old then
			pendingGain += new - old
			pendingAt = os.clock()
			bumpSpring:impulse(math.clamp((new - old) / old * 8, 0.3, 4))
		end
	end)
	state.BallChanged:Connect(function(part)
		if part then
			sizeSpring:snap(state.diameter)
		end
	end)
	Net.connect("Absorbed", function(list)
		for _, a in list do
			local def = PropLibrary.get(a.uid)
			if def then
				if a.n then
					self:toast(a.uid, a.m, "✨ NEW!")
				elseif a.v then
					self:toast(a.uid, a.m, "✨ NEW VARIANT!")
				elseif Rarity.get(def.rarity).toast or a.m > 0 then
					self:toast(a.uid, a.m, Rarity.get(def.rarity).glyph .. " " .. def.rarity .. "!")
				end
			end
		end
	end)
	controllers.WorldController.GoalUnlocked:Connect(function(uid)
		self:goalUnlocked(uid)
	end)
	controllers.WorldController.TemplateProgress:Connect(function(done, total)
		loadingChip.Visible = done < total
		loadingChip.Text = string.format("✨ Building the world… %d%%", math.floor(done / total * 100))
	end)
	state.RoundChanged:Connect(function(round: any, previous: any)
		for i = 1, 3 do
			setTopRow(i, round.top and round.top[i])
		end
		local enteredFinal = round.phase == "FinalRoll" and previous.phase ~= "FinalRoll"
		local enteredPlaying = round.state == "Playing" and previous.state ~= "Playing"
		local enteredLaunch = round.state == "Launch" and previous.state ~= "Launch"
		if enteredFinal then
			self:showBanner("⭐ FINAL ROLL! ⭐", Theme.Color.Accent, 2.8)
		elseif enteredPlaying then
			local kit = Kits.get(round.kitId or "")
			self:showBanner(if kit then kit.icon .. " " .. kit.name else "ROLL!", Theme.Color.White, 2.2)
		elseif enteredLaunch then
			self:showBanner("🚀 LAUNCH! 🚀", Theme.Color.Accent, 2.5)
		end
	end)
	state.ResultsReceived:Connect(showResults)
	Net.connect("Announce", function(kind, data)
		if kind == "rolled" and data then
			local me = state.player.UserId
			if data.hostId == me then
				self:showBanner("🌀 You rolled up " .. tostring(data.victimName) .. "!", Theme.Color.Accent, 2.2)
				bumpSpring:impulse(10)
			elseif data.victimId ~= me then
				self:feed("🌀 " .. tostring(data.hostName) .. " rolled up " .. tostring(data.victimName), Theme.Color.Secondary)
			end
			return
		end
		if kind == "runnerCaught" and data then
			if data.userId == state.player.UserId then
				self:showBanner("🏃 YOU CAUGHT THE GOLDEN RUNNER!", Color3.fromRGB(255, 210, 63), 2.6)
			else
				self:feed("🏃 " .. tostring(data.name) .. " caught the Golden Runner!", Color3.fromRGB(255, 210, 63))
			end
			return
		end
		if kind == "crown" and data then
			if data.userId == state.player.UserId then
				self:showBanner("👑 YOU HAVE THE CROWN! Keep it!", Color3.fromRGB(255, 214, 64), 2.2)
			else
				self:feed("👑 " .. tostring(data.name) .. " took the crown!", Color3.fromRGB(255, 214, 64))
			end
			return
		end
		if kind == "legendary" and data then
			local def = PropLibrary.get(data.uid)
			self:showBanner("🌟 " .. tostring(data.name) .. " found " .. (if def then def.name else "a Legendary") .. "!", rarityColor("Legendary"), 3)
		end
	end)
	RunService.RenderStepped:Connect(function(dt)
		update(dt)
		updateRiderPanel()
		updateSpeedLines(dt)
		fadeCombo()
	end)
	task.spawn(function()
		while true do
			task.wait(0.25)
			pcall(updateGoal)
		end
	end)
end

return HudController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="100">
            <Properties>
              <string name="Name">InputController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- All player input in one place. Movement comes from Roblox's own control module (dynamic thumbstick,
-- WASD/arrows, left stick) so it feels native everywhere; actions are bound with ContextActionService.
-- Camera orbit never needs right-click: Q/E, left-drag, one-finger drag (touch), right stick.

local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Signal = require(ReplicatedStorage.Shared.Util.Signal)

local InputController = {}

InputController.ActionPressed = Signal.new() -- (actionName)
InputController.ZoomChanged = Signal.new() -- (delta)
InputController.InputTypeChanged = Signal.new() -- ("Touch" | "Gamepad" | "Keyboard")
InputController.inputType = "Keyboard"
InputController.orbit = Vector2.zero -- accumulated orbit delta this frame (radians-ish), consumed by camera
InputController.orbitHeld = false
InputController.keyOrbit = 0 -- -1..1 from Q/E or right stick X
InputController.keyPitch = 0
InputController.lastMove = Vector3.zero

local controls = nil
local dragging = false
local dragInput: InputObject? = nil
local lastDragPos: Vector2? = nil

local function detectInputType(input: InputObject)
	local t = input.UserInputType
	local kind
	if t == Enum.UserInputType.Touch then
		kind = "Touch"
	elseif t.Name:find("Gamepad") then
		kind = "Gamepad"
	elseif t == Enum.UserInputType.Keyboard or t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.MouseMovement then
		kind = "Keyboard"
	end
	if kind and kind ~= InputController.inputType then
		InputController.inputType = kind
		InputController.InputTypeChanged:Fire(kind)
	end
end

-- Raw move input in camera space: X = right, Z = back (forward is -Z), magnitude 0..1.
function InputController:getMoveVector(): Vector3
	local v = Vector3.zero
	if controls then
		local ok, result = pcall(function()
			return controls:GetMoveVector()
		end)
		if ok and result then
			v = result
		end
	end
	if v.Magnitude > 1 then
		v = v.Unit
	end
	self.lastMove = v
	return v
end

-- Short rumble on gamepads (and phones that support it). intensity 0..1.
function InputController:rumble(intensity: number, duration: number)
	local HapticService = game:GetService("HapticService")
	local targets = { Enum.UserInputType.Gamepad1, Enum.UserInputType.Touch }
	for _, t in targets do
		local ok, supported = pcall(function()
			return HapticService:IsVibrationSupported(t)
		end)
		if ok and supported then
			pcall(function()
				HapticService:SetMotor(t, Enum.VibrationMotor.Large, math.clamp(intensity, 0, 1))
				HapticService:SetMotor(t, Enum.VibrationMotor.Small, math.clamp(intensity * 0.7, 0, 1))
			end)
			task.delay(duration, function()
				pcall(function()
					HapticService:SetMotor(t, Enum.VibrationMotor.Large, 0)
					HapticService:SetMotor(t, Enum.VibrationMotor.Small, 0)
				end)
			end)
		end
	end
end

-- Called by HUD touch buttons as well as keybinds.
function InputController:press(action: string)
	self.ActionPressed:Fire(action)
end

-- Consume the orbit delta accumulated since the last call.
function InputController:takeOrbit(): Vector2
	local o = self.orbit
	self.orbit = Vector2.zero
	return o
end

local function bindActions()
	ContextActionService:BindActionAtPriority("RTW_Hop", function(_, state)
		if state == Enum.UserInputState.Begin then
			InputController:press("Hop")
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.Space, Enum.KeyCode.ButtonA)
	ContextActionService:BindActionAtPriority("RTW_Dash", function(_, state)
		if state == Enum.UserInputState.Begin then
			InputController:press("Dash")
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift, Enum.KeyCode.ButtonX, Enum.KeyCode.ButtonR2)
	ContextActionService:BindActionAtPriority("RTW_Emote", function(_, state)
		if state == Enum.UserInputState.Begin then
			InputController:press("EmoteWheel")
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.ContextActionPriority.Medium.Value, Enum.KeyCode.G, Enum.KeyCode.ButtonY)
	ContextActionService:BindActionAtPriority("RTW_Burst", function(_, state)
		if state == Enum.UserInputState.Begin then
			InputController:press("Burst")
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.ContextActionPriority.Medium.Value, Enum.KeyCode.F, Enum.KeyCode.ButtonB)
end

-- While rolling, Space and Shift belong to us; in the hub they go back to the normal character.
function InputController:setRollingBindings(rolling: boolean)
	if rolling then
		bindActions()
	else
		ContextActionService:UnbindAction("RTW_Hop")
		ContextActionService:UnbindAction("RTW_Dash")
	end
end

function InputController:start()
	local player = Players.LocalPlayer
	task.spawn(function()
		local ok, module = pcall(function()
			local moduleScript: any = player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule")
			return (require :: any)(moduleScript)
		end)
		if ok and module then
			controls = module:GetControls()
		else
			warn("[Input] PlayerModule unavailable; movement input disabled")
		end
	end)

	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		self.inputType = "Touch"
	elseif UserInputService.GamepadEnabled and GuiService:IsTenFootInterface() then
		self.inputType = "Gamepad"
	end

	UserInputService.InputBegan:Connect(function(input, processed)
		detectInputType(input)
		if processed then
			return
		end
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.MouseButton2 then
			dragging = true
			lastDragPos = Vector2.new(input.Position.X, input.Position.Y)
		elseif t == Enum.UserInputType.Touch then
			-- Touches on the right 60% of the screen orbit the camera (left side is the thumbstick).
			local viewport = workspace.CurrentCamera.ViewportSize
			if input.Position.X > viewport.X * 0.4 and not dragInput then
				dragInput = input
				lastDragPos = Vector2.new(input.Position.X, input.Position.Y)
			end
		elseif input.KeyCode == Enum.KeyCode.Q then
			self.keyOrbit = -1
		elseif input.KeyCode == Enum.KeyCode.E then
			self.keyOrbit = 1
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.MouseButton2 then
			dragging = false
			self.orbitHeld = false
		elseif input == dragInput then
			dragInput = nil
			self.orbitHeld = false
		elseif input.KeyCode == Enum.KeyCode.Q and self.keyOrbit < 0 then
			self.keyOrbit = 0
		elseif input.KeyCode == Enum.KeyCode.E and self.keyOrbit > 0 then
			self.keyOrbit = 0
		end
	end)
	UserInputService.InputChanged:Connect(function(input, processed)
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseMovement and dragging and lastDragPos then
			local pos = Vector2.new(input.Position.X, input.Position.Y)
			local delta = pos - lastDragPos
			lastDragPos = pos
			if delta.Magnitude > 0.5 then
				self.orbit += delta
				self.orbitHeld = true
			end
		elseif input == dragInput and lastDragPos then
			local pos = Vector2.new(input.Position.X, input.Position.Y)
			self.orbit += (pos - lastDragPos)
			lastDragPos = pos
			self.orbitHeld = true
		elseif t == Enum.UserInputType.MouseWheel and not processed then
			-- Two-finger scroll on a MacBook trackpad arrives as MouseWheel.
			self.ZoomChanged:Fire(-input.Position.Z)
		elseif input.KeyCode == Enum.KeyCode.Thumbstick2 then
			local x, y = input.Position.X, input.Position.Y
			self.keyOrbit = if math.abs(x) > 0.2 then x else 0
			self.keyPitch = if math.abs(y) > 0.2 then y else 0
		end
	end)
	UserInputService.TouchPinch:Connect(function(_, scale, _, state)
		if state == Enum.UserInputState.Change then
			self.ZoomChanged:Fire((1 - scale) * 4)
		end
	end)
	bindActions()
end

return InputController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="101">
            <Properties>
              <string name="Name">LaunchController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- The end-of-round LAUNCH: your ball becomes a planet, and you watch it happen.
--   1. Ignition: the ball shudders on a column of fire and smoke.
--   2. Lift-off: it rockets up, BURNING ITS TRASH FOR FUEL. The props stuck to it break off in
--      flames and tumble back down, and the ball shrinks to its glowing core.
--   3. The sky fades to space (night, stars, nebula glow) while the camera rides along.
--   4. Your galaxy comes into view: Nana's star, orbit rings and every planet you've made before.
--   5. The core flies into an open orbit, pops into a planet with your colors and your planet's
--      name, and starts orbiting. The camera holds on your galaxy until the results.
-- Other players' balls launch too, toward their own corners of the sky.
-- Everything here is client-side presentation; the server only anchors balls and creates planets.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)

local LaunchController = {}
LaunchController.Launched = Signal.new()
LaunchController.Planeted = Signal.new() -- (userId, position)

local controllers
local state
local flights = {}
local debris = {}
local active = false
local scene: Model? = nil
local sceneOrbits = {}
local savedLighting = nil
local lightingFx = {}
local myPlanet = nil -- latest PlanetCreated record for us
local hold = nil -- camera hold after arrival

local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"
local FIRE = "rbxasset://textures/particles/fire_main.dds"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local GRAVITY = Vector3.new(0, -140, 0)
local MAX_DEBRIS = 70

function LaunchController:init(c)
	controllers = c
end

local function hex(h: string?, fallback: Color3): Color3
	if type(h) ~= "string" then
		return fallback
	end
	local ok, c = pcall(Color3.fromHex, h)
	return if ok then c else fallback
end

local function part(props): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		p[k] = v
	end
	return p
end

local function emitter(parent: Instance, props): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	for k, v in props do
		e[k] = v
	end
	e.Parent = parent
	return e
end

-- ROCKET FX -------------------------------------------------------------------------------------

local function addRocket(shell: BasePart, diameter: number): { Instance }
	local made = {}
	local bottom = Instance.new("Attachment")
	bottom.Position = Vector3.new(0, -diameter * 0.45, 0)
	bottom.Parent = shell
	table.insert(made, bottom)
	table.insert(made, emitter(bottom, {
		Texture = FIRE,
		Color = ColorSequence.new(Color3.fromRGB(255, 240, 160), Color3.fromRGB(255, 110, 60)),
		LightEmission = 1,
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, diameter * 0.55), NumberSequenceKeypoint.new(1, 0) }),
		Lifetime = NumberRange.new(0.25, 0.5),
		Rate = 70,
		Speed = NumberRange.new(diameter * 1.5, diameter * 2.8),
		EmissionDirection = Enum.NormalId.Bottom,
		SpreadAngle = Vector2.new(18, 18),
	}))
	table.insert(made, emitter(bottom, {
		Texture = SMOKE,
		Color = ColorSequence.new(Color3.fromRGB(255, 250, 240), Color3.fromRGB(190, 180, 200)),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 1) }),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, diameter * 0.5), NumberSequenceKeypoint.new(1, diameter * 1.8) }),
		Lifetime = NumberRange.new(1.4, 2.2),
		Rate = 28,
		Speed = NumberRange.new(diameter * 0.3, diameter * 0.7),
		EmissionDirection = Enum.NormalId.Bottom,
	}))
	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(255, 170, 90)
	glow.Range = math.clamp(diameter * 3, 12, 60)
	glow.Brightness = 3
	glow.Parent = shell
	table.insert(made, glow)
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(diameter * 0.3, 0, 0)
	a0.Parent = shell
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(-diameter * 0.3, 0, 0)
	a1.Parent = shell
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 1.1
	trail.LightEmission = 0.8
	trail.FaceCamera = true
	trail.Color = ColorSequence.new(Color3.fromRGB(255, 236, 140), Color3.fromRGB(255, 120, 196))
	trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	trail.Parent = shell
	table.insert(made, a0)
	table.insert(made, a1)
	table.insert(made, trail)
	return made
end

local function groundBlast(pos: Vector3, diameter: number)
	local anchor = part({ Transparency = 1, Size = Vector3.one, CFrame = CFrame.new(pos) })
	anchor.Parent = Workspace
	local smoke = emitter(anchor, {
		Texture = SMOKE,
		Color = ColorSequence.new(Color3.fromRGB(255, 248, 235)),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) }),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, diameter * 0.6), NumberSequenceKeypoint.new(1, diameter * 2.2) }),
		Lifetime = NumberRange.new(1.5, 2.5),
		Speed = NumberRange.new(diameter * 2, diameter * 4),
		SpreadAngle = Vector2.new(180, 8),
		Drag = 3,
		Enabled = false,
	})
	smoke:Emit(26)
	task.delay(3, function()
		anchor:Destroy()
	end)
end

-- FUEL: stuck props break off burning and fall ------------------------------------------------

local function igniteDebris(model: Model, size: number, velocity: Vector3)
	if #debris >= MAX_DEBRIS then
		model:Destroy()
		return
	end
	local root = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
	if not root then
		model:Destroy()
		return
	end
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
		end
	end
	local fx = Instance.new("Attachment")
	fx.Parent = root
	emitter(fx, {
		Texture = FIRE,
		Color = ColorSequence.new(Color3.fromRGB(255, 220, 140), Color3.fromRGB(255, 90, 50)),
		LightEmission = 1,
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, math.max(0.6, size * 0.7)), NumberSequenceKeypoint.new(1, 0) }),
		Lifetime = NumberRange.new(0.3, 0.6),
		Rate = 24,
		Speed = NumberRange.new(1, 3),
	})
	emitter(fx, {
		Texture = SMOKE,
		Color = ColorSequence.new(Color3.fromRGB(120, 110, 120)),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) }),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, math.max(0.6, size * 0.5)), NumberSequenceKeypoint.new(1, math.max(2, size * 1.6)) }),
		Lifetime = NumberRange.new(0.8, 1.3),
		Rate = 10,
		Speed = NumberRange.new(0.5, 1.5),
	})
	table.insert(debris, {
		model = model,
		vel = velocity,
		spin = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 8,
		cf = model:GetPivot(),
		born = os.clock(),
	})
end

-- Peel one visible stuck prop off a ball and send it tumbling down in flames.
local function shedOne(f): boolean
	local balls = controllers.BallVisualController
	local entry = balls and balls.balls[f.userId]
	if not entry then
		return false
	end
	for i = #entry.stuck, 1, -1 do
		local s = entry.stuck[i]
		if s.model and not s.folded then
			table.remove(entry.stuck, i)
			local model = s.model
			s.model = nil
			local out = model:GetPivot().Position - f.part.Position
			out = if out.Magnitude > 1e-3 then out.Unit else Vector3.new(1, 0, 0)
			local vel = Vector3.new(out.X, 0, out.Z) * (12 + math.random() * 18) + Vector3.new(0, -10 - math.random() * 25, 0) + f.vel * 0.25
			igniteDebris(model, s.size or 1, vel)
			return true
		end
	end
	-- Nothing visible left: chip a burning chunk off the core in one of its lump colors.
	if entry.lumps and #entry.lumps > 0 and math.random() < 0.6 then
		local lump = entry.lumps[math.random(1, #entry.lumps)]
		local size = f.diameter * (0.08 + math.random() * 0.08)
		local chunk = Instance.new("Model")
		local p = part({
			Size = Vector3.new(size, size * 0.7, size),
			Color = lump.Color,
			Material = Enum.Material.SmoothPlastic,
			CFrame = CFrame.new(f.part.Position + Vector3.new(math.random() - 0.5, -0.6, math.random() - 0.5) * f.diameter * 0.5),
		})
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
		p.Parent = chunk
		chunk.PrimaryPart = p
		chunk.Parent = Workspace
		local a = math.random() * math.pi * 2
		igniteDebris(chunk, size, Vector3.new(math.cos(a), 0, math.sin(a)) * 16 + Vector3.new(0, -20, 0) + f.vel * 0.25)
	end
	return false
end

local function updateDebris(dt: number)
	local now = os.clock()
	local parts, cfs = {}, {}
	for i = #debris, 1, -1 do
		local d = debris[i]
		local age = now - d.born
		if age > 4 or not d.model.Parent then
			d.model:Destroy()
			table.remove(debris, i)
			continue
		end
		d.vel += GRAVITY * dt
		local rot = CFrame.Angles(d.spin.X * dt, d.spin.Y * dt, d.spin.Z * dt)
		local new = (CFrame.new(d.cf.Position + d.vel * dt) * (d.cf - d.cf.Position) * rot)
		local delta = new * d.cf:Inverse()
		d.cf = new
		for _, p in d.model:GetDescendants() do
			if p:IsA("BasePart") then
				table.insert(parts, p)
				table.insert(cfs, delta * p.CFrame)
				if age > 3 then
					p.Transparency = math.min(1, p.Transparency + dt * 1.2)
				end
			end
		end
	end
	if #parts > 0 then
		Workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

-- SKY -> SPACE ------------------------------------------------------------------------------------

local function enterSpace(duration: number)
	if savedLighting then
		return
	end
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	local sky = Lighting:FindFirstChildOfClass("Sky")
	savedLighting = {
		ClockTime = Lighting.ClockTime,
		Brightness = Lighting.Brightness,
		FogEnd = Lighting.FogEnd,
		FogStart = Lighting.FogStart,
		ExposureCompensation = Lighting.ExposureCompensation,
		OutdoorAmbient = Lighting.OutdoorAmbient,
		atmosphere = atmosphere and { Density = atmosphere.Density, Haze = atmosphere.Haze, Glare = atmosphere.Glare },
		starCount = sky and sky.StarCount,
	}
	local info = TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	table.insert(lightingFx, TweenService:Create(Lighting, info, {
		ClockTime = 0.2,
		Brightness = 1.2,
		FogEnd = 100000,
		FogStart = 99999,
		ExposureCompensation = 0.3,
		OutdoorAmbient = Color3.fromRGB(110, 100, 160),
	}))
	if atmosphere then
		table.insert(lightingFx, TweenService:Create(atmosphere, info, { Density = 0, Haze = 0, Glare = 0 }))
	end
	if sky then
		sky.StarCount = 3000
	end
	local tint = Instance.new("ColorCorrectionEffect")
	tint.Name = "LaunchSpace"
	tint.Parent = Lighting
	table.insert(lightingFx, TweenService:Create(tint, info, { TintColor = Color3.fromRGB(215, 205, 255), Saturation = 0.2, Contrast = 0.08 }))
	lightingFx.tint = tint
	for _, t in lightingFx do
		if typeof(t) == "Instance" and t:IsA("Tween") then
			t:Play()
		end
	end
end

local function leaveSpace()
	if not savedLighting then
		return
	end
	for _, t in lightingFx do
		if typeof(t) == "Instance" and t:IsA("Tween") then
			t:Cancel()
		end
	end
	local s = savedLighting
	savedLighting = nil
	local info = TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
	TweenService:Create(Lighting, info, {
		ClockTime = s.ClockTime,
		Brightness = s.Brightness,
		FogEnd = s.FogEnd,
		FogStart = s.FogStart,
		ExposureCompensation = s.ExposureCompensation,
		OutdoorAmbient = s.OutdoorAmbient,
	}):Play()
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmosphere and s.atmosphere then
		TweenService:Create(atmosphere, info, s.atmosphere):Play()
	end
	local sky = Lighting:FindFirstChildOfClass("Sky")
	if sky and s.starCount then
		sky.StarCount = s.starCount
	end
	local tint = lightingFx.tint
	if tint then
		TweenService:Create(tint, info, { TintColor = Color3.new(1, 1, 1), Saturation = 0, Contrast = 0 }):Play()
		task.delay(1.3, function()
			tint:Destroy()
		end)
	end
	table.clear(lightingFx)
end

-- THE GALAXY ------------------------------------------------------------------------------------

local function planetModel(colors: { string }, fallback: Color3, radius: number, seed: number): Model
	local model = Instance.new("Model")
	local main = part({
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * radius * 2,
		Color = hex(colors[1], fallback),
		Material = Enum.Material.SmoothPlastic,
	})
	main.Parent = model
	model.PrimaryPart = main
	for i = 2, math.min(#colors, 5) do
		for k = 1, 3 do
			local blob = part({
				Shape = Enum.PartType.Ball,
				Size = Vector3.one * radius * (0.7 + ((i + k) % 3) * 0.16),
				Color = hex(colors[i], main.Color),
				Material = Enum.Material.SmoothPlastic,
			})
			local a = (i * 2.4 + k * 1.7 + seed) % (math.pi * 2)
			local b = ((i * 1.3 + k * 2.1) % math.pi) - math.pi / 2
			blob:SetAttribute("Offset", Vector3.new(math.cos(a) * math.cos(b), math.sin(b), math.sin(a) * math.cos(b)) * radius * 0.72)
			blob.Parent = model
		end
	end
	-- Soft atmosphere glow.
	local halo = part({
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * radius * 2.3,
		Color = main.Color:Lerp(Color3.new(1, 1, 1), 0.5),
		Material = Enum.Material.Neon,
		Transparency = 0.85,
	})
	halo:SetAttribute("Halo", true)
	halo.Parent = model
	return model
end

local function placePlanet(model: Model, cf: CFrame)
	for _, p in model:GetChildren() do
		if p:IsA("BasePart") then
			local offset = p:GetAttribute("Offset")
			p.CFrame = if offset then cf * CFrame.new(offset) else cf
		end
	end
end

local function label(adornee: BasePart, text: string, color: Color3, size: number)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(320, 60)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.StudsOffsetWorldSpace = Vector3.new(0, size + 4, 0)
	gui.Adornee = adornee
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, 1)
	t.Text = text
	t.TextScaled = true
	t.FontFace = Font.new("rbxasset://fonts/families/LuckiestGuy.json")
	t.TextColor3 = color
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = Color3.fromRGB(38, 26, 74)
	stroke.Parent = t
	t.Parent = gui
	gui.Parent = adornee
	return gui
end

-- Builds Nana's star, orbit rings and your existing planets around `center`.
local function buildGalaxy(center: Vector3, myD: number)
	local model = Instance.new("Model")
	model.Name = "LaunchGalaxy"
	local starR = math.max(40, myD * 1.6)
	local star = part({
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * starR * 2,
		Color = Color3.fromRGB(255, 210, 110),
		Material = Enum.Material.Neon,
		CFrame = CFrame.new(center),
	})
	star.Parent = model
	local glow = part({
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * starR * 3,
		Color = Color3.fromRGB(255, 160, 80),
		Material = Enum.Material.Neon,
		Transparency = 0.82,
		CFrame = CFrame.new(center),
	})
	glow.Parent = model
	local light = Instance.new("PointLight")
	light.Range = 60
	light.Brightness = 5
	light.Color = Color3.fromRGB(255, 220, 160)
	light.Parent = star
	label(star, "✨ Nana's Star ✨", Color3.fromRGB(255, 230, 150), starR)
	-- Nebula clouds far behind for color.
	for i = 1, 5 do
		local a = i * 1.26
		local cloud = part({
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * (starR * (6 + i)),
			Color = ({ Color3.fromRGB(150, 90, 255), Color3.fromRGB(255, 110, 190), Color3.fromRGB(80, 160, 255) })[(i % 3) + 1],
			Material = Enum.Material.Neon,
			Transparency = 0.93,
			CFrame = CFrame.new(center + Vector3.new(math.cos(a) * starR * 14, starR * (2 + i % 3), math.sin(a) * starR * 14)),
		})
		cloud.Parent = model
	end
	-- Existing planets in rings.
	table.clear(sceneOrbits)
	local planets = {}
	local profile = state.profile
	if profile and profile.galaxy then
		for _, p in profile.galaxy.planets do
			if not (myPlanet and p.id == myPlanet.id) then
				table.insert(planets, p)
			end
		end
	end
	table.sort(planets, function(a, b)
		return a.t < b.t
	end)
	local slot = 0
	local ringGap = math.max(30, myD * 1.4)
	local function orbitRadius(i: number): number
		return starR * 1.8 + i * ringGap
	end
	for i, p in planets do
		slot = i
		local r = math.clamp(myD * 0.35 + math.log(math.max(p.d, 1)) * myD * 0.08, 4, myD * 0.9)
		local pm = planetModel(p.colors or {}, Color3.fromRGB(140, 200, 255), r, p.id)
		pm.Parent = model
		if p.name then
			label(pm.PrimaryPart, p.name, Color3.new(1, 1, 1), r * 0.6).Size = UDim2.fromOffset(200, 34)
		end
		table.insert(sceneOrbits, {
			model = pm,
			radius = orbitRadius(i),
			speed = 0.22 / math.sqrt(i),
			phase = (p.id * 2.399) % (math.pi * 2),
			tilt = ((p.id * 0.61) % 0.3) - 0.15,
		})
	end
	-- Ring guides: thin glowing circles (built from short segments) for each orbit plus the new one.
	for i = 1, slot + 1 do
		local rr = orbitRadius(i)
		local isNew = i == slot + 1
		local segments = 56
		local thick = math.max(0.6, myD * 0.03)
		local segLen = 2 * math.pi * rr / segments * 1.05
		for k = 1, segments do
			local a = (k / segments) * math.pi * 2
			local seg = part({
				Size = Vector3.new(thick, thick, segLen),
				Color = if isNew then Color3.fromRGB(255, 230, 140) else Color3.fromRGB(180, 160, 255),
				Material = Enum.Material.Neon,
				Transparency = if isNew then 0.25 else 0.7,
				CFrame = CFrame.new(center + Vector3.new(math.cos(a) * rr, 0, math.sin(a) * rr)) * CFrame.Angles(0, -a, 0),
			})
			seg.Parent = model
		end
	end
	model.Parent = Workspace
	scene = model
	return {
		center = center,
		starR = starR,
		newOrbit = orbitRadius(slot + 1),
		newIndex = slot + 1,
	}
end

local function updateGalaxy()
	if not scene then
		return
	end
	local t = os.clock()
	local center = scene:GetAttribute("Center")
	if not center then
		return
	end
	for _, o in sceneOrbits do
		local a = o.phase + t * o.speed
		local pos = center + Vector3.new(math.cos(a) * o.radius, math.sin(a) * o.radius * o.tilt, math.sin(a) * o.radius)
		placePlanet(o.model, CFrame.new(pos) * CFrame.Angles(0, t * 0.5 + o.phase, 0.2))
	end
end

local function clearScene()
	if scene then
		scene:Destroy()
		scene = nil
	end
	table.clear(sceneOrbits)
	hold = nil
end

-- FLOW ------------------------------------------------------------------------------------------

local function onLaunch(list, endsAt)
	state = controllers.ClientState
	local balls = controllers.BallVisualController
	local now = os.clock()
	-- Leave ~5 s at the end to admire the galaxy before the results.
	local total = math.max(4, endsAt - Workspace:GetServerTimeNow())
	local duration = math.clamp(total - 5, 3.5, 10)
	table.clear(flights)
	clearScene()
	active = true
	local myFlight = nil
	local myId = state.player.UserId
	-- Find our launch spot first so the galaxy sits above it.
	local myEntry = nil
	for _, entry in list do
		if entry.userId == myId then
			myEntry = entry
		end
	end
	local galaxy = nil
	if myEntry and myEntry.ball and myEntry.ball:FindFirstChild("Ball") then
		local start = myEntry.ball.Ball.Position
		local d = myEntry.diameter
		galaxy = buildGalaxy(start + Vector3.new(0, 1300 + d * 7, -(500 + d * 3)), d)
		if scene then
			scene:SetAttribute("Center", galaxy.center)
		end
	end
	for i, entry in list do
		local model = entry.ball
		local ballPart = model and model:FindFirstChild("Ball")
		if ballPart then
			local d = entry.diameter
			local visual = balls and balls.balls[entry.userId]
			local made = if visual then addRocket(visual.shell, d) else {}
			local mine = entry.userId == myId
			local f = {
				userId = entry.userId,
				part = ballPart,
				start = ballPart.CFrame,
				diameter = d,
				t0 = now + 0.8 + (i % 5) * 0.12, -- ignition, then a slightly staggered volley
				dur = duration - 0.8,
				made = made,
				color = if visual then visual.color else Color3.new(1, 1, 1),
				popped = false,
				mine = mine,
				vel = Vector3.zero,
				lastPos = ballPart.Position,
				nextShed = 0,
				visual = visual,
			}
			if mine and galaxy then
				-- Our ball heads for the open orbit slot in front of the camera.
				f.target = galaxy.center + Vector3.new(0, 0, galaxy.newOrbit)
			else
				-- Others streak off toward their own galaxies in the far sky.
				local a = (entry.userId % 360) / 360 * math.pi * 2 + i
				f.target = ballPart.Position + Vector3.new(math.cos(a) * (900 + d * 4), 1600 + d * 8, math.sin(a) * (900 + d * 4))
			end
			table.insert(flights, f)
			if mine then
				myFlight = f
			end
			groundBlast(ballPart.Position - Vector3.new(0, d / 2, 0), d)
		end
	end
	if controllers.AudioController then
		controllers.AudioController:play("Launch")
	end
	local hud = controllers.HudController
	if hud then
		hud:showBanner("🚀 LAUNCH! 🚀", nil, 1.6)
		task.delay(1.8, function()
			hud:showBanner("🔥 Burning your trash for fuel!", Color3.fromRGB(255, 190, 110), 2)
		end)
		task.delay(duration * 0.6, function()
			hud:showBanner("🌌 Heading to your galaxy...", Color3.fromRGB(200, 180, 255), 2)
		end)
	end
	enterSpace(duration * 0.75)
	LaunchController.Launched:Fire(myFlight ~= nil)

	-- Camera: chase from below-behind (watch the fuel fall), then swing out to frame the galaxy as
	-- the core arrives, then hold and slowly orbit the galaxy.
	local camera = controllers.CameraController
	local cam = Workspace.CurrentCamera
	local startCF = cam.CFrame
	local focus = myFlight or flights[1]
	if camera and focus then
		local t0 = os.clock()
		camera:playScripted(function()
			local t = os.clock() - t0
			if not active and not hold then
				return nil
			end
			local d = focus.diameter
			if hold then
				local ht = os.clock() - hold.t0
				local a = ht * 0.12
				local c = hold.center
				local dist = hold.radius * 1.6 + 60
				return CFrame.lookAt(c + Vector3.new(math.sin(a) * dist, dist * 0.45, math.cos(a) * dist), c + Vector3.new(0, 0, hold.radius * 0.3))
			end
			local p = focus.part.Position
			local alpha = math.clamp(t / duration, 0, 1)
			-- Close chase: slightly below and behind, looking up past the ball at the sky.
			local chase = CFrame.lookAt(p + Vector3.new(d * 1.2 + 10, -d * 0.6 - 6, d * 2.6 + 16), p + Vector3.new(0, d * 3, 0))
			local target = chase
			if galaxy and alpha > 0.55 then
				local c = galaxy.center
				local wide = CFrame.lookAt(c + Vector3.new(galaxy.newOrbit * 0.6, galaxy.newOrbit * 0.5, galaxy.newOrbit * 1.9 + 60), (c + p) / 2)
				local k = math.clamp((alpha - 0.55) / 0.35, 0, 1)
				k = k * k * (3 - 2 * k)
				target = chase:Lerp(wide, k)
			end
			if t < 0.5 then
				target = startCF:Lerp(target, t / 0.5)
			end
			return target
		end)
	end
end

local function arrive(f)
	f.popped = true
	for _, inst in f.made do
		inst:Destroy()
	end
	local pos = f.part.Position
	-- Hide the real ball and its visuals; the planet takes over.
	local model = f.part.Parent
	if model then
		for _, d in model:GetDescendants() do
			if d:IsA("BasePart") then
				d.Transparency = 1
			end
		end
	end
	if f.visual then
		f.visual.folder.Parent = nil
	end
	-- Burst.
	local anchor = part({ Transparency = 1, Size = Vector3.one, CFrame = CFrame.new(pos) })
	anchor.Parent = Workspace
	local burst = emitter(anchor, {
		Texture = SPARKLE,
		Color = ColorSequence.new(f.color, Color3.new(1, 1, 1)),
		LightEmission = 1,
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, f.diameter * 0.4), NumberSequenceKeypoint.new(1, 0) }),
		Lifetime = NumberRange.new(0.8, 1.4),
		Speed = NumberRange.new(f.diameter * 2, f.diameter * 5),
		SpreadAngle = Vector2.new(180, 180),
		Drag = 2,
		Enabled = false,
	})
	burst:Emit(70)
	task.delay(2, function()
		anchor:Destroy()
	end)
	LaunchController.Planeted:Fire(f.userId, pos)
	if not f.mine then
		return
	end
	-- Our new planet joins the galaxy.
	local planet = myPlanet
	local colors = planet and planet.colors or {}
	local radius = math.max(4, f.diameter * 0.45)
	local pm = planetModel(colors, f.color, radius, planet and planet.id or 1)
	pm.Parent = scene or Workspace
	local center = scene and scene:GetAttribute("Center") or pos
	local orbitR = (Vector3.new(pos.X, center.Y, pos.Z) - center).Magnitude
	local name = planet and planet.name or "Your new planet"
	label(pm.PrimaryPart, "🪐 " .. name .. "  NEW!", Color3.fromRGB(255, 230, 120), radius)
	local entry = {
		model = pm,
		radius = orbitR,
		speed = 0.18,
		phase = math.atan2(pos.Z - center.Z, pos.X - center.X),
		tilt = 0,
	}
	-- Flash of light where the core becomes a planet.
	local flash = part({
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * radius * 2,
		Color = Color3.fromRGB(255, 245, 220),
		Material = Enum.Material.Neon,
		Transparency = 0.1,
		CFrame = CFrame.new(pos),
	})
	flash.Parent = Workspace
	local flashTween = TweenService:Create(flash, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.one * radius * 7,
		Transparency = 1,
	})
	flashTween:Play()
	flashTween.Completed:Once(function()
		flash:Destroy()
	end)
	table.insert(sceneOrbits, entry)
	hold = { t0 = os.clock(), center = center, radius = orbitR }
	if controllers.HudController then
		controllers.HudController:showBanner("🪐 " .. name .. " joined your galaxy!", Color3.fromRGB(255, 230, 120), 3.5)
	end
	if controllers.AudioController then
		controllers.AudioController:play("Legendary", { volume = 0.5 })
	end
	if controllers.CameraController then
		controllers.CameraController:shake(0.25)
	end
end

local function update(dt: number)
	updateDebris(dt)
	updateGalaxy()
	if not active then
		return
	end
	local now = os.clock()
	local anyFlying = false
	for _, f in flights do
		if not f.part.Parent or f.popped then
			continue
		end
		anyFlying = true
		local t = (now - f.t0) / f.dur
		local pos
		if t < 0 then
			-- Ignition: shudder in place.
			local k = 1 + t / 0.8
			pos = f.start.Position + Vector3.new(math.sin(now * 40) * 0.05, math.abs(math.sin(now * 33)) * 0.08, math.cos(now * 37) * 0.05) * f.diameter * k
		else
			t = math.min(t, 1)
			-- Rocket curve: straight up first, then bend toward the target.
			local e = t * t * (3 - 2 * t)
			local up = f.start.Position + Vector3.new(0, (f.target.Y - f.start.Position.Y) * math.min(1, t * 1.6) ^ 2, 0)
			local bend = math.clamp((t - 0.25) / 0.75, 0, 1)
			pos = up:Lerp(f.target, bend * bend * e)
			-- Burn off fuel: shed props steadily through the first two thirds of the climb.
			if t < 0.7 and now >= f.nextShed then
				f.nextShed = now + (if f.mine then 0.09 else 0.25)
				shedOne(f)
			end
			-- The ball burns down to its core as the fuel goes.
			if f.visual then
				f.visual.diameter = f.diameter * (1 - 0.35 * math.min(1, t / 0.7))
			end
		end
		f.vel = (pos - f.lastPos) / math.max(dt, 1 / 240)
		f.lastPos = pos
		f.part.CFrame = CFrame.new(pos) * CFrame.Angles(0, now * 3, math.max(t, 0) * 2)
		if t >= 1 then
			arrive(f)
		end
	end
	if not anyFlying and not hold then
		active = false
	end
end

function LaunchController:start()
	state = controllers.ClientState
	Net.connect("LaunchSequence", onLaunch)
	Net.connect("PlanetCreated", function(planet)
		if type(planet) == "table" then
			myPlanet = planet
		end
	end)
	RunService.RenderStepped:Connect(update)
	state.RoundChanged:Connect(function(round)
		if round.state ~= "Launch" then
			if active or scene or savedLighting then
				active = false
				clearScene()
				leaveSpace()
				for _, d in debris do
					d.model:Destroy()
				end
				table.clear(debris)
			end
		end
	end)
end

return LaunchController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="102">
            <Properties>
              <string name="Name">MenuController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Out-of-round progression UI: the side menu (Stardust counter, Nana's requests, Rolledex, Shop,
-- Galaxy), all menu panels, hub station prompts, the daily streak popup on join, server toasts
-- (boosts, finished requests, warnings, new planets) and the compact Nana tracker during rounds.

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Theme = require(Shared.Config.Theme)
local Format = require(Shared.Util.Format)
local Spring = require(Shared.Util.Spring)
local Progression = require(Shared.Logic.Progression)
local Cosmetics = require(Shared.Data.Cosmetics)
local Titles = require(Shared.Data.Titles)
local Ui = require(script.Parent.Parent.UI.Ui)
local Panel = require(script.Parent.Parent.UI.Panel)
local Panels = script.Parent.Parent.Panels
local Common = require(Panels.Common)
local StreakPanel = require(Panels.StreakPanel)
local RequestsPanel = require(Panels.RequestsPanel)
local RolledexPanel = require(Panels.RolledexPanel)
local ShopPanel = require(Panels.ShopPanel)
local GalaxyPanel = require(Panels.GalaxyPanel)

local MenuController = {}

local controllers
local state
local gui: ScreenGui
local menu: Frame
local stardustLabel: TextLabel
local stardustSpring = Spring.new(0, 90, 14)
local stardustShown = 0
local notices: Frame
local levelLabel: TextLabel
local levelFill: Frame
local panels: { [string]: any } = {}
local tracker
local badges = {}
local streakPopupDone = false

function MenuController:init(c)
	controllers = c
end

-- A short notice that slides in at the top centre (stacking).
function MenuController:notify(icon: string, text: string, color: Color3?)
	-- Keep the stack short: the oldest notice makes room.
	local existing = {}
	for _, c in notices:GetChildren() do
		if c:IsA("Frame") then
			table.insert(existing, c)
		end
	end
	if #existing >= 4 then
		existing[1]:Destroy()
	end
	local card = Ui.new("Frame", {
		Size = UDim2.fromOffset(420, 52),
		BackgroundColor3 = Theme.Color.Panel,
		Parent = notices,
	}, { Ui.corner(Theme.Radius.Pill), Ui.stroke(3, color or Theme.Color.Ink) })
	Ui.new("TextLabel", {
		Text = icon,
		Position = UDim2.fromOffset(10, 6),
		Size = UDim2.fromOffset(40, 40),
		TextScaled = true,
		Parent = card,
	})
	Ui.new("TextLabel", {
		Text = text,
		Position = UDim2.fromOffset(58, 8),
		Size = UDim2.new(1, -72, 1, -16),
		TextScaled = true,
		TextColor3 = Theme.Color.Ink,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = card,
	})
	local scale = Ui.new("UIScale", { Scale = 0.3, Parent = card })
	Ui.tween(scale, Theme.Tween.Pop, { Scale = 1 })
	if controllers.AudioController then
		controllers.AudioController:play("Toast")
	end
	task.delay(4, function()
		local t = Ui.tween(scale, Theme.Tween.Smooth, { Scale = 0 })
		t.Completed:Wait()
		card:Destroy()
	end)
end

local function menuButton(order: number, icon: string, label: string, color: Color3, onClick: () -> ())
	local _, holder = Ui.button({
		text = icon,
		size = UDim2.fromOffset(64, 64),
		color = color,
		radius = Theme.Radius.Pill,
		order = order,
		parent = menu,
		onClick = onClick,
	})
	Ui.new("TextLabel", {
		Text = label,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 1, -8),
		Size = UDim2.fromOffset(84, 18),
		TextScaled = true,
		ZIndex = 3,
		Parent = holder,
	}, { Ui.stroke(2, Theme.Color.Ink) })
	local badge = Ui.new("TextLabel", {
		Text = "!",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 4, 0, -4),
		Size = UDim2.fromOffset(24, 24),
		BackgroundColor3 = Theme.Color.Bad,
		BackgroundTransparency = 0,
		TextScaled = true,
		Visible = false,
		ZIndex = 4,
		Parent = holder,
	}, { Ui.corner(Theme.Radius.Pill), Ui.stroke(2, Theme.Color.Ink) })
	return holder, badge
end

local function buildMenu()
	menu = Ui.new("Frame", {
		Name = "SideMenu",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 16, 0.56, 0),
		Size = UDim2.fromOffset(180, 470),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	}, {
		Ui.new("UIListLayout", {
			Padding = UDim.new(0, 18),
			SortOrder = Enum.SortOrder.LayoutOrder,
			HorizontalAlignment = Enum.HorizontalAlignment.Left,
		}),
	})
	local pill = Ui.new("Frame", {
		Name = "Stardust",
		Size = UDim2.fromOffset(170, 46),
		BackgroundColor3 = Theme.Color.Panel,
		LayoutOrder = 0,
		Parent = menu,
	}, { Ui.corner(Theme.Radius.Pill), Ui.stroke(3, Theme.Color.Ink) })
	stardustLabel = Ui.new("TextLabel", {
		Text = "✨ 0",
		Position = UDim2.fromOffset(12, 6),
		Size = UDim2.new(1, -24, 1, -12),
		TextScaled = true,
		FontFace = Theme.Font.Display,
		TextColor3 = Theme.Color.AccentDark,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = pill,
	}, { Ui.stroke(2, Theme.Color.Ink) })
	Common.flyTarget = pill
	local levelPill = Ui.new("Frame", {
		Name = "Level",
		Size = UDim2.fromOffset(170, 40),
		BackgroundColor3 = Theme.Color.Panel,
		LayoutOrder = 0,
		Parent = menu,
	}, { Ui.corner(Theme.Radius.Pill), Ui.stroke(3, Theme.Color.Ink) })
	local track = Ui.new("Frame", {
		Position = UDim2.fromOffset(66, 12),
		Size = UDim2.new(1, -78, 0, 16),
		BackgroundColor3 = Theme.Color.PaperDim,
		Parent = levelPill,
	}, { Ui.corner(Theme.Radius.Pill), Ui.stroke(1.5, Theme.Color.Ink) })
	levelFill = Ui.new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Theme.Color.Magic,
		Parent = track,
	}, { Ui.corner(Theme.Radius.Pill) })
	levelLabel = Ui.new("TextLabel", {
		Text = "Lv 1",
		Position = UDim2.fromOffset(10, 6),
		Size = UDim2.fromOffset(54, 28),
		TextScaled = true,
		FontFace = Theme.Font.Display,
		TextColor3 = Theme.Color.Magic,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = levelPill,
	}, { Ui.stroke(1.5, Theme.Color.Ink) })
	local _, nanaBadge = menuButton(1, "🧶", "Nana", Theme.Color.Magic, function()
		panels.requests.panel:toggle()
	end)
	local _, dexBadge = menuButton(2, "📖", "Rolledex", Theme.Color.Secondary, function()
		panels.rolledex.panel:toggle()
	end)
	menuButton(3, "🛍️", "Shop", Theme.Color.Primary, function()
		panels.shop.panel:toggle()
	end)
	menuButton(4, "🌌", "Galaxy", Theme.Color.MagicDark, function()
		panels.galaxy.panel:toggle()
	end)
	badges.nana = nanaBadge
	badges.dex = dexBadge
end

local function updateBadges(profile)
	if not profile then
		return
	end
	local claimable = panels.streak:claimable(profile)
	for _, req in profile.daily.requests do
		if req.done and not req.claimed then
			claimable = true
		end
	end
	badges.nana.Visible = claimable
	-- New Rolledex entries since the book was last opened.
	local dex = panels.rolledex
	if dex.seenCount == nil then
		dex.seenCount = dex.foundCount or 0
	end
	badges.dex.Visible = (dex.foundCount or 0) > dex.seenCount
end

local function updateLevel(profile)
	if not profile or not levelLabel then
		return
	end
	local level, into, need = Progression.levelFromXp(profile.xp or 0)
	levelLabel.Text = "Lv " .. level
	Ui.tween(levelFill, Theme.Tween.Smooth, { Size = UDim2.fromScale(math.clamp(into / math.max(need, 1), 0, 1), 1) })
end

local function onProfile(profile)
	updateLevel(profile)
	for _, p in panels do
		local ok, err = pcall(p.refresh, p, profile)
		if not ok then
			warn("[Menu] panel refresh: " .. tostring(err))
		end
	end
	updateBadges(profile)
	if tracker then
		tracker.update(profile, state)
	end
end

local function onToast(kind: string, data)
	data = data or {}
	if kind == "daily" then
		-- Pop the streak card shortly after joining (once the world has had a moment to settle).
		if data.streakClaimable and (not streakPopupDone or data.newDay) then
			streakPopupDone = true
			task.delay(if data.newDay then 0.5 else 3, function()
				if not Panel.current() and state.playerState ~= "Rolling" then
					panels.streak.panel:open()
				elseif data.newDay then
					MenuController:notify("🌙", "A new day! Claim your streak and Nana's new requests.", Theme.Color.Magic)
				end
			end)
		end
	elseif kind == "request" then
		MenuController:notify(data.icon or "🧶", "Request done! " .. tostring(data.text or "") .. "  (+" .. tostring(data.reward or 0) .. " ✨)", Theme.Color.Magic)
		if controllers.AudioController then
			controllers.AudioController:play("NewDiscovery")
		end
	elseif kind == "boost" then
		local reasons = { comeback = "Comeback boost!", catchup = "Catch-up boost!" }
		MenuController:notify("⚡", string.format("%s Grow x%.1f for %ds", reasons[data.reason] or "Growth boost!", data.mult or 1, data.duration or 0), Theme.Color.Accent)
	elseif kind == "progress" then
		if controllers.HudController then
			controllers.HudController:showProgress(data)
		end
		for i, up in data.levelUps or {} do
			task.delay(1 + i * 1.2, function()
				local extras = {}
				if up.shell then
					local def = Cosmetics.ById[up.shell]
					table.insert(extras, (def and def.icon or "🎨") .. " " .. (def and def.name or up.shell) .. " shell")
				end
				if up.title then
					local def = Titles.ById[up.title]
					table.insert(extras, "title « " .. (def and def.text or up.title) .. " »")
				end
				local text = "Level " .. up.level .. "! +" .. up.stardust .. " ✨"
				if #extras > 0 then
					text ..= " + " .. table.concat(extras, " + ")
				end
				MenuController:notify("⭐", text, Theme.Color.Magic)
			end)
		end
		if data.record then
			local cm = (state.round and state.round.cmPerStud) or 1
			MenuController:notify("🏆", "New personal best: " .. Format.size(data.record.new, cm) .. "!", Theme.Color.Accent)
		end
	elseif kind == "achievement" then
		local text = "Achievement: " .. tostring(data.name) .. "  +" .. tostring(data.stardust) .. " ✨"
		if data.title then
			local def = Titles.ById[data.title]
			text ..= " + title « " .. (def and def.text or data.title) .. " »"
		end
		MenuController:notify(data.icon or "🏅", text, Theme.Color.Accent)
		if controllers.AudioController then
			controllers.AudioController:play("Legendary", { volume = 0.5 })
		end
	elseif kind == "setProgress" then
		MenuController:notify(data.icon or "📖", string.format("%s  %d / %d", tostring(data.name), data.have or 0, data.total or 0), Theme.Color.Secondary)
	elseif kind == "setComplete" then
		MenuController:notify(data.icon or "📖", "Set complete: " .. tostring(data.name) .. "!  +" .. tostring(data.stardust) .. " ✨", Theme.Color.Good)
		if controllers.AudioController then
			controllers.AudioController:play("Legendary", { volume = 0.6 })
		end
	elseif kind == "title" then
		MenuController:notify("🎖️", "New title: « " .. tostring(data.text) .. " »", Theme.Color.Magic)
	elseif kind == "warning" then
		MenuController:notify("⚠️", tostring(data.text or "Something went wrong"), Theme.Color.Bad)
	end
end

local function onPlanet(planet)
	if type(planet) ~= "table" then
		return
	end
	local cm = (state.round and state.round.cmPerStud) or 1
	task.delay(3.5, function()
		MenuController:notify("🪐", string.format("New planet: %s (%s)! See it in your Galaxy.", tostring(planet.name), Format.size(planet.d or 0, cm)), Theme.Color.Magic)
	end)
end

local function onPrompt(prompt: ProximityPrompt)
	local node = prompt.Parent
	local station = nil
	while node and node ~= workspace do
		station = node:GetAttribute("Station")
		if station then
			break
		end
		node = node.Parent
	end
	local map = {
		Requests = panels.requests,
		Rolledex = panels.rolledex,
		Shop = panels.shop,
		Cores = panels.shop,
		Galaxy = panels.galaxy,
	}
	local target = station and map[station]
	if target then
		if station == "Cores" then
			target.tab = "Cores"
		elseif station == "Shop" then
			target.tab = "Shells"
		end
		target.panel:open()
	end
end

local function update(dt: number)
	local profile = state.profile
	local rolling = state.playerState == "Rolling" or state.playerState == "Rider" or state.playerState == "Merged"
	local roundState = state.round and state.round.state
	local inShow = roundState == "Launch"
	menu.Visible = profile ~= nil and not rolling and not inShow
	if tracker then
		tracker.frame.Visible = profile ~= nil and rolling and roundState == "Playing" and tracker.hasOpen == true
	end
	if rolling and Panel.current() then
		Panel.closeAll()
	end
	-- Rolling counter for Stardust.
	if profile then
		stardustSpring.target = profile.stardust
		if stardustShown == 0 and profile.stardust > 0 and stardustSpring.position == 0 then
			stardustSpring:snap(profile.stardust) -- first sync: no count-up from zero
		end
		local shown = math.floor(stardustSpring:step(dt) + 0.5)
		if shown ~= stardustShown then
			stardustShown = shown
			stardustLabel.Text = "✨ " .. Format.commas(shown)
		end
	end
end

function MenuController:start()
	state = controllers.ClientState
	gui = Ui.new("ScreenGui", {
		Name = "MenuHud",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 10,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	Ui.autoScale(gui)
	notices = Ui.new("Frame", {
		Name = "Notices",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -130),
		Size = UDim2.fromOffset(440, 300),
		BackgroundTransparency = 1,
		ZIndex = 100,
		Parent = gui,
	}, {
		Ui.new("UIListLayout", {
			Padding = UDim.new(0, 8),
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
		}),
	})
	local ctx = {
		gui = gui,
		controllers = controllers,
		state = state,
		notify = function(icon, text, color)
			MenuController:notify(icon, text, color)
		end,
	}
	ctx.openStreak = function()
		panels.streak.panel:open()
	end
	buildMenu()
	panels.streak = StreakPanel.new(ctx)
	panels.requests = RequestsPanel.new(ctx)
	panels.rolledex = RolledexPanel.new(ctx)
	panels.shop = ShopPanel.new(ctx)
	panels.galaxy = GalaxyPanel.new(ctx)
	panels.rolledex.panel.Opened:Connect(function()
		panels.rolledex.seenCount = panels.rolledex.foundCount or 0
		badges.dex.Visible = false
	end)
	tracker = RequestsPanel.buildTracker(gui, function()
		-- Tapping the tracker mid-round just flashes it; the board opens between rounds.
		MenuController:notify("🧶", "Claim Nana's rewards from the menu between rounds!", Theme.Color.Magic)
	end)
	local baseUpdate = tracker.update
	tracker.update = function(profile, s)
		tracker.hasOpen = baseUpdate(profile, s)
		return tracker.hasOpen
	end
	state.ProfileChanged:Connect(onProfile)
	if state.profile then
		onProfile(state.profile)
	end
	Net.connect("Toast", onToast)
	Net.connect("PlanetCreated", onPlanet)
	ProximityPromptService.PromptTriggered:Connect(onPrompt)
	state.ResultsReceived:Connect(function()
		-- Results show Stardust earned; nudge the badge state after the payout sync.
		task.delay(1, function()
			updateBadges(state.profile)
		end)
	end)
	RunService.RenderStepped:Connect(update)
end

return MenuController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="103">
            <Properties>
              <string name="Name">MovementController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Local ball physics: momentum-based rolling with snappy acceleration, strong turn-in, a coasting
-- brake, hop and dash. The client owns its ball, so input feels instant; the server validates.
--
-- We steer by setting the ball's horizontal velocity toward a force-limited target every physics
-- step and drive its spin to match true rolling, so stuck props visibly roll with the ball while
-- the motion stays tight and predictable at every size.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)
local Growth = require(Shared.Logic.Growth)
local MovementModel = require(Shared.Logic.MovementModel)
local Tuning = require(Shared.Config.Tuning)
local Cores = require(Shared.Data.Cores)
local Animations = require(Shared.Config.Animations)

local MovementController = {}

MovementController.Hopped = Signal.new()
MovementController.Dashed = Signal.new()
MovementController.Landed = Signal.new() -- (impactSpeed)
MovementController.Bonked = Signal.new() -- (speed, hitPart, hitPosition, normal)
MovementController.grounded = false
MovementController.speed = 0
MovementController.velocity = Vector3.zero
MovementController.heading = Vector3.new(0, 0, -1)
MovementController.dashReadyAt = 0
MovementController.dashUntil = 0
MovementController.lastDash = -math.huge
MovementController.moveInput = Vector3.zero -- world-space desired direction (0..1)
MovementController.enabled = false

local controllers
local state, input, camera
local ball: BasePart? = nil
local riderAttachment: Attachment? = nil
local alignPos: AlignPosition? = nil
local alignOri: AlignOrientation? = nil
local animTracks = {}
local lastHop = -math.huge
local lastGroundedAt = 0
local airborneSince = 0
local wasGrounded = true
local prevHorizontal = Vector3.zero
local lastBonk = 0
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

function MovementController:init(c)
	controllers = c
end

local function speedMultiplier(): number
	local mult = 1
	local def = Cores.get(state.core)
	if def and def.speedMult then
		mult *= def.speedMult(state.coreLevel)
	end
	mult *= state:mods().speedMult or 1
	if state.playerState == "Merged" then
		mult *= Tuning.Merge.SpeedPenalty
	end
	return mult
end

local function hopHeight(d: number): number
	local h = Growth.hopHeight(d)
	local def = Cores.get(state.core)
	if def and def.hopMult then
		h *= def.hopMult(state.coreLevel)
	end
	return h
end

function MovementController:dashCooldown(): number
	local def = Cores.get(state.core)
	local mult = if def and def.dashCooldownMult then def.dashCooldownMult(state.coreLevel) else 1
	return Tuning.Ball.DashCooldown * mult
end

function MovementController:dashProgress(): number
	local cd = self:dashCooldown()
	return math.clamp((os.clock() - self.lastDash) / cd, 0, 1)
end

local function refreshFilter()
	local list = {}
	local character = Players.LocalPlayer.Character
	if character then
		table.insert(list, character)
	end
	if state.ballModel then
		table.insert(list, state.ballModel)
	end
	local visuals = Workspace:FindFirstChild("BallVisuals")
	if visuals then
		table.insert(list, visuals)
	end
	rayParams.FilterDescendantsInstances = list
end

local function loadAnimations(character: Model)
	table.clear(animTracks)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		return
	end
	local rig = if humanoid.RigType == Enum.HumanoidRigType.R6 then "R6" else "R15"
	local ids = Animations[rig]
	for _, name in { "Run", "Idle", "Fall", "Cheer", "Wave", "Laugh" } do
		local anim = Instance.new("Animation")
		anim.AnimationId = ids[name]
		local ok, track = pcall(function()
			return animator:LoadAnimation(anim)
		end)
		if ok and track then
			local oneShot = name == "Cheer" or name == "Wave" or name == "Laugh"
			track.Priority = if oneShot then Enum.AnimationPriority.Action2 else Enum.AnimationPriority.Action
			track.Looped = not oneShot
			animTracks[name] = track
		end
	end
end

-- Humanoid states that must never run while riding (any of them can pull the avatar off the ball
-- and make it walk on the ground behind it).
local RIDE_DISABLED_STATES = {
	Enum.HumanoidStateType.Running,
	Enum.HumanoidStateType.RunningNoPhysics,
	Enum.HumanoidStateType.Jumping,
	Enum.HumanoidStateType.Freefall,
	Enum.HumanoidStateType.Landed,
	Enum.HumanoidStateType.Climbing,
	Enum.HumanoidStateType.Seated,
	Enum.HumanoidStateType.FallingDown,
	Enum.HumanoidStateType.Ragdoll,
	Enum.HumanoidStateType.GettingUp,
	Enum.HumanoidStateType.Swimming,
	Enum.HumanoidStateType.StrafingNoPhysics,
}

local function setRideStates(humanoid: Humanoid, riding: boolean)
	for _, st in RIDE_DISABLED_STATES do
		pcall(function()
			humanoid:SetStateEnabled(st, not riding)
		end)
	end
	if riding then
		humanoid.PlatformStand = true
		humanoid:ChangeState(Enum.HumanoidStateType.Physics)
	else
		humanoid.PlatformStand = false
		humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
	end
end

-- The Roller: the avatar balances on top of the ball, running on it like a circus performer.
-- It is locked to the ball every physics step (see holdRider), with a rigid AlignPosition as a
-- second line of defence, so it can never be left behind however big or fast the ball gets.
local function attachRider()
	local character = Players.LocalPlayer.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not hrp or not humanoid then
		return
	end
	if alignPos then
		alignPos:Destroy()
	end
	if alignOri then
		alignOri:Destroy()
	end
	if riderAttachment then
		riderAttachment:Destroy()
	end
	local att = Instance.new("Attachment")
	att.Name = "RollerAttachment"
	att.Parent = hrp
	local ap = Instance.new("AlignPosition")
	ap.Mode = Enum.PositionAlignmentMode.OneAttachment
	ap.Attachment0 = att
	ap.RigidityEnabled = true
	ap.Parent = hrp
	local ao = Instance.new("AlignOrientation")
	ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
	ao.Attachment0 = att
	ao.RigidityEnabled = true
	ao.Parent = hrp
	riderAttachment, alignPos, alignOri = att, ap, ao
	setRideStates(humanoid, true)
	loadAnimations(character)
end

local function detachRider()
	if alignPos then
		alignPos:Destroy()
		alignPos = nil
	end
	if alignOri then
		alignOri:Destroy()
		alignOri = nil
	end
	if riderAttachment then
		riderAttachment:Destroy()
		riderAttachment = nil
	end
	for _, track in animTracks do
		pcall(function()
			track:Stop(0.2)
		end)
	end
	local character = Players.LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		setRideStates(humanoid, false)
	end
end

-- Where the avatar should be: standing on top of the ball, facing the direction of travel.
local function riderTarget(): CFrame?
	local character = Players.LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local hrp = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not ball or not humanoid or not hrp then
		return nil
	end
	local r = ball.Size.X / 2
	local standHeight = humanoid.HipHeight + hrp.Size.Y / 2
	local h = MovementController.heading
	local pos = ball.Position + Vector3.new(0, r + standHeight * 0.95, 0)
	return CFrame.lookAt(pos, pos + Vector3.new(h.X, 0, h.Z))
end

-- Hard-lock the avatar to the ball every physics step (client owns the character, so this
-- replicates to everyone). Also re-asserts the Physics humanoid state if anything changed it.
local function holdRider()
	if not ball or not alignPos then
		return
	end
	local character = Players.LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local hrp = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local target = riderTarget()
	if not humanoid or not hrp or not target then
		return
	end
	if humanoid:GetState() ~= Enum.HumanoidStateType.Physics then
		humanoid:ChangeState(Enum.HumanoidStateType.Physics)
	end
	humanoid.PlatformStand = true
	hrp.CFrame = target
	hrp.AssemblyLinearVelocity = ball.AssemblyLinearVelocity
	hrp.AssemblyAngularVelocity = Vector3.zero
	alignPos.Position = target.Position
	if alignOri then
		alignOri.CFrame = target - target.Position
	end
end

function MovementController:bind(part: BasePart?)
	ball = part
	self.enabled = part ~= nil
	if part then
		refreshFilter()
		attachRider()
		self.lastDash = -math.huge
		input:setRollingBindings(true)
	elseif state.playerState == "Rider" then
		-- Rolled up: the server welds us to the host ball. Keep the avatar limp (Physics state)
		-- and goofing around until we Burst Off.
		if alignPos then
			alignPos:Destroy()
			alignPos = nil
		end
		if alignOri then
			alignOri:Destroy()
			alignOri = nil
		end
		input:setRollingBindings(false)
		local character = Players.LocalPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			setRideStates(humanoid, true)
		end
		task.spawn(function()
			-- Wave, cheer and laugh while stuck on someone's ball: funny, not punishing.
			local cycle = { "Cheer", "Wave", "Laugh" }
			local i = 0
			while state.playerState == "Rider" do
				i += 1
				local track = animTracks[cycle[(i - 1) % #cycle + 1]]
				if track then
					pcall(function()
						track:Play(0.1)
					end)
				end
				task.wait(1.3)
			end
		end)
	else
		detachRider()
		input:setRollingBindings(false)
	end
end

local function groundCheck(pos: Vector3, radius: number): (boolean, Vector3?)
	local result = Workspace:Raycast(pos, Vector3.new(0, -(radius + math.max(0.6, radius * 0.12)), 0), rayParams)
	if result then
		return true, result.Normal
	end
	return false, nil
end

-- Mobile auto-steer: bend the input a little toward absorbable stuff ahead.
local function autoSteer(dir: Vector3, d: number): Vector3
	if input.inputType ~= "Touch" or not controllers.SettingsController.values.autoSteer then
		return dir
	end
	local world = controllers.WorldController
	if not world or not ball then
		return dir
	end
	local target = world:steerTarget(ball.Position, dir, d)
	if not target then
		return dir
	end
	local to = Vector3.new(target.X - ball.Position.X, 0, target.Z - ball.Position.Z)
	if to.Magnitude < 0.1 then
		return dir
	end
	to = to.Unit
	local maxAngle = math.rad(Tuning.Ball.AutoSteerMaxAngle)
	local angle = math.acos(math.clamp(dir:Dot(to), -1, 1))
	if angle < 1e-3 then
		return dir
	end
	local t = math.min(1, maxAngle / angle) * 0.6
	local blended = dir:Lerp(to, t)
	return if blended.Magnitude > 1e-3 then blended.Unit * dir.Magnitude else dir
end

function MovementController:hop()
	if not ball or not self.enabled then
		return
	end
	local now = os.clock()
	if now - lastHop < Tuning.Ball.HopCooldown then
		return
	end
	-- Coyote time: allow hopping just after rolling off an edge.
	if not self.grounded and now - lastGroundedAt > 0.15 then
		return
	end
	lastHop = now
	local h = hopHeight(state.diameter)
	-- Low Gravity: hops go much higher so the whole map turns into a bouncy castle.
	h *= state:mods().hopMult or 1
	local vy = math.sqrt(2 * Workspace.Gravity * h)
	local v = ball.AssemblyLinearVelocity
	ball.AssemblyLinearVelocity = Vector3.new(v.X, math.max(v.Y, 0) + vy, v.Z)
	self.Hopped:Fire(h)
	Net.send("Action", "hop")
end

function MovementController:dash()
	if not ball or not self.enabled then
		return
	end
	local now = os.clock()
	if now - self.lastDash < self:dashCooldown() then
		return
	end
	self.lastDash = now
	self.dashUntil = now + Tuning.Ball.DashDuration
	local dir = if self.moveInput.Magnitude > 0.1 then self.moveInput.Unit else self.heading
	local maxSpeed = Growth.maxSpeed(state.diameter) * speedMultiplier()
	local v = ball.AssemblyLinearVelocity
	local horizontal = Vector3.new(v.X, 0, v.Z)
	-- Redirect momentum into the dash direction, then add the boost: dashes always go where you aim.
	local boosted = dir * math.max(horizontal.Magnitude, maxSpeed * 0.6) + dir * maxSpeed * Tuning.Ball.DashBoost
	ball.AssemblyLinearVelocity = Vector3.new(boosted.X, math.max(v.Y, 0) + 4, boosted.Z)
	self.Dashed:Fire(dir)
	Net.send("Action", "dash")
end

function MovementController:applyImpulse(dv: Vector3)
	if ball and ball.Parent then
		ball.AssemblyLinearVelocity += dv
	end
end

local function updateRider()
	if not ball or not alignPos then
		return
	end
	holdRider()
	local character = Players.LocalPlayer.Character
	local scale = if character then character:GetScale() else 1
	-- Animation: run on the ball proportionally to speed; idle balance when still; flail in the air.
	local run, idle, fall = animTracks.Run, animTracks.Idle, animTracks.Fall
	local speedFrac = MovementController.speed / math.max(Growth.maxSpeed(state.diameter), 1)
	if not MovementController.grounded and fall then
		if not fall.IsPlaying then
			fall:Play(0.15)
		end
		if run and run.IsPlaying then
			run:Stop(0.15)
		end
	elseif speedFrac > 0.08 and run then
		if fall and fall.IsPlaying then
			fall:Stop(0.15)
		end
		if not run.IsPlaying then
			run:Play(0.2)
		end
		if idle and idle.IsPlaying then
			idle:Stop(0.2)
		end
		run:AdjustSpeed(math.clamp(0.6 + speedFrac * 1.6, 0.6, 2.4) / math.sqrt(math.max(scale, 0.3)))
	elseif idle then
		if fall and fall.IsPlaying then
			fall:Stop(0.15)
		end
		if run and run.IsPlaying then
			run:Stop(0.25)
		end
		if not idle.IsPlaying then
			idle:Play(0.25)
		end
	end
end

local function step(dt: number)
	if not ball or not ball.Parent or not MovementController.enabled then
		return
	end
	if ball.Anchored then
		return
	end
	local self = MovementController
	local d = state.diameter
	local r = ball.Size.X / 2
	local pos = ball.Position
	local now = os.clock()

	-- Input -> world direction using the camera's yaw (camera-relative controls).
	local raw = input:getMoveVector()
	local yaw = camera and camera.yaw or 0
	local forward = Vector3.new(-math.sin(yaw), 0, -math.cos(yaw))
	local right = Vector3.new(math.cos(yaw), 0, -math.sin(yaw))
	local desired = right * raw.X - forward * raw.Z
	if desired.Magnitude > 1 then
		desired = desired.Unit
	end
	if desired.Magnitude > 0.05 then
		desired = autoSteer(desired, d)
	end
	self.moveInput = desired

	local grounded = groundCheck(pos, r)
	if grounded then
		lastGroundedAt = now
	end
	if grounded and not wasGrounded and now - airborneSince > 0.15 then
		self.Landed:Fire(math.abs(prevHorizontal.Y))
	end
	if not grounded and wasGrounded then
		airborneSince = now
	end
	wasGrounded = grounded
	self.grounded = grounded

	local speedMult = speedMultiplier()
	local maxSpeed = Growth.maxSpeed(d) * speedMult
	local v = ball.AssemblyLinearVelocity
	local horizontal = Vector3.new(v.X, 0, v.Z)
	local dashing = now < self.dashUntil
	local nvx, nvz = MovementModel.step(v.X, v.Z, d, {
		dirX = desired.X,
		dirZ = desired.Z,
		grounded = grounded,
		dashing = dashing,
		speedMult = speedMult,
	}, dt)
	local newHorizontal = Vector3.new(nvx, 0, nvz)

	-- Bonk detection: a sudden loss of speed while pushing into something.
	local prevSpeed = prevHorizontal.Magnitude
	if prevSpeed > maxSpeed * 0.35 and horizontal.Magnitude < prevSpeed * 0.45 and now - lastBonk > 0.35 then
		local dir = Vector3.new(prevHorizontal.X, 0, prevHorizontal.Z).Unit
		local hit = Workspace:Raycast(pos, dir * (r + math.max(2, r * 0.6)), rayParams)
		if hit then
			lastBonk = now
			-- Bounce back a little: it teaches "too big!" without words.
			local bounce = -dir * prevSpeed * 0.35
			newHorizontal = newHorizontal + bounce
			self.Bonked:Fire(prevSpeed, hit.Instance, hit.Position, hit.Normal)
			if prevSpeed >= maxSpeed * Tuning.Absorb.BonkMinSpeed then
				Net.send("Action", "bonk", prevSpeed)
			end
		end
	end

	local vy = v.Y
	ball.AssemblyLinearVelocity = Vector3.new(newHorizontal.X, vy, newHorizontal.Z)
	-- Spin to match rolling without slipping (visual + keeps stuck props rolling believably).
	if grounded then
		local spin = Vector3.yAxis:Cross(newHorizontal) / math.max(r, 0.1)
		ball.AssemblyAngularVelocity = ball.AssemblyAngularVelocity:Lerp(spin, math.min(1, dt * 12))
	end

	prevHorizontal = Vector3.new(newHorizontal.X, vy, newHorizontal.Z)
	self.velocity = ball.AssemblyLinearVelocity
	self.speed = newHorizontal.Magnitude
	if self.speed > maxSpeed * 0.12 then
		self.heading = self.heading:Lerp(newHorizontal.Unit, math.min(1, dt * 10))
		if self.heading.Magnitude > 1e-3 then
			self.heading = self.heading.Unit
		end
	elseif desired.Magnitude > 0.2 then
		self.heading = self.heading:Lerp(desired.Unit, math.min(1, dt * 6)).Unit
	end
end

function MovementController:start()
	state = controllers.ClientState
	input = controllers.InputController
	camera = controllers.CameraController
	state.BallChanged:Connect(function(part)
		self:bind(part)
	end)
	if state.ball then
		self:bind(state.ball)
	end
	input.ActionPressed:Connect(function(action)
		if action == "Hop" then
			self:hop()
		elseif action == "Dash" then
			self:dash()
		elseif action == "Burst" and state.playerState == "Rider" then
			Net.send("Action", "burst")
		end
	end)
	state.PlayerStateChanged:Connect(function(newState)
		if newState == "Rider" then
			-- Make sure rider animations are loaded even if we never rolled this life.
			local character = Players.LocalPlayer.Character
			if character and not animTracks.Cheer then
				loadAnimations(character)
			end
		end
	end)
	Net.connect("Impulse", function(dv: Vector3)
		if typeof(dv) == "Vector3" then
			self:applyImpulse(dv)
		end
	end)
	Players.LocalPlayer.CharacterAdded:Connect(function()
		task.wait(0.2)
		if ball then
			refreshFilter()
			attachRider()
		end
	end)
	RunService.PreSimulation:Connect(function(dt)
		step(dt)
		holdRider()
	end)
	RunService.RenderStepped:Connect(updateRider)
	state.DiameterChanged:Connect(function()
		refreshFilter()
	end)
end

return MovementController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="104">
            <Properties>
              <string name="Name">NanaController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Builds Nana Nova (smooth meshes) at her hub anchor and gives her a cosy idle: gentle rocking,
-- head tilts, knitting needles clicking, the galaxy yarn ball slowly turning.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local NanaNova = require(Shared.Data.NanaNova)
local PropBuilder = require(Shared.PropBuilder)

local NanaController = {}

local nana: Model? = nil
local chair: Model? = nil
local base: CFrame = CFrame.new()
local parts, offsets, tags = {}, {}, {}

local function build(anchor: BasePart)
	local ground = anchor.CFrame * CFrame.new(0, -anchor.Size.Y / 2, 0)
	local chairModel = PropBuilder.buildParts(NanaNova.Chair, "NanaChair")
	chairModel:PivotTo(ground)
	chairModel.Parent = Workspace
	local nanaModel = PropBuilder.buildParts(NanaNova.Parts, "NanaNova")
	base = ground * CFrame.new(0, 4.6, -0.3)
	nanaModel:PivotTo(base)
	nanaModel.Parent = Workspace
	chair, nana = chairModel, nanaModel
	local pivot = nanaModel:GetPivot()
	for _, d in nanaModel:GetDescendants() do
		if d:IsA("BasePart") then
			table.insert(parts, d)
			table.insert(offsets, pivot:ToObjectSpace(d.CFrame))
			table.insert(tags, d:GetAttribute("Tag"))
		end
	end
end

local function animate()
	if not nana or not nana.Parent then
		return
	end
	local t = os.clock()
	local rock = math.sin(t * 1.4) * 0.05
	local root = base * CFrame.Angles(rock, 0, 0)
	local cfs = {}
	for i, part in parts do
		local offset = offsets[i]
		local tag = tags[i]
		if tag == "head" then
			offset = CFrame.new(0, 6.5, 0) * CFrame.Angles(math.sin(t * 0.7) * 0.05, math.sin(t * 0.45) * 0.12, math.sin(t * 0.9) * 0.06) * CFrame.new(0, -6.5, 0) * offset
		elseif tag == "needle" then
			offset = offset * CFrame.Angles(0, 0, math.sin(t * 7) * 0.12)
		elseif tag == "arm" then
			offset = CFrame.new(0, 0, math.sin(t * 7) * 0.06) * offset
		elseif tag == "yarn" then
			local center = CFrame.new(0, 3.6, 2.4)
			offset = center * CFrame.Angles(0, t * 0.6, 0) * center:Inverse() * offset
		end
		cfs[i] = root * offset
	end
	Workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
	if chair then
		chair:PivotTo(base * CFrame.new(0, -4.6, 0.3) * CFrame.Angles(rock, 0, 0))
	end
end

function NanaController:start()
	task.spawn(function()
		local hub = Workspace:WaitForChild("Hub", 60)
		local anchor = hub and hub:WaitForChild("NanaAnchor", 30)
		if anchor then
			build(anchor)
		end
	end)
	RunService.RenderStepped:Connect(animate)
end

return NanaController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="105">
            <Properties>
              <string name="Name">SettingsController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Player settings (audio, graphics quality, camera sensitivity, reduced motion, colorblind rarity
-- colors, mobile auto-steer). Saved to the profile when PlayerDataService is present; otherwise kept
-- for the session. Other controllers read Settings.values and listen to Changed.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)

local SettingsController = {}

SettingsController.values = {
	music = 0.6,
	sfx = 0.9,
	quality = "Auto", -- Auto | Low | Medium | High
	cameraSensitivity = 1,
	reducedMotion = false,
	colorblind = false,
	autoSteer = true,
	shake = 1,
}
SettingsController.Changed = Signal.new() -- (key, value)

local controllers

function SettingsController:init(c)
	controllers = c
end

-- 0.5 (low) .. 1.2 (high): scales render distances, particle counts and effects.
function SettingsController:qualityFactor(): number
	local q = self.values.quality
	if q == "Low" then
		return 0.55
	elseif q == "Medium" then
		return 0.8
	elseif q == "High" then
		return 1.15
	end
	-- Auto: read the engine's current graphics level (1-10) when available.
	local ok, level = pcall(function()
		return UserSettings().GameSettings.SavedQualityLevel.Value
	end)
	if ok and level and level > 0 then
		return math.clamp(0.45 + level * 0.07, 0.5, 1.15)
	end
	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		return 0.7
	end
	return 1
end

function SettingsController:set(key: string, value: any)
	if self.values[key] == value then
		return
	end
	self.values[key] = value
	self.Changed:Fire(key, value)
	Net.request("SaveSettings", { [key] = value })
end

function SettingsController:start()
	local state = controllers.ClientState
	state.ProfileChanged:Connect(function(profile)
		if profile and profile.settings then
			for k, v in profile.settings do
				if self.values[k] ~= nil and self.values[k] ~= v then
					self.values[k] = v
					self.Changed:Fire(k, v)
				end
			end
		end
	end)
end

return SettingsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="106">
            <Properties>
              <string name="Name">TuningPanel</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Studio-only live tuning panel (toggle with F2 or the 🔧 button). Change feel numbers while
-- rolling; values apply instantly on client and server. "Print" dumps the current values so they
-- can be pasted into Config/Tuning.luau. Not created in live servers.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Theme = require(Shared.Config.Theme)
local Tuning = require(Shared.Config.Tuning)
local Events = require(Shared.Data.Events)
local Ui = require(script.Parent.Parent.UI.Ui)

local TuningPanel = {}

local PARAMS = {
	{ "Ball.SpeedBase", 1 },
	{ "Ball.SpeedExponent", 0.02 },
	{ "Ball.AccelTimeSmall", 0.02 },
	{ "Ball.AccelTimeHuge", 0.05 },
	{ "Ball.TurnAssist", 0.1 },
	{ "Ball.BrakeTimeSmall", 0.1 },
	{ "Ball.BrakeTimeHuge", 0.1 },
	{ "Ball.AirControl", 0.05 },
	{ "Ball.HopPerDiameter", 0.05 },
	{ "Ball.DashBoost", 0.05 },
	{ "Ball.DashCooldown", 0.1 },
	{ "Absorb.Ratio", 0.02 },
	{ "Growth.Gain", 0.05 },
	{ "Growth.EarlyBoost", 0.1 },
	{ "Growth.EarlyScale", 1 },
	{ "Camera.BaseDistance", 0.5 },
	{ "Camera.DistancePerDiameter", 0.1 },
	{ "Camera.HeightPerDiameter", 0.05 },
	{ "Camera.FovSpeedBonus", 1 },
	{ "Camera.YawSharpness", 0.2 },
}

local function read(path: string): number
	local section, key = path:match("^(%w+)%.(%w+)$")
	return (Tuning :: any)[section][key]
end

local function write(path: string, value: number)
	local section, key = path:match("^(%w+)%.(%w+)$")
	;(Tuning :: any)[section][key] = value
end

function TuningPanel:start()
	if not RunService:IsStudio() then
		return
	end
	local gui = Ui.new("ScreenGui", {
		Name = "TuningPanel",
		ResetOnSpawn = false,
		DisplayOrder = 50,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	local panel = Ui.new("Frame", {
		Position = UDim2.new(0, 12, 0.5, -280),
		Size = UDim2.fromOffset(330, 560),
		BackgroundColor3 = Theme.Color.Panel,
		Visible = false,
		Parent = gui,
	}, { Ui.corner(Theme.Radius.Medium), Ui.stroke(3, Theme.Color.Ink), Ui.padding(10) })
	Ui.new("TextLabel", {
		Text = "🔧 Feel Tuning (Studio)",
		Size = UDim2.new(1, 0, 0, 26),
		TextScaled = true,
		TextColor3 = Theme.Color.Ink,
		Parent = panel,
	})
	local list = Ui.new("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 30),
		Size = UDim2.new(1, 0, 1, -120),
		BackgroundTransparency = 1,
		CanvasSize = UDim2.fromOffset(0, #PARAMS * 30),
		ScrollBarThickness = 6,
		Parent = panel,
	}, { Ui.new("UIListLayout", { Padding = UDim.new(0, 4) }) })
	for _, param in PARAMS do
		local path, step = param[1], param[2]
		local row = Ui.new("Frame", { Size = UDim2.new(1, -8, 0, 26), BackgroundTransparency = 1, Parent = list })
		Ui.new("TextLabel", {
			Text = path,
			Size = UDim2.new(0.55, 0, 1, 0),
			TextScaled = true,
			TextColor3 = Theme.Color.Ink,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = row,
		})
		local box = Ui.new("TextBox", {
			Text = tostring(read(path)),
			Position = UDim2.new(0.55, 26, 0, 0),
			Size = UDim2.new(0.45, -52, 1, 0),
			TextScaled = true,
			TextColor3 = Theme.Color.Ink,
			BackgroundTransparency = 0,
			BackgroundColor3 = Theme.Color.PanelAlt,
			ClearTextOnFocus = false,
			Parent = row,
		}, { Ui.corner(Theme.Radius.Small) })
		local function set(v: number)
			v = math.floor(v * 1000 + 0.5) / 1000
			write(path, v)
			box.Text = tostring(v)
			Net.request("DevTuning", { path = path, value = v })
		end
		box.FocusLost:Connect(function()
			local v = tonumber(box.Text)
			if v then
				set(v)
			else
				box.Text = tostring(read(path))
			end
		end)
		Ui.button({ text = "-", size = UDim2.fromOffset(24, 26), position = UDim2.new(0.55, 0, 0, 0), color = Theme.Color.Bad, radius = Theme.Radius.Small, parent = row, onClick = function()
			set(read(path) - step)
		end })
		Ui.button({ text = "+", size = UDim2.fromOffset(24, 26), position = UDim2.new(1, -24, 0, 0), color = Theme.Color.Good, radius = Theme.Radius.Small, parent = row, onClick = function()
			set(read(path) + step)
		end })
	end
	local actions = Ui.new("Frame", {
		Position = UDim2.new(0, 0, 1, -126),
		Size = UDim2.new(1, 0, 0, 126),
		BackgroundTransparency = 1,
		Parent = panel,
	}, { Ui.new("UIGridLayout", { CellSize = UDim2.fromOffset(100, 36), CellPadding = UDim2.fromOffset(6, 6) }) })
	local function cmd(text: string, name: string, arg: number?)
		Ui.button({ text = text, size = UDim2.fromOffset(100, 36), color = Theme.Color.Secondary, radius = Theme.Radius.Small, parent = actions, onClick = function()
			Net.request("DevCommand", { cmd = name, arg = arg })
		end })
	end
	cmd("Size ×2", "scale", 2)
	cmd("Size ×0.5", "scale", 0.5)
	cmd("Reset size", "reset")
	cmd("Final Roll", "finalroll")
	cmd("End round", "endround")
	-- Cycles through every world event so each can be tested on demand.
	local eventIndex = 0
	local eventButton
	eventButton = Ui.button({ text = "Event ▶", size = UDim2.fromOffset(100, 36), color = Theme.Color.Magic, radius = Theme.Radius.Small, parent = actions, onClick = function()
		eventIndex = eventIndex % #Events.List + 1
		local def = Events.List[eventIndex]
		Net.request("DevCommand", { cmd = "event", arg = eventIndex })
		eventButton.Text = def.icon .. " " .. def.id
	end })
	Ui.button({ text = "Print", size = UDim2.fromOffset(100, 36), color = Theme.Color.Accent, radius = Theme.Radius.Small, parent = actions, onClick = function()
		local lines = {}
		for _, param in PARAMS do
			table.insert(lines, string.format("%s = %s", param[1], tostring(read(param[1]))))
		end
		print("[Tuning]\n" .. table.concat(lines, "\n"))
	end })
	Ui.button({
		text = "🔧",
		size = UDim2.fromOffset(44, 44),
		position = UDim2.new(0, 12, 1, -60),
		color = Theme.Color.Magic,
		radius = Theme.Radius.Pill,
		parent = gui,
		onClick = function()
			panel.Visible = not panel.Visible
		end,
	})
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.F2 then
			panel.Visible = not panel.Visible
		end
	end)
end

return TuningPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="107">
            <Properties>
              <string name="Name">VFXController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Visual effects with pooled emitters (mobile friendly): absorb pops colored like the prop,
-- rarity sparkles, bonk stars + shockwave rings, landing dust, dash trails, glints on rare props,
-- wordless emoji reactions. Counts scale with the graphics quality setting.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Growth = require(Shared.Logic.Growth)
local PropLibrary = require(Shared.Logic.PropLibrary)
local Rarity = require(Shared.Config.Rarity)
local Mutations = require(Shared.Data.Mutations)

local VFXController = {}

local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local FIRE = "rbxasset://textures/particles/fire_main.dds"

local controllers
local state, settings
local folder: Folder
local emitterPool = {}
local trail: Trail? = nil
local trailAttachments = {}

function VFXController:init(c)
	controllers = c
end

local function quality(): number
	return if settings then settings:qualityFactor() else 1
end

local function getEmitter(): (Part, ParticleEmitter)
	for _, e in emitterPool do
		if not e.busy then
			e.busy = true
			task.delay(2.5, function()
				e.busy = false
			end)
			return e.part, e.emitter
		end
	end
	local part = Instance.new("Part")
	part.Name = "Emitter"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Transparency = 1
	part.Size = Vector3.one * 0.2
	part.Parent = folder
	local emitter = Instance.new("ParticleEmitter")
	emitter.Enabled = false
	emitter.Parent = part
	local e = { part = part, emitter = emitter, busy = true }
	table.insert(emitterPool, e)
	task.delay(2.5, function()
		e.busy = false
	end)
	return part, emitter
end

local function burst(pos: Vector3, opts)
	local part, emitter = getEmitter()
	part.CFrame = CFrame.new(pos)
	emitter.Texture = opts.texture or SPARKLE
	emitter.Color = ColorSequence.new(opts.color or Color3.new(1, 1, 1), opts.color2 or opts.color or Color3.new(1, 1, 1))
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, opts.size or 1), NumberSequenceKeypoint.new(1, 0) })
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, opts.alpha or 0), NumberSequenceKeypoint.new(1, 1) })
	emitter.Lifetime = NumberRange.new(opts.life or 0.35, (opts.life or 0.35) * 1.6)
	emitter.Speed = NumberRange.new((opts.speed or 10) * 0.5, opts.speed or 10)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Drag = opts.drag or 4
	emitter.Acceleration = opts.accel or Vector3.zero
	emitter.LightEmission = opts.light or 0.6
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-180, 180)
	emitter:Emit(math.max(1, math.floor((opts.count or 8) * quality())))
end

-- Absorb pop at a contact point, tinted with the prop's main color.
function VFXController:pop(pos: Vector3, color: Color3, size: number, rarityOrder: number?)
	burst(pos, { color = color, color2 = Color3.new(1, 1, 1), size = math.clamp(size * 0.35, 0.3, 14), speed = math.clamp(size * 2.5, 6, 120), count = 7, life = 0.3 })
	if rarityOrder and rarityOrder >= 3 then
		burst(pos, { color = color, color2 = Color3.fromRGB(255, 255, 255), size = math.clamp(size * 0.5, 0.6, 18), speed = math.clamp(size * 4, 10, 160), count = 10 + rarityOrder * 3, life = 0.6, light = 1 })
	end
end

function VFXController:sparkle(pos: Vector3, color: Color3, size: number, count: number?)
	burst(pos, { color = color, color2 = Color3.new(1, 1, 1), size = size, speed = size * 6, count = count or 18, life = 0.8, light = 1, drag = 3 })
end

function VFXController:poof(pos: Vector3, size: number, color: Color3?)
	burst(pos, { texture = SMOKE, color = color or Color3.fromRGB(255, 250, 240), size = math.clamp(size * 0.8, 0.6, 40), speed = math.clamp(size * 1.5, 3, 60), count = 6, life = 0.5, light = 0.2, alpha = 0.3 })
end

function VFXController:dust(pos: Vector3, size: number)
	burst(pos, { texture = SMOKE, color = Color3.fromRGB(255, 244, 228), size = math.clamp(size * 0.6, 0.4, 50), speed = math.clamp(size * 1.2, 2, 80), count = 5, life = 0.6, light = 0.1, alpha = 0.45, accel = Vector3.new(0, size * 0.5, 0) })
end

-- Expanding neon ring on the ground (bonks, bumps, landings of big balls).
function VFXController:shockwave(pos: Vector3, radius: number, color: Color3?)
	if quality() < 0.6 and radius < 8 then
		return
	end
	local ring = Instance.new("Part")
	ring.Shape = Enum.PartType.Cylinder
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.Material = Enum.Material.Neon
	ring.Color = color or Color3.fromRGB(255, 240, 200)
	ring.Transparency = 0.2
	ring.Size = Vector3.new(0.2, radius * 0.3, radius * 0.3)
	ring.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.pi / 2)
	ring.Parent = folder
	local tween = TweenService:Create(ring, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.1, radius * 2, radius * 2),
		Transparency = 1,
	})
	tween:Play()
	tween.Completed:Once(function()
		ring:Destroy()
	end)
end

-- Flaming tail for a falling meteor. Returns the instances so the caller can clean them up.
function VFXController:meteorTrail(part: BasePart, size: number): { Instance }
	local made = {}
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(size * 0.35, 0, 0)
	a0.Parent = part
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(-size * 0.35, 0, 0)
	a1.Parent = part
	local tail = Instance.new("Trail")
	tail.Attachment0 = a0
	tail.Attachment1 = a1
	tail.FaceCamera = true
	tail.Lifetime = 0.7
	tail.MinLength = 0
	tail.LightEmission = 1
	tail.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.1) })
	tail.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 250, 220)),
		ColorSequenceKeypoint.new(0.35, Color3.fromRGB(255, 160, 80)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 110, 255)),
	})
	tail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
	tail.Parent = part
	local core = Instance.new("Attachment")
	core.Parent = part
	local fire = Instance.new("ParticleEmitter")
	fire.Texture = FIRE
	fire.LightEmission = 1
	fire.Color = ColorSequence.new(Color3.fromRGB(255, 236, 170), Color3.fromRGB(255, 110, 70))
	fire.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size * 0.9), NumberSequenceKeypoint.new(1, 0) })
	fire.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	fire.Lifetime = NumberRange.new(0.25, 0.5)
	fire.Rate = math.floor(40 * quality()) + 10
	fire.Speed = NumberRange.new(0.5, 2)
	fire.LockedToPart = false
	fire.Parent = core
	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(255, 170, 110)
	glow.Range = math.clamp(size * 4, 8, 60)
	glow.Brightness = 3
	glow.Parent = part
	table.insert(made, a0)
	table.insert(made, a1)
	table.insert(made, tail)
	table.insert(made, core)
	table.insert(made, glow)
	return made
end

-- Meteor impact: flash ring, debris puff and starry sparks.
function VFXController:meteorImpact(pos: Vector3, size: number)
	self:shockwave(pos + Vector3.new(0, 0.2, 0), math.max(6, size * 3), Color3.fromRGB(255, 190, 120))
	self:dust(pos, math.max(2, size * 1.2))
	burst(pos, { texture = SPARKLE, color = Color3.fromRGB(200, 170, 255), size = math.clamp(size * 0.5, 0.5, 12), speed = math.clamp(size * 4, 10, 90), count = math.floor(14 * quality()) + 4, life = 0.8, light = 1, alpha = 0 })
end

-- Little floating emoji reaction (critters fleeing, giggling when rolled up, stickers).
function VFXController:emoji(pos: Vector3, text: string, duration: number?)
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.one * 0.2
	anchor.CFrame = CFrame.new(pos)
	anchor.Parent = folder
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(48, 48)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.MaxDistance = 250
	gui.Adornee = anchor
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Text = text
	label.TextScaled = true
	label.Parent = gui
	gui.Parent = anchor
	local d = duration or 1
	TweenService:Create(gui, TweenInfo.new(d, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { StudsOffsetWorldSpace = Vector3.new(0, 4, 0) }):Play()
	TweenService:Create(label, TweenInfo.new(d * 0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, d * 0.6), { TextTransparency = 1 }):Play()
	task.delay(d + 0.1, function()
		anchor:Destroy()
	end)
end

-- Persistent soft glint on rare / mutated props so they read as treasure from a distance.
function VFXController:attachGlint(part: BasePart, color: Color3, strong: boolean)
	if quality() < 0.55 and not strong then
		return
	end
	local att = Instance.new("Attachment")
	att.Parent = part
	local e = Instance.new("ParticleEmitter")
	e.Texture = SPARKLE
	e.Color = ColorSequence.new(color, Color3.new(1, 1, 1))
	e.LightEmission = 1
	local s = math.clamp(part.Size.Magnitude * 0.25, 0.4, 8)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.4, s), NumberSequenceKeypoint.new(1, 0) })
	e.Lifetime = NumberRange.new(0.6, 1.1)
	e.Rate = if strong then 6 else 2.5
	e.Speed = NumberRange.new(0.2, 1)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-90, 90)
	e.Parent = att
	e:Emit(1)
end

local function setupTrail()
	if trail then
		trail:Destroy()
		trail = nil
	end
	for _, a in trailAttachments do
		a:Destroy()
	end
	table.clear(trailAttachments)
	local balls = controllers.BallVisualController
	local me = balls and balls.balls[Players.LocalPlayer.UserId]
	if not me then
		return
	end
	local a0 = Instance.new("Attachment")
	a0.Parent = me.shell
	local a1 = Instance.new("Attachment")
	a1.Parent = me.shell
	trailAttachments = { a0, a1 }
	local t = Instance.new("Trail")
	t.Attachment0 = a0
	t.Attachment1 = a1
	t.Lifetime = 0.35
	t.LightEmission = 0.6
	t.FaceCamera = true
	t.Color = ColorSequence.new(Color3.new(1, 1, 1), me.color)
	t.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) })
	t.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) })
	t.Enabled = false
	t.Parent = me.shell
	trail = t
end

local function updateTrail()
	if not trail or not trail.Parent then
		return
	end
	local movement = controllers.MovementController
	local d = state.diameter
	local frac = movement.speed / math.max(Growth.maxSpeed(d), 1)
	local dashing = os.clock() < movement.dashUntil + 0.2
	trail.Enabled = dashing or frac > 1.05
	-- Attachments sit on the ball's sides, perpendicular to the heading.
	local h = movement.heading
	local side = Vector3.new(-h.Z, 0, h.X) * d * 0.42
	if #trailAttachments == 2 then
		trailAttachments[1].Position = side - Vector3.new(0, d * 0.2, 0)
		trailAttachments[2].Position = -side - Vector3.new(0, d * 0.2, 0)
	end
end

function VFXController:start()
	state = controllers.ClientState
	settings = controllers.SettingsController
	folder = Workspace:FindFirstChild("VFX") or Instance.new("Folder")
	folder.Name = "VFX"
	folder.Parent = Workspace

	local world = controllers.WorldController
	local input = controllers.InputController
	world.PropAbsorbed:Connect(function(p, absorberKey, isPrediction)
		local isLocal = absorberKey == state.player.UserId
		if isLocal and not isPrediction then
			return
		end
		local pos = Vector3.new(p.x, p.cy, p.z)
		local color = Color3.fromHex(p.def.metrics.mainColor)
		local rarity = Rarity.get(p.def.rarity)
		local mut = Mutations.get(p.mutation)
		self:pop(pos, color, p.absorbSize, rarity.order + (if mut then mut.rarityBoost else 0))
		if isLocal then
			-- Tiny tick for every pickup, a real thump for big ones.
			local rel = p.absorbSize / math.max(state.diameter * 0.62, 0.1)
			if rel > 0.35 then
				input:rumble(math.clamp(rel * 0.6, 0.15, 0.6), 0.08)
			end
		end
		if isLocal and p.critter then
			self:emoji(pos + Vector3.new(0, p.def.metrics.sy * p.eff, 0), if math.random() < 0.5 then "😆" else "🎉", 1.1)
		end
	end)
	local movement = controllers.MovementController
	movement.Bonked:Connect(function(speed, _, hitPos)
		local d = state.diameter
		local frac = math.clamp(speed / math.max(Growth.maxSpeed(d), 1), 0.3, 1.4)
		input:rumble(0.25 + frac * 0.5, 0.12)
		burst(hitPos, { color = Color3.fromRGB(255, 236, 140), size = math.clamp(d * 0.25, 0.5, 30), speed = d * 3 * frac, count = 9, life = 0.45, light = 1 })
		self:shockwave(hitPos, d * 0.9 * frac, Color3.fromRGB(255, 240, 200))
		self:emoji(hitPos + Vector3.new(0, d * 0.5, 0), "💫", 0.7)
	end)
	movement.Landed:Connect(function(impact)
		local ball = state.ball
		if ball and impact > 25 then
			local d = state.diameter
			self:dust(ball.Position - Vector3.new(0, d / 2, 0), d)
			if impact > 60 then
				self:shockwave(ball.Position - Vector3.new(0, d / 2 - 0.2, 0), d * 1.2)
			end
		end
	end)
	movement.Dashed:Connect(function()
		local ball = state.ball
		if ball then
			self:dust(ball.Position - Vector3.new(0, state.diameter / 2, 0), state.diameter * 0.8)
		end
	end)
	world.GoalUnlocked:Connect(function()
		input:rumble(0.6, 0.25)
		local ball = state.ball
		if ball then
			self:sparkle(ball.Position, Color3.fromRGB(255, 214, 64), math.clamp(state.diameter * 0.3, 0.6, 30), 30)
			self:shockwave(ball.Position - Vector3.new(0, state.diameter / 2 - 0.2, 0), state.diameter * 2, Color3.fromRGB(255, 214, 64))
		end
	end)
	Net.connect("Absorbed", function(list)
		local ball = state.ball
		if not ball then
			return
		end
		for _, a in list do
			if a.n or a.v then
				local def = PropLibrary.get(a.uid)
				if def then
					self:sparkle(ball.Position + Vector3.new(0, state.diameter * 0.6, 0), Rarity.color(def.rarity, settings.values.colorblind), math.clamp(state.diameter * 0.2, 0.5, 20), 16)
				end
			end
		end
	end)
	state.BallChanged:Connect(function(part)
		if part then
			task.delay(0.5, setupTrail)
		end
	end)
	Net.connect("BallFx", function(kind, data)
		if type(data) ~= "table" or typeof(data.position) ~= "Vector3" then
			return
		end
		local me = state.player.UserId
		if kind == "bump" then
			local size = data.size or 10
			burst(data.position, { color = Color3.fromRGB(255, 240, 180), size = math.clamp(size * 0.3, 0.6, 40), speed = size * 4, count = 16, life = 0.5, light = 1 })
			self:shockwave(data.position, size * (1 + data.power), Color3.fromRGB(255, 220, 140))
			if data.a == me or data.b == me then
				input:rumble(0.4 + data.power * 0.5, 0.18)
				if controllers.CameraController then
					controllers.CameraController:shake(0.35 + data.power * 0.5)
				end
				self:emoji(data.position + Vector3.new(0, size * 0.6, 0), "💥", 0.8)
			end
		elseif kind == "burst" then
			self:poof(data.position, 12, Color3.fromRGB(255, 200, 120))
			self:shockwave(data.position, 18, Color3.fromRGB(255, 92, 120))
			if data.userId == me and controllers.CameraController then
				controllers.CameraController:shake(0.5)
				input:rumble(0.7, 0.25)
			end
		end
	end)
	Net.connect("Announce", function(kind, data)
		if kind == "rolled" and type(data) == "table" and typeof(data.position) == "Vector3" then
			self:sparkle(data.position, Color3.fromRGB(255, 214, 64), 3, 30)
			self:emoji(data.position + Vector3.new(0, 6, 0), "😂", 1.4)
		end
	end)
	RunService.RenderStepped:Connect(updateTrail)
end

return VFXController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="108">
            <Properties>
              <string name="Name">VoteController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Between rounds everyone (bots too) votes on the next round: three map + mode combos as big
-- cards along the bottom of the screen with live vote counts. The winner is shown just before the
-- next round starts.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Theme = require(Shared.Config.Theme)
local Modes = require(Shared.Data.Modes)
local Kits = require(Shared.Data.Kits)
local Ui = require(script.Parent.Parent.UI.Ui)

local VoteController = {}

local controllers
local state
local gui: ScreenGui
local holder: Frame
local title: TextLabel
local cards = {}
local myVote: number? = nil
local shownOptions = nil

function VoteController:init(c)
	controllers = c
end

local function hex(h: string?, fallback: Color3): Color3
	if type(h) ~= "string" then
		return fallback
	end
	local ok, c = pcall(Color3.fromHex, h)
	return if ok then c else fallback
end

local function build()
	gui = Ui.new("ScreenGui", {
		Name = "VoteHud",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 6,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	Ui.autoScale(gui)
	holder = Ui.new("Frame", {
		Name = "Vote",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -14),
		Size = UDim2.fromOffset(840, 214),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	})
	title = Ui.display("🗳️ Vote for the next round!", {
		Size = UDim2.new(1, 0, 0, 36),
		Parent = holder,
	})
	local row = Ui.new("Frame", {
		Position = UDim2.fromOffset(0, 44),
		Size = UDim2.new(1, 0, 0, 170),
		BackgroundTransparency = 1,
		Parent = holder,
	}, {
		Ui.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 14),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	for i = 1, 3 do
		local card = Ui.new("TextButton", {
			Text = "",
			AutoButtonColor = false,
			Size = UDim2.fromOffset(270, 166),
			BackgroundColor3 = Theme.Color.Panel,
			LayoutOrder = i,
			Parent = row,
		}, { Ui.corner(Theme.Radius.Large), Ui.stroke(4, Theme.Color.Ink) })
		local scale = Ui.new("UIScale", { Parent = card })
		local band = Ui.new("Frame", {
			Size = UDim2.new(1, 0, 0, 58),
			BackgroundColor3 = Theme.Color.Primary,
			Parent = card,
		}, { Ui.corner(Theme.Radius.Large), Ui.gradient(Color3.new(1, 1, 1), Color3.fromRGB(215, 215, 215)) })
		Ui.new("Frame", {
			Position = UDim2.new(0, 0, 1, -20),
			Size = UDim2.new(1, 0, 0, 20),
			BackgroundColor3 = Theme.Color.Primary,
			Name = "BandFoot",
			Parent = band,
		}, { Ui.gradient(Color3.fromRGB(230, 230, 230), Color3.fromRGB(215, 215, 215)) })
		local icon = Ui.new("TextLabel", {
			Position = UDim2.fromOffset(8, 4),
			Size = UDim2.fromOffset(60, 50),
			TextScaled = true,
			Parent = band,
		})
		local modeName = Ui.new("TextLabel", {
			Position = UDim2.fromOffset(72, 6),
			Size = UDim2.new(1, -80, 0, 30),
			TextScaled = true,
			FontFace = Theme.Font.Display,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = band,
		}, { Ui.stroke(2.5, Theme.Color.Ink) })
		local mapName = Ui.new("TextLabel", {
			Position = UDim2.fromOffset(72, 34),
			Size = UDim2.new(1, -80, 0, 20),
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = band,
		}, { Ui.stroke(2, Theme.Color.Ink) })
		local desc = Ui.new("TextLabel", {
			Position = UDim2.fromOffset(12, 64),
			Size = UDim2.new(1, -24, 0, 52),
			TextWrapped = true,
			TextSize = 18,
			TextColor3 = Theme.Color.Ink,
			TextYAlignment = Enum.TextYAlignment.Top,
			Parent = card,
		})
		local votes = Ui.new("TextLabel", {
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 12, 1, -10),
			Size = UDim2.fromOffset(110, 30),
			TextScaled = true,
			FontFace = Theme.Font.Display,
			TextColor3 = Theme.Color.MagicDark,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = card,
		})
		local mine = Ui.new("TextLabel", {
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -12, 1, -10),
			Size = UDim2.fromOffset(130, 30),
			TextScaled = true,
			Text = "TAP TO VOTE",
			TextColor3 = Theme.Color.InkSoft,
			TextXAlignment = Enum.TextXAlignment.Right,
			Parent = card,
		})
		card.Activated:Connect(function()
			if not shownOptions then
				return
			end
			myVote = i
			Net.request("Vote", i)
			Ui.tween(scale, Theme.Tween.Quick, { Scale = 0.94 })
			task.delay(0.1, function()
				Ui.tween(scale, Theme.Tween.Pop, { Scale = 1 })
			end)
			if controllers.AudioController then
				controllers.AudioController:play("Click")
			end
		end)
		cards[i] = { card = card, band = band, icon = icon, modeName = modeName, mapName = mapName, desc = desc, votes = votes, mine = mine, scale = scale }
	end
end

local function update()
	local round = state.round
	local vote = round and round.vote
	local rolling = state.playerState == "Rolling" or state.playerState == "Rider"
	if not vote or rolling or round.state == "Playing" or round.state == "Launch" then
		if holder.Visible then
			holder.Visible = false
		end
		if not vote then
			shownOptions = nil
			myVote = nil
		end
		return
	end
	holder.Visible = true
	if shownOptions ~= vote.options then
		shownOptions = vote.options
		myVote = nil
		for i, option in vote.options do
			local c = cards[i]
			local mode = Modes.get(option.modeId)
			local kit = Kits.get(option.kitId)
			local color = hex(mode.color, Theme.Color.Primary)
			c.band.BackgroundColor3 = color
			c.band.BandFoot.BackgroundColor3 = color
			c.icon.Text = mode.icon
			c.modeName.Text = mode.name
			c.mapName.Text = if kit then (kit.icon or "🗺️") .. " " .. kit.name else option.kitId
			c.desc.Text = mode.description
			c.scale.Scale = 0.4
			task.delay(i * 0.08, function()
				Ui.tween(c.scale, Theme.Tween.Pop, { Scale = 1 })
			end)
		end
	end
	local best = 0
	for _, n in vote.counts do
		best = math.max(best, n)
	end
	for i, c in cards do
		local n = vote.counts[i] or 0
		c.votes.Text = "🗳️ " .. n
		local selected = myVote == i
		c.mine.Text = if selected then "✅ YOUR VOTE" else "TAP TO VOTE"
		c.mine.TextColor3 = if selected then Theme.Color.GoodDark else Theme.Color.InkSoft
		local stroke = c.card:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Color = if selected then Theme.Color.Accent elseif n == best and n > 0 then Theme.Color.Good else Theme.Color.Ink
			stroke.Thickness = if selected then 6 else 4
		end
	end
	local left = math.max(0, math.ceil((vote.endsAt or 0) - state:serverTime()))
	title.Text = "🗳️ Vote for the next round!  " .. left .. "s"
end

function VoteController:start()
	state = controllers.ClientState
	build()
	RunService.RenderStepped:Connect(update)
end

return VoteController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="109">
            <Properties>
              <string name="Name">WorldController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Client side of the world: builds prop visuals from the compact server snapshot (only near the
-- camera, distance-scaled per prop), predicts absorbs for instant feel and sends claims, animates
-- removals/loot/critters, toggles collision on props that are too big (bonk!), highlights
-- "almost" targets, and tracks the next size goal for the HUD.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)
local SpatialHash = require(Shared.Util.SpatialHash)
local PropCodec = require(Shared.Util.PropCodec)
local MathUtil = require(Shared.Util.MathUtil)
local PropLibrary = require(Shared.Logic.PropLibrary)
local Absorb = require(Shared.Logic.Absorb)
local Mutations = require(Shared.Data.Mutations)
local Rarity = require(Shared.Config.Rarity)
local Tuning = require(Shared.Config.Tuning)
local Kits = require(Shared.Data.Kits)
local PropBuilder = require(Shared.PropBuilder)

local WorldController = {}

local STARFALL = (Mutations.ById.Starfall and Mutations.ById.Starfall.index) or 5

WorldController.props = {} :: { [number]: any }
WorldController.hash = SpatialHash.new(32)
WorldController.maxRadius = 1
WorldController.kitId = nil
WorldController.roundId = 0
WorldController.landmarkId = 0
WorldController.ready = false
WorldController.templateProgress = 0
WorldController.nextGoal = nil -- { uid, needDiameter }
WorldController.bigGoal = nil
WorldController.spawnCenter = nil :: { number }?
WorldController.arenaHalf = 600

WorldController.WorldLoaded = Signal.new()
WorldController.PropAbsorbed = Signal.new() -- (prop, absorberKey, isLocalPrediction)
WorldController.GoalUnlocked = Signal.new() -- (uid)
WorldController.TemplateProgress = Signal.new() -- (done, total)
WorldController.SpawnAreaReady = Signal.new() -- fired once the props around spawn + skyline are built
WorldController.spawnAreaReady = false

local controllers
local state, settings
local folder: Folder
local myUserId = Players.LocalPlayer.UserId
local claims = {}
local arcs = {} -- loot / knock-off flight animations
local critterVisuals = {} -- id -> { model, parts, offsets, display = CFrame, target }
local highlightPool = {}
local unlockedUids = {}
local queryScratch = {}

function WorldController:init(c)
	controllers = c
end

local function propRenderDistance(p): number
	if p.landmark then
		return math.huge
	end
	local g = Tuning.Graphics
	local q = if settings then settings:qualityFactor() else 1
	return math.clamp(p.absorbSize * g.PropRenderScale, g.PropRenderMin, g.PropRenderMax) * q
end

local function makeEntry(r, loot: boolean)
	local def = PropLibrary.get(r.uid)
	if not def then
		return nil
	end
	local mut = Mutations.get(r.mutation)
	local eff = r.scale * (if mut then mut.scale else 1)
	local m = def.metrics
	local p = {
		id = r.id,
		uid = r.uid,
		def = def,
		x = r.x,
		y = r.y,
		z = r.z,
		yaw = r.yaw,
		scale = r.scale,
		eff = eff,
		mutation = r.mutation,
		absorbSize = m.absorbSize * eff,
		radius = m.contactRadius * eff,
		cy = r.y + m.centerY * eff,
		landmark = def.landmark,
		critter = def.critter ~= nil,
		loot = loot,
		activeAt = 0,
		state = "world",
		model = nil,
		collides = false,
	}
	p.renderDist = propRenderDistance(p)
	return p
end

local function placeModel(p)
	local model = p.model
	if not model then
		return
	end
	model:PivotTo(CFrame.new(p.x, p.y, p.z) * CFrame.Angles(0, p.yaw, 0))
end

local function addSparkle(p)
	local rarity = Rarity.get(p.def.rarity)
	local mut = Mutations.get(p.mutation)
	if not (rarity.sparkle or mut) or not p.model or not p.model.PrimaryPart then
		return
	end
	local vfx = controllers.VFXController
	if vfx then
		vfx:attachGlint(p.model.PrimaryPart, if mut and mut.color then Color3.fromHex(mut.color) else rarity.color, mut ~= nil)
	end
end

local function spawnVisual(p, force: boolean?): boolean
	if p.model then
		return true
	end
	if p.state ~= "world" and not force then
		return true
	end
	if not PropBuilder.hasTemplate(p.uid) then
		return false
	end
	local model = PropBuilder.create(p.uid, p.id, p.scale, p.mutation)
	if not model then
		return false
	end
	p.model = model
	local hitbox = model.PrimaryPart
	if hitbox then
		hitbox.CollisionGroup = "Props"
		hitbox.CanCollide = p.collides
		hitbox.CanQuery = p.collides
		hitbox:SetAttribute("PropId", p.id)
	end
	placeModel(p)
	model.Parent = folder
	addSparkle(p)
	if p.critter then
		WorldController:registerCritterVisual(p)
	end
	if p.landmark and controllers.HudController then
		controllers.HudController:attachLandmarkMarker(p)
	end
	return true
end

local function despawnVisual(p)
	if p.model then
		critterVisuals[p.id] = nil
		p.model:Destroy()
		p.model = nil
	end
end

function WorldController:clear()
	for _, p in self.props do
		if p.model then
			p.model:Destroy()
		end
	end
	table.clear(self.props)
	table.clear(critterVisuals)
	table.clear(arcs)
	table.clear(claims)
	table.clear(unlockedUids)
	self.hash = SpatialHash.new(32)
	self.maxRadius = 1
	self.nextGoal = nil
	self.bigGoal = nil
end

function WorldController:get(id: number)
	return self.props[id]
end

-- Prioritised background template building. Order matters for the first second of play:
--   1. the landmark and big props (the skyline you see in the spawn swoop),
--   2. everything near spawn (what you roll into immediately),
--   3. the rest, by how common it is.
-- SpawnAreaReady fires as soon as groups 1 and 2 are done.
local function prepareTemplates(kitId: string, spawnCenter)
	local counts = {}
	local nearScore = {}
	for _, p in WorldController.props do
		counts[p.uid] = (counts[p.uid] or 0) + 1
		local dx, dz = p.x - spawnCenter[1], p.z - spawnCenter[3]
		if dx * dx + dz * dz < 220 * 220 then
			nearScore[p.uid] = (nearScore[p.uid] or 0) + 1
		end
	end
	local uids = {}
	local priority = {}
	local defs: { any } = PropLibrary.ByKit[kitId] or {}
	for _, def in defs do
		table.insert(uids, def.uid)
		if def.landmark then
			priority[def.uid] = 3
		elseif def.metrics.absorbSize > 40 and (counts[def.uid] or 0) > 0 then
			priority[def.uid] = 2
		elseif (nearScore[def.uid] or 0) > 0 then
			priority[def.uid] = 1
		else
			priority[def.uid] = 0
		end
	end
	table.sort(uids, function(a, b)
		local pa, pb = priority[a], priority[b]
		if pa ~= pb then
			return pa > pb
		end
		local na, nb = nearScore[a] or 0, nearScore[b] or 0
		if na ~= nb then
			return na > nb
		end
		return (counts[a] or 0) > (counts[b] or 0)
	end)
	local needed = 0
	for _, uid in uids do
		if priority[uid] > 0 then
			needed += 1
		end
	end
	local roundId = WorldController.roundId
	PropBuilder.prepareAsync(uids, function(done, total)
		if WorldController.roundId ~= roundId then
			return
		end
		WorldController.templateProgress = done / total
		WorldController.TemplateProgress:Fire(done, total)
		if not WorldController.spawnAreaReady and done >= needed then
			WorldController.spawnAreaReady = true
			WorldController.SpawnAreaReady:Fire()
		end
	end)
	if not WorldController.spawnAreaReady and WorldController.roundId == roundId then
		WorldController.spawnAreaReady = true
		WorldController.SpawnAreaReady:Fire()
	end
end

local function onWorldLoad(info, buf)
	local self = WorldController
	self:clear()
	self.kitId = info.kitId
	self.roundId = info.roundId
	self.landmarkId = info.landmarkId
	self.ready = false
	self.spawnAreaReady = false
	self.arenaHalf = info.arenaHalf
	self.spawnCenter = info.spawnCenter
	local folderName = "ClientProps"
	folder = Workspace:FindFirstChild(folderName) or Instance.new("Folder")
	folder.Name = folderName
	folder.Parent = Workspace
	for _, r in PropCodec.decode(buf) do
		local p = makeEntry(r, false)
		if p then
			self.props[p.id] = p
			self.hash:insert(p.id, p.x, p.z, p.radius)
			self.maxRadius = math.max(self.maxRadius, p.radius)
		end
	end
	self.ready = true
	self.WorldLoaded:Fire(info)
	task.spawn(prepareTemplates, info.kitId, info.spawnCenter or { 0, 0, 0 })
	-- Warm the other kits of this tier in the background so the next round loads instantly.
	task.delay(20, function()
		for _, kit in Kits.forTier(Kits.get(info.kitId).tier) do
			if kit.id ~= info.kitId then
				local uids = {}
				for _, def in PropLibrary.ByKit[kit.id] do
					table.insert(uids, def.uid)
				end
				PropBuilder.prepareAsync(uids)
			end
		end
	end)
end

-- Fly-in or poof for a removed prop. absorberKey = ball owner's userId (0 = vanished).
local function handleRemoval(p, absorberKey: number)
	local balls = controllers.BallVisualController
	WorldController.hash:remove(p.id)
	WorldController.props[p.id] = nil
	if p.state == "predicted" then
		if absorberKey == myUserId then
			p.state = "gone"
			return
		end
		-- Someone else got it first: reassign the visual to their ball.
		if balls then
			balls:reassign(myUserId, absorberKey, p)
		end
		p.state = "gone"
		return
	end
	p.state = "gone"
	if absorberKey ~= 0 and balls and balls:hasBall(absorberKey) then
		if not p.model then
			spawnVisual(p, true)
		end
		balls:absorbProp(absorberKey, p)
		WorldController.PropAbsorbed:Fire(p, absorberKey, false)
	else
		if p.model and controllers.VFXController then
			controllers.VFXController:poof(p.model:GetPivot().Position, p.absorbSize)
		end
		despawnVisual(p)
	end
end

local function onPropsRemoved(list)
	for _, entry in list do
		local id, absorberKey = entry[1], entry[2]
		local p = WorldController.props[id]
		if p then
			handleRemoval(p, absorberKey)
		end
	end
end

local function onLoot(buf, origins, settles)
	local self = WorldController
	local now = os.clock()
	for i, r in PropCodec.decode(buf) do
		local p = makeEntry(r, true)
		if p then
			local settle = settles[i] or Tuning.World.LootSettleTime
			p.activeAt = now + settle
			self.props[p.id] = p
			self.hash:insert(p.id, p.x, p.z, p.radius)
			self.maxRadius = math.max(self.maxRadius, p.radius)
			local from = origins[i]
			if typeof(from) == "Vector3" and spawnVisual(p) and p.model then
				local to = Vector3.new(p.x, p.y, p.z)
				-- Meteors streak in on a straight line with a flaming tail instead of a lob.
				local meteor = p.mutation == STARFALL and (from - to).Magnitude > 120
				local fx = nil
				if meteor and controllers.VFXController and p.model.PrimaryPart then
					fx = controllers.VFXController:meteorTrail(p.model.PrimaryPart, math.max(1.5, p.absorbSize))
				end
				if meteor and controllers.AudioController and state.ball then
					local dist = (state.ball.Position - to).Magnitude
					if dist < 400 then
						controllers.AudioController:play("Meteor", { volume = math.clamp(1 - dist / 400, 0.15, 1) })
					end
				end
				table.insert(arcs, {
					prop = p,
					from = from,
					to = to,
					t0 = now,
					dur = settle,
					spin = (math.random() - 0.5) * (if meteor then 30 else 12),
					height = if meteor then 0 else math.max(6, (from - to).Magnitude * 0.35),
					meteor = meteor,
					fx = fx,
				})
			end
		end
	end
end

local function onMutated(list)
	for _, entry in list do
		local p = WorldController.props[entry[1]]
		if p then
			local r = { id = p.id, uid = p.uid, x = p.x, y = p.y, z = p.z, yaw = p.yaw, scale = p.scale, mutation = entry[2] }
			local updated = makeEntry(r, p.loot)
			updated.state = p.state
			despawnVisual(p)
			WorldController.props[p.id] = updated
			WorldController.hash:move(p.id, p.x, p.z, updated.radius)
			if controllers.VFXController then
				controllers.VFXController:poof(Vector3.new(p.x, p.cy, p.z), p.absorbSize, Color3.fromRGB(255, 220, 110))
			end
		end
	end
end

-- Critters ------------------------------------------------------------------------------------

function WorldController:registerCritterVisual(p)
	local model = p.model
	if not model or not model.PrimaryPart then
		return
	end
	local pivot = model:GetPivot()
	local parts, offsets, tags, pivots = {}, {}, {}, {}
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			table.insert(parts, d)
			table.insert(offsets, pivot:ToObjectSpace(d.CFrame))
			table.insert(tags, d:GetAttribute("Tag"))
			local pv = d:GetAttribute("Pivot")
			table.insert(pivots, if typeof(pv) == "Vector3" then pv * p.eff else nil)
		end
	end
	critterVisuals[p.id] = {
		prop = p,
		parts = parts,
		offsets = offsets,
		tags = tags,
		pivots = pivots,
		display = pivot,
		phase = math.random() * 10,
		state = 0,
		reactUntil = 0,
	}
end

local function onCritterState(buf)
	local now = os.clock()
	for _, r in PropCodec.decodeCritters(buf) do
		local p = WorldController.props[r.id]
		if p and p.state == "world" then
			p.x, p.y, p.z, p.yaw = r.x, r.y, r.z, r.yaw
			p.cy = r.y + p.def.metrics.centerY * p.eff
			WorldController.hash:move(p.id, p.x, p.z, p.radius)
			local vis = critterVisuals[p.id]
			if vis then
				if r.state == 2 and vis.state ~= 2 and controllers.VFXController then
					controllers.VFXController:emoji(Vector3.new(p.x, p.cy + p.def.metrics.sy * p.eff * 0.7, p.z), "❗", 0.8)
				end
				vis.state = r.state
				vis.lastUpdate = now
			end
		end
	end
end

local function animateCritters(dt: number)
	local cframes, partsList = {}, {}
	for id, vis in critterVisuals do
		local p = vis.prop
		if not p.model or p.state ~= "world" then
			critterVisuals[id] = nil
			continue
		end
		local target = CFrame.new(p.x, p.y, p.z) * CFrame.Angles(0, p.yaw, 0)
		vis.display = vis.display:Lerp(target, MathUtil.damp(10, dt))
		local moving = vis.state ~= 0
		local style = p.def.critter.style
		local speedMul = if vis.state == 2 or vis.state == 3 then 2.2 else 1
		vis.phase += dt * (if moving then 9 * speedMul else 2)
		local ph = vis.phase
		local h = p.def.metrics.sy * p.eff
		local bob, tilt, roll = 0, 0, 0
		if style == "hop" then
			bob = if moving then math.abs(math.sin(ph * 0.6)) * h * 0.5 else math.abs(math.sin(ph)) * h * 0.03
		elseif style == "waddle" then
			roll = math.sin(ph) * (if moving then 0.18 else 0.04)
			bob = math.abs(math.sin(ph)) * h * 0.06
		elseif style == "fly" then
			bob = (p.def.critter.hover or 3) * p.eff + math.sin(ph * 0.5) * h * 0.4
			roll = math.sin(ph * 0.3) * 0.1
		elseif style == "glide" then
			bob = 0
			tilt = math.sin(ph * 0.4) * 0.03
		elseif style == "wiggle" then
			roll = math.sin(ph * 1.3) * 0.12
		else -- scurry / trot / run
			bob = if moving then math.abs(math.sin(ph)) * h * 0.08 else 0
			tilt = if moving then -0.08 * speedMul else 0
		end
		local base = vis.display * CFrame.new(0, bob, 0) * CFrame.Angles(tilt, 0, roll)
		for i, part in vis.parts do
			local offset = vis.offsets[i]
			local tag = vis.tags[i]
			local pivot = vis.pivots[i]
			if pivot and (tag == "leg" or tag == "wing" or tag == "tail" or tag == "head") then
				-- Rotate about the part's own pivot point (top of a leg, root of a wing...).
				local angle = 0
				local axis = "X"
				if tag == "leg" then
					local side = if pivot.X >= 0 then 1 else -1
					local front = if pivot.Z >= 0 then 1 else -1
					angle = if moving then math.sin(ph + (side * front > 0 and 0 or math.pi)) * 0.7 else 0
				elseif tag == "wing" then
					axis = "Z"
					local side = if pivot.X >= 0 then 1 else -1
					angle = side * (if style == "fly" then math.sin(ph * 3.2) * 0.9 else (if moving then math.sin(ph * 1.5) * 0.35 else 0))
				elseif tag == "tail" then
					axis = "Y"
					angle = math.sin(ph * 0.8) * 0.35
				elseif tag == "head" then
					angle = math.sin(ph * 0.5) * 0.08
				end
				local rot = if axis == "X" then CFrame.Angles(angle, 0, 0) elseif axis == "Y" then CFrame.Angles(0, angle, 0) else CFrame.Angles(0, 0, angle)
				local pivotCF = CFrame.new(pivot)
				offset = pivotCF * rot * pivotCF:Inverse() * offset
			end
			table.insert(partsList, part)
			table.insert(cframes, base * offset)
		end
	end
	if #partsList > 0 then
		Workspace:BulkMoveTo(partsList, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

-- Arcs (loot, knocked props) -------------------------------------------------------------------

local function animateArcs()
	local now = os.clock()
	for i = #arcs, 1, -1 do
		local a = arcs[i]
		local p = a.prop
		if not p.model or p.state ~= "world" then
			if a.fx then
				for _, inst in a.fx do
					inst:Destroy()
				end
			end
			table.remove(arcs, i)
			continue
		end
		local t = math.clamp((now - a.t0) / a.dur, 0, 1)
		local pos
		if a.meteor then
			-- Accelerates into the ground like it's falling from orbit.
			pos = a.from:Lerp(a.to, t ^ 1.7)
		else
			pos = a.from:Lerp(a.to, t) + Vector3.new(0, math.sin(t * math.pi) * a.height, 0)
		end
		local spin = CFrame.Angles(a.spin * (1 - t) * t, p.yaw + a.spin * t, 0)
		p.model:PivotTo(CFrame.new(pos) * spin)
		if t >= 1 then
			placeModel(p)
			local vfx = controllers.VFXController
			if a.meteor then
				if vfx then
					vfx:meteorImpact(a.to, p.absorbSize)
				end
				if controllers.CameraController and state.ball then
					local dist = (state.ball.Position - a.to).Magnitude
					local reach = 60 + p.absorbSize * 10
					if dist < reach then
						controllers.CameraController:shake(0.5 * (1 - dist / reach))
					end
				end
			elseif vfx then
				vfx:dust(a.to, math.max(1, p.absorbSize * 0.6))
			end
			table.remove(arcs, i)
		end
		if t >= 1 and a.fx then
			for _, inst in a.fx do
				inst:Destroy()
			end
			a.fx = nil
		end
	end
end

-- Prediction + claims -------------------------------------------------------------------------

local function predict()
	if not state:isRolling() or state.round.state ~= "Playing" then
		return
	end
	local ball = state.ball
	local d = state.diameter
	local r = d / 2
	local pos = ball.Position
	local ctx = state:absorbContext()
	local now = os.clock()
	local threshold = Absorb.threshold(d, ctx)
	local vacuumMax = d * Tuning.Absorb.VacuumReach
	table.clear(queryScratch)
	WorldController.hash:query(pos.X, pos.Z, r + WorldController.maxRadius + vacuumMax + 2, queryScratch)
	for _, id in queryScratch do
		local p = WorldController.props[id]
		if p and p.state == "world" and (not p.loot or now >= p.activeAt) then
			local reach = 0.4 + Absorb.vacuumReach(d, p.absorbSize, threshold)
			if Absorb.canAbsorbProp(d, p.absorbSize, p.landmark, ctx) and Absorb.inContact(pos.X, pos.Y, pos.Z, r, p.x, p.cy, p.z, p.radius, reach) then
				if not p.model then
					spawnVisual(p, true)
				end
				p.state = "predicted"
				p.predictedAt = now
				table.insert(claims, p.id)
				local balls = controllers.BallVisualController
				if balls then
					balls:absorbProp(myUserId, p)
				end
				WorldController.PropAbsorbed:Fire(p, myUserId, true)
			end
		end
	end
	if #claims > 0 then
		local batch = {}
		for i = 1, math.min(#claims, 48) do
			batch[i] = claims[i]
		end
		for _ = 1, #batch do
			table.remove(claims, 1)
		end
		Net.send("AbsorbClaim", batch)
	end
end

-- Predictions the server never confirmed are restored (rare: e.g. another player got there first
-- and the removal is still in flight, or a claim was rejected).
local function reconcile()
	local now = os.clock()
	for _, p in WorldController.props do
		if p.state == "predicted" and now - (p.predictedAt or now) > 1.6 then
			p.state = "world"
			local balls = controllers.BallVisualController
			if balls then
				balls:release(myUserId, p)
			end
			if p.model then
				p.model:Destroy()
				p.model = nil
			end
		end
	end
end

-- Rendering, collision, highlights, goals ------------------------------------------------------

-- Collision only on props too big to absorb (they bonk); everything smaller rolls straight in.
-- Runs on every render pass AND immediately whenever the ball grows, so a prop that just became
-- absorbable never stays solid for a frame (that caused bumpy absorbs of bigger things).
local function setCollides(p, collide: boolean)
	if collide == p.collides then
		return
	end
	p.collides = collide
	local hb = p.model and p.model.PrimaryPart
	if hb then
		hb.CanCollide = collide
		hb.CanQuery = collide
	end
end

function WorldController:updateCollisions()
	local ball = state.ball
	if not ball or not ball.Parent then
		return
	end
	local d = state.diameter
	local threshold = Absorb.threshold(d, state:absorbContext())
	local final = state:isFinalRoll()
	local pos = ball.Position
	table.clear(queryScratch)
	self.hash:query(pos.X, pos.Z, d * 3 + 40, queryScratch)
	for _, id in queryScratch do
		local p = self.props[id]
		if p and p.model and p.state == "world" then
			setCollides(p, p.absorbSize > threshold or (p.landmark and not final))
		end
	end
end

local function renderPass()
	if not WorldController.ready then
		return
	end
	local cam = Workspace.CurrentCamera
	local focus = cam.CFrame.Position
	if state.ball and state.ball.Parent then
		focus = state.ball.Position
	elseif WorldController.spawnCenter and state.round.state == "Playing" then
		-- Not rolling yet: build around spawn so the area is full when the ball drops in.
		local c = WorldController.spawnCenter
		focus = Vector3.new(c[1], c[2], c[3])
	end
	local d = state.diameter
	local threshold = Absorb.threshold(d, state:absorbContext())
	local toSpawn = {}
	for _, p in WorldController.props do
		if p.state ~= "world" then
			continue
		end
		local dx, dz = p.x - focus.X, p.z - focus.Z
		local distSq = dx * dx + dz * dz
		-- Render distance grows with the ball a little so big rollers see the next feeding grounds.
		local rd = p.renderDist * (1 + math.min(d / 120, 1.5))
		if p.model then
			if distSq > (rd * 1.15) ^ 2 then
				despawnVisual(p)
			end
		elseif distSq < rd * rd then
			table.insert(toSpawn, { p = p, d = distSq })
		end
		if p.model and distSq < (d * 3 + 40) ^ 2 then
			setCollides(p, p.absorbSize > threshold or (p.landmark and not state:isFinalRoll()))
		end
	end
	table.sort(toSpawn, function(a, b)
		return a.d < b.d
	end)
	-- Build faster while waiting to spawn so the area is full the moment the ball appears.
	local budget = if state:isRolling() then 60 else 140
	for _, entry in toSpawn do
		if budget <= 0 then
			break
		end
		if spawnVisual(entry.p) then
			budget -= 1
		end
	end
end

local function updateHighlights()
	if not state:isRolling() then
		for _, h in highlightPool do
			h.Adornee = nil
		end
		return
	end
	local pos = state.ball.Position
	local d = state.diameter
	local threshold = Absorb.threshold(d, state:absorbContext())
	local candidates = {}
	table.clear(queryScratch)
	WorldController.hash:query(pos.X, pos.Z, d * 6 + 40, queryScratch)
	for _, id in queryScratch do
		local p = WorldController.props[id]
		if p and p.model and p.state == "world" and not p.landmark and p.absorbSize > threshold and p.absorbSize <= threshold * 1.3 then
			local dx, dz = p.x - pos.X, p.z - pos.Z
			table.insert(candidates, { p = p, d = dx * dx + dz * dz })
		end
	end
	table.sort(candidates, function(a, b)
		return a.d < b.d
	end)
	for i = 1, 5 do
		local h = highlightPool[i]
		if not h then
			h = Instance.new("Highlight")
			h.FillColor = Color3.fromRGB(255, 214, 64)
			h.OutlineColor = Color3.fromRGB(255, 236, 160)
			h.FillTransparency = 0.88
			h.OutlineTransparency = 0.25
			h.DepthMode = Enum.HighlightDepthMode.Occluded
			h.Parent = folder
			highlightPool[i] = h
		end
		local c = candidates[i]
		h.Adornee = if c then c.p.model else nil
		if c then
			-- Brighter the closer we are to being able to roll it up.
			local closeness = 1 - math.clamp((c.p.absorbSize - threshold) / (threshold * 0.3), 0, 1)
			h.OutlineTransparency = 0.6 - closeness * 0.45
		end
	end
end

-- Next goal = the smallest kind of thing on the map we can't roll up yet; big goal = the landmark.
local function updateGoals()
	local d = state.diameter
	local ctx = state:absorbContext()
	local threshold = Absorb.threshold(d, ctx)
	local best, bestSize = nil, math.huge
	local present = {}
	for _, p in WorldController.props do
		if p.state == "world" and not p.landmark then
			present[p.uid] = true
			if p.absorbSize > threshold and p.def.metrics.absorbSize < bestSize then
				best, bestSize = p.uid, p.def.metrics.absorbSize
			end
		end
	end
	local prev = WorldController.nextGoal
	WorldController.nextGoal = if best then { uid = best, needDiameter = bestSize / Absorb.ratio(ctx) } else nil
	if prev and (not WorldController.nextGoal or WorldController.nextGoal.uid ~= prev.uid) and not unlockedUids[prev.uid] and d >= prev.needDiameter * 0.98 then
		unlockedUids[prev.uid] = true
		WorldController.GoalUnlocked:Fire(prev.uid)
	end
	local landmark = WorldController.props[WorldController.landmarkId]
	if landmark then
		WorldController.bigGoal = { uid = landmark.uid, needDiameter = landmark.absorbSize / Tuning.Absorb.LandmarkReach, prop = landmark }
	else
		WorldController.bigGoal = nil
WorldController.spawnCenter = nil :: { number }?
WorldController.arenaHalf = 600
	end
end

-- Weighted centre of absorbable props ahead (mobile auto-steer assist).
function WorldController:steerTarget(pos: Vector3, dir: Vector3, d: number): Vector3?
	local range = d * Tuning.Ball.AutoSteerRange + 10
	local threshold = Absorb.threshold(d, state:absorbContext())
	local sum, weight = Vector3.zero, 0
	table.clear(queryScratch)
	self.hash:query(pos.X, pos.Z, range, queryScratch)
	local flatDir = Vector3.new(dir.X, 0, dir.Z)
	if flatDir.Magnitude < 1e-3 then
		return nil
	end
	flatDir = flatDir.Unit
	for _, id in queryScratch do
		local p = self.props[id]
		if p and p.state == "world" and p.absorbSize <= threshold then
			local to = Vector3.new(p.x - pos.X, 0, p.z - pos.Z)
			local dist = to.Magnitude
			if dist > 0.5 and dist < range and to.Unit:Dot(flatDir) > 0.75 then
				local w = (p.absorbSize / threshold + 0.3) / (dist + 2)
				sum += Vector3.new(p.x, 0, p.z) * w
				weight += w
			end
		end
	end
	if weight <= 0 then
		return nil
	end
	return sum / weight
end

function WorldController:start()
	state = controllers.ClientState
	settings = controllers.SettingsController
	folder = Workspace:FindFirstChild("ClientProps") or Instance.new("Folder")
	folder.Name = "ClientProps"
	folder.Parent = Workspace
	Net.connect("WorldLoad", onWorldLoad)
	Net.connect("PropsRemoved", onPropsRemoved)
	Net.connect("LootSpawned", onLoot)
	Net.connect("PropsMutated", onMutated)
	Net.connect("CritterState", onCritterState)
	RunService.Heartbeat:Connect(predict)
	RunService.RenderStepped:Connect(function(dt)
		animateArcs()
		animateCritters(dt)
	end)
	task.spawn(function()
		while true do
			task.wait(0.2)
			local ok, err = pcall(renderPass)
			if not ok then
				warn("[World] render pass: " .. tostring(err))
			end
			reconcile()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(0.3)
			pcall(updateHighlights)
			pcall(updateGoals)
		end
	end)
	state.DiameterChanged:Connect(function()
		self:updateCollisions()
	end)
	-- Ask to be dropped in only once the world around spawn is built (server falls back after 6s).
	self.SpawnAreaReady:Connect(function()
		if state.playerState ~= "Rolling" and state.round.state == "Playing" then
			Net.request("Spawn", true)
		end
	end)
	settings.Changed:Connect(function(key)
		if key == "quality" then
			for _, p in self.props do
				p.renderDist = propRenderDistance(p)
			end
		end
	end)
end

return WorldController
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="110">
          <Properties>
            <string name="Name">Panels</string>
          </Properties>
          <Item class="ModuleScript" referent="111">
            <Properties>
              <string name="Name">Common</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Small building blocks shared by the menu panels: cards, progress bars, pills, countdown text and
-- the "stars fly into your Stardust counter" celebration.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage.Shared
local Theme = require(Shared.Config.Theme)
local Format = require(Shared.Util.Format)
local Ui = require(script.Parent.Parent.UI.Ui)

local Common = {}

Common.flyTarget = nil :: GuiObject? -- set by MenuController to the Stardust pill

function Common.card(parent: Instance, props: { [string]: any }?): Frame
	local card = Ui.new("Frame", {
		BackgroundColor3 = Theme.Color.Panel,
		Size = UDim2.new(1, 0, 0, 100),
		Parent = parent,
	}, {
		Ui.corner(Theme.Radius.Medium),
		Ui.stroke(3, Theme.Color.Ink),
	})
	for k, v in (props or {}) :: { [string]: any } do
		card[k] = v
	end
	return card
end

function Common.text(parent: Instance, text: string, props: { [string]: any }?): TextLabel
	local label = Ui.new("TextLabel", {
		Text = text,
		TextScaled = true,
		TextColor3 = Theme.Color.Ink,
		FontFace = Theme.Font.Bold,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, 0, 0, 24),
		Parent = parent,
	})
	for k, v in (props or {}) :: { [string]: any } do
		label[k] = v
	end
	return label
end

-- Rounded progress bar; returns (frame, setFraction(f, text?)).
function Common.bar(parent: Instance, color: Color3, props: { [string]: any }?)
	local frame = Ui.new("Frame", {
		BackgroundColor3 = Theme.Color.PaperDim,
		Size = UDim2.new(1, 0, 0, 22),
		Parent = parent,
	}, { Ui.corner(Theme.Radius.Pill), Ui.stroke(2, Theme.Color.Ink) })
	for k, v in (props or {}) :: { [string]: any } do
		frame[k] = v
	end
	local fill = Ui.new("Frame", {
		BackgroundColor3 = color,
		Size = UDim2.fromScale(0, 1),
		Parent = frame,
	}, { Ui.corner(Theme.Radius.Pill), Ui.gradient(Color3.new(1, 1, 1), Color3.fromRGB(210, 210, 210)) })
	local label = Ui.new("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		TextScaled = true,
		Text = "",
		ZIndex = 3,
		Parent = frame,
	}, { Ui.stroke(2, Theme.Color.Ink), Ui.new("UIPadding", { PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 2) }) })
	local function set(f: number, text: string?)
		f = math.clamp(f, 0, 1)
		Ui.tween(fill, Theme.Tween.Smooth, { Size = UDim2.fromScale(math.max(f, if f > 0 then 0.06 else 0), 1) })
		fill.Visible = f > 0
		label.Text = text or ""
	end
	return frame, set
end

function Common.pill(parent: Instance, text: string, color: Color3, props: { [string]: any }?): (Frame, TextLabel)
	local pill = Ui.new("Frame", {
		BackgroundColor3 = color,
		Size = UDim2.fromOffset(150, 36),
		Parent = parent,
	}, { Ui.corner(Theme.Radius.Pill), Ui.stroke(3, Theme.Color.Ink) })
	for k, v in (props or {}) :: { [string]: any } do
		pill[k] = v
	end
	local label = Ui.new("TextLabel", {
		Text = text,
		Position = UDim2.fromOffset(10, 3),
		Size = UDim2.new(1, -20, 1, -6),
		TextScaled = true,
		FontFace = Theme.Font.Bold,
		Parent = pill,
	}, { Ui.stroke(2, Theme.Color.Ink) })
	return pill, label
end

function Common.stardust(n: number): string
	return "✨ " .. Format.commas(math.floor(n))
end

function Common.countdown(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local h = seconds // 3600
	local m = (seconds % 3600) // 60
	if h > 0 then
		return string.format("%dh %dm", h, m)
	end
	return string.format("%dm %ds", m, seconds % 60)
end

-- Sets every Text-ish child ZIndex so cards inside panels draw above the panel body.
function Common.raise(root: Instance, z: number)
	if root:IsA("GuiObject") then
		root.ZIndex = z
	end
	for _, d in root:GetDescendants() do
		if d:IsA("GuiObject") then
			d.ZIndex = z
		end
	end
end

-- A burst of ✨ that flies from a source element to the Stardust counter.
function Common.flyStars(from: GuiObject, gui: ScreenGui, count: number?)
	local target = Common.flyTarget
	if not target or not from or not from.Parent then
		return
	end
	local scale = gui:FindFirstChildOfClass("UIScale")
	local s = if scale then scale.Scale else 1
	local a = from.AbsolutePosition + from.AbsoluteSize / 2
	local b = target.AbsolutePosition + Vector2.new(24, target.AbsoluteSize.Y / 2)
	for i = 1, count or 10 do
		local star = Ui.new("TextLabel", {
			Text = "✨",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(34, 34),
			Position = UDim2.fromOffset(a.X / s, a.Y / s),
			TextScaled = true,
			ZIndex = 200,
			Parent = gui,
		})
		local spread = Vector2.new(math.random(-90, 90), math.random(-70, 40))
		local mid = (a / s) + spread
		task.delay((i - 1) * 0.04, function()
			local t1 = TweenService:Create(star, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Position = UDim2.fromOffset(mid.X, mid.Y),
			})
			t1:Play()
			t1.Completed:Wait()
			local t2 = TweenService:Create(star, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
				Position = UDim2.fromOffset(b.X / s, b.Y / s),
				Size = UDim2.fromOffset(18, 18),
			})
			t2:Play()
			t2.Completed:Wait()
			star:Destroy()
		end)
	end
end

return Common
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="112">
            <Properties>
              <string name="Name">GalaxyPanel</string>
              <string name="Source"><![CDATA[--!nonstrict
-- My Galaxy: every planet you've launched orbiting Nana's star in a live viewport. Planet size
-- follows how big your ball got; colors come from what you rolled up; winners get a golden ring.
-- Tap a planet for its card: name (rename), map, size, place, signature props, pin.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Theme = require(Shared.Config.Theme)
local Format = require(Shared.Util.Format)
local Tiers = require(Shared.Config.Tiers)
local Tuning = require(Shared.Config.Tuning)
local Kits = require(Shared.Data.Kits)
local PropLibrary = require(Shared.Logic.PropLibrary)
local PropBuilder = require(Shared.PropBuilder)
local Ui = require(script.Parent.Parent.UI.Ui)
local Panel = require(script.Parent.Parent.UI.Panel)
local Common = require(script.Parent.Common)

local GalaxyPanel = {}
GalaxyPanel.__index = GalaxyPanel

local FOV = 40
local CAM_CF = CFrame.lookAt(Vector3.new(0, 34, 62), Vector3.new(0, -2, 0))

local function hex(h: string?, fallback: Color3): Color3
	if type(h) ~= "string" then
		return fallback
	end
	local ok, c = pcall(Color3.fromHex, h)
	return if ok then c else fallback
end

local function planetRadius(d: number): number
	return math.clamp(0.9 + math.log(math.max(d, 1)) * 0.55, 1, 4.2)
end

function GalaxyPanel.new(ctx)
	local self = setmetatable({}, GalaxyPanel)
	self.ctx = ctx
	self.planets = {}
	self.selected = nil
	self.panel = Panel.new({
		name = "Galaxy",
		title = "My Galaxy",
		icon = "🌌",
		color = Theme.Color.Space,
		size = Vector2.new(960, 580),
		parent = ctx.gui,
	})
	local _, massLabel = Common.pill(self.panel.headerRight, "", Theme.Color.MagicDark, {
		Size = UDim2.fromOffset(200, 40),
		Position = UDim2.fromOffset(20, 0),
	})
	self.massLabel = massLabel
	local body = self.panel.body

	local space = Ui.new("Frame", {
		Size = UDim2.new(1, -290, 1, -54),
		BackgroundColor3 = Color3.fromRGB(18, 12, 44),
		ClipsDescendants = true,
		Parent = body,
	}, {
		Ui.corner(Theme.Radius.Medium),
		Ui.stroke(3, Theme.Color.Ink),
		Ui.gradient(Color3.fromRGB(60, 40, 120), Color3.fromRGB(12, 8, 30)),
	})
	self.space = space
	-- Twinkly backdrop stars.
	for _ = 1, 50 do
		Ui.new("Frame", {
			Position = UDim2.fromScale(math.random(), math.random()),
			Size = UDim2.fromOffset(math.random(2, 4), math.random(2, 4)),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = math.random() * 0.6,
			Parent = space,
		}, { Ui.corner(Theme.Radius.Pill) })
	end
	self.viewport = Ui.new("ViewportFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Ambient = Color3.fromRGB(150, 140, 190),
		LightColor = Color3.fromRGB(255, 240, 220),
		LightDirection = Vector3.new(0.2, -1, -0.3),
		Parent = space,
	})
	local cam = Instance.new("Camera")
	cam.FieldOfView = FOV
	cam.CFrame = CAM_CF
	cam.Parent = self.viewport
	self.viewport.CurrentCamera = cam
	self.world = Instance.new("WorldModel")
	self.world.Parent = self.viewport
	-- Nana's star.
	local star = Instance.new("Part")
	star.Shape = Enum.PartType.Ball
	star.Size = Vector3.one * 7
	star.Material = Enum.Material.Neon
	star.Color = Color3.fromRGB(255, 214, 110)
	star.Anchored = true
	star.CFrame = CFrame.new()
	star.Parent = self.world
	local halo = star:Clone()
	halo.Size = Vector3.one * 10
	halo.Transparency = 0.75
	halo.Color = Color3.fromRGB(255, 170, 90)
	halo.Parent = self.world
	self.overlay = Ui.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = space })
	self.empty = Common.text(space, "Your galaxy is empty!\nFinish a round to launch your first planet 🚀", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -20),
		Size = UDim2.new(0.9, 0, 0, 60),
		TextWrapped = true,
		TextColor3 = Theme.Color.White,
		TextXAlignment = Enum.TextXAlignment.Center,
		Visible = false,
	})

	-- Tier progress under the galaxy.
	local _, setTier = Common.bar(body, Theme.Color.Magic, {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, -6),
		Size = UDim2.new(1, -290, 0, 34),
	})
	self.setTier = setTier

	-- Planet card.
	local card = Common.card(body, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.new(0, 278, 1, 0),
	})
	self.card = card
	self.nameBox = Ui.new("TextBox", {
		Text = "",
		PlaceholderText = "Planet name",
		Position = UDim2.fromOffset(12, 12),
		Size = UDim2.new(1, -24, 0, 40),
		TextScaled = true,
		FontFace = Theme.Font.Display,
		TextColor3 = Theme.Color.Ink,
		BackgroundColor3 = Theme.Color.PaperDim,
		BackgroundTransparency = 0,
		ClearTextOnFocus = false,
		Parent = card,
	}, { Ui.corner(Theme.Radius.Small), Ui.padding(4) })
	self.nameBox.FocusLost:Connect(function(enter)
		self:rename(self.nameBox.Text, enter)
	end)
	Common.text(card, "✏️ tap the name to rename", {
		Position = UDim2.fromOffset(12, 54),
		Size = UDim2.new(1, -24, 0, 16),
		TextColor3 = Theme.Color.InkSoft,
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	self.facts = Common.text(card, "", {
		Position = UDim2.fromOffset(14, 78),
		Size = UDim2.new(1, -28, 0, 110),
		TextScaled = false,
		TextSize = 19,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
	})
	Common.text(card, "Rolled up:", {
		Position = UDim2.fromOffset(14, 196),
		Size = UDim2.new(1, -28, 0, 20),
		TextColor3 = Theme.Color.InkSoft,
	})
	local props = Ui.new("Frame", {
		Position = UDim2.fromOffset(12, 220),
		Size = UDim2.new(1, -24, 0, 170),
		BackgroundTransparency = 1,
		Parent = card,
	}, { Ui.new("UIGridLayout", { CellSize = UDim2.fromOffset(78, 78), CellPadding = UDim2.fromOffset(6, 6) }) })
	self.propSlots = {}
	for i = 1, Tuning.Galaxy.SignatureProps do
		self.propSlots[i] = Ui.viewport(nil, {
			BackgroundColor3 = Theme.Color.PaperDim,
			BackgroundTransparency = 0,
			LayoutOrder = i,
			Parent = props,
		})
		Ui.corner(Theme.Radius.Small).Parent = self.propSlots[i]
	end
	self.pinButton = Ui.button({
		text = "📌 Pin",
		size = UDim2.new(1, -24, 0, 48),
		position = UDim2.new(0, 12, 1, -58),
		color = Theme.Color.Secondary,
		parent = card,
		onClick = function()
			self:togglePin()
		end,
	})

	self.panel.Opened:Connect(function()
		self:refresh(ctx.state.profile)
	end)
	RunService.RenderStepped:Connect(function()
		if self.panel.isOpen then
			self:animate()
		end
	end)
	return self
end

function GalaxyPanel:buildPlanet(p)
	local model = Instance.new("Model")
	local radius = planetRadius(p.d)
	local main = Instance.new("Part")
	main.Shape = Enum.PartType.Ball
	main.Size = Vector3.one * radius * 2
	main.Color = hex(p.colors[1], Color3.fromRGB(140, 200, 255))
	main.Material = Enum.Material.SmoothPlastic
	main.Anchored = true
	main.Parent = model
	model.PrimaryPart = main
	-- Continents in the planet's other colors.
	for i = 2, math.min(#p.colors, 5) do
		for k = 1, 3 do
			local blob = Instance.new("Part")
			blob.Shape = Enum.PartType.Ball
			blob.Size = Vector3.one * radius * (0.7 + ((i + k) % 3) * 0.15)
			blob.Color = hex(p.colors[i], main.Color)
			blob.Material = Enum.Material.SmoothPlastic
			blob.Anchored = true
			local a = (i * 2.4 + k * 1.7 + p.id) % (math.pi * 2)
			local b = ((i * 1.3 + k * 2.1) % math.pi) - math.pi / 2
			local dir = Vector3.new(math.cos(a) * math.cos(b), math.sin(b), math.sin(a) * math.cos(b))
			blob:SetAttribute("Offset", dir * radius * 0.72)
			blob.Parent = model
		end
	end
	if p.place == 1 then
		local ring = Instance.new("Part")
		ring.Shape = Enum.PartType.Cylinder
		ring.Size = Vector3.new(0.2, radius * 3.4, radius * 3.4)
		ring.Color = Color3.fromRGB(255, 210, 90)
		ring.Material = Enum.Material.Neon
		ring.Transparency = 0.35
		ring.Anchored = true
		ring:SetAttribute("Ring", true)
		ring.Parent = model
	end
	model.Parent = self.world
	return model, radius
end

function GalaxyPanel:refresh(profile)
	if not profile then
		return
	end
	local galaxy = profile.galaxy
	self.massLabel.Text = string.format("🪐 %d  •  ⚖️ %s", galaxy.total or #galaxy.planets, Format.compact(math.floor(galaxy.mass or 0)))
	-- Next tier progress (later tiers are "coming soon" until they ship).
	local nextTier = nil
	for _, tier in Tiers.List do
		if tier.galaxyMassRequired > (galaxy.mass or 0) then
			nextTier = tier
			break
		end
	end
	if nextTier then
		local text = string.format("%s %s tier at %s mass%s", nextTier.icon, nextTier.name, Format.compact(nextTier.galaxyMassRequired), if nextTier.shipped then "" else " (coming soon!)")
		self.setTier((galaxy.mass or 0) / nextTier.galaxyMassRequired, text)
	else
		self.setTier(1, "🌌 Every tier unlocked!")
	end
	if not self.panel.isOpen then
		return
	end
	-- Rebuild planets when the list changes.
	local signature = {}
	for _, p in galaxy.planets do
		table.insert(signature, p.id .. ":" .. (p.pinned and 1 or 0) .. ":" .. p.name)
	end
	local sig = table.concat(signature, ",")
	if sig ~= self.signature then
		self.signature = sig
		for _, entry in self.planets do
			entry.model:Destroy()
			entry.button:Destroy()
		end
		table.clear(self.planets)
		local list = table.clone(galaxy.planets)
		table.sort(list, function(a, b)
			return a.t < b.t
		end)
		for i, p in list do
			local model, radius = self:buildPlanet(p)
			local button = Ui.new("TextButton", {
				Text = "",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = UDim2.fromOffset(60, 60),
				BackgroundTransparency = 1,
				Parent = self.overlay,
			})
			local label = Ui.new("TextLabel", {
				Text = (if p.pinned then "📌 " else "") .. p.name,
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.new(0.5, 0, 1, -6),
				Size = UDim2.fromOffset(140, 18),
				TextScaled = true,
				Parent = button,
			}, { Ui.stroke(2, Theme.Color.Ink) })
			local entry = {
				planet = p,
				model = model,
				radius = radius,
				button = button,
				label = label,
				orbit = 11 + i * (3.2 + radius * 0.6),
				speed = 0.35 / math.sqrt(i),
				phase = (p.id * 2.399) % (math.pi * 2),
				tilt = ((p.id * 0.61) % 0.5) - 0.25,
			}
			button.Activated:Connect(function()
				self:select(entry)
			end)
			table.insert(self.planets, entry)
		end
		self.empty.Visible = #self.planets == 0
		self.card.Visible = #self.planets > 0
		-- Keep the selection (or pick the newest planet).
		local keep = nil
		for _, entry in self.planets do
			if self.selected and entry.planet.id == self.selected.planet.id then
				keep = entry
			end
		end
		if keep or self.planets[#self.planets] then
			self:select(keep or self.planets[#self.planets])
		end
		-- Zoom out to fit the outermost orbit.
		local outer = 20
		for _, entry in self.planets do
			outer = math.max(outer, entry.orbit + entry.radius)
		end
		self.viewport.CurrentCamera.CFrame = CFrame.lookAt(Vector3.new(0, outer * 0.95, outer * 1.75), Vector3.new(0, -outer * 0.08, 0))
	end
end

function GalaxyPanel:animate()
	local t = os.clock()
	local cam = self.viewport.CurrentCamera
	local size = self.space.AbsoluteSize
	local scale = self.ctx.gui:FindFirstChildOfClass("UIScale")
	local s = if scale then scale.Scale else 1
	local tanHalf = math.tan(math.rad(FOV / 2))
	local aspect = size.X / math.max(size.Y, 1)
	for _, entry in self.planets do
		local a = entry.phase + t * entry.speed
		local pos = Vector3.new(math.cos(a) * entry.orbit, math.sin(a) * entry.orbit * entry.tilt, math.sin(a) * entry.orbit)
		local spin = CFrame.Angles(0, t * 0.6 + entry.phase, 0.2)
		local base = CFrame.new(pos) * spin
		for _, part in entry.model:GetChildren() do
			if part:IsA("BasePart") then
				local offset = part:GetAttribute("Offset")
				if offset then
					part.CFrame = base * CFrame.new(offset)
				elseif part:GetAttribute("Ring") then
					part.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.pi / 2 + 0.35)
				else
					part.CFrame = base
				end
			end
		end
		-- Project to the overlay so the planet can be tapped and labelled.
		local p = cam.CFrame:PointToObjectSpace(pos)
		if p.Z < 0 then
			local x = (p.X / -p.Z) / (tanHalf * aspect)
			local y = (p.Y / -p.Z) / tanHalf
			local px = (x + 1) / 2 * size.X / s
			local py = (1 - y) / 2 * size.Y / s
			entry.button.Position = UDim2.fromOffset(px, py)
			local onScreen = math.max(36, entry.radius * 2 / -p.Z / tanHalf * size.Y / s * 0.5)
			entry.button.Size = UDim2.fromOffset(onScreen, onScreen)
			entry.button.Visible = true
		else
			entry.button.Visible = false
		end
		entry.label.TextColor3 = if self.selected == entry then Theme.Color.Accent else Theme.Color.White
	end
end

function GalaxyPanel:select(entry)
	self.selected = entry
	local p = entry.planet
	self.nameBox.Text = p.name
	local kit = Kits.get(p.kit)
	local cm = 1
	for _, tier in Tiers.List do
		if tier.id == p.tier then
			cm = tier.cmPerStud
		end
	end
	local placeText = if p.place == 1 then "🥇 1st place!" elseif p.place == 2 then "🥈 2nd place" elseif p.place == 3 then "🥉 3rd place" else Format.ordinal(p.place) .. " place"
	self.facts.Text = string.format("📏 %s across\n🗺️ %s\n%s\n📅 %s", Format.size(p.d, cm), kit and kit.name or p.kit, placeText, os.date("%b %d, %Y", p.t))
	for i, slot in self.propSlots do
		local uid = p.props[i]
		for _, c in slot:GetChildren() do
			if c:IsA("Model") or c:IsA("Camera") then
				c:Destroy()
			end
		end
		if uid and PropLibrary.get(uid) then
			task.spawn(function()
				local template = PropBuilder.template(uid)
				if template and self.selected == entry then
					Ui.setViewportModel(slot, template)
				end
			end)
		end
	end
	self.pinButton.Text = if p.pinned then "📌 Unpin" else "📌 Pin (keeps it forever)"
end

function GalaxyPanel:rename(text: string, _enter: boolean)
	local entry = self.selected
	if not entry or text == entry.planet.name then
		return
	end
	-- Trim to the byte limit without cutting a multi-byte character (emoji) in half.
	local name = text
	if #name > Tuning.Galaxy.NameMaxLength then
		local cut = 0
		for pos in utf8.codes(name) do
			local nextPos = utf8.offset(name, 2, pos) or (#name + 1)
			if nextPos - 1 > Tuning.Galaxy.NameMaxLength then
				break
			end
			cut = nextPos - 1
		end
		name = string.sub(name, 1, cut)
	end
	local ok, result = Net.request("RenamePlanet", { id = entry.planet.id, name = name })
	if ok and type(result) == "string" then
		self.nameBox.Text = result
	else
		self.nameBox.Text = entry.planet.name
	end
end

function GalaxyPanel:togglePin()
	local entry = self.selected
	if not entry then
		return
	end
	local ok, result = Net.request("PinPlanet", entry.planet.id)
	if not ok and result == "max_pinned" then
		self.ctx.notify("📌", "You can pin up to " .. Tuning.Galaxy.MaxPinned .. " planets.", Theme.Color.Bad)
	end
end

return GalaxyPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="113">
            <Properties>
              <string name="Name">RequestsPanel</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Nana Nova's request board: Nana knitting in a viewport with a speech bubble, today's three
-- requests (easy / medium / hard) with live progress, CLAIM and one free swap, the all-three bonus
-- and a countdown to new requests. Also builds the compact in-round tracker.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Theme = require(Shared.Config.Theme)
local Format = require(Shared.Util.Format)
local Daily = require(Shared.Logic.Daily)
local NanaNova = require(Shared.Data.NanaNova)
local Cosmetics = require(Shared.Data.Cosmetics)
local PropBuilder = require(Shared.PropBuilder)
local Ui = require(script.Parent.Parent.UI.Ui)
local Panel = require(script.Parent.Parent.UI.Panel)
local Common = require(script.Parent.Common)

local RequestsPanel = {}
RequestsPanel.__index = RequestsPanel

local TIER_STARS = { "⭐", "⭐⭐", "⭐⭐⭐" }
local TIER_COLORS = { Theme.Color.Good, Theme.Color.Secondary, Theme.Color.Magic }

local function sizeFormatter(state)
	local cm = (state.round and state.round.cmPerStud) or 1
	return function(studs: number)
		return Format.size(studs, cm)
	end
end

function RequestsPanel.new(ctx)
	local self = setmetatable({}, RequestsPanel)
	self.ctx = ctx
	self.panel = Panel.new({
		name = "Requests",
		title = "Nana's Requests",
		icon = "🧶",
		color = Theme.Color.Magic,
		size = Vector2.new(860, 540),
		parent = ctx.gui,
	})
	local body = self.panel.body

	-- Header: streak chip opens the streak panel.
	local streakChip = Ui.button({
		text = "🔥 Day 0",
		size = UDim2.fromOffset(150, 44),
		position = UDim2.fromOffset(70, -2),
		color = Theme.Color.Primary,
		radius = Theme.Radius.Pill,
		parent = self.panel.headerRight,
		onClick = function()
			if ctx.openStreak then
				ctx.openStreak()
			end
		end,
	})
	self.streakChip = streakChip

	-- Left: Nana and her speech bubble.
	local left = Ui.new("Frame", {
		Size = UDim2.new(0, 250, 1, 0),
		BackgroundTransparency = 1,
		Parent = body,
	})
	self.nanaViewport = Ui.viewport(nil, {
		Size = UDim2.new(1, 0, 0, 290),
		Position = UDim2.fromOffset(0, 90),
		Parent = left,
	})
	local bubble = Common.card(left, {
		Size = UDim2.new(1, 0, 0, 80),
		BackgroundColor3 = Theme.Color.Paper,
	})
	self.bubbleText = Common.text(bubble, "", {
		Position = UDim2.fromOffset(10, 8),
		Size = UDim2.new(1, -20, 1, -16),
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	Ui.new("TextLabel", {
		Text = "▼",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 1, -6),
		Size = UDim2.fromOffset(30, 24),
		TextScaled = true,
		TextColor3 = Theme.Color.Paper,
		Parent = bubble,
	}, { Ui.stroke(2, Theme.Color.Ink) })
	self.knitLabel = Common.text(left, "", {
		Position = UDim2.new(0, 0, 1, -30),
		Size = UDim2.new(1, 0, 0, 26),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = Theme.Color.InkSoft,
	})

	-- Right: the three request cards.
	local right = Ui.new("Frame", {
		Position = UDim2.fromOffset(266, 0),
		Size = UDim2.new(1, -266, 1, 0),
		BackgroundTransparency = 1,
		Parent = body,
	})
	self.cards = {}
	for slot = 1, 3 do
		local card = Common.card(right, {
			Position = UDim2.fromOffset(0, (slot - 1) * 112),
			Size = UDim2.new(1, 0, 0, 102),
		})
		local stars = Common.text(card, TIER_STARS[slot], {
			Position = UDim2.fromOffset(12, 6),
			Size = UDim2.fromOffset(110, 22),
		})
		local icon = Ui.new("TextLabel", {
			Text = "🧺",
			Position = UDim2.fromOffset(12, 32),
			Size = UDim2.fromOffset(56, 56),
			TextScaled = true,
			Parent = card,
		})
		local desc = Common.text(card, "", {
			Position = UDim2.fromOffset(78, 30),
			Size = UDim2.new(1, -250, 0, 28),
		})
		local barFrame, setBar = Common.bar(card, TIER_COLORS[slot], {
			Position = UDim2.fromOffset(78, 64),
			Size = UDim2.new(1, -250, 0, 24),
		})
		local reward = Common.text(card, "", {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -12, 0, 6),
			Size = UDim2.fromOffset(150, 24),
			TextXAlignment = Enum.TextXAlignment.Right,
			TextColor3 = Theme.Color.AccentDark,
		})
		local action, actionHolder = Ui.button({
			text = "CLAIM",
			size = UDim2.fromOffset(150, 52),
			anchor = Vector2.new(1, 1),
			position = UDim2.new(1, -12, 1, -10),
			color = Theme.Color.Good,
			parent = card,
			onClick = function()
				self:act(slot)
			end,
		})
		local doneMark = Common.text(card, "✅ Done!", {
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -12, 1, -18),
			Size = UDim2.fromOffset(150, 34),
			TextXAlignment = Enum.TextXAlignment.Center,
			TextColor3 = Theme.Color.GoodDark,
			Visible = false,
		})
		self.cards[slot] = {
			card = card,
			stars = stars,
			icon = icon,
			desc = desc,
			bar = barFrame,
			setBar = setBar,
			reward = reward,
			action = action,
			actionHolder = actionHolder,
			doneMark = doneMark,
			mode = "none",
		}
	end
	local bonusCard = Common.card(right, {
		Position = UDim2.fromOffset(0, 336),
		Size = UDim2.new(1, 0, 0, 92),
		BackgroundColor3 = Color3.fromRGB(255, 246, 214),
	})
	self.bonusText = Common.text(bonusCard, "", {
		Position = UDim2.fromOffset(14, 8),
		Size = UDim2.new(1, -28, 0, 28),
	})
	local _, setBonus = Common.bar(bonusCard, Theme.Color.Accent, {
		Position = UDim2.fromOffset(14, 44),
		Size = UDim2.new(1, -28, 0, 22),
	})
	self.setBonus = setBonus
	self.resetText = Common.text(bonusCard, "", {
		Position = UDim2.fromOffset(14, 68),
		Size = UDim2.new(1, -28, 0, 18),
		TextColor3 = Theme.Color.InkSoft,
	})

	self.panel.Opened:Connect(function()
		self:ensureNana()
		local lines = NanaNova.Lines.request
		self.bubbleText.Text = lines[math.random(1, #lines)]
		self:refresh(ctx.state.profile)
	end)
	-- Keep the countdown ticking and Nana gently bobbing while open.
	RunService.Heartbeat:Connect(function()
		if not self.panel.isOpen then
			return
		end
		self.resetText.Text = "🌙 New requests in " .. Common.countdown(Daily.secondsUntilReset(Workspace:GetServerTimeNow()))
		local cam = self.nanaViewport.CurrentCamera
		if cam and self.nanaModel then
			local t = os.clock()
			self.nanaModel:PivotTo(CFrame.Angles(0, math.sin(t * 0.8) * 0.25, 0) * CFrame.Angles(math.sin(t * 1.6) * 0.03, 0, 0))
		end
	end)
	return self
end

function RequestsPanel:ensureNana()
	if self.nanaModel or self.buildingNana then
		return
	end
	self.buildingNana = true
	task.spawn(function()
		local model = PropBuilder.buildParts(NanaNova.Parts, "NanaPanel")
		Ui.setViewportModel(self.nanaViewport, model)
		model:Destroy()
		self.nanaModel = self.nanaViewport:FindFirstChildOfClass("Model")
		self.buildingNana = false
	end)
end

function RequestsPanel:refresh(profile)
	if not profile then
		return
	end
	local daily = profile.daily
	self.streakChip.Text = "🔥 Day " .. (profile.streak and profile.streak.count or 0)
	local fmt = sizeFormatter(self.ctx.state)
	local claimed = 0
	for slot, entry in self.cards do
		local req = daily.requests[slot]
		if not req then
			entry.card.Visible = false
			continue
		end
		entry.card.Visible = true
		entry.icon.Text = Daily.icon(req)
		entry.desc.Text = Daily.describe(req, fmt)
		entry.reward.Text = "+" .. req.reward .. " ✨"
		local progressText = if req.kind == "reachSize"
			then string.format("%s / %s", fmt(req.progress), fmt(req.target))
			else string.format("%d / %d", req.progress, req.target)
		entry.setBar(req.progress / math.max(1, req.target), progressText)
		if req.claimed then
			claimed += 1
			entry.mode = "claimed"
			entry.actionHolder.Visible = false
			entry.doneMark.Visible = true
		elseif req.done then
			entry.mode = "claim"
			entry.actionHolder.Visible = true
			entry.doneMark.Visible = false
			entry.action.Text = "CLAIM"
			entry.action.BackgroundColor3 = Theme.Color.Good
		elseif (daily.swaps or 0) < 1 then
			entry.mode = "swap"
			entry.actionHolder.Visible = true
			entry.doneMark.Visible = false
			entry.action.Text = "🔄 Swap"
			entry.action.BackgroundColor3 = Theme.Color.Secondary
		else
			entry.mode = "none"
			entry.actionHolder.Visible = false
			entry.doneMark.Visible = false
		end
	end
	if daily.bonusClaimed then
		self.bonusText.Text = "🎁 Nana's bonus collected! Come back tomorrow 💜"
		self.setBonus(1, "3 / 3")
	else
		self.bonusText.Text = "🎁 Finish all three for +" .. Daily.AllDoneBonus .. " ✨ bonus!"
		self.setBonus(claimed / 3, claimed .. " / 3")
	end
	local knit = Cosmetics.ById.Knitted
	if knit and not profile.cosmetics.shells.Knitted then
		self.knitLabel.Text = string.format("%s Knit shell: %d / %d days", knit.icon, math.min(profile.nanaDays or 0, Daily.KnitShellDays), Daily.KnitShellDays)
	else
		self.knitLabel.Text = "🧶 Thank you, dearie!"
	end
end

function RequestsPanel:act(slot: number)
	local entry = self.cards[slot]
	if entry.mode == "claim" then
		local ok, result = Net.request("ClaimRequest", slot)
		if ok and type(result) == "table" then
			Common.flyStars(entry.action, self.ctx.gui, 10)
			local lines = NanaNova.Lines.complete
			self.bubbleText.Text = lines[math.random(1, #lines)]
			local audio = self.ctx.controllers.AudioController
			if audio then
				audio:play("Coin")
			end
			if result.bonus then
				self.ctx.notify("🎁", "Nana's bonus! +" .. result.bonus .. " Stardust", Theme.Color.Accent)
			end
			if result.shell then
				self.ctx.notify("🧶", "You earned Nana's Knit shell!", Theme.Color.Magic)
			end
		end
	elseif entry.mode == "swap" then
		local ok = Net.request("SwapRequest", slot)
		if ok then
			self.bubbleText.Text = "🧶 Hmm, how about this instead?"
		end
	end
end

-- Compact live tracker for the HUD during a round: three tiny progress rows.
function RequestsPanel.buildTracker(parent: Instance, onClick: () -> ())
	local frame = Ui.new("TextButton", {
		Name = "NanaTracker",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 16, 0.56, 0),
		Size = UDim2.fromOffset(236, 112),
		BackgroundColor3 = Theme.Color.Panel,
		BackgroundTransparency = 0.12,
		AutoButtonColor = false,
		Text = "",
		Visible = false,
		Parent = parent,
	}, { Ui.corner(Theme.Radius.Medium), Ui.stroke(3, Theme.Color.Ink) })
	frame.Activated:Connect(onClick)
	Ui.new("TextLabel", {
		Text = "🧶 Nana's requests",
		Position = UDim2.fromOffset(10, 4),
		Size = UDim2.new(1, -20, 0, 20),
		TextScaled = true,
		TextColor3 = Theme.Color.Magic,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = frame,
	}, { Ui.stroke(1.5, Theme.Color.Ink) })
	local rows = {}
	for slot = 1, 3 do
		local icon = Ui.new("TextLabel", {
			Text = "",
			Position = UDim2.fromOffset(8, 28 + (slot - 1) * 27),
			Size = UDim2.fromOffset(24, 24),
			TextScaled = true,
			Parent = frame,
		})
		local _, setBar = Common.bar(frame, TIER_COLORS[slot], {
			Position = UDim2.fromOffset(38, 30 + (slot - 1) * 27),
			Size = UDim2.new(1, -48, 0, 20),
		})
		rows[slot] = { icon = icon, set = setBar }
	end
	local tracker = { frame = frame }
	function tracker.update(profile, state)
		if not profile or not profile.daily or #profile.daily.requests == 0 then
			frame.Visible = false
			return false
		end
		local fmt = sizeFormatter(state)
		local anyOpen = false
		for slot, row in rows do
			local req = profile.daily.requests[slot]
			if req then
				row.icon.Text = if req.done then "✅" else Daily.icon(req)
				local text = if req.done
					then (if req.claimed then "Done!" else "Claim in the menu!")
					elseif req.kind == "reachSize" then fmt(req.progress) .. " / " .. fmt(req.target)
					else string.format("%d / %d", req.progress, req.target)
				row.set(req.progress / math.max(1, req.target), text)
				if not req.claimed then
					anyOpen = true
				end
			end
		end
		return anyOpen
	end
	return tracker
end

return RequestsPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="114">
            <Properties>
              <string name="Name">RolledexPanel</string>
              <string name="Source"><![CDATA[--!nonstrict
-- The Rolledex: every prop in every kit. Discovered props show their model, name and rarity with a
-- row of dots for the mutation variants you've found; undiscovered ones are dark silhouettes with
-- a hint about where to look. Tabs per kit with completion, a detail pane for the selected prop.
-- Viewports are built lazily (a few per frame) so opening the book never hitches.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Theme = require(Shared.Config.Theme)
local Rarity = require(Shared.Config.Rarity)
local Format = require(Shared.Util.Format)
local Tuning = require(Shared.Config.Tuning)
local Bitset = require(Shared.Util.Bitset)
local Kits = require(Shared.Data.Kits)
local Mutations = require(Shared.Data.Mutations)
local PropLibrary = require(Shared.Logic.PropLibrary)
local PropBuilder = require(Shared.PropBuilder)
local Progression = require(Shared.Logic.Progression)
local Ui = require(script.Parent.Parent.UI.Ui)
local Panel = require(script.Parent.Parent.UI.Panel)
local Common = require(script.Parent.Common)

local RolledexPanel = {}
RolledexPanel.__index = RolledexPanel

local STRIDE = Mutations.VariantsPerProp
local CELL = 104

local function sortedDefs(kitId: string)
	local list = table.clone(PropLibrary.ByKit[kitId] or {})
	table.sort(list, function(a, b)
		local ra, rb = Rarity.get(a.rarity).order, Rarity.get(b.rarity).order
		if a.landmark ~= b.landmark then
			return b.landmark
		end
		if ra ~= rb then
			return ra < rb
		end
		return a.metrics.absorbSize < b.metrics.absorbSize
	end)
	return list
end

function RolledexPanel.new(ctx)
	local self = setmetatable({}, RolledexPanel)
	self.ctx = ctx
	self.set = Bitset.new()
	self.encoded = nil
	self.kitId = Kits.List[1].id
	self.cells = {}
	self.queue = {}
	self.selected = nil
	self.panel = Panel.new({
		name = "Rolledex",
		title = "Rolledex",
		icon = "📖",
		color = Theme.Color.Secondary,
		size = Vector2.new(960, 580),
		parent = ctx.gui,
	})
	local _, totalLabel = Common.pill(self.panel.headerRight, "0 / 0", Theme.Color.SecondaryDark, {
		Size = UDim2.fromOffset(170, 40),
		Position = UDim2.fromOffset(50, 0),
	})
	self.totalLabel = totalLabel
	local body = self.panel.body

	-- Kit tabs.
	local tabs = Ui.new("Frame", {
		Size = UDim2.new(1, 0, 0, 46),
		BackgroundTransparency = 1,
		Parent = body,
	}, { Ui.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8) }) })
	self.tabs = {}
	for i, kit in Kits.List do
		local button = Ui.button({
			text = kit.name,
			size = UDim2.fromOffset(210, 44),
			color = Theme.Color.Panel,
			radius = Theme.Radius.Pill,
			order = i,
			parent = tabs,
			onClick = function()
				self:showKit(kit.id)
			end,
		})
		self.tabs[kit.id] = button
	end
	self.tabs.__sets = Ui.button({
		text = "🧩 Sets",
		size = UDim2.fromOffset(130, 44),
		color = Theme.Color.Panel,
		radius = Theme.Radius.Pill,
		order = #Kits.List + 1,
		parent = tabs,
		onClick = function()
			self:showKit("__sets")
		end,
	})

	-- Grid (left) and detail pane (right).
	local gridHolder = Ui.new("Frame", {
		Position = UDim2.fromOffset(0, 56),
		Size = UDim2.new(1, -280, 1, -56),
		BackgroundTransparency = 1,
		Parent = body,
	})
	self.grid = Panel.scroller(gridHolder)
	self.gridLayout = Ui.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(CELL, CELL + 18),
		CellPadding = UDim2.fromOffset(8, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = self.grid,
	})
	Ui.new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 12), Parent = self.grid })

	local detail = Common.card(body, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 56),
		Size = UDim2.new(0, 268, 1, -56),
	})
	self.detailViewport = Ui.viewport(nil, {
		Position = UDim2.fromOffset(14, 10),
		Size = UDim2.new(1, -28, 0, 200),
		Parent = detail,
	})
	self.detailName = Common.text(detail, "", {
		Position = UDim2.fromOffset(14, 214),
		Size = UDim2.new(1, -28, 0, 32),
		FontFace = Theme.Font.Display,
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	self.detailRarity = Common.text(detail, "", {
		Position = UDim2.fromOffset(14, 248),
		Size = UDim2.new(1, -28, 0, 24),
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	self.detailInfo = Common.text(detail, "Pick something to take a closer look!", {
		Position = UDim2.fromOffset(14, 278),
		Size = UDim2.new(1, -28, 0, 60),
		TextWrapped = true,
		TextScaled = false,
		TextSize = 17,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = Theme.Color.InkSoft,
	})
	local variants = Ui.new("Frame", {
		Position = UDim2.new(0, 14, 1, -96),
		Size = UDim2.new(1, -28, 0, 84),
		BackgroundTransparency = 1,
		Parent = detail,
	}, { Ui.new("UIGridLayout", { CellSize = UDim2.fromOffset(52, 38), CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder }) })
	self.variantChips = {}
	for _, m in Mutations.List do
		local chip = Ui.new("TextLabel", {
			Text = "?",
			BackgroundColor3 = Theme.Color.PaperDim,
			BackgroundTransparency = 0,
			TextScaled = true,
			LayoutOrder = m.index,
			Parent = variants,
		}, { Ui.corner(Theme.Radius.Small), Ui.stroke(2, Theme.Color.Ink), Ui.padding(4) })
		self.variantChips[m.index] = { chip = chip, def = m }
	end

	self.panel.Opened:Connect(function()
		self:refresh(ctx.state.profile)
		self:showKit(self.kitId)
	end)
	-- Lazy viewport builder.
	RunService.Heartbeat:Connect(function()
		if not self.panel.isOpen or #self.queue == 0 or self.building then
			return
		end
		self.building = true
		local cell = table.remove(self.queue, 1)
		task.spawn(function()
			local template = PropBuilder.template(cell.def.uid)
			if template and cell.viewport.Parent then
				Ui.setViewportModel(cell.viewport, template, not cell.found)
			end
			cell.built = true
			self.building = false
		end)
	end)
	return self
end

function RolledexPanel:found(uid: number, mutation: number?): boolean
	return Bitset.get(self.set, uid * STRIDE + (mutation or 0))
end

function RolledexPanel:refresh(profile)
	if not profile then
		return
	end
	if profile.rolledex ~= self.encoded then
		self.encoded = profile.rolledex
		self.set = Bitset.decode(profile.rolledex)
		-- Discovery state changed: rebuild the visible grid next time it's shown.
		self.dirty = true
	end
	local total, found = 0, 0
	for _, kit in Kits.List do
		local kitFound, kitTotal = 0, 0
		for _, def in (PropLibrary.ByKit[kit.id] or {}) :: { any } do
			kitTotal += 1
			if self:found(def.uid) then
				kitFound += 1
			end
		end
		total += kitTotal
		found += kitFound
		local tab = self.tabs[kit.id]
		if tab then
			tab.Text = string.format("%s  %d%%", kit.name, math.floor(kitFound / math.max(1, kitTotal) * 100))
		end
	end
	self.foundCount = found
	self.totalLabel.Text = string.format("📖 %d / %d", found, total)
	if self.panel.isOpen and self.dirty then
		self:showKit(self.kitId)
	end
end

function RolledexPanel:showKit(kitId: string)
	if kitId == self.shownKit and not self.dirty then
		return
	end
	self.kitId = kitId
	self.shownKit = kitId
	self.dirty = false
	for id, tab in self.tabs do
		tab.BackgroundColor3 = if id == kitId then Theme.Color.Accent else Theme.Color.Panel
	end
	for _, cell in self.cells do
		cell.frame:Destroy()
	end
	for _, c in self.grid:GetChildren() do
		if c:IsA("Frame") and c.Name == "SetCard" then
			c:Destroy()
		end
	end
	table.clear(self.cells)
	table.clear(self.queue)
	if kitId == "__sets" then
		self.gridLayout.CellSize = UDim2.fromOffset(620, 128)
		self:showSets()
		return
	end
	self.gridLayout.CellSize = UDim2.fromOffset(CELL, CELL + 18)
	local colorblind = self.ctx.controllers.SettingsController and self.ctx.controllers.SettingsController.values.colorblind
	for i, def in sortedDefs(kitId) do
		local isFound = self:found(def.uid)
		local rarity = Rarity.get(def.rarity)
		local frame = Ui.new("TextButton", {
			Text = "",
			AutoButtonColor = false,
			BackgroundColor3 = if isFound then Theme.Color.Panel else Theme.Color.PaperDim,
			LayoutOrder = i,
			Parent = self.grid,
		}, {
			Ui.corner(Theme.Radius.Medium),
			Ui.stroke(if isFound then 4 else 2, if isFound then Rarity.color(def.rarity, colorblind) else Theme.Color.InkSoft),
		})
		local viewport = Ui.viewport(nil, {
			Position = UDim2.fromOffset(6, 4),
			Size = UDim2.new(1, -12, 0, CELL - 22),
			Parent = frame,
		})
		Ui.new("TextLabel", {
			Text = if isFound then def.name else "???",
			Position = UDim2.new(0, 4, 1, -36),
			Size = UDim2.new(1, -8, 0, 20),
			TextScaled = true,
			TextColor3 = Theme.Color.Ink,
			Parent = frame,
		})
		-- Variant dots.
		local dots = Ui.new("Frame", {
			Position = UDim2.new(0, 6, 1, -14),
			Size = UDim2.new(1, -12, 0, 10),
			BackgroundTransparency = 1,
			Parent = frame,
		}, { Ui.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 2) }) })
		if isFound then
			for _, m in Mutations.List do
				if m.weight > 0 or self:found(def.uid, m.index) then
					local has = self:found(def.uid, m.index)
					Ui.new("Frame", {
						Size = UDim2.fromOffset(8, 8),
						BackgroundColor3 = if has then (if m.color then Color3.fromHex(m.color) else Theme.Color.Magic) else Color3.fromRGB(210, 205, 225),
						Parent = dots,
					}, { Ui.corner(Theme.Radius.Pill) })
				end
			end
		end
		if def.landmark then
			Ui.new("TextLabel", { Text = "🗿", Position = UDim2.fromOffset(4, 2), Size = UDim2.fromOffset(22, 22), TextScaled = true, Parent = frame })
		elseif rarity.order >= 3 and isFound then
			Ui.new("TextLabel", { Text = rarity.glyph, Position = UDim2.fromOffset(4, 2), Size = UDim2.fromOffset(20, 20), TextScaled = true, TextColor3 = rarity.color, Parent = frame })
		end
		local cell = { frame = frame, viewport = viewport, def = def, found = isFound, built = false }
		frame.Activated:Connect(function()
			self:select(cell)
		end)
		table.insert(self.cells, cell)
		table.insert(self.queue, cell)
	end
	self.grid.CanvasPosition = Vector2.zero
	if self.cells[1] then
		self:select(self.cells[1])
	end
end

-- Themed sets per map: finish one for Stardust, finish a whole map for its Master title.
function RolledexPanel:showSets()
	local profile = self.ctx.state.profile
	local claimed = profile and profile.setsClaimed or {}
	local kitNames = {}
	for _, kit in Kits.List do
		kitNames[kit.id] = kit.name
	end
	local list = table.clone(Progression.sets())
	-- Nearly-finished sets first: that's what you want to chase.
	table.sort(list, function(a, b)
		local fa = Progression.setProgress(a, function(u)
			return self:found(u)
		end) / #a.uids
		local fb = Progression.setProgress(b, function(u)
			return self:found(u)
		end) / #b.uids
		local da, db = claimed[a.id] == true, claimed[b.id] == true
		if da ~= db then
			return db
		end
		if fa ~= fb then
			return fa > fb
		end
		return a.id < b.id
	end)
	for i, set in list do
		local have = Progression.setProgress(set, function(u)
			return self:found(u)
		end)
		local done = claimed[set.id] == true
		local card = Common.card(self.grid, {
			Name = "SetCard",
			LayoutOrder = i,
			BackgroundColor3 = if done then Color3.fromRGB(226, 250, 230) else Theme.Color.Panel,
		})
		Common.text(card, set.icon .. " " .. set.name, {
			Position = UDim2.fromOffset(12, 6),
			Size = UDim2.new(0.6, 0, 0, 28),
			FontFace = Theme.Font.Display,
		})
		Common.text(card, (kitNames[set.kitId] or set.kitId) .. "  •  " .. (if done then "✅ Complete!" else string.format("%d / %d  •  +%d ✨", have, #set.uids, set.reward)), {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -12, 0, 10),
			Size = UDim2.new(0.42, 0, 0, 22),
			TextXAlignment = Enum.TextXAlignment.Right,
			TextColor3 = if done then Theme.Color.GoodDark else Theme.Color.InkSoft,
		})
		local row = Ui.new("Frame", {
			Position = UDim2.fromOffset(10, 40),
			Size = UDim2.new(1, -20, 0, 80),
			BackgroundTransparency = 1,
			Parent = card,
		}, { Ui.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6) }) })
		for _, uid in set.uids do
			local def = PropLibrary.get(uid)
			if def then
				local isFound = self:found(uid)
				local chip = Ui.new("TextButton", {
					Text = "",
					AutoButtonColor = false,
					Size = UDim2.fromOffset(70, 76),
					BackgroundColor3 = if isFound then Theme.Color.PanelAlt else Theme.Color.PaperDim,
					Parent = row,
				}, { Ui.corner(Theme.Radius.Small), Ui.stroke(2, if isFound then Theme.Color.Good else Theme.Color.InkSoft) })
				local vp = Ui.viewport(nil, { Size = UDim2.new(1, 0, 1, -4), Parent = chip })
				local cell = { frame = chip, viewport = vp, def = def, found = isFound, built = false }
				chip.Activated:Connect(function()
					self:select(cell)
				end)
				table.insert(self.cells, cell)
				table.insert(self.queue, cell)
			end
		end
	end
	self.grid.CanvasPosition = Vector2.zero
	if self.cells[1] then
		self:select(self.cells[1])
	end
end

function RolledexPanel:select(cell)
	self.selected = cell
	local def = cell.def
	local rarity = Rarity.get(def.rarity)
	task.spawn(function()
		local template = PropBuilder.template(def.uid)
		if template and self.selected == cell then
			Ui.setViewportModel(self.detailViewport, template, not cell.found)
		end
	end)
	if cell.found then
		self.detailName.Text = def.name
		self.detailRarity.Text = rarity.glyph .. " " .. rarity.name
		self.detailRarity.TextColor3 = rarity.color
		local cm = (self.ctx.state.round and self.ctx.state.round.cmPerStud) or 1
		self.detailInfo.Text = "Roll it up once you're " .. Format.size(def.metrics.absorbSize / Tuning.Absorb.Ratio, cm) .. " big."
	else
		self.detailName.Text = "???"
		self.detailRarity.Text = rarity.glyph .. " " .. rarity.name
		self.detailRarity.TextColor3 = rarity.color
		self.detailInfo.Text = "💡 " .. (def.hint ~= "" and def.hint or "Keep rolling around this map!")
	end
	for index, entry in self.variantChips do
		local has = cell.found and self:found(def.uid, index)
		entry.chip.Text = if has then entry.def.name else "?"
		entry.chip.BackgroundColor3 = if has and entry.def.color then Color3.fromHex(entry.def.color) else Theme.Color.PaperDim
		entry.chip.TextColor3 = Theme.Color.Ink
	end
end

return RolledexPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="115">
            <Properties>
              <string name="Name">ShopPanel</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Stardust shop. Cores tab: each core's perk at your level, level pips, unlock / upgrade / equip.
-- Shells tab: a spinning preview ball per shell, price or how to earn it, buy / equip.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Theme = require(Shared.Config.Theme)
local Cores = require(Shared.Data.Cores)
local Cosmetics = require(Shared.Data.Cosmetics)
local Titles = require(Shared.Data.Titles)
local Ui = require(script.Parent.Parent.UI.Ui)
local Panel = require(script.Parent.Parent.UI.Panel)
local Common = require(script.Parent.Common)

local ShopPanel = {}
ShopPanel.__index = ShopPanel

local SOURCE_TEXT = {
	Streak = "🔥 Login streak",
	Nana = "🧶 Nana's gift",
	Level = "⭐ Level reward",
	Achievement = "🏅 Achievement",
	Default = "",
}

-- A little preview ball model wearing a shell.
local function shellBall(def): Model
	local model = Instance.new("Model")
	local ball = Instance.new("Part")
	ball.Shape = Enum.PartType.Ball
	ball.Size = Vector3.one * 4
	ball.Anchored = true
	ball.Color = if def.color then Color3.fromHex(def.color) else Color3.fromRGB(255, 140, 90)
	ball.Material = Enum.Material[def.material] or Enum.Material.SmoothPlastic
	ball.Reflectance = def.reflectance or 0
	ball.Parent = model
	model.PrimaryPart = ball
	-- Lumpy flecks like the real ball's surface.
	local accent = if def.color2 then Color3.fromHex(def.color2) else ball.Color:Lerp(Color3.new(1, 1, 1), 0.3)
	for i = 1, 14 do
		local phi = math.acos(1 - 2 * (i - 0.5) / 14)
		local theta = math.pi * (1 + 5 ^ 0.5) * i
		local dir = Vector3.new(math.cos(theta) * math.sin(phi), math.cos(phi), math.sin(theta) * math.sin(phi))
		local fleck = Instance.new("Part")
		fleck.Shape = Enum.PartType.Ball
		fleck.Size = Vector3.one * (0.7 + (i % 3) * 0.2)
		fleck.Anchored = true
		fleck.Color = accent
		fleck.Material = if def.neon then Enum.Material.Neon else ball.Material
		fleck.CFrame = CFrame.new(dir * 1.9)
		fleck.Parent = model
	end
	return model
end

function ShopPanel.new(ctx)
	local self = setmetatable({}, ShopPanel)
	self.ctx = ctx
	self.tab = "Cores"
	self.panel = Panel.new({
		name = "Shop",
		title = "Shop",
		icon = "🛍️",
		color = Theme.Color.Primary,
		size = Vector2.new(920, 560),
		parent = ctx.gui,
	})
	local _, balance = Common.pill(self.panel.headerRight, "✨ 0", Theme.Color.AccentDark, {
		Size = UDim2.fromOffset(170, 40),
		Position = UDim2.fromOffset(50, 0),
	})
	self.balance = balance
	local body = self.panel.body
	local tabs = Ui.new("Frame", {
		Size = UDim2.new(1, 0, 0, 46),
		BackgroundTransparency = 1,
		Parent = body,
	}, { Ui.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8) }) })
	self.tabButtons = {}
	for i, name in { "Cores", "Shells", "Titles" } do
		self.tabButtons[name] = Ui.button({
			text = if name == "Cores" then "⚙️ Cores" elseif name == "Shells" then "🎨 Shells" else "🎖️ Titles",
			size = UDim2.fromOffset(180, 44),
			color = Theme.Color.Panel,
			radius = Theme.Radius.Pill,
			order = i,
			parent = tabs,
			onClick = function()
				self.tab = name
				self:render()
			end,
		})
	end
	self.hint = Common.text(body, "", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 10),
		Size = UDim2.fromOffset(440, 26),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = Theme.Color.InkSoft,
	})
	local listHolder = Ui.new("Frame", {
		Position = UDim2.fromOffset(0, 56),
		Size = UDim2.new(1, 0, 1, -56),
		BackgroundTransparency = 1,
		Parent = body,
	})
	self.list = Panel.scroller(listHolder)
	self.layout = Ui.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(420, 150),
		CellPadding = UDim2.fromOffset(12, 12),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = self.list,
	})
	Ui.new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 12), Parent = self.list })
	self.spinners = {}
	self.panel.Opened:Connect(function()
		self:render()
	end)
	RunService.Heartbeat:Connect(function()
		if not self.panel.isOpen then
			return
		end
		local t = os.clock()
		for _, m in self.spinners do
			if m.Parent then
				m:PivotTo(CFrame.Angles(0.35, t * 0.9, 0))
			end
		end
	end)
	return self
end

function ShopPanel:refresh(profile)
	if profile then
		self.balance.Text = Common.stardust(profile.stardust)
	end
	if self.panel.isOpen then
		self:render()
	end
end

local function clear(list: Instance)
	for _, c in list:GetChildren() do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
end

function ShopPanel:buy(action: string, id: string, source: GuiObject)
	local ok, result = Net.request(action, id)
	local audio = self.ctx.controllers.AudioController
	if ok then
		if audio then
			audio:play("Purchase")
		end
		if action == "EquipCore" then
			self.ctx.notify("⚙️", "Core equipped! It kicks in on your next roll.", Theme.Color.Magic)
		end
		local vfx = source and source.Parent
		if vfx then
			local s = Ui.new("UIScale", { Scale = 1.15, Parent = source })
			Ui.tween(s, Theme.Tween.Bounce, { Scale = 1 })
			task.delay(0.6, function()
				s:Destroy()
			end)
		end
	else
		if audio then
			audio:play("Error")
		end
		if result == "afford" then
			self.ctx.notify("✨", "Not enough Stardust yet. Roll some more!", Theme.Color.Bad)
		end
	end
end

function ShopPanel:render()
	local profile = self.ctx.state.profile
	if not profile then
		return
	end
	self.balance.Text = Common.stardust(profile.stardust)
	for name, b in self.tabButtons do
		b.BackgroundColor3 = if name == self.tab then Theme.Color.Accent else Theme.Color.Panel
	end
	clear(self.list)
	table.clear(self.spinners)
	if self.tab == "Cores" then
		self.hint.Text = "Cores change how your ball handles. Upgrade your favorite!"
		self.layout.CellSize = UDim2.fromOffset(420, 150)
		self:renderCores(profile)
	elseif self.tab == "Shells" then
		self.hint.Text = "Shells change how your ball looks. Earn rare ones daily!"
		self.layout.CellSize = UDim2.fromOffset(205, 230)
		self:renderShells(profile)
	else
		self.hint.Text = "Titles show under your name. Earn them by leveling up and achievements!"
		self.layout.CellSize = UDim2.fromOffset(280, 96)
		self:renderTitles(profile)
	end
end

function ShopPanel:renderCores(profile)
	for i, def in Cores.List do
		local level = profile.cores.owned[def.id] or 0
		local equipped = profile.cores.equipped == def.id
		local color = Color3.fromHex(def.color)
		local card = Common.card(self.list, { LayoutOrder = i, BackgroundColor3 = if equipped then Color3.fromRGB(255, 248, 225) else Theme.Color.Panel })
		Ui.new("Frame", {
			Position = UDim2.fromOffset(10, 10),
			Size = UDim2.fromOffset(84, 84),
			BackgroundColor3 = color,
			Parent = card,
		}, {
			Ui.corner(Theme.Radius.Pill),
			Ui.stroke(3, Theme.Color.Ink),
			Ui.new("TextLabel", { Text = def.icon, Size = UDim2.fromScale(1, 1), TextScaled = true, BackgroundTransparency = 1 }, { Ui.padding(14) }),
		})
		Common.text(card, def.name .. (if equipped then "  ✅" else ""), {
			Position = UDim2.fromOffset(106, 8),
			Size = UDim2.new(1, -116, 0, 30),
			FontFace = Theme.Font.Display,
		})
		Common.text(card, def.description, {
			Position = UDim2.fromOffset(106, 40),
			Size = UDim2.new(1, -116, 0, 20),
			TextColor3 = Theme.Color.InkSoft,
		})
		Common.text(card, if level > 0 then "⚡ " .. def.perk(level) else "🔒 " .. def.perk(1), {
			Position = UDim2.fromOffset(106, 64),
			Size = UDim2.new(1, -116, 0, 20),
			TextColor3 = Theme.Color.GoodDark,
		})
		-- Level pips.
		local pips = Ui.new("Frame", {
			Position = UDim2.fromOffset(10, 104),
			Size = UDim2.fromOffset(84, 14),
			BackgroundTransparency = 1,
			Parent = card,
		}, { Ui.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 3) }) })
		for l = 1, def.maxLevel do
			Ui.new("Frame", {
				Size = UDim2.fromOffset(14, 14),
				BackgroundColor3 = if l <= level then color else Theme.Color.PaperDim,
				Parent = pips,
			}, { Ui.corner(Theme.Radius.Pill), Ui.stroke(1.5, Theme.Color.Ink) })
		end
		local cost = Cores.costFor(def.id, level)
		local buttons = Ui.new("Frame", {
			Position = UDim2.new(0, 106, 1, -54),
			Size = UDim2.new(1, -116, 0, 46),
			BackgroundTransparency = 1,
			Parent = card,
		}, { Ui.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right, Padding = UDim.new(0, 8) }) })
		if cost then
			local afford = profile.stardust >= cost
			local button
			button = Ui.button({
				text = (if level == 0 then "Unlock " else "Lv " .. (level + 1) .. "  ") .. Common.stardust(cost),
				size = UDim2.fromOffset(170, 44),
				color = if afford then Theme.Color.Good else Theme.Color.PaperDim,
				order = 2,
				parent = buttons,
				onClick = function()
					self:buy("BuyCore", def.id, button)
				end,
			})
		else
			Ui.button({ text = "MAX ⭐", size = UDim2.fromOffset(120, 44), color = Theme.Color.Accent, order = 2, parent = buttons })
		end
		if level > 0 and not equipped then
			local equip
			equip = Ui.button({
				text = "Equip",
				size = UDim2.fromOffset(100, 44),
				color = Theme.Color.Secondary,
				order = 1,
				parent = buttons,
				onClick = function()
					self:buy("EquipCore", def.id, equip)
				end,
			})
		end
	end
end

function ShopPanel:renderTitles(profile)
	for i, def in Titles.List do
		local owned = profile.titles and profile.titles[def.id] == true
		local equipped = profile.title == def.id
		local card = Common.card(self.list, { LayoutOrder = (if owned then 0 else 100) + i, BackgroundColor3 = if equipped then Color3.fromRGB(255, 248, 225) else Theme.Color.Panel })
		Common.text(card, "« " .. def.text .. " »", {
			Position = UDim2.fromOffset(12, 8),
			Size = UDim2.new(1, -24, 0, 30),
			FontFace = Theme.Font.Display,
			TextColor3 = if owned then Color3.fromHex(def.color) else Theme.Color.InkSoft,
		})
		Common.text(card, (if owned then "✅ " else "🔒 ") .. def.how, {
			Position = UDim2.fromOffset(12, 40),
			Size = UDim2.new(1, -130, 0, 20),
			TextColor3 = Theme.Color.InkSoft,
		})
		if owned and not equipped then
			local button
			button = Ui.button({
				text = "Wear",
				size = UDim2.fromOffset(100, 42),
				anchor = Vector2.new(1, 1),
				position = UDim2.new(1, -10, 1, -8),
				color = Theme.Color.Secondary,
				parent = card,
				onClick = function()
					self:buy("EquipTitle", def.id, button)
				end,
			})
		elseif equipped then
			Common.text(card, "Wearing", {
				AnchorPoint = Vector2.new(1, 1),
				Position = UDim2.new(1, -12, 1, -14),
				Size = UDim2.fromOffset(100, 24),
				TextColor3 = Theme.Color.GoodDark,
				TextXAlignment = Enum.TextXAlignment.Right,
			})
		end
	end
end

function ShopPanel:renderShells(profile)
	local list = table.clone(Cosmetics.Shells)
	table.sort(list, function(a, b)
		return a.order < b.order
	end)
	for i, def in list do
		local owned = profile.cosmetics.shells[def.id] == true
		local equipped = profile.cosmetics.equipped.shell == def.id
		local card = Common.card(self.list, { LayoutOrder = i, BackgroundColor3 = if equipped then Color3.fromRGB(255, 248, 225) else Theme.Color.Panel })
		local vp = Ui.viewport(nil, {
			Position = UDim2.fromOffset(10, 6),
			Size = UDim2.new(1, -20, 0, 112),
			Parent = card,
		})
		local preview = shellBall(def)
		Ui.setViewportModel(vp, preview)
		preview:Destroy()
		local spinner = vp:FindFirstChildOfClass("Model")
		if spinner then
			table.insert(self.spinners, spinner)
		end
		Common.text(card, def.icon .. " " .. def.name, {
			Position = UDim2.fromOffset(10, 120),
			Size = UDim2.new(1, -20, 0, 26),
			TextXAlignment = Enum.TextXAlignment.Center,
			FontFace = Theme.Font.Display,
		})
		Common.text(card, def.description, {
			Position = UDim2.fromOffset(10, 148),
			Size = UDim2.new(1, -20, 0, 18),
			TextXAlignment = Enum.TextXAlignment.Center,
			TextColor3 = Theme.Color.InkSoft,
		})
		local button
		if equipped then
			Ui.button({ text = "Wearing ✅", size = UDim2.new(1, -20, 0, 46), position = UDim2.new(0, 10, 1, -54), color = Theme.Color.Accent, parent = card })
		elseif owned then
			button = Ui.button({
				text = "Wear",
				size = UDim2.new(1, -20, 0, 46),
				position = UDim2.new(0, 10, 1, -54),
				color = Theme.Color.Secondary,
				parent = card,
				onClick = function()
					self:buy("EquipShell", def.id, button)
				end,
			})
		elseif def.source == "Shop" and def.cost then
			local afford = profile.stardust >= def.cost
			button = Ui.button({
				text = Common.stardust(def.cost),
				size = UDim2.new(1, -20, 0, 46),
				position = UDim2.new(0, 10, 1, -54),
				color = if afford then Theme.Color.Good else Theme.Color.PaperDim,
				parent = card,
				onClick = function()
					self:buy("BuyShell", def.id, button)
				end,
			})
		else
			Ui.button({
				text = "🔒 " .. (SOURCE_TEXT[def.source] or ""),
				size = UDim2.new(1, -20, 0, 46),
				position = UDim2.new(0, 10, 1, -54),
				color = Theme.Color.PaperDim,
				parent = card,
			})
		end
	end
end

return ShopPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="116">
            <Properties>
              <string name="Name">StreakPanel</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Daily login streak popup: a week of reward cards (claimed / today / upcoming), the big CLAIM
-- button, the next exclusive shell milestone and a countdown to tomorrow. Pops up on join when a
-- claim is waiting.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Theme = require(Shared.Config.Theme)
local Daily = require(Shared.Logic.Daily)
local Cosmetics = require(Shared.Data.Cosmetics)
local Ui = require(script.Parent.Parent.UI.Ui)
local Panel = require(script.Parent.Parent.UI.Panel)
local Common = require(script.Parent.Common)

local StreakPanel = {}
StreakPanel.__index = StreakPanel

function StreakPanel.new(ctx)
	local self = setmetatable({}, StreakPanel)
	self.ctx = ctx
	self.panel = Panel.new({
		name = "Streak",
		title = "Daily Streak",
		icon = "🔥",
		color = Theme.Color.Primary,
		size = Vector2.new(780, 440),
		parent = ctx.gui,
	})
	local body = self.panel.body
	self.subtitle = Common.text(body, "", {
		Size = UDim2.new(1, 0, 0, 30),
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	local row = Ui.new("Frame", {
		Position = UDim2.fromOffset(0, 40),
		Size = UDim2.new(1, 0, 0, 170),
		BackgroundTransparency = 1,
		Parent = body,
	}, {
		Ui.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	self.days = {}
	for i = 1, 7 do
		local card = Common.card(row, { Size = UDim2.fromOffset(96, 160), LayoutOrder = i })
		local dayLabel = Common.text(card, "Day " .. i, {
			Position = UDim2.fromOffset(6, 6),
			Size = UDim2.new(1, -12, 0, 26),
			TextXAlignment = Enum.TextXAlignment.Center,
			FontFace = Theme.Font.Display,
		})
		local icon = Ui.new("TextLabel", {
			Text = "✨",
			Position = UDim2.fromOffset(18, 36),
			Size = UDim2.fromOffset(60, 60),
			TextScaled = true,
			Parent = card,
		})
		local amount = Common.text(card, "", {
			Position = UDim2.fromOffset(6, 100),
			Size = UDim2.new(1, -12, 0, 26),
			TextXAlignment = Enum.TextXAlignment.Center,
		})
		local check = Ui.new("TextLabel", {
			Text = "✅",
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, 6, 0, -8),
			Size = UDim2.fromOffset(34, 34),
			TextScaled = true,
			Visible = false,
			Parent = card,
		})
		local glow = card:FindFirstChildOfClass("UIStroke")
		table.insert(self.days, { card = card, day = dayLabel, icon = icon, amount = amount, check = check, stroke = glow })
	end
	local claim, claimHolder = Ui.button({
		text = "CLAIM",
		size = UDim2.fromOffset(300, 70),
		anchor = Vector2.new(0.5, 0),
		position = UDim2.new(0.5, 0, 0, 222),
		color = Theme.Color.Good,
		font = Theme.Font.Display,
		parent = body,
		onClick = function()
			self:claim()
		end,
	})
	self.claimButton, self.claimHolder = claim, claimHolder
	self.footer = Common.text(body, "", {
		Position = UDim2.fromOffset(0, 304),
		Size = UDim2.new(1, 0, 0, 26),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = Theme.Color.InkSoft,
	})
	self.panel.Opened:Connect(function()
		self:refresh(ctx.state.profile)
	end)
	return self
end

function StreakPanel:refresh(profile)
	if not profile then
		return
	end
	local today = Daily.dayIndex(Workspace:GetServerTimeNow())
	local claimable, nextCount = Daily.streakStatus(profile.streak, today)
	local current = if claimable then nextCount else profile.streak.count
	-- Show the 7-day window containing the day being claimed (or just claimed).
	local weekStart = ((current - 1) // 7) * 7
	for i, entry in self.days do
		local n = weekStart + i
		local reward = Daily.streakReward(n)
		entry.day.Text = "Day " .. n
		if reward.shell then
			local shell = Cosmetics.ById[reward.shell]
			entry.icon.Text = shell and shell.icon or "🎁"
			entry.amount.Text = shell and shell.name or "Shell"
		else
			entry.icon.Text = if i == 7 then "💰" else "✨"
			entry.amount.Text = "+" .. reward.stardust
		end
		local done = n < current or (n == current and not claimable)
		local isToday = n == current and claimable
		entry.check.Visible = done
		entry.card.BackgroundColor3 = if isToday then Color3.fromRGB(255, 244, 200) elseif done then Theme.Color.PaperDim else Theme.Color.Panel
		entry.stroke.Color = if isToday then Theme.Color.AccentDark else Theme.Color.Ink
		entry.stroke.Thickness = if isToday then 5 else 3
		entry.icon.TextTransparency = if n > current then 0.45 else 0
	end
	if claimable then
		local reward = Daily.streakReward(nextCount)
		self.claimButton.Text = "CLAIM  " .. Common.stardust(reward.stardust)
		self.claimHolder.Visible = true
		self.subtitle.Text = if nextCount == 1 and profile.streak.count > 0 then "😢 Streak restarted. Let's go again!" else "🔥 Come back every day for bigger rewards!"
	else
		self.claimHolder.Visible = false
		self.subtitle.Text = "🔥 " .. profile.streak.count .. "-day streak! See you tomorrow!"
	end
	-- Next exclusive shell milestone.
	local nextShellDay, nextShell = nil, nil
	for day, shell in Daily.StreakShells do
		if day >= current and (not nextShellDay or day < nextShellDay) and not profile.cosmetics.shells[shell] then
			nextShellDay, nextShell = day, shell
		end
	end
	local reset = Common.countdown(Daily.secondsUntilReset(Workspace:GetServerTimeNow()))
	local parts = { "Best: " .. profile.streak.best .. " days", "Next day in " .. reset }
	if nextShellDay and nextShell then
		local def = Cosmetics.ById[nextShell]
		table.insert(parts, 1, string.format("Day %d: %s %s shell", nextShellDay, def.icon, def.name))
	end
	self.footer.Text = table.concat(parts, "   •   ")
end

function StreakPanel:claim()
	local ok, result = Net.request("ClaimStreak", true)
	if ok and type(result) == "table" then
		Common.flyStars(self.claimButton, self.ctx.gui, 14)
		local audio = self.ctx.controllers.AudioController
		if audio then
			audio:play("Purchase")
		end
		if result.shell then
			local def = Cosmetics.ById[result.shell]
			self.ctx.notify(def and def.icon or "🎁", "New shell unlocked: " .. (def and def.name or result.shell) .. "!", Theme.Color.Magic)
		end
		self.claimHolder.Visible = false
		self.subtitle.Text = "🔥 " .. result.count .. "-day streak! +" .. result.stardust .. " Stardust"
		task.delay(1.6, function()
			if self.panel.isOpen then
				self.panel:close()
			end
		end)
	end
end

function StreakPanel:claimable(profile): boolean
	if not profile then
		return false
	end
	local claimable = Daily.streakStatus(profile.streak, Daily.dayIndex(Workspace:GetServerTimeNow()))
	return claimable
end

return StreakPanel
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="117">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="118">
            <Properties>
              <string name="Name">Panel</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Modal panel shell shared by every menu (Nana's board, Rolledex, Shop, Galaxy, streak popup):
-- dimmed backdrop, chunky card with a colored header, icon + title, close button, bouncy open and
-- close, Escape / backdrop-click to close. Only one panel is open at a time.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Theme = require(ReplicatedStorage.Shared.Config.Theme)
local Signal = require(ReplicatedStorage.Shared.Util.Signal)
local Ui = require(script.Parent.Ui)

local Panel = {}
Panel.__index = Panel

local openPanel = nil
Panel.Opened = Signal.new() -- (panel)
Panel.Closed = Signal.new() -- (panel)

export type Options = {
	name: string,
	title: string,
	icon: string,
	color: Color3,
	size: Vector2?,
	parent: Instance,
	dismissable: boolean?, -- default true
}

function Panel.new(opts: Options)
	local self = setmetatable({}, Panel)
	self.name = opts.name
	self.isOpen = false
	self.Opened = Signal.new()
	self.Closed = Signal.new()
	local size = opts.size or Vector2.new(760, 520)
	self.backdrop = Ui.new("TextButton", {
		Name = opts.name .. "Backdrop",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Color.Overlay,
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		Visible = false,
		ZIndex = 50,
		Parent = opts.parent,
	})
	self.card = Ui.new("Frame", {
		Name = opts.name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.fromOffset(size.X, size.Y),
		BackgroundColor3 = Theme.Color.PanelAlt,
		ZIndex = 51,
		Visible = false,
		Parent = opts.parent,
	}, {
		Ui.corner(Theme.Radius.Large),
		Ui.stroke(4, Theme.Color.Ink),
		Ui.new("UISizeConstraint", { MaxSize = Vector2.new(size.X, size.Y) }),
	})
	self.scale = Ui.new("UIScale", { Scale = 1, Parent = self.card })
	local header = Ui.new("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 70),
		BackgroundColor3 = opts.color,
		ZIndex = 52,
		Parent = self.card,
	}, {
		Ui.corner(Theme.Radius.Large),
		Ui.gradient(Color3.new(1, 1, 1), Color3.fromRGB(215, 215, 215)),
	})
	-- Square off the header's bottom corners.
	Ui.new("Frame", {
		Position = UDim2.new(0, 0, 1, -24),
		Size = UDim2.new(1, 0, 0, 24),
		BackgroundColor3 = opts.color,
		ZIndex = 52,
		Parent = header,
	}, { Ui.gradient(Color3.fromRGB(235, 235, 235), Color3.fromRGB(215, 215, 215)) })
	Ui.new("TextLabel", {
		Text = opts.icon,
		Position = UDim2.fromOffset(16, 8),
		Size = UDim2.fromOffset(54, 54),
		TextScaled = true,
		ZIndex = 53,
		Parent = header,
	})
	self.titleLabel = Ui.new("TextLabel", {
		Text = opts.title,
		Position = UDim2.fromOffset(80, 10),
		Size = UDim2.new(1, -170, 0, 50),
		TextScaled = true,
		FontFace = Theme.Font.Display,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 53,
		Parent = header,
	}, { Ui.stroke(3, Theme.Color.Ink) })
	self.headerRight = Ui.new("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -78, 0, 14),
		Size = UDim2.fromOffset(220, 42),
		BackgroundTransparency = 1,
		ZIndex = 53,
		Parent = header,
	})
	local _, closeHolder = Ui.button({
		text = "✕",
		size = UDim2.fromOffset(50, 50),
		position = UDim2.new(1, -62, 0, 9),
		color = Theme.Color.Bad,
		radius = Theme.Radius.Pill,
		parent = header,
		onClick = function()
			self:close()
		end,
	})
	closeHolder.ZIndex = 54
	self.body = Ui.new("Frame", {
		Name = "Body",
		Position = UDim2.fromOffset(16, 82),
		Size = UDim2.new(1, -32, 1, -96),
		BackgroundTransparency = 1,
		ZIndex = 52,
		Parent = self.card,
	})
	if opts.dismissable ~= false then
		self.backdrop.Activated:Connect(function()
			self:close()
		end)
	end
	return self
end

function Panel:setTitle(text: string)
	self.titleLabel.Text = text
end

function Panel:open()
	if self.isOpen then
		return
	end
	if openPanel and openPanel ~= self then
		openPanel:close(true)
	end
	openPanel = self
	self.isOpen = true
	self.backdrop.Visible = true
	self.card.Visible = true
	self.backdrop.BackgroundTransparency = 1
	Ui.tween(self.backdrop, Theme.Tween.Smooth, { BackgroundTransparency = 0.45 })
	self.scale.Scale = 0.6
	Ui.tween(self.scale, Theme.Tween.Pop, { Scale = 1 })
	self.Opened:Fire()
	Panel.Opened:Fire(self)
end

function Panel:close(instant: boolean?)
	if not self.isOpen then
		return
	end
	self.isOpen = false
	if openPanel == self then
		openPanel = nil
	end
	if instant then
		self.backdrop.Visible = false
		self.card.Visible = false
	else
		Ui.tween(self.backdrop, Theme.Tween.Quick, { BackgroundTransparency = 1 })
		local t = Ui.tween(self.scale, Theme.Tween.Quick, { Scale = 0.7 })
		t.Completed:Once(function()
			if not self.isOpen then
				self.backdrop.Visible = false
				self.card.Visible = false
			end
		end)
	end
	self.Closed:Fire()
	Panel.Closed:Fire(self)
end

function Panel:toggle()
	if self.isOpen then
		self:close()
	else
		self:open()
	end
end

function Panel.current()
	return openPanel
end

function Panel.closeAll()
	if openPanel then
		openPanel:close()
	end
end

-- A vertical/grid scrolling area inside a panel body.
function Panel.scroller(parent: Instance, props: { [string]: any }?): ScrollingFrame
	local frame = Ui.new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = Theme.Color.InkSoft,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ZIndex = 52,
		Parent = parent,
	})
	for k, v in (props or {}) :: { [string]: any } do
		frame[k] = v
	end
	return frame
end

UserInputService.InputBegan:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB then
		if openPanel then
			openPanel:close()
		end
	end
end)

return Panel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="119">
            <Properties>
              <string name="Name">Ui</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Tiny declarative UI helpers for a cohesive, chunky, bouncy look (no default Roblox styling).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Theme = require(ReplicatedStorage.Shared.Config.Theme)

local Ui: any = {}

-- Ui.new("Frame", { Size = ..., [Ui.Children] = {...} })
function Ui.new(className: string, props: { [any]: any }?, children: { Instance }?): any
	local inst: any = Instance.new(className)
	if inst:IsA("GuiObject") then
		(inst :: any).BorderSizePixel = 0
	end
	if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
		(inst :: any).FontFace = Theme.Font.Bold;
		(inst :: any).TextColor3 = Theme.Color.White;
		(inst :: any).BackgroundTransparency = 1
	end
	local parent = nil
	local propList: { [any]: any } = props or {}
	for k, v in propList do
		if k == "Parent" then
			parent = v
		else
			(inst :: any)[k] = v
		end
	end
	local childList: { Instance } = children or {}
	for _, child in childList do
		child.Parent = inst
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function Ui.corner(radius: UDim?): UICorner
	return Ui.new("UICorner", { CornerRadius = radius or Theme.Radius.Medium }) :: UICorner
end

function Ui.stroke(thickness: number?, color: Color3?, mode: Enum.ApplyStrokeMode?): UIStroke
	return Ui.new("UIStroke", {
		Thickness = thickness or Theme.Stroke.Medium,
		Color = color or Theme.Color.Ink,
		ApplyStrokeMode = mode or Enum.ApplyStrokeMode.Contextual,
		LineJoinMode = Enum.LineJoinMode.Round,
	}) :: UIStroke
end

function Ui.padding(px: number): UIPadding
	local u = UDim.new(0, px)
	return Ui.new("UIPadding", { PaddingTop = u, PaddingBottom = u, PaddingLeft = u, PaddingRight = u }) :: UIPadding
end

function Ui.gradient(top: Color3, bottom: Color3, rotation: number?): UIGradient
	return Ui.new("UIGradient", { Color = ColorSequence.new(top, bottom), Rotation = rotation or 90 }) :: UIGradient
end

function Ui.tween(inst: Instance, info: TweenInfo, goals: { [string]: any }): Tween
	local t = TweenService:Create(inst, info, goals)
	t:Play()
	return t
end

-- Big outlined display text (size counter, banners).
function Ui.display(text: string, props: { [any]: any }?): TextLabel
	local label = Ui.new("TextLabel", {
		Text = text,
		FontFace = Theme.Font.Display,
		TextScaled = true,
		TextColor3 = Theme.Color.White,
	}, { Ui.stroke(4, Theme.Color.Ink) })
	local propList: { [any]: any } = props or {}
	for k, v in propList do
		label[k] = v
	end
	return label
end

-- Chunky button with a drop "lip", hover/press bounce and click sound.
function Ui.button(props: { [string]: any }): (TextButton, Frame)
	local color = props.color or Theme.Color.Primary
	local h, s, v = color:ToHSV()
	local dark = Color3.fromHSV(h, math.min(1, s * 1.1), v * 0.72)
	local holder = Ui.new("Frame", {
		Name = props.name or "Button",
		Size = props.size or UDim2.fromOffset(160, 64),
		Position = props.position or UDim2.new(),
		AnchorPoint = props.anchor or Vector2.zero,
		BackgroundColor3 = dark,
		LayoutOrder = props.order or 0,
		Parent = props.parent,
	}, {
		Ui.corner(props.radius or Theme.Radius.Medium),
	}) :: Frame
	local scale = Ui.new("UIScale", { Parent = holder }) :: UIScale
	local button = Ui.new("TextButton", {
		Name = "Face",
		Size = UDim2.new(1, 0, 1, -6),
		BackgroundColor3 = color,
		BackgroundTransparency = 0,
		AutoButtonColor = false,
		Text = props.text or "",
		TextScaled = true,
		FontFace = props.font or Theme.Font.Bold,
		Parent = holder,
	}, {
		Ui.corner(props.radius or Theme.Radius.Medium),
		Ui.stroke(3, Theme.Color.Ink, Enum.ApplyStrokeMode.Border),
		Ui.new("UIGradient", {
			Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(225, 225, 225)),
			Rotation = 90,
		}),
		Ui.new("UIPadding", { PaddingTop = UDim.new(0.14, 0), PaddingBottom = UDim.new(0.14, 0), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }),
	}) :: TextButton
	local textStroke = Ui.stroke(2.5, Theme.Color.Ink, Enum.ApplyStrokeMode.Contextual)
	textStroke.Parent = button
	button.MouseEnter:Connect(function()
		Ui.tween(scale, Theme.Tween.Quick, { Scale = 1.05 })
	end)
	button.MouseLeave:Connect(function()
		Ui.tween(scale, Theme.Tween.Quick, { Scale = 1 })
		Ui.tween(button, Theme.Tween.Quick, { Position = UDim2.new() })
	end)
	button.MouseButton1Down:Connect(function()
		Ui.tween(scale, Theme.Tween.Quick, { Scale = 0.94 })
		Ui.tween(button, Theme.Tween.Quick, { Position = UDim2.fromOffset(0, 4) })
	end)
	button.MouseButton1Up:Connect(function()
		Ui.tween(scale, Theme.Tween.Pop, { Scale = 1 })
		Ui.tween(button, Theme.Tween.Quick, { Position = UDim2.new() })
	end)
	if props.onClick then
		button.Activated:Connect(function()
			if Ui.onClickSound then
				Ui.onClickSound()
			end
			props.onClick()
		end)
	end
	return button, holder
end

-- A ViewportFrame showing a model, auto-framed. `model` is cloned.
function Ui.viewport(model: Model?, props: { [any]: any }?): ViewportFrame
	local vp = Ui.new("ViewportFrame", {
		BackgroundTransparency = 1,
		Ambient = Color3.fromRGB(200, 190, 220),
		LightColor = Color3.fromRGB(255, 248, 235),
		LightDirection = Vector3.new(-0.6, -1, -0.5),
	})
	local propList: { [any]: any } = props or {}
	for k, v in propList do
		vp[k] = v
	end
	if model then
		Ui.setViewportModel(vp, model)
	end
	return vp
end

function Ui.setViewportModel(vp: ViewportFrame, model: Model, silhouette: boolean?)
	for _, c in vp:GetChildren() do
		if c:IsA("Model") or c:IsA("Camera") or c:IsA("WorldModel") then
			c:Destroy()
		end
	end
	local clone = model:Clone()
	for _, d in clone:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
			if silhouette then
				d.Color = Color3.fromRGB(40, 28, 80)
				d.Material = Enum.Material.SmoothPlastic
			end
		elseif d:IsA("ParticleEmitter") or d:IsA("PointLight") then
			d:Destroy()
		end
	end
	clone:PivotTo(CFrame.new())
	clone.Parent = vp
	local cf, size = clone:GetBoundingBox()
	local radius = math.max(size.Magnitude / 2, 0.2)
	local cam = Instance.new("Camera")
	cam.FieldOfView = 30
	local dir = Vector3.new(0.7, 0.5, 1).Unit
	cam.CFrame = CFrame.lookAt(cf.Position + dir * radius / math.sin(math.rad(15)) * 1.05, cf.Position)
	cam.Parent = vp
	vp.CurrentCamera = cam
end

-- Uniform UI scale so layouts read the same on phones, tablets, PCs and TVs.
function Ui.autoScale(gui: ScreenGui): UIScale
	local scale = Ui.new("UIScale", { Parent = gui }) :: UIScale
	local function update()
		local cam = Workspace.CurrentCamera
		local vs = cam.ViewportSize
		local s = math.clamp(math.min(vs.X / 1280, vs.Y / 760), 0.6, 1.4)
		if game:GetService("GuiService"):IsTenFootInterface() then
			s *= 1.25
		end
		scale.Scale = s
	end
	update()
	Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(update)
	return scale
end

return Ui
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
