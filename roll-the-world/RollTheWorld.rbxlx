        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">PropCodec</string>
            <string name="Source"><![CDATA[--!strict
-- Compact binary encoding for prop lists sent to clients (one buffer instead of thousands of
-- instances). Record layout (19 bytes): u16 id, u16 uid, f32 x, f32 y, f32 z, u8 yaw, u8 scale, u8 mutation.
-- Loot uses the same layout. Critter state uses its own 13-byte layout.

local PropCodec = {}

local RECORD = 19

export type Record = {
	id: number,
	uid: number,
	x: number,
	y: number,
	z: number,
	yaw: number,
	scale: number,
	mutation: number,
}

local function quantYaw(yaw: number): number
	return math.floor(((yaw % (2 * math.pi)) / (2 * math.pi)) * 255 + 0.5) % 256
end

local function quantScale(scale: number): number
	return math.clamp(math.floor((scale - 0.25) * 100 + 0.5), 0, 255)
end

function PropCodec.encode(records: { Record }): buffer
	local b = buffer.create(#records * RECORD)
	for i, r in records do
		local o = (i - 1) * RECORD
		buffer.writeu16(b, o, r.id)
		buffer.writeu16(b, o + 2, r.uid)
		buffer.writef32(b, o + 4, r.x)
		buffer.writef32(b, o + 8, r.y)
		buffer.writef32(b, o + 12, r.z)
		buffer.writeu8(b, o + 16, quantYaw(r.yaw))
		buffer.writeu8(b, o + 17, quantScale(r.scale))
		buffer.writeu8(b, o + 18, r.mutation)
	end
	return b
end

function PropCodec.decode(b: buffer): { Record }
	local count = buffer.len(b) // RECORD
	local out = table.create(count)
	for i = 1, count do
		local o = (i - 1) * RECORD
		out[i] = {
			id = buffer.readu16(b, o),
			uid = buffer.readu16(b, o + 2),
			x = buffer.readf32(b, o + 4),
			y = buffer.readf32(b, o + 8),
			z = buffer.readf32(b, o + 12),
			yaw = buffer.readu8(b, o + 16) / 255 * 2 * math.pi,
			scale = buffer.readu8(b, o + 17) / 100 + 0.25,
			mutation = buffer.readu8(b, o + 18),
		}
	end
	return out
end

-- Quantised scale exactly as clients will see it (server uses this so both sides agree).
function PropCodec.roundTripScale(scale: number): number
	return quantScale(scale) / 100 + 0.25
end

-- Critters: u16 id, f32 x, f32 y, f32 z, u8 yaw, u8 state  (16 bytes)
local CRITTER = 16

export type CritterRecord = { id: number, x: number, y: number, z: number, yaw: number, state: number }

function PropCodec.encodeCritters(records: { CritterRecord }): buffer
	local b = buffer.create(#records * CRITTER)
	for i, r in records do
		local o = (i - 1) * CRITTER
		buffer.writeu16(b, o, r.id)
		buffer.writef32(b, o + 2, r.x)
		buffer.writef32(b, o + 6, r.y)
		buffer.writef32(b, o + 10, r.z)
		buffer.writeu8(b, o + 14, quantYaw(r.yaw))
		buffer.writeu8(b, o + 15, r.state)
	end
	return b
end

function PropCodec.decodeCritters(b: buffer): { CritterRecord }
	local count = buffer.len(b) // CRITTER
	local out = table.create(count)
	for i = 1, count do
		local o = (i - 1) * CRITTER
		out[i] = {
			id = buffer.readu16(b, o),
			x = buffer.readf32(b, o + 2),
			y = buffer.readf32(b, o + 6),
			z = buffer.readf32(b, o + 10),
			yaw = buffer.readu8(b, o + 14) / 255 * 2 * math.pi,
			state = buffer.readu8(b, o + 15),
		}
	end
	return out
end

return PropCodec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">RateLimiter</string>
            <string name="Source"><![CDATA[--!strict
-- Token-bucket rate limiter keyed by an arbitrary key (usually a Player or userId).

export type RateLimiter = {
	allow: (self: RateLimiter, key: any, cost: number?) -> boolean,
	reset: (self: RateLimiter, key: any) -> (),
}

local RateLimiter = {}
RateLimiter.__index = RateLimiter

-- ratePerSecond: refill speed. burst: bucket capacity.
-- clock: injectable time source (defaults to os.clock) so tests are deterministic.
function RateLimiter.new(ratePerSecond: number, burst: number, clock: (() -> number)?): RateLimiter
	local self = setmetatable({
		_rate = ratePerSecond,
		_burst = burst,
		_buckets = setmetatable({}, { __mode = "k" }) :: any,
		_clock = clock or os.clock,
	}, RateLimiter)
	return (self :: any) :: RateLimiter
end

function RateLimiter.allow(self: any, key: any, cost: number?): boolean
	local c = cost or 1
	local now = self._clock()
	local bucket = self._buckets[key]
	if not bucket then
		bucket = { tokens = self._burst, t = now }
		self._buckets[key] = bucket
	end
	bucket.tokens = math.min(self._burst, bucket.tokens + (now - bucket.t) * self._rate)
	bucket.t = now
	if bucket.tokens >= c then
		bucket.tokens -= c
		return true
	end
	return false
end

function RateLimiter.reset(self: any, key: any)
	self._buckets[key] = nil
end

return RateLimiter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">Rng</string>
            <string name="Source"><![CDATA[--!strict
-- Deterministic, platform-independent PRNG (xoshiro128**). Used by world generation and request
-- generation so the same seed always yields the same result on server, client and in tests.

export type Rng = {
	nextU32: (self: Rng) -> number,
	float: (self: Rng) -> number,
	range: (self: Rng, lo: number, hi: number) -> number,
	int: (self: Rng, lo: number, hi: number) -> number,
	chance: (self: Rng, p: number) -> boolean,
	pick: <T>(self: Rng, list: { T }) -> T,
	weighted: <T>(self: Rng, list: { T }, weightOf: (T) -> number) -> T?,
	shuffle: <T>(self: Rng, list: { T }) -> { T },
	gauss: (self: Rng) -> number,
	fork: (self: Rng, salt: number) -> Rng,
}

local Rng = {}
Rng.__index = Rng

local band, bor, bxor, lshift, rshift = bit32.band, bit32.bor, bit32.bxor, bit32.lshift, bit32.rshift

local function rotl(x: number, k: number): number
	return bor(lshift(x, k), rshift(x, 32 - k))
end

-- 32-bit multiply mod 2^32 without losing precision in doubles.
local function mul32(a: number, b: number): number
	local aHi, aLo = rshift(a, 16), band(a, 0xFFFF)
	local bHi, bLo = rshift(b, 16), band(b, 0xFFFF)
	local lo = aLo * bLo
	local mid = band(aHi * bLo + aLo * bHi, 0xFFFF)
	return band(lo + lshift(mid, 16), 0xFFFFFFFF)
end

local function splitmix(state: number): (number, number)
	state = band(state + 0x9E3779B9, 0xFFFFFFFF)
	local z = state
	z = mul32(bxor(z, rshift(z, 16)), 0x85EBCA6B)
	z = mul32(bxor(z, rshift(z, 13)), 0xC2B2AE35)
	z = bxor(z, rshift(z, 16))
	return state, z
end

function Rng.new(seed: number): Rng
	local s = band(math.floor(math.abs(seed)) % 4294967296, 0xFFFFFFFF)
	local a, b, c, d
	s, a = splitmix(s)
	s, b = splitmix(s)
	s, c = splitmix(s)
	s, d = splitmix(s)
	if a == 0 and b == 0 and c == 0 and d == 0 then
		a = 1
	end
	return (setmetatable({ _s0 = a, _s1 = b, _s2 = c, _s3 = d }, Rng) :: any) :: Rng
end

function Rng.nextU32(self: any): number
	local s0, s1, s2, s3 = self._s0, self._s1, self._s2, self._s3
	local result = mul32(rotl(mul32(s1, 5), 7), 9)
	local t = lshift(s1, 9)
	s2 = bxor(s2, s0)
	s3 = bxor(s3, s1)
	s1 = bxor(s1, s2)
	s0 = bxor(s0, s3)
	s2 = bxor(s2, t)
	s3 = rotl(s3, 11)
	self._s0, self._s1, self._s2, self._s3 = s0, s1, s2, s3
	return result
end

function Rng.float(self: any): number
	return self:nextU32() / 4294967296
end

function Rng.range(self: any, lo: number, hi: number): number
	return lo + (hi - lo) * self:float()
end

function Rng.int(self: any, lo: number, hi: number): number
	if hi < lo then
		lo, hi = hi, lo
	end
	return lo + (self:nextU32() % (hi - lo + 1))
end

function Rng.chance(self: any, p: number): boolean
	return self:float() < p
end

function Rng.pick(self: any, list)
	assert(#list > 0, "Rng.pick on empty list")
	return list[self:int(1, #list)]
end

function Rng.weighted(self: any, list, weightOf)
	local total = 0
	for _, item in list do
		total += math.max(0, weightOf(item))
	end
	if total <= 0 then
		return nil
	end
	local roll = self:float() * total
	for _, item in list do
		roll -= math.max(0, weightOf(item))
		if roll <= 0 then
			return item
		end
	end
	return list[#list]
end

function Rng.shuffle(self: any, list)
	for i = #list, 2, -1 do
		local j = self:int(1, i)
		list[i], list[j] = list[j], list[i]
	end
	return list
end

function Rng.gauss(self: any): number
	local u1 = math.max(self:float(), 1e-9)
	local u2 = self:float()
	return math.sqrt(-2 * math.log(u1)) * math.cos(2 * math.pi * u2)
end

function Rng.fork(self: any, salt: number): Rng
	return Rng.new(bxor(self:nextU32(), band(math.floor(salt * 2654435761) % 4294967296, 0xFFFFFFFF)))
end

-- Stable string hash (FNV-1a) for seeding from ids.
function Rng.hashString(str: string): number
	local h = 0x811C9DC5
	for i = 1, #str do
		h = bxor(h, string.byte(str, i))
		h = mul32(h, 0x01000193)
	end
	return h
end

return Rng
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">Signal</string>
            <string name="Source"><![CDATA[--!strict
-- Minimal, allocation-light signal. Handlers run synchronously in connection order.
-- Handlers that yield are fine (each runs in its own thread via task.spawn when `deferred` is false
-- we call directly; yielding handlers will block later handlers, so prefer non-yielding handlers).

export type Connection = {
	Connected: boolean,
	Disconnect: (self: Connection) -> (),
}

export type Signal<T...> = {
	Connect: (self: Signal<T...>, fn: (T...) -> ()) -> Connection,
	Once: (self: Signal<T...>, fn: (T...) -> ()) -> Connection,
	Fire: (self: Signal<T...>, T...) -> (),
	Wait: (self: Signal<T...>) -> T...,
	DisconnectAll: (self: Signal<T...>) -> (),
}

local Signal = {}
Signal.__index = Signal

local ConnectionMT = {}
ConnectionMT.__index = ConnectionMT

function ConnectionMT.Disconnect(self: any)
	if not self.Connected then
		return
	end
	self.Connected = false
	local signal = self._signal
	local list = signal._handlers
	for i = #list, 1, -1 do
		if list[i] == self then
			table.remove(list, i)
			break
		end
	end
end

function Signal.new<T...>(): Signal<T...>
	local self = setmetatable({ _handlers = {} }, Signal)
	return (self :: any) :: Signal<T...>
end

function Signal.Connect(self: any, fn)
	local conn = setmetatable({ Connected = true, _fn = fn, _signal = self }, ConnectionMT)
	table.insert(self._handlers, conn)
	return conn
end

function Signal.Once(self: any, fn)
	local conn
	conn = self:Connect(function(...)
		conn:Disconnect()
		fn(...)
	end)
	return conn
end

function Signal.Fire(self: any, ...)
	-- Copy so handlers may disconnect during dispatch.
	local list: { any } = table.clone(self._handlers)
	for _, conn in list do
		if conn.Connected then
			local ok, err = pcall(conn._fn, ...)
			if not ok then
				warn("[Signal] handler error: " .. tostring(err))
			end
		end
	end
end

function Signal.Wait(self: any)
	local thread = coroutine.running()
	self:Once(function(...)
		task.spawn(thread, ...)
	end)
	return coroutine.yield()
end

function Signal.DisconnectAll(self: any)
	for _, conn in self._handlers do
		conn.Connected = false
	end
	table.clear(self._handlers)
end

return Signal
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">SpatialHash</string>
            <string name="Source"><![CDATA[--!strict
-- 2D (XZ) uniform-grid spatial hash for fast "what is near this ball" queries over thousands of props.
-- Items are referenced by integer id. Each item occupies every cell its bounding circle overlaps.

export type SpatialHash = {
	cellSize: number,
	cells: { [number]: { [number]: boolean } },
	items: { [number]: { x: number, z: number, r: number, cells: { number } } },
	count: number,
	insert: (self: SpatialHash, id: number, x: number, z: number, radius: number) -> (),
	remove: (self: SpatialHash, id: number) -> (),
	move: (self: SpatialHash, id: number, x: number, z: number, radius: number?) -> (),
	query: (self: SpatialHash, x: number, z: number, radius: number, out: { number }?) -> { number },
	has: (self: SpatialHash, id: number) -> boolean,
}

local SpatialHash = {}
SpatialHash.__index = SpatialHash

-- Packs integer cell coords (within +/- 32767) into one number key.
local function key(cx: number, cz: number): number
	return (cx + 32768) * 65536 + (cz + 32768)
end

function SpatialHash.new(cellSize: number): SpatialHash
	return (setmetatable({ cellSize = cellSize, cells = {}, items = {}, count = 0 }, SpatialHash) :: any) :: SpatialHash
end

function SpatialHash.insert(self: any, id: number, x: number, z: number, radius: number)
	if self.items[id] then
		self:remove(id)
	end
	local cs = self.cellSize
	local cellList = {}
	local x0, x1 = math.floor((x - radius) / cs), math.floor((x + radius) / cs)
	local z0, z1 = math.floor((z - radius) / cs), math.floor((z + radius) / cs)
	for cx = x0, x1 do
		for cz = z0, z1 do
			local k = key(cx, cz)
			local cell = self.cells[k]
			if not cell then
				cell = {}
				self.cells[k] = cell
			end
			cell[id] = true
			table.insert(cellList, k)
		end
	end
	self.items[id] = { x = x, z = z, r = radius, cells = cellList }
	self.count += 1
end

function SpatialHash.remove(self: any, id: number)
	local item = self.items[id]
	if not item then
		return
	end
	for _, k in item.cells do
		local cell = self.cells[k]
		if cell then
			cell[id] = nil
			if next(cell) == nil then
				self.cells[k] = nil
			end
		end
	end
	self.items[id] = nil
	self.count -= 1
end

function SpatialHash.move(self: any, id: number, x: number, z: number, radius: number?)
	local item = self.items[id]
	local r = radius or (item and item.r) or 0
	if item then
		local cs = self.cellSize
		-- Skip the rebuild when the occupied cell range is unchanged.
		local same = math.floor((item.x - item.r) / cs) == math.floor((x - r) / cs)
			and math.floor((item.x + item.r) / cs) == math.floor((x + r) / cs)
			and math.floor((item.z - item.r) / cs) == math.floor((z - r) / cs)
			and math.floor((item.z + item.r) / cs) == math.floor((z + r) / cs)
		if same then
			item.x, item.z, item.r = x, z, r
			return
		end
	end
	self:insert(id, x, z, r)
end

-- Returns ids whose bounding circle may intersect the query circle (broad phase, de-duplicated).
function SpatialHash.query(self: any, x: number, z: number, radius: number, out: { number }?): { number }
	local result = out or {}
	local seen = {}
	local cs = self.cellSize
	local x0, x1 = math.floor((x - radius) / cs), math.floor((x + radius) / cs)
	local z0, z1 = math.floor((z - radius) / cs), math.floor((z + radius) / cs)
	for cx = x0, x1 do
		for cz = z0, z1 do
			local cell = self.cells[key(cx, cz)]
			if cell then
				for id in cell do
					if not seen[id] then
						seen[id] = true
						local item = self.items[id]
						local dx, dz = item.x - x, item.z - z
						local reach = item.r + radius
						if dx * dx + dz * dz <= reach * reach then
							table.insert(result, id)
						end
					end
				end
			end
		end
	end
	return result
end

function SpatialHash.has(self: any, id: number): boolean
	return self.items[id] ~= nil
end

return SpatialHash
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">Spring</string>
            <string name="Source"><![CDATA[--!strict
-- Critically-damped-ish scalar spring for bouncy UI numbers and squash/stretch.

export type Spring = {
	position: number,
	velocity: number,
	target: number,
	stiffness: number,
	damping: number,
	step: (self: Spring, dt: number) -> number,
	impulse: (self: Spring, v: number) -> (),
	snap: (self: Spring, v: number) -> (),
}

local Spring = {}
Spring.__index = Spring

function Spring.new(initial: number, stiffness: number?, damping: number?): Spring
	return (setmetatable({
		position = initial,
		velocity = 0,
		target = initial,
		stiffness = stiffness or 170,
		damping = damping or 18,
	}, Spring) :: any) :: Spring
end

function Spring.step(self: any, dt: number): number
	-- Sub-step for stability at low frame rates.
	local steps = math.max(1, math.ceil(dt / (1 / 120)))
	local h = dt / steps
	for _ = 1, steps do
		local force = (self.target - self.position) * self.stiffness - self.velocity * self.damping
		self.velocity += force * h
		self.position += self.velocity * h
	end
	return self.position
end

function Spring.impulse(self: any, v: number)
	self.velocity += v
end

function Spring.snap(self: any, v: number)
	self.position = v
	self.target = v
	self.velocity = 0
end

return Spring
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">TableUtil</string>
            <string name="Source"><![CDATA[--!strict
-- Table helpers used by save migrations, live config merging and UI.

local TableUtil = {}

function TableUtil.deepCopy<T>(value: T): T
	if type(value) ~= "table" then
		return value
	end
	local out = {}
	for k, v in value :: any do
		out[TableUtil.deepCopy(k)] = TableUtil.deepCopy(v)
	end
	return (out :: any) :: T
end

-- Fills missing keys in `target` from `defaults`, recursively. Existing values win.
function TableUtil.reconcile(target: { [any]: any }, defaults: { [any]: any }): { [any]: any }
	for k, v in defaults do
		if target[k] == nil then
			target[k] = TableUtil.deepCopy(v)
		elseif type(v) == "table" and type(target[k]) == "table" and next(v) ~= nil and #v == 0 then
			-- Only recurse into dictionary-shaped defaults; arrays are replaced wholesale.
			TableUtil.reconcile(target[k], v)
		end
	end
	return target
end

-- Overlay `patch` on top of `base` (patch wins), returning a new table.
function TableUtil.merge(base: { [any]: any }, patch: { [any]: any }?): { [any]: any }
	local out = TableUtil.deepCopy(base)
	if not patch then
		return out
	end
	for k, v in patch do
		if type(v) == "table" and type(out[k]) == "table" and #v == 0 and next(v) ~= nil then
			out[k] = TableUtil.merge(out[k], v)
		else
			out[k] = TableUtil.deepCopy(v)
		end
	end
	return out
end

function TableUtil.keys<K>(t: { [K]: any }): { K }
	local out = {}
	for k in t do
		table.insert(out, k)
	end
	return out
end

function TableUtil.count(t: { [any]: any }): number
	local n = 0
	for _ in t do
		n += 1
	end
	return n
end

function TableUtil.map<T, U>(list: { T }, fn: (T, number) -> U): { U }
	local out = table.create(#list)
	for i, v in list do
		out[i] = fn(v, i)
	end
	return out
end

function TableUtil.filter<T>(list: { T }, fn: (T) -> boolean): { T }
	local out = {}
	for _, v in list do
		if fn(v) then
			table.insert(out, v)
		end
	end
	return out
end

function TableUtil.find<T>(list: { T }, fn: (T) -> boolean): T?
	for _, v in list do
		if fn(v) then
			return v
		end
	end
	return nil
end

function TableUtil.freeze<T>(t: T): T
	if type(t) == "table" and not table.isfrozen(t :: any) then
		for _, v in t :: any do
			if type(v) == "table" then
				TableUtil.freeze(v)
			end
		end
		table.freeze(t :: any)
	end
	return t
end

return TableUtil
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">Trove</string>
            <string name="Source"><![CDATA[--!strict
-- Cleanup bag. Add instances, connections, functions, threads or anything with Destroy/Disconnect.

export type Trove = {
	Add: <T>(self: Trove, item: T) -> T,
	Clean: (self: Trove) -> (),
	Destroy: (self: Trove) -> (),
}

local Trove = {}
Trove.__index = Trove

function Trove.new(): Trove
	return (setmetatable({ _items = {} }, Trove) :: any) :: Trove
end

local function cleanupItem(item: any): ()
	local kind = typeof(item)
	if kind == "function" then
		item()
	elseif kind == "RBXScriptConnection" then
		item:Disconnect()
	elseif kind == "Instance" then
		item:Destroy()
	elseif kind == "thread" then
		pcall(task.cancel, item)
	elseif kind == "table" then
		if type(item.Destroy) == "function" then
			item:Destroy()
		elseif type(item.Disconnect) == "function" then
			item:Disconnect()
		end
	end
end

function Trove.Add(self: any, item: any): any
	table.insert(self._items, item)
	return item
end

function Trove.Clean(self: any)
	local items = self._items
	self._items = {}
	for i = #items, 1, -1 do
		local item = items[i]
		local ok, err = pcall(function()
			cleanupItem(item)
		end)
		if not ok then
			warn("[Trove] cleanup error: " .. tostring(err))
		end
	end
end

function Trove.Destroy(self: any)
	self:Clean()
end

return Trove
]]></string>
          </Properties>
        </Item>
      </Item>
