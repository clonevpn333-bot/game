{
  "name": "dream-courier",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DREAM COURIER — a linear third-person dream adventure built with Three.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc",
    "test": "playwright test",
    "verify:visual": "playwright test tests/visual.spec.ts",
    "inspect:canvas": "node scripts/inspect-threejs-canvas.mjs",
    "build:single": "tsc && vite build --config vite.single.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "lil-gui": "^0.21.0",
    "postprocessing": "^6.39.5",
    "three": "~0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^25.9.0",
    "@types/pngjs": "^6.0.5",
    "@types/three": "~0.186.0",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.13",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
